	return [
		RecoveryCompilerModule.new(name: "frontend/resolution/module_components", imports: "import { CompilerState, diagnostic } from state/state\nimport { integer_string } from support/literals\nimport { load_integer, sparse_integer_at } from support/storage\n\n"),
