import { Gate4Compiler } from state
import { gate4_load_integer, gate4_load_string } from storage
import { gate4_integer_string } from literals

# Native diagnostics currently carry line origins, not token columns. Match
# the reference renderer's location/severity/code shape without inventing a
# column or assigning a reference code to a different frontend diagnosis.
def cli_diagnostic(state: Gate4Compiler, fallback: String, offset: Integer): String
	module_index := gate4_load_integer(state.diagnostic_modules, 0)
	mut path := fallback
	mut line := gate4_load_integer(state.diagnostic_lines, 0)
	if module_index < state.module_count[0]
		path = gate4_load_string(state.module_files, module_index)
	end
	if fallback == "(trb)"
		if module_index == state.entry_module[0]
			path = fallback
			line -= offset
			if line < 1
				line = 1
			end
		end
	end
	return path + ":" + gate4_integer_string(line) + ": error[" + gate4_load_string(state.diagnostic_codes, 0) + "]: " + gate4_load_string(state.diagnostic_messages, 0)
end
