import { CompilerState } from state
import { load_integer, load_string } from storage
import { integer_string } from literals

# Native diagnostics currently carry line origins, not token columns. Match
# the reference renderer's location/severity/code shape without inventing a
# column or assigning a reference code to a different frontend diagnosis.
def cli_diagnostic(state: CompilerState, fallback: String, offset: Integer): String
	module_index := load_integer(state.diagnostic_modules, 0)
	mut path := fallback
	mut line := load_integer(state.diagnostic_lines, 0)
	if module_index < state.module_count[0]
		path = load_string(state.module_files, module_index)
	end
	if fallback == "(trb)"
		if module_index == state.entry_module[0]
			path = fallback
			line -= offset
			if line < 1
				line = 1
			end
		end
	end
	return path + ":" + integer_string(line) + ": error[" + load_string(state.diagnostic_codes, 0) + "]: " + load_string(state.diagnostic_messages, 0)
end
