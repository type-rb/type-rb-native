def native_cli_runtime_qbe(): String
	return "\ndata $trbn_empty = { b 0 }\ndata $trbn_template = { b \"/tmp/trbn.XXXXXX\", b 0 }\ndata $trbn_append = { b \"ab\", b 0 }\ndata $trbn_float_format = { b \"%.17g\", b 0 }\ndata $trbn_eof = align 8 { l 0 }\ndata $trbn_interrupted = align 8 { l 0 }\ndata $trbn_child = align 8 { l 0 }\nfunction l $native_cli_env(l %name) {\n@start\n %key =l add %name, 16\n %value =l call $getenv(l %key)\n jnz %value, @found, @empty\n@found\n %result =l call $g4_string_from_c(l %value)\n ret %result\n@empty\n %blank =l call $g4_string_from_c(l $trbn_empty)\n ret %blank\n}\nfunction l $native_cli_cwd() {\n@start\n %buffer =l alloc8 65536\n %value =l call $getcwd(l %buffer, l 65536)\n jnz %value, @ok, @fail\n@ok\n %result =l call $g4_string_from_c(l %value)\n ret %result\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\nfunction l $native_cli_program() {\n@start\n %argv =l loadl $g4_process_argv_pointer\n %name =l loadl %argv\n %result =l call $g4_string_from_c(l %name)\n ret %result\n}\nfunction l $native_cli_platform() {\n@start\n %buffer =l alloc8 2048\n %status =w call $uname(l %buffer)\n %bad =w cnew %status, 0\n jnz %bad, @fail, @ok\n@ok\n %result =l call $g4_string_from_c(l %buffer)\n ret %result\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\nfunction l $native_cli_tty() {\n@start\n %input =w call $isatty(w 0)\n %output =w call $isatty(w 1)\n %both =w and %input, %output\n %result =l extuw %both\n ret %result\n}\nfunction l $native_cli_write(l %text, l %descriptor) {\n@start\n %lenp =l add %text, 8\n %length =l loadl %lenp\n %data =l add %text, 16\n %result =l call $write(w %descriptor, l %data, l %length)\n ret %result\n}\nfunction l $native_cli_save(l %path, l %text, l %append) {\n@start\n %name =l add %path, 16\n jnz %append, @append, @replace\n@append\n %af =l call $fopen(l %name, l $trbn_append)\n jmp @write\n@replace\n %wf =l call $fopen(l %name, l $g4_wb)\n jmp @write\n@write\n %file =l phi @append %af, @replace %wf\n jnz %file, @open, @fail\n@open\n %lenp =l add %text, 8\n %length =l loadl %lenp\n %data =l add %text, 16\n %written =l call $fwrite(l %data, l 1, l %length, l %file)\n %closed =w call $fclose(l %file)\n %short =w cnel %written, %length\n %closefail =w cnew %closed, 0\n %bad =w or %short, %closefail\n %result =l extuw %bad\n ret %result\n@fail\n ret 1\n}\nfunction l $native_cli_mkdir(l %path) {\n@start\n %name =l add %path, 16\n %status =w call $mkdir(l %name, w 448)\n %result =l extsw %status\n ret %result\n}\nfunction l $native_cli_remove(l %path, l %directory) {\n@start\n %name =l add %path, 16\n jnz %directory, @dir, @file\n@dir\n %d =w call $rmdir(l %name)\n %dr =l extsw %d\n ret %dr\n@file\n %f =w call $unlink(l %name)\n %fr =l extsw %f\n ret %fr\n}\nfunction l $native_cli_temp() {\n@start\n %buffer =l alloc8 64\n call $strcpy(l %buffer, l $trbn_template)\n %path =l call $mkdtemp(l %buffer)\n jnz %path, @ok, @fail\n@ok\n %result =l call $g4_string_from_c(l %path)\n ret %result\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\nfunction $trbn_signal(w %signal) {\n@start\n %sig =l extsw %signal\n storel %sig, $trbn_interrupted\n %child =l loadl $trbn_child\n jnz %child, @forward, @idle\n@idle\n %terminate =w ceqw %signal, 15\n jnz %terminate, @terminate, @done\n@terminate\n call $native_cli_terminal_end()\n call $_exit(w 143)\n hlt\n@forward\n call $kill(w %child, w %signal)\n@done\n ret\n}\nfunction l $native_cli_interrupt(l %reset) {\n@start\n %value =l loadl $trbn_interrupted\n jnz %reset, @reset, @done\n@reset\n storel 0, $trbn_interrupted\n@done\n ret %value\n}\nfunction l $native_cli_signals() {\n@start\n call $signal(w 2, l $trbn_signal)\n call $siginterrupt(w 2, w 1)\n call $signal(w 15, l $trbn_signal)\n call $siginterrupt(w 15, w 1)\n ret 0\n}\nfunction l $native_cli_line(l %prompt) {\n@start\n storel 0, $trbn_eof\n jmp @plain\n@plain\n %buffer =l call $malloc(l 1048577)\n jmp @read\n@read\n %index =l phi @plain 0, @next %next\n %cell =l add %buffer, %index\n %count =l call $read(w 0, l %cell, l 1)\n %ended =w cslel %count, 0\n jnz %ended, @end, @character\n@character\n %byte =w loadub %cell\n %newline =w ceqw %byte, 10\n jnz %newline, @end, @next\n@next\n %next =l add %index, 1\n %limit =w ceql %next, 1048576\n jnz %limit, @limit, @read\n@limit\n %last =l add %buffer, 1048576\n storeb 0, %last\n jmp @finish\n@end\n storeb 0, %cell\n %empty =w ceql %index, 0\n %eof =w and %ended, %empty\n jnz %eof, @eof, @finish\n@finish\n %result =l call $g4_string_from_c(l %buffer)\n call $free(l %buffer)\n ret %result\n@eof\n call $free(l %buffer)\n storel 1, $trbn_eof\n %blank =l call $g4_string_from_c(l $trbn_empty)\n ret %blank\n}\nfunction l $native_cli_execute(l %arguments, l %internal) {\n@start\n %lenp =l add %arguments, 8\n %length =l loadl %lenp\n %datap =l add %arguments, 24\n %data =l loadl %datap\n %cells =l add %length, 1\n %size =l mul %cells, 8\n %argv =l call $malloc(l %size)\n jmp @copy\n@copy\n %index =l phi @start 0, @next %next\n %done =w ceql %index, %length\n %offset =l mul %index, 8\n %cell =l add %argv, %offset\n jnz %done, @dispatch, @item\n@item\n %source =l add %data, %offset\n %string =l loadl %source\n %cstring =l add %string, 16\n storel %cstring, %cell\n jmp @next\n@next\n %next =l add %index, 1\n jmp @copy\n@dispatch\n storel 0, %cell\n jnz %internal, @internal, @fork\n@internal\n %compile =w call $g4_compiler_dispatch(w %length, l %argv)\n call $free(l %argv)\n %cr =l extsw %compile\n ret %cr\n@fork\n %pid =w call $fork()\n %failure =w csltw %pid, 0\n jnz %failure, @fail, @forked\n@forked\n jnz %pid, @parent, @child\n@child\n call $signal(w 2, l 0)\n call $signal(w 15, l 0)\n %command =l loadl %argv\n call $execv(l %command, l %argv)\n call $_exit(w 127)\n hlt\n@parent\n %pidlong =l extsw %pid\n storel %pidlong, $trbn_child\n %status =l alloc8 8\n jmp @wait\n@wait\n %waited =w call $waitpid(w %pid, l %status, w 0)\n %retry =w csltw %waited, 0\n jnz %retry, @wait, @finished\n@finished\n storel 0, $trbn_child\n %value =w loadw %status\n call $free(l %argv)\n %signal =w and %value, 127\n jnz %signal, @signaled, @normal\n@signaled\n %code =w add %signal, 128\n %sr =l extuw %code\n ret %sr\n@normal\n %exit =w shr %value, 8\n %nr =l extuw %exit\n ret %nr\n@fail\n call $free(l %argv)\n ret 127\n}\nfunction d $native_cli_float(l %text) {\n@start\n %data =l add %text, 16\n %result =d call $strtod(l %data, l 0)\n ret %result\n}\nfunction l $native_cli_float_text(d %value) {\n@start\n %buffer =l alloc8 128\n call $snprintf(l %buffer, l 128, l $trbn_float_format, ..., d %value)\n %result =l call $g4_string_from_c(l %buffer)\n ret %result\n}\n\nfunction l $native_cli_eof() {\n@start\n %result =l loadl $trbn_eof\n ret %result\n}\ndata $trbn_darwin = { b \"Darwin\", b 0 }\ndata $trbn_linux = { b \"Linux\", b 0 }\ndata $trbn_amd64 = { b \"x86_64\", b 0 }\ndata $trbn_arm64 = { b \"aarch64\", b 0 }\nfunction l $native_cli_target() {\n@start\n %buffer =l alloc8 2048\n %status =w call $uname(l %buffer)\n %bad =w cnew %status, 0\n jnz %bad, @fail, @darwin\n@darwin\n %d =w call $strcmp(l %buffer, l $trbn_darwin)\n jnz %d, @linux, @apple\n@apple\n storel $g4_qbe_darwin_arm64, $g4_selected_qbe_target\n storel $g4_dead_strip_darwin, $g4_selected_dead_strip\n %dr =l call $g4_string_from_c(l $g4_profile_darwin_arm64)\n ret %dr\n@linux\n %l =w call $strcmp(l %buffer, l $trbn_linux)\n jnz %l, @fail, @machine\n@machine\n %machine =l add %buffer, 260\n %a =w call $strcmp(l %machine, l $trbn_amd64)\n jnz %a, @arm64, @amd64\n@amd64\n storel $g4_qbe_linux_amd64, $g4_selected_qbe_target\n jmp @linux_common\n@arm64\n %arm =w call $strcmp(l %machine, l $trbn_arm64)\n jnz %arm, @fail, @arm\n@arm\n storel $g4_qbe_linux_arm64, $g4_selected_qbe_target\n jmp @linux_common\n@linux_common\n %profile =l phi @amd64 $g4_profile_linux_amd64, @arm $g4_profile_linux_arm64\n storel $g4_dead_strip_linux, $g4_selected_dead_strip\n storel $g4_project_linker_lld, $g4_project_selected_linker\n %lr =l call $g4_string_from_c(l %profile)\n ret %lr\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\n\nfunction l $native_cli_rename(l %source, l %target) {\n@start\n %from =l add %source, 16\n %to =l add %target, 16\n %status =w call $rename(l %from, l %to)\n %result =l extsw %status\n ret %result\n}\n\nfunction l $native_cli_tempfile(l %prefix) {\n@start\n %data =l add %prefix, 16\n %path =l call $g4_c_concat(l %data, l $trbn_suffix)\n %fd =w call $mkstemp(l %path)\n %bad =w csltw %fd, 0\n jnz %bad, @fail, @ok\n@ok\n call $close(w %fd)\n %result =l call $g4_string_from_c(l %path)\n call $free(l %path)\n ret %result\n@fail\n call $free(l %path)\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\ndata $trbn_suffix = { b \".XXXXXX\", b 0 }\nfunction l $native_cli_emit(l %source, l %destination) {\n@start\n %path =l add %destination, 16\n %file =l call $fopen(l %path, l $g4_wb)\n jnz %file, @opened, @fail\n@opened\n %fd =w call $fileno(l %file)\n %saved =w call $dup(w 1)\n %bad =w csltw %saved, 0\n jnz %bad, @close, @redirect\n@redirect\n %redirected =w call $dup2(w %fd, w 1)\n %failed =w csltw %redirected, 0\n jnz %failed, @restore_error, @emit\n@emit\n %argv =l alloc8 32\n storel $trbn_empty, %argv\n %cmdp =l add %argv, 8\n storel $g4_emit, %cmdp\n %sourcep =l add %argv, 16\n %text =l add %source, 16\n storel %text, %sourcep\n %endp =l add %argv, 24\n storel 0, %endp\n %status =w call $g4_compiler_dispatch(w 3, l %argv)\n %restored =w call $dup2(w %saved, w 1)\n call $close(w %saved)\n %closed =w call $fclose(l %file)\n %rb =w csltw %restored, 0\n %cb =w cnew %closed, 0\n %iofail =w or %rb, %cb\n jnz %iofail, @fail, @done\n@done\n %result =l extsw %status\n ret %result\n@restore_error\n call $close(w %saved)\n jmp @close\n@close\n call $fclose(l %file)\n@fail\n ret 73\n}\n\n\n# POSIX terminal ABI only. Editing and rendering are implemented in TypeRB.\ndata $trbn_term_reset = { b \"\\033[0m\\033[?2004l\", b 0 }\ndata $trbn_term_saved = align 8 { z 256 }\ndata $trbn_term_active = align 8 { l 0 }\ndata $trbn_winsize_request = align 8 { l 0 }\ndata $trbn_locale = { b \"\", b 0 }\nfunction l $native_cli_terminal_start() {\n@start\n %saved =w call $tcgetattr(w 0, l $trbn_term_saved)\n jnz %saved, @fail, @raw\n@raw\n %raw =l alloc8 256\n %again =w call $tcgetattr(w 0, l %raw)\n jnz %again, @fail, @configure\n@configure\n call $cfmakeraw(l %raw)\n %status =w call $tcsetattr(w 0, w 0, l %raw)\n jnz %status, @fail, @ready\n@ready\n storel 1, $trbn_term_active\n %buffer =l alloc8 2048\n call $uname(l %buffer)\n %darwin =w call $strcmp(l %buffer, l $trbn_darwin)\n jnz %darwin, @linux, @apple\n@apple\n storel 1074295912, $trbn_winsize_request\n call $setlocale(w 2, l $trbn_locale)\n jmp @done\n@linux\n storel 21523, $trbn_winsize_request\n call $setlocale(w 0, l $trbn_locale)\n jmp @done\n@done\n ret 0\n@fail\n ret 1\n}\nfunction l $native_cli_terminal_end() {\n@start\n %active =l loadl $trbn_term_active\n jnz %active, @restore, @done\n@restore\n call $write(w 1, l $trbn_term_reset, l 12)\n call $tcsetattr(w 0, w 0, l $trbn_term_saved)\n storel 0, $trbn_term_active\n@done\n ret 0\n}\nfunction l $native_cli_terminal_size(l %axis) {\n@start\n %size =l alloc8 8\n storel 0, %size\n %request =l loadl $trbn_winsize_request\n %status =w call $ioctl(w 0, l %request, ..., l %size)\n %offset =l mul %axis, 2\n %cell =l add %size, %offset\n %value =w loaduh %cell\n %result =l extuw %value\n ret %result\n}\nfunction l $native_cli_key(l %timeout) {\n@start\n %pending =l loadl $trbn_interrupted\n jnz %pending, @interrupt, @poll\n@poll\n %fds =l alloc8 8\n storel 0, %fds\n %events =l add %fds, 4\n storeh 1, %events\n %ready =w call $poll(l %fds, l 1, w %timeout)\n %signal =l loadl $trbn_interrupted\n jnz %signal, @interrupt, @check\n@check\n %idle =w ceqw %ready, 0\n jnz %idle, @timeout, @read\n@read\n %buffer =l alloc8 8\n %count =l call $read(w 0, l %buffer, l 1)\n %signal2 =l loadl $trbn_interrupted\n jnz %signal2, @interrupt, @received\n@received\n %one =w ceql %count, 1\n jnz %one, @byte, @end\n@byte\n %value =w loadub %buffer\n %result =l extuw %value\n ret %result\n@end\n ret -1\n@timeout\n ret -2\n@interrupt\n ret -3\n}\nfunction l $native_cli_byte(l %text, l %index) {\n@start\n %data =l add %text, 16\n %cell =l add %data, %index\n %byte =w loadub %cell\n %result =l extuw %byte\n ret %result\n}\nfunction l $native_cli_character(l %byte) {\n@start\n %buffer =l alloc8 8\n storel 0, %buffer\n storeb %byte, %buffer\n %result =l call $g4_string_from_c(l %buffer)\n ret %result\n}\nfunction l $native_cli_cell_width(l %codepoint) {\n@start\n %width =w call $wcwidth(w %codepoint)\n %result =l extsw %width\n ret %result\n}\n"
end
