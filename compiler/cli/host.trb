def native_cli_runtime_qbe(): String
	return "\ndata $trbn_empty = { b 0 }\ndata $trbn_template = { b \"/tmp/trbn.XXXXXX\", b 0 }\ndata $trbn_append = { b \"ab\", b 0 }\ndata $trbn_float_format = { b \"%.17g\", b 0 }\ndata $trbn_eof = align 8 { l 0 }\ndata $trbn_interrupted = align 8 { l 0 }\ndata $trbn_child = align 8 { l 0 }\nfunction l $native_cli_env(l %name) {\n@start\n %key =l add %name, 16\n %value =l call $getenv(l %key)\n jnz %value, @found, @empty\n@found\n %result =l call $g4_string_from_c(l %value)\n ret %result\n@empty\n %blank =l call $g4_string_from_c(l $trbn_empty)\n ret %blank\n}\nfunction l $native_cli_cwd() {\n@start\n %buffer =l alloc8 65536\n %value =l call $getcwd(l %buffer, l 65536)\n jnz %value, @ok, @fail\n@ok\n %result =l call $g4_string_from_c(l %value)\n ret %result\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\nfunction l $native_cli_program() {\n@start\n %argv =l loadl $g4_process_argv_pointer\n %name =l loadl %argv\n %result =l call $g4_string_from_c(l %name)\n ret %result\n}\nfunction l $native_cli_platform() {\n@start\n %buffer =l alloc8 2048\n %status =w call $uname(l %buffer)\n %bad =w cnew %status, 0\n jnz %bad, @fail, @ok\n@ok\n %result =l call $g4_string_from_c(l %buffer)\n ret %result\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\nfunction l $native_cli_tty() {\n@start\n %input =w call $isatty(w 0)\n %output =w call $isatty(w 1)\n %both =w and %input, %output\n %result =l extuw %both\n ret %result\n}\nfunction l $native_cli_write(l %text, l %descriptor) {\n@start\n %lenp =l add %text, 8\n %length =l loadl %lenp\n %data =l add %text, 16\n %result =l call $write(w %descriptor, l %data, l %length)\n ret %result\n}\nfunction l $native_cli_save(l %path, l %text, l %append) {\n@start\n %name =l add %path, 16\n jnz %append, @append, @replace\n@append\n %af =l call $fopen(l %name, l $trbn_append)\n jmp @write\n@replace\n %wf =l call $fopen(l %name, l $g4_wb)\n jmp @write\n@write\n %file =l phi @append %af, @replace %wf\n jnz %file, @open, @fail\n@open\n %lenp =l add %text, 8\n %length =l loadl %lenp\n %data =l add %text, 16\n %written =l call $fwrite(l %data, l 1, l %length, l %file)\n %closed =w call $fclose(l %file)\n %short =w cnel %written, %length\n %closefail =w cnew %closed, 0\n %bad =w or %short, %closefail\n %result =l extuw %bad\n ret %result\n@fail\n ret 1\n}\nfunction l $native_cli_mkdir(l %path) {\n@start\n %name =l add %path, 16\n %status =w call $mkdir(l %name, w 448)\n %result =l extsw %status\n ret %result\n}\nfunction l $native_cli_remove(l %path, l %directory) {\n@start\n %name =l add %path, 16\n jnz %directory, @dir, @file\n@dir\n %d =w call $rmdir(l %name)\n %dr =l extsw %d\n ret %dr\n@file\n %f =w call $unlink(l %name)\n %fr =l extsw %f\n ret %fr\n}\nfunction l $native_cli_temp() {\n@start\n %buffer =l alloc8 64\n call $strcpy(l %buffer, l $trbn_template)\n %path =l call $mkdtemp(l %buffer)\n jnz %path, @ok, @fail\n@ok\n %result =l call $g4_string_from_c(l %path)\n ret %result\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\nfunction $trbn_signal(w %signal) {\n@start\n %sig =l extsw %signal\n storel %sig, $trbn_interrupted\n %child =l loadl $trbn_child\n jnz %child, @forward, @idle\n@idle\n %terminate =w ceqw %signal, 15\n jnz %terminate, @terminate, @done\n@terminate\n call $_exit(w 143)\n hlt\n@forward\n call $kill(w %child, w %signal)\n@done\n ret\n}\nfunction l $native_cli_interrupt(l %reset) {\n@start\n %value =l loadl $trbn_interrupted\n jnz %reset, @reset, @done\n@reset\n storel 0, $trbn_interrupted\n@done\n ret %value\n}\nfunction l $native_cli_signals() {\n@start\n call $signal(w 2, l $trbn_signal)\n call $siginterrupt(w 2, w 1)\n call $signal(w 15, l $trbn_signal)\n call $siginterrupt(w 15, w 1)\n ret 0\n}\nfunction l $native_cli_line(l %prompt) {\n@start\n storel 0, $trbn_eof\n %reader =l loadl $trbn_readline\n jnz %reader, @editor, @plain\n@editor\n %promptdata =l add %prompt, 16\n %line =l call %reader(l %promptdata)\n jnz %line, @edited, @editor_eof\n@edited\n %edited =l call $g4_string_from_c(l %line)\n call $free(l %line)\n ret %edited\n@editor_eof\n storel 1, $trbn_eof\n %emptyline =l call $g4_string_from_c(l $trbn_empty)\n ret %emptyline\n@plain\n %buffer =l call $malloc(l 1048577)\n jmp @read\n@read\n %index =l phi @plain 0, @next %next\n %cell =l add %buffer, %index\n %count =l call $read(w 0, l %cell, l 1)\n %ended =w cslel %count, 0\n jnz %ended, @end, @character\n@character\n %byte =w loadub %cell\n %newline =w ceqw %byte, 10\n jnz %newline, @end, @next\n@next\n %next =l add %index, 1\n %limit =w ceql %next, 1048576\n jnz %limit, @limit, @read\n@limit\n %last =l add %buffer, 1048576\n storeb 0, %last\n jmp @finish\n@end\n storeb 0, %cell\n %empty =w ceql %index, 0\n %eof =w and %ended, %empty\n jnz %eof, @eof, @finish\n@finish\n %result =l call $g4_string_from_c(l %buffer)\n call $free(l %buffer)\n ret %result\n@eof\n call $free(l %buffer)\n storel 1, $trbn_eof\n %blank =l call $g4_string_from_c(l $trbn_empty)\n ret %blank\n}\nfunction l $native_cli_execute(l %arguments, l %internal) {\n@start\n %lenp =l add %arguments, 8\n %length =l loadl %lenp\n %datap =l add %arguments, 24\n %data =l loadl %datap\n %cells =l add %length, 1\n %size =l mul %cells, 8\n %argv =l call $malloc(l %size)\n jmp @copy\n@copy\n %index =l phi @start 0, @next %next\n %done =w ceql %index, %length\n %offset =l mul %index, 8\n %cell =l add %argv, %offset\n jnz %done, @dispatch, @item\n@item\n %source =l add %data, %offset\n %string =l loadl %source\n %cstring =l add %string, 16\n storel %cstring, %cell\n jmp @next\n@next\n %next =l add %index, 1\n jmp @copy\n@dispatch\n storel 0, %cell\n jnz %internal, @internal, @fork\n@internal\n %compile =w call $g4_compiler_dispatch(w %length, l %argv)\n call $free(l %argv)\n %cr =l extsw %compile\n ret %cr\n@fork\n %pid =w call $fork()\n %failure =w csltw %pid, 0\n jnz %failure, @fail, @forked\n@forked\n jnz %pid, @parent, @child\n@child\n call $signal(w 2, l 0)\n call $signal(w 15, l 0)\n %command =l loadl %argv\n call $execv(l %command, l %argv)\n call $_exit(w 127)\n hlt\n@parent\n %pidlong =l extsw %pid\n storel %pidlong, $trbn_child\n %status =l alloc8 8\n jmp @wait\n@wait\n %waited =w call $waitpid(w %pid, l %status, w 0)\n %retry =w csltw %waited, 0\n jnz %retry, @wait, @finished\n@finished\n storel 0, $trbn_child\n %value =w loadw %status\n call $free(l %argv)\n %signal =w and %value, 127\n jnz %signal, @signaled, @normal\n@signaled\n %code =w add %signal, 128\n %sr =l extuw %code\n ret %sr\n@normal\n %exit =w shr %value, 8\n %nr =l extuw %exit\n ret %nr\n@fail\n call $free(l %argv)\n ret 127\n}\nfunction d $native_cli_float(l %text) {\n@start\n %data =l add %text, 16\n %result =d call $strtod(l %data, l 0)\n ret %result\n}\nfunction l $native_cli_float_text(d %value) {\n@start\n %buffer =l alloc8 128\n call $snprintf(l %buffer, l 128, l $trbn_float_format, ..., d %value)\n %result =l call $g4_string_from_c(l %buffer)\n ret %result\n}\n\nfunction l $native_cli_eof() {\n@start\n %result =l loadl $trbn_eof\n ret %result\n}\ndata $trbn_darwin = { b \"Darwin\", b 0 }\ndata $trbn_linux = { b \"Linux\", b 0 }\ndata $trbn_amd64 = { b \"x86_64\", b 0 }\ndata $trbn_arm64 = { b \"aarch64\", b 0 }\nfunction l $native_cli_target() {\n@start\n %buffer =l alloc8 2048\n %status =w call $uname(l %buffer)\n %bad =w cnew %status, 0\n jnz %bad, @fail, @darwin\n@darwin\n %d =w call $strcmp(l %buffer, l $trbn_darwin)\n jnz %d, @linux, @apple\n@apple\n storel $g4_qbe_darwin_arm64, $g4_selected_qbe_target\n storel $g4_dead_strip_darwin, $g4_selected_dead_strip\n %dr =l call $g4_string_from_c(l $g4_profile_darwin_arm64)\n ret %dr\n@linux\n %l =w call $strcmp(l %buffer, l $trbn_linux)\n jnz %l, @fail, @machine\n@machine\n %machine =l add %buffer, 260\n %a =w call $strcmp(l %machine, l $trbn_amd64)\n jnz %a, @arm64, @amd64\n@amd64\n storel $g4_qbe_linux_amd64, $g4_selected_qbe_target\n jmp @linux_common\n@arm64\n %arm =w call $strcmp(l %machine, l $trbn_arm64)\n jnz %arm, @fail, @arm\n@arm\n storel $g4_qbe_linux_arm64, $g4_selected_qbe_target\n jmp @linux_common\n@linux_common\n %profile =l phi @amd64 $g4_profile_linux_amd64, @arm $g4_profile_linux_arm64\n storel $g4_dead_strip_linux, $g4_selected_dead_strip\n storel $g4_project_linker_lld, $g4_project_selected_linker\n %lr =l call $g4_string_from_c(l %profile)\n ret %lr\n@fail\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\n\ndata $trbn_edit_darwin = { b \"/usr/lib/libedit.3.dylib\", b 0 }\ndata $trbn_edit_linux = { b \"libedit.so.2\", b 0 }\ndata $trbn_getc_name = { b \"rl_getc_function\", b 0 }\ndata $trbn_readline_name = { b \"readline\", b 0 }\ndata $trbn_history_name = { b \"add_history\", b 0 }\ndata $trbn_matches_name = { b \"rl_completion_matches\", b 0 }\ndata $trbn_attempted_name = { b \"rl_attempted_completion_function\", b 0 }\ndata $trbn_append_name = { b \"rl_completion_append_character\", b 0 }\ndata $trbn_readline = align 8 { l 0 }\ndata $trbn_add_history = align 8 { l 0 }\ndata $trbn_matches = align 8 { l 0 }\ndata $trbn_candidates = align 8 { l 0 }\ndata $trbn_candidate_count = align 8 { l 0 }\ndata $trbn_candidate_cursor = align 8 { l 0 }\nfunction l $native_cli_editor() {\n@start\n %first =l call $dlopen(l $trbn_edit_darwin, w 1)\n jnz %first, @loaded_darwin, @linux\n@loaded_darwin\n jmp @loaded\n@linux\n %second =l call $dlopen(l $trbn_edit_linux, w 1)\n jnz %second, @loaded_linux, @fail\n@loaded_linux\n jmp @loaded\n@loaded\n %library =l phi @loaded_darwin %first, @loaded_linux %second\n %getc =l call $dlsym(l %library, l $trbn_getc_name)\n %reader =l call $dlsym(l %library, l $trbn_readline_name)\n %history =l call $dlsym(l %library, l $trbn_history_name)\n %matches =l call $dlsym(l %library, l $trbn_matches_name)\n %attempted =l call $dlsym(l %library, l $trbn_attempted_name)\n %append =l call $dlsym(l %library, l $trbn_append_name)\n %r =w ceql %reader, 0\n %h =w ceql %history, 0\n %m =w ceql %matches, 0\n %a =w ceql %attempted, 0\n %ap =w ceql %append, 0\n %v0 =w or %r, %h\n %v1 =w or %m, %a\n %v2 =w or %v0, %v1\n %v3 =w or %v2, %ap\n %g =w ceql %getc, 0\n %bad =w or %v3, %g\n jnz %bad, @fail, @ready\n@ready\n storel $trbn_getc, %getc\n storel %reader, $trbn_readline\n storel %history, $trbn_add_history\n storel %matches, $trbn_matches\n storel $trbn_complete, %attempted\n storew 0, %append\n ret 0\n@fail\n ret 1\n}\nfunction l $native_cli_history(l %line) {\n@start\n %history =l loadl $trbn_add_history\n jnz %history, @add, @done\n@add\n %text =l add %line, 16\n call %history(l %text)\n@done\n ret 0\n}\nfunction l $native_cli_completions(l %items) {\n@start\n %old =l loadl $trbn_candidates\n %oldcount =l loadl $trbn_candidate_count\n jmp @free_loop\n@free_loop\n %index =l phi @start 0, @free_next %next\n %done =w ceql %index, %oldcount\n jnz %done, @new, @free\n@free\n %offset =l mul %index, 8\n %cell =l add %old, %offset\n %string =l loadl %cell\n call $free(l %string)\n jmp @free_next\n@free_next\n %next =l add %index, 1\n jmp @free_loop\n@new\n call $free(l %old)\n %lenp =l add %items, 8\n %length =l loadl %lenp\n %size =l mul %length, 8\n %data =l call $malloc(l %size)\n storel %data, $trbn_candidates\n storel %length, $trbn_candidate_count\n %sourcep =l add %items, 24\n %source =l loadl %sourcep\n jmp @copy_loop\n@copy_loop\n %i =l phi @new 0, @copy_next %n\n %end =w ceql %i, %length\n jnz %end, @done, @copy\n@copy\n %off =l mul %i, 8\n %sp =l add %source, %off\n %managed =l loadl %sp\n %text =l add %managed, 16\n %copy =l call $strdup(l %text)\n %target =l add %data, %off\n storel %copy, %target\n jmp @copy_next\n@copy_next\n %n =l add %i, 1\n jmp @copy_loop\n@done\n ret 0\n}\nfunction l $trbn_completion_generator(l %text, w %state) {\n@start\n jnz %state, @scan, @reset\n@reset\n storel 0, $trbn_candidate_cursor\n jmp @scan\n@scan\n %cursor =l loadl $trbn_candidate_cursor\n %length =l loadl $trbn_candidate_count\n %done =w ceql %cursor, %length\n jnz %done, @none, @compare\n@compare\n %next =l add %cursor, 1\n storel %next, $trbn_candidate_cursor\n %data =l loadl $trbn_candidates\n %offset =l mul %cursor, 8\n %cell =l add %data, %offset\n %candidate =l loadl %cell\n %textlen =l call $strlen(l %text)\n %different =w call $strncmp(l %text, l %candidate, l %textlen)\n jnz %different, @scan, @match\n@match\n %result =l call $strdup(l %candidate)\n ret %result\n@none\n ret 0\n}\nfunction l $trbn_complete(l %text, w %start, w %end) {\n@entry\n %matches =l loadl $trbn_matches\n %result =l call %matches(l %text, l $trbn_completion_generator)\n ret %result\n}\nfunction l $native_cli_rename(l %source, l %target) {\n@start\n %from =l add %source, 16\n %to =l add %target, 16\n %status =w call $rename(l %from, l %to)\n %result =l extsw %status\n ret %result\n}\n\nfunction l $native_cli_tempfile(l %prefix) {\n@start\n %data =l add %prefix, 16\n %path =l call $g4_c_concat(l %data, l $trbn_suffix)\n %fd =w call $mkstemp(l %path)\n %bad =w csltw %fd, 0\n jnz %bad, @fail, @ok\n@ok\n call $close(w %fd)\n %result =l call $g4_string_from_c(l %path)\n call $free(l %path)\n ret %result\n@fail\n call $free(l %path)\n %empty =l call $g4_string_from_c(l $trbn_empty)\n ret %empty\n}\ndata $trbn_suffix = { b \".XXXXXX\", b 0 }\nfunction l $native_cli_emit(l %source, l %destination) {\n@start\n %path =l add %destination, 16\n %file =l call $fopen(l %path, l $g4_wb)\n jnz %file, @opened, @fail\n@opened\n %fd =w call $fileno(l %file)\n %saved =w call $dup(w 1)\n %bad =w csltw %saved, 0\n jnz %bad, @close, @redirect\n@redirect\n %redirected =w call $dup2(w %fd, w 1)\n %failed =w csltw %redirected, 0\n jnz %failed, @restore_error, @emit\n@emit\n %argv =l alloc8 32\n storel $trbn_empty, %argv\n %cmdp =l add %argv, 8\n storel $g4_emit, %cmdp\n %sourcep =l add %argv, 16\n %text =l add %source, 16\n storel %text, %sourcep\n %endp =l add %argv, 24\n storel 0, %endp\n %status =w call $g4_compiler_dispatch(w 3, l %argv)\n %restored =w call $dup2(w %saved, w 1)\n call $close(w %saved)\n %closed =w call $fclose(l %file)\n %rb =w csltw %restored, 0\n %cb =w cnew %closed, 0\n %iofail =w or %rb, %cb\n jnz %iofail, @fail, @done\n@done\n %result =l extsw %status\n ret %result\n@restore_error\n call $close(w %saved)\n jmp @close\n@close\n call $fclose(l %file)\n@fail\n ret 73\n}\n\n# Override the editor's byte reader so an interrupted blocking read submits a\n# disposable line. Signal setup happens after libedit enters terminal mode.\nfunction w $trbn_getc(l %stream) {\n@start\n %pending =l loadl $trbn_interrupted\n jnz %pending, @interrupted, @read\n@read\n call $native_cli_signals()\n %buffer =l alloc8 8\n %count =l call $read(w 0, l %buffer, l 1)\n %signal =l loadl $trbn_interrupted\n jnz %signal, @interrupted, @received\n@received\n %one =w ceql %count, 1\n jnz %one, @character, @eof\n@character\n %byte =w loadub %buffer\n ret %byte\n@interrupted\n ret 10\n@eof\n ret -1\n}\n"
end
