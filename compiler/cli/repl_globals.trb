import { repl_call } from repl_eval
import { ReplStore, ReplEnvironment, repl_global_key, repl_value } from repl_model
import { repl_capture_binding } from repl_values
import { find_declaration_in_module } from declaration_lookup
import { CompilerState } from state

# A retained REPL program may use different catalog indexes. Persistent values
# are keyed by source/declaration identity, never by the current array position.
def repl_initialize_globals(mut state: CompilerState, mut store: ReplStore): Boolean
	mut added: Array<String> := []
	store.error[0] = ""
	state.global_bindings.global_order.each do |identity|
		key := repl_global_key(state, identity)
		if !store.globals.key?(key)
			value := repl_call(state, state.global_bindings.global_functions[identity], [], store)
			if store.error[0] != ""
				added.each do |name|
					store.globals.delete(name)
				end
				return false
			end
			store.globals[key] = repl_value(store, "$Binding", 0, 0.0, "", [value])
			added.push(key)
		end
	end
	return true
end

# The checked header witnesses existing values; it must never initialize them.
# Named functions and anonymous captures reach the same cell as the session.
def repl_link_globals(state: CompilerState, mut store: ReplStore, mut environment: ReplEnvironment)
	mut binding := 0
	while binding < environment.count[0]
		identity := find_declaration_in_module(state, state.module_graph.entry_module[0], environment.names[binding], 7)
		if identity >= 0
			store.globals[repl_global_key(state, identity)] = repl_capture_binding(store, environment, binding)
		end
		binding += 1
	end
end
