import { native_cli_scalar } from host
import { ReplStore, repl_boolean, repl_integer, repl_string, repl_value } from repl_model
import { repl_none } from repl_nullable

# The retained evaluator compares code points without constructing substrings.
def repl_string_offset(value: String, part: String, kind: Integer): Integer
	last := value.size() - part.size()
	if last < 0
		return - 1
	end
	mut first := 0
	mut finish := last
	if kind == 3
		finish = 0
	elsif kind == 4
		first = last
	end
	mut found :=- 1
	mut start := first
	while start <= finish
		mut index := 0
		while index < part.size()
			if value[start + index] != part[index]
				break
			end
			index += 1
		end
		if index == part.size()
			found = start
			if kind != 6
				return found
			end
		end
		start += 1
	end
	return found
end

def repl_string_method(mut store: ReplStore, kind: Integer, receiver: Integer, argument: Integer): Integer
	value := store.texts[receiver]
	if kind == 10
		bounds := store.children[argument]
		first := store.integers[bounds[0]]
		last := store.integers[bounds[1]]
		exclusive := store.integers[bounds[2]] == 1
		if first < 0 || last < 0 || first > last || last > value.size() || (!exclusive && last == value.size())
			store.error[0] = "panic: String slice range is out of bounds"
			return 0
		end
		mut finish := last
		if !exclusive
			finish += 1
		end
		mut sliced := ""
		mut index := first
		while index < finish
			sliced += value[index]
			index += 1
		end
		return repl_string(store, sliced)
	end
	if kind >= 7
		mut children: Array<Integer> := []
		mut reversed := ""
		mut index := 0
		while index < value.size()
			character := value[index]
			if kind == 7
				children.push(repl_integer(store, native_cli_scalar(character)))
			elsif kind == 8
				children.push(repl_string(store, character))
			else
				reversed = character + reversed
			end
			index += 1
		end
		if kind == 9
			return repl_string(store, reversed)
		end
		mut type_name := "Array<Integer>"
		if kind == 8
			type_name = "Array<String>"
		end
		return repl_value(store, type_name, 0, 0.0, "", children)
	end
	if kind == 1
		return repl_boolean(store, value.size() == 0)
	end
	offset := repl_string_offset(value, store.texts[argument], kind)
	if kind < 5
		return repl_boolean(store, offset >= 0)
	end
	if offset < 0
		return repl_none(store, "Integer?")
	end
	return repl_value(store, "Integer?", 0, 0.0, "", [repl_integer(store, offset)])
end
