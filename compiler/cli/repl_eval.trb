import { hash_key_type, hash_value_type } from hash_types
import { checked_hash_plan } from hash_checked
import { repl_hash_new, repl_hash_set, repl_hash_get, repl_hash_slot, repl_hash_delete, repl_hash_update } from repl_hash
import trb/std/math
import { Gate4Compiler } from state
import { sparse_integer_at, gate4_load_integer, gate4_load_string } from storage
import { syntax_statement_boundary, syntax_iteration_suffix, syntax_loop_transfer_kind, syntax_conditional_tail, gate4_token_is, gate4_binary_operator_id, gate4_binary_precedence, gate4_parse_expression_syntax, gate4_parse_type, gate4_skip_newlines, gate4_declaration_start } from parser
import { mir_logical_short_value } from mir
import { checked_iteration_require, checked_loop_transfer_kind } from checked_program
import { gate4_find_visible_function, gate4_find_visible_record, gate4_find_record_type, gate4_find_field, gate4_record_type, gate4_array_element_type } from resolution
import { gate4_number_is_float, gate4_number_without_underscores, gate4_integer_string } from literals
import { native_cli_float, native_cli_interrupt } from host
import { repl_get, ReplStore, ReplEnvironment, ReplReference, repl_value, repl_integer, repl_float, repl_boolean, repl_string, repl_reference, repl_environment } from repl_model
import { repl_render, repl_find, repl_bind, repl_coerce } from repl_values

# Evaluation follows the already checked token stream. Parser, resolution and
# type checking remain owned by the ordinary compiler; no source is replayed.
def repl_number(text: String): Integer
	mut result := 0
	mut index := 0
	while index < text.size()
		mut digit := 0
		while digit < 10
			if gate4_integer_string(digit) == text[index]
				result = result * 10 + digit
			end
			digit += 1
		end
		index += 1
	end
	return result
end

# Validate before conversion so a bad value reports a recoverable REPL error.
def repl_string_integer(mut store: ReplStore, text: String): Integer
	mut index := 0
	mut negative := false
	if text.size() > 0
		if text[0] == "-"
			negative = true
			index = 1
		end
		if text[0] == "+"
			index = 1
		end
	end
	if index == text.size()
		store.error[0] = "panic: invalid Integer"
		return 0
	end
	mut result := 0
	while index < text.size()
		mut digit := 0
		while digit < 10
			if gate4_integer_string(digit) == text[index]
				if result > (9007199254740991 - digit) / 10
					store.error[0] = "panic: Integer is outside the portable range"
					return 0
				end
				result = result * 10 + digit
				digit = 10
			end
			digit += 1
		end
		if digit == 10
			store.error[0] = "panic: invalid Integer"
			return 0
		end
		index += 1
	end
	if negative
		return - result
	end
	return result
end

def repl_numeric(mut store: ReplStore, left: Integer, operator: String, right: Integer): Integer
	a := repl_get(store, left)
	b := repl_get(store, right)
	if a.type_name == "String"
		if operator == "+"
			return repl_string(store, a.text + b.text)
		end
		if operator == "=="
			return repl_boolean(store, a.text == b.text)
		end
		return repl_boolean(store, a.text != b.text)
	end
	if a.type_name == "Boolean"
		if operator == "=="
			return repl_boolean(store, a.integer == b.integer)
		end
		return repl_boolean(store, a.integer != b.integer)
	end
	mut floating := a.type_name == "Float"
	if b.type_name == "Float"
		floating = true
	end
	if floating
		mut x := a.floating
		mut y := b.floating
		if a.type_name == "Integer"
			x = a.integer
		end
		if b.type_name == "Integer"
			y = b.integer
		end
		if operator == "+"
			return repl_float(store, x + y)
		end
		if operator == "-"
			return repl_float(store, x - y)
		end
		if operator == "*"
			return repl_float(store, x * y)
		end
		if operator == "/"
			return repl_float(store, x / y)
		end
		if operator == "=="
			return repl_boolean(store, x == y)
		end
		if operator == "!="
			return repl_boolean(store, x != y)
		end
		if operator == "<"
			return repl_boolean(store, x < y)
		end
		if operator == "<="
			return repl_boolean(store, x <= y)
		end
		if operator == ">"
			return repl_boolean(store, x > y)
		end
		return repl_boolean(store, x >= y)
	end
	x := a.integer
	y := b.integer
	if operator == "=="
		return repl_boolean(store, x == y)
	end
	if operator == "!="
		return repl_boolean(store, x != y)
	end
	if operator == "<"
		return repl_boolean(store, x < y)
	end
	if operator == "<="
		return repl_boolean(store, x <= y)
	end
	if operator == ">"
		return repl_boolean(store, x > y)
	end
	if operator == ">="
		return repl_boolean(store, x >= y)
	end
	limit := 9007199254740991
	mut overflow := false
	if operator == "+"
		if y > 0
			overflow = x > limit - y
		else
			overflow = x < - limit - y
		end
	end
	if operator == "-"
		if y < 0
			overflow = x > limit + y
		else
			overflow = x < - limit + y
		end
	end
	if operator == "*"
		if y != 0
			mut ax := x
			mut ay := y
			if ax < 0
				ax =- ax
			end
			if ay < 0
				ay =- ay
			end
			overflow = ax > limit / ay
		end
	end
	if overflow
		store.error[0] = "panic: Integer is outside the portable range"
		return 0
	end
	if operator == "+"
		return repl_integer(store, x + y)
	end
	if operator == "-"
		return repl_integer(store, x - y)
	end
	if operator == "*"
		return repl_integer(store, x * y)
	end
	if y == 0
		store.error[0] = "panic: division by zero"
		return 0
	end
	if operator == "/"
		return repl_integer(store, x / y)
	end
	return repl_integer(store, x % y)
end

def repl_call(mut state: Gate4Compiler, function: Integer, arguments: Array<Integer>, mut store: ReplStore): Integer
	if store.depth[0] > 256
		store.error[0] = "REPL call depth limit exceeded"
		return 0
	end
	store.depth[0] += 1
	mut environment := repl_environment()
	start := gate4_load_integer(state.function_parameter_starts, function)
	mut index := 0
	while index < arguments.size()
		type_name := gate4_load_string(state.parameter_types, start + index)
		value := repl_coerce(store, arguments[index], type_name)
		repl_bind(environment, gate4_load_string(state.parameter_names, start + index), value, gate4_load_integer(state.parameter_mutable, start + index))
		index += 1
	end
	mut position := [gate4_load_integer(state.function_body_starts, function)]
	mut flow := [0]
	module_name := state.active_module[0]
	state.active_module[0] = gate4_load_integer(state.function_modules, function)
	result := repl_block(state, position, store, environment, flow, - 1)
	state.active_module[0] = module_name
	store.depth[0] -= 1
	return repl_coerce(store, result, gate4_load_string(state.function_result_types, function))
end

def repl_primary(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, expected: String): ReplReference
	text := gate4_load_string(state.token_texts, position[0])
	kind := gate4_load_integer(state.token_kinds, position[0])
	position[0] += 1
	if kind == 2
		if gate4_number_is_float(text)
			return repl_reference(repl_float(store, native_cli_float(gate4_number_without_underscores(text))))
		end
		return repl_reference(repl_integer(store, repl_number(text)))
	end
	if kind == 3
		return repl_reference(repl_string(store, text))
	end
	if text == "true"
		return repl_reference(repl_boolean(store, true))
	end
	if text == "false"
		return repl_reference(repl_boolean(store, false))
	end
	if text == "-"
		operand := repl_expression(state, position, store, environment, 7, "")
		value := repl_get(store, operand.value)
		if value.type_name == "Float"
			return repl_reference(repl_float(store, - value.floating))
		end
		return repl_reference(repl_integer(store, - value.integer))
	end
	if text == "!"
		operand := repl_expression(state, position, store, environment, 7, "Boolean")
		return repl_reference(repl_boolean(store, store.integers[operand.value] == 0))
	end
	if text == "("
		result := repl_expression(state, position, store, environment, 1, expected)
		position[0] += 1
		return result
	end
	if text == "{"
		plan := checked_hash_plan(state, position[0] - 1)
		id := repl_hash_new(store, plan.type_name, plan.capacity)
		gate4_skip_newlines(state, position)
		while !gate4_token_is(state, position[0], "}")
			key := repl_expression(state, position, store, environment, 1, plan.key_type)
			position[0] += 1
			item := repl_expression(state, position, store, environment, 1, plan.value_type)
			if store.error[0] != ""
				return repl_reference(0)
			end
			repl_hash_set(store, id, key.value, repl_coerce(store, item.value, plan.value_type))
			gate4_skip_newlines(state, position)
			if gate4_token_is(state, position[0], ",")
				position[0] += 1
			end
			gate4_skip_newlines(state, position)
		end
		position[0] += 1
		return repl_reference(id)
	end
	if text == "["
		mut children: Array<Integer> := []
		mut element := gate4_array_element_type(expected)
		gate4_skip_newlines(state, position)
		while !gate4_token_is(state, position[0], "]")
			value := repl_expression(state, position, store, environment, 1, element)
			if element == ""
				element = store.types[value.value]
			end
			if element == "Integer"
				if store.types[value.value] == "Float"
					element = "Float"
				end
			end
			children.push(value.value)
			if gate4_token_is(state, position[0], ",")
				position[0] += 1
			end
			gate4_skip_newlines(state, position)
			if store.error[0] != ""
				return repl_reference(0)
			end
		end
		position[0] += 1
		mut child := 0
		while child < children.size()
			children[child] = repl_coerce(store, children[child], element)
			child += 1
		end
		return repl_reference(repl_value(store, "Array<" + element + ">", 0, 0.0, "", children))
	end
	binding := repl_find(environment, text)
	if binding >= 0
		return ReplReference.new(value: environment.values[binding], binding: binding, container: - 1, slot: - 1)
	end
	if gate4_token_is(state, position[0], "(")
		function := gate4_find_visible_function(state, state.active_module[0], text)
		mut arguments: Array<Integer> := []
		position[0] += 1
		gate4_skip_newlines(state, position)
		while !gate4_token_is(state, position[0], ")")
			mut parameter_type := "String"
			if function >= 0
				start := gate4_load_integer(state.function_parameter_starts, function)
				parameter_type = gate4_load_string(state.parameter_types, start + arguments.size())
			end
			value := repl_expression(state, position, store, environment, 1, parameter_type)
			arguments.push(repl_coerce(store, value.value, parameter_type))
			if gate4_token_is(state, position[0], ",")
				position[0] += 1
			end
			gate4_skip_newlines(state, position)
			if store.error[0] != ""
				return repl_reference(0)
			end
		end
		position[0] += 1
		if text == "puts"
			if store.types[arguments[0]] == "String"
				puts(store.texts[arguments[0]])
			else
				puts(repl_render(state, store, arguments[0], 0))
			end
			return repl_reference(0)
		end
		if function >= 0
			return repl_reference(repl_call(state, function, arguments, store))
		end
	end
	if gate4_token_is(state, position[0], ".")
		position[0] += 1
		member := gate4_load_string(state.token_texts, position[0])
		position[0] += 2
		if text == "Math"
			argument := repl_expression(state, position, store, environment, 1, "Float")
			position[0] += 1
			value := repl_coerce(store, argument.value, "Float")
			return repl_reference(repl_float(store, Math.sqrt(store.floats[value])))
		end
		if text == "Process"
			position[0] += 1
			return repl_reference(repl_value(store, "Array<String>", 0, 0.0, "", []))
		end
		record_index := gate4_find_visible_record(state, state.active_module[0], text)
		if record_index >= 0
			if member == "new"
				start := gate4_load_integer(state.record_field_starts, record_index)
				count := gate4_load_integer(state.record_field_counts, record_index)
				mut children: Array<Integer> := []
				mut index := 0
				while index < count
					children.push(0)
					index += 1
				end
				gate4_skip_newlines(state, position)
				while !gate4_token_is(state, position[0], ")")
					name := gate4_load_string(state.token_texts, position[0])
					position[0] += 2
					field := gate4_find_field(state, record_index, name)
					type_name := gate4_load_string(state.field_types, field)
					value := repl_expression(state, position, store, environment, 1, type_name)
					children[field - start] = repl_coerce(store, value.value, type_name)
					if gate4_token_is(state, position[0], ",")
						position[0] += 1
					end
					gate4_skip_newlines(state, position)
				end
				position[0] += 1
				return repl_reference(repl_value(store, gate4_record_type(record_index), 0, 0.0, "", children))
			end
		end
	end
	store.error[0] = "unsupported checked REPL expression " + text
	return repl_reference(0)
end

def repl_postfix(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, expected: String): ReplReference
	mut result := repl_primary(state, position, store, environment, expected)
	mut complete := false
	while !complete
		if store.error[0] != ""
			return repl_reference(0)
		end
		value := repl_get(store, result.value)
		if gate4_token_is(state, position[0], "[")
			if value.type_name == "Hash" || hash_key_type(value.type_name) != ""
				plan := checked_hash_plan(state, position[0])
				store.types[result.value] = plan.type_name
				position[0] += 1
				key := repl_expression(state, position, store, environment, 1, plan.key_type)
				position[0] += 1
				if plan.kind == 3
					result = ReplReference.new(value: 0, binding: - 1, container: result.value, slot: key.value)
				else
					result = repl_reference(repl_hash_get(store, result.value, key.value))
				end
				next
			end
			position[0] += 1
			requested := repl_expression(state, position, store, environment, 1, "Integer")
			position[0] += 1
			mut length := value.children.size()
			if value.type_name == "String"
				length = value.text.size()
			end
			mut index := store.integers[requested.value]
			if index < 0
				index += length
			end
			if index < 0
				store.error[0] = "panic: index is out of bounds"
				return repl_reference(0)
			end
			if index >= length
				store.error[0] = "panic: index is out of bounds"
				return repl_reference(0)
			end
			if value.type_name == "String"
				result = repl_reference(repl_string(store, value.text[index]))
			else
				result = ReplReference.new(value: value.children[index], binding: - 1, container: result.value, slot: index)
			end
		else
			if gate4_token_is(state, position[0], ".")
				if syntax_iteration_suffix(state, position[0]) >= 0
					break
				end
				position[0] += 1
				member := gate4_load_string(state.token_texts, position[0])
				position[0] += 1
				if gate4_token_is(state, position[0], "(")
					if value.type_name == "Hash" || hash_key_type(value.type_name) != ""
						result = repl_reference(repl_hash_method(state, position, store, environment, result.value))
						next
					end
					position[0] += 1
					if member == "push"
						argument := repl_expression(state, position, store, environment, 1, gate4_array_element_type(value.type_name))
						store.children[result.value].push(repl_coerce(store, argument.value, gate4_array_element_type(value.type_name)))
						result = repl_reference(0)
					else
						if member == "size"
							mut size := value.children.size()
							if value.type_name == "String"
								size = value.text.size()
							end
							result = repl_reference(repl_integer(store, size))
						else
							if member == "to_s"
								result = repl_reference(repl_string(store, gate4_integer_string(value.integer)))
							else
								if member == "to_i"
									if value.type_name == "Float"
										if value.floating != value.floating
											store.error[0] = "panic: Float cannot be converted to Integer"
										else
											if value.floating > 9007199254740991.0
												store.error[0] = "panic: Float cannot be converted to Integer"
											else
												if value.floating < - 9007199254740991.0
													store.error[0] = "panic: Float cannot be converted to Integer"
												else
													result = repl_reference(repl_integer(store, value.floating.to_i()))
												end
											end
										end
									else
										result = repl_reference(repl_integer(store, repl_string_integer(store, value.text)))
									end
								end
							end
						end
					end
					position[0] += 1
				else
					record_index := gate4_find_record_type(state, value.type_name)
					field := gate4_find_field(state, record_index, member)
					start := gate4_load_integer(state.record_field_starts, record_index)
					result = ReplReference.new(value: value.children[field - start], binding: - 1, container: result.value, slot: field - start)
				end
			else
				complete = true
			end
		end
	end
	return result
end

def repl_expression(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, minimum: Integer, expected: String): ReplReference
	mut result := repl_postfix(state, position, store, environment, expected)
	mut complete := false
	while !complete
		if store.error[0] != ""
			return repl_reference(0)
		end
		operator := gate4_load_string(state.token_texts, position[0])
		precedence := gate4_binary_precedence(operator)
		if precedence < minimum
			complete = true
		else
			position[0] += 1
			origin := position[0] - 1
			gate4_skip_newlines(state, position)
			if precedence <= 2
				plan := gate4_load_integer(state.mir_nonnegative_facts, origin)
				short_value := mir_logical_short_value(plan)
				if short_value < 0 || plan - 64 != gate4_binary_operator_id(operator)
					store.error[0] = "invalid checked logical plan"
					return repl_reference(0)
				end
				if store.integers[result.value] == short_value
					# The frontend already checked both regions. Advance through
					# skipped syntax without evaluating calls, allocations or traps.
					if !gate4_parse_expression_syntax(state, position, precedence + 1)
						store.error[0] = "invalid checked logical right-hand side"
					end
					result = repl_reference(result.value)
				else
					result = repl_reference(repl_expression(state, position, store, environment, precedence + 1, "Boolean").value)
				end
			else
				right := repl_expression(state, position, store, environment, precedence + 1, "")
				result = repl_reference(repl_numeric(store, result.value, operator, right.value))
			end
		end
	end
	return result
end

def repl_block_end(state: Gate4Compiler, start: Integer, stop_else: Boolean): Integer
	mut position := start
	mut depth := 0
	while position < state.token_count[0]
		encoded_iteration := sparse_integer_at(state.iteration_origins, position)
		if encoded_iteration > 0 && encoded_iteration <= state.iterations.size()
			position = state.iterations[encoded_iteration - 1].finish
			next
		end
		if gate4_token_is(state, position, "if")
			depth += 1
		end
		if gate4_token_is(state, position, "while")
			depth += 1
		end
		if gate4_token_is(state, position, "end")
			if depth == 0
				return position
			end
			depth -= 1
		end
		if stop_else
			if depth == 0
				if syntax_conditional_tail(state, position)
					return position
				end
			end
		end
		position += 1
	end
	return position
end

def repl_iteration(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, mut flow: Array<Integer>, parent_loop: Integer): Integer
	plan := checked_iteration_require(state, position[0], parent_loop)
	if plan.origin < 0
		store.error[0] = "invalid checked Array iteration"
		return 0
	end
	receiver := repl_expression(state, position, store, environment, 1, plan.type_name).value
	if store.error[0] != ""
		return 0
	end
	if store.types[receiver] != plan.type_name || position[0] != plan.receiver_finish
		store.error[0] = "Array iteration receiver disagrees with checked MIR"
		return 0
	end
	saved := environment.count[0]
	mut cursor := 0
	mut result := 0
	while cursor < store.children[receiver].size()
		environment.count[0] = saved
		repl_bind(environment, gate4_load_string(state.token_texts, plan.element_origin), store.children[receiver][cursor], 1)
		if plan.index_origin >= 0
			repl_bind(environment, gate4_load_string(state.token_texts, plan.index_origin), repl_integer(store, cursor), 1)
		end
		position[0] = plan.body_start
		result = repl_block(state, position, store, environment, flow, plan.origin)
		if flow[0] == 2
			flow[0] = 0
			break
		elsif flow[0] == 3
			flow[0] = 0
		elsif flow[0] != 0
			break
		end
		if store.error[0] != ""
			break
		end
		cursor += 1
	end
	environment.count[0] = saved
	position[0] = plan.finish
	if flow[0] == 1
		return result
	end
	return 0
end

def repl_statement(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, mut flow: Array<Integer>, loop_origin: Integer): Integer
	if sparse_integer_at(state.iteration_origins, position[0]) > 0
		return repl_iteration(state, position, store, environment, flow, loop_origin)
	end
	if gate4_token_is(state, position[0], "if")
		finish := repl_block_end(state, position[0] + 1, false)
		saved := environment.count[0]
		mut result := 0
		mut complete := false
		while !complete
			position[0] += 1
			condition := repl_expression(state, position, store, environment, 1, "Boolean")
			if store.error[0] != ""
				return 0
			end
			gate4_skip_newlines(state, position)
			if store.integers[condition.value] != 0
				result = repl_block(state, position, store, environment, flow, loop_origin)
				complete = true
			else
				boundary := repl_block_end(state, position[0], true)
				position[0] = boundary
				if !gate4_token_is(state, boundary, "elsif")
					if gate4_token_is(state, boundary, "else")
						position[0] += 1
						result = repl_block(state, position, store, environment, flow, loop_origin)
					end
					complete = true
				end
			end
		end
		environment.count[0] = saved
		position[0] = finish + 1
		return result
	end
	if gate4_token_is(state, position[0], "while")
		start := position[0] + 1
		finish := repl_block_end(state, start, false)
		mut running := true
		mut result := 0
		while running
			position[0] = start
			condition := repl_expression(state, position, store, environment, 1, "Boolean")
			if store.integers[condition.value] == 0
				running = false
			else
				saved := environment.count[0]
				result = repl_block(state, position, store, environment, flow, start - 1)
				environment.count[0] = saved
			end
			if flow[0] == 2
				flow[0] = 0
				running = false
			elsif flow[0] == 3
				flow[0] = 0
			elsif flow[0] != 0
				running = false
			end
			if store.error[0] != ""
				running = false
			end
		end
		position[0] = finish + 1
		return result
	end
	if syntax_loop_transfer_kind(state, position[0]) > 0
		kind := checked_loop_transfer_kind(state, position[0], loop_origin)
		if kind == 0
			store.error[0] = "invalid checked loop transfer target"
			return 0
		end
		# Return remains 1; the nearest while consumes exit/header transfers.
		flow[0] = kind + 1
		position[0] += 1
		return 0
	end
	if gate4_token_is(state, position[0], "return")
		position[0] += 1
		flow[0] = 1
		if syntax_statement_boundary(state, position[0])
			return 0
		end
		value := repl_expression(state, position, store, environment, 1, "")
		return value.value
	end
	if gate4_declaration_start(state, position[0])
		mut mutable := 0
		if gate4_token_is(state, position[0], "mut")
			mutable = 1
			position[0] += 1
		end
		name := gate4_load_string(state.token_texts, position[0])
		position[0] += 1
		mut expected := ""
		if gate4_token_is(state, position[0], ":")
			position[0] += 1
			expected = gate4_parse_type(state, position)
		end
		position[0] += 1
		value := repl_expression(state, position, store, environment, 1, expected)
		result := repl_coerce(store, value.value, expected)
		if store.error[0] == ""
			repl_bind(environment, name, result, mutable)
		end
		return result
	end
	left := repl_expression(state, position, store, environment, 1, "")
	if store.error[0] != ""
		return 0
	end
	operator := gate4_load_string(state.token_texts, position[0])
	mut assignment := operator == "="
	if operator == "+="
		assignment = true
	end
	if operator == "-="
		assignment = true
	end
	if operator == "*="
		assignment = true
	end
	if operator == "/="
		assignment = true
	end
	if operator == "%="
		assignment = true
	end
	if assignment
		position[0] += 1
		mut expected := store.types[left.value]
		mut hash_assignment := false
		if left.container >= 0
			if hash_key_type(store.types[left.container]) != ""
				hash_assignment = true
				expected = hash_value_type(store.types[left.container])
			end
		end
		right := repl_expression(state, position, store, environment, 1, expected)
		mut result := repl_coerce(store, right.value, expected)
		if operator != "="
			result = repl_numeric(store, left.value, operator[0], result)
		end
		if store.error[0] == ""
			if hash_assignment
				repl_hash_set(store, left.container, left.slot, result)
				return result
			end
			if left.binding >= 0
				environment.values[left.binding] = result
			else
				if left.slot >= store.children[left.container].size()
					store.error[0] = "panic: index is out of bounds"
					return 0
				end
				store.children[left.container][left.slot] = result
			end
		end
		return result
	end
	return left.value
end

def repl_block(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, mut flow: Array<Integer>, loop_origin: Integer): Integer
	mut result := 0
	gate4_skip_newlines(state, position)
	mut complete := false
	while !complete
		if native_cli_interrupt(0) != 0
			store.error[0] = "Interrupted"
		end
		if store.error[0] != ""
			return 0
		end
		if (gate4_token_is(state, position[0], "end") || gate4_token_is(state, position[0], "}"))
			complete = true
		else
			if syntax_conditional_tail(state, position[0])
				complete = true
			else
				result = repl_statement(state, position, store, environment, flow, loop_origin)
				gate4_skip_newlines(state, position)
				if flow[0] != 0
					complete = true
				end
			end
		end
	end
	return result
end

# Consume the same checked operation plans as ordinary code generation.
def repl_hash_method(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, receiver: Integer): Integer
	plan := checked_hash_plan(state, position[0])
	position[0] += 1
	store.types[receiver] = plan.type_name
	mut argument := 0
	if plan.kind == 5 || plan.kind == 6 || plan.kind == 13
		argument = repl_expression(state, position, store, environment, 1, plan.key_type).value
	end
	if plan.kind == 8 || plan.kind == 9
		argument = repl_expression(state, position, store, environment, 1, plan.type_name).value
	end
	gate4_skip_newlines(state, position)
	position[0] += 1
	if store.error[0] != ""
		return 0
	end
	table := store.hashes[store.integers[receiver]]
	if plan.kind == 4
		return repl_integer(store, table.sizes[0])
	elsif plan.kind == 12
		return repl_boolean(store, table.sizes[0] == 0)
	elsif plan.kind == 5
		return repl_boolean(store, repl_hash_slot(store, table, argument) >= 0)
	elsif plan.kind == 13
		return repl_hash_get(store, receiver, argument)
	elsif plan.kind == 6
		return repl_hash_delete(store, receiver, argument)
	elsif plan.kind == 9
		repl_hash_update(store, receiver, argument)
		return 0
	elsif plan.kind == 7 || plan.kind == 8
		copy := repl_hash_new(store, plan.type_name, table.keys.size())
		repl_hash_update(store, copy, receiver)
		if plan.kind == 8
			repl_hash_update(store, copy, argument)
		end
		return copy
	end
	mut children: Array<Integer> := []
	mut index := 0
	while index < table.keys.size()
		if table.keys[index] > 0
			if plan.kind == 10
				children.push(table.keys[index])
			else
				children.push(table.values[index])
			end
		end
		index += 1
	end
	mut element := plan.value_type
	if plan.kind == 10
		element = plan.key_type
	end
	return repl_value(store, "Array<" + element + ">", 0, 0.0, "", children)
end
