import trb/std/math
import { Gate4Compiler } from state
import { gate4_load_integer, gate4_load_string } from storage
import { gate4_token_is, gate4_binary_precedence, gate4_parse_type, gate4_skip_newlines, gate4_declaration_start } from parser
import { gate4_find_visible_function, gate4_find_visible_record, gate4_find_record_type, gate4_find_field, gate4_record_type, gate4_array_element_type } from resolution
import { gate4_number_is_float, gate4_number_without_underscores, gate4_integer_string } from literals
import { native_cli_float, native_cli_interrupt } from host
import { repl_render, repl_get, ReplStore, ReplEnvironment, ReplReference, repl_value, repl_integer, repl_float, repl_boolean, repl_string, repl_reference, repl_find, repl_bind, repl_environment, repl_coerce } from repl_values

# Evaluation follows the already checked token stream. Parser, resolution and
# type checking remain owned by the ordinary compiler; no source is replayed.
def repl_number(text: String): Integer
	mut result := 0
	mut index := 0
	while index < text.size()
		mut digit := 0
		while digit < 10
			if gate4_integer_string(digit) == text[index]
				result = result * 10 + digit
			end
			digit += 1
		end
		index += 1
	end
	return result
end

# Validate before conversion so a bad value reports a recoverable REPL error.
def repl_string_integer(mut store: ReplStore, text: String): Integer
	mut index := 0
	mut negative := false
	if text.size() > 0
		if text[0] == "-"
			negative = true
			index = 1
		end
		if text[0] == "+"
			index = 1
		end
	end
	if index == text.size()
		store.error[0] = "panic: invalid Integer"
		return 0
	end
	mut result := 0
	while index < text.size()
		mut digit := 0
		while digit < 10
			if gate4_integer_string(digit) == text[index]
				if result > (9007199254740991 - digit) / 10
					store.error[0] = "panic: Integer is outside the portable range"
					return 0
				end
				result = result * 10 + digit
				digit = 10
			end
			digit += 1
		end
		if digit == 10
			store.error[0] = "panic: invalid Integer"
			return 0
		end
		index += 1
	end
	if negative
		return - result
	end
	return result
end

def repl_numeric(mut store: ReplStore, left: Integer, operator: String, right: Integer): Integer
	a := repl_get(store, left)
	b := repl_get(store, right)
	if a.type_name == "String"
		if operator == "+"
			return repl_string(store, a.text + b.text)
		end
		if operator == "=="
			return repl_boolean(store, a.text == b.text)
		end
		return repl_boolean(store, a.text != b.text)
	end
	if a.type_name == "Boolean"
		if operator == "=="
			return repl_boolean(store, a.integer == b.integer)
		end
		return repl_boolean(store, a.integer != b.integer)
	end
	mut floating := a.type_name == "Float"
	if b.type_name == "Float"
		floating = true
	end
	if floating
		mut x := a.floating
		mut y := b.floating
		if a.type_name == "Integer"
			x = a.integer
		end
		if b.type_name == "Integer"
			y = b.integer
		end
		if operator == "+"
			return repl_float(store, x + y)
		end
		if operator == "-"
			return repl_float(store, x - y)
		end
		if operator == "*"
			return repl_float(store, x * y)
		end
		if operator == "/"
			return repl_float(store, x / y)
		end
		if operator == "=="
			return repl_boolean(store, x == y)
		end
		if operator == "!="
			return repl_boolean(store, x != y)
		end
		if operator == "<"
			return repl_boolean(store, x < y)
		end
		if operator == "<="
			return repl_boolean(store, x <= y)
		end
		if operator == ">"
			return repl_boolean(store, x > y)
		end
		return repl_boolean(store, x >= y)
	end
	x := a.integer
	y := b.integer
	if operator == "=="
		return repl_boolean(store, x == y)
	end
	if operator == "!="
		return repl_boolean(store, x != y)
	end
	if operator == "<"
		return repl_boolean(store, x < y)
	end
	if operator == "<="
		return repl_boolean(store, x <= y)
	end
	if operator == ">"
		return repl_boolean(store, x > y)
	end
	if operator == ">="
		return repl_boolean(store, x >= y)
	end
	limit := 9007199254740991
	mut overflow := false
	if operator == "+"
		if y > 0
			overflow = x > limit - y
		else
			overflow = x < - limit - y
		end
	end
	if operator == "-"
		if y < 0
			overflow = x > limit + y
		else
			overflow = x < - limit + y
		end
	end
	if operator == "*"
		if y != 0
			mut ax := x
			mut ay := y
			if ax < 0
				ax =- ax
			end
			if ay < 0
				ay =- ay
			end
			overflow = ax > limit / ay
		end
	end
	if overflow
		store.error[0] = "panic: Integer is outside the portable range"
		return 0
	end
	if operator == "+"
		return repl_integer(store, x + y)
	end
	if operator == "-"
		return repl_integer(store, x - y)
	end
	if operator == "*"
		return repl_integer(store, x * y)
	end
	if y == 0
		store.error[0] = "panic: division by zero"
		return 0
	end
	if operator == "/"
		return repl_integer(store, x / y)
	end
	return repl_integer(store, x % y)
end

def repl_call(mut state: Gate4Compiler, function: Integer, arguments: Array<Integer>, mut store: ReplStore): Integer
	if store.depth[0] > 256
		store.error[0] = "REPL call depth limit exceeded"
		return 0
	end
	store.depth[0] += 1
	mut environment := repl_environment()
	start := gate4_load_integer(state.function_parameter_starts, function)
	mut index := 0
	while index < arguments.size()
		type_name := gate4_load_string(state.parameter_types, start + index)
		value := repl_coerce(store, arguments[index], type_name)
		repl_bind(environment, gate4_load_string(state.parameter_names, start + index), value, gate4_load_integer(state.parameter_mutable, start + index))
		index += 1
	end
	mut position := [gate4_load_integer(state.function_body_starts, function)]
	mut flow := [0]
	module_name := state.active_module[0]
	state.active_module[0] = gate4_load_integer(state.function_modules, function)
	result := repl_block(state, position, store, environment, flow)
	state.active_module[0] = module_name
	store.depth[0] -= 1
	return repl_coerce(store, result, gate4_load_string(state.function_result_types, function))
end

def repl_primary(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, expected: String): ReplReference
	text := gate4_load_string(state.token_texts, position[0])
	kind := gate4_load_integer(state.token_kinds, position[0])
	position[0] += 1
	if kind == 2
		if gate4_number_is_float(text)
			return repl_reference(repl_float(store, native_cli_float(gate4_number_without_underscores(text))))
		end
		return repl_reference(repl_integer(store, repl_number(text)))
	end
	if kind == 3
		return repl_reference(repl_string(store, text))
	end
	if text == "true"
		return repl_reference(repl_boolean(store, true))
	end
	if text == "false"
		return repl_reference(repl_boolean(store, false))
	end
	if text == "-"
		operand := repl_expression(state, position, store, environment, 4, "")
		value := repl_get(store, operand.value)
		if value.type_name == "Float"
			return repl_reference(repl_float(store, - value.floating))
		end
		return repl_reference(repl_integer(store, - value.integer))
	end
	if text == "!"
		operand := repl_expression(state, position, store, environment, 4, "Boolean")
		return repl_reference(repl_boolean(store, store.integers[operand.value] == 0))
	end
	if text == "("
		result := repl_expression(state, position, store, environment, 1, expected)
		position[0] += 1
		return result
	end
	if text == "["
		mut children: Array<Integer> := []
		mut element := gate4_array_element_type(expected)
		gate4_skip_newlines(state, position)
		while !gate4_token_is(state, position[0], "]")
			value := repl_expression(state, position, store, environment, 1, element)
			if element == ""
				element = store.types[value.value]
			end
			if element == "Integer"
				if store.types[value.value] == "Float"
					element = "Float"
				end
			end
			children.push(value.value)
			if gate4_token_is(state, position[0], ",")
				position[0] += 1
			end
			gate4_skip_newlines(state, position)
			if store.error[0] != ""
				return repl_reference(0)
			end
		end
		position[0] += 1
		mut child := 0
		while child < children.size()
			children[child] = repl_coerce(store, children[child], element)
			child += 1
		end
		return repl_reference(repl_value(store, "Array<" + element + ">", 0, 0.0, "", children))
	end
	binding := repl_find(environment, text)
	if binding >= 0
		return ReplReference.new(value: environment.values[binding], binding: binding, container: - 1, slot: - 1)
	end
	if gate4_token_is(state, position[0], "(")
		function := gate4_find_visible_function(state, state.active_module[0], text)
		mut arguments: Array<Integer> := []
		position[0] += 1
		gate4_skip_newlines(state, position)
		while !gate4_token_is(state, position[0], ")")
			mut parameter_type := "String"
			if function >= 0
				start := gate4_load_integer(state.function_parameter_starts, function)
				parameter_type = gate4_load_string(state.parameter_types, start + arguments.size())
			end
			value := repl_expression(state, position, store, environment, 1, parameter_type)
			arguments.push(repl_coerce(store, value.value, parameter_type))
			if gate4_token_is(state, position[0], ",")
				position[0] += 1
			end
			gate4_skip_newlines(state, position)
			if store.error[0] != ""
				return repl_reference(0)
			end
		end
		position[0] += 1
		if text == "puts"
			if store.types[arguments[0]] == "String"
				puts(store.texts[arguments[0]])
			else
				puts(repl_render(state, store, arguments[0], 0))
			end
			return repl_reference(0)
		end
		if function >= 0
			return repl_reference(repl_call(state, function, arguments, store))
		end
	end
	if gate4_token_is(state, position[0], ".")
		position[0] += 1
		member := gate4_load_string(state.token_texts, position[0])
		position[0] += 2
		if text == "Math"
			argument := repl_expression(state, position, store, environment, 1, "Float")
			position[0] += 1
			value := repl_coerce(store, argument.value, "Float")
			return repl_reference(repl_float(store, Math.sqrt(store.floats[value])))
		end
		if text == "Process"
			position[0] += 1
			return repl_reference(repl_value(store, "Array<String>", 0, 0.0, "", []))
		end
		record_index := gate4_find_visible_record(state, state.active_module[0], text)
		if record_index >= 0
			if member == "new"
				start := gate4_load_integer(state.record_field_starts, record_index)
				count := gate4_load_integer(state.record_field_counts, record_index)
				mut children: Array<Integer> := []
				mut index := 0
				while index < count
					children.push(0)
					index += 1
				end
				gate4_skip_newlines(state, position)
				while !gate4_token_is(state, position[0], ")")
					name := gate4_load_string(state.token_texts, position[0])
					position[0] += 2
					field := gate4_find_field(state, record_index, name)
					type_name := gate4_load_string(state.field_types, field)
					value := repl_expression(state, position, store, environment, 1, type_name)
					children[field - start] = repl_coerce(store, value.value, type_name)
					if gate4_token_is(state, position[0], ",")
						position[0] += 1
					end
					gate4_skip_newlines(state, position)
				end
				position[0] += 1
				return repl_reference(repl_value(store, gate4_record_type(record_index), 0, 0.0, "", children))
			end
		end
	end
	store.error[0] = "unsupported checked REPL expression " + text
	return repl_reference(0)
end

def repl_postfix(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, expected: String): ReplReference
	mut result := repl_primary(state, position, store, environment, expected)
	mut complete := false
	while !complete
		if store.error[0] != ""
			return repl_reference(0)
		end
		value := repl_get(store, result.value)
		if gate4_token_is(state, position[0], "[")
			position[0] += 1
			requested := repl_expression(state, position, store, environment, 1, "Integer")
			position[0] += 1
			mut length := value.children.size()
			if value.type_name == "String"
				length = value.text.size()
			end
			mut index := store.integers[requested.value]
			if index < 0
				index += length
			end
			if index < 0
				store.error[0] = "panic: index is out of bounds"
				return repl_reference(0)
			end
			if index >= length
				store.error[0] = "panic: index is out of bounds"
				return repl_reference(0)
			end
			if value.type_name == "String"
				result = repl_reference(repl_string(store, value.text[index]))
			else
				result = ReplReference.new(value: value.children[index], binding: - 1, container: result.value, slot: index)
			end
		else
			if gate4_token_is(state, position[0], ".")
				position[0] += 1
				member := gate4_load_string(state.token_texts, position[0])
				position[0] += 1
				if gate4_token_is(state, position[0], "(")
					position[0] += 1
					if member == "push"
						argument := repl_expression(state, position, store, environment, 1, gate4_array_element_type(value.type_name))
						store.children[result.value].push(repl_coerce(store, argument.value, gate4_array_element_type(value.type_name)))
						result = repl_reference(0)
					else
						if member == "size"
							mut size := value.children.size()
							if value.type_name == "String"
								size = value.text.size()
							end
							result = repl_reference(repl_integer(store, size))
						else
							if member == "to_s"
								result = repl_reference(repl_string(store, gate4_integer_string(value.integer)))
							else
								if member == "to_i"
									if value.type_name == "Float"
										if value.floating != value.floating
											store.error[0] = "panic: Float cannot be converted to Integer"
										else
											if value.floating > 9007199254740991.0
												store.error[0] = "panic: Float cannot be converted to Integer"
											else
												if value.floating < - 9007199254740991.0
													store.error[0] = "panic: Float cannot be converted to Integer"
												else
													result = repl_reference(repl_integer(store, value.floating.to_i()))
												end
											end
										end
									else
										result = repl_reference(repl_integer(store, repl_string_integer(store, value.text)))
									end
								end
							end
						end
					end
					position[0] += 1
				else
					record_index := gate4_find_record_type(state, value.type_name)
					field := gate4_find_field(state, record_index, member)
					start := gate4_load_integer(state.record_field_starts, record_index)
					result = ReplReference.new(value: value.children[field - start], binding: - 1, container: result.value, slot: field - start)
				end
			else
				complete = true
			end
		end
	end
	return result
end

def repl_expression(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, minimum: Integer, expected: String): ReplReference
	mut result := repl_postfix(state, position, store, environment, expected)
	mut complete := false
	while !complete
		if store.error[0] != ""
			return repl_reference(0)
		end
		operator := gate4_load_string(state.token_texts, position[0])
		precedence := gate4_binary_precedence(operator)
		if precedence < minimum
			complete = true
		else
			position[0] += 1
			right := repl_expression(state, position, store, environment, precedence + 1, "")
			result = repl_reference(repl_numeric(store, result.value, operator, right.value))
		end
	end
	return result
end

def repl_block_end(state: Gate4Compiler, start: Integer, stop_else: Boolean): Integer
	mut position := start
	mut depth := 0
	while position < state.token_count[0]
		if gate4_token_is(state, position, "if")
			depth += 1
		end
		if gate4_token_is(state, position, "while")
			depth += 1
		end
		if gate4_token_is(state, position, "end")
			if depth == 0
				return position
			end
			depth -= 1
		end
		if stop_else
			if depth == 0
				if gate4_token_is(state, position, "else")
					return position
				end
			end
		end
		position += 1
	end
	return position
end

def repl_statement(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, mut flow: Array<Integer>): Integer
	if gate4_token_is(state, position[0], "if")
		position[0] += 1
		condition := repl_expression(state, position, store, environment, 1, "Boolean")
		gate4_skip_newlines(state, position)
		boundary := repl_block_end(state, position[0], true)
		finish := repl_block_end(state, position[0], false)
		saved := environment.count[0]
		mut result := 0
		if store.integers[condition.value] != 0
			result = repl_block(state, position, store, environment, flow)
		else
			if gate4_token_is(state, boundary, "else")
				position[0] = boundary + 1
				result = repl_block(state, position, store, environment, flow)
			end
		end
		environment.count[0] = saved
		position[0] = finish + 1
		return result
	end
	if gate4_token_is(state, position[0], "while")
		start := position[0] + 1
		finish := repl_block_end(state, start, false)
		mut running := true
		mut result := 0
		while running
			position[0] = start
			condition := repl_expression(state, position, store, environment, 1, "Boolean")
			if store.integers[condition.value] == 0
				running = false
			else
				saved := environment.count[0]
				result = repl_block(state, position, store, environment, flow)
				environment.count[0] = saved
			end
			if flow[0] != 0
				running = false
			end
			if store.error[0] != ""
				running = false
			end
		end
		position[0] = finish + 1
		return result
	end
	if gate4_token_is(state, position[0], "return")
		position[0] += 1
		flow[0] = 1
		if gate4_load_integer(state.token_kinds, position[0]) == 4
			return 0
		end
		value := repl_expression(state, position, store, environment, 1, "")
		return value.value
	end
	if gate4_declaration_start(state, position[0])
		mut mutable := 0
		if gate4_token_is(state, position[0], "mut")
			mutable = 1
			position[0] += 1
		end
		name := gate4_load_string(state.token_texts, position[0])
		position[0] += 1
		mut expected := ""
		if gate4_token_is(state, position[0], ":")
			position[0] += 1
			expected = gate4_parse_type(state, position)
		end
		position[0] += 1
		value := repl_expression(state, position, store, environment, 1, expected)
		result := repl_coerce(store, value.value, expected)
		if store.error[0] == ""
			repl_bind(environment, name, result, mutable)
		end
		return result
	end
	left := repl_expression(state, position, store, environment, 1, "")
	operator := gate4_load_string(state.token_texts, position[0])
	mut assignment := operator == "="
	if operator == "+="
		assignment = true
	end
	if operator == "-="
		assignment = true
	end
	if operator == "*="
		assignment = true
	end
	if operator == "/="
		assignment = true
	end
	if operator == "%="
		assignment = true
	end
	if assignment
		position[0] += 1
		expected := store.types[left.value]
		right := repl_expression(state, position, store, environment, 1, expected)
		mut result := repl_coerce(store, right.value, expected)
		if operator != "="
			result = repl_numeric(store, left.value, operator[0], result)
		end
		if store.error[0] == ""
			if left.binding >= 0
				environment.values[left.binding] = result
			else
				store.children[left.container][left.slot] = result
			end
		end
		return result
	end
	return left.value
end

def repl_block(mut state: Gate4Compiler, mut position: Array<Integer>, mut store: ReplStore, mut environment: ReplEnvironment, mut flow: Array<Integer>): Integer
	mut result := 0
	gate4_skip_newlines(state, position)
	mut complete := false
	while !complete
		if native_cli_interrupt(0) != 0
			store.error[0] = "Interrupted"
		end
		if store.error[0] != ""
			return 0
		end
		if gate4_token_is(state, position[0], "end")
			complete = true
		else
			if gate4_token_is(state, position[0], "else")
				complete = true
			else
				result = repl_statement(state, position, store, environment, flow)
				gate4_skip_newlines(state, position)
				if flow[0] != 0
					complete = true
				end
			end
		end
	end
	return result
end
