import { builtin_result_variant } from builtin_results
import { find_record_type } from type_resolution
import { CompilerState } from state
import { load_integer, load_string } from storage
import { repl_array_method } from repl_array_methods
import { repl_hash_slot } from repl_hash
import { ReplStore, repl_boolean, repl_get, repl_integer, repl_string, repl_value } from repl_model
import { repl_string_method } from repl_string_methods
import { repl_coerce } from repl_values

def repl_builtin_error(state: CompilerState, mut store: ReplStore, result_type: String, fields: Array<Integer>): Integer
	err := builtin_result_variant(state, result_type, false)
	error_type := state.enum_fields[state.enum_variants[err].field_start].type_name
	record_index := find_record_type(state, error_type)
	start := load_integer(state.record_field_starts, record_index)
	mut values: Array<Integer> := []
	fields.each.with_index do |field, index|
		values.push(repl_coerce(store, field, load_string(state.field_types, start + index)))
	end
	error := repl_value(store, error_type, 0, 0.0, "", values)
	return repl_value(store, result_type, err, 0.0, "Err", [error])
end

def repl_builtin_lookup(state: CompilerState, mut store: ReplStore, kind: Integer, receiver: Integer, argument: Integer, result_type: String): Integer
	ok := builtin_result_variant(state, result_type, true)
	if kind == 3
		table := store.hashes[store.integers[receiver]]
		slot := repl_hash_slot(store, table, argument)
		if slot >= 0
			return repl_value(store, result_type, ok, 0.0, "Ok", [table.values[slot]])
		end
		message := repl_string(store, "Hash key is missing")
		return repl_builtin_error(state, store, result_type, [argument, message])
	end
	# Read the retained receiver's current storage only after argument evaluation.
	value := repl_get(store, receiver)
	mut size := store.children[receiver].size()
	mut label := "Array"
	if value.type_name == "String"
		size = value.text.size()
		label = "String"
	end
	if kind == 1
		mut position := store.integers[argument]
		if position < 0
			position += size
		end
		if position >= 0 && position < size
			mut selected := 0
			if value.type_name == "String"
				selected = repl_string(store, value.text[position])
			else
				selected = store.children[receiver][position]
			end
			return repl_value(store, result_type, ok, 0.0, "Ok", [selected])
		end
		message := repl_string(store, label + " index is out of bounds")
		return repl_builtin_error(state, store, result_type, [argument, repl_integer(store, size), message])
	end
	bounds := store.children[argument]
	first := store.integers[bounds[0]]
	finish := store.integers[bounds[1]]
	exclusive := store.integers[bounds[2]] == 1
	if first >= 0 && first <= finish && finish <= size && (exclusive || finish < size)
		mut selected := 0
		if value.type_name == "String"
			selected = repl_string_method(store, 10, receiver, argument)
		else
			selected = repl_array_method(store, 6, receiver, argument)
		end
		return repl_value(store, result_type, ok, 0.0, "Ok", [selected])
	end
	message := repl_string(store, label + " slice range is out of bounds")
	return repl_builtin_error(state, store, result_type, [bounds[0], bounds[1], repl_boolean(store, exclusive), repl_integer(store, size), message])
end
