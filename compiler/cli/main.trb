import { cli_diagnostic } from diagnostics
import { Gate4Compiler, gate4_has_diagnostic } from state
import { gate4_resolve } from resolution
import { gate4_load_string } from storage
import trb/std/process
import { compiler_main as core_main, gate4_file_exists, gate4_read_source, gate4_load_configured_project, gate4_load_file_root, gate4_check, gate4_emit_qbe, gate4_source_slice } from compiler
import { parse_project_config } from project_config
import { gate4_path_directory, gate4_path_basename, gate4_path_join, gate4_string_ends_with, gate4_string_starts_with, gate4_string_without_suffix } from path
import { native_cli_env, native_cli_cwd, native_cli_program, native_cli_tty, native_cli_write, native_cli_mkdir, native_cli_remove, native_cli_temp, native_cli_execute, native_cli_signals, native_cli_target, native_cli_emit, native_cli_tempfile, native_cli_rename } from host
import { repl_run } from repl

# The entry adapters preserve the internal bootstrap protocol without exposing
# its positional tool arguments as the user-facing command contract.
def compiler_main(source: String, mode: String, file_mode: Boolean): Integer
	return core_main(source, mode, file_mode)
end

def compiler_file_main(source: String, path: String, mode: String, file_mode: Boolean): Integer
	if !gate4_string_ends_with(path, ".trb")
		mut state := gate4_load_configured_project(source, path)
		return cli_compile_state(state, path, mode, file_mode)
	end
	mut state := gate4_load_file_root(source, path)
	return cli_compile_state(state, path, mode, file_mode)
end

def cli_compile_state(mut state: Gate4Compiler, path: String, mode: String, file_mode: Boolean): Integer
	if !gate4_has_diagnostic(state)
		gate4_resolve(state)
	end
	if !gate4_has_diagnostic(state)
		gate4_check(state)
	end
	if !gate4_has_diagnostic(state)
		if mode == "check"
			puts("ok")
			return 0
		end
		if mode == "emit-qbe"
			output := gate4_emit_qbe(state)
			if !gate4_has_diagnostic(state)
				mut index := 0
				while index < output.count[0]
					puts(gate4_load_string(output.lines, index))
					index += 1
				end
				return 0
			end
		else
			return cli_error("unsupported compiler mode " + mode)
		end
	end
	message := cli_diagnostic(state, path, 0)
	if file_mode
		native_cli_write(message + "\n", 2)
	else
		puts(message)
	end
	return 1
end

record CliOptions
	command: String
	source: String
	config: String
	mode: String
	output: String
	compile: Boolean
	stdout: Boolean
	arguments: Array<String>
	error: String
end

def cli_error(message: String): Integer
	native_cli_write("trbn: " + message + "\n", 2)
	return 1
end

def cli_usage(): Integer
	puts("Usage: trbn [COMMAND] [OPTIONS] [SOURCE]")
	puts("  trbn                         Start a REPL in an interactive terminal")
	puts("  trbn FILE.trb [-- ARGS...]    Build and run a file")
	puts("  trbn check [SOURCE]          Check a file or project")
	puts("  trbn build [SOURCE]          Emit native QBE source")
	puts("  trbn build --compile [SOURCE] Build an executable")
	puts("  trbn run [SOURCE] [-- ARGS...] Build and run")
	puts("  trbn repl                   Start a stateful REPL")
	puts("Options: --mode trb, --config PATH, --outfile PATH, --stdout")
	puts("TypeRB Native is experimental. Only mode trb is implemented.")
	return 0
end

def cli_parse_argument(mut options: CliOptions, arguments: Array<String>, mut index: Array<Integer>)
	mut argument := arguments[index[0]]
	mut inline_value := ""
	mut has_inline := false
	mut separator := 0
	while separator < argument.size()
		if argument[separator] == "="
			inline_value = gate4_source_slice(argument, separator + 1, argument.size())
			argument = gate4_source_slice(argument, 0, separator)
			has_inline = true
		end
		separator += 1
	end
	if has_inline
		if !cli_any(cli_any(argument == "--mode", argument == "--config"), argument == "--outfile")
			options.error = "unexpected option value for " + argument
			return
		end
	end
	index[0] += 1
	if argument == "--"
		while index[0] < arguments.size()
			options.arguments.push(arguments[index[0]])
			index[0] += 1
		end
		return
	end
	if argument == "--compile"
		options.compile = true
		return
	end
	if argument == "--stdout"
		options.stdout = true
		return
	end
	if cli_any(argument == "--help", argument == "-h")
		options.command = "help"
		return
	end
	if argument == "--version"
		options.command = "version"
		return
	end
	if cli_any(cli_any(argument == "--mode", argument == "--config"), argument == "--outfile")
		mut value := inline_value
		if !has_inline
			if index[0] >= arguments.size()
				options.error = "missing value for " + argument
				return
			end
			value = arguments[index[0]]
			index[0] += 1
		end
		if cli_any(value == "", gate4_string_starts_with(value, "--"))
			options.error = "missing value for " + argument
			return
		end
		if argument == "--mode"
			options.mode = value
		end
		if argument == "--config"
			options.config = value
		end
		if argument == "--outfile"
			options.output = value
		end
		return
	end
	if gate4_string_starts_with(argument, "-")
		options.error = "unknown option " + argument
		return
	end
	if options.command == ""
		if cli_any(cli_any(cli_any(argument == "check", argument == "build"), cli_any(argument == "run", argument == "repl")), cli_any(argument == "help", argument == "version"))
			options.command = argument
			return
		end
		if !gate4_string_ends_with(argument, ".trb")
			if !gate4_file_exists(argument)
				options.error = "unknown command " + argument
				return
			end
		end
		options.command = "run"
	end
	if options.source == ""
		options.source = argument
		return
	end
	options.error = "unexpected argument " + argument
	return
end

def cli_parse(arguments: Array<String>): CliOptions
	mut options := CliOptions.new(command: "", source: "", config: "", mode: "", output: "", compile: false, stdout: false, arguments: [], error: "")
	mut index := [0]
	while index[0] < arguments.size()
		cli_parse_argument(options, arguments, index)
		if options.error != ""
			return options
		end
	end
	return options
end

def cli_absolute(path: String, root: String): String
	if gate4_string_starts_with(path, "/")
		return path
	end
	if cli_any(path == ".", path == "")
		return root
	end
	return gate4_path_join(root, path)
end

def cli_find_config(start: String): String
	mut root := start
	while root != ""
		candidate := gate4_path_join(root, "trbconfig.jsonc")
		if gate4_file_exists(candidate)
			return candidate
		end
		parent := gate4_path_directory(root)
		if root == parent
			return ""
		end
		root = parent
	end
	return ""
end

def cli_program_path(cwd: String): String
	program := native_cli_program()
	if program != gate4_path_basename(program)
		return cli_absolute(program, cwd)
	end
	paths := native_cli_env("PATH")
	mut start := 0
	mut index := 0
	while index <= paths.size()
		mut delimiter := index == paths.size()
		if !delimiter
			delimiter = paths[index] == ":"
		end
		if delimiter
			directory := cli_absolute(gate4_source_slice(paths, start, index), cwd)
			candidate := gate4_path_join(directory, program)
			if gate4_file_exists(candidate)
				return candidate
			end
			start = index + 1
		end
		index += 1
	end
	return cli_absolute(program, cwd)
end

def cli_create_directory(path: String): Boolean
	if gate4_file_exists(path)
		return true
	end
	parent := gate4_path_directory(path)
	if parent == path
		return false
	end
	if !cli_create_directory(parent)
		return false
	end
	return native_cli_mkdir(path) == 0
end

def native_cli_main(): Integer
	arguments := Process.argv()
	if arguments.size() > 0
		if arguments[0] == "--internal-driver"
			native_cli_target()
			mut driver := ["compiler"]
			mut index := 1
			while index < arguments.size()
				driver.push(arguments[index])
				index += 1
			end
			return native_cli_execute(driver, 1)
		end
	end
	options := cli_parse(arguments)
	if options.error != ""
		return cli_error(options.error)
	end
	mut command := options.command
	if command == "help"
		return cli_usage()
	end
	if command == "version"
		puts("trbn 0.1.0-dev (experimental; default mode: trb)")
		return 0
	end
	if command == ""
		if native_cli_tty() == 0
			return cli_usage()
		end
		command = "repl"
	end
	if command != "run"
		if options.arguments.size() > 0
			return cli_error("program arguments are only accepted by run")
		end
	end
	if command != "build"
		if cli_any(cli_any(options.compile, options.stdout), options.output != "")
			return cli_error("build options require the build command")
		end
	end
	if cli_both(options.compile, options.stdout)
		return cli_error("--compile cannot be combined with --stdout")
	end
	cwd := native_cli_cwd()
	if cwd == ""
		return cli_error("cannot resolve the working directory")
	end
	mut source := cli_absolute(options.source, cwd)
	if options.source != ""
		if !gate4_file_exists(source)
			return cli_error("cannot read source " + source)
		end
	end
	mut config := options.config
	if config != ""
		config = cli_absolute(config, cwd)
		if !gate4_file_exists(config)
			return cli_error("cannot read configuration " + config)
		end
	else
		mut start := source
		if gate4_string_ends_with(source, ".trb")
			start = gate4_path_directory(source)
		end
		config = cli_find_config(start)
	end
	mut mode := "trb"
	mut project_name := gate4_string_without_suffix(gate4_path_basename(source), ".trb")
	mut output_root := gate4_path_directory(source)
	mut source_output := "build"
	if config != ""
		project := parse_project_config(gate4_read_source(config))
		if project.error != ""
			return cli_error(project.error)
		end
		if project.mode != ""
			mode = project.mode
		end
		project_name = project.name
		source_output = project.out_dir
		output_root = gate4_path_directory(config)
		source = config
	end
	if options.mode != ""
		if cli_both(config != "", command != "repl")
			return cli_error("--mode cannot override a project configuration")
		end
		mode = options.mode
	end
	if mode != "trb"
		return cli_error("mode " + mode + " is not implemented; this experimental compiler supports mode trb")
	end
	native_cli_signals()
	profile := native_cli_target()
	if profile == ""
		return cli_error("unsupported host platform")
	end
	if command == "repl"
		return repl_run(config)
	end
	if !gate4_file_exists(source)
		return cli_error("cannot read source " + source)
	end
	if cli_both(!gate4_string_ends_with(source, ".trb"), config == "")
		return cli_error("no trbconfig.jsonc found; specify a .trb entry file")
	end
	if command == "check"
		return compiler_file_main(gate4_read_source(source), source, "check", true)
	end
	if cli_both(command == "build", !options.compile)
		if options.stdout
			return compiler_file_main(gate4_read_source(source), source, "emit-qbe", true)
		end
		if options.output != ""
			return cli_error("--outfile requires --compile")
		end
		directory := cli_absolute(source_output, output_root)
		if !cli_create_directory(directory)
			return cli_error("cannot create output directory")
		end
		output := gate4_path_join(directory, project_name + ".ssa")
		temporary := native_cli_tempfile(output)
		if temporary == ""
			return cli_error("cannot create intermediate output")
		end
		status := native_cli_emit(source, temporary)
		if status != 0
			native_cli_remove(temporary, 0)
			return status
		end
		if native_cli_rename(temporary, output) != 0
			native_cli_remove(temporary, 0)
			return cli_error("cannot publish output")
		end
		return 0
	end
	mut qbe := native_cli_env("TRBN_QBE")
	if qbe == ""
		qbe = gate4_path_join(gate4_path_directory(cli_program_path(cwd)), "qbe")
	end
	qbe = cli_absolute(qbe, cwd)
	mut cc := native_cli_env("TRBN_CC")
	if cc == ""
		cc = "/usr/bin/cc"
	end
	cc = cli_absolute(cc, cwd)
	if !gate4_file_exists(qbe)
		return cli_error("QBE is missing; place qbe beside trbn or set TRBN_QBE")
	end
	mut temporary := ""
	mut output := options.output
	if command == "run"
		temporary = native_cli_temp()
		if temporary == ""
			return cli_error("cannot create a temporary build directory")
		end
		output = gate4_path_join(temporary, "program")
	else
		if output == ""
			output = "bin/" + project_name
		end
		output = cli_absolute(output, output_root)
	end
	if !cli_create_directory(gate4_path_directory(output))
		return cli_error("cannot create output directory")
	end
	status := native_cli_execute(["compiler", "build", source, "--output", output, "--qbe", qbe, "--cc", cc], 1)
	mut result := status
	if cli_both(result == 0, command == "run")
		mut child_arguments := [output]
		mut index := 0
		while index < options.arguments.size()
			child_arguments.push(options.arguments[index])
			index += 1
		end
		result = native_cli_execute(child_arguments, 0)
	end
	if temporary != ""
		native_cli_remove(output, 0)
		native_cli_remove(temporary, 1)
	end
	return result
end

def main()
	return
end

def cli_any(left: Boolean, right: Boolean): Boolean
	if left
		return true
	end
	return right
end

def cli_both(left: Boolean, right: Boolean): Boolean
	if left
		return right
	end
	return false
end
