import { repl_history_load, repl_history_save } from repl_history
import { Gate4Compiler, gate4_compiler_new, gate4_has_diagnostic, gate4_locals_new, gate4_local_add, gate4_diagnostic, gate4_find_module } from state
import { gate4_load_integer, gate4_load_string, gate4_store_integer } from storage
import { gate4_parse_module, gate4_token_is, gate4_skip_newlines } from parser
import { gate4_resolve, gate4_find_function_in_module, gate4_type_display, gate4_find_record_type, gate4_find_record_in_module, gate4_record_type } from resolution
import { gate4_lex, gate4_check, gate4_print_diagnostic, gate4_load_file_root, gate4_read_source, gate4_file_exists, gate4_source_slice, gate4_parse_project_config, gate4_collect_project_sources, gate4_project_module_name } from compiler
import { gate4_check_expression } from checked_program
import { gate4_path_directory, gate4_path_join, gate4_string_starts_with } from path
import { native_cli_line, native_cli_eof, native_cli_tty, native_cli_write, native_cli_interrupt, native_cli_cwd, native_cli_env, native_cli_mkdir, native_cli_editor, native_cli_completions, native_cli_history } from host
import { ReplStore, ReplEnvironment, repl_store, repl_environment, repl_render, repl_compact } from repl_values
import { repl_statement } from repl_eval
import { gate4_ascii_code } from literals

record ReplProject
	imports: String
	root: String
	error: String
end

def repl_trim(text: String): String
	mut start := 0
	mut finish := text.size()
	mut scan := true
	while scan
		if start < finish
			character := text[start]
			if character == " "
				start += 1
			else
				if character == "\t"
					start += 1
				else
					scan = false
				end
			end
		else
			scan = false
		end
	end
	scan = true
	while scan
		if finish > start
			character := text[finish - 1]
			if character == "\n"
				finish -= 1
			else
				if character == " "
					finish -= 1
				else
					scan = false
				end
			end
		else
			scan = false
		end
	end
	return gate4_source_slice(text, start, finish)
end

def repl_lines(text: String): Integer
	mut lines := 0
	mut index := 0
	while index < text.size()
		if text[index] == "\n"
			lines += 1
		end
		index += 1
	end
	return lines
end

def repl_incomplete(text: String): Boolean
	mut state := gate4_compiler_new(text.size() + 1)
	gate4_lex(state, text)
	if gate4_has_diagnostic(state)
		message := gate4_load_string(state.diagnostic_messages, 0)
		return gate4_string_starts_with(message, "unterminated")
	end
	mut depth := 0
	mut delimiters := 0
	mut index := 0
	while index < state.token_count[0]
		if gate4_token_is(state, index, "def")
			depth += 1
		end
		if gate4_token_is(state, index, "record")
			depth += 1
		end
		if gate4_token_is(state, index, "if")
			depth += 1
		end
		if gate4_token_is(state, index, "while")
			depth += 1
		end
		if gate4_token_is(state, index, "end")
			depth -= 1
		end
		if gate4_token_is(state, index, "(")
			delimiters += 1
		end
		if gate4_token_is(state, index, "[")
			delimiters += 1
		end
		if gate4_token_is(state, index, ")")
			delimiters -= 1
		end
		if gate4_token_is(state, index, "]")
			delimiters -= 1
		end
		index += 1
	end
	if depth > 0
		return true
	end
	return delimiters > 0
end

def repl_project(config: String): ReplProject
	if config == ""
		return ReplProject.new(imports: "import trb/std/math\nimport trb/std/process\n", root: native_cli_cwd(), error: "")
	end
	project := gate4_parse_project_config(gate4_read_source(config))
	if project.error != ""
		return ReplProject.new(imports: "", root: "", error: project.error)
	end
	root := gate4_path_join(gate4_path_directory(config), project.source_dir)
	bundle := gate4_collect_project_sources(root, gate4_path_join(gate4_path_directory(config), project.out_dir))
	if bundle.error != ""
		return ReplProject.new(imports: "", root: root, error: bundle.error)
	end
	mut names: Array<String> := []
	mut modules: Array<String> := []
	mut index := 0
	while index < bundle.paths.size()
		mut state := gate4_compiler_new(bundle.sources[index].size() + 1)
		gate4_lex(state, bundle.sources[index])
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, 0, 0)
		end
		if gate4_has_diagnostic(state)
			return ReplProject.new(imports: "", root: root, error: "cannot parse project module " + bundle.paths[index])
		end
		module_name := gate4_project_module_name(state, root, bundle.paths[index])
		mut item := 0
		while item < state.function_count[0]
			name := gate4_load_string(state.function_names, item)
			if name != "main"
				names.push(name)
				modules.push(module_name)
			end
			item += 1
		end
		item = 0
		while item < state.record_count[0]
			names.push(gate4_load_string(state.record_names, item))
			modules.push(module_name)
			item += 1
		end
		index += 1
	end
	mut imports := "import trb/std/math\nimport trb/std/process\n"
	index = 0
	while index < names.size()
		mut count := 0
		mut peer := 0
		while peer < names.size()
			if names[index] == names[peer]
				count += 1
			end
			peer += 1
		end
		if count == 1
			imports += "import { " + names[index] + " } from " + modules[index] + "\n"
		end
		index += 1
	end
	return ReplProject.new(imports: imports, root: root, error: "")
end

def repl_checked(source: String, root: String): Gate4Compiler
	mut state := gate4_load_file_root(source, gate4_path_join(root, "__repl__.trb"))
	if !gate4_has_diagnostic(state)
		gate4_resolve(state)
	end
	# A REPL import is an intentional session declaration; it need not be used
	# by the same submission that introduced it.
	mut index := 0
	while index < state.import_count[0]
		gate4_store_integer(state.import_used, index, 1)
		index += 1
	end
	if !gate4_has_diagnostic(state)
		gate4_check(state)
	end
	# Keep the evaluator inside the ordinary runtime's current String boundary.
	index = 0
	while index < state.token_count[0]
		if gate4_load_integer(state.token_kinds, index) == 3
			text := gate4_load_string(state.token_texts, index)
			mut character := 0
			while character < text.size()
				if gate4_ascii_code(text[character]) < 0
					gate4_diagnostic(state, "TRBN4005", gate4_load_integer(state.token_lines, index), "Native REPL currently supports ASCII String literals only")
					return state
				end
				character += 1
			end
		end
		index += 1
	end
	return state
end

def repl_help()
	puts("Enter TypeRB expressions, bindings, functions, records, or imports.")
	puts(":type EXPRESSION  Show the checked type without evaluating")
	puts(":load FILE        Load declarations from a TypeRB file")
	puts(":reload           Reload the project and replay the session")
	puts(":help             Show this help")
	puts(":quit             Exit (or Ctrl-D); Ctrl-C cancels input/evaluation")
	return
end

record ReplSession
	project: ReplProject
	text: Array<String>
	store: ReplStore
	environment: ReplEnvironment
	submissions: Array<String>
end

def repl_show(mut state: Gate4Compiler, mut session: ReplSession, input: String, prefix: String, type_only: Boolean, display: Boolean): Boolean
	state.active_module[0] = state.entry_module[0]
	line_number := repl_lines(prefix) + 1
	main := gate4_find_function_in_module(state, state.entry_module[0], "main")
	mut position := [gate4_load_integer(state.function_body_starts, main)]
	while gate4_load_integer(state.token_lines, position[0]) < line_number
		position[0] += 1
	end
	gate4_skip_newlines(state, position)
	if gate4_load_integer(state.token_lines, position[0]) >= line_number + repl_lines(input) + 1
		return true
	end
	if type_only
		mut locals := gate4_locals_new(session.environment.count[0] + 16)
		mut index := 0
		while index < session.environment.count[0]
			id := session.environment.values[index]
			gate4_local_add(state, locals, session.environment.names[index], session.store.types[id], session.environment.mutable[index], 1)
			index += 1
		end
		value := gate4_check_expression(state, position, locals, 1, "")
		puts(gate4_type_display(state, value.type_name))
		return true
	end
	session.store.error[0] = ""
	previous_count := session.environment.count[0]
	mut flow := [0]
	mut value := 0
	finish_line := line_number + repl_lines(input) + 1
	mut evaluating := true
	while evaluating
		value = repl_statement(state, position, session.store, session.environment, flow)
		gate4_skip_newlines(state, position)
		if gate4_load_integer(state.token_lines, position[0]) >= finish_line
			evaluating = false
		end
		if session.store.error[0] != ""
			evaluating = false
		end
		if flow[0] != 0
			evaluating = false
		end
	end
	if session.store.error[0] != ""
		session.environment.count[0] = previous_count
	end
	session.text[1] = repl_bindings(state, session)
	if session.store.error[0] != ""
		native_cli_write(session.store.error[0] + "\n", 2)
		return false
	end
	if !display
		return true
	end
	if session.store.types[value] != "Void"
		mut rendered := repl_render(state, session.store, value, 0) + " : " + gate4_type_display(state, session.store.types[value])
		mut mutable := gate4_string_starts_with(input, "mut ")
		mut index := 0
		while index < session.environment.count[0]
			if input == session.environment.names[index]
				mutable = session.environment.mutable[index] == 1
			end
			index += 1
		end
		if mutable
			rendered += " [mut]"
		end
		puts(rendered)
	end
	return true
end

def repl_submit(mut session: ReplSession, input: String, type_only: Boolean, display: Boolean): Boolean
	declarations := repl_is_declaration(input)
	prefix := session.text[0] + "def main()\n" + session.text[1]
	mut source := prefix + input + "\nreturn\nend\n"
	if declarations
		source = session.text[0] + input + "\ndef main()\n" + session.text[1] + "return\nend\n"
	end
	mut state := repl_checked(source, session.project.root)
	if gate4_has_diagnostic(state)
		gate4_print_diagnostic(state, true)
		return false
	end
	if declarations
		previous := repl_checked(session.text[0] + "def main()\n" + session.text[1] + "return\nend\n", session.project.root)
		repl_remap_records(previous, state, session.store)
		session.text[0] += input + "\n"
		return true
	end
	return repl_show(state, session, input, prefix, type_only, display)
end

def repl_command(mut session: ReplSession, input: String, config: String): Boolean
	if input == ":quit"
		return false
	end
	if input == ":exit"
		return false
	end
	if input == ":q"
		return false
	end
	if input == ":help"
		repl_help()
		return true
	end
	if input == ":reload"
		if repl_replay(session, config, [])
			puts("reloaded")
		end
		return true
	end
	if gate4_string_starts_with(input, ":type ")
		repl_submit(session, gate4_source_slice(input, 6, input.size()), true, false)
		return true
	end
	if gate4_string_starts_with(input, ":load ")
		path := repl_trim(gate4_source_slice(input, 6, input.size()))
		if !gate4_file_exists(path)
			native_cli_write("trbn: cannot read " + path + "\n", 2)
			return true
		end
		repl_replay(session, config, repl_split_source(gate4_read_source(path)))
		return true
	end
	if gate4_string_starts_with(input, ":")
		native_cli_write("trbn: unknown REPL command; use :help\n", 2)
		return true
	end
	if input != ""
		if repl_submit(session, input, false, true)
			session.submissions.push(input)
		end
	end
	return true
end

def repl_run(config: String): Integer
	project := repl_project(config)
	if project.error != ""
		native_cli_write("trbn: " + project.error + "\n", 2)
		return 1
	end
	mut session := ReplSession.new(project: project, text: [project.imports, ""], store: repl_store(), environment: repl_environment(), submissions: [])
	mut pending := ""
	interactive := native_cli_tty() != 0
	mut history := native_cli_env("TRBN_HISTORY")
	if history == ""
		if config != ""
			directory := gate4_path_join(gate4_path_directory(config), ".trb")
			native_cli_mkdir(directory)
			history = gate4_path_join(directory, "repl_history")
		else
			cache := native_cli_env("HOME")
			if cache != ""
				directory := gate4_path_join(cache, ".cache")
				native_cli_mkdir(directory)
				repl_cache := gate4_path_join(directory, "trbn")
				native_cli_mkdir(repl_cache)
				history = gate4_path_join(repl_cache, "repl_history_trb")
			end
		end
	end
	mut history_entries: Array<String> := []
	if interactive
		if native_cli_editor() != 0
			native_cli_write("trbn: interactive REPL requires libedit (install libedit2 on Linux)\n", 2)
			return 1
		end
		if history != ""
			history_entries = repl_history_load(history)
		end
		puts("TypeRB Native 0.1.0-dev - experimental REPL (trb)")
		puts("Type :help for help.")
	end
	mut running := true
	while running
		native_cli_interrupt(1)
		mut prompt := ""
		if interactive
			repl_complete(session)
			prompt = "trbn:trb> "
			if pending != ""
				prompt = "...> "
			end
		end
		line := native_cli_line(prompt)
		if native_cli_interrupt(0) != 0
			pending = ""
			native_cli_write("\n", 1)
		else
			if native_cli_eof() != 0
				running = false
				if pending != ""
					native_cli_write("trbn: incomplete input at end of session\n", 2)
				end
			else
				pending += line + "\n"
				if !repl_incomplete(pending)
					input := repl_trim(pending)
					pending = ""
					running = repl_command(session, input, config)
					session.store = repl_compact(session.store, session.environment)
					if interactive
						if history != ""
							if input != ":quit"
								if input != ""
									history_entries.push(input)
									native_cli_history(input)
									if !repl_history_save(history, history_entries)
										native_cli_write("trbn: cannot save REPL history\n", 2)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return 0
end

def repl_default(state: Gate4Compiler, type_name: String): String
	if type_name == "Integer"
		return "0"
	end
	if type_name == "Float"
		return "0.0"
	end
	if type_name == "Boolean"
		return "false"
	end
	if type_name == "String"
		return "\"\""
	end
	if gate4_string_starts_with(type_name, "Array<")
		return "[]"
	end
	record_index := gate4_find_record_type(state, type_name)
	start := gate4_load_integer(state.record_field_starts, record_index)
	count := gate4_load_integer(state.record_field_counts, record_index)
	mut text := gate4_type_display(state, type_name) + ".new("
	mut index := 0
	while index < count
		if index > 0
			text += ", "
		end
		text += gate4_load_string(state.field_names, start + index) + ": " + repl_default(state, gate4_load_string(state.field_types, start + index))
		index += 1
	end
	return text + ")"
end

def repl_bindings(state: Gate4Compiler, session: ReplSession): String
	mut source := ""
	mut index := 0
	while index < session.environment.count[0]
		if session.environment.mutable[index] == 1
			source += "mut "
		end
		id := session.environment.values[index]
		type_name := session.store.types[id]
		source += session.environment.names[index] + ": " + gate4_type_display(state, type_name) + " := " + repl_default(state, type_name) + "\n"
		index += 1
	end
	return source
end

def repl_complete(session: ReplSession)
	mut candidates := [":type ", ":load ", ":reload", ":help", ":quit", "puts(", "Math.sqrt(", "Process.argv()", "true", "false", "mut ", "def ", "record "]
	mut index := 0
	while index < session.environment.count[0]
		name := session.environment.names[index]
		candidates.push(name)
		type_name := session.store.types[session.environment.values[index]]
		if gate4_string_starts_with(type_name, "Array<")
			candidates.push(name + ".size()")
			candidates.push(name + ".push(")
		end
		if type_name == "String"
			candidates.push(name + ".size()")
		end
		index += 1
	end
	state := repl_checked(session.text[0] + "def main()\nreturn\nend\n", session.project.root)
	index = 0
	while index < state.function_count[0]
		if gate4_load_integer(state.function_modules, index) == state.entry_module[0]
			name := gate4_load_string(state.function_names, index)
			if name != "main"
				candidates.push(name + "(")
			end
		end
		index += 1
	end
	index = 0
	while index < state.import_count[0]
		name := gate4_load_string(state.import_symbols, index)
		if name != ""
			candidates.push(name)
		end
		index += 1
	end
	index = 0
	while index < state.record_count[0]
		candidates.push(gate4_load_string(state.record_names, index) + ".new(")
		index += 1
	end
	native_cli_completions(candidates)
	return
end

# Record indexes are compiler-state-local. Preserve nominal identities when a
# new session declaration changes the ordering of imported record types.
def repl_remap_records(previous: Gate4Compiler, current: Gate4Compiler, mut store: ReplStore)
	mut index := 0
	while index < store.types.size()
		record_index := gate4_find_record_type(previous, store.types[index])
		if record_index >= 0
			module_index := gate4_load_integer(previous.record_modules, record_index)
			module_name := gate4_load_string(previous.module_names, module_index)
			name := gate4_load_string(previous.record_names, record_index)
			next_module := gate4_find_module(current, module_name)
			next_record := gate4_find_record_in_module(current, next_module, name)
			store.types[index] = gate4_record_type(next_record)
		end
		index += 1
	end
	return
end

# Explicit reload/load rebuild the session, matching the reference commands.
# Ordinary submissions continue to evaluate only their newly authored input.
def repl_replay(mut session: ReplSession, config: String, additional: Array<String>): Boolean
	project := repl_project(config)
	if project.error != ""
		native_cli_write("trbn: " + project.error + "\n", 2)
		return false
	end
	mut replayed := ReplSession.new(project: project, text: [project.imports, ""], store: repl_store(), environment: repl_environment(), submissions: [])
	mut inputs: Array<String> := []
	mut index := 0
	while index < session.submissions.size()
		inputs.push(session.submissions[index])
		index += 1
	end
	index = 0
	while index < additional.size()
		inputs.push(additional[index])
		index += 1
	end
	# Check the complete replacement before replaying any observable effects.
	mut declarations := project.imports
	mut body := ""
	index = 0
	while index < inputs.size()
		if repl_is_declaration(inputs[index])
			declarations += inputs[index] + "\n"
		else
			body += inputs[index] + "\n"
		end
		index += 1
	end
	checked := repl_checked(declarations + "def main()\n" + body + "return\nend\n", project.root)
	if gate4_has_diagnostic(checked)
		gate4_print_diagnostic(checked, true)
		return false
	end
	replayed.text[0] = declarations
	index = 0
	while index < inputs.size()
		if !repl_is_declaration(inputs[index])
			if !repl_submit(replayed, inputs[index], false, false)
				return false
			end
		end
		replayed.submissions.push(inputs[index])
		replayed.store = repl_compact(replayed.store, replayed.environment)
		index += 1
	end
	session.project = replayed.project
	session.text = replayed.text
	session.store = replayed.store
	session.environment = replayed.environment
	session.submissions = replayed.submissions
	return true
end

def repl_split_source(source: String): Array<String>
	mut submissions: Array<String> := []
	mut pending := ""
	mut index := 0
	while index <= source.size()
		mut character := "\n"
		if index < source.size()
			character = source[index]
		end
		pending += character
		if character == "\n"
			if !repl_incomplete(pending)
				input := repl_trim(pending)
				if input != ""
					submissions.push(input)
				end
				pending = ""
			end
		end
		index += 1
	end
	if pending != ""
		submissions.push(pending)
	end
	return submissions
end

def repl_is_declaration(input: String): Boolean
	mut probe := gate4_compiler_new(input.size() + 1)
	gate4_lex(probe, input)
	mut first := [0]
	gate4_skip_newlines(probe, first)
	mut declarations := gate4_token_is(probe, first[0], "def")
	if gate4_token_is(probe, first[0], "record")
		declarations = true
	end
	if gate4_token_is(probe, first[0], "import")
		declarations = true
	end
	return declarations
end
