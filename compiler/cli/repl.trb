import { cli_diagnostic } from diagnostics
import { ReplCandidates, repl_editor_read, repl_editor_paint } from repl_editor
import { repl_incomplete, repl_escape } from repl_syntax
import { repl_history_load, repl_history_save } from repl_history
import { Gate4Compiler, gate4_compiler_new, gate4_has_diagnostic, gate4_locals_new, gate4_local_add, gate4_diagnostic, gate4_find_module } from state
import { gate4_load_integer, gate4_load_string, gate4_store_integer } from storage
import { gate4_parse_module, gate4_token_is, gate4_skip_newlines } from parser
import { gate4_resolve, gate4_find_function_in_module, gate4_type_display, gate4_find_record_type, gate4_find_record_in_module, gate4_record_type } from resolution
import { gate4_lex, gate4_check, gate4_load_file_root, gate4_read_source, gate4_file_exists, gate4_source_slice, gate4_collect_project_sources, gate4_project_module_name } from compiler
import { parse_project_config } from project_config
import { gate4_check_expression } from checked_program
import { gate4_path_directory, gate4_path_join, gate4_string_starts_with } from path
import { native_cli_line, native_cli_eof, native_cli_tty, native_cli_write, native_cli_interrupt, native_cli_cwd, native_cli_env, native_cli_mkdir } from host
import { ReplStore, ReplEnvironment, repl_store, repl_environment, repl_render, repl_compact } from repl_values
import { repl_statement } from repl_eval
import { gate4_ascii_code, gate4_integer_string } from literals

record ReplProject
	imports: String
	root: String
	error: String
end

def repl_trim(text: String): String
	mut start := 0
	mut finish := text.size()
	mut scan := true
	while scan
		if start < finish
			character := text[start]
			if character == " "
				start += 1
			else
				if character == "\t"
					start += 1
				else
					scan = false
				end
			end
		else
			scan = false
		end
	end
	scan = true
	while scan
		if finish > start
			character := text[finish - 1]
			if character == "\n"
				finish -= 1
			else
				if character == " "
					finish -= 1
				else
					scan = false
				end
			end
		else
			scan = false
		end
	end
	return gate4_source_slice(text, start, finish)
end

def repl_lines(text: String): Integer
	mut lines := 0
	mut index := 0
	while index < text.size()
		if text[index] == "\n"
			lines += 1
		end
		index += 1
	end
	return lines
end

def repl_project(config: String): ReplProject
	if config == ""
		return ReplProject.new(imports: "import trb/std/math\nimport trb/std/process\n", root: native_cli_cwd(), error: "")
	end
	project := parse_project_config(gate4_read_source(config))
	if project.error != ""
		return ReplProject.new(imports: "", root: "", error: project.error)
	end
	root := gate4_path_join(gate4_path_directory(config), project.source_dir)
	bundle := gate4_collect_project_sources(root, gate4_path_join(gate4_path_directory(config), project.out_dir))
	if bundle.error != ""
		return ReplProject.new(imports: "", root: root, error: bundle.error)
	end
	mut names: Array<String> := []
	mut modules: Array<String> := []
	mut index := 0
	while index < bundle.paths.size()
		mut state := gate4_compiler_new(bundle.sources[index].size() * 3 + 16)
		gate4_lex(state, bundle.sources[index])
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, 0, 0)
		end
		if gate4_has_diagnostic(state)
			return ReplProject.new(imports: "", root: root, error: "cannot parse project module " + bundle.paths[index])
		end
		module_name := gate4_project_module_name(state, root, bundle.paths[index])
		mut item := 0
		while item < state.function_count[0]
			name := gate4_load_string(state.function_names, item)
			if name != "main"
				names.push(name)
				modules.push(module_name)
			end
			item += 1
		end
		item = 0
		while item < state.record_count[0]
			names.push(gate4_load_string(state.record_names, item))
			modules.push(module_name)
			item += 1
		end
		index += 1
	end
	mut imports := "import trb/std/math\nimport trb/std/process\n"
	index = 0
	while index < names.size()
		mut count := 0
		mut peer := 0
		while peer < names.size()
			if names[index] == names[peer]
				count += 1
			end
			peer += 1
		end
		if count == 1
			imports += "import { " + names[index] + " } from " + modules[index] + "\n"
		end
		index += 1
	end
	return ReplProject.new(imports: imports, root: root, error: "")
end

def repl_checked(source: String, root: String): Gate4Compiler
	mut state := gate4_load_file_root(source, gate4_path_join(root, "__repl__.trb"))
	if !gate4_has_diagnostic(state)
		gate4_resolve(state)
	end
	# A REPL import is an intentional session declaration; it need not be used
	# by the same submission that introduced it.
	mut index := 0
	while index < state.import_count[0]
		gate4_store_integer(state.import_used, index, 1)
		index += 1
	end
	if !gate4_has_diagnostic(state)
		gate4_check(state)
	end
	# Keep the evaluator inside the ordinary runtime's current String boundary.
	index = 0
	while index < state.token_count[0]
		if gate4_load_integer(state.token_kinds, index) == 3
			text := gate4_load_string(state.token_texts, index)
			mut character := 0
			while character < text.size()
				if gate4_ascii_code(text[character]) < 0
					gate4_diagnostic(state, "TRBN4005", gate4_load_integer(state.token_lines, index), "Native REPL currently supports ASCII String literals only")
					return state
				end
				character += 1
			end
		end
		index += 1
	end
	return state
end

def repl_help()
	puts("Enter TypeRB expressions, bindings, functions, records, or imports.")
	puts(":type EXPRESSION  Show the checked type without evaluating")
	puts(":load FILE        Load declarations from a TypeRB file")
	puts(":reload           Reload the project and replay the session")
	puts(":help             Show this help")
	puts(":quit             Exit (or Ctrl-D); Ctrl-C cancels input/evaluation")
	return
end

record ReplSession
	project: ReplProject
	text: Array<String>
	store: ReplStore
	environment: ReplEnvironment
	submissions: Array<String>
end

def repl_show(mut state: Gate4Compiler, mut session: ReplSession, input: String, prefix: String, type_only: Boolean, display: Boolean): Boolean
	state.active_module[0] = state.entry_module[0]
	line_number := repl_lines(prefix) + 1
	main := gate4_find_function_in_module(state, state.entry_module[0], "main")
	mut position := [gate4_load_integer(state.function_body_starts, main)]
	while gate4_load_integer(state.token_lines, position[0]) < line_number
		position[0] += 1
	end
	gate4_skip_newlines(state, position)
	if gate4_load_integer(state.token_lines, position[0]) >= line_number + repl_lines(input) + 1
		return true
	end
	if type_only
		mut locals := gate4_locals_new(session.environment.count[0] + 16)
		mut index := 0
		while index < session.environment.count[0]
			id := session.environment.values[index]
			gate4_local_add(state, locals, session.environment.names[index], session.store.types[id], session.environment.mutable[index], 1)
			index += 1
		end
		value := gate4_check_expression(state, position, locals, 1, "")
		puts(repl_editor_paint(gate4_type_display(state, value.type_name), 5, repl_use_color()))
		return true
	end
	session.store.error[0] = ""
	previous_count := session.environment.count[0]
	mut flow := [0]
	mut value := 0
	finish_line := line_number + repl_lines(input) + 1
	mut evaluating := true
	mut error_line := line_number
	while evaluating
		error_line = gate4_load_integer(state.token_lines, position[0])
		value = repl_statement(state, position, session.store, session.environment, flow)
		gate4_skip_newlines(state, position)
		if gate4_load_integer(state.token_lines, position[0]) >= finish_line
			evaluating = false
		end
		if session.store.error[0] != ""
			evaluating = false
		end
		if flow[0] != 0
			evaluating = false
		end
	end
	if session.store.error[0] != ""
		session.environment.count[0] = previous_count
	end
	session.text[1] = repl_bindings(state, session)
	if session.store.error[0] != ""
		mut message := session.store.error[0]
		if gate4_string_starts_with(message, "panic: ")
			message = gate4_source_slice(message, 7, message.size())
		end
		message = "(trb):" + gate4_integer_string(repl_session_lines(session) + error_line - line_number + 1) + ": error: " + message
		native_cli_write(repl_error_text(message) + "\n", 2)
		return false
	end
	if !display
		return true
	end
	if session.store.types[value] != "Void"
		mut rendered := repl_editor_paint(repl_render(state, session.store, value, 0), 2, repl_use_color()) + repl_editor_paint(" : ", 4, repl_use_color()) + repl_editor_paint(gate4_type_display(state, session.store.types[value]), 5, repl_use_color())
		mut mutable := gate4_string_starts_with(input, "mut ")
		mut index := 0
		while index < session.environment.count[0]
			if input == session.environment.names[index]
				mutable = session.environment.mutable[index] == 1
			end
			index += 1
		end
		if mutable
			rendered += repl_editor_paint(" [mut]", 4, repl_use_color())
		end
		puts(rendered)
	end
	return true
end

def repl_session_lines(session: ReplSession): Integer
	mut count := 0
	mut index := 0
	while index < session.submissions.size()
		count += repl_lines(session.submissions[index]) + 1
		index += 1
	end
	return count
end

def repl_submit(mut session: ReplSession, input: String, type_only: Boolean, display: Boolean): Boolean
	declarations := repl_is_declaration(input)
	prefix := session.text[0] + "def main()\n" + session.text[1]
	mut source := prefix + input + "\nreturn\nend\n"
	if declarations
		source = session.text[0] + input + "\ndef main()\n" + session.text[1] + "return\nend\n"
	end
	mut state := repl_checked(source, session.project.root)
	if gate4_has_diagnostic(state)
		mut offset := repl_lines(prefix)
		if declarations
			offset = repl_lines(session.text[0])
		end
		repl_diagnostic(state, offset - repl_session_lines(session))
		return false
	end
	if declarations
		previous := repl_checked(session.text[0] + "def main()\n" + session.text[1] + "return\nend\n", session.project.root)
		repl_remap_records(previous, state, session.store)
		session.text[0] += input + "\n"
		return true
	end
	return repl_show(state, session, input, prefix, type_only, display)
end

record ReplCommand
	session: ReplSession
	running: Boolean
end

record ReplReplay
	session: ReplSession
	success: Boolean
end

def repl_command(mut session: ReplSession, input: String, config: String): ReplCommand
	if input == ":quit" || input == ":exit" || input == ":q"
		return ReplCommand.new(session: session, running: false)
	end
	if input == ":help"
		repl_help()
		return ReplCommand.new(session: session, running: true)
	end
	if input == ":reload"
		replayed := repl_replay(session, config, [])
		if replayed.success
			puts("reloaded")
		end
		return ReplCommand.new(session: replayed.session, running: true)
	end
	if gate4_string_starts_with(input, ":type ")
		repl_submit(session, gate4_source_slice(input, 6, input.size()), true, false)
		return ReplCommand.new(session: session, running: true)
	end
	if gate4_string_starts_with(input, ":load ")
		path := repl_trim(gate4_source_slice(input, 6, input.size()))
		if !gate4_file_exists(path)
			native_cli_write("trbn: cannot read " + path + "\n", 2)
			return ReplCommand.new(session: session, running: true)
		end
		replayed := repl_replay(session, config, repl_split_source(gate4_read_source(path)))
		return ReplCommand.new(session: replayed.session, running: true)
	end
	if gate4_string_starts_with(input, ":")
		native_cli_write("trbn: unknown REPL command; use :help\n", 2)
		return ReplCommand.new(session: session, running: true)
	end
	if input != ""
		if repl_submit(session, input, false, true)
			session.submissions.push(input)
		end
	end
	return ReplCommand.new(session: session, running: true)
end

def repl_run(config: String): Integer
	project := repl_project(config)
	if project.error != ""
		native_cli_write("trbn: " + project.error + "\n", 2)
		return 1
	end
	mut session := ReplSession.new(project: project, text: [project.imports, ""], store: repl_store(), environment: repl_environment(), submissions: [])
	mut pending := ""
	interactive := native_cli_tty() != 0
	mut history := native_cli_env("TRBN_HISTORY")
	if history == ""
		if config != ""
			directory := gate4_path_join(gate4_path_directory(config), ".trb")
			native_cli_mkdir(directory)
			history = gate4_path_join(directory, "repl_history")
		else
			cache := native_cli_env("HOME")
			if cache != ""
				directory := gate4_path_join(cache, ".cache")
				native_cli_mkdir(directory)
				repl_cache := gate4_path_join(directory, "trbn")
				native_cli_mkdir(repl_cache)
				history = gate4_path_join(repl_cache, "repl_history_trb")
			end
		end
	end
	mut history_entries: Array<String> := []
	if interactive
		if history != ""
			history_entries = repl_history_load(history)
		end
		puts("TypeRB Native 0.1.0-dev - experimental REPL (trb)")
		puts("Type :help for help.")
	end
	mut running := true
	while running
		native_cli_interrupt(1)
		mut line := ""
		mut editor_status := 0
		if interactive
			input := repl_editor_read(history_entries, repl_complete(session))
			line = input.text
			editor_status = input.status
		else
			line = native_cli_line("")
		end
		if editor_status == 3
			native_cli_write("trbn: " + line + "\n", 2)
			return 1
		end

		if repl_cancelled(editor_status)
			pending = ""
			native_cli_write("\n", 1)
		else
			if repl_ended(editor_status, interactive)
				running = false
				if pending != ""
					native_cli_write("trbn: incomplete input at end of session\n", 2)
				end
			else
				pending += line + "\n"
				if !repl_incomplete(pending)
					input := repl_trim(pending)
					pending = ""
					command := repl_command(session, input, config)
					running = command.running
					session = ReplSession.new(project: command.session.project, text: command.session.text, store: repl_compact(command.session.store, command.session.environment), environment: command.session.environment, submissions: command.session.submissions)
					if interactive
						if history != ""
							if repl_keep_history(input)
								if input != ""
									history_entries.push(input)
									if !repl_history_save(history, history_entries)
										native_cli_write("trbn: cannot save REPL history\n", 2)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return 0
end

def repl_default(state: Gate4Compiler, type_name: String): String
	if type_name == "Integer"
		return "0"
	end
	if type_name == "Float"
		return "0.0"
	end
	if type_name == "Boolean"
		return "false"
	end
	if type_name == "String"
		return "\"\""
	end
	if gate4_string_starts_with(type_name, "Array<")
		return "[]"
	end
	record_index := gate4_find_record_type(state, type_name)
	start := gate4_load_integer(state.record_field_starts, record_index)
	count := gate4_load_integer(state.record_field_counts, record_index)
	mut text := gate4_type_display(state, type_name) + ".new("
	mut index := 0
	while index < count
		if index > 0
			text += ", "
		end
		text += gate4_load_string(state.field_names, start + index) + ": " + repl_default(state, gate4_load_string(state.field_types, start + index))
		index += 1
	end
	return text + ")"
end

def repl_bindings(state: Gate4Compiler, session: ReplSession): String
	mut source := ""
	mut index := 0
	while index < session.environment.count[0]
		if session.environment.mutable[index] == 1
			source += "mut "
		end
		id := session.environment.values[index]
		type_name := session.store.types[id]
		source += session.environment.names[index] + ": " + gate4_type_display(state, type_name) + " := " + repl_default(state, type_name) + "\n"
		index += 1
	end
	return source
end

def repl_complete(session: ReplSession): ReplCandidates
	mut candidates := ReplCandidates.new(labels: [], insertions: [], details: [], kinds: [])
	repl_candidate(candidates, ":type", ":type ", "show checked type", 0)
	repl_candidate(candidates, ":load", ":load ", "load a file and replay session", 0)
	repl_candidate(candidates, ":reload", ":reload", "reload project and session", 0)
	repl_candidate(candidates, ":help", ":help", "show REPL commands", 0)
	repl_candidate(candidates, ":quit", ":quit", "exit REPL", 0)
	repl_candidate(candidates, "puts", "puts(", "puts(value: String | Integer | Boolean)", 6)
	repl_candidate(candidates, "Math", "Math", "standard module", 0)
	repl_candidate(candidates, "Process", "Process", "standard module", 0)
	repl_candidate(candidates, "Math.sqrt", "Math.sqrt(", "Math.sqrt(value: Float): Float", 6)
	repl_candidate(candidates, "Process.argv", "Process.argv()", "Process.argv(): Array<String>", 6)
	keywords := ["true", "false", "mut", "def", "record", "if", "else", "while", "return", "end", "import"]
	mut keyword := 0
	while keyword < keywords.size()
		repl_candidate(candidates, keywords[keyword], keywords[keyword], "keyword", 1)
		keyword += 1
	end
	types := ["Integer", "Float", "Boolean", "String", "Array"]
	keyword = 0
	while keyword < types.size()
		repl_candidate(candidates, types[keyword], types[keyword], "built-in type", 5)
		keyword += 1
	end
	state := repl_checked(session.text[0] + "def main()\n" + session.text[1] + "return\nend\n", session.project.root)

	mut index := 0
	while index < session.environment.count[0]
		name := session.environment.names[index]
		type_name := session.store.types[session.environment.values[index]]
		repl_candidate(candidates, name, name, gate4_type_display(state, type_name), 0)
		if gate4_string_starts_with(type_name, "Array<")
			repl_candidate(candidates, name + ".size", name + ".size()", "size(): Integer", 6)
			repl_candidate(candidates, name + ".push", name + ".push(", "push(value)", 6)
		end
		if type_name == "String"
			repl_candidate(candidates, name + ".size", name + ".size()", "size(): Integer", 6)
		end
		if type_name == "String"
			repl_candidate(candidates, name + ".to_i", name + ".to_i()", "to_i(): Integer", 6)
		end
		if type_name == "Integer"
			repl_candidate(candidates, name + ".to_s", name + ".to_s()", "to_s(): String", 6)
		end
		record_index := gate4_find_record_type(state, type_name)
		if record_index >= 0
			start := gate4_load_integer(state.record_field_starts, record_index)
			count := gate4_load_integer(state.record_field_counts, record_index)
			mut field := 0
			while field < count
				member := name + "." + gate4_load_string(state.field_names, start + field)
				repl_candidate(candidates, member, member, gate4_type_display(state, gate4_load_string(state.field_types, start + field)), 0)
				field += 1
			end
		end
		index += 1
	end
	index = 0
	while index < state.function_count[0]
		if gate4_load_integer(state.function_modules, index) == state.entry_module[0]
			name := gate4_load_string(state.function_names, index)
			if name != "main"
				repl_candidate(candidates, name, repl_function_insertion(state, index, name), repl_function_detail(state, index), 6)
			end
		end
		index += 1
	end
	index = 0
	while index < state.import_count[0]
		name := gate4_load_string(state.import_symbols, index)
		if name != ""
			mut imported_function :=- 1
			if gate4_load_integer(state.import_kinds, index) == 0
				imported_function = gate4_find_function_in_module(state, gate4_load_integer(state.import_targets, index), name)
			end
			if imported_function >= 0
				repl_candidate(candidates, name, repl_function_insertion(state, imported_function, name), repl_function_detail(state, imported_function), 6)
			else
				repl_candidate(candidates, name, name, "project declaration", 0)
			end
		end
		index += 1
	end
	index = 0
	while index < state.record_count[0]
		repl_candidate(candidates, gate4_load_string(state.record_names, index), gate4_load_string(state.record_names, index), "record type", 5)
		repl_candidate(candidates, gate4_load_string(state.record_names, index) + ".new", gate4_load_string(state.record_names, index) + ".new(", "record constructor", 6)
		index += 1
	end
	return candidates
end

# Record indexes are compiler-state-local. Preserve nominal identities when a
# new session declaration changes the ordering of imported record types.
def repl_remap_records(previous: Gate4Compiler, current: Gate4Compiler, mut store: ReplStore)
	mut index := 0
	while index < store.types.size()
		record_index := gate4_find_record_type(previous, store.types[index])
		if record_index >= 0
			module_index := gate4_load_integer(previous.record_modules, record_index)
			module_name := gate4_load_string(previous.module_names, module_index)
			name := gate4_load_string(previous.record_names, record_index)
			next_module := gate4_find_module(current, module_name)
			next_record := gate4_find_record_in_module(current, next_module, name)
			store.types[index] = gate4_record_type(next_record)
		end
		index += 1
	end
	return
end

# Explicit reload/load rebuild the session, matching the reference commands.
# Ordinary submissions continue to evaluate only their newly authored input.
def repl_replay(mut session: ReplSession, config: String, additional: Array<String>): ReplReplay
	project := repl_project(config)
	if project.error != ""
		native_cli_write("trbn: " + project.error + "\n", 2)
		return ReplReplay.new(session: session, success: false)
	end
	mut replayed := ReplSession.new(project: project, text: [project.imports, ""], store: repl_store(), environment: repl_environment(), submissions: [])
	mut inputs: Array<String> := []
	mut index := 0
	while index < session.submissions.size()
		inputs.push(session.submissions[index])
		index += 1
	end
	index = 0
	while index < additional.size()
		inputs.push(additional[index])
		index += 1
	end
	# Check the complete replacement before replaying any observable effects.
	mut declarations := project.imports
	mut body := ""
	index = 0
	while index < inputs.size()
		if repl_is_declaration(inputs[index])
			declarations += inputs[index] + "\n"
		else
			body += inputs[index] + "\n"
		end
		index += 1
	end
	checked := repl_checked(declarations + "def main()\n" + body + "return\nend\n", project.root)
	if gate4_has_diagnostic(checked)
		mut offset := repl_lines(project.imports)
		mut body_offset := repl_lines(declarations) + 1
		mut input_index := 0
		mut diagnostic_offset := 0
		mut submitted_lines := 0
		line := gate4_load_integer(checked.diagnostic_lines, 0)
		while input_index < inputs.size()
			count := repl_lines(inputs[input_index]) + 1
			mut start := body_offset
			if repl_is_declaration(inputs[input_index])
				start = offset
				offset += count
			else
				body_offset += count
			end
			if line > start
				if line <= start + count
					diagnostic_offset = start - submitted_lines
				end
			end
			submitted_lines += count
			input_index += 1
		end
		repl_diagnostic(checked, diagnostic_offset)
		return ReplReplay.new(session: session, success: false)
	end
	replayed.text[0] = declarations
	index = 0
	while index < inputs.size()
		if !repl_is_declaration(inputs[index])
			if !repl_submit(replayed, inputs[index], false, false)
				return ReplReplay.new(session: session, success: false)
			end
		end
		replayed.submissions.push(inputs[index])
		replayed = ReplSession.new(project: replayed.project, text: replayed.text, store: repl_compact(replayed.store, replayed.environment), environment: replayed.environment, submissions: replayed.submissions)
		index += 1
	end
	return ReplReplay.new(session: replayed, success: true)
end

def repl_split_source(source: String): Array<String>
	mut submissions: Array<String> := []
	mut pending := ""
	mut index := 0
	while index <= source.size()
		mut character := "\n"
		if index < source.size()
			character = source[index]
		end
		pending += character
		if character == "\n"
			if !repl_incomplete(pending)
				input := repl_trim(pending)
				if input != ""
					submissions.push(input)
				end
				pending = ""
			end
		end
		index += 1
	end
	if pending != ""
		submissions.push(pending)
	end
	return submissions
end

def repl_is_declaration(input: String): Boolean
	mut probe := gate4_compiler_new(input.size() * 3 + 16)
	gate4_lex(probe, input)
	mut first := [0]
	gate4_skip_newlines(probe, first)
	mut declarations := gate4_token_is(probe, first[0], "def")
	if gate4_token_is(probe, first[0], "record")
		declarations = true
	end
	if gate4_token_is(probe, first[0], "import")
		declarations = true
	end
	return declarations
end

def repl_cancelled(status: Integer): Boolean
	if status == 2
		return true
	end
	return native_cli_interrupt(0) != 0
end

def repl_ended(status: Integer, interactive: Boolean): Boolean
	if interactive
		return status == 1
	end
	return native_cli_eof() != 0
end

def repl_keep_history(input: String): Boolean
	if input == ":quit"
		return false
	end
	if input == ":q"
		return false
	end
	return input != ":exit"
end

def repl_candidate(mut candidates: ReplCandidates, label: String, insertion: String, detail: String, kind: Integer)
	mut index := 0
	while index < candidates.labels.size()
		if candidates.labels[index] == label
			return
		end
		index += 1
	end
	candidates.labels.push(label)
	candidates.insertions.push(insertion)
	candidates.details.push(detail)
	candidates.kinds.push(kind)
	return
end

def repl_function_detail(state: Gate4Compiler, index: Integer): String
	mut detail := gate4_load_string(state.function_names, index) + "("
	start := gate4_load_integer(state.function_parameter_starts, index)
	count := gate4_load_integer(state.function_parameter_counts, index)
	mut parameter := 0
	while parameter < count
		if parameter > 0
			detail += ", "
		end
		detail += gate4_load_string(state.parameter_names, start + parameter) + ": " + gate4_type_display(state, gate4_load_string(state.parameter_types, start + parameter))
		parameter += 1
	end
	return detail + "): " + gate4_type_display(state, gate4_load_string(state.function_result_types, index))
end

def repl_use_color(): Boolean
	if native_cli_tty() == 0
		return false
	end
	return native_cli_env("NO_COLOR") == ""
end

def repl_error_text(message: String): String
	if repl_use_color()
		return repl_escape() + "38;2;255;88;116m" + message + repl_escape() + "0m"
	end
	return message
end

def repl_diagnostic(state: Gate4Compiler, offset: Integer)
	native_cli_write(repl_error_text(cli_diagnostic(state, "(trb)", offset)) + "\n", 2)
	return
end

def repl_function_insertion(state: Gate4Compiler, index: Integer, name: String): String
	if gate4_load_integer(state.function_parameter_counts, index) == 0
		return name + "()"
	end
	return name + "("
end
