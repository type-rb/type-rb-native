def multiply(left: Integer, right: Integer): Integer
	return left * right
end

def main()
	root := 67108863
	above_root := root + 1
	zero := 0
	negative_root :=- root
	negative_one :=- 1
	maximum := 9007199254740991
	minimum :=- maximum
	puts(multiply(root, root).to_s())
	puts(multiply(above_root, root).to_s())
	puts(multiply(negative_root, root).to_s())
	puts(multiply(maximum, zero).to_s())
	puts(multiply(zero, minimum).to_s())
	puts(multiply(minimum, negative_one).to_s())
	return
end
