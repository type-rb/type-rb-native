def equal(text: String, index: Integer, pattern: String): Boolean
	return text[index] == pattern
end

def different(text: String, index: Integer, pattern: String): Boolean
	return pattern != text[index]
end

def main()
	text := "aα" + "漢🙂"
	puts(equal(text, 0, "a"))
	puts(equal(text, 1, "α"))
	puts(equal(text, 2, "漢"))
	puts(equal(text, -1, "🙂"))
	puts(different(text, -2, "α"))
	puts(equal(text, 0, ""))
	puts(equal(text, 0, "aa"))
end
