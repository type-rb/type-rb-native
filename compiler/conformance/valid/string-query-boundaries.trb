def show(value: Integer?)
	if value == nil
		puts("nil")
	else
		puts(value)
	end
end

def probe()
	puts("".empty?())
	puts("😀".empty?())
	puts("".include?(""))
	puts("".start_with?(""))
	puts("".end_with?(""))
	show("".index(""))
	show("".rindex(""))
	puts("".include?("a"))
	puts("a".start_with?("ab"))
	puts("a".end_with?("ab"))
	show("a".index("ab"))
	show("a".rindex("ab"))
	puts("😀".include?(""))
	puts("😀".start_with?(""))
	puts("😀".end_with?(""))
	show("😀".index(""))
	show("😀".rindex(""))
	show("😀".index("😀"))
	show("😀".rindex("😀"))
	puts("a\nb".include?("\n"))
end

def main()
	probe()
end
