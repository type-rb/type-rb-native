record Window
	bounds: Range<Integer>
end

def chosen_range(mut calls: Array<Integer>): Range<Integer>
	calls[0] += 1
	return 1...4
end

def range_sum(bounds: Range<Integer>): Integer
	mut total := 0
	bounds.each do |value|
		total += value
	end
	return total
end

def first_three(bounds: Range<Integer>): Integer
	bounds.each.with_index do |value, index|
		if value == 3
			return index
		end
	end
	return - 1
end

def main()
	window := Window.new(bounds: 2...5)
	puts(range_sum(window.bounds))
	stored: Array<Range<Integer>> := [(- 1..1), (5...5)]
	puts(range_sum(stored[0]))
	puts(range_sum(stored[1]))
	mut sources: Array<Range<Integer>> := [(1..3)]
	mut total := 0
	sources[0].each do |value|
		sources[0] = 8..8
		total += value
	end
	puts(total)
	puts(range_sum(sources[0]))
	mut calls := [0]
	chosen_range(calls).each do |value|
		puts(value)
	end
	puts(calls[0])
	mut seen: Array<Integer> := []
	(9007199254740990..9007199254740991).each.with_index do |value, index|
		seen.push(value)
		seen.push(index)
		if value == 9007199254740991
			next
		end
		value = 0
		index = 99
	end
	puts(seen[0])
	puts(seen[1])
	puts(seen[2])
	puts(seen[3])
	mut nested := 0
	[1, 2].each do |outer|
		(1..3).each do |inner|
			if inner == 2
				next
			end
			nested += outer * 10 + inner
			if inner == 3
				break
			end
		end
	end
	puts(nested)
	puts(first_three(1..4))
	puts(first_three(4..6))
end
