def main()
	values := [- 9007199254740991, - 3, - 2, - 1, 0, 1, 2, 3, 9007199254740991]
	values.each do |value|
		puts(value.abs())
		puts(value.zero?())
		puts(value.positive?())
		puts(value.negative?())
		puts(value.even?())
		puts(value.odd?())
		puts(value.to_f() == value * 1.0)
		puts(value.min(0))
		puts(value.max(0))
		puts(value.clamp(- 2, 2))
	end
	puts(3.clamp(3, 3))
	puts((- 9007199254740991).clamp(- 9007199254740991, 9007199254740991))
	puts((- 3).abs().min(2).max(1).to_f() == 2.0)
end
