record WindowEntry
	text: String
	values: Array<Integer>
end

def integer_window(): Boolean
	mut values := [0, 1, 2, 3]
	view := values
	mut incoming := 4
	mut first := 0
	mut correct := true
	while incoming < 260
		correct = values.shift() == first && correct
		values.push(incoming)
		correct = view[0] == first + 1 && view[-1] == incoming && correct
		first += 1
		incoming += 1
	end
	values.shift()
	copy := values.dup()
	backward := values.reverse()
	part := values.slice(1...3)
	correct = copy[0] == 257 && backward[0] == 259 && part[0] == 258 && correct
	values.unshift(256)
	values.unshift(255)
	correct = view[0] == 255 && values.pop() == 259 && correct
	while !values.empty?()
		values.shift()
	end
	values.push(7)
	values.unshift(6)
	correct = view[0] == 6 && values.pop() == 7 && values.pop() == 6 && correct
	values.push(8)
	return values.size() == 1 && view[0] == 8 && correct
end

def floating_window(): Boolean
	mut values := [-0.0, 1.25, 2.25, 3.25]
	negative_zero := values.shift()
	values.push(4.25)
	mut first := 1
	mut incoming := 5
	mut correct := 1.0 / negative_zero < 0.0
	while incoming < 260
		correct = values.shift() == first + 0.25 && correct
		values.push(incoming + 0.25)
		first += 1
		incoming += 1
	end
	values.unshift(-0.0)
	correct = 1.0 / values.shift() < 0.0 && correct
	while !values.empty?()
		values.pop()
	end
	values.push(-0.0)
	return 1.0 / values[0] < 0.0 && correct
end

def managed_window(): Boolean
	mut child := [7]
	mut values: Array<WindowEntry> := []
	mut index := 0
	while index < 4
		values.push(WindowEntry.new(text: index.to_s(), values: child))
		index += 1
	end
	view := values
	mut first := 0
	mut correct := true
	while index < 140
		removed := values.shift()
		correct = removed.text == first.to_s() && removed.values[0] == 7 && correct
		values.push(WindowEntry.new(text: index.to_s(), values: child))
		first += 1
		index += 1
	end
	values.shift()
	copy := values.dup()
	values.unshift(WindowEntry.new(text: "reused", values: child))
	child.push(9)
	correct = view[0].text == "reused" && copy[0].values[1] == 9 && correct
	mut table := { "one" => child, "two" =>[8] }
	mut keys := table.keys()
	mut entries := table.values()
	keys.shift()
	entries.shift()
	keys.push("three")
	entries.push(child)
	return entries.last()[1] == 9 && keys.last() == "three" && correct
end

def main()
	puts(integer_window())
	puts(floating_window())
	puts(managed_window())
end
