def show(value: Integer?)
	if value == nil
		puts("nil")
	else
		puts(value)
	end
end
alias Text = String
record Entry
	label: Text
end

def probe()
	mut current := "old" + "😀tail"
	receiver := fn(): String
		puts("receiver")
		return current
	end
	argument := fn(): String
		puts("argument")
		current = "new"
		return "😀" + "tail"
	end
	show(receiver().index(argument()))
	puts(current)
	entry := Entry.new(label: "kept" + "日本")
	find := fn(part: Text): Integer?
		return entry.label.index(part)
	end
	show(find("日本"))
	show(entry.label.rindex("missing"))
	puts(entry.label)
	values := ["日x日", "😀x😀"].map { |text| text.rindex("x") }
	values.each { |value| show(value) }
end

def main()
	probe()
end
