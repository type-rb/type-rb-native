def update(mut left: Array<Integer>, mut right: Array<Integer>)
	mut first := left
	mut second := right
	mut index := 0
	while index < first.size()
		first[index] += second[index]
		second[index] += first[index]
		index += 1
	end
	return
end

def rebind(mut first: Array<Integer>, mut second: Array<Integer>): Integer
	before := first[- 1]
	first = second
	first[- 1] += before
	return first[- 1]
end

def local_rebind(mut first: Array<Integer>, mut second: Array<Integer>): Integer
	mut values := first
	before := values[- 1]
	values = second
	values[- 1] += before
	return values[- 1]
end

def grow_alias(mut first: Array<Integer>, mut second: Array<Integer>): Integer
	mut values := first
	before := values[- 1]
	second.push(7)
	return before + values[- 1]
end

def main()
	mut left := [1, 2]
	mut right := [3, 4]
	update(left, right)
	puts(left[0].to_s())
	puts(right[- 1].to_s())
	update(left, left)
	puts(left[0].to_s())
	puts(left[- 1].to_s())
	mut short := [5]
	puts(rebind(short, left).to_s())
	puts(short[- 1].to_s())
	puts(local_rebind(short, right).to_s())
	puts(grow_alias(short, short).to_s())
	mut empty: Array<Integer> := []
	update(empty, empty)
	puts(empty.size().to_s())
	return
end
