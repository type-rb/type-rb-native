def show(value: Integer?)
	if value == nil
		puts("nil")
	else
		puts(value)
	end
end

def probe()
	text := "A日本😀日本😀"
	show(text.index("日本"))
	show(text.rindex("日本"))
	show(text.index("😀"))
	show(text.rindex("😀"))
	show(text.index("本😀"))
	show(text.rindex("本😀"))
	show(text.index(""))
	show(text.rindex(""))
	show(text.index("missing"))
	puts(text.include?("日本😀"))
	puts(text.start_with?("A日"))
	puts(text.end_with?("本😀"))
	puts(text.start_with?("日本"))
	puts(text.end_with?("A日"))
	show("ababa".index("aba"))
	show("ababa".rindex("aba"))
	show("é é".index("é"))
	show("é é".index("́"))
	puts("é".include?("é"))
	show("👩‍💻x👩‍💻".rindex("💻"))
end

def main()
	probe()
end
