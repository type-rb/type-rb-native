def counted(mut calls: Array<Integer>, values: Array<Integer>): Array<Integer>
	calls[0] += 1
	return values
end

def main()
	mut values := [1, 2]
	mut retained := values
	mut calls := [0]
	mut sum := 0
	counted(calls, values).each.with_index do |value, index|
		if index == 0
			mut extra := 3
			while extra <= 40
				retained.push(extra)
				extra += 1
			end
			retained[1] = 20
			values = [99]
		end
		sum += value
		value = 1000
		index = 1000
	end
	puts(calls[0])
	puts(sum)
	puts(values[0])
	puts(retained.size())
	puts(retained[0])
	mut value := 500
	mut index := 600
	[10, 20].each().with_index() { |value, index| puts(value); puts(index); value += 1; index += 1 }
	puts(value)
	puts(index)
	mut empty: Array<Integer> := []
	empty.each { |_value| puts("unreachable") }
	[true, false].each { |flag| puts(flag) }
	[1.25, 2.5].each { |number| puts(number == 1.25 || number == 2.5) }
	[[1], [2, 3]].each do |row|
		row.push(4)
		puts(row.size())
	end
	[1, 2].each do |multiplier|
		mut row := [3, 4]
		mut cursor := 0
		while cursor < row.size()
			puts(multiplier * row[cursor])
			cursor += 1
		end
	end
	# Hash delimiters must not terminate the surrounding conditional in the REPL.
	if true
		mut table := { 1 => 2 }
		table[1] = 3
		puts(table[1])
	end
	[1].each { |_value| puts("\n") }
	puts("iteration complete")
end
