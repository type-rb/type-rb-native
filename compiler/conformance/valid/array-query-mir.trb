enum Direction
	Left
	Right
end

def main()
	values := [3, 1, 3, 2, 1]
	puts(values.include?(2))
	puts(values.include?(9))
	puts(values.count(3))
	found := values.index(1)
	if found != nil
		puts(found)
	end
	puts(values.index(9) == nil)
	mut unique := values.uniq()
	unique[0] = 8
	puts(values[0])
	unique.each { |value| puts(value) }
	joined := values.concat(values)
	puts(joined.size())
	puts(joined[5])
	empty: Array<Integer> := []
	puts(empty.include?(0))
	puts(empty.count(0))
	puts(empty.index(0) == nil)
	puts(empty.uniq().size())
	flags := [true, false, true]
	puts(flags.count(true))
	puts(flags.uniq().size())
	nan := 0.0 / 0.0
	negative_zero :=- 1.0 / (1.0 / 0.0)
	floats := [nan, nan, negative_zero, 0.0, 2.5]
	puts(floats.include?(nan))
	puts(floats.count(0))
	puts(floats.uniq().size())
	puts((1.0 / floats.uniq()[2]) < 0.0)
	directions := [Direction::Left, Direction::Right, Direction::Left]
	puts(directions.include?(Direction::Right))
	puts(directions.count(Direction::Left))
	puts(directions.uniq().size())
end
