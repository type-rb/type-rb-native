import trb/std/result
class Loaded
	readonly @kind: "loaded" := "loaded"
	@value: String
	def initialize(value: String)
		@value = value + "!"
	end
end
class Missing
	readonly @kind: "missing" := "missing"
	@code: Integer := 404
end
alias Response = Loaded | Missing
def read(value: Response): String
	return case value.kind
	when "loaded"
		value.value
	when "missing"
		value.code.to_s()
	end
end
def receive(): Result<Response, String>
	return Result<Response, String>::Ok(Loaded.new("result"))
end

def main()
	value := receive() catch |_|
		Missing.new()
	end
	puts(read(value))
end
