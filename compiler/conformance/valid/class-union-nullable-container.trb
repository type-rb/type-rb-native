class Loaded
	readonly @kind: "loaded" := "loaded"
	@value: String
	def initialize(value: String)
		@value = value + "!"
	end
end
class Missing
	readonly @kind: "missing" := "missing"
	@code: Integer := 404
end
alias Response = Loaded | Missing
def read(value: Response): String
	return case value.kind
	when "loaded"
		value.value
	when "missing"
		value.code.to_s()
	end
end

def main()
	values: Array<Response?> := [Loaded.new("held"), nil, Missing.new()]
	values.each do |value|
		if value != nil
			puts(read(value))
		end
	end
end
