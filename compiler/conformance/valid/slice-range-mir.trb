def slice_case_0()
	(1..5).each_slice(2).with_index { |batch, index| puts(index); puts(batch.size()); puts(batch[0]); puts(batch[- 1]) }
	(1...5).each_slice(2) { |batch| puts(batch[- 1]) }
	(5..1).each_slice(3) { |_batch| puts(99) }
	(1...1).each_slice(3) { |_batch| puts(99) }

end

def slice_case_1()
	(- 9007199254740991..9007199254740991).each_slice(3) do |batch|
		puts(batch.size())
		puts(batch[0])
		puts(batch[- 1])
		break
	end
	(9007199254740990..9007199254740991).each_slice(3).with_index { |batch, index| puts(index); puts(batch.size()); puts(batch[- 1]) }
	(9007199254740990...9007199254740991).each_slice(1) { |batch| puts(batch[0]) }
	(9007199254740991..9007199254740991).each_slice(1) { |batch| puts(batch[0]) }

end

def slice_case_2()
	mut total := 0
	(1..3).each_slice(2) do |outer|
		[4, 5, 6].each_slice(1) do |inner|
			next if inner[0] == 5
			total += outer[0] + inner[0]
		end
	end
	puts(total)

end

def main()
	slice_case_0()
	slice_case_1()
	slice_case_2()
end
