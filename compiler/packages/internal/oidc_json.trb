module OidcJson
end

import { JsonNode, JsonParser, _byte, _node, _space, _string } from trb/internal/json
import trb/std/encoding/base64
import trb/std/result

# OIDC follows encoding/json's typed structs and float64 claims, not the
# public JSON codec's portable Integer conversion. Reuse its syntax scanner;
# retain ordered struct fields so duplicate nulls do not erase earlier strings.
record StringObject
	valid: Boolean
	fields: Hash<String, String>
end

record KeyDocument
	valid: Boolean
	keys: Array<Hash<String, String>>
end

def fold(value: String): String
	mut parts: Array<String> := []
	lower := value.downcase()
	lower.codepoints().each.with_index do |point, index|
		if point == 383
			parts.push("s")
		else
			parts.push(lower[index])
		end
	end
	return parts.join("")
end

def finish(mut parser: JsonParser): Boolean
	_space(parser)
	return parser.failure == nil && parser.position == parser.bytes.size()
end

def strings(mut parser: JsonParser, names: Array<String>): StringObject
	mut fields: Hash<String, String> := {}
	_space(parser)
	if _byte(parser) == 110
		identity := _node(parser)
		return StringObject.new(valid: identity >= 0 && parser.failure == nil, fields: fields)
	end
	if _byte(parser) != 123
		return StringObject.new(valid: false, fields: fields)
	end
	parser.position += 1
	_space(parser)
	if _byte(parser) == 125
		parser.position += 1
		return StringObject.new(valid: true, fields: fields)
	end
	mut valid := true
	while parser.failure == nil
		if _byte(parser) != 34
			return StringObject.new(valid: false, fields: fields)
		end
		name := fold(_string(parser))
		_space(parser)
		if _byte(parser) != 58
			return StringObject.new(valid: false, fields: fields)
		end
		parser.position += 1
		identity := _node(parser)
		if identity < 0
			return StringObject.new(valid: false, fields: fields)
		end
		if names.include?(name)
			case parser.nodes[identity]
			when JsonNode::String(text)
				fields[name] = text
			when JsonNode::Null
				nil
			else
				valid = false
			end
		end
		_space(parser)
		if _byte(parser) == 125
			parser.position += 1
			return StringObject.new(valid: valid && parser.failure == nil, fields: fields)
		end
		if _byte(parser) != 44
			return StringObject.new(valid: false, fields: fields)
		end
		parser.position += 1
		_space(parser)
	end
	return StringObject.new(valid: false, fields: fields)
end

def parse_strings(bytes: Bytes, names: Array<String>): StringObject
	mut parser := JsonParser.new(bytes)
	result := strings(parser, names)
	return StringObject.new(valid: result.valid && finish(parser), fields: result.fields)
end

def key_array(mut parser: JsonParser): KeyDocument
	mut keys: Array<Hash<String, String>> := []
	_space(parser)
	if _byte(parser) == 110
		identity := _node(parser)
		return KeyDocument.new(valid: identity >= 0 && parser.failure == nil, keys: keys)
	end
	if _byte(parser) != 91
		return KeyDocument.new(valid: false, keys: keys)
	end
	parser.position += 1
	_space(parser)
	if _byte(parser) == 93
		parser.position += 1
		return KeyDocument.new(valid: true, keys: keys)
	end
	while parser.failure == nil
		key := strings(parser, ["kid", "kty", "use", "alg", "n", "e"])
		if !key.valid
			return KeyDocument.new(valid: false, keys: keys)
		end
		keys.push(key.fields)
		_space(parser)
		if _byte(parser) == 93
			parser.position += 1
			return KeyDocument.new(valid: true, keys: keys)
		end
		if _byte(parser) != 44
			return KeyDocument.new(valid: false, keys: keys)
		end
		parser.position += 1
	end
	return KeyDocument.new(valid: false, keys: keys)
end

def parse_keys(bytes: Bytes): KeyDocument
	mut parser := JsonParser.new(bytes)
	mut keys: Array<Hash<String, String>> := []
	_space(parser)
	if _byte(parser) == 110
		identity := _node(parser)
		return KeyDocument.new(valid: identity >= 0 && finish(parser), keys: keys)
	end
	if _byte(parser) != 123
		return KeyDocument.new(valid: false, keys: keys)
	end
	parser.position += 1
	_space(parser)
	if _byte(parser) == 125
		parser.position += 1
		return KeyDocument.new(valid: finish(parser), keys: keys)
	end
	while parser.failure == nil
		if _byte(parser) != 34
			return KeyDocument.new(valid: false, keys: keys)
		end
		name := fold(_string(parser))
		_space(parser)
		if _byte(parser) != 58
			return KeyDocument.new(valid: false, keys: keys)
		end
		parser.position += 1
		if name == "keys"
			result := key_array(parser)
			if !result.valid
				return result
			end
			keys = result.keys
		else
			if _node(parser) < 0
				return KeyDocument.new(valid: false, keys: keys)
			end
		end
		_space(parser)
		if _byte(parser) == 125
			parser.position += 1
			return KeyDocument.new(valid: finish(parser), keys: keys)
		end
		if _byte(parser) != 44
			return KeyDocument.new(valid: false, keys: keys)
		end
		parser.position += 1
		_space(parser)
	end
	return KeyDocument.new(valid: false, keys: keys)
end

def parse_claims(bytes: Bytes): JsonParser?
	mut parser := JsonParser.new(bytes)
	root := _node(parser)
	if root < 0 || !finish(parser)
		return nil
	end
	case parser.nodes[root]
	when JsonNode::Object(_members)
		nil
	when JsonNode::Null
		nil
	else
		return nil
	end
	# encoding/json converts even overwritten/unknown numeric fields to float64.
	# Do not apply the standard JSON API's portable Integer range here.
	mut index := 0
	while index < parser.nodes.size()
		case parser.nodes[index]
		when JsonNode::Number(text)
			case text.try_to_f()
			when Result::Err(_error)
				return nil
			else
				nil
			end
		else
			nil
		end
		index += 1
	end
	return parser
end

def field(parser: JsonParser, name: String): JsonNode
	case parser.nodes[0]
	when JsonNode::Object(members)
		if parser.objects[members].key?(name)
			return parser.nodes[parser.objects[members].fetch(name)]
		end
	else
		nil
	end
	return JsonNode::Null
end

def text(node: JsonNode): String
	case node
	when JsonNode::String(value)
		return value
	else
		return ""
	end
end

def number(node: JsonNode): Float?
	case node
	when JsonNode::Number(value)
		case value.try_to_f()
		when Result::Ok(parsed)
			return parsed
		else
			return nil
		end
	else
		return nil
	end
end

def get(fields: Hash<String, String>, name: String): String
	if fields.key?(name)
		return fields.fetch(name)
	end
	return ""
end

# Go's RawURLEncoding ignores CR/LF and accepts unused low bits. The shared
# Base64 API deliberately rejects both, so normalize only this internal input.
def decode(value: String): Bytes?
	mut parts: Array<String> := []
	mut index := 0
	while index < value.size()
		if value[index] != "\r" && value[index] != "\n"
			parts.push(value[index])
		end
		index += 1
	end
	alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
	if parts.size() % 4 == 2 || parts.size() % 4 == 3
		last := parts.size() - 1
		mut digit := 0
		while digit < 64
			if alphabet[digit] == parts[last]
				mut divisor := 4
				if parts.size() % 4 == 2
					divisor = 16
				end
				parts[last] = alphabet[(digit / divisor) * divisor]
				break
			end
			digit += 1
		end
	end
	case Base64.url_decode(parts.join(""))
	when Result::Ok(bytes)
		return bytes
	else
		return nil
	end
end
