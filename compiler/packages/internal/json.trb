import trb/std/string_builder
import trb/internal/string_builder_storage as BuilderStorage
import { Result } from trb/std/result
import trb/std/json as PublicJSON
import trb/internal/encoding_bytes as Octets

module JSON
end

# Defer numeric conversion failures until syntax and duplicate keys are resolved.
# Proven portable integer tokens can retain their value without a copied String.
enum JsonNode
	Null
	Boolean(value: Boolean)
	Number(text: String)
	PortableInteger(value: Integer)
	String(text: String)
	Array(items_index: Integer)
	Object(members_index: Integer)
end

# Parsing helpers share one cursor without wrapping each scalar in an Array.
class JsonParser
	@bytes: Bytes
	@position: Integer := 0
	# Completed strings are independent snapshots; only scratch storage is reused.
	@string_buffer: StringBuilder := StringBuilder.new()
	@nodes: Array<JsonNode> := []
	# Enum patterns are immutable. Keep child containers under the parser's
	# mutable ownership and store only their pool indexes in raw node variants.
	@arrays: Array<Array<Integer>> := []
	@objects: Array<Hash<String, Integer>> := []
	@failure: PublicJSON::Error? := nil
	def initialize(bytes: Bytes)
		@bytes = bytes
	end
end

def _slice(source: String, start: Integer, finish: Integer): String
	mut text := ""
	mut index := start
	while index < finish
		text += source[index]
		index += 1
	end
	return text
end

def _byte(parser: JsonParser): Integer
	if parser.position >= parser.bytes.size()
		return -1
	end
	return parser.bytes.at(parser.position)
end

# Preserve byte offsets until the complete span has been copied.
def _source_slice(mut parser: JsonParser, start: Integer, finish: Integer): String
	mut builder := parser.string_buffer
	builder.clear()
	BuilderStorage.append_bytes(builder, parser.bytes, start, finish)
	text := builder.to_s()
	builder.clear()
	return text
end

def _space(mut parser: JsonParser)
	mut character := _byte(parser)
	while character == 32 || character == 10 || character == 13 || character == 9
		parser.position += 1
		character = _byte(parser)
	end
end

def _error(kind: PublicJSON::ErrorKind, message: String, path: String): PublicJSON::Error
	return PublicJSON::Error.new(kind: kind, message: message, path: path, line: nil, column: nil)
end

def _byte_width(bytes: Bytes, position: Integer, finish: Integer): Integer
	first := bytes.at(position)
	mut width := 1
	if first >= 194 && first < 224
		width = 2
	elsif first >= 224 && first < 240
		width = 3
	elsif first >= 240 && first < 245
		width = 4
	end
	if position + width > finish
		return 1
	end
	# Validate encoded bytes directly. Building a String here would allocate
	# for every code point, including the common unescaped JSON string path.
	mut index := 1
	while index < width
		continuation := bytes.at(position + index)
		if continuation < 128 || continuation > 191
			return 1
		end
		index += 1
	end
	if width >= 3
		second := bytes.at(position + 1)
		if (first == 224 && second < 160) || (first == 237 && second >= 160) || (first == 240 && second < 144) || (first == 244 && second >= 144)
			return 1
		end
	end
	return width
end

def _syntax(mut parser: JsonParser, message: String, location: Integer)
	if parser.failure != nil
		return
	end
	if location < 0
		parser.failure = _error(PublicJSON::ErrorKind::Syntax, message, "")
		return
	end
	# The reference counts runes before the error's final byte, consuming each
	# incomplete or invalid UTF-8 byte separately rather than replacing a run.
	mut line := 1
	mut column := 1
	mut index := 0
	while index < location
		if parser.bytes.at(index) == 10
			line += 1
			column = 1
		else
			column += 1
		end
		index += _byte_width(parser.bytes, index, location)
	end
	parser.failure = PublicJSON::Error.new(kind: PublicJSON::ErrorKind::Syntax, message: message, path: "", line: line, column: column)
end

def _diagnostic_hex(value: Integer, width: Integer): String
	mut number := value
	mut text := ""
	mut index := 0
	while index < width
		text = "0123456789abcdef"[number % 16] + text
		number /= 16
		index += 1
	end
	return text
end

def _diagnostic_range(data: String, point: Integer): Boolean
	mut low := 0
	mut high := data.size() / 12
	while low < high
		middle := low + (high - low) / 2
		mut start := 0
		mut finish := 0
		mut index := 0
		while index < 6
			start = start * 16 + _hex(data[middle * 12 + index])
			finish = finish * 16 + _hex(data[middle * 12 + 6 + index])
			index += 1
		end
		if point < start
			high = middle
		elsif point > finish
			low = middle + 1
		else
			return true
		end
	end
	return false
end

def _diagnostic_character(character: String, quote: String): String
	if !character.to_bytes().valid_utf8?()
		return "\\x" + _diagnostic_hex(character.to_bytes().at(0), 2)
	end
	if character == quote || character == "\\"
		return "\\" + character
	end
	point := character.codepoints()[0]
	if _diagnostic_range(_diagnostic_printable_data(), point)
		return character
	end
	if point == 7
		return "\\a"
	elsif point == 8
		return "\\b"
	elsif point == 9
		return "\\t"
	elsif point == 10
		return "\\n"
	elsif point == 11
		return "\\v"
	elsif point == 12
		return "\\f"
	elsif point == 13
		return "\\r"
	elsif point < 32 || point == 127
		return "\\x" + _diagnostic_hex(point, 2)
	elsif point < 65536
		return "\\u" + _diagnostic_hex(point, 4)
	end
	return "\\U" + _diagnostic_hex(point, 8)
end

def _quoted(character: String): String
	return "'" + _diagnostic_character(character, "'") + "'"
end

def _bad(mut parser: JsonParser, context: String)
	if _byte(parser) < 0
		_syntax(parser, "unexpected EOF", -1)
	else
		width := _byte_width(parser.bytes, parser.position, parser.bytes.size())
		character := _source_slice(parser, parser.position, parser.position + width)
		_syntax(parser, "invalid character " + _quoted(character) + " " + context, parser.position + width - 1)
	end
end

def _hex(character: String): Integer
	mut index := 0
	while index < 16
		if "0123456789abcdef"[index] == character || "0123456789ABCDEF"[index] == character
			return index
		end
		index += 1
	end
	return -1
end

def _hex_byte(character: Integer): Integer
	if character >= 48 && character <= 57
		return character - 48
	elsif character >= 65 && character <= 70
		return character - 55
	elsif character >= 97 && character <= 102
		return character - 87
	end
	return -1
end

def _rune(point: Integer): String
	if point < 128
		return Octets.octet(point)
	elsif point < 2048
		return Octets.octet(192 + point / 64) + Octets.octet(128 + point % 64)
	elsif point < 65536
		return Octets.octet(224 + point / 4096) + Octets.octet(128 + point / 64 % 64) + Octets.octet(128 + point % 64)
	end
	return Octets.octet(240 + point / 262144) + Octets.octet(128 + point / 4096 % 64) + Octets.octet(128 + point / 64 % 64) + Octets.octet(128 + point % 64)
end

def _escape_diagnostic(sequence: String): String
	bytes := sequence.to_bytes()
	mut needs_quotes := false
	mut encoded := "\""
	mut index := 0
	while index < bytes.size()
		width := _byte_width(bytes, index, bytes.size())
		if width == 1 && bytes.at(index) >= 128
			needs_quotes = true
			encoded += "\\x" + _diagnostic_hex(bytes.at(index), 2)
		else
			mut raw := ""
			mut offset := 0
			while offset < width
				raw += Octets.octet(bytes.at(index + offset))
				offset += 1
			end
			character := raw.to_bytes().to_s()
			point := character.codepoints()[0]
			if point == 96 || point == 65533 || !_diagnostic_range(_diagnostic_printable_data(), point) || _diagnostic_range(_diagnostic_space_data(), point)
				needs_quotes = true
			end
			encoded += _diagnostic_character(character, "\"")
		end
		index += width
	end
	if needs_quotes
		return encoded + "\""
	end
	return "`" + sequence.to_bytes().to_s() + "`"
end

def _unicode(mut parser: JsonParser): Integer
	mut value := 0
	mut count := 0
	start := parser.position
	mut valid := true
	while count < 4 && parser.position < parser.bytes.size()
		character := parser.bytes.at(parser.position)
		digit := _hex_byte(character)
		if digit < 0
			valid = false
		else
			value = value * 16 + digit
		end
		parser.position += 1
		count += 1
	end
	if count < 4 && _byte(parser) < 0 && valid
		_syntax(parser, "unexpected EOF", -1)
		return -1
	end
	if !valid || count != 4
		# Successful escapes need only the code point, not a diagnostic String.
		sequence := "\\u" + _source_slice(parser, start, parser.position)
		_syntax(parser, "invalid escape sequence " + _escape_diagnostic(sequence) + " in string", parser.position - 1)
		return -1
	end
	return value
end

def _string(mut parser: JsonParser): String
	parser.position += 1
	mut builder := parser.string_buffer
	builder.clear()
	# The input is immutable. Publish the cursor only at parser boundaries;
	# errors and Unicode escape decoding still use the shared parser position.
	bytes := parser.bytes
	finish := bytes.size()
	mut position := parser.position
	mut span_start := position
	if parser.failure != nil
		return ""
	end
	while position < finish
		character := bytes.at(position)
		if character == 34
			BuilderStorage.append_bytes(builder, bytes, span_start, position)
			parser.position = position + 1
			text := builder.to_s()
			builder.clear()
			return text
		end
		if character < 32
			parser.position = position
			_bad(parser, "in string")
			return ""
		end
		if character >= 128
			width := _byte_width(bytes, position, finish)
			if width == 1
				BuilderStorage.append_bytes(builder, bytes, span_start, position)
				builder.append_codepoint(65533)
				position += 1
				span_start = position
			else
				position += width
			end
			next
		end
		position += 1
		if character != 92
			next
		end
		BuilderStorage.append_bytes(builder, bytes, span_start, position - 1)
		if position == finish
			break
		end
		escape := bytes.at(position)
		position += 1
		if escape == 34 || escape == 92 || escape == 47
			builder.append_codepoint(escape)
		elsif escape == 98
			builder.append("\x08")
		elsif escape == 102
			builder.append("\x0c")
		elsif escape == 110
			builder.append("\n")
		elsif escape == 114
			builder.append("\r")
		elsif escape == 116
			builder.append("\t")
		elsif escape == 117
			parser.position = position
			mut point := _unicode(parser)
			position = parser.position
			if point < 0
				return ""
			end
			if point >= 55296 && point <= 56319
				start := position
				if start + 6 <= finish && bytes.at(start) == 92 && bytes.at(start + 1) == 117
					mut low := 0
					mut offset := 2
					while offset < 6 && _hex_byte(bytes.at(start + offset)) >= 0
						low = low * 16 + _hex_byte(bytes.at(start + offset))
						offset += 1
					end
					if offset == 6 && low >= 56320 && low <= 57343
						point = 65536 + (point - 55296) * 1024 + low - 56320
						position += 6
					end
				end
			end
			if point >= 55296 && point <= 57343
				point = 65533
			end
			builder.append_codepoint(point)
		else
			parser.position = position
			_syntax(parser, "invalid escape sequence " + _escape_diagnostic("\\" + Octets.octet(escape)) + " in string", position - 1)
			return ""
		end
		span_start = position
	end
	parser.position = position
	_syntax(parser, "unexpected EOF", -1)
	return ""
end

def _digit(character: Integer): Boolean
	return character >= 48 && character <= 57
end

# Scan one digit run without a call or parser-field store for each byte.
def _digits(mut parser: JsonParser)
	bytes := parser.bytes
	finish := bytes.size()
	mut position := parser.position
	while position < finish
		character := bytes.at(position)
		if character < 48 || character > 57
			break
		end
		position += 1
	end
	parser.position = position
end

def _number(mut parser: JsonParser): JsonNode
	start := parser.position
	negative := _byte(parser) == 45
	if negative
		parser.position += 1
	end
	if !_digit(_byte(parser))
		_bad(parser, "in numeric literal")
		return JsonNode::Null
	end
	mut integer := 0
	mut portable_integer := true
	if _byte(parser) == 48
		parser.position += 1
	else
		bytes := parser.bytes
		finish := bytes.size()
		mut position := parser.position
		# 2^53 - 1 is 9007199254740991. Check its decimal prefix before
		# multiplying so arbitrary-length numeric tokens cannot overflow.
		largest_prefix := 900719925474099
		largest_final_digit := 1
		while position < finish
			character := bytes.at(position)
			if character < 48 || character > 57
				break
			end
			digit := character - 48
			if portable_integer
				if integer > largest_prefix || (integer == largest_prefix && digit > largest_final_digit)
					portable_integer = false
				else
					integer = integer * 10 + digit
				end
			end
			position += 1
		end
		parser.position = position
	end
	if _byte(parser) == 46
		portable_integer = false
		parser.position += 1
		if !_digit(_byte(parser))
			_bad(parser, "in numeric literal")
			return JsonNode::Null
		end
		_digits(parser)
	end
	if _byte(parser) == 101 || _byte(parser) == 69
		portable_integer = false
		parser.position += 1
		if _byte(parser) == 43 || _byte(parser) == 45
			parser.position += 1
		end
		if !_digit(_byte(parser))
			_bad(parser, "in numeric literal")
			return JsonNode::Null
		end
		_digits(parser)
	end
	if portable_integer
		if negative
			integer = -integer
		end
		return JsonNode::PortableInteger(integer)
	end
	return JsonNode::Number(_source_slice(parser, start, parser.position))
end

def _literal(mut parser: JsonParser, literal: String)
	bytes := literal.to_bytes()
	mut index := 0
	while index < bytes.size()
		if _byte(parser) != bytes.at(index)
			_bad(parser, "in literal " + literal + " (expecting '" + literal[index] + "')")
			return
		end
		parser.position += 1
		index += 1
	end
end

# Nodes retain raw values; only reachable children are converted after syntax
# and duplicate-key handling finish. Explicit stacks preserve the JSON depth
# contract without consuming an evaluator call frame for each container.
def _atom(mut parser: JsonParser, depth: Integer): Integer
	_space(parser)
	character := _byte(parser)
	mut node := JsonNode::Null
	if character == 34
		node = JsonNode::String(_string(parser))
	elsif character == 110
		_literal(parser, "null")
	elsif character == 116 || character == 102
		mut text := "true"
		if character == 102
			text = "false"
		end
		_literal(parser, text)
		node = JsonNode::Boolean(character == 116)
	elsif character == 45 || _digit(character)
		node = _number(parser)
	elsif character == 91 || character == 123
		if depth >= 10000
			_syntax(parser, "exceeded max depth", parser.position)
			return -1
		end
		if character == 123
			node = JsonNode::Object(parser.objects.size())
			parser.objects.push({})
		else
			node = JsonNode::Array(parser.arrays.size())
			parser.arrays.push([])
		end
		parser.position += 1
	else
		_bad(parser, "looking for beginning of value")
		return -1
	end
	if parser.failure != nil
		return -1
	end
	identity := parser.nodes.size()
	parser.nodes.push(node)
	return identity
end

# Scalars have no closing delimiter and never enter the container stack.
def _closing_byte(node: JsonNode): Integer
	case node
	when JsonNode::Array(_items)
		return 93
	when JsonNode::Object(_members)
		return 125
	else
		return -1
	end
end

def _node(mut parser: JsonParser): Integer
	root := _atom(parser, 0)
	if root < 0 || _closing_byte(parser.nodes[root]) < 0
		return root
	end
	mut frames := [root]
	mut phases := [0]
	while !frames.empty?() && parser.failure == nil
		top := frames.size() - 1
		node := parser.nodes[frames[top]]
		closing := _closing_byte(node)
		_space(parser)
		character := _byte(parser)
		if phases[top] == 0 && character == closing
			parser.position += 1
			frames.pop()
			phases.pop()
			next
		end
		if phases[top] != 2
			mut key := ""
			if closing == 125
				if character != 34
					_bad(parser, "looking for beginning of object key string")
					return -1
				end
				key = _string(parser)
				_space(parser)
				if _byte(parser) != 58
					_bad(parser, "after object key")
					return -1
				end
				parser.position += 1
			end
			child := _atom(parser, frames.size())
			if child < 0
				return -1
			end
			case node
			when JsonNode::Object(members_index)
				parser.objects[members_index][key] = child
			when JsonNode::Array(items_index)
				parser.arrays[items_index].push(child)
			else
				# Only containers enter frames; fail closed if that invariant breaks.
				_syntax(parser, "unexpected scalar in container stack", -1)
				return -1
			end
			phases[top] = 2
			if _closing_byte(parser.nodes[child]) >= 0
				frames.push(child)
				phases.push(0)
			end
			next
		end
		if character == closing
			parser.position += 1
			frames.pop()
			phases.pop()
		elsif character == 44
			parser.position += 1
			phases[top] = 1
		else
			if closing == 125
				_bad(parser, "after object key:value pair")
			else
				_bad(parser, "after array element")
			end
			return -1
		end
	end
	return root
end

def _pointer(name: String): String
	mut escaped := ""
	mut index := 0
	while index < name.size()
		if name[index] == "~"
			escaped += "~0"
		elsif name[index] == "/"
			escaped += "~1"
		else
			escaped += name[index]
		end
		index += 1
	end
	return escaped
end

def _atomic_value(node: JsonNode): Result<PublicJSON::Value, PublicJSON::Error>
	case node
	when JsonNode::Null
		return Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Null)
	when JsonNode::Boolean(boolean)
		return Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Boolean(boolean))
	when JsonNode::PortableInteger(integer)
		return Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Integer(integer))
	when JsonNode::Number(text)
		case text.try_to_f()
		when Result::Ok(number)
			if number < -9007199254740991.0 || number > 9007199254740991.0
				return Result<PublicJSON::Value, PublicJSON::Error>::Err(_error(PublicJSON::ErrorKind::Decode, "JSON integer is outside the portable range", ""))
			end
			integer := number.to_i()
			if integer.to_f() == number
				return Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Integer(integer))
			end
			return Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Float(number))
		when Result::Err(_cause)
			return Result<PublicJSON::Value, PublicJSON::Error>::Err(_error(PublicJSON::ErrorKind::Decode, "JSON number is not finite", ""))
		end
	when JsonNode::String(text)
		return Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::String(text))
	else
		# Container conversion is handled by the explicit traversal stack.
		return Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Null)
	end
end

def _path(parents: Array<Integer>, parts: Array<String>, positions: Array<Integer>, identity: Integer): String
	# Keep raw keys and numeric indexes until the selected error needs its path.
	mut path := ""
	mut index := identity
	while parents[index] >= 0
		mut part := parts[index]
		if positions[index] >= 0
			part = positions[index].to_s()
		else
			part = _pointer(part)
		end
		path = "/" + part + path
		index = parents[index]
	end
	return path
end

def _decoding_path(parser: JsonParser, identity: Integer): String
	# Raw nodes have unique identities and at most one parent. Resolve path
	# metadata only after conversion fails, including the final duplicate keys.
	mut parents: Array<Integer> := []
	mut parts: Array<String> := []
	mut positions: Array<Integer> := []
	mut index := 0
	while index < parser.nodes.size()
		parents.push(-1)
		parts.push("")
		positions.push(-1)
		index += 1
	end
	index = 0
	while index < parser.nodes.size()
		case parser.nodes[index]
		when JsonNode::Array(items_index)
			children := parser.arrays[items_index]
			mut position := 0
			while position < children.size()
				child := children[position]
				parents[child] = index
				positions[child] = position
				position += 1
			end
		when JsonNode::Object(members_index)
			children := parser.objects[members_index]
			keys := children.keys()
			mut position := 0
			while position < keys.size()
				child := children.fetch(keys[position])
				parents[child] = index
				parts[child] = keys[position]
				position += 1
			end
		else
			nil
		end
		index += 1
	end
	return _path(parents, parts, positions, identity)
end

def _value(parser: JsonParser, identity: Integer): Result<PublicJSON::Value, PublicJSON::Error>
	# Node identities are dense indexes; unreachable duplicate-key nodes keep
	# their unused placeholder without requiring a second Hash lookup per edge.
	mut values: Array<PublicJSON::Value> := []
	mut index := 0
	while index < parser.nodes.size()
		values.push(PublicJSON::Value::Null)
		index += 1
	end
	mut pending := [identity]
	mut entered := [false]
	# Keep each active object's canonical order across its child traversal.
	# Nested objects push and pop their own keys without sorting a parent twice.
	mut object_keys: Array<Array<String>> := []
	while !pending.empty?()
		top := pending.size() - 1
		current := pending[top]
		node := parser.nodes[current]
		case node
		when JsonNode::Array(items_index)
			children := parser.arrays[items_index]
			if !entered[top]
				entered[top] = true
				index = children.size()
				while index > 0
					index -= 1
					child := children[index]
					pending.push(child)
					entered.push(false)
				end
				next
			end
			mut items: Array<PublicJSON::Value> := []
			index = 0
			while index < children.size()
				items.push(values[children[index]])
				index += 1
			end
			values[current] = PublicJSON::Value::Array(items)
		when JsonNode::Object(members_index)
			children := parser.objects[members_index]
			if !entered[top]
				keys := children.keys().sort()
				object_keys.push(keys)
				entered[top] = true
				index = keys.size()
				while index > 0
					index -= 1
					child := children.fetch(keys[index])
					pending.push(child)
					entered.push(false)
				end
				next
			end
			keys := object_keys[object_keys.size() - 1]
			object_keys.pop()
			mut members: Hash<String, PublicJSON::Value> := {}
			index = 0
			while index < keys.size()
				members[keys[index]] = values[children.fetch(keys[index])]
				index += 1
			end
			values[current] = PublicJSON::Value::Object(members)
		else
			case _atomic_value(node)
			when Result::Ok(value)
				values[current] = value
			when Result::Err(error)
				return Result<PublicJSON::Value, PublicJSON::Error>::Err(_error(error.kind, error.message, _decoding_path(parser, current)))
			end
		end
		pending.pop()
		entered.pop()
	end
	return Result<PublicJSON::Value, PublicJSON::Error>::Ok(values[identity])
end

def parse(source: String): Result<PublicJSON::Value, PublicJSON::Error>
	mut parser := JsonParser.new(source.to_bytes())
	_space(parser)
	if _byte(parser) < 0
		return Result<PublicJSON::Value, PublicJSON::Error>::Err(_error(PublicJSON::ErrorKind::Syntax, "EOF", ""))
	end
	root := _node(parser)
	failure := parser.failure
	if failure != nil
		return Result<PublicJSON::Value, PublicJSON::Error>::Err(failure)
	end
	_space(parser)
	if _byte(parser) >= 0
		trailing := _node(parser)
		trailing_failure := parser.failure
		if trailing_failure != nil
			return Result<PublicJSON::Value, PublicJSON::Error>::Err(trailing_failure)
		end
		mut message := "JSON source contains multiple values"
		mut name := ""
		case parser.nodes[trailing]
		when JsonNode::Boolean(_boolean)
			name = "bool"
		when JsonNode::Number(_text)
			name = "number"
		when JsonNode::PortableInteger(_integer)
			name = "number"
		when JsonNode::String(_text)
			name = "string"
		when JsonNode::Array(_items)
			name = "array"
		else
			name = ""
		end
		if name != ""
			message = "json: cannot unmarshal " + name + " into Go value of type struct {}"
		end
		return Result<PublicJSON::Value, PublicJSON::Error>::Err(_error(PublicJSON::ErrorKind::Syntax, message, ""))
	end
	return _value(parser, root)
end

def parse_jsonc(source: String): Result<PublicJSON::Value, PublicJSON::Error>
	# Comments become spaces per byte, preserving the reference decoder's
	# filtered-source locations, including CR/LF and multibyte comments.
	bytes := source.to_bytes()
	mut fragments: Array<String> := []
	mut mode := 0
	mut escaped := false
	mut index := 0
	while index < bytes.size()
		octet := bytes.at(index)
		mut following := -1
		if index + 1 < bytes.size()
			following = bytes.at(index + 1)
		end
		if mode == 1
			fragments.push(Octets.octet(octet))
			if escaped
				escaped = false
			elsif octet == 92
				escaped = true
			elsif octet == 34
				mode = 0
			end
		elsif mode == 2 || mode == 3
			if mode == 3 && octet == 42 && following == 47
				fragments.push("  ")
				index += 1
				mode = 0
			elsif octet == 10 || octet == 13
				fragments.push(Octets.octet(octet))
				if mode == 2 && octet == 10
					mode = 0
				end
			else
				fragments.push(" ")
			end
		elsif octet == 47 && (following == 47 || following == 42)
			mode = 2
			if following == 42
				mode = 3
			end
			fragments.push("  ")
			index += 1
		else
			fragments.push(Octets.octet(octet))
			if octet == 34
				mode = 1
			end
		end
		index += 1
	end
	return parse(fragments.join(""))
end

# Most strings need only the surrounding quotes. Validate and scan bytes
# once before taking that path; malformed UTF-8 still uses the reference's
# per-code-point replacement and HTML/JavaScript escaping below.
def _needs_escape(bytes: Bytes): Boolean
	mut index := 0
	while index < bytes.size()
		octet := bytes.at(index)
		if octet < 32 || octet == 34 || octet == 92 || octet == 60 || octet == 62 || octet == 38
			return true
		end
		# ASCII needs no further width or validity check after escape screening.
		if octet < 128
			index += 1
			next
		end
		width := _byte_width(bytes, index, bytes.size())
		if width == 1
			return true
		end
		if octet == 226 && width == 3 && bytes.at(index + 1) == 128 && (bytes.at(index + 2) == 168 || bytes.at(index + 2) == 169)
			return true
		end
		index += width
	end
	return false
end

def _escape(text: String): String
	bytes := text.to_bytes()
	if !_needs_escape(bytes)
		return "\"" + text + "\""
	end
	return _escape_fragments(bytes)
end

# The caller has already classified the input; do not repeat that scan.
def _escape_fragments(bytes: Bytes): String
	octets := Octets.table()
	mut fragments := ["\""]
	mut index := 0
	while index < bytes.size()
		octet := bytes.at(index)
		if octet >= 128
			width := _byte_width(bytes, index, bytes.size())
			if width == 1
				# Preserve String#chars normalization before JSON quoting.
				fragments.push("\ufffd")
			elsif octet == 226 && width == 3 && bytes.at(index + 1) == 128 && bytes.at(index + 2) == 168
				fragments.push("\\u2028")
			elsif octet == 226 && width == 3 && bytes.at(index + 1) == 128 && bytes.at(index + 2) == 169
				fragments.push("\\u2029")
			else
				# Valid UTF-8 can be joined from shared octets without allocating
				# a character String and Bytes value for every code point.
				mut offset := 0
				while offset < width
					fragments.push(octets[bytes.at(index + offset)])
					offset += 1
				end
			end
			index += width
			next
		end
		if octet == 34
			fragments.push("\\\"")
		elsif octet == 92
			fragments.push("\\\\")
		elsif octet == 8
			fragments.push("\\b")
		elsif octet == 12
			fragments.push("\\f")
		elsif octet == 10
			fragments.push("\\n")
		elsif octet == 13
			fragments.push("\\r")
		elsif octet == 9
			fragments.push("\\t")
		elsif octet == 60
			fragments.push("\\u003c")
		elsif octet == 62
			fragments.push("\\u003e")
		elsif octet == 38
			fragments.push("\\u0026")
		elsif octet < 32
			fragments.push("\\u00" + "0123456789abcdef"[octet / 16] + "0123456789abcdef"[octet % 16])
		else
			fragments.push(octets[octet])
		end
		index += 1
	end
	fragments.push("\"")
	return fragments.join("")
end

# Ordinary strings can join the shared output without a temporary quoted copy.
# Keep escaped text on the established fragment formatter.
def _append_quoted(mut builder: StringBuilder, text: String)
	bytes := text.to_bytes()
	if _needs_escape(bytes)
		builder.append(_escape_fragments(bytes))
	else
		builder.append("\"")
		builder.append(text)
		builder.append("\"")
	end
end

def _floating(number: Float): String
	if number == 0.0
		if 1.0 / number < 0.0
			return "-0"
		end
		return "0"
	end
	fixed := number.to_s()
	mut sign := ""
	mut start := 0
	if number < 0.0
		sign = "-"
		start = 1
	end
	mut point := start
	while point < fixed.size() && fixed[point] != "."
		point += 1
	end
	if number.abs() >= 0.000001 && number.abs() < "1e21".to_f()
		if point + 2 == fixed.size() && fixed[point + 1] == "0"
			return _slice(fixed, 0, point)
		end
		return fixed
	end
	mut digits := ""
	mut first := -1
	mut index := start
	while index < fixed.size()
		if fixed[index] != "."
			if first >= 0 || fixed[index] != "0"
				if first < 0
					first = index
				end
				digits += fixed[index]
			end
		end
		index += 1
	end
	mut finish := digits.size()
	while finish > 1 && digits[finish - 1] == "0"
		finish -= 1
	end
	mut exponent := point - first
	if first < point
		exponent -= 1
	end
	mut result := sign + digits[0]
	if finish > 1
		result += "." + _slice(digits, 1, finish)
	end
	result += "e"
	if exponent >= 0
		result += "+"
	end
	return result + exponent.to_s()
end

def _encoding_error_path(value: PublicJSON::Value): PublicJSON::Error?
	mut values := [value]
	mut parents := [-1]
	mut parts := [""]
	mut positions := [-1]
	mut pending := [0]
	while !pending.empty?()
		current := pending[pending.size() - 1]
		pending.pop()
		case values[current]
		when PublicJSON::Value::Float(number)
			if !number.finite?()
				return _error(PublicJSON::ErrorKind::Encode, "JSON Float must be finite", _path(parents, parts, positions, current))
			end
		when PublicJSON::Value::Array(items)
			mut index := items.size()
			while index > 0
				index -= 1
				pending.push(values.size())
				values.push(items[index])
				parents.push(current)
				parts.push("")
				positions.push(index)
			end
		when PublicJSON::Value::Object(members)
			keys := members.keys()
			mut index := keys.size()
			while index > 0
				index -= 1
				pending.push(values.size())
				values.push(members.fetch(keys[index]))
				parents.push(current)
				parts.push(keys[index])
				positions.push(-1)
			end
		else
			nil
		end
	end
	return nil
end

# Valid documents need only the pending values. Keep diagnostic paths and
# already visited values alive only when a nonfinite number requires an error.
def _encoding_error(value: PublicJSON::Value): PublicJSON::Error?
	mut pending := [value]
	while !pending.empty?()
		current := pending[pending.size() - 1]
		pending.pop()
		case current
		when PublicJSON::Value::Float(number)
			if !number.finite?()
				return _encoding_error_path(value)
			end
		when PublicJSON::Value::Array(items)
			mut index := items.size()
			while index > 0
				index -= 1
				pending.push(items[index])
			end
		when PublicJSON::Value::Object(members)
			keys := members.keys()
			mut index := keys.size()
			while index > 0
				index -= 1
				pending.push(members.fetch(keys[index]))
			end
		else
			nil
		end
	end
	return nil
end

# Keep only the active path and its next child positions. Each object owns one
# sorted key list until it closes; siblings do not need pending value/token pairs.
def _serialize_compound(value: PublicJSON::Value): String
	mut values := [value]
	mut positions := [0]
	mut object_keys: Array<Array<String>> := []
	mut builder := StringBuilder.new()
	while !values.empty?()
		top := values.size() - 1
		current := values[top]
		index := positions[top]
		case current
		when PublicJSON::Value::Null
			builder.append("null")
		when PublicJSON::Value::Boolean(boolean)
			builder.append(boolean.to_s())
		when PublicJSON::Value::Integer(integer)
			builder.append(integer.to_s())
		when PublicJSON::Value::Float(number)
			builder.append(_floating(number))
		when PublicJSON::Value::String(string)
			_append_quoted(builder, string)
		when PublicJSON::Value::Array(items)
			if index == 0
				builder.append("[")
			end
			if index < items.size()
				if index > 0
					builder.append(",")
				end
				positions[top] = index + 1
				values.push(items[index])
				positions.push(0)
				next
			end
			builder.append("]")
		when PublicJSON::Value::Object(members)
			if index == 0
				builder.append("{")
				object_keys.push(members.keys().sort())
			end
			keys := object_keys[object_keys.size() - 1]
			if index < keys.size()
				if index > 0
					builder.append(",")
				end
				key := keys[index]
				_append_quoted(builder, key)
				builder.append(":")
				positions[top] = index + 1
				values.push(members.fetch(key))
				positions.push(0)
				next
			end
			builder.append("}")
			object_keys.pop()
		end
		values.pop()
		positions.pop()
	end
	return builder.to_s()
end

# Scalar roots need neither traversal stacks nor a mutable document buffer.
def _serialize(value: PublicJSON::Value): String
	case value
	when PublicJSON::Value::Null
		return "null"
	when PublicJSON::Value::Boolean(boolean)
		return boolean.to_s()
	when PublicJSON::Value::Integer(integer)
		return integer.to_s()
	when PublicJSON::Value::Float(number)
		return _floating(number)
	when PublicJSON::Value::String(string)
		return _escape(string)
	else
		return _serialize_compound(value)
	end
end

def stringify(value: PublicJSON::Value): Result<String, PublicJSON::Error>
	error := _encoding_error(value)
	if error != nil
		return Result<String, PublicJSON::Error>::Err(error)
	end
	return Result<String, PublicJSON::Error>::Ok(_serialize(value))
end

