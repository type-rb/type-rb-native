import trb/internal/network_host as NetworkHost
import trb/internal/runtime as Runtime
import { protocol, checked_response } from trb/internal/web_dispatch
import { Body, Header, Headers, HttpMethod } from trb/http
import { Web, Request, Response } from trb/web

# This implementation is a project provider. Its router is generated from the
# same bound route/middleware declarations as Web testing; host callbacks never
# call a managed handler. All managed work runs after next_request returns.
def serve(config: Web::ServerConfig)
	if config.host.strip() == ""
		Runtime.fail<Integer>("trb/web ServerConfig.host must not be empty")
	end
	if config.host.codepoints().include?(0)
		Runtime.fail<Integer>("trb/web ServerConfig.host must not contain NUL")
	end
	if config.port < 1 || config.port > 65535
		Runtime.fail<Integer>("trb/web ServerConfig.port must be between 1 and 65535")
	end
	if config.body_limit_bytes < 1
		Runtime.fail<Integer>("trb/web ServerConfig.body_limit_bytes must be greater than zero")
	end
	if config.shutdown_timeout_milliseconds < 0
		Runtime.fail<Integer>("trb/web ServerConfig.shutdown_timeout_milliseconds must not be negative")
	end
	error := NetworkHost.start(config.host, config.port, config.body_limit_bytes, config.shutdown_timeout_milliseconds)
	if error != ""
		Runtime.fail<Integer>(error)
	end
	while true
		connection := NetworkHost.next_request()
		if connection == 0
			break
		end
		action := fn(): Integer
			respond(connection, config.body_limit_bytes)
			return 1
		end
		if Runtime.recover<Integer>(action, 0) == 0
			NetworkHost.write(connection, encode_response(protocol(500, "internal_server_error"), false, "1.1", true), true)
		end
	end
	NetworkHost.stop()
	return
end

def respond(connection: Integer, limit: Integer)
	status := NetworkHost.status(connection)
	# Negative status denotes a framing/header failure before a valid request.
	# As in the reference server, it must not enter application middleware.
	if status < 0
		mut error := "bad_request"
		if status == -431
			error = "request_header_fields_too_large"
		end
		NetworkHost.write(connection, encode_response(protocol(0 - status, error), false, "1.1", true), true)
		return
	end
	target := NetworkHost.read(connection, 0).to_s()
	method := NetworkHost.read(connection, 1).to_s()
	raw_headers := NetworkHost.read(connection, 2).to_s()
	body := NetworkHost.read(connection, 3)
	version := NetworkHost.read(connection, 4).to_s()
	mut entries: Array<Header> := []
	mut host_count := 0
	mut host_valid := true
	raw_headers.split("\n").each do |line|
		if line != ""
			parts := line.split(":")
			name := parts[0].downcase()
			value := parts.slice(1...parts.size()).join(":").strip()
			if name == "host"
				host_count += 1
				value.codepoints().each do |point|
					if !(point >= 65 && point <= 90) && !(point >= 97 && point <= 122) && !(point >= 48 && point <= 57) && !"!$%&()*+,-.:;=[]'_~".codepoints().include?(point)
						host_valid = false
					end
				end
			else
				entries.push(Header.new(name: name, value: value))
			end
		end
	end
	if status == 100 && (!host_valid || host_count > 1 || (version == "1.1" && host_count == 0))
		NetworkHost.write(connection, encode_response(protocol(400, "bad_request"), false, version, true), true)
		return
	end
	mut filtered: Array<Header> := []
	chunked := Headers.new(entries).key?("transfer-encoding")
	entries.each do |header|
		if header.name != "transfer-encoding" && !(chunked && header.name == "trailer")
			filtered.push(header)
		end
	end
	mut path := target
	if path.start_with?("http://") || path.start_with?("https://")
		scheme_parts := path.split("://")
		authority_path := scheme_parts.slice(1...scheme_parts.size()).join("://")
		mut boundary := 0
		while boundary < authority_path.size() && authority_path[boundary] != "/" && authority_path[boundary] != "?"
			boundary += 1
		end
		path = "/"
		if boundary < authority_path.size()
			if authority_path[boundary] == "/"
				path = authority_path.slice(boundary...authority_path.size())
			else
				path += authority_path.slice(boundary...authority_path.size())
			end
		end
	end
	mut query := ""
	parts := path.split("?")
	if parts.size() > 1
		path = parts[0]
		query = parts.slice(1...parts.size()).join("?")
	end
	request := Request.new(method: HttpMethod.new(method), path: path, query_string: query, headers: Headers.new(filtered), body: Body.new(body))
	if status == 100
		expectations := request.headers.values("expect")
		if expectations.size() > 0 && (expectations.size() != 1 || expectations[0].downcase() != "100-continue")
			NetworkHost.write(connection, encode_response(protocol(417, "expectation_failed"), false, version, true), true)
			return
		end
		mut interim := "".to_bytes()
		if expectations.size() == 1
			interim = "HTTP/1.1 100 Continue\r\n\r\n".to_bytes()
		end
		NetworkHost.write(connection, interim, false)
		return
	end
	response := dispatch_network(request, limit, status)
	mut close := status != 0 || version == "1.0"
	request.headers.values("connection").each do |value|
		value.downcase().split(",").each do |token|
			if token.strip() == "keep-alive" && status == 0
				close = false
			end
		end
	end
	request.headers.values("connection").each do |value|
		value.downcase().split(",").each do |token|
			if token.strip() == "close"
				close = true
			end
		end
	end
	response.headers.values("connection").each do |value|
		value.downcase().split(",").each do |token|
			if token.strip() == "close"
				close = true
			end
		end
	end
	NetworkHost.write(connection, encode_response(response, method.upcase() == "HEAD", version, close), close)
	return
end

# Transport framing is generated from validated values. Never trust a handler's
# Content-Length or Transfer-Encoding when serializing the actual byte buffer.
def encode_response(value: Response, head: Boolean, version: String = "1.1", close: Boolean = false): Bytes
	response := checked_response(value)
	mut final := "".to_bytes()
	if response.status < 200 && response.status != 101
		# Like the reference ResponseWriter, a returned informational status is
		# followed by the implicit final 200 when the handler writes its body.
		final = encode_response(Response.new(status: 200, headers: response.headers, body: response.body), head, version, close)
		if version == "1.0"
			return final
		end
	end
	mut body := response.body.bytes()
	bodyless := head || response.status == 204 || response.status == 304 || response.status < 200
	if bodyless
		body = "".to_bytes()
	end
	mut headers := "HTTP/" + version + " " + response.status.to_s() + " \r\n"
	response.headers.entries().each do |header|
		name := header.name.downcase()
		if name != "content-length" && name != "transfer-encoding" && name != "connection" && name != "trailer"
			headers += header.name + ": " + header.value + "\r\n"
		end
	end
	if !bodyless || head
		headers += "Content-Length: " + body.size().to_s() + "\r\n"
	end
	if response.status >= 200
		if close
			headers += "Connection: close\r\n"
		elsif version == "1.0"
			headers += "Connection: keep-alive\r\n"
		end
	end
	return (headers + "\r\n").to_bytes().concat(body).concat(final)
end
