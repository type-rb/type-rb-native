import trb/std/encoding/hex as PublicHex
import trb/std/result
import trb/internal/encoding_bytes as Octets

module Hex
end

def encode(value: Bytes): String
	mut parts: Array<String> := []
	mut index := 0
	while index < value.size()
		octet := value.at(index)
		parts.push("0123456789abcdef"[octet / 16])
		parts.push("0123456789abcdef"[octet % 16])
		index += 1
	end
	return parts.join("")
end

def _digit(point: Integer): Integer
	if point >= 48 && point <= 57
		return point - 48
	elsif point >= 65 && point <= 70
		return point - 55
	elsif point >= 97 && point <= 102
		return point - 87
	end
	return -1
end

def decode(value: String): Result<Bytes, PublicHex::DecodeError>
	bytes := value.to_bytes()
	mut index := 0
	# Every accepted character is ASCII. At the first invalid character,
	# the byte offset is therefore also the reference code-point offset.
	while index < bytes.size()
		digit := _digit(bytes.at(index))
		if digit < 0
			return Result<Bytes, PublicHex::DecodeError>::Err(PublicHex::DecodeError.new(kind: PublicHex::DecodeErrorKind::InvalidCharacter, input: value, index: index, message: "invalid hexadecimal character"))
		end
		index += 1
	end
	if bytes.size() % 2 != 0
		return Result<Bytes, PublicHex::DecodeError>::Err(PublicHex::DecodeError.new(kind: PublicHex::DecodeErrorKind::OddLength, input: value, index: bytes.size(), message: "hex input has odd length"))
	end
	octets := Octets.table()
	mut parts: Array<String> := []
	index = 0
	while index < bytes.size()
		parts.push(octets[_digit(bytes.at(index)) * 16 + _digit(bytes.at(index + 1))])
		index += 2
	end
	return Result<Bytes, PublicHex::DecodeError>::Ok(parts.join("").to_bytes())
end
