		"function l $g4_source_slice(l %source, l %start, l %finish) {\n@start\n\t%length =l sub %finish, %start\n\t%size =l add %length, 9\n\t%result =l call $g4_string_alloc(l %size)\n\t%length_address =l add %result, 8\n\tstorel %length, %length_address\n\t%source_data =l add %source, 16\n\t%from =l add %source_data, %start\n\t%data =l add %result, 16\n\tcall $memcpy(l %data, l %from, l %length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %result\n}\n\nfunction w $g4_c_ends_with(l %value, l %suffix) {\n@start\n\t%value_length =l call $strlen(l %value)\n\t%suffix_length =l call $strlen(l %suffix)\n\t%short =w csltl %value_length, %suffix_length\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %value_length, %suffix_length\n\t%start =l add %value, %offset\n\t%comparison =w call $memcmp(l %start, l %suffix, l %suffix_length)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $g4_c_is_test_source(l %path) {\n@start\n\t%length =l call $strlen(l %path)\n\t%short =w csltl %length, 9\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %length, 9\n\t%start =l add %path, %offset\n\t%comparison =w call $strncasecmp(l %start, l $g4_project_test_suffix, l 9)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $g4_c_has_directory_component(l %path, l %component) {\n@start\n\t%component_length =l call $strlen(l %component)\n\tjmp @search\n@search\n\t%cursor =l phi @start %path, @advance %advanced\n\t%match =l call $strstr(l %cursor, l %component)\n\t%missing =w ceql %match, 0\n\tjnz %missing, @no, @boundary\n@boundary\n\t%after =l add %match, %component_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tjnz %matched, @yes, @advance\n@advance\n\t%advanced =l add %match, 1\n\tjmp @search\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $g4_c_path_has_prefix(l %path, l %prefix) {\n@start\n\t%path_length =l call $strlen(l %path)\n\t%prefix_length =l call $strlen(l %prefix)\n\t%short =w csltl %path_length, %prefix_length\n\tjnz %short, @no, @compare\n@compare\n\t%comparison =w call $memcmp(l %path, l %prefix, l %prefix_length)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @no, @boundary\n@boundary\n\t%after =l add %path, %prefix_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tret %matched\n@no\n\tret 0\n}\n\nfunction w $g4_project_path_excluded(l %path) {\n@start\n\t%source_root =l loadl $g4_project_source_root\n\t%source_comparison =w call $strcmp(l %path, l %source_root)\n\t%source =w ceqw %source_comparison, 0\n\tjnz %source, @no, @out_root\n@out_root\n\t%out_root =l loadl $g4_project_out_root\n\t%roots_comparison =w call $strcmp(l %source_root, l %out_root)\n\t%same_roots =w ceqw %roots_comparison, 0\n\tjnz %same_roots, @components, @out_prefix\n@out_prefix\n\t%inside_out =w call $g4_c_path_has_prefix(l %path, l %out_root)\n\tjnz %inside_out, @yes, @components\n@components\n\t%git =w call $g4_c_has_directory_component(l %path, l $g4_project_git_component)\n\tjnz %git, @yes, @trb\n@trb\n\t%hidden =w call $g4_c_has_directory_component(l %path, l $g4_project_trb_component)\n\tjnz %hidden, @yes, @node_modules\n@node_modules\n\t%node =w call $g4_c_has_directory_component(l %path, l $g4_project_node_modules_component)\n\tjnz %node, @yes, @no\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $g4_project_path_compare(l %left_cell, l %right_cell) {\n@start\n\t%left =l loadl %left_cell\n\t%right =l loadl %right_cell\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%left_shorter =w csltl %left_length, %right_length\n\tjnz %left_shorter, @left_minimum, @right_minimum\n@left_minimum\n\t%left_min =l copy %left_length\n\tjmp @compare\n@right_minimum\n\t%right_min =l copy %right_length\n\tjmp @compare\n@compare\n\t%minimum =l phi @left_minimum %left_min, @right_minimum %right_min\n\t%left_data =l add %left, 16\n\t%right_data =l add %right, 16\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %minimum)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @compared, @lengths\n@compared\n\tret %comparison\n@lengths\n\t%shorter =w csltl %left_length, %right_length\n\tjnz %shorter, @less, @longer\n@longer\n\t%greater =w csgtl %left_length, %right_length\n\tjnz %greater, @more, @equal\n@less\n\tret -1\n@more\n\tret 1\n@equal\n\tret 0\n}\n\nfunction w $g4_project_walk_callback(l %path, l %stat, w %type, l %walk) {\n@start\n\t%excluded =w call $g4_project_path_excluded(l %path)\n\tjnz %excluded, @ignore, @classify\n@classify\n\t%regular =w ceqw %type, 0\n\tjnz %regular, @regular, @directory\n@directory\n\t%directory =w ceqw %type, 1\n\tjnz %directory, @ignore, @walk_error\n@walk_error\n\t%denied =w ceqw %type, 2\n\t%unknown =w ceqw %type, 4\n\t%unreadable =w or %denied, %unknown\n\tjnz %unreadable, @error, @special\n@special\n\t%source_kind =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source_kind, @error, @ignore\n@regular\n\t%source =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source, @test, @ignore\n@test\n\t%test_source =w call $g4_c_is_test_source(l %path)\n\tjnz %test_source, @ignore, @collect\n@collect\n\t%owned =l call $g4_string_from_c(l %path)\n\t%paths =l loadl $g4_project_paths\n\tcall $g4_array_push(l %paths, l %owned)\n\tret 0\n@error\n\t%error =l call $g4_string_from_c(l %path)\n\tstorel %error, $g4_project_error\n\t%error_root =l add $g4_gc_global_roots, 88\n\tstorel %error, %error_root\n\tret 1\n@ignore\n\tret 0\n}\n\nfunction l $g4_collect_project_sources(l %source_root, l %out_root) {\n@start\n\t%paths =l call $g4_array_new(l $g4_desc_array_managed)\n\t%paths_root =l add $g4_gc_global_roots, 64\n\tstorel %paths, %paths_root\n\t%sources =l call $g4_array_new(l $g4_desc_array_manage