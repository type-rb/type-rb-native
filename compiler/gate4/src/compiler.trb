		inline_budget: inline_budget,
		scalar_inline_depth: [0],
		scalar_inline_range_failure_used: [0],
		array_bounds_failure_used: [0],
		array_header_cache: [["", "", ""], ["", "", ""]],
	)
end

def gate4_output_line(mut output: Gate4Output, line: String)
	index := output.count[0]
	gate4_store_string(output.lines, index, line)
	output.count[0] = index + 1
	return
end

def gate4_integer_string(value: Integer): String
	if value == 0
		return "0"
	end
	mut remaining := value
	mut negative := false
	if remaining < 0
		negative = true
		remaining = 0 - remaining
	end
	digits := "0123456789"
	mut result := ""
	while remaining > 0
		digit := remaining % 10
		result = digits[digit] + result
		remaining /= 10
	end
	if negative
		result = "-" + result
	end
	return result
end

def gate4_ascii_code(character: String): Integer
	if character == "\n"
		return 10
	end
	if character == "\r"
		return 13
	end
	if character == "\t"
		return 9
	end
	if character == " "
		return 32
	end
	if character == "$"
		return 36
	end
	if character == "%"
		return 37
	end
	if character == "("
		return 40
	end
	if character == ")"
		return 41
	end
	if character == ","
		return 44
	end
	if character == "="
		return 61
	end
	if character == "@"
		return 64
	end
	if character == "_"
		return 95
	end
	if character == "{"
		return 123
	end
	if character == "}"
		return 125
	end
	mut lowercase_index := 0
	lowercase := "abcdefghijklmnopqrstuvwxyz"
	while lowercase_index < lowercase.size()
		if lowercase[lowercase_index] == character
			return lowercase_index + 97
		end
		lowercase_index += 1
	end
	mut uppercase_index := 0
	uppercase := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	while uppercase_index < uppercase.size()
		if uppercase[uppercase_index] == character
			return uppercase_index + 65
		end
		uppercase_index += 1
	end
	mut digit_index := 0
	digits := "0123456789"
	while digit_index < digits.size()
		if digits[digit_index] == character
			return digit_index + 48
		end
		digit_index += 1
	end
	alphabet := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
	mut index := 0
	while index < alphabet.size()
		if alphabet[index] == character
			return index + 32
		end
		index += 1
	end
	return - 1
end

def gate4_small_nonnegative_integer_operand(value: String): Boolean
	if value.size() == 0
		return false
	end
	if value.size() > 4
		return false
	end
	mut parsed := 0
	mut index := 0
	while index < value.size()
		code := gate4_ascii_code(value[index])
		if code < 48
			return false
		end
		if code > 57
			return false
		end
		parsed = parsed * 10 + code - 48
		index += 1
	end
	return parsed <= 1024
end

def gate4_number_without_underscores(value: String): String
	mut result := ""
	mut index := 0
	while index < value.size()
		if value[index] != "_"
			result += value[index]
		end
		index += 1
	end
	return result
end

def gate4_number_is_float(value: String): Boolean
	mut index := 0
	while index < value.size()
		if value[index] == "."
			return true
		end
		index += 1
	end
	return false
end

def gate4_integer_literal_in_range(value: String): Boolean
	normalized := gate4_number_without_underscores(value)
	limit := "9007199254740991"
	mut first := 0
	mut scanning := true
	while scanning
		if first >= normalized.size()
			scanning = false
		else
			if normalized[first] == "0"
				first += 1
			else
				scanning = false
			end
		end
	end
	if first == normalized.size()
		return true
	end
	digits := normalized.size() - first
	if digits < limit.size()
		return true
	end
	if digits > limit.size()
		return false
	end
	mut index := 0
	while index < limit.size()
		actual := gate4_ascii_code(normalized[first + index])
		maximum := gate4_ascii_code(limit[index])
		if actual < maximum
			return true
		end
		if actual > maximum
			return false
		end
		index += 1
	end
	return true
end

def gate4_float_literal_in_range(value: String): Boolean
	normalized := gate4_number_without_underscores(value)
	# Round-to-nearest overflows at 2^1024 - 2^970. The tie rounds to
	# infinity, so a decimal magnitude must be strictly below this integer.
	limit := ""
	mut decimal := normalized.size()
	mut index := 0
	while index < normalized.size()
		if normalized[index] == "."
			decimal = index
			index = normalized.size()
		else
			index += 1
		end
	end
	mut first := 0
	mut scanning := true
	while scanning
		if first >= decimal
			scanning = false
		else
			if normalized[first] == "0"
				first += 1
			else
				scanning = false
			end
		end
	end
	integer_digits := decimal - first
	if integer_digits < limit.size()
		return true
	end
	if integer_digits > limit.size()
		return false
	end
	index = 0
	while index < limit.size()
		actual := gate4_ascii_code(normalized[first + index])
		maximum := gate4_ascii_code(limit[index])
		if actual < maximum
			return true
		end
		if actual > maximum
			return false
		end
		index += 1
	end
	return false
end

def gate4_static_string_bytes(value: String): Array<Integer>
	mut bytes: Array<Integer> := []
	mut index := 0
	while index < value.size()
		code := gate4_ascii_code(value[index])
		if code < 0
			return []
		end
		bytes.push(code)
		index += 1
	end
	return bytes
end

def gate4_static_bytes_hash(bytes: Array<Integer>, index: Integer): Integer
	return ((bytes[index] * 257 + bytes[index + 1]) * 257 + bytes[index + 2]) % 512
end

def gate4_encode_static_bytes(bytes: Array<Integer>): Array<Integer>
	mut positions: Array<Integer> := []
	while positions.size() < 512
		positions.push(- 1)
	end
	mut encoded: Array<Integer> := []
	mut index := 0
	while index < bytes.size()
		mut match_length := 0
		mut match_distance := 0
		if index + 2 < bytes.size()
			hash := gate4_static_bytes_hash(bytes, index)
			previous := positions[hash]
			if previous >= 0
				distance := index - previous
				if distance <= 65535
					mut limit := bytes.size() - index
					if limit > 130
						limit = 130
					end
					mut length := 0
					mut matching := true
					while matching
						if length >= limit
							matching = false
						else
							if bytes[previous + length] == bytes[index + length]
								length += 1
							else
								matching = false
							end
						end
					end
					if length >= 4
						match_length = length
						match_distance = distance
					end
				end
			end
		end

		mut consumed := 1
		if match_length >= 4
			encoded.push(128 + match_length - 3)
			encoded.push(match_distance / 256)
			encoded.push(match_distance % 256)
			consumed = match_length
		else
			encoded.push(bytes[index])
		end

		mut update := index
		while update < index + consumed
			if update + 2 < bytes.size()
				positions[gate4_static_bytes_hash(bytes, update)] = update
			end
			update += 1
		end
		index += consumed
	end
	return encoded
end

def gate4_encode_static_string(value: String): Array<Integer>
	return gate4_encode_static_bytes(gate4_static_string_bytes(value))
end

def gate4_emit_static_byte_data(
		mut output: Gate4Output,
		symbol: String,
		bytes: Array<Integer>,
	)
	gate4_output_line(output, "data $" + symbol + " = {")
	mut line := "\tb"
	mut line_bytes := 0
	mut index := 0
	while index < bytes.size()
		line += " " + gate4_integer_string(bytes[index])
		line_bytes += 1
		if line_bytes == 16
			gate4_output_line(output, line + ",")
			line = "\tb"
			line_bytes = 0
		end
		index += 1
	end
	if line_bytes > 0
		gate4_output_line(output, line + ",")
	end
	gate4_output_line(output, "\tb 0 }")
	return
end

def gate4_emit_static_string_decoder(
		mut output: Gate4Output,
		compressed_tokens: Array<Integer>,
		compressed_sizes: Array<Integer>,
		decoded_sizes: Array<Integer>,
	)
	gate4_output_line(
		output,
		"function $g4_static_string_decode(l %target, l %encoded, l %encoded_length, l %decoded_length) {\n@start\n\tstorel 0, %target\n\t%length_address =l add %target, 8\n\tstorel %decoded_length, %length_address\n\t%output =l add %target, 16\n\tjmp @loop\n@loop\n\t%input_index =l phi @start 0, @literal %literal_next_input, @match_done %match_next_input\n\t%output_index =l phi @start 0, @literal %literal_next_output, @match_done %match_next_output\n\t%done =w cslel %encoded_length, %input_index\n\tjnz %done, @terminate, @read\n@read\n\t%encoded_address =l add %encoded, %input_index\n\t%header =w loadub %encoded_address\n\t%is_match =w csgtw %header, 127\n\tjnz %is_match, @match, @literal\n@literal\n\t%literal_address =l add %output, %output_index\n\tstoreb %header, %literal_address\n\t%literal_next_input =l add %input_index, 1\n\t%literal_next_output =l add %output_index, 1\n\tjmp @loop\n@match\n\t%high_address =l add %encoded_address, 1\n\t%low_address =l add %encoded_address, 2\n\t%high =w loadub %high_address\n\t%low =w loadub %low_address\n\t%high_long =l extuw %high\n\t%low_long =l extuw %low\n\t%high_shifted =l shl %high_long, 8\n\t%distance =l or %high_shifted, %low_long\n\t%match_length_word =w sub %header, 125\n\t%match_length =l extuw %match_length_word\n\tjmp @copy\n@copy\n\t%copy_index =l phi @match 0, @copy_byte %copy_next\n\t%copy_done =w cslel %match_length, %copy_index\n\tjnz %copy_done, @match_done, @copy_byte\n@copy_byte\n\t%source_base =l sub %output_index, %distance\n\t%source_index =l add %source_base, %copy_index\n\t%source_address =l add %output, %source_index\n\t%value =w loadub %source_address\n\t%destination_index =l add %output_index, %copy_index\n\t%destination_address =l add %output, %destination_index\n\tstoreb %value, %destination_address\n\t%copy_next =l add %copy_index, 1\n\tjmp @copy\n@match_done\n\t%match_next_input =l add %input_index, 3\n\t%match_next_output =l add %output_index, %match_length\n\tjmp @loop\n@terminate\n\t%terminator =l add %output, %decoded_length\n\tstoreb 0, %terminator\n\tret\n}",
	)
	gate4_output_line(output, "\nfunction $g4_static_strings_initialize() {\n@start")
	mut index := 0
	while index < compressed_tokens.size()
		token := gate4_integer_string(compressed_tokens[index])
		gate4_output_line(
			output,
			"\tcall $g4_static_string_decode(l $g4s" + token + ", l $g4c" + token +
			", l " + gate4_integer_string(compressed_sizes[index]) +
			", l " + gate4_integer_string(decoded_sizes[index]) + ")",
		)
		index += 1
	end
	gate4_output_line(output, "\tret\n}")
	return
end

def gate4_emit_static_strings(
		mut state: Gate4Compiler,
		mut output: Gate4Output,
	): Boolean
	deduplicate := gate4_compiler_entry_function(state) >= 0
	mut canonical_values: Array<String> := []
	mut canonical_tokens: Array<Integer> := []
	mut compressed_tokens: Array<Integer> := []
	mut compressed_sizes: Array<Integer> := []
	mut decoded_sizes: Array<Integer> := []
	mut token_index := 0
	while token_index < state.token_count[0]
		if gate4_load_integer(state.token_kinds, token_index) == 3
			value := gate4_load_string(state.token_texts, token_index)
			mut canonical := token_index
			mut value_index := 0
			mut found := false
			if deduplicate
				while value_index < canonical_values.size()
					if canonical_values[value_index] == value
						canonical = canonical_tokens[value_index]
						found = true
						value_index = canonical_values.size()
					else
						value_index += 1
					end
				end
			end
			if !found
				canonical_values.push(value)
				canonical_tokens.push(token_index)
				mut bytes: Array<Integer> := []
				mut has_static_bytes := false
				mut compressed: Array<Integer> := []
				if value.size() >= 256
					bytes = gate4_static_string_bytes(value)
					if bytes.size() == value.size()
						has_static_bytes = true
						compressed = gate4_encode_static_bytes(bytes)
					end
				end
				mut use_compressed := false
				if compressed.size() > 0
					if compressed.size() < value.size()
						use_compressed = true
					end
				end
				if use_compressed
					gate4_output_line(
						output,
						"data $g4s" + gate4_integer_string(token_index) + " = align 8 { z " +
						gate4_integer_string(value.size() + 17) + " }",
					)
					gate4_emit_static_byte_data(output, "g4c" + gate4_integer_string(token_index), compressed)
					compressed_tokens.push(token_index)
					compressed_sizes.push(compressed.size())
					decoded_sizes.push(value.size())
					output.runtime_flags[2] = 1
				else
					gate4_output_line(
						output,
						"data $g4s" + gate4_integer_string(token_index) +
						" = align 8 { l 0, l " + gate4_integer_string(value.size()) + ",",
					)
					mut line := "\tb"
					mut line_bytes := 0
					mut character_index := 0
					while character_index < value.size()
						mut code := 0
						if has_static_bytes
							code = bytes[character_index]
						else
							code = gate4_ascii_code(value[character_index])
						end
						if code < 0
							gate4_diagnostic(
								state,
								"TRBN4005",
								gate4_load_integer(state.token_lines, token_index),
								"Gate 4 QBE emission supports ASCII String literals only",
							)
						else
							line += " " + gate4_integer_string(code)
							line_bytes += 1
							if line_bytes == 16
								gate4_output_line(output, line + ",")
								line = "\tb"
								line_bytes = 0
							end
						end
						character_index += 1
					end
					if line_bytes > 0
						gate4_output_line(output, line + ",")
					end
					gate4_output_line(output, "\tb 0 }")
				end
			end
			gate4_store_integer(state.token_lines, token_index, canonical)
		end
		token_index += 1
	end
	if compressed_tokens.size() > 0
		gate4_emit_static_string_decoder(output, compressed_tokens, compressed_sizes, decoded_sizes)
	end
	gate4_output_line(output, "")
	return !gate4_has_diagnostic(state)
end

def gate4_emit_record_descriptors(state: Gate4Compiler, mut output: Gate4Output)
	mut record_index := 0
	while record_index < state.record_count[0]
		field_start := gate4_load_integer(state.record_field_starts, record_index)
		field_count := gate4_load_integer(state.record_field_counts, record_index)
		mut managed_count := 0
		mut entries := ""
		mut field_offset := 0
		while field_offset < field_count
			field_type := gate4_load_string(state.field_types, field_start + field_offset)
			if gate4_type_is_managed(field_type)
				entries += ", l " + gate4_integer_string(8 + field_offset * 8)
				managed_count += 1
			end
			field_offset += 1
		end
		gate4_output_line(
			output,
			"data $g4_desc_record" + gate4_integer_string(record_index) +
			" = align 8 { l 1, l " + gate4_integer_string(managed_count) + ", l " +
			gate4_integer_string(field_count * 8) + entries + " }",
		)
		record_index += 1
	end
	gate4_output_line(output, "")
	return
end

def gate4_project_runtime_qbe_line(value: String): Boolean
	if gate4_string_starts_with(value, "data $g4_project_")
		return true
	end
	if gate4_string_starts_with(value, "function l $g4_source_slice")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_c_")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_project_")
		return true
	end
	return gate4_string_starts_with(value, "function l $g4_collect_project_sources")
end

def gate4_emit_runtime(mut output: Gate4Output, project_runtime: Boolean)
	lines := [
		"data $g4_newline = { b 10 }\ndata $g4_character_cache = align 8 { z 2048 }\ndata $g4_string_storage = align 8 { l 0, l 0, l 0 }\ndata $g4_temporary_storage = align 8 { l 0, l 0 }\ndata $g4_allocation_error = { b 112 97 110 105 99 58 32 97 108 108 111 99 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $g4_bounds_error = { b 112 97 110 105 99 58 32 105 110 100 101 120 32 105 115 32 111 117 116 32 111 102 32 98 111 117 110 100 115 10 }\ndata $g4_integer_error = { b 112 97 110 105 99 58 32 73 110 116 101 103 101 114 32 111 112 101 114 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $g4_integer_range_error = { b \"panic: Integer is outside the portable range\", b 10 }\ndata $g4_division_error = { b \"panic: division by zero\", b 10 }\ndata $g4_usage_error = { b \"usage: compiler {check|emit-qbe} SOURCE\", b 10, b \"       compiler build SOURCE --output OUTPUT --qbe QBE --cc CC\", b 10 }\ndata $g4_file_error = { b \"compiler: cannot read source file: \" }\ndata $g4_check = { b \"check\", b 0 }\ndata $g4_emit = { b \"emit-qbe\", b 0 }\ndata $g4_build = { b \"build\", b 0 }\ndata $g4_output_flag = { b \"--output\", b 0 }\ndata $g4_qbe_flag = { b \"--qbe\", b 0 }\ndata $g4_cc_flag = { b \"--cc\", b 0 }\ndata $g4_target_option = { b \"--target\", b 0 }\ndata $g4_source_arg = { b \"--source-content\", b 0 }\ndata $g4_rb = { b \"rb\", b 0 }\ndata $g4_wb = { b \"wb\", b 0 }\ndata $g4_ssa_suffix = { b \".trbn.ssa\", b 0 }\ndata $g4_asm_suffix = { b \".trbn.s\", b 0 }\ndata $g4_temp_suffix = { b \".trbn.XXXXXX\", b 0 }\ndata $g4_slash = { b \"/\", b 0 }\ndata $g4_target_flag = { b \"-t\", b 0 }\ndata $g4_profile_darwin_arm64 = { b \"darwin-arm64-v0\", b 0 }\ndata $g4_profile_linux_arm64 = { b \"linux-arm64-v0\", b 0 }\ndata $g4_profile_linux_amd64 = { b \"linux-amd64-v0\", b 0 }\ndata $g4_qbe_darwin_arm64 = { b \"arm64_apple\", b 0 }\ndata $g4_qbe_linux_arm64 = { b \"arm64\", b 0 }\ndata $g4_qbe_linux_amd64 = { b \"amd64_sysv\", b 0 }\ndata $g4_o_flag = { b \"-o\", b 0 }\ndata $g4_math_library = { b \"-lm\", b 0 }",
		"data $g4_project_assembler_input = { b \"-xassembler\", b 0 }",
		"data $g4_project_linker_lld = { b \"-fuse-ld=lld\", b 0 }",
		"data $g4_dead_strip_darwin = { b \"-Wl,-dead_strip,-x\", b 0 }",
		"data $g4_dead_strip_linux = { b \"-Wl,--gc-sections,--strip-all\", b 0 }",
		"data $g4_selected_qbe_target = align 8 { l $g4_qbe_darwin_arm64 }",
		"data $g4_selected_dead_strip = align 8 { l $g4_dead_strip_darwin }",
		"data $g4_project_selected_linker = align 8 { l 0 }",
		"data $g4_project_paths = align 8 { l 0 }\ndata $g4_project_error = align 8 { l 0 }\ndata $g4_project_source_root = align 8 { l 0 }\ndata $g4_project_out_root = align 8 { l 0 }\ndata $g4_project_empty_string = align 8 { l 0, l 0, b 0 }\ndata $g4_project_trb_suffix = { b \".trb\", b 0 }\ndata $g4_project_test_suffix = { b \"_test.trb\", b 0 }\ndata $g4_project_git_component = { b \"/.git\", b 0 }\ndata $g4_project_trb_component = { b \"/.trb\", b 0 }\ndata $g4_project_node_modules_component = { b \"/node_modules\", b 0 }",
		"data $g4_target_error = { b \"compiler: unsupported target profile\", b 10 }\ndata $g4_intermediate_error = { b \"compiler: cannot create intermediate file\", b 10 }\ndata $g4_qbe_error = { b \"compiler: qbe failed\", b 10 }\ndata $g4_cc_error = { b \"compiler: cc failed\", b 10 }\ndata $g4_publish_error = { b \"compiler: cannot publish output\", b 10 }\n\nfunction $g4_fail(l %message, l %size) {\n@start\n\tcall $write(w 2, l %message, l %size)\n\tcall $exit(w 2)\n\thlt\n}\n\nfunction l $g4_alloc(l %size) {\n@start\n\t%pointer =l call $calloc(l 1, l %size)\n\t%failed =w ceql %pointer, 0\n\tjnz %failed, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ok\n\tret %pointer\n}\n\nfunction l $g4_string_alloc(l %size) {\n@start\n\t%result =l call $g4_gc_alloc(l $g4_desc_string, l %size, l 0)\n\tret %result\n}\n\nfunction l $g4_temp_alloc(l %size) {\n@start\n\t%storage =l loadl $g4_temporary_storage\n\t%missing =w ceql %storage, 0\n\tjnz %missing, @initialize, @allocate\n@initialize\n\t%allocated =l call $calloc(l 1, l 1048576)\n\t%failed =w ceql %allocated, 0\n\tjnz %failed, @allocation_failed, @initialized\n@allocation_failed\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@initialized\n\tstorel %allocated, $g4_temporary_storage\n\tjmp @allocate\n@allocate\n\t%base =l loadl $g4_temporary_storage\n\t%used_address =l add $g4_temporary_storage, 8\n\t%used =l loadl %used_address\n\t%with_padding =l add %size, 7\n\t%aligned =l and %with_padding, -8\n\t%next =l add %used, %aligned\n\t%overflow =w csltl 1048576, %next\n\tjnz %overflow, @capacity_failed, @ready\n@capacity_failed\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ready\n\t%result =l add %base, %used\n\tstorel %next, %used_address\n\tret %result\n}\n\nfunction $g4_temp_reset() {\n@start\n\t%used_address =l add $g4_temporary_storage, 8\n\tstorel 0, %used_address\n\tret\n}\n\nfunction l $g4_string_from_c(l %source) {\n@start\n\t%length =l call $strlen(l %source)\n\t%size =l add %length, 9\n\t%string =l call $g4_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 16\n\tcall $memcpy(l %data, l %source, l %length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %string\n}\n\nfunction l $g4_read_file(l %p) {\n@start\n\t%f =l call $fopen(l %p, l $g4_rb)\n\t%fm =w ceql %f, 0\n\tjnz %fm, @fail, @seek\n@seek\n\t%es =w call $fseek(l %f, l 0, w 2)\n\t%ef =w cnew %es, 0\n\tjnz %ef, @close, @len\n@len\n\t%n =l call $ftell(l %f)\n\t%neg =w csltl %n, 0\n\tjnz %neg, @close, @rewind\n@rewind\n\t%rs =w call $fseek(l %f, l 0, w 0)\n\t%rf =w cnew %rs, 0\n\tjnz %rf, @close, @alloc\n@alloc\n\t%sz =l add %n, 9\n\t%s =l call $g4_string_alloc(l %sz)\n\t%length_address =l add %s, 8\n\tstorel %n, %length_address\n\t%d =l add %s, 16\n\t%got =l call $fread(l %d, l 1, l %n, l %f)\n\t%cs =w call $fclose(l %f)\n\t%rfe =w cnel %got, %n\n\t%cfe =w cnew %cs, 0\n\t%bad =w or %rfe, %cfe\n\tjnz %bad, @fail, @done\n@done\n\t%e =l add %d, %n\n\tstoreb 0, %e\n\t%file_root =l add $g4_gc_global_roots, 8\n\tstorel %s, %file_root\n\tret %s\n@close\n\t%ignored =w call $fclose(l %f)\n\tjmp @fail\n@fail\n\tret 0\n}\n",
		"function l $g4_file_exists(l %path) {\n@start\n\t%data =l add %path, 16\n\t%status =w call $access(l %data, w 0)\n\t%ok =w ceqw %status, 0\n\t%result =l extuw %ok\n\tret %result\n}\n",
		"function l $g4_read_source(l %path) {\n@start\n\t%data =l add %path, 16\n\t%source =l call $g4_read_file(l %data)\n\tret %source\n}\n",
		"function l $g4_source_slice(l %source, l %start, l %finish) {\n@start\n\t%length =l sub %finish, %start\n\t%size =l add %length, 9\n\t%result =l call $g4_string_alloc(l %size)\n\t%length_address =l add %result, 8\n\tstorel %length, %length_address\n\t%source_data =l add %source, 16\n\t%from =l add %source_data, %start\n\t%data =l add %result, 16\n\tcall $memcpy(l %data, l %from, l %length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %result\n}\n\nfunction w $g4_c_ends_with(l %value, l %suffix) {\n@start\n\t%value_length =l call $strlen(l %value)\n\t%suffix_length =l call $strlen(l %suffix)\n\t%short =w csltl %value_length, %suffix_length\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %value_length, %suffix_length\n\t%start =l add %value, %offset\n\t%comparison =w call $memcmp(l %start, l %suffix, l %suffix_length)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $g4_c_is_test_source(l %path) {\n@start\n\t%length =l call $strlen(l %path)\n\t%short =w csltl %length, 9\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %length, 9\n\t%start =l add %path, %offset\n\t%comparison =w call $strncasecmp(l %start, l $g4_project_test_suffix, l 9)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $g4_c_has_directory_component(l %path, l %component) {\n@start\n\t%component_length =l call $strlen(l %component)\n\tjmp @search\n@search\n\t%cursor =l phi @start %path, @advance %advanced\n\t%match =l call $strstr(l %cursor, l %component)\n\t%missing =w ceql %match, 0\n\tjnz %missing, @no, @boundary\n@boundary\n\t%after =l add %match, %component_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tjnz %matched, @yes, @advance\n@advance\n\t%advanced =l add %match, 1\n\tjmp @search\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $g4_c_path_has_prefix(l %path, l %prefix) {\n@start\n\t%path_length =l call $strlen(l %path)\n\t%prefix_length =l call $strlen(l %prefix)\n\t%short =w csltl %path_length, %prefix_length\n\tjnz %short, @no, @compare\n@compare\n\t%comparison =w call $memcmp(l %path, l %prefix, l %prefix_length)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @no, @boundary\n@boundary\n\t%after =l add %path, %prefix_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tret %matched\n@no\n\tret 0\n}\n\nfunction w $g4_project_path_excluded(l %path) {\n@start\n\t%source_root =l loadl $g4_project_source_root\n\t%source_comparison =w call $strcmp(l %path, l %source_root)\n\t%source =w ceqw %source_comparison, 0\n\tjnz %source, @no, @out_root\n@out_root\n\t%out_root =l loadl $g4_project_out_root\n\t%roots_comparison =w call $strcmp(l %source_root, l %out_root)\n\t%same_roots =w ceqw %roots_comparison, 0\n\tjnz %same_roots, @components, @out_prefix\n@out_prefix\n\t%inside_out =w call $g4_c_path_has_prefix(l %path, l %out_root)\n\tjnz %inside_out, @yes, @components\n@components\n\t%git =w call $g4_c_has_directory_component(l %path, l $g4_project_git_component)\n\tjnz %git, @yes, @trb\n@trb\n\t%hidden =w call $g4_c_has_directory_component(l %path, l $g4_project_trb_component)\n\tjnz %hidden, @yes, @node_modules\n@node_modules\n\t%node =w call $g4_c_has_directory_component(l %path, l $g4_project_node_modules_component)\n\tjnz %node, @yes, @no\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $g4_project_path_compare(l %left_cell, l %right_cell) {\n@start\n\t%left =l loadl %left_cell\n\t%right =l loadl %right_cell\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%left_shorter =w csltl %left_length, %right_length\n\tjnz %left_shorter, @left_minimum, @right_minimum\n@left_minimum\n\t%left_min =l copy %left_length\n\tjmp @compare\n@right_minimum\n\t%right_min =l copy %right_length\n\tjmp @compare\n@compare\n\t%minimum =l phi @left_minimum %left_min, @right_minimum %right_min\n\t%left_data =l add %left, 16\n\t%right_data =l add %right, 16\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %minimum)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @compared, @lengths\n@compared\n\tret %comparison\n@lengths\n\t%shorter =w csltl %left_length, %right_length\n\tjnz %shorter, @less, @longer\n@longer\n\t%greater =w csgtl %left_length, %right_length\n\tjnz %greater, @more, @equal\n@less\n\tret -1\n@more\n\tret 1\n@equal\n\tret 0\n}\n\nfunction w $g4_project_walk_callback(l %path, l %stat, w %type, l %walk) {\n@start\n\t%excluded =w call $g4_project_path_excluded(l %path)\n\tjnz %excluded, @ignore, @classify\n@classify\n\t%regular =w ceqw %type, 0\n\tjnz %regular, @regular, @directory\n@directory\n\t%directory =w ceqw %type, 1\n\tjnz %directory, @ignore, @walk_error\n@walk_error\n\t%denied =w ceqw %type, 2\n\t%unknown =w ceqw %type, 4\n\t%unreadable =w or %denied, %unknown\n\tjnz %unreadable, @error, @special\n@special\n\t%source_kind =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source_kind, @error, @ignore\n@regular\n\t%source =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source, @test, @ignore\n@test\n\t%test_source =w call $g4_c_is_test_source(l %path)\n\tjnz %test_source, @ignore, @collect\n@collect\n\t%owned =l call $g4_string_from_c(l %path)\n\t%paths =l loadl $g4_project_paths\n\tcall $g4_array_push(l %paths, l %owned)\n\tret 0\n@error\n\t%error =l call $g4_string_from_c(l %path)\n\tstorel %error, $g4_project_error\n\t%error_root =l add $g4_gc_global_roots, 88\n\tstorel %error, %error_root\n\tret 1\n@ignore\n\tret 0\n}\n\nfunction l $g4_collect_project_sources(l %source_root, l %out_root) {\n@start\n\t%paths =l call $g4_array_new(l $g4_desc_array_managed)\n\t%paths_root =l add $g4_gc_global_roots, 64\n\tstorel %paths, %paths_root\n\t%sources =l call $g4_array_new(l $g4_desc_array_managed)\n\t%sources_root =l add $g4_gc_global_roots, 72\n\tstorel %sources, %sources_root\n\t%result =l call $g4_gc_alloc(l $g4_desc_project_sources, l 24, l 0)\n\t%result_root =l add $g4_gc_global_roots, 80\n\tstorel %result, %result_root\n\t%paths_slot =l add %result, 8\n\tstorel %paths, %paths_slot\n\t%sources_slot =l add %result, 16\n\tstorel %sources, %sources_slot\n\t%error_slot =l add %result, 24\n\tstorel $g4_project_empty_string, %error_slot\n\tstorel %paths, $g4_project_paths\n\tstorel 0, $g4_project_error\n\t%error_root =l add $g4_gc_global_roots, 88\n\tstorel 0, %error_root\n\t%source_data =l add %source_root, 16\n\t%out_data =l add %out_root, 16\n\tstorel %source_data, $g4_project_source_root\n\tstorel %out_data, $g4_project_out_root\n\t%walk_status =w call $nftw(l %source_data, l $g4_project_walk_callback, w 32, w 1)\n\t%walk_error =l loadl $g4_project_error\n\t%callback_failed =w cnel %walk_error, 0\n\tjnz %callback_failed, @failed, @walk_result\n@walk_result\n\t%walk_failed =w cnew %walk_status, 0\n\tjnz %walk_failed, @root_failed, @sort\n@root_failed\n\tstorel %source_root, %error_slot\n\tret %result\n@failed\n\tstorel %walk_error, %error_slot\n\tret %result\n@sort\n\t%path_count_address =l add %paths, 8\n\t%path_count =l loadl %path_count_address\n\t%multiple =w csltl 1, %path_count\n\tjnz %multiple, @sort_paths, @read_start\n@sort_paths\n\t%paths_data_slot =l add %paths, 24\n\t%paths_data =l loadl %paths_data_slot\n\tcall $qsort(l %paths_data, l %path_count, l 8, l $g4_project_path_compare)\n\tjmp @read_start\n@read_start\n\t%read_data_slot =l add %paths, 24\n\t%read_data =l loadl %read_data_slot\n\tjmp @read_loop\n@read_loop\n\t%index =l phi @read_start 0, @read_next %next_index\n\t%finished =w cslel %path_count, %index\n\tjnz %finished, @success, @read\n@read\n\t%offset =l mul %index, 8\n\t%path_slot =l add %read_data, %offset\n\t%path =l loadl %path_slot\n\t%path_data =l add %path, 16\n\t%source =l call $g4_read_file(l %path_data)\n\t%read_failed =w ceql %source, 0\n\tjnz %read_failed, @source_failed, @source_ready\n@source_failed\n\tstorel %path, %error_slot\n\tret %result\n@source_ready\n\tcall $g4_array_push(l %sources, l %source)\n\tjmp @read_next\n@read_next\n\t%next_index =l add %index, 1\n\tjmp @read_loop\n@success\n\tret %result\n}\n\nfunction l $g4_c_concat(l %a, l %b) {\n@start\n\t%an =l call $strlen(l %a)\n\t%bn =l call $strlen(l %b)\n\t%n =l add %an, %bn\n\t%sz =l add %n, 1\n\t%r =l call $g4_alloc(l %sz)\n\tcall $memcpy(l %r, l %a, l %an)\n\t%p =l add %r, %an\n\tcall $memcpy(l %p, l %b, l %bn)\n\tret %r\n}\n\nfunction l $g4_c_basename(l %path) {\n@start\n\t%slash =l call $strrchr(l %path, w 47)\n\t%missing =w ceql %slash, 0\n\tjnz %missing, @whole, @suffix\n@whole\n\tret %path\n@suffix\n\t%base =l add %slash, 1\n\tret %base\n}\n",
		"function w $g4_run(l %program, l %args) {\n@start\n\t%pid =w call $fork()\n\t%ff =w csltw %pid, 0\n\tjnz %ff, @fail, @child_check\n@child_check\n\t%child =w ceqw %pid, 0\n\tjnz %child, @child, @parent\n@child\n\t%ignored =w call $execv(l %program, l %args)\n\tcall $exit(w 127)\n\thlt\n@parent\n\t%sp =l alloc8 8\n\tstorew 0, %sp\n\t%waited =w call $waitpid(w %pid, l %sp, w 0)\n\t%wf =w csltw %waited, 0\n\tjnz %wf, @fail, @status\n@status\n\t%st =w loadw %sp\n\t%sig =w and %st, 127\n\t%signaled =w cnew %sig, 0\n\tjnz %signaled, @signal, @exited\n@signal\n\t%sr =w add %sig, 128\n\tret %sr\n@exited\n\t%shifted =w shr %st, 8\n\t%code =w and %shifted, 255\n\tret %code\n@fail\n\tret 127\n}\n",
		"function w $g4_run_qbe(l %qbe, l %ssa, l %assembly) {\n@start\n\t%target =l loadl $g4_selected_qbe_target\n\t%a =l alloc8 56\n\tstorel %qbe, %a\n\t%a1 =l add %a, 8\n\tstorel $g4_target_flag, %a1\n\t%a2 =l add %a, 16\n\tstorel %target, %a2\n\t%a3 =l add %a, 24\n\tstorel $g4_o_flag, %a3\n\t%a4 =l add %a, 32\n\tstorel %assembly, %a4\n\t%a5 =l add %a, 40\n\tstorel %ssa, %a5\n\t%a6 =l add %a, 48\n\tstorel 0, %a6\n\t%r =w call $g4_run(l %qbe, l %a)\n\tret %r\n}\n",
		"function w $g4_project_run_cc(l %cc, l %assembly, l %output) {\n@start\n\t%dead_strip =l loadl $g4_selected_dead_strip\n\t%linker =l loadl $g4_project_selected_linker\n\t%a =l alloc8 72\n\tstorel %cc, %a\n\t%a1 =l add %a, 8\n\tstorel $g4_project_assembler_input, %a1\n\t%a2 =l add %a, 16\n\tstorel %assembly, %a2\n\t%has_linker =w cnel %linker, 0\n\tjnz %has_linker, @linker, @default\n@linker\n\t%linker_slot =l add %a, 24\n\tstorel %linker, %linker_slot\n\t%linker_tail =l add %a, 32\n\tjmp @tail\n@default\n\t%default_tail =l add %a, 24\n\tjmp @tail\n@tail\n\t%tail =l phi @linker %linker_tail, @default %default_tail\n\tstorel %dead_strip, %tail\n\t%math_slot =l add %tail, 8\n\tstorel $g4_math_library, %math_slot\n\t%output_flag_slot =l add %tail, 16\n\tstorel $g4_o_flag, %output_flag_slot\n\t%output_slot =l add %tail, 24\n\tstorel %output, %output_slot\n\t%end_slot =l add %tail, 32\n\tstorel 0, %end_slot\n\t%r =w call $g4_run(l %cc, l %a)\n\tret %r\n}\n",
		"function $g4_cleanup(l %ssa, l %assembly) {\n@start\n\t%i0 =w call $unlink(l %ssa)\n\t%i1 =w call $unlink(l %assembly)\n\tret\n}\n\nfunction $g4_cleanup_output(l %output, l %directory) {\n@start\n\t%i0 =w call $unlink(l %output)\n\t%i1 =w call $rmdir(l %directory)\n\tret\n}\n\nfunction l $g4_string_concat(l %left, l %right) {\n@start\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%length =l add %left_length, %right_length\n\t%size =l add %length, 9\n\t%string =l call $g4_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 16\n\t%left_data =l add %left, 16\n\tcall $memcpy(l %data, l %left_data, l %left_length)\n\t%right_target =l add %data, %left_length\n\t%right_data =l add %right, 16\n\tcall $memcpy(l %right_target, l %right_data, l %right_length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %string\n}\n\nfunction l $g4_string_equal(l %left, l %right) {\n@start\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%same_length =w ceql %left_length, %right_length\n\tjnz %same_length, @compare, @different\n@compare\n\t%left_data =l add %left, 16\n\t%right_data =l add %right, 16\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %left_length)\n\t%equal =w ceqw %comparison, 0\n\t%result =l extuw %equal\n\tret %result\n@different\n\tret 0\n}\n\nfunction l $g4_string_index(l %string, l %requested) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%negative =w csltl %requested, 0\n\tjnz %negative, @negative, @check\n@negative\n\t%adjusted_negative =l add %length, %requested\n\tjmp @bounds\n@check\n\t%adjusted_positive =l copy %requested\n\tjmp @bounds\n@bounds\n\t%index =l phi @negative %adjusted_negative, @check %adjusted_positive\n\t%below =w csltl %index, 0\n\t%above =w cslel %length, %index\n\t%invalid =w or %below, %above\n\tjnz %invalid, @fail, @load\n@fail\n\tcall $g4_fail(l $g4_bounds_error, l 30)\n\thlt\n@load\n\t%data =l add %string, 16\n\t%address =l add %data, %index\n\t%character =w loadub %address\n\t%result =l call $g4_string_alloc(l 10)\n\t%result_length =l add %result, 8\n\tstorel 1, %result_length\n\t%result_data =l add %result, 16\n\tstoreb %character, %result_data\n\t%result_end =l add %result_data, 1\n\tstoreb 0, %result_end\n\tret %result\n}\n\nfunction $g4_puts(l %string) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%data =l add %string, 16\n\tcall $write(w 1, l %data, l %length)\n\tcall $write(w 1, l $g4_newline, l 1)\n\tret\n}\n\nfunction $g4_eputs(l %string) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%data =l add %string, 16\n\tcall $write(w 2, l %data, l %length)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret\n}\n\nfunction l $g4_array_new(l %descriptor) {\n@start\n\t%array =l call $g4_gc_alloc(l %descriptor, l 24, l 32)\n\t%data =l call $calloc(l 4, l 8)\n\t%failed =w ceql %data, 0\n\tjnz %failed, @fail, @initialize\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@initialize\n\t%heap =l loadl $g4_gc_heap_bytes\n\t%heap_with_data =l add %heap, 32\n\tstorel %heap_with_data, $g4_gc_heap_bytes\n\t%allocated =l loadl $g4_gc_allocated_bytes\n\t%allocated_with_data =l add %allocated, 32\n\tstorel %allocated_with_data, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_with_data)\n\t%length =l add %array, 8\n\tstorel 0, %length\n\t%capacity =l add %array, 16\n\tstorel 4, %capacity\n\t%data_slot =l add %array, 24\n\tstorel %data, %data_slot\n\tret %array\n}\n\nfunction $g4_array_push(l %array, l %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\t%new_capacity =l mul %capacity, 2\n\t%new_bytes =l mul %new_capacity, 8\n\t%old_bytes =l mul %capacity, 8\n\t%growth =l sub %new_bytes, %old_bytes\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $g4_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $g4_gc_heap_bytes\n\t%allocated_before =l loadl $g4_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_after)\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\tjmp @store\n@store\n\t%current_data_slot =l add %array, 24\n\t%current_data =l loadl %current_data_slot\n\t%offset =l mul %length, 8\n\t%target =l add %current_data, %offset\n\tstorel %value, %target\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\tret\n}\n\nfunction l $g4_integer_add(l %left, l %right) {\n@start\n\t%result =l add %left, %right\n\t%too_high =w csgtl %result, 9007199254740991\n\tjnz %too_high, @fail, @check_low\n@check_low\n\t%too_low =w csltl %result, -9007199254740991\n\tjnz %too_low, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n@ok\n\tret %result\n}\n\nfunction l $g4_integer_subtract(l %left, l %right) {\n@start\n\t%result =l sub %left, %right\n\t%too_high =w csgtl %result, 9007199254740991\n\tjnz %too_high, @fail, @check_low\n@check_low\n\t%too_low =w csltl %result, -9007199254740991\n\tjnz %too_low, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n@ok\n\tret %result\n}\n\nfunction l $g4_integer_multiply(l %left, l %right) {\n@start\n\t%left_zero =w ceql %left, 0\n\tjnz %left_zero, @zero, @left_sign\n@left_sign\n\t%left_positive =w csgtl %left, 0\n\tjnz %left_positive, @left_positive, @left_negative\n@left_positive\n\t%right_positive =w csgtl %right, 0\n\tjnz %right_positive, @positive_positive, @positive_nonpositive\n@positive_positive\n\t%positive_limit =l div 9007199254740991, %right\n\t%positive_overflow =w csgtl %left, %positive_limit\n\tjnz %positive_overflow, @fail, @multiply\n@positive_nonpositive\n\t%right_zero =w ceql %right, 0\n\tjnz %right_zero, @zero, @positive_negative\n@positive_negative\n\t%negative_limit =l div -9007199254740991, %left\n\t%negative_overflow =w csltl %right, %negative_limit\n\tjnz %negative_overflow, @fail, @multiply\n@left_negative\n\t%right_positive_two =w csgtl %right, 0\n\tjnz %right_positive_two, @negative_positive, @negative_nonpositive\n@negative_positive\n\t%negative_limit_two =l div -9007199254740991, %right\n\t%negative_overflow_two =w csltl %left, %negative_limit_two\n\tjnz %negative_overflow_two, @fail, @multiply\n@negative_nonpositive\n\t%right_zero_two =w ceql %right, 0\n\tjnz %right_zero_two, @zero, @negative_negative\n@negative_negative\n\t%positive_limit_two =l div 9007199254740991, %right\n\t%positive_overflow_two =w csltl %left, %positive_limit_two\n\tjnz %positive_overflow_two, @fail, @multiply\n@multiply\n\t%result =l mul %left, %right\n\tret %result\n@zero\n\tret 0\n@fail\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n}\n\nfunction l $g4_integer_divide(l %left, l %right) {\n@start\n\t%zero =w ceql %right, 0\n\tjnz %zero, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_division_error, l 24)\n\thlt\n@ok\n\t%result =l div %left, %right\n\tret %result\n}\n\nfunction l $g4_integer_remainder(l %left, l %right) {\n@start\n\t%zero =w ceql %right, 0\n\tjnz %zero, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_division_error, l 24)\n\thlt\n@ok\n\t%result =l rem %left, %right\n\tret %result\n}\n",
	]
	mut index := 0
	while index < lines.size()
		line := lines[index]
		if project_runtime
			gate4_output_line(output, line)
		else
			if gate4_string_starts_with(line, "function w $g4_project_run_cc")
				gate4_output_line(
					output,
					"function w $g4_run_cc(l %cc, l %assembly, l %output) {\n@start\n\t%dead_strip =l loadl $g4_selected_dead_strip\n\t%a =l alloc8 56\n\tstorel %cc, %a\n\t%a1 =l add %a, 8\n\tstorel %assembly, %a1\n\t%a2 =l add %a, 16\n\tstorel %dead_strip, %a2\n\t%a3 =l add %a, 24\n\tstorel $g4_math_library, %a3\n\t%a4 =l add %a, 32\n\tstorel $g4_o_flag, %a4\n\t%a5 =l add %a, 40\n\tstorel %output, %a5\n\t%a6 =l add %a, 48\n\tstorel 0, %a6\n\t%r =w call $g4_run(l %cc, l %a)\n\tret %r\n}\n",
				)
			else
				if gate4_string_starts_with(line, "function l $g4_read_source")
					gate4_output_line(
						output,
						"function l $g4_read_source(l %path) {\n@start\n\t%data =l add %path, 16\n\t%source =l call $g4_read_file(l %data)\n\tret %source\n}\n",
					)
				else
					if !gate4_project_runtime_qbe_line(line)
						gate4_output_line(output, line)
					end
				end
			end
		end
		index += 1
	end
	gate4_emit_managed_runtime_compact(output)
	return
end

def gate4_emit_managed_runtime_compact(mut output: Gate4Output)
	gate4_output_line(output, "data $g4_gc_heap = align 8 { l 0 }\ndata $g4_gc_global_roots = align 8 { z 96 }\ndata $g4_gc_temp_data = align 8 { l 0 }\ndata $g4_gc_temp_count = align 8 { l 0 }\ndata $g4_gc_temp_capacity = align 8 { l 0 }\ndata $g4_gc_heap_bytes = align 8 { l 0 }\ndata $g4_gc_heap_target = align 8 { l 1048576 }\ndata $g4_gc_collection_count = align 8 { l 0 }\ndata $g4_gc_automatic_collection_count = align 8 { l 0 }\ndata $g4_gc_allocated_bytes = align 8 { l 0 }\ndata $g4_gc_reclaimed_bytes = align 8 { l 0 }\ndata $g4_gc_peak_heap_bytes = align 8 { l 0 }\ndata $g4_gc_trace_enabled = align 8 { l 0 }\ndata $g4_desc_string = align 8 { l 0 }\ndata $g4_desc_array_scalar = align 8 { l 2, l 0 }\ndata $g4_desc_array_managed = align 8 { l 2, l 1 }\ndata $g4_desc_project_sources = align 8 { l 1, l 3, l 24, l 8, l 16, l 24 }\ndata $g4_gc_stats_environment = { b \"TYPE_RB_NATIVE_RUNTIME_STATS\", b 0 }\ndata $g4_gc_trace_environment = { b \"TYPE_RB_NATIVE_RUNTIME_TRACE\", b 0 }\ndata $g4_gc_trace_collection = { b \"type-rb-native-gc-trace-v1,collection,\" }\ndata $g4_gc_trace_automatic = { b \"type-rb-native-gc-trace-v1,automatic,\" }\ndata $g4_gc_trace_live = { b \"type-rb-native-gc-trace-v1,live-bytes,\" }\ndata $g4_gc_trace_target = { b \"type-rb-native-gc-trace-v1,next-target-bytes,\" }\ndata $g4_gc_trace_roots = { b \"type-rb-native-gc-trace-v1,root-count,\" }\ndata $g4_gc_trace_capacity = { b \"type-rb-native-gc-trace-v1,root-capacity,\" }\ndata $g4_gc_report_collections = { b \"type-rb-native-gc-stat-v1,collections,\" }\ndata $g4_gc_report_automatic = { b \"type-rb-native-gc-stat-v1,automatic-collections,\" }\ndata $g4_gc_report_allocated = { b \"type-rb-native-gc-stat-v1,allocated-bytes,\" }\ndata $g4_gc_report_reclaimed = { b \"type-rb-native-gc-stat-v1,reclaimed-bytes,\" }\ndata $g4_gc_report_live = { b \"type-rb-native-gc-stat-v1,live-bytes,\" }\ndata $g4_gc_report_peak = { b \"type-rb-native-gc-stat-v1,peak-heap-bytes,\" }\n\nfunction $g4_gc_update_peak(l %candidate) {\n@start\n\t%peak =l loadl $g4_gc_peak_heap_bytes\n\t%greater =w csgtl %candidate, %peak\n\tjnz %greater, @store, @finish\n@store\n\tstorel %candidate, $g4_gc_peak_heap_bytes\n\tret\n@finish\n\tret\n}\n\nfunction $g4_gc_maybe_collect(l %additional) {\n@start\n\t%before =l loadl $g4_gc_heap_bytes\n\t%projected =l add %before, %additional\n\t%target =l loadl $g4_gc_heap_target\n\t%over =w csgtl %projected, %target\n\tjnz %over, @collect, @finish\n@collect\n\tcall $g4_gc_collect(w 1)\n@finish\n\tret\n}\n\nfunction $g4_gc_temp_push(l %value) {\n@start\n\t%nil =w ceql %value, 0\n\tjnz %nil, @finish, @descriptor\n@descriptor\n\t%descriptor_mark =l loadl %value\n\t%static =w ceql %descriptor_mark, 0\n\tjnz %static, @finish, @count\n@count\n\t%count =l loadl $g4_gc_temp_count\n\t%capacity =l loadl $g4_gc_temp_capacity\n\t%full =w ceql %count, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $g4_gc_temp_grow(l %value, l %count, l %capacity)\n\tret\n@store\n\t%current_data =l loadl $g4_gc_temp_data\n\t%offset =l shl %count, 3\n\t%slot =l add %current_data, %offset\n\tstorel %value, %slot\n\t%next_count =l add %count, 1\n\tstorel %next_count, $g4_gc_temp_count\n\tjmp @finish\n@finish\n\tret\n}\n\nfunction $g4_gc_temp_grow(l %value, l %count, l %capacity) {\n@start\n\t%empty =w ceql %capacity, 0\n\tjnz %empty, @minimum, @double\n@minimum\n\t%minimum =l copy 64\n\tjmp @allocate\n@double\n\t%doubled =l mul %capacity, 2\n\tjmp @allocate\n@allocate\n\t%next_capacity =l phi @minimum %minimum, @double %doubled\n\t%bytes =l mul %next_capacity, 8\n\t%data =l loadl $g4_gc_temp_data\n\t%new_data =l call $realloc(l %data, l %bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\tstorel %new_data, $g4_gc_temp_data\n\tstorel %next_capacity, $g4_gc_temp_capacity\n\t%offset =l mul %count, 8\n\t%slot =l add %new_data, %offset\n\tstorel %value, %slot\n\t%next_count =l add %count, 1\n\tstorel %next_count, $g4_gc_temp_count\n\tret\n}\n\nfunction $g4_gc_temp_reset(l %base) {\n@start\n\tstorel %base, $g4_gc_temp_count\n\tret\n}\n\nfunction l $g4_gc_alloc(l %descriptor, l %payload_size, l %reserved_size) {\n@start\n\t%total =l add %payload_size, 16\n\t%projected =l add %total, %reserved_size\n\tcall $g4_gc_maybe_collect(l %projected)\n\t%base =l call $malloc(l %total)\n\t%failed =w ceql %base, 0\n\tjnz %failed, @fail, @initialize\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@initialize\n\t%head =l loadl $g4_gc_heap\n\tstorel %head, %base\n\t%object =l add %base, 8\n\tstorel %descriptor, %object\n\t%payload =l add %object, 8\n\tcall $memset(l %payload, w 0, l %payload_size)\n\t%bytes =l loadl $g4_gc_heap_bytes\n\t%updated =l add %bytes, %total\n\tstorel %updated, $g4_gc_heap_bytes\n\t%allocated =l loadl $g4_gc_allocated_bytes\n\t%new_allocated =l add %allocated, %total\n\tstorel %new_allocated, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %updated)\n\tstorel %base, $g4_gc_heap\n\tcall $g4_gc_temp_push(l %object)\n\tret %object\n}\n\nfunction $g4_gc_scan_fixed(l %object, l %descriptor) {\n@start\n\t%count_address =l add %descriptor, 8\n\t%count =l loadl %count_address\n\tjmp @loop\n@loop\n\t%index =l phi @start 0, @visit %next\n\t%done =w cslel %count, %index\n\tjnz %done, @finish, @visit\n@visit\n\t%scaled =l mul %index, 8\n\t%entries =l add %descriptor, 24\n\t%entry =l add %entries, %scaled\n\t%offset =l loadl %entry\n\t%field =l add %object, %offset\n\t%reference =l loadl %field\n\tcall $g4_gc_mark(l %reference)\n\t%next =l add %index, 1\n\tjmp @loop\n@finish\n\tret\n}\n\nfunction $g4_gc_scan_array(l %object, l %descriptor) {\n@start\n\t%managed_address =l add %descriptor, 8\n\t%managed =l loadl %managed_address\n\t%scalar =w ceql %managed, 0\n\tjnz %scalar, @finish, @prepare\n@prepare\n\t%length_address =l add %object, 8\n\t%length =l loadl %length_address\n\t%data_address =l add %object, 24\n\t%data =l loadl %data_address\n\tjmp @loop\n@loop\n\t%index =l phi @prepare 0, @visit %next\n\t%done =w cslel %length, %index\n\tjnz %done, @finish, @visit\n@visit\n\t%scaled =l mul %index, 8\n\t%entry =l add %data, %scaled\n\t%reference =l loadl %entry\n\tcall $g4_gc_mark(l %reference)\n\t%next =l add %index, 1\n\tjmp @loop\n@finish\n\tret\n}\n\nfunction $g4_gc_mark(l %object) {\n@start\n\t%nil =w ceql %object, 0\n\tjnz %nil, @finish, @descriptor\n@descriptor\n\t%descriptor_mark =l loadl %object\n\t%static =w ceql %descriptor_mark, 0\n\tjnz %static, @finish, @check_mark\n@check_mark\n\t%mark =l and %descriptor_mark, 1\n\t%seen =w cnel %mark, 0\n\tjnz %seen, @finish, @dispatch\n@dispatch\n\t%marked_descriptor =l or %descriptor_mark, 1\n\tstorel %marked_descriptor, %object\n\t%descriptor =l and %descriptor_mark, -2\n\t%kind =l loadl %descriptor\n\t%fixed =w ceql %kind, 1\n\tjnz %fixed, @fixed, @check_array\n@fixed\n\tcall $g4_gc_scan_fixed(l %object, l %descriptor)\n\tret\n@check_array\n\t%array =w ceql %kind, 2\n\tjnz %array, @array, @finish\n@array\n\tcall $g4_gc_scan_array(l %object, l %descriptor)\n@finish\n\tret\n}\n\nfunction $g4_gc_mark_roots() {\n@start\n\t%temp_count =l loadl $g4_gc_temp_count\n\t%temp_data =l loadl $g4_gc_temp_data\n\tjmp @temp_loop\n@temp_loop\n\t%temp_index =l phi @start 0, @temp %next_temp\n\t%temps_done =w cslel %temp_count, %temp_index\n\tjnz %temps_done, @globals, @temp\n@temp\n\t%temp_scaled =l mul %temp_index, 8\n\t%temp_slot =l add %temp_data, %temp_scaled\n\t%temp_reference =l loadl %temp_slot\n\tcall $g4_gc_mark(l %temp_reference)\n\t%next_temp =l add %temp_index, 1\n\tjmp @temp_loop\n@globals\n\tjmp @global_loop\n@global_loop\n\t%global_index =l phi @globals 0, @global %next_global\n\t%globals_done =w cslel 12, %global_index\n\tjnz %globals_done, @finish, @global\n@global\n\t%global_scaled =l mul %global_index, 8\n\t%global_slot =l add $g4_gc_global_roots, %global_scaled\n\t%global_reference =l loadl %global_slot\n\tcall $g4_gc_mark(l %global_reference)\n\t%next_global =l add %global_index, 1\n\tjmp @global_loop\n@finish\n\tret\n}\n\nfunction $g4_gc_sweep() {\n@start\n\t%head =l loadl $g4_gc_heap\n\tjmp @loop\n@loop\n\t%current =l phi @start %head, @advance %next\n\t%previous =l phi @start 0, @advance %next_previous\n\t%done =w ceql %current, 0\n\tjnz %done, @finish, @object\n@object\n\t%next =l loadl %current\n\t%descriptor_address =l add %current, 8\n\t%descriptor_mark =l loadl %descriptor_address\n\t%mark =l and %descriptor_mark, 1\n\t%live =w cnel %mark, 0\n\tjnz %live, @keep, @release\n@keep\n\t%descriptor =l and %descriptor_mark, -2\n\tstorel %descriptor, %descriptor_address\n\tjmp @advance\n@release\n\t%released_descriptor =l and %descriptor_mark, -2\n\t%kind =l loadl %released_descriptor\n\t%array =w ceql %kind, 2\n\tjnz %array, @release_array, @check_fixed\n@release_array\n\t%data_address =l add %current, 32\n\t%data =l loadl %data_address\n\t%capacity_address =l add %current, 24\n\t%capacity =l loadl %capacity_address\n\t%backing_bytes =l mul %capacity, 8\n\t%heap_with_backing =l loadl $g4_gc_heap_bytes\n\t%heap_without_backing =l sub %heap_with_backing, %backing_bytes\n\tstorel %heap_without_backing, $g4_gc_heap_bytes\n\t%reclaimed_before_backing =l loadl $g4_gc_reclaimed_bytes\n\t%reclaimed_with_backing =l add %reclaimed_before_backing, %backing_bytes\n\tstorel %reclaimed_with_backing, $g4_gc_reclaimed_bytes\n\t%has_data =w cnel %data, 0\n\tjnz %has_data, @free_data, @array_ready\n@free_data\n\tcall $free(l %data)\n\tjmp @array_ready\n@array_ready\n\t%array_size =l copy 40\n\tjmp @unlink\n@check_fixed\n\t%fixed =w ceql %kind, 1\n\tjnz %fixed, @fixed_size, @string_size\n@fixed_size\n\t%payload_size_address =l add %released_descriptor, 16\n\t%payload_size =l loadl %payload_size_address\n\t%fixed_size =l add %payload_size, 16\n\tjmp @unlink\n@string_size\n\t%length_address =l add %current, 16\n\t%length =l loadl %length_address\n\t%string_size =l add %length, 25\n\tjmp @unlink\n@unlink\n\t%size =l phi @array_ready %array_size, @fixed_size %fixed_size, @string_size %string_size\n\t%at_head =w ceql %previous, 0\n\tjnz %at_head, @unlink_head, @unlink_after\n@unlink_head\n\tstorel %next, $g4_gc_heap\n\tjmp @account\n@unlink_after\n\tstorel %next, %previous\n@account\n\t%bytes =l loadl $g4_gc_heap_bytes\n\t%remaining =l sub %bytes, %size\n\tstorel %remaining, $g4_gc_heap_bytes\n\t%reclaimed =l loadl $g4_gc_reclaimed_bytes\n\t%new_reclaimed =l add %reclaimed, %size\n\tstorel %new_reclaimed, $g4_gc_reclaimed_bytes\n\tcall $free(l %current)\n\tjmp @advance\n@advance\n\t%next_previous =l phi @keep %current, @account %previous\n\tjmp @loop\n@finish\n\tret\n}\n\nfunction $g4_gc_collect(w %automatic) {\n@start\n\tcall $g4_gc_mark_roots()\n\tcall $g4_gc_sweep()\n\t%count =l loadl $g4_gc_collection_count\n\t%next_count =l add %count, 1\n\tstorel %next_count, $g4_gc_collection_count\n\tjnz %automatic, @automatic, @pace\n@automatic\n\t%automatic_count =l loadl $g4_gc_automatic_collection_count\n\t%next_automatic =l add %automatic_count, 1\n\tstorel %next_automatic, $g4_gc_automatic_collection_count\n\tjmp @pace\n@pace\n\t%live =l loadl $g4_gc_heap_bytes\n\t%doubled =l mul %live, 2\n\t%candidate =l add %doubled, 65536\n\t%small =w csltl %candidate, 1048576\n\tjnz %small, @minimum, @candidate\n@minimum\n\tstorel 1048576, $g4_gc_heap_target\n\tjmp @trace\n@candidate\n\tstorel %candidate, $g4_gc_heap_target\n\tjmp @trace\n@trace\n\tcall $g4_gc_trace(w %automatic, l %next_count)\n\tret\n}\n\nfunction $g4_gc_trace_initialize() {\n@start\n\t%enabled =l call $getenv(l $g4_gc_trace_environment)\n\tstorel %enabled, $g4_gc_trace_enabled\n\tret\n}\n\nfunction $g4_gc_trace(w %automatic, l %collection) {\n@start\n\t%enabled =l loadl $g4_gc_trace_enabled\n\t%disabled =w ceql %enabled, 0\n\tjnz %disabled, @finish, @select\n@select\n\t%manual =w ceqw %automatic, 0\n\tjnz %manual, @emit, @interval\n@interval\n\t%remainder =l rem %collection, 64\n\t%sampled =w ceql %remainder, 0\n\tjnz %sampled, @emit, @finish\n@emit\n\tcall $g4_gc_report(l $g4_gc_trace_collection, l 38, l %collection)\n\t%automatic_value =l extuw %automatic\n\tcall $g4_gc_report(l $g4_gc_trace_automatic, l 37, l %automatic_value)\n\t%live =l loadl $g4_gc_heap_bytes\n\tcall $g4_gc_report(l $g4_gc_trace_live, l 38, l %live)\n\t%target =l loadl $g4_gc_heap_target\n\tcall $g4_gc_report(l $g4_gc_trace_target, l 45, l %target)\n\t%roots =l loadl $g4_gc_temp_count\n\tcall $g4_gc_report(l $g4_gc_trace_roots, l 38, l %roots)\n\t%capacity =l loadl $g4_gc_temp_capacity\n\tcall $g4_gc_report(l $g4_gc_trace_capacity, l 41, l %capacity)\n@finish\n\tret\n}\n\nfunction $g4_gc_report(l %label, l %label_size, l %value) {\n@start\n\tcall $write(w 2, l %label, l %label_size)\n\t%buffer =l alloc8 32\n\t%end =l add %buffer, 32\n\t%cursor_slot =l alloc8 8\n\t%value_slot =l alloc8 8\n\tstorel %end, %cursor_slot\n\tstorel %value, %value_slot\n\t%zero =w ceql %value, 0\n\tjnz %zero, @zero, @loop\n@zero\n\t%zero_cursor =l sub %end, 1\n\tstoreb 48, %zero_cursor\n\tstorel %zero_cursor, %cursor_slot\n\tjmp @write\n@loop\n\t%current =l loadl %value_slot\n\t%done =w ceql %current, 0\n\tjnz %done, @write, @digit\n@digit\n\t%remainder =l rem %current, 10\n\t%digit =l add %remainder, 48\n\t%digit_byte =w copy %digit\n\t%cursor =l loadl %cursor_slot\n\t%next_cursor =l sub %cursor, 1\n\tstoreb %digit_byte, %next_cursor\n\tstorel %next_cursor, %cursor_slot\n\t%remaining =l div %current, 10\n\tstorel %remaining, %value_slot\n\tjmp @loop\n@write\n\t%start =l loadl %cursor_slot\n\t%size =l sub %end, %start\n\tcall $write(w 2, l %start, l %size)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret\n}\n\nfunction $g4_gc_finish() {\n@start\n\t%stats_enabled =l call $getenv(l $g4_gc_stats_environment)\n\t%trace_enabled =l loadl $g4_gc_trace_enabled\n\t%stats_disabled =w ceql %stats_enabled, 0\n\t%trace_disabled =w ceql %trace_enabled, 0\n\t%disabled =w and %stats_disabled, %trace_disabled\n\tjnz %disabled, @finish, @collect\n@collect\n\tstorel 0, $g4_gc_temp_count\n\tcall $memset(l $g4_gc_global_roots, w 0, l 96)\n\tcall $g4_gc_collect(w 0)\n\tjnz %stats_disabled, @finish, @report\n@report\n\t%collections =l loadl $g4_gc_collection_count\n\tcall $g4_gc_report(l $g4_gc_report_collections, l 38, l %collections)\n\t%automatic =l loadl $g4_gc_automatic_collection_count\n\tcall $g4_gc_report(l $g4_gc_report_automatic, l 48, l %automatic)\n\t%allocated =l loadl $g4_gc_allocated_bytes\n\tcall $g4_gc_report(l $g4_gc_report_allocated, l 42, l %allocated)\n\t%reclaimed =l loadl $g4_gc_reclaimed_bytes\n\tcall $g4_gc_report(l $g4_gc_report_reclaimed, l 42, l %reclaimed)\n\t%live =l loadl $g4_gc_heap_bytes\n\tcall $g4_gc_report(l $g4_gc_report_live, l 37, l %live)\n\t%peak =l loadl $g4_gc_peak_heap_bytes\n\tcall $g4_gc_report(l $g4_gc_report_peak, l 42, l %peak)\n@finish\n\tret\n}\n")
	gate4_output_line(output, "\nfunction $g4_gc_temp_reserve(l %required) {\n@start\n\t%capacity =l loadl $g4_gc_temp_capacity\n\t%enough =w cslel %required, %capacity\n\tjnz %enough, @finish, @initial\n@initial\n\t%empty =w ceql %capacity, 0\n\tjnz %empty, @minimum, @existing\n@minimum\n\t%minimum =l copy 64\n\tjmp @grow\n@existing\n\t%existing =l copy %capacity\n\tjmp @grow\n@grow\n\t%current =l phi @minimum %minimum, @existing %existing, @double %doubled\n\t%large_enough =w cslel %required, %current\n\tjnz %large_enough, @allocate, @double\n@double\n\t%doubled =l mul %current, 2\n\tjmp @grow\n@allocate\n\t%bytes =l mul %current, 8\n\t%data =l loadl $g4_gc_temp_data\n\t%new_data =l call $realloc(l %data, l %bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @ready\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ready\n\tstorel %new_data, $g4_gc_temp_data\n\tstorel %current, $g4_gc_temp_capacity\n@finish\n\tret\n}\n")
	# Traced non-Float Arrays share paced growth and a compact push ABI.
	gate4_output_line(output, "\nfunction $g4_array_push_paced(l %array, l %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $g4_array_grow_paced(l %array, l %value, l %length, l %capacity)\n\tret\n@store\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%offset =l shl %length, 3\n\t%target =l add %data, %offset\n\tstorel %value, %target\n\tret\n}\n\nfunction $g4_array_grow_paced(l %array, l %value, l %length, l %capacity) {\n@start\n\t%new_capacity =l shl %capacity, 2\n\t%new_bytes =l shl %new_capacity, 3\n\t%old_bytes =l shl %capacity, 3\n\t%growth =l sub %new_bytes, %old_bytes\n\tcall $g4_gc_maybe_collect(l %growth)\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $g4_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $g4_gc_heap_bytes\n\t%allocated_before =l loadl $g4_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_after)\n\t%capacity_slot =l add %array, 16\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\t%offset =l shl %length, 3\n\t%target =l add %new_data, %offset\n\tstorel %value, %target\n\t%new_length =l add %length, 1\n\t%length_slot =l add %array, 8\n\tstorel %new_length, %length_slot\n\tret\n}\n")
	return
end

def gate4_emit_float_array_runtime(mut output: Gate4Output)
	gate4_output_line(output, "\nfunction $g4_array_push_d(l %array, d %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\t%new_capacity =l mul %capacity, 2\n\t%new_bytes =l mul %new_capacity, 8\n\t%old_bytes =l mul %capacity, 8\n\t%growth =l sub %new_bytes, %old_bytes\n\tcall $g4_gc_maybe_collect(l %growth)\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $g4_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $g4_gc_heap_bytes\n\t%allocated_before =l loadl $g4_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_after)\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\tjmp @store\n@store\n\t%current_data_slot =l add %array, 24\n\t%current_data =l loadl %current_data_slot\n\t%offset =l mul %length, 8\n\t%target =l add %current_data, %offset\n\tstored %value, %target\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\tret\n}")
	return
end

def gate4_emit_process_runtime(mut output: Gate4Output)
	gate4_output_line(
		output,
		"\ndata $g4_process_argc = align 8 { l 0 }\ndata $g4_process_argv_pointer = align 8 { l 0 }\n\nfunction l $g4_process_argv() {\n@start\n\t%array =l call $g4_array_new(l $g4_desc_array_managed)\n\t%argc =l loadl $g4_process_argc\n\t%argv =l loadl $g4_process_argv_pointer\n\tjmp @loop\n@loop\n\t%index =l phi @start 1, @append %next\n\t%done =w cslel %argc, %index\n\tjnz %done, @finish, @load\n@load\n\t%offset =l mul %index, 8\n\t%cell =l add %argv, %offset\n\t%source =l loadl %cell\n\t%string =l call $g4_string_from_c(l %source)\n\tcall $g4_array_push_paced(l %array, l %string)\n\tjmp @append\n@append\n\t%next =l add %index, 1\n\tjmp @loop\n@finish\n\tret %array\n}",
	)
	return
end

def gate4_emit_string_to_integer_runtime(mut output: Gate4Output)
	gate4_output_line(
		output,
		"\ndata $g4_invalid_integer_error = { b \"panic: invalid Integer\", b 10 }\n\nfunction l $g4_string_to_integer(l %string) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%empty =w ceql %length, 0\n\tjnz %empty, @invalid, @first\n@first\n\t%parse_start_slot =l alloc8 8\n\t%data =l add %string, 16\n\t%first =w loadub %data\n\t%plus =w ceqw %first, 43\n\t%minus =w ceqw %first, 45\n\t%signed =w or %plus, %minus\n\tjnz %signed, @signed, @unsigned\n@signed\n\t%sign_only =w ceql %length, 1\n\tjnz %sign_only, @invalid, @signed_start\n@signed_start\n\t%signed_index =l copy 1\n\tstorel %signed_index, %parse_start_slot\n\tjmp @validate\n@unsigned\n\t%unsigned_index =l copy 0\n\tstorel %unsigned_index, %parse_start_slot\n\tjmp @validate\n@validate\n\t%validation_index =l phi @signed_start %signed_index, @unsigned %unsigned_index, @validate_next %validation_next\n\t%validation_done =w cslel %length, %validation_index\n\tjnz %validation_done, @parse_start, @validate_digit\n@validate_digit\n\t%validation_address =l add %data, %validation_index\n\t%validation_character =w loadub %validation_address\n\t%validation_below =w csltw %validation_character, 48\n\t%validation_above =w csgtw %validation_character, 57\n\t%validation_invalid =w or %validation_below, %validation_above\n\tjnz %validation_invalid, @invalid, @validate_next\n@validate_next\n\t%validation_next =l add %validation_index, 1\n\tjmp @validate\n@parse_start\n\t%parse_begin =l loadl %parse_start_slot\n\tjmp @parse\n@parse\n\t%parse_index =l phi @parse_start %parse_begin, @parse_next %next_index\n\t%accumulator =l phi @parse_start 0, @parse_next %next_accumulator\n\t%parse_done =w cslel %length, %parse_index\n\tjnz %parse_done, @sign, @parse_digit\n@parse_digit\n\t%parse_address =l add %data, %parse_index\n\t%parse_character =w loadub %parse_address\n\t%digit_word =w sub %parse_character, 48\n\t%digit =l extuw %digit_word\n\t%large_prefix =w csgtl %accumulator, 900719925474099\n\t%limit_prefix =w ceql %accumulator, 900719925474099\n\t%large_digit =w csgtl %digit, 1\n\t%limit_overflow =w and %limit_prefix, %large_digit\n\t%overflow =w or %large_prefix, %limit_overflow\n\tjnz %overflow, @range, @accumulate\n@accumulate\n\t%scaled =l mul %accumulator, 10\n\t%next_accumulator =l add %scaled, %digit\n\tjmp @parse_next\n@parse_next\n\t%next_index =l add %parse_index, 1\n\tjmp @parse\n@sign\n\tjnz %minus, @negative, @positive\n@negative\n\t%negative_result =l sub 0, %accumulator\n\tret %negative_result\n@positive\n\tret %accumulator\n@invalid\n\tcall $g4_fail(l $g4_invalid_integer_error, l 23)\n\thlt\n@range\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n}",
	)
	return
end

def gate4_emit_integer_to_string_runtime(mut output: Gate4Output)
	gate4_output_line(
		output,
		"\nfunction l $g4_integer_to_string(l %value) {\n@start\n\t%buffer =l alloc8 32\n\t%end =l add %buffer, 32\n\t%cursor_slot =l alloc8 8\n\tstorel %end, %cursor_slot\n\t%negative =w csltl %value, 0\n\tjnz %negative, @negative_value, @positive_value\n@negative_value\n\t%negative_magnitude =l sub 0, %value\n\tjmp @magnitude\n@positive_value\n\t%positive_magnitude =l copy %value\n\tjmp @magnitude\n@magnitude\n\t%magnitude_value =l phi @negative_value %negative_magnitude, @positive_value %positive_magnitude\n\t%zero =w ceql %magnitude_value, 0\n\tjnz %zero, @zero_digit, @digits\n@zero_digit\n\t%zero_cursor =l sub %end, 1\n\tstoreb 48, %zero_cursor\n\tstorel %zero_cursor, %cursor_slot\n\tjmp @sign\n@digits\n\t%current =l phi @magnitude %magnitude_value, @digit %remaining\n\t%done =w ceql %current, 0\n\tjnz %done, @sign, @digit\n@digit\n\t%remainder =l rem %current, 10\n\t%digit_value =l add %remainder, 48\n\t%digit_byte =w copy %digit_value\n\t%cursor =l loadl %cursor_slot\n\t%next_cursor =l sub %cursor, 1\n\tstoreb %digit_byte, %next_cursor\n\tstorel %next_cursor, %cursor_slot\n\t%remaining =l div %current, 10\n\tjmp @digits\n@sign\n\tjnz %negative, @negative_sign, @finish\n@negative_sign\n\t%sign_cursor =l loadl %cursor_slot\n\t%before_sign =l sub %sign_cursor, 1\n\tstoreb 45, %before_sign\n\tstorel %before_sign, %cursor_slot\n\tjmp @finish\n@finish\n\t%start =l loadl %cursor_slot\n\t%length =l sub %end, %start\n\t%size =l add %length, 9\n\t%string =l call $g4_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 16\n\tcall $memcpy(l %data, l %start, l %length)\n\t%terminator =l add %data, %length\n\tstoreb 0, %terminator\n\tret %string\n}",
	)
	return
end

def gate4_emit_float_to_integer_runtime(mut output: Gate4Output)
	gate4_output_line(
		output,
		"\ndata $g4_float_integer_error = { b \"panic: Float cannot be converted to Integer\", b 10 }\n\nfunction l $g4_float_to_integer(d %value) {\n@start\n\t%self_difference =d sub %value, %value\n\t%finite =w ceqd %self_difference, %self_difference\n\tjnz %finite, @range, @nonfinite\n@range\n\t%too_high =w cgtd %value, d_9007199254740991.0\n\t%too_low =w cltd %value, d_-9007199254740991.0\n\t%outside =w or %too_high, %too_low\n\tjnz %outside, @outside, @convert\n@convert\n\t%result =l dtosi %value\n\tret %result\n@nonfinite\n\tcall $g4_fail(l $g4_float_integer_error, l 44)\n\thlt\n@outside\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n}",
	)
	return
end

def gate4_emitted_value(
		operand: String,
		type_name: String,
		category: Integer,
		name: String,
		mutable: Integer,
		address: String,
	): Gate4EmittedValue
	return Gate4EmittedValue.new(
		operand: operand,
		type_name: type_name,
		category: category,
		name: name,
		mutable: mutable,
		address: address,
	)
end

def gate4_qbe_type(type_name: String): String
	if type_name == "Float"
		return "d"
	end
	return "l"
end

def gate4_qbe_load(type_name: String): String
	if type_name == "Float"
		return "loadd"
	end
	return "loadl"
end

def gate4_qbe_store(type_name: String): String
	if type_name == "Float"
		return "stored"
	end
	return "storel"
end

def gate4_type_is_managed(type_name: String): Boolean
	if type_name == "String"
		return true
	end
	if gate4_array_element_type(type_name) != ""
		return true
	end
	return gate4_string_starts_with(type_name, "Record#")
end

def gate4_note_temporary_root(mut context: Gate4EmitContext)
	if context.temporary_roots_used[0] == 0
		context.temporary_roots_used[0] = 1
	end
	return
end

def gate4_note_gc_safe_point(mut context: Gate4EmitContext)
	if context.temporary_roots_used[0] == 1
		context.temporary_roots_used[0] = 2
	end
	return
end

def gate4_emit_array_push(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		array: String,
		element_type: String,
		operand: String,
	)
	# Growing an Array may collect before its backing storage is reallocated.
	gate4_note_gc_safe_point(context)
	gate4_invalidate_array_header_cache(context)
	if element_type == "Float"
		output.runtime_flags[0] = 1
		gate4_output_line(
			output,
			"\tcall $g4_array_push_d(l " + array + ", d " + operand + ")",
		)
		return
	end
	gate4_output_line(
		output,
		"\tcall $g4_array_push_paced(l " + array + ", l " + operand + ")",
	)
end

def gate4_emit_temporary(mut context: Gate4EmitContext): String
	index := context.temporary_count[0]
	context.temporary_count[0] = index + 1
	return "%t" + gate4_integer_string(index)
end

def gate4_emit_temporary_root_reset(mut context: Gate4EmitContext, mut output: Gate4Output)
	return
end

def gate4_owned_managed_local_count(context: Gate4EmitContext): Integer
	mut count := 0
	mut local_index := 0
	while local_index < context.local_count[0]
		type_name := gate4_load_string(context.local_types, local_index)
		inherited := gate4_load_integer(context.local_inherited, local_index)
		if gate4_type_is_managed(type_name)
			if inherited == 0
				count += 1
			end
		end
		local_index += 1
	end
	return count
end

def gate4_emit_loop_root_compaction(mut context: Gate4EmitContext, mut output: Gate4Output)
	# Replace this function's temporary-root segment with its currently live
	# managed locals. The prologue reserves the maximum segment first, so loop
	# headers never reallocate while rewriting roots.
	managed_count := gate4_owned_managed_local_count(context)
	if managed_count == 0
		gate4_output_line(output, "\tcall $g4_gc_temp_reset(l %temporary_roots)")
		return
	end
	gate4_output_line(output, "{")
	data := gate4_emit_temporary(context)
	base_offset := gate4_emit_temporary(context)
	base := gate4_emit_temporary(context)
	gate4_output_line(output, "\t" + data + " =l loadl $g4_gc_temp_data")
	gate4_output_line(output, "\t" + base_offset + " =l mul %temporary_roots, 8")
	gate4_output_line(output, "\t" + base + " =l add " + data + ", " + base_offset)
	mut local_index := 0
	mut managed_index := 0
	while local_index < context.local_count[0]
		type_name := gate4_load_string(context.local_types, local_index)
		inherited := gate4_load_integer(context.local_inherited, local_index)
		if gate4_type_is_managed(type_name)
			if inherited == 0
				gate4_note_temporary_root(context)
				value := gate4_emit_temporary(context)
				mut slot := base
				if managed_index > 0
					slot = gate4_emit_temporary(context)
					gate4_output_line(
						output,
						"\t" + slot + " =l add " + base + ", " + gate4_integer_string(managed_index * 8),
					)
				end
				gate4_output_line(
					output,
					"\t" + value + " =l loadl " + gate4_load_string(context.local_slots, local_index),
				)
				gate4_output_line(output, "\tstorel " + value + ", " + slot)
				managed_index += 1
			end
		end
		local_index += 1
	end
	root_count := gate4_emit_temporary(context)
	gate4_output_line(
		output,
		"\t" + root_count + " =l add %temporary_roots, " + gate4_integer_string(managed_count),
	)
	gate4_output_line(output, "\tstorel " + root_count + ", $g4_gc_temp_count")
	gate4_output_line(output, "}")
	return
end

def gate4_function_reassigns_parameter(
		state: Gate4Compiler,
		function_index: Integer,
		name: String,
	): Boolean
	mut index := gate4_load_integer(state.function_body_starts, function_index)
	mut depth := 0
	while index < state.token_count[0]
		text := gate4_load_string(state.token_texts, index)
		if text == "if"
			depth += 1
		else
			if text == "while"
				depth += 1
			else
				if text == "end"
					if depth == 0
						return false
					end
					depth -= 1
				else
					if gate4_load_integer(state.token_kinds, index) == 1
						if text == name
							next_token := gate4_load_string(state.token_texts, index + 1)
							if next_token == "="
								return true
							end
							if gate4_compound_operator(next_token) != ""
								return true
							end
						end
					end
				end
			end
		end
		index += 1
	end
	return false
end

def gate4_emit_root_value(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		operand: String,
		type_name: String,
	)
	if gate4_type_is_managed(type_name)
		# Managed results are produced by allocation or by calls whose allocation
		# behavior is intentionally opaque at this boundary.
		context.temporary_roots_used[0] = 2
	end
	return
end

def gate4_note_managed_alias(
		mut context: Gate4EmitContext,
		type_name: String,
	)
	if gate4_type_is_managed(type_name)
		# The owner remains reachable through its caller, allocation, or managed
		# local root until the alias is consumed. Loop compaction transfers an
		# alias retained as a local, so a duplicate temporary root is unnecessary.
		gate4_note_temporary_root(context)
	end
	return
end

def gate4_emit_label(mut context: Gate4EmitContext): String
	index := context.label_count[0]
	context.label_count[0] = index + 1
	return "@l" + gate4_integer_string(index)
end

def gate4_take_inline_budget(mut context: Gate4EmitContext): Boolean
	# Keep lexical-loop capacity independent from the bounded numeric-helper reserve.
	mut budget_index := 0
	if context.loop_depth[0] <= 0
		budget_index = 1
	end
	if context.inline_budget[budget_index] <= 0
		return false
	end
	context.inline_budget[budget_index] = context.inline_budget[budget_index] - 1
	return true
end

def gate4_integer_range_failure_label(mut context: Gate4EmitContext): String
	if context.scalar_inline_depth[0] > 0
		context.scalar_inline_range_failure_used[0] = 1
		return "@scalar_inline_integer_range_failure"
	end
	return gate4_emit_label(context)
end

def gate4_emit_integer_range_failure(mut output: Gate4Output, failure: String)
	if failure == "@scalar_inline_integer_range_failure"
		return
	end
	gate4_output_line(output, failure)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_integer_range_error, l 45)")
	gate4_output_line(output, "\thlt")
	return
end

def gate4_emit_checked_integer_add(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	too_high := gate4_emit_temporary(context)
	too_low := gate4_emit_temporary(context)
	check_low := gate4_emit_label(context)
	failure := gate4_integer_range_failure_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + result + " =l add " + left + ", " + right)
	gate4_output_line(output, "\t" + too_high + " =w csgtl " + result + ", 9007199254740991")
	gate4_output_line(output, "\tjnz " + too_high + ", " + failure + ", " + check_low)
	gate4_output_line(output, check_low)
	gate4_output_line(output, "\t" + too_low + " =w csltl " + result + ", -9007199254740991")
	gate4_output_line(output, "\tjnz " + too_low + ", " + failure + ", " + complete)
	gate4_emit_integer_range_failure(output, failure)
	gate4_output_line(output, complete)
	return
end

def gate4_emit_checked_integer_subtract(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	too_high := gate4_emit_temporary(context)
	too_low := gate4_emit_temporary(context)
	check_low := gate4_emit_label(context)
	failure := gate4_integer_range_failure_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + result + " =l sub " + left + ", " + right)
	gate4_output_line(output, "\t" + too_high + " =w csgtl " + result + ", 9007199254740991")
	gate4_output_line(output, "\tjnz " + too_high + ", " + failure + ", " + check_low)
	gate4_output_line(output, check_low)
	gate4_output_line(output, "\t" + too_low + " =w csltl " + result + ", -9007199254740991")
	gate4_output_line(output, "\tjnz " + too_low + ", " + failure + ", " + complete)
	gate4_emit_integer_range_failure(output, failure)
	gate4_output_line(output, complete)
	return
end

def gate4_emit_checked_integer_multiply(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	if gate4_small_nonnegative_integer_operand(right)
		if gate4_take_inline_budget(context)
			too_high := gate4_emit_temporary(context)
			too_low := gate4_emit_temporary(context)
			check_low := gate4_emit_label(context)
			failure := gate4_integer_range_failure_label(context)
			complete := gate4_emit_label(context)
			gate4_output_line(output, "\t" + result + " =l mul " + left + ", " + right)
			gate4_output_line(output, "\t" + too_high + " =w csgtl " + result + ", 9007199254740991")
			gate4_output_line(output, "\tjnz " + too_high + ", " + failure + ", " + check_low)
			gate4_output_line(output, check_low)
			gate4_output_line(output, "\t" + too_low + " =w csltl " + result + ", -9007199254740991")
			gate4_output_line(output, "\tjnz " + too_low + ", " + failure + ", " + complete)
			gate4_emit_integer_range_failure(output, failure)
			gate4_output_line(output, complete)
			return
		end
	end
	gate4_output_line(
		output,
		"\t" + result + " =l call $g4_integer_multiply(l " + left + ", l " + right + ")",
	)
	return
end

def gate4_emit_checked_integer_divide(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	zero := gate4_emit_temporary(context)
	failure := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + zero + " =w ceql " + right + ", 0")
	gate4_output_line(output, "\tjnz " + zero + ", " + failure + ", " + complete)
	gate4_output_line(output, failure)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_division_error, l 24)")
	gate4_output_line(output, "\thlt")
	gate4_output_line(output, complete)
	gate4_output_line(output, "\t" + result + " =l div " + left + ", " + right)
	return
end

def gate4_emit_checked_integer_remainder(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	zero := gate4_emit_temporary(context)
	failure := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + zero + " =w ceql " + right + ", 0")
	gate4_output_line(output, "\tjnz " + zero + ", " + failure + ", " + complete)
	gate4_output_line(output, failure)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_division_error, l 24)")
	gate4_output_line(output, "\thlt")
	gate4_output_line(output, complete)
	gate4_output_line(output, "\t" + result + " =l rem " + left + ", " + right)
	return
end

def gate4_invalidate_array_header_cache(mut context: Gate4EmitContext)
	context.array_header_cache[0][0] = ""
	context.array_header_cache[1][0] = ""
	return
end

def gate4_loop_finish(state: Gate4Compiler, start: Integer): Integer
	mut index := start + 1
	mut depth := 0
	while index < state.token_count[0]
		if index - start > 256
			return start
		end
		if gate4_token_is(state, index, "if")
			depth += 1
		else
			if gate4_token_is(state, index, "while")
				depth += 1
			else
				if gate4_token_is(state, index, "end")
					if depth == 0
						return index
					end
					depth -= 1
				end
			end
		end
		index += 1
	end
	return start
end

def gate4_loop_calls_preserve_array_headers(
		mut state: Gate4Compiler,
		start: Integer,
		finish: Integer,
	): Boolean
	mut index := start
	while index < finish
		if gate4_token_is(state, index, "(")
			previous := index - 1
			if previous >= start
				if gate4_load_integer(state.token_kinds, previous) == 1
					name := gate4_load_string(state.token_texts, previous)
					mut safe := false
					if previous > start
						if gate4_token_is(state, previous - 1, ".")
							safe = name == "size"
							if name == "sqrt"
								if previous - 2 >= start
									safe = gate4_token_is(state, previous - 2, "Math")
								end
							end
						end
					end
					if !safe
						function_index := gate4_find_visible_function(state, state.active_module[0], name)
						if function_index >= 0
							safe = gate4_scalar_leaf_inline_eligible(state, function_index)
						end
					end
					if !safe
						return false
					end
				end
			end
		end
		index += 1
	end
	return true
end

def gate4_loop_array_header_local(
		mut state: Gate4Compiler,
		context: Gate4EmitContext,
		start: Integer,
	): Integer
	if state.function_count[0] > 32
		return - 1
	end
	if context.local_count[0] > 16
		return - 1
	end
	finish := gate4_loop_finish(state, start)
	if finish <= start
		return - 1
	end
	if !gate4_loop_calls_preserve_array_headers(state, start, finish)
		return - 1
	end
	mut best :=- 1
	mut best_score := 1
	mut local_index := 0
	while local_index < context.local_count[0]
		if gate4_array_element_type(gate4_load_string(context.local_types, local_index)) != ""
			name := gate4_load_string(context.local_names, local_index)
			mut score := 0
			mut stable := true
			mut token_index := start
			while token_index < finish
				if gate4_token_is(state, token_index, name)
					if gate4_token_is(state, token_index + 1, "[")
						score += 2
					else
						if gate4_token_is(state, token_index + 1, ".")
							if gate4_token_is(state, token_index + 2, "size")
								score += 1
							end
						else
							next_token := gate4_load_string(state.token_texts, token_index + 1)
							if next_token == "="
								stable = false
							end
							if gate4_compound_operator(next_token) != ""
								stable = false
							end
						end
					end
				end
				token_index += 1
			end
			if stable
				if score > best_score
					best = local_index
					best_score = score
				end
			end
		end
		local_index += 1
	end
	return best
end

def gate4_emit_loop_array_header_hoist(
		mut state: Gate4Compiler,
		start: Integer,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
	)
	local_index := gate4_loop_array_header_local(state, context, start)
	if local_index < 0
		return
	end
	key := gate4_load_string(context.local_slots, local_index)
	mut array := key
	if gate4_load_integer(context.local_direct, local_index) == 0
		array = gate4_emit_temporary(context)
		gate4_output_line(output, "\t" + array + " =l loadl " + key)
	end
	mut cache := context.array_header_cache[0]
	cache[0] = key
	cache[1] = ""
	cache[2] = ""
	gate4_emit_array_header(context, output, array, key, 1, "8", "", "")
	gate4_emit_array_header(context, output, array, key, 2, "24", "", "")
	return
end

def gate4_emit_array_header(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		array: String,
		key: String,
		cache_index: Integer,
		offset: String,
		address: String,
		value: String,
	): String
	use_cache := key != ""
	mut caches := context.array_header_cache
	mut cache := caches[0]
	if use_cache
		if cache[0] != key
			cache = caches[1]
			if cache[0] != key
				cache[0] = key
				cache[1] = ""
				cache[2] = ""
			end
			mut promote := context.loop_depth[0] <= 0
			if caches[0][0] == ""
				promote = true
			end
			if promote
				previous_cache := caches[0]
				caches[1] = previous_cache
				caches[0] = cache
			end
		end
		cached := cache[cache_index]
		if cached != ""
			return cached
		end
	end
	mut resolved_address := address
	mut resolved_value := value
	if resolved_value == ""
		resolved_address = gate4_emit_temporary(context)
		resolved_value = gate4_emit_temporary(context)
	end
	gate4_output_line(output, "\t" + resolved_address + " =l add " + array + ", " + offset)
	gate4_output_line(output, "\t" + resolved_value + " =l loadl " + resolved_address)
	if use_cache
		cache[cache_index] = resolved_value
	end
	return resolved_value
end

def gate4_emit_array_address(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		array: String,
		array_key: String,
		requested: String,
	): String
	mut use_cache := false
	if array_key != ""
		# Restrict header reuse to loops that own managed locals. Inherited-only
		# loops remain unchanged so call-heavy kernels do not extend temporary live
		# ranges without an owning Array allocation to amortize them.
		if context.loop_depth[0] > 0
			use_cache = gate4_owned_managed_local_count(context) >= 1
		end
		if context.array_header_cache[0][0] == array_key
			use_cache = true
		end
	end
	mut length := ""
	mut length_address := ""
	mut resolved_length := ""
	if use_cache
		resolved_length = gate4_emit_array_header(context, output, array, array_key, 1, "8", "", "")
	else
		length = gate4_emit_temporary(context)
	end
	negative_mask := gate4_emit_temporary(context)
	adjustment := gate4_emit_temporary(context)
	index := gate4_emit_temporary(context)
	valid := gate4_emit_temporary(context)
	mut data_slot := ""
	mut data := ""
	if !use_cache
		data_slot = gate4_emit_temporary(context)
		data = gate4_emit_temporary(context)
	end
	offset := gate4_emit_temporary(context)
	address := gate4_emit_temporary(context)
	load_label := gate4_emit_label(context)
	if !use_cache
		length_address = gate4_emit_temporary(context)
		resolved_length = gate4_emit_array_header(
			context,
			output,
			array,
			"",
			1,
			"8",
			length_address,
			length,
		)
	end
	gate4_output_line(output, "\t" + negative_mask + " =l sar " + requested + ", 63")
	gate4_output_line(output, "\t" + adjustment + " =l and " + resolved_length + ", " + negative_mask)
	gate4_output_line(output, "\t" + index + " =l add " + requested + ", " + adjustment)
	gate4_output_line(output, "\t" + valid + " =w cultl " + index + ", " + resolved_length)
	gate4_output_line(output, "\tjnz " + valid + ", " + load_label + ", @array_bounds_failure")
	context.array_bounds_failure_used[0] = 1
	gate4_output_line(output, load_label)
	mut resolved_data := ""
	if use_cache
		resolved_data = gate4_emit_array_header(context, output, array, array_key, 2, "24", "", "")
	else
		resolved_data = gate4_emit_array_header(
			context,
			output,
			array,
			"",
			2,
			"24",
			data_slot,
			data,
		)
	end
	gate4_output_line(output, "\t" + offset + " =l mul " + index + ", 8")
	gate4_output_line(output, "\t" + address + " =l add " + resolved_data + ", " + offset)
	return address
end

def gate4_emit_add_local(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		name: String,
		type_name: String,
		mutable: Integer,
		initial: String,
		inherited_root: Boolean,
	): String
	index := context.local_count[0]
	slot_index := context.slot_count[0]
	slot := "%v" + gate4_integer_string(slot_index)
	context.slot_count[0] = slot_index + 1
	gate4_store_string(context.local_names, index, name)
	gate4_store_string(context.local_types, index, type_name)
	gate4_store_string(context.local_slots, index, slot)
	gate4_store_integer(context.local_mutable, index, mutable)
	gate4_store_integer(context.local_direct, index, 0)
	mut inherited := 0
	if inherited_root
		inherited = 1
	end
	gate4_store_integer(context.local_inherited, index, inherited)
	context.local_count[0] = index + 1
	if gate4_type_is_managed(type_name)
		if inherited == 0
			# Lexical blocks restore local_count, so retain the maximum active
			# managed-local count separately for the function prologue.
			managed_count := gate4_owned_managed_local_count(context)
			if managed_count > context.managed_local_high_water[0]
				context.managed_local_high_water[0] = managed_count
			end
		end
	end
	gate4_output_line(output, "\t" + gate4_qbe_store(type_name) + " " + initial + ", " + slot)
	return slot
end

def gate4_emit_add_direct_local(
		mut context: Gate4EmitContext,
		name: String,
		type_name: String,
		operand: String,
	)
	index := context.local_count[0]
	gate4_store_string(context.local_names, index, name)
	gate4_store_string(context.local_types, index, type_name)
	gate4_store_string(context.local_slots, index, operand)
	gate4_store_integer(context.local_mutable, index, 0)
	gate4_store_integer(context.local_inherited, index, 1)
	gate4_store_integer(context.local_direct, index, 1)
	context.local_count[0] = index + 1
	return
end

def gate4_emit_loaded_local(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		index: Integer,
	): Gate4EmittedValue
	type_name := gate4_load_string(context.local_types, index)
	if gate4_load_integer(context.local_direct, index) == 1
		mut address := ""
		if gate4_array_element_type(type_name) != ""
			address = gate4_load_string(context.local_slots, index)
		end
		return gate4_emitted_value(
			gate4_load_string(context.local_slots, index),
			type_name,
			0,
			gate4_load_string(context.local_names, index),
			0,
			address,
		)
	end
	operand := gate4_emit_temporary(context)
	gate4_output_line(
		output,
		"\t" + operand + " =" + gate4_qbe_type(type_name) + " " + gate4_qbe_load(type_name) + " " +
		gate4_load_string(context.local_slots, index),
	)
	return gate4_emitted_value(
		operand,
		type_name,
		0,
		gate4_load_string(context.local_names, index),
		gate4_load_integer(context.local_mutable, index),
		gate4_load_string(context.local_slots, index),
	)
end

def gate4_emit_address(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		base: String,
		offset: Integer,
	): String
	if offset == 0
		return base
	end
	address := gate4_emit_temporary(context)
	gate4_output_line(output, "\t" + address + " =l add " + base + ", " + gate4_integer_string(offset))
	return address
end

def gate4_emit_array_literal(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		expected: String,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	contextual_element_type := gate4_array_element_type(expected)
	mut element_type := contextual_element_type
	mut operands: Array<String> := []
	mut value_types: Array<String> := []
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], "]")
			finished = true
		else
			value := gate4_emit_expression(state, position, context, output, 1, contextual_element_type)
			operands.push(value.operand)
			value_types.push(value.type_name)
			if contextual_element_type == ""
				element_type = gate4_common_array_element_type(element_type, value.type_name)
			end
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, "]")
	array := gate4_emit_temporary(context)
	mut descriptor := "$g4_desc_array_scalar"
	if gate4_type_is_managed(element_type)
		descriptor = "$g4_desc_array_managed"
	end
	gate4_output_line(
		output,
		"\t" + array + " =l call $g4_array_new(l " + descriptor + ")",
	)
	gate4_emit_root_value(context, output, array, gate4_array_type(element_type))
	mut index := 0
	while index < operands.size()
		mut operand := operands[index]
		if element_type == "Float"
			if value_types[index] == "Integer"
				converted := gate4_emit_temporary(context)
				gate4_output_line(output, "\t" + converted + " =d sltof " + operand)
				operand = converted
			end
		end
		gate4_emit_array_push(context, output, array, element_type, operand)
		index += 1
	end
	return gate4_emitted_value(array, gate4_array_type(element_type), 0, "", 1, "")
end

def gate4_inline_scalar_type(type_name: String): Boolean
	if type_name == "Integer"
		return true
	end
	if type_name == "Float"
		return true
	end
	return type_name == "Boolean"
end

def gate4_inline_statement_end(state: Gate4Compiler, start: Integer, finish: Integer): Integer
	mut index := start
	mut depth := 0
	while index < finish
		kind := gate4_load_integer(state.token_kinds, index)
		if kind == 4
			if depth == 0
				return index
			end
		else
			if gate4_token_is(state, index, "(")
				depth += 1
			else
				if gate4_token_is(state, index, ")")
					depth -= 1
				end
			end
		end
		index += 1
	end
	return finish
end

def gate4_inline_scalar_expression_allowed(
		state: Gate4Compiler,
		start: Integer,
		finish: Integer,
	): Boolean
	mut index := start
	mut depth := 0
	mut found := false
	while index < finish
		kind := gate4_load_integer(state.token_kinds, index)
		text := gate4_load_string(state.token_texts, index)
		if kind == 4
			if depth <= 0
				return false
			end
		else
			if kind == 1
				if index + 1 < finish
					if gate4_token_is(state, index + 1, "(")
						return false
					end
				end
			else
				if kind != 2
					mut allowed := gate4_binary_precedence(text) > 0
					if text == "!"
						allowed = true
					end
					if text == "("
						allowed = true
						depth += 1
					end
					if text == ")"
						if depth <= 0
							return false
						end
						allowed = true
						depth -= 1
					end
					if !allowed
						return false
					end
				end
			end
			found = true
		end
		index += 1
	end
	if depth != 0
		return false
	end
	return found
end

def gate4_inline_skip_newlines(state: Gate4Compiler, start: Integer, finish: Integer): Integer
	mut index := start
	while index < finish
		if gate4_load_integer(state.token_kinds, index) != 4
			return index
		end
		index += 1
	end
	return index
end

def gate4_scalar_leaf_inline_eligible(state: Gate4Compiler, function_index: Integer): Boolean
	if !gate4_inline_scalar_type(gate4_load_string(state.function_result_types, function_index))
		return false
	end
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		if gate4_load_integer(state.parameter_mutable, parameter_index) != 0
			return false
		end
		if !gate4_inline_scalar_type(gate4_load_string(state.parameter_types, parameter_index))
			return false
		end
		parameter_index += 1
	end
	mut index := gate4_load_integer(state.function_body_starts, function_index)
	finish := gate4_load_integer(state.function_body_ends, function_index)
	while index < finish
		index = gate4_inline_skip_newlines(state, index, finish)
		if index >= finish
			return false
		end
		if gate4_token_is(state, index, "return")
			expression_start := index + 1
			statement_end := gate4_inline_statement_end(state, expression_start, finish)
			if !gate4_inline_scalar_expression_allowed(state, expression_start, statement_end)
				return false
			end
			index = statement_end
			index = gate4_inline_skip_newlines(state, index, finish)
			return index == finish
		end
		if gate4_load_integer(state.token_kinds, index) != 1
			return false
		end
		if index + 1 >= finish
			return false
		end
		if !gate4_token_is(state, index + 1, ":=")
			return false
		end
		expression_start := index + 2
		statement_end := gate4_inline_statement_end(state, expression_start, finish)
		if !gate4_inline_scalar_expression_allowed(state, expression_start, statement_end)
			return false
		end
		index = statement_end
	end
	return false
end

def gate4_emit_scalar_leaf_inline(
		mut state: Gate4Compiler,
		function_index: Integer,
		argument_operands: Array<String>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
	): Gate4EmittedValue
	saved_module := state.active_module[0]
	saved_local_count := context.local_count[0]
	saved_inline_depth := context.scalar_inline_depth[0]
	context.scalar_inline_depth[0] = saved_inline_depth + 1
	state.active_module[0] = gate4_load_integer(state.function_modules, function_index)
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_count := gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := 0
	while parameter_index < parameter_count
		declaration_index := parameter_start + parameter_index
		gate4_emit_add_direct_local(
			context,
			gate4_load_string(state.parameter_names, declaration_index),
			gate4_load_string(state.parameter_types, declaration_index),
			argument_operands[parameter_index],
		)
		parameter_index += 1
	end
	mut position := [gate4_load_integer(state.function_body_starts, function_index)]
	gate4_skip_newlines(state, position)
	result_type := gate4_load_string(state.function_result_types, function_index)
	mut result := gate4_emitted_value("", "Invalid", 0, "", 0, "")
	mut complete := false
	while !complete
		if gate4_token_is(state, position[0], "return")
			gate4_advance(position)
			result = gate4_emit_expression(state, position, context, output, 1, result_type)
			gate4_finish_statement(state, position)
			complete = true
		else
			name := gate4_expect_identifier(state, position)
			gate4_expect(state, position, ":=")
			value := gate4_emit_expression(state, position, context, output, 1, "")
			gate4_emit_add_direct_local(context, name, value.type_name, value.operand)
			gate4_finish_statement(state, position)
		end
	end
	context.local_count[0] = saved_local_count
	context.scalar_inline_depth[0] = saved_inline_depth
	state.active_module[0] = saved_module
	return result
end

def gate4_emit_scalar_leaf_direct_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		function_index: Integer,
		parameter_start: Integer,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
	): Gate4EmittedValue
	mut argument_operands: Array<String> := []
	mut argument_count := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			expected := gate4_load_string(state.parameter_types, parameter_start + argument_count)
			value := gate4_emit_expression(state, position, context, output, 1, expected)
			argument_operands.push(value.operand)
			argument_count += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	return gate4_emit_scalar_leaf_inline(
		state,
		function_index,
		argument_operands,
		context,
		output,
	)
end

def gate4_emit_direct_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		callee: Gate4EmittedValue,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	function_index := gate4_find_visible_function(state, state.active_module[0], callee.name)
	mut parameter_start := 0
	mut result_type := "Void"
	if callee.category == 4
		result_type = "Array<String>"
	else
		if callee.category == 5
			result_type = "Float"
		end
	end
	if function_index >= 0
		parameter_start = gate4_load_integer(state.function_parameter_starts, function_index)
		result_type = gate4_load_string(state.function_result_types, function_index)
	end
	if function_index >= 0
		if state.function_count[0] <= 32
			if gate4_scalar_leaf_inline_eligible(state, function_index)
				if context.loop_depth[0] > 0
					if context.inline_budget[2] > 0
						context.inline_budget[2] = context.inline_budget[2] - 1
						return gate4_emit_scalar_leaf_direct_call(
							state,
							position,
							function_index,
							parameter_start,
							context,
							output,
						)
					end
				end
			end
		end
	end
	mut arguments := ""
	mut argument_count := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			mut expected := "String"
			if callee.category == 5
				expected = "Float"
			end
			if function_index >= 0
				expected = gate4_load_string(state.parameter_types, parameter_start + argument_count)
			end
			value := gate4_emit_expression(state, position, context, output, 1, expected)
			if arguments != ""
				arguments += ", "
			end
			arguments += gate4_qbe_type(value.type_name) + " " + value.operand
			argument_count += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	if callee.category != 5
		# An opaque call may mutate an aliased Array header. Arguments have already
		# consumed any cached header values needed before this invalidation point.
		gate4_invalidate_array_header_cache(context)
	end
	if callee.category == 4
		output.runtime_flags[1] = 1
		result := gate4_emit_temporary(context)
		gate4_output_line(output, "\t" + result + " =l call $g4_process_argv()")
		gate4_emit_root_value(context, output, result, result_type)
		return gate4_emitted_value(result, result_type, 0, "", 1, "")
	end
	if callee.category == 5
		result := gate4_emit_temporary(context)
		gate4_output_line(output, "\t" + result + " =d call $sqrt(" + arguments + ")")
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if gate4_compiler_entry_function(state) >= 0
		if callee.name == "gate4_file_exists"
			result := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + result + " =l call $g4_file_exists(" + arguments + ")")
			return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
		end
		if callee.name == "gate4_read_source"
			result := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + result + " =l call $g4_read_source(" + arguments + ")")
			gate4_emit_root_value(context, output, result, "String")
			return gate4_emitted_value(result, "String", 0, "", 0, "")
		end
		if callee.name == "gate4_source_slice"
			result := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + result + " =l call $g4_source_slice(" + arguments + ")")
			gate4_emit_root_value(context, output, result, "String")
			return gate4_emitted_value(result, "String", 0, "", 0, "")
		end
		if callee.name == "gate4_collect_project_sources"
			result := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + result + " =l call $g4_collect_project_sources(" + arguments + ")")
			gate4_emit_root_value(context, output, result, result_type)
			return gate4_emitted_value(result, result_type, 0, "", 0, "")
		end
	end
	if callee.name == "puts"
		gate4_output_line(output, "\tcall $g4_puts(" + arguments + ")")
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	if callee.name == "gate4_eputs"
		gate4_output_line(output, "\tcall $g4_eputs(" + arguments + ")")
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	if callee.name == "gate4_reset_temporary_storage"
		gate4_output_line(output, "\tcall $g4_temp_reset()")
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	if context.inline_budget[2] >= 0
		if gate4_scalar_leaf_inline_eligible(state, function_index)
			context.inline_budget[2] =- 1
		end
	end
	# Until interprocedural no-allocation summaries exist, every ordinary
	# TypeRB call remains a conservative GC safe point.
	gate4_note_gc_safe_point(context)
	if result_type == "Void"
		gate4_output_line(
			output,
			"\tcall $g4f" + gate4_integer_string(function_index) + "(" + arguments + ")",
		)
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	result := gate4_emit_temporary(context)
	gate4_output_line(
		output,
		"\t" + result + " =" + gate4_qbe_type(result_type) + " call $g4f" +
		gate4_integer_string(function_index) + "(" + arguments + ")",
	)
	gate4_emit_root_value(context, output, result, result_type)
	return gate4_emitted_value(result, result_type, 0, "", 0, "")
end

def gate4_emit_record_new(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		record_name: String,
	): Gate4EmittedValue
	record_index := gate4_find_visible_record(state, state.active_module[0], record_name)
	field_start := gate4_load_integer(state.record_field_starts, record_index)
	field_count := gate4_load_integer(state.record_field_counts, record_index)
	record_value := gate4_emit_temporary(context)
	gate4_output_line(
		output,
		"\t" + record_value + " =l call $g4_gc_alloc(l $g4_desc_record" +
		gate4_integer_string(record_index) + ", l " + gate4_integer_string(field_count * 8) + ", l 0)",
	)
	gate4_emit_root_value(context, output, record_value, gate4_record_type(record_index))
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	mut field_offset := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			gate4_expect_identifier(state, position)
			gate4_expect(state, position, ":")
			value := gate4_emit_expression(
				state,
				position,
				context,
				output,
				1,
				gate4_load_string(state.field_types, field_start + field_offset),
			)
			address := gate4_emit_address(context, output, record_value, 8 + field_offset * 8)
			field_type := gate4_load_string(state.field_types, field_start + field_offset)
			gate4_output_line(output, "\t" + gate4_qbe_store(field_type) + " " + value.operand + ", " + address)
			field_offset += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	return gate4_emitted_value(record_value, gate4_record_type(record_index), 0, "", 1, "")
end

def gate4_emit_method_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		receiver: Gate4EmittedValue,
		method: String,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	if method == "size"
		gate4_expect(state, position, ")")
		mut key := ""
		if gate4_array_element_type(receiver.type_name) != ""
			if receiver.address != ""
				if context.loop_depth[0] > 0
					if gate4_owned_managed_local_count(context) >= 1
						key = receiver.address
					end
				end
				if context.array_header_cache[0][0] == receiver.address
					key = receiver.address
				end
			end
		end
		result := gate4_emit_array_header(context, output, receiver.operand, key, 1, "8", "", "")
		return gate4_emitted_value(result, "Integer", 0, "", 0, "")
	end
	if method == "push"
		element_type := gate4_array_element_type(receiver.type_name)
		value := gate4_emit_expression(state, position, context, output, 1, element_type)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		gate4_emit_array_push(context, output, receiver.operand, element_type, value.operand)
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	if method == "to_i"
		gate4_expect(state, position, ")")
		result := gate4_emit_temporary(context)
		output.runtime_flags[1] = 1
		mut conversion := "$g4_float_to_integer(d "
		if receiver.type_name == "String"
			conversion = "$g4_string_to_integer(l "
		end
		gate4_output_line(output, "\t" + result + " =l call " + conversion + receiver.operand + ")")
		return gate4_emitted_value(result, "Integer", 0, "", 0, "")
	end
	if method == "to_s"
		gate4_expect(state, position, ")")
		output.runtime_flags[1] = 1
		result := gate4_emit_temporary(context)
		gate4_output_line(
			output,
			"\t" + result + " =l call $g4_integer_to_string(l " + receiver.operand + ")",
		)
		gate4_emit_root_value(context, output, result, "String")
		return gate4_emitted_value(result, "String", 0, "", 0, "")
	end
	return gate4_emitted_value("", "Invalid", 0, "", 0, "")
end

def gate4_emit_postfix(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		initial: Gate4EmittedValue,
	): Gate4EmittedValue
	mut value := gate4_emitted_value(
		initial.operand,
		initial.type_name,
		initial.category,
		initial.name,
		initial.mutable,
		initial.address,
	)
	mut scanning := true
	while scanning
		if gate4_token_is(state, position[0], "(")
			value = gate4_emit_direct_call(state, position, context, output, value)
		else
			if gate4_token_is(state, position[0], ".")
				gate4_advance(position)
				member := gate4_expect_identifier(state, position)
				if gate4_token_is(state, position[0], "(")
					if value.category < 4
						if value.category == 2
							value = gate4_emit_record_new(state, position, context, output, value.name)
						else
							value = gate4_emit_method_call(state, position, context, output, value, member)
						end
					end
				else
					record_index := gate4_find_record_type(state, value.type_name)
					field_index := gate4_find_field(state, record_index, member)
					offset := 8 + (field_index - gate4_load_integer(state.record_field_starts, record_index)) * 8
					address := gate4_emit_address(context, output, value.operand, offset)
					operand := gate4_emit_temporary(context)
					field_type := gate4_load_string(state.field_types, field_index)
					gate4_output_line(
						output,
						"\t" + operand + " =" + gate4_qbe_type(field_type) + " " + gate4_qbe_load(field_type) + " " + address,
					)
					gate4_note_managed_alias(context, field_type)
					value = gate4_emitted_value(
						operand,
						field_type,
						0,
						member,
						value.mutable,
						address,
					)
				end
			else
				if gate4_token_is(state, position[0], "[")
					gate4_advance(position)
					index := gate4_emit_expression(state, position, context, output, 1, "Integer")
					gate4_expect(state, position, "]")
					if value.type_name == "String"
						result := gate4_emit_temporary(context)
						gate4_output_line(
							output,
							"\t" + result + " =l call $g4_string_index(l " + value.operand + ", l " + index.operand + ")",
						)
						gate4_emit_root_value(context, output, result, "String")
						value = gate4_emitted_value(result, "String", 0, "", 0, "")
					else
						mut address := ""
						mut inline_address := false
						if context.loop_depth[0] > 0
							if gate4_take_inline_budget(context)
								inline_address = true
							end
						end
						if inline_address
							address = gate4_emit_array_address(
								context,
								output,
								value.operand,
								value.address,
								index.operand,
							)
						else
							output.runtime_flags[3] = 1
							address = gate4_emit_temporary(context)
							gate4_output_line(
								output,
								"\t" + address + " =l call $g4_array_address(l " + value.operand + ", l " + index.operand + ")",
							)
						end
						element_type := gate4_array_element_type(value.type_name)
						operand := gate4_emit_temporary(context)
						gate4_output_line(
							output,
							"\t" + operand + " =" + gate4_qbe_type(element_type) + " " +
							gate4_qbe_load(element_type) + " " + address,
						)
						gate4_note_managed_alias(context, element_type)
						value = gate4_emitted_value(
							operand,
							element_type,
							0,
							"",
							value.mutable,
							address,
						)
					end
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def gate4_emit_primary(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		expected: String,
	): Gate4EmittedValue
	token_index := position[0]
	kind := gate4_load_integer(state.token_kinds, token_index)
	if kind == 2
		value := gate4_number_without_underscores(gate4_load_string(state.token_texts, token_index))
		gate4_advance(position)
		if gate4_number_is_float(value)
			return gate4_emitted_value("d_" + value, "Float", 0, "", 0, "")
		end
		return gate4_emitted_value(value, "Integer", 0, "", 0, "")
	end
	if kind == 3
		gate4_advance(position)
		canonical := gate4_load_integer(state.token_lines, token_index)
		return gate4_emitted_value("$g4s" + gate4_integer_string(canonical), "String", 0, "", 0, "")
	end
	if gate4_token_is(state, token_index, "[")
		return gate4_emit_array_literal(state, position, context, output, expected)
	end
	if gate4_token_is(state, token_index, "(")
		gate4_advance(position)
		gate4_skip_newlines(state, position)
		value := gate4_emit_expression(state, position, context, output, 1, expected)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		return value
	end
	if gate4_token_is(state, token_index, "!")
		gate4_advance(position)
		value := gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, "Boolean"),
		)
		comparison := gate4_emit_temporary(context)
		result := gate4_emit_temporary(context)
		gate4_output_line(output, "\t" + comparison + " =w ceql " + value.operand + ", 0")
		gate4_output_line(output, "\t" + result + " =l extuw " + comparison)
		return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
	end
	if gate4_token_is(state, token_index, "-")
		gate4_advance(position)
		value := gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, ""),
		)
		result := gate4_emit_temporary(context)
		if value.type_name == "Float"
			gate4_output_line(output, "\t" + result + " =d sub d_-0.0, " + value.operand)
			return gate4_emitted_value(result, "Float", 0, "", 0, "")
		end
		gate4_output_line(output, "\t" + result + " =l call $g4_integer_subtract(l 0, l " + value.operand + ")")
		return gate4_emitted_value(result, "Integer", 0, "", 0, "")
	end
	if gate4_token_is(state, token_index, "+")
		gate4_advance(position)
		return gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, ""),
		)
	end
	if kind == 1
		name := gate4_load_string(state.token_texts, token_index)
		gate4_advance(position)
		if name == "true"
			return gate4_emitted_value("1", "Boolean", 0, "", 0, "")
		end
		if name == "false"
			return gate4_emitted_value("0", "Boolean", 0, "", 0, "")
		end
		mut local_index := context.local_count[0] - 1
		mut found_local :=- 1
		while local_index >= 0
			if gate4_load_string(context.local_names, local_index) == name
				found_local = local_index
				local_index =- 1
			else
				local_index -= 1
			end
		end
		if found_local >= 0
			return gate4_emit_loaded_local(context, output, found_local)
		end
		standard_package := gate4_standard_package_import(state, state.active_module[0], name)
		if standard_package < - 1
			return gate4_emitted_value("", gate4_standard_package_root(standard_package), 2 - standard_package, name, 0, "")
		end
		if name == "puts"
			return gate4_emitted_value("", "", 1, name, 0, "")
		end
		if gate4_find_visible_function(state, state.active_module[0], name) >= 0
			return gate4_emitted_value("", "", 1, name, 0, "")
		end
		if gate4_find_visible_record(state, state.active_module[0], name) >= 0
			return gate4_emitted_value("", "", 2, name, 0, "")
		end
	end
	return gate4_emitted_value("", "Invalid", 0, "", 0, "")
end

def gate4_emit_binary(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		operator: String,
		left: Gate4EmittedValue,
		right: Gate4EmittedValue,
	): Gate4EmittedValue
	result_type := gate4_binary_result_type_name(operator, left.type_name, right.type_name)
	result := gate4_emit_temporary(context)
	mut left_operand := left.operand
	mut right_operand := right.operand
	mut float_operands := false
	if left.type_name == "Float"
		float_operands = true
	end
	if right.type_name == "Float"
		float_operands = true
	end
	if float_operands
		if left.type_name == "Integer"
			converted_left := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + converted_left + " =d sltof " + left_operand)
			left_operand = converted_left
		end
		if right.type_name == "Integer"
			converted_right := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + converted_right + " =d sltof " + right_operand)
			right_operand = converted_right
		end
	end
	if operator == "+"
		if left.type_name == "String"
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_string_concat(l " + left.operand + ", l " + right.operand + ")",
			)
			gate4_emit_root_value(context, output, result, "String")
		else
			if result_type == "Float"
				gate4_output_line(output, "\t" + result + " =d add " + left_operand + ", " + right_operand)
				return gate4_emitted_value(result, result_type, 0, "", 0, "")
			end
			if gate4_take_inline_budget(context)
				gate4_emit_checked_integer_add(context, output, result, left.operand, right.operand)
			else
				gate4_output_line(
					output,
					"\t" + result + " =l call $g4_integer_add(l " + left.operand + ", l " + right.operand + ")",
				)
			end
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "-"
		if result_type == "Float"
			gate4_output_line(output, "\t" + result + " =d sub " + left_operand + ", " + right_operand)
			return gate4_emitted_value(result, result_type, 0, "", 0, "")
		end
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_subtract(context, output, result, left.operand, right.operand)
		else
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_integer_subtract(l " + left.operand + ", l " + right.operand + ")",
			)
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "*"
		if result_type == "Float"
			gate4_output_line(output, "\t" + result + " =d mul " + left_operand + ", " + right_operand)
			return gate4_emitted_value(result, result_type, 0, "", 0, "")
		end
		gate4_emit_checked_integer_multiply(context, output, result, left.operand, right.operand)
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "/"
		if result_type == "Float"
			gate4_output_line(output, "\t" + result + " =d div " + left_operand + ", " + right_operand)
			return gate4_emitted_value(result, result_type, 0, "", 0, "")
		end
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_divide(context, output, result, left.operand, right.operand)
		else
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_integer_divide(l " + left.operand + ", l " + right.operand + ")",
			)
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "%"
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_remainder(context, output, result, left.operand, right.operand)
		else
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_integer_remainder(l " + left.operand + ", l " + right.operand + ")",
			)
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if left.type_name == "String"
		mut compare_strings := operator == "=="
		if operator == "!="
			compare_strings = true
		end
		if compare_strings
			mut equality := result
			if operator == "!="
				equality = gate4_emit_temporary(context)
			end
			gate4_output_line(
				output,
				"\t" + equality + " =l call $g4_string_equal(l " + left.operand + ", l " + right.operand + ")",
			)
			if operator == "!="
				word := gate4_emit_temporary(context)
				gate4_output_line(output, "\t" + word + " =w ceql " + equality + ", 0")
				gate4_output_line(output, "\t" + result + " =l extuw " + word)
			end
			return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
		end
	end
	mut comparison := "ceql"
	if float_operands
		comparison = "ceqd"
	end
	if operator == "!="
		if float_operands
			comparison = "cned"
		else
			comparison = "cnel"
		end
	end
	if operator == "<"
		if float_operands
			comparison = "cltd"
		else
			comparison = "csltl"
		end
	end
	if operator == "<="
		if float_operands
			comparison = "cled"
		else
			comparison = "cslel"
		end
	end
	if operator == ">"
		if float_operands
			comparison = "cgtd"
		else
			comparison = "csgtl"
		end
	end
	if operator == ">="
		if float_operands
			comparison = "cged"
		else
			comparison = "csgel"
		end
	end
	word := gate4_emit_temporary(context)
	gate4_output_line(
		output,
		"\t" + word + " =w " + comparison + " " + left_operand + ", " + right_operand,
	)
	gate4_output_line(output, "\t" + result + " =l extuw " + word)
	return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
end

def gate4_binary_result_type_name(operator: String, left: String, right: String): String
	if gate4_binary_precedence(operator) == 1
		return "Boolean"
	end
	if left == "Float"
		return "Float"
	end
	if right == "Float"
		return "Float"
	end
	return left
end

def gate4_emit_expression(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		minimum_precedence: Integer,
		expected: String,
	): Gate4EmittedValue
	mut value := gate4_emit_postfix(
		state,
		position,
		context,
		output,
		gate4_emit_primary(state, position, context, output, expected),
	)
	mut scanning := true
	while scanning
		operator := gate4_load_string(state.token_texts, position[0])
		precedence := gate4_binary_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			right := gate4_emit_expression(
				state,
				position,
				context,
				output,
				precedence + 1,
				"",
			)
			value = gate4_emit_binary(context, output, operator, value, right)
		end
	end
	if expected == "Float"
		if value.type_name == "Integer"
			converted := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + converted + " =d sltof " + value.operand)
			return gate4_emitted_value(
				converted,
				"Float",
				value.category,
				value.name,
				value.mutable,
				value.address,
			)
		end
	end
	return value
end

def gate4_emit_declaration(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
	): Boolean
	mut mutable := 0
	if gate4_token_is(state, position[0], "mut")
		mutable = 1
		gate4_advance(position)
	end
	name := gate4_expect_identifier(state, position)
	mut declared_type := ""
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		declared_type = gate4_parse_type(state, position)
		declared_type = gate4_resolve_type_name(state, state.active_module[0], declared_type, false)
	end
	gate4_expect(state, position, ":=")
	value := gate4_emit_expression(state, position, context, output, 1, declared_type)
	mut local_type := declared_type
	if local_type == ""
		local_type = value.type_name
	end
	gate4_emit_add_local(context, output, name, local_type, mutable, value.operand, false)
	return gate4_finish_statement(state, position)
end

def gate4_emit_simple_statement(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
	): Boolean
	left := gate4_emit_expression(state, position, context, output, 1, "")
	operator := gate4_load_string(state.token_texts, position[0])
	if operator == "="
		gate4_advance(position)
		right := gate4_emit_expression(state, position, context, output, 1, left.type_name)
		gate4_output_line(output, "\t" + gate4_qbe_store(left.type_name) + " " + right.operand + ", " + left.address)
	else
		compound := gate4_compound_operator(operator)
		if compound != ""
			gate4_advance(position)
			right := gate4_emit_expression(state, position, context, output, 1, left.type_name)
			result := gate4_emit_binary(context, output, compound, left, right)
			gate4_output_line(output, "\t" + gate4_qbe_store(left.type_name) + " " + result.operand + ", " + left.address)
		end
	end
	if gate4_array_element_type(left.type_name) != ""
		# Rebinding an Array local or field invalidates the header associated with
		# its stable source address. Element writes have scalar or managed element
		# types and keep the Array header itself unchanged.
		gate4_invalidate_array_header_cache(context)
	end
	return gate4_finish_statement(state, position)
end

def gate4_emit_condition(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		operand: String,
	): String
	condition := gate4_emit_temporary(context)
	gate4_output_line(output, "\t" + condition + " =w cnel " + operand + ", 0")
	return condition
end

def gate4_emit_block(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result_type: String,
	): Integer
	gate4_skip_newlines(state, position)
	mut complete := false
	mut terminated := 0
	while !complete
		if gate4_token_is(state, position[0], "end")
			complete = true
		else
			if gate4_token_is(state, position[0], "else")
				complete = true
			else
				if gate4_token_is(state, position[0], "if")
					gate4_advance(position)
					condition_value := gate4_emit_expression(state, position, context, output, 1, "Boolean")
					gate4_finish_statement(state, position)
					condition := gate4_emit_condition(context, output, condition_value.operand)
					when_true := gate4_emit_label(context)
					when_false := gate4_emit_label(context)
					join := gate4_emit_label(context)
					gate4_emit_temporary_root_reset(context, output)
					gate4_invalidate_array_header_cache(context)
					gate4_output_line(output, "\tjnz " + condition + ", " + when_true + ", " + when_false)
					gate4_output_line(output, when_true)
					saved_count := context.local_count[0]
					true_terminated := gate4_emit_block(state, position, context, output, result_type)
					context.local_count[0] = saved_count
					if true_terminated == 0
						gate4_emit_temporary_root_reset(context, output)
						gate4_output_line(output, "\tjmp " + join)
					end
					gate4_invalidate_array_header_cache(context)
					gate4_output_line(output, when_false)
					mut false_terminated := 0
					if gate4_token_is(state, position[0], "else")
						gate4_advance(position)
						gate4_finish_statement(state, position)
						false_terminated = gate4_emit_block(state, position, context, output, result_type)
						context.local_count[0] = saved_count
					end
					if false_terminated == 0
						gate4_emit_temporary_root_reset(context, output)
						gate4_output_line(output, "\tjmp " + join)
					end
					gate4_expect(state, position, "end")
					gate4_finish_statement(state, position)
					if true_terminated == 1
						if false_terminated == 1
							terminated = 1
						else
							gate4_output_line(output, join)
						end
					else
						gate4_output_line(output, join)
					end
					gate4_invalidate_array_header_cache(context)
				else
					if gate4_token_is(state, position[0], "while")
						header := gate4_emit_label(context)
						body := gate4_emit_label(context)
						done := gate4_emit_label(context)
						gate4_invalidate_array_header_cache(context)
						gate4_emit_loop_array_header_hoist(state, position[0], context, output)
						gate4_output_line(output, "\tjmp " + header)
						gate4_output_line(output, header)
						gate4_emit_loop_root_compaction(context, output)
						gate4_advance(position)
						context.loop_depth[0] = context.loop_depth[0] + 1
						condition_value := gate4_emit_expression(state, position, context, output, 1, "Boolean")
						gate4_finish_statement(state, position)
						condition := gate4_emit_condition(context, output, condition_value.operand)
						gate4_emit_temporary_root_reset(context, output)
						gate4_output_line(output, "\tjnz " + condition + ", " + body + ", " + done)
						gate4_output_line(output, body)
						saved_count := context.local_count[0]
						body_terminated := gate4_emit_block(state, position, context, output, result_type)
						context.local_count[0] = saved_count
						if body_terminated == 0
							gate4_emit_temporary_root_reset(context, output)
							gate4_output_line(output, "\tjmp " + header)
						end
						gate4_expect(state, position, "end")
						gate4_finish_statement(state, position)
						gate4_output_line(output, done)
						gate4_invalidate_array_header_cache(context)
						context.loop_depth[0] = context.loop_depth[0] - 1
					else
						if gate4_token_is(state, position[0], "return")
							gate4_advance(position)
							if gate4_load_integer(state.token_kinds, position[0]) == 4
								gate4_output_line(output, "\tjmp @return")
							else
								value := gate4_emit_expression(state, position, context, output, 1, result_type)
								gate4_output_line(
									output,
									"\t" + gate4_qbe_store(result_type) + " " + value.operand + ", %return_value",
								)
								gate4_output_line(output, "\tjmp @return")
							end
							gate4_finish_statement(state, position)
							terminated = 1
						else
							mut declaration := false
							if gate4_token_is(state, position[0], "mut")
								declaration = true
							else
								if gate4_load_integer(state.token_kinds, position[0]) == 1
									if gate4_token_is(state, position[0] + 1, ":=")
										declaration = true
									else
										if gate4_token_is(state, position[0] + 1, ":")
											declaration = true
										end
									end
								end
							end
							if declaration
								gate4_emit_declaration(state, position, context, output)
							else
								gate4_emit_simple_statement(state, position, context, output)
							end
						end
					end
				end
			end
		end
		if terminated == 1
			while !complete
				if gate4_token_is(state, position[0], "end")
					complete = true
				else
					if gate4_token_is(state, position[0], "else")
						complete = true
					else
						gate4_parse_simple_statement_syntax(state, position)
					end
				end
			end
		end
	end
	return terminated
end

def gate4_emit_function(
		mut state: Gate4Compiler,
		function_index: Integer,
		mut output: Gate4Output,
		inline_budget: Array<Integer>,
	)
	state.active_module[0] = gate4_load_integer(state.function_modules, function_index)
	mut context := gate4_emit_context_new(state.token_count[0] + 1, inline_budget)
	mut body := gate4_output_new(state.token_count[0] * 8 + 1024, output.runtime_flags)
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_count := gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameters := ""
	mut parameter_index := 0
	while parameter_index < parameter_count
		if parameters != ""
			parameters += ", "
		end
		parameter_type := gate4_load_string(state.parameter_types, parameter_start + parameter_index)
		parameters += gate4_qbe_type(parameter_type) + " %p" + gate4_integer_string(parameter_index)
		parameter_index += 1
	end
	mut result_prefix := ""
	result_type := gate4_load_string(state.function_result_types, function_index)
	if result_type != "Void"
		result_prefix = gate4_qbe_type(result_type) + " "
	end
	parameter_index = 0
	while parameter_index < parameter_count
		declaration_index := parameter_start + parameter_index
		parameter_name := gate4_load_string(state.parameter_names, declaration_index)
		gate4_emit_add_local(
			context,
			body,
			parameter_name,
			gate4_load_string(state.parameter_types, declaration_index),
			gate4_load_integer(state.parameter_mutable, declaration_index),
			"%p" + gate4_integer_string(parameter_index),
			!gate4_function_reassigns_parameter(state, function_index, parameter_name),
		)
		parameter_index += 1
	end
	mut position := [gate4_load_integer(state.function_body_starts, function_index)]
	terminated := gate4_emit_block(
		state,
		position,
		context,
		body,
		gate4_load_string(state.function_result_types, function_index),
	)
	if terminated == 0
		if gate4_load_string(state.function_result_types, function_index) == "Void"
			gate4_output_line(body, "\tjmp @return")
		else
			gate4_output_line(body, "\tcall $g4_fail(l $g4_integer_error, l 32)")
			gate4_output_line(body, "\thlt")
		end
	end
	gate4_output_line(
		output,
		"function " + result_prefix + "$g4f" + gate4_integer_string(function_index) + "(" + parameters + ") {",
	)
	gate4_output_line(output, "@start")
	# State 2 combines a managed temporary with a following collection safe
	# point. Either condition alone does not require publishing the frame.
	uses_temporary_roots := context.temporary_roots_used[0] == 2
	managed_local_count := context.managed_local_high_water[0]
	if uses_temporary_roots
		gate4_output_line(output, "\t%temporary_roots =l loadl $g4_gc_temp_count")
	end
	if result_type != "Void"
		gate4_output_line(output, "\t%return_value =l alloc8 8")
	end
	# QBE allocates dynamically when an alloc instruction executes, so lexical
	# local slots must precede every branch and loop in the function body.
	mut slot_index := 0
	while slot_index < context.slot_count[0]
		gate4_output_line(
			output,
			"\t%v" + gate4_integer_string(slot_index) + " =l alloc8 8",
		)
		slot_index += 1
	end
	if uses_temporary_roots
		if managed_local_count > 0
			gate4_output_line(
				output,
				"\t%root_capacity =l add %temporary_roots, " + gate4_integer_string(managed_local_count),
			)
			gate4_output_line(output, "\tcall $g4_gc_temp_reserve(l %root_capacity)")
		end
	end
	mut body_index := 0
	mut inside_root_publication := false
	while body_index < body.count[0]
		line := gate4_load_string(body.lines, body_index)
		if line == "{"
			inside_root_publication = true
		else
			if line == "}"
				inside_root_publication = false
			else
				if uses_temporary_roots
					if line == "\tcall $g4_gc_temp_reset(l %temporary_roots)"
						gate4_output_line(output, "\tstorel %temporary_roots, $g4_gc_temp_count")
					else
						gate4_output_line(output, line)
					end
				else
					if !inside_root_publication
						if line != "\tcall $g4_gc_temp_reset(l %temporary_roots)"
							gate4_output_line(output, line)
						end
					end
				end
			end
		end
		body_index += 1
	end
	if context.array_bounds_failure_used[0] == 1
		gate4_output_line(output, "@array_bounds_failure")
		gate4_output_line(output, "\tcall $g4_fail(l $g4_bounds_error, l 30)")
		gate4_output_line(output, "\thlt")
	end
	if context.scalar_inline_range_failure_used[0] == 1
		gate4_output_line(output, "@scalar_inline_integer_range_failure")
		gate4_output_line(output, "\tcall $g4_fail(l $g4_integer_range_error, l 45)")
		gate4_output_line(output, "\thlt")
	end
	gate4_output_line(output, "@return")
	if uses_temporary_roots
		gate4_output_line(output, "\tstorel %temporary_roots, $g4_gc_temp_count")
	end
	if result_type == "Void"
		gate4_output_line(output, "\tret")
	else
		gate4_output_line(
			output,
			"\t%return_result =" + gate4_qbe_type(result_type) + " " +
			gate4_qbe_load(result_type) + " %return_value",
		)
		if gate4_type_is_managed(result_type)
			gate4_output_line(output, "\tcall $g4_gc_temp_push(l %return_result)")
		end
		gate4_output_line(output, "\tret %return_result")
	end
	gate4_output_line(output, "}\n")
	gate4_reset_temporary_storage()
	return
end

def gate4_compiler_entry_function(state: Gate4Compiler): Integer
	index := gate4_find_function_in_module(state, state.entry_module[0], "compiler_main")
	if index < 0
		return - 1
	end
	if gate4_load_integer(state.function_parameter_counts, index) != 3
		return - 1
	end
	start := gate4_load_integer(state.function_parameter_starts, index)
	if gate4_load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 2) != "Boolean"
		return - 1
	end
	if gate4_load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def gate4_compiler_file_entry_function(state: Gate4Compiler): Integer
	index := gate4_find_function_in_module(state, state.entry_module[0], "compiler_file_main")
	if index < 0
		return - 1
	end
	if gate4_load_integer(state.function_parameter_counts, index) != 4
		return - 1
	end
	start := gate4_load_integer(state.function_parameter_starts, index)
	if gate4_load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 2) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 3) != "Boolean"
		return - 1
	end
	if gate4_load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def gate4_emit_process_arguments(mut output: Gate4Output)
	gate4_output_line(
		output,
		"\t%process_argc =l extsw %argc\n\tstorel %process_argc, $g4_process_argc\n\tstorel %argv, $g4_process_argv_pointer",
	)
	return
end

def gate4_emit_target_entry(mut output: Gate4Output)
	gate4_output_line(output, "\nexport function w $main(w %argc, l %argv) {")
	gate4_output_line(output, "@start")
	gate4_output_line(output, "\tcall $g4_gc_trace_initialize()")
	if output.runtime_flags[2] == 1
		gate4_output_line(output, "\tcall $g4_static_strings_initialize()")
	end
	if output.runtime_flags[1] == 1
		gate4_emit_process_arguments(output)
	end
	gate4_output_line(output, "\tstorel $g4_qbe_darwin_arm64, $g4_selected_qbe_target")
	gate4_output_line(output, "\tstorel $g4_dead_strip_darwin, $g4_selected_dead_strip")
	gate4_output_line(output, "\tstorel 0, $g4_project_selected_linker")
	gate4_output_line(output, "\t%a11 =w ceqw %argc, 11")
	gate4_output_line(output, "\tjnz %a11, @target_shape, @dispatch")
	gate4_output_line(output, "@target_shape")
	gate4_output_line(output, "\t%target_flag_pointer =l add %argv, 72")
	gate4_output_line(output, "\t%target_flag =l loadl %target_flag_pointer")
	gate4_output_line(output, "\t%target_flag_comparison =w call $strcmp(l %target_flag, l $g4_target_option)")
	gate4_output_line(output, "\t%target_flag_ok =w ceqw %target_flag_comparison, 0")
	gate4_output_line(output, "\tjnz %target_flag_ok, @target_profile, @dispatch")
	gate4_output_line(output, "@target_profile")
	gate4_output_line(output, "\t%profile_pointer =l add %argv, 80")
	gate4_output_line(output, "\t%profile =l loadl %profile_pointer")
	gate4_output_line(output, "\t%darwin_comparison =w call $strcmp(l %profile, l $g4_profile_darwin_arm64)")
	gate4_output_line(output, "\t%darwin =w ceqw %darwin_comparison, 0")
	gate4_output_line(output, "\tjnz %darwin, @target_darwin, @target_linux_check")
	gate4_output_line(output, "@target_darwin")
	gate4_output_line(output, "\tjmp @invoke_target")
	gate4_output_line(output, "@target_linux_check")
	gate4_output_line(output, "\t%linux_comparison =w call $strcmp(l %profile, l $g4_profile_linux_arm64)")
	gate4_output_line(output, "\t%linux =w ceqw %linux_comparison, 0")
	gate4_output_line(output, "\tjnz %linux, @target_linux_arm64, @target_linux_amd64_check")
	gate4_output_line(output, "@target_linux_arm64")
	gate4_output_line(output, "\tstorel $g4_qbe_linux_arm64, $g4_selected_qbe_target")
	gate4_output_line(output, "\tjmp @target_linux_common")
	gate4_output_line(output, "@target_linux_amd64_check")
	gate4_output_line(output, "\t%linux_amd64_comparison =w call $strcmp(l %profile, l $g4_profile_linux_amd64)")
	gate4_output_line(output, "\t%linux_amd64 =w ceqw %linux_amd64_comparison, 0")
	gate4_output_line(output, "\tjnz %linux_amd64, @target_linux_amd64, @target_error")
	gate4_output_line(output, "@target_linux_amd64")
	gate4_output_line(output, "\tstorel $g4_qbe_linux_amd64, $g4_selected_qbe_target")
	gate4_output_line(output, "\tjmp @target_linux_common")
	gate4_output_line(output, "@target_linux_common")
	gate4_output_line(output, "\tstorel $g4_dead_strip_linux, $g4_selected_dead_strip")
	gate4_output_line(output, "\tstorel $g4_project_linker_lld, $g4_project_selected_linker")
	gate4_output_line(output, "\tjmp @invoke_target")
	gate4_output_line(output, "@target_error")
	gate4_output_line(output, "\tcall $write(w 2, l $g4_target_error, l 37)")
	gate4_output_line(output, "\tcall $g4_gc_finish()")
	gate4_output_line(output, "\tret 64")
	gate4_output_line(output, "@invoke_target")
	gate4_output_line(output, "\t%target_status =w call $g4_compiler_dispatch(w 9, l %argv)")
	gate4_output_line(output, "\tcall $g4_gc_finish()")
	gate4_output_line(output, "\tret %target_status")
	gate4_output_line(output, "@dispatch")
	gate4_output_line(output, "\t%dispatch_status =w call $g4_compiler_dispatch(w %argc, l %argv)")
	gate4_output_line(output, "\tcall $g4_gc_finish()")
	gate4_output_line(output, "\tret %dispatch_status")
	gate4_output_line(output, "}")
	return
end

def gate4_emit_entry(state: Gate4Compiler, mut output: Gate4Output)
	compiler_entry := gate4_compiler_entry_function(state)
	if compiler_entry >= 0
		compiler_file_entry := gate4_compiler_file_entry_function(state)
		gate4_output_line(output, "function w $g4_compiler_dispatch(w %argc, l %argv) {")
		gate4_output_line(output, "@start")
		gate4_output_line(
			output,
			"\t%a9 =w ceqw %argc, 9\n\tjnz %a9, @bshape, @other\n@bshape\n\t%bcmdp =l add %argv, 8\n\t%bcmd =l loadl %bcmdp\n\t%boc =w call $strcmp(l %bcmd, l $g4_build)\n\t%bok =w ceqw %boc, 0\n\t%bofp =l add %argv, 24\n\t%bof =l loadl %bofp\n\t%bofc =w call $strcmp(l %bof, l $g4_output_flag)\n\t%bofo =w ceqw %bofc, 0\n\t%bqfp =l add %argv, 40\n\t%bqf =l loadl %bqfp\n\t%bqfc =w call $strcmp(l %bqf, l $g4_qbe_flag)\n\t%bqfo =w ceqw %bqfc, 0\n\t%bcfp =l add %argv, 56\n\t%bcf =l loadl %bcfp\n\t%bcfc =w call $strcmp(l %bcf, l $g4_cc_flag)\n\t%bcfo =w ceqw %bcfc, 0\n\t%bv0 =w and %bok, %bofo\n\t%bv1 =w and %bqfo, %bcfo\n\t%bv =w and %bv0, %bv1\n\tjnz %bv, @build, @usage\n@build\n\t%bspp =l add %argv, 16\n\t%bsp =l loadl %bspp\n\t%bsrc =l call $g4_read_file(l %bsp)\n\t%bsm =w ceql %bsrc, 0\n\tjnz %bsm, @bread_error, @bpaths\n@bread_error\n\tcall $write(w 2, l $g4_file_error, l 35)\n\t%bspl =l call $strlen(l %bsp)\n\tcall $write(w 2, l %bsp, l %bspl)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret 66\n@bpaths\n\t%bop =l add %argv, 32\n\t%bo =l loadl %bop\n\t%bqp =l add %argv, 48\n\t%bqbe =l loadl %bqp\n\t%bcp =l add %argv, 64\n\t%bcc =l loadl %bcp\n\t%bssa =l call $g4_c_concat(l %bo, l $g4_ssa_suffix)\n\t%basm =l call $g4_c_concat(l %bo, l $g4_asm_suffix)\n\t%bf =l call $fopen(l %bssa, l $g4_wb)\n\t%bfm =w ceql %bf, 0\n\tjnz %bfm, @bfile_error, @bredirect\n@bfile_error\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bredirect\n\t%bfd =w call $fileno(l %bf)\n\t%bsaved =w call $dup(w 1)\n\t%bfdb =w csltw %bfd, 0\n\t%bsavedb =w csltw %bsaved, 0\n\t%brb =w or %bfdb, %bsavedb\n\tjnz %brb, @bredirect_error, @bset_stdout\n@bset_stdout\n\t%bset =w call $dup2(w %bfd, w 1)\n\t%bsetb =w csltw %bset, 0\n\tjnz %bsetb, @bredirect_error, @bcompile\n@bredirect_error\n\t%bci =w call $close(w %bsaved)\n\t%bfci =w call $fclose(l %bf)\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bcompile\n\t%bm =l call $g4_string_from_c(l $g4_emit)",
		)
		gate4_output_line(
			output,
			"\t%bpath =l call $g4_string_from_c(l %bsp)",
		)
		gate4_output_line(
			output,
			"\t%bst =l call $g4f" + gate4_integer_string(compiler_file_entry) +
			"(l %bsrc, l %bpath, l %bm, l 1)",
		)
		gate4_output_line(
			output,
			"\t%brestore =w call $dup2(w %bsaved, w 1)\n\t%bclosed =w call $close(w %bsaved)\n\t%bfclosed =w call $fclose(l %bf)\n\t%brb0 =w csltw %brestore, 0\n\t%brb1 =w csltw %bclosed, 0\n\t%brb2 =w cnew %bfclosed, 0\n\t%brb3 =w or %brb0, %brb1\n\t%brbad =w or %brb3, %brb2\n\tjnz %brbad, @bpost_error, @bcompiled\n@bpost_error\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bcompiled\n\t%bcfail =w cnel %bst, 0\n\tjnz %bcfail, @bcompiler_failed, @bqbe\n@bcompiler_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tret 1\n@bqbe\n\t%bqs =w call $g4_run_qbe(l %bqbe, l %bssa, l %basm)\n\t%bqfail =w cnew %bqs, 0\n\tjnz %bqfail, @bqbe_failed, @btemp\n@bqbe_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_qbe_error, l 21)\n\tret 70\n@btemp\n\t%btmpl =l call $g4_c_concat(l %bo, l $g4_temp_suffix)\n\t%bdir =l call $mkdtemp(l %btmpl)\n\t%bdfail =w ceql %bdir, 0\n\tjnz %bdfail, @btemp_failed, @btemp_path\n@btemp_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@btemp_path\n\t%bbase =l call $g4_c_basename(l %bo)\n\t%bdp =l call $g4_c_concat(l %bdir, l $g4_slash)\n\t%bexe =l call $g4_c_concat(l %bdp, l %bbase)\n\t%bcs =w call $g4_project_run_cc(l %bcc, l %basm, l %bexe)\n\t%bccfail =w cnew %bcs, 0\n\tjnz %bccfail, @bcc_failed, @bpublish\n@bcc_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $g4_cc_error, l 20)\n\tret 70\n@bpublish\n\t%bpr =w call $rename(l %bexe, l %bo)\n\t%bpf =w cnew %bpr, 0\n\tjnz %bpf, @bpublish_failed, @bsuccess\n@bpublish_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $g4_publish_error, l 32)\n\tret 73\n@bsuccess\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tret 0\n@other\n\t%a3 =w ceqw %argc, 3\n\tjnz %a3, @fargs, @hargc\n@hargc\n\t%a4 =w ceqw %argc, 4\n\tjnz %a4, @hargs, @usage\n@hargs\n\t%hfp =l add %argv, 8\n\t%hf =l loadl %hfp\n\t%hfc =w call $strcmp(l %hf, l $g4_source_arg)\n\t%valid_hf =w ceqw %hfc, 0\n\tjnz %valid_hf, @hidden, @usage\n@usage\n\tcall $write(w 2, l $g4_usage_error, l 103)\n\tret 64\n@hidden\n\t%hmp =l add %argv, 16\n\t%hmc =l loadl %hmp\n\t%hm =l call $g4_string_from_c(l %hmc)\n\t%hsp =l add %argv, 24\n\t%hsc =l loadl %hsp\n\t%hs =l call $g4_string_from_c(l %hsc)",
		)
		gate4_output_line(
			output,
			"\t%hst =l call $g4f" + gate4_integer_string(compiler_entry) +
			"(l %hs, l %hm, l 0)",
		)
		gate4_output_line(
			output,
			"\tret 0\n@fargs\n\t%fmp =l add %argv, 8\n\t%fmc =l loadl %fmp\n\t%cc =w call $strcmp(l %fmc, l $g4_check)\n\t%cm =w ceqw %cc, 0\n\t%ec =w call $strcmp(l %fmc, l $g4_emit)\n\t%em =w ceqw %ec, 0\n\t%valid_fm =w or %cm, %em\n\tjnz %valid_fm, @file, @usage\n@file\n\t%pp =l add %argv, 16\n\t%path =l loadl %pp\n\t%src =l call $g4_read_file(l %path)\n\t%rf =w ceql %src, 0\n\tjnz %rf, @read_error, @compile\n@read_error\n\tcall $write(w 2, l $g4_file_error, l 35)\n\t%pl =l call $strlen(l %path)\n\tcall $write(w 2, l %path, l %pl)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret 66\n@compile\n\t%fm =l call $g4_string_from_c(l %fmc)",
		)
		gate4_output_line(
			output,
			"\t%fpath =l call $g4_string_from_c(l %path)",
		)
		gate4_output_line(
			output,
			"\t%fst =l call $g4f" + gate4_integer_string(compiler_file_entry) +
			"(l %src, l %fpath, l %fm, l 1)",
		)
		gate4_output_line(output, "\t%failed =w cnel %fst, 0\n\tret %failed")
	else
		gate4_output_line(output, "export function w $main(w %argc, l %argv) {")
		gate4_output_line(output, "@start")
		gate4_output_line(output, "\tcall $g4_gc_trace_initialize()")
		if output.runtime_flags[2] == 1
			gate4_output_line(output, "\tcall $g4_static_strings_initialize()")
		end
		if output.runtime_flags[1] == 1
			gate4_emit_process_arguments(output)
		end
		main_index := gate4_find_function_in_module(state, state.entry_module[0], "main")
		gate4_output_line(output, "\tcall $g4f" + gate4_integer_string(main_index) + "()")
		gate4_output_line(output, "\tcall $g4_gc_finish()")
		gate4_output_line(output, "\tret 0")
	end
	gate4_output_line(output, "}")
	if compiler_entry >= 0
		gate4_emit_target_entry(output)
	end
	return
end

def gate4_emit_qbe(mut state: Gate4Compiler): Gate4Output
	mut output := gate4_output_new(state.token_count[0] * 24 + 4096, [0, 0, 0, 0])
	gate4_emit_static_strings(state, output)
	gate4_emit_record_descriptors(state, output)
	compiler_runtime := gate4_compiler_entry_function(state) >= 0
	gate4_emit_runtime(output, compiler_runtime)
	function_count := state.function_count[0]
	mut inline_budget := [0, 0, - 2]
	if function_count <= 32
		inline_budget[0] = 64
		inline_budget[1] = 6
		inline_budget[2] = 2
	else
		if function_count <= 96
			inline_budget[0] = 32
			inline_budget[1] = 3
		end
	end
	mut function_index := 0
	# Flat recovery input still needs the source fallbacks during its first bootstrap.
	# Canonical multi-module compiler input uses the runtime intrinsics directly.
	if compiler_runtime
		if state.module_count[0] > 1
			function_index = 5
		end
	end
	mut deferred_function :=- 1
	while function_index < function_count
		mut deferred := false
		if function_count <= 32
			if deferred_function < 0
				if gate4_scalar_leaf_inline_eligible(state, function_index)
					deferred_function = function_index
					deferred = true
				end
			end
		end
		if !deferred
			gate4_emit_function(state, function_index, output, inline_budget)
		end
		function_index += 1
	end
	if deferred_function >= 0
		if inline_budget[2] == - 1
			gate4_emit_function(state, deferred_function, output, inline_budget)
		end
	end
	gate4_emit_entry(state, output)
	if output.runtime_flags[3] == 1
		gate4_output_line(
			output,
			"\nfunction l $g4_array_address(l %array, l %requested) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%negative =w csltl %requested, 0\n\tjnz %negative, @negative, @check\n@negative\n\t%adjusted_negative =l add %length, %requested\n\tjmp @bounds\n@check\n\t%adjusted_positive =l copy %requested\n\tjmp @bounds\n@bounds\n\t%index =l phi @negative %adjusted_negative, @check %adjusted_positive\n\t%valid =w cultl %index, %length\n\tjnz %valid, @load, @fail\n@fail\n\tcall $g4_fail(l $g4_bounds_error, l 30)\n\thlt\n@load\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%offset =l mul %index, 8\n\t%address =l add %data, %offset\n\tret %address\n}",
		)
	end
	if output.runtime_flags[0] == 1
		gate4_emit_float_array_runtime(output)
	end
	if output.runtime_flags[1] == 1
		gate4_emit_process_runtime(output)
		gate4_emit_string_to_integer_runtime(output)
		gate4_emit_integer_to_string_runtime(output)
		gate4_emit_float_to_integer_runtime(output)
	end
	return output
end

def gate4_eputs(_value: String)
	return
end

def gate4_print_diagnostic(state: Gate4Compiler, file_mode: Boolean)
	mut message := ""
	module_index := gate4_load_integer(state.diagnostic_modules, 0)
	if module_index > 0
		message += gate4_load_string(state.module_files, module_index) + ":"
	end
	message += gate4_load_string(state.diagnostic_codes, 0) + ":"
	message += gate4_integer_string(gate4_load_integer(state.diagnostic_lines, 0))
	message += ":"
	message += gate4_load_string(state.diagnostic_messages, 0)
	if file_mode
		gate4_eputs(message)
	else
		puts(message)
	end
	return
end

def gate4_compile_state(mut state: Gate4Compiler, mode: String, file_mode: Boolean): Integer
	if !gate4_has_diagnostic(state)
		gate4_resolve(state)
	end
	if !gate4_has_diagnostic(state)
		gate4_check(state)
	end
	if gate4_has_diagnostic(state)
		gate4_print_diagnostic(state, file_mode)
		return 1
	end
	if mode == "check"
		puts("ok")
		return 0
	end
	if mode == "emit-qbe"
		output := gate4_emit_qbe(state)
		if gate4_has_diagnostic(state)
			gate4_print_diagnostic(state, file_mode)
			return 1
		end
		mut index := 0
		while index < output.count[0]
			puts(gate4_load_string(output.lines, index))
			index += 1
		end
		return 0
	end
	message := "TRBN4006:1:unsupported compiler mode " + mode
	if file_mode
		gate4_eputs(message)
	else
		puts(message)
	end
	return 64
end

def gate4_project_set_error(
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		message: String,
		line: Integer,
	)
	if error[0] == ""
		error[0] = message
		error_line[0] = line
	end
	return
end

def gate4_project_advance(mut value: Array<Integer>, amount: Integer)
	value[0] = value[0] + amount
	return
end

def gate4_json_skip_ignored(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == " "
				gate4_project_advance(position, 1)
			else
				if character == "\t"
					gate4_project_advance(position, 1)
				else
					if character == "\r"
						gate4_project_advance(position, 1)
					else
						if character == "\n"
							gate4_project_advance(position, 1)
							gate4_project_advance(line, 1)
						else
							if character == "/"
								if position[0] + 1 < source.size()
									following := source[position[0] + 1]
									if following == "/"
										gate4_project_advance(position, 2)
										mut comment := true
										while comment
											if position[0] >= source.size()
												comment = false
											else
												if source[position[0]] == "\n"
													comment = false
												else
													gate4_project_advance(position, 1)
												end
											end
										end
									else
										if following == "*"
											start_line := line[0]
											gate4_project_advance(position, 2)
											mut comment := true
											mut closed := false
											while comment
												if position[0] >= source.size()
													comment = false
												else
													if source[position[0]] == "\n"
														gate4_project_advance(line, 1)
													end
													if source[position[0]] == "*"
														if position[0] + 1 < source.size()
															if source[position[0] + 1] == "/"
																gate4_project_advance(position, 2)
																closed = true
																comment = false
															end
														end
													end
													if comment
														gate4_project_advance(position, 1)
													end
												end
											end
											if !closed
												gate4_project_set_error(error, error_line, "unterminated JSONC block comment", start_line)
												scanning = false
											end
										else
											scanning = false
										end
									end
								else
									scanning = false
								end
							else
								scanning = false
							end
						end
					end
				end
			end
		end
	end
	return error[0] == ""
end

def gate4_json_hex_digit(character: String): Integer
	code := gate4_ascii_code(character)
	if code >= 48
		if code <= 57
			return code - 48
		end
	end
	if code >= 65
		if code <= 70
			return code - 55
		end
	end
	if code >= 97
		if code <= 102
			return code - 87
		end
	end
	return - 1
end

def gate4_json_ascii_character(code: Integer): String
	if code == 9
		return "\t"
	end
	if code == 10
		return "\n"
	end
	if code == 13
		return "\r"
	end
	if code < 32
		return ""
	end
	if code > 126
		return ""
	end
	alphabet := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
	return alphabet[code - 32]
end

def gate4_json_string(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if position[0] >= source.size()
		gate4_project_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	if source[position[0]] != "\""
		gate4_project_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	gate4_project_advance(position, 1)
	mut result := ""
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == "\""
				gate4_project_advance(position, 1)
				closed = true
				scanning = false
			else
				if character == "\n"
					gate4_project_set_error(error, error_line, "newline in JSON string", line[0])
					scanning = false
				else
					if character == "\\"
						gate4_project_advance(position, 1)
						if position[0] >= source.size()
							gate4_project_set_error(error, error_line, "unterminated JSON escape", line[0])
							scanning = false
						else
							escaped := source[position[0]]
							gate4_project_advance(position, 1)
							if escaped == "\""
								result += "\""
							else
								if escaped == "\\"
									result += "\\"
								else
									if escaped == "/"
										result += "/"
									else
										if escaped == "n"
											result += "\n"
										else
											if escaped == "r"
												result += "\r"
											else
												if escaped == "t"
													result += "\t"
												else
													if escaped == "u"
														mut code := 0
														mut digit_index := 0
														while digit_index < 4
															if position[0] >= source.size()
																gate4_project_set_error(error, error_line, "incomplete JSON Unicode escape", line[0])
																digit_index = 4
															else
																digit := gate4_json_hex_digit(source[position[0]])
																if digit < 0
																	gate4_project_set_error(error, error_line, "invalid JSON Unicode escape", line[0])
																	digit_index = 4
																else
																	code = code * 16 + digit
																	gate4_project_advance(position, 1)
																	digit_index += 1
																end
															end
														end
														if error[0] == ""
															decoded := gate4_json_ascii_character(code)
															if decoded == ""
																gate4_project_set_error(error, error_line, "non-ASCII JSON Unicode escape is not supported", line[0])
															else
																result += decoded
															end
														end
													else
														gate4_project_set_error(error, error_line, "unsupported JSON escape", line[0])
													end
												end
											end
										end
									end
								end
							end
							if error[0] != ""
								scanning = false
							end
						end
					else
						code := gate4_ascii_code(character)
						if code >= 0
							if code < 32
								gate4_project_set_error(error, error_line, "control character in JSON string", line[0])
								scanning = false
							end
						end
						if scanning
							result += character
							gate4_project_advance(position, 1)
						end
					end
				end
			end
		end
	end
	if !closed
		if error[0] == ""
			gate4_project_set_error(error, error_line, "unterminated JSON string", line[0])
		end
	end
	return result
end

def gate4_json_literal_at(source: String, position: Integer, literal: String): Boolean
	if position + literal.size() > source.size()
		return false
	end
	mut index := 0
	while index < literal.size()
		if source[position + index] != literal[index]
			return false
		end
		index += 1
	end
	return true
end

def gate4_json_boolean(
		source: String,
		mut position: Array<Integer>,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if gate4_json_literal_at(source, position[0], "true")
		gate4_project_advance(position, 4)
		return true
	end
	if gate4_json_literal_at(source, position[0], "false")
		gate4_project_advance(position, 5)
		return false
	end
	gate4_project_set_error(error, error_line, "expected JSON Boolean", line)
	return false
end

def gate4_string_array_contains(values: Array<String>, value: String): Boolean
	mut index := 0
	while index < values.size()
		if values[index] == value
			return true
		end
		index += 1
	end
	return false
end

def gate4_json_expect(
		source: String,
		mut position: Array<Integer>,
		expected: String,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if position[0] < source.size()
		if source[position[0]] == expected
			gate4_project_advance(position, 1)
			return true
		end
	end
	gate4_project_set_error(error, error_line, "expected JSON " + expected, line)
	return false
end

def gate4_parse_project_go_config(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Gate4ProjectGoConfig
	mut module_name := ""
	mut version := "1.27"
	mut root_package := "main"
	gate4_json_expect(source, position, "{", line[0], error, error_line)
	gate4_json_skip_ignored(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut finished := false
	while !finished
		if error[0] != ""
			finished = true
		else
			if position[0] < source.size()
				if source[position[0]] == "}"
					gate4_project_advance(position, 1)
					finished = true
				else
					key_line := line[0]
					key := gate4_json_string(source, position, line, error, error_line)
					if gate4_string_array_contains(seen, key)
						gate4_project_set_error(error, error_line, "duplicate go configuration field " + key, key_line)
					else
						seen.push(key)
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					gate4_json_expect(source, position, ":", line[0], error, error_line)
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if key == "module"
							module_name = gate4_json_string(source, position, line, error, error_line)
						else
							if key == "version"
								version = gate4_json_string(source, position, line, error, error_line)
							else
								if key == "rootPackage"
									root_package = gate4_json_string(source, position, line, error, error_line)
								else
									gate4_project_set_error(error, error_line, "unsupported go configuration field " + key, key_line)
								end
							end
						end
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if position[0] < source.size()
							if source[position[0]] == ","
								gate4_project_advance(position, 1)
								gate4_json_skip_ignored(source, position, line, error, error_line)
								if position[0] < source.size()
									if source[position[0]] == "}"
										gate4_project_set_error(error, error_line, "trailing comma in go configuration", line[0])
									end
								end
							else
								if source[position[0]] != "}"
									gate4_project_set_error(error, error_line, "expected JSON , or }", line[0])
								end
							end
						else
							gate4_project_set_error(error, error_line, "unterminated go configuration", line[0])
						end
					end
				end
			else
				gate4_project_set_error(error, error_line, "unterminated go configuration", line[0])
			end
		end
	end
	if version == ""
		version = "1.27"
	end
	if root_package == ""
		root_package = "main"
	end
	return Gate4ProjectGoConfig.new(module_name: module_name, version: version, root_package: root_package)
end

def gate4_project_blank(value: String): Boolean
	mut index := 0
	while index < value.size()
		character := value[index]
		mut whitespace := character == " "
		if character == "\t"
			whitespace = true
		end
		if character == "\r"
			whitespace = true
		end
		if character == "\n"
			whitespace = true
		end
		if !whitespace
			return false
		end
		index += 1
	end
	return true
end

def gate4_project_clean_relative(
		value: String,
		field: String,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if value.size() > 0
		if value[0] == "/"
			gate4_project_set_error(error, error_line, field + " must be relative to the project root", 1)
			return ""
		end
	end
	mut segments: Array<String> := []
	mut segment_count := 0
	mut segment := ""
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "/"
				boundary = true
			end
		end
		if boundary
			if segment == ".."
				if segment_count == 0
					gate4_project_set_error(error, error_line, field + " cannot escape the project root", 1)
				else
					segment_count -= 1
				end
			else
				if segment != ""
					if segment != "."
						if segment_count < segments.size()
							segments[segment_count] = segment
						else
							segments.push(segment)
						end
						segment_count += 1
					end
				end
			end
			segment = ""
		else
			segment += value[index]
		end
		index += 1
	end
	mut result := ""
	index = 0
	while index < segment_count
		if result != ""
			result += "/"
		end
		result += segments[index]
		index += 1
	end
	if result == ""
		return "."
	end
	return result
end

def gate4_project_go_version_supported(value: String): Boolean
	mut components: Array<Integer> := []
	mut current := 0
	mut digits := 0
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "."
				boundary = true
			end
		end
		if boundary
			if digits == 0
				return false
			end
			components.push(current)
			current = 0
			digits = 0
		else
			code := gate4_ascii_code(value[index])
			if code < 48
				return false
			end
			if code > 57
				return false
			end
			digit := code - 48
			if current > 900719925474099
				return false
			end
			if current == 900719925474099
				if digit > 1
					return false
				end
			end
			current = current * 10 + digit
			digits += 1
		end
		index += 1
	end
	if components.size() < 2
		return false
	end
	if components.size() > 3
		return false
	end
	if components[0] > 1
		return true
	end
	if components[0] < 1
		return false
	end
	return components[1] >= 27
end

def gate4_project_config_error(
		name: String,
		version: String,
		mode: String,
		source_dir: String,
		out_dir: String,
		copy_files: Boolean,
		package_management: String,
		go_config: Gate4ProjectGoConfig,
		error: String,
		error_line: Integer,
	): Gate4ProjectConfig
	return Gate4ProjectConfig.new(
		name: name,
		version: version,
		mode: mode,
		source_dir: source_dir,
		out_dir: out_dir,
		copy_files: copy_files,
		package_management: package_management,
		go_config: go_config,
		error: error,
		error_line: error_line,
	)
end

def gate4_parse_project_config(source: String): Gate4ProjectConfig
	mut position := [0]
	mut line := [1]
	mut error := [""]
	mut error_line := [1]
	mut name := ""
	mut version := "0.1.0"
	mut mode := ""
	mut source_dir := "."
	mut out_dir := "build"
	mut copy_files := true
	mut package_management := "managed"
	mut go_config := Gate4ProjectGoConfig.new(module_name: "", version: "1.27", root_package: "main")
	gate4_json_skip_ignored(source, position, line, error, error_line)
	gate4_json_expect(source, position, "{", line[0], error, error_line)
	gate4_json_skip_ignored(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut finished := false
	while !finished
		if error[0] != ""
			finished = true
		else
			if position[0] < source.size()
				if source[position[0]] == "}"
					gate4_project_advance(position, 1)
					finished = true
				else
					key_line := line[0]
					key := gate4_json_string(source, position, line, error, error_line)
					if gate4_string_array_contains(seen, key)
						gate4_project_set_error(error, error_line, "duplicate project configuration field " + key, key_line)
					else
						seen.push(key)
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					gate4_json_expect(source, position, ":", line[0], error, error_line)
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if key == "$schema"
							gate4_json_string(source, position, line, error, error_line)
						else
							if key == "name"
								name = gate4_json_string(source, position, line, error, error_line)
							else
								if key == "version"
									version = gate4_json_string(source, position, line, error, error_line)
								else
									if key == "mode"
										mode = gate4_json_string(source, position, line, error, error_line)
									else
										if key == "sourceDir"
											source_dir = gate4_json_string(source, position, line, error, error_line)
										else
											if key == "outDir"
												out_dir = gate4_json_string(source, position, line, error, error_line)
											else
												if key == "copyFiles"
													copy_files = gate4_json_boolean(source, position, line[0], error, error_line)
												else
													if key == "packageManagement"
														package_management = gate4_json_string(source, position, line, error, error_line)
													else
														if key == "go"
															go_config = gate4_parse_project_go_config(source, position, line, error, error_line)
														else
															gate4_project_set_error(error, error_line, "unsupported project configuration field " + key, key_line)
														end
													end
												end
											end
										end
									end
								end
							end
						end
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if position[0] < source.size()
							if source[position[0]] == ","
								gate4_project_advance(position, 1)
								gate4_json_skip_ignored(source, position, line, error, error_line)
								if position[0] < source.size()
									if source[position[0]] == "}"
										gate4_project_set_error(error, error_line, "trailing comma in project configuration", line[0])
									end
								end
							else
								if source[position[0]] != "}"
									gate4_project_set_error(error, error_line, "expected JSON , or }", line[0])
								end
							end
						else
							gate4_project_set_error(error, error_line, "unterminated project configuration", line[0])
						end
					end
				end
			else
				gate4_project_set_error(error, error_line, "unterminated project configuration", line[0])
			end
		end
	end
	gate4_json_skip_ignored(source, position, line, error, error_line)
	if error[0] == ""
		if position[0] != source.size()
			gate4_project_set_error(error, error_line, "unexpected data after project configuration", line[0])
		end
	end
	if error[0] == ""
		if gate4_project_blank(name)
			gate4_project_set_error(error, error_line, "name is required", 1)
		end
	end
	if error[0] == ""
		if mode != "go"
			gate4_project_set_error(error, error_line, "mode must be go for configured Native builds", 1)
		end
	end
	if source_dir == ""
		source_dir = "."
	end
	if out_dir == ""
		out_dir = "build"
	end
	if package_management == ""
		package_management = "managed"
	end
	if error[0] == ""
		source_dir = gate4_project_clean_relative(source_dir, "sourceDir", error, error_line)
	end
	if error[0] == ""
		out_dir = gate4_project_clean_relative(out_dir, "outDir", error, error_line)
	end
	if error[0] == ""
		mut package_mode_supported := package_management == "managed"
		if package_management == "external"
			package_mode_supported = true
		end
		if !package_mode_supported
			gate4_project_set_error(error, error_line, "packageManagement must be managed or external", 1)
		end
	end
	if error[0] == ""
		if gate4_project_blank(go_config.module_name)
			gate4_project_set_error(error, error_line, "go.module is required for mode go", 1)
		end
	end
	if error[0] == ""
		if !gate4_project_go_version_supported(go_config.version)
			gate4_project_set_error(error, error_line, "go.version must be 1.27 or later", 1)
		end
	end
	return gate4_project_config_error(
		name,
		version,
		mode,
		source_dir,
		out_dir,
		copy_files,
		package_management,
		go_config,
		error[0],
		error_line[0],
	)
end

def compiler_main(source: String, mode: String, file_mode: Boolean): Integer
	mut state := gate4_compiler_new(source.size() + 1)
	gate4_lex(state, source)
	if !gate4_has_diagnostic(state)
		gate4_parse_module(state, 0, state.entry_module[0])
	end
	return gate4_compile_state(state, mode, file_mode)
end

def compiler_file_main(source: String, path: String, mode: String, file_mode: Boolean): Integer
	mut state := gate4_compiler_new(1)
	if gate4_path_basename(path) == "trbconfig.jsonc"
		state = gate4_load_configured_project(source, path)
	else
		state = gate4_load_file_root(source, path)
	end
	return gate4_compile_state(state, mode, file_mode)
end

def gate4_has_diagnostic(state: Gate4Compiler): Boolean
	return state.diagnostic_count[0] > 0
end

def gate4_diagnostic(mut state: Gate4Compiler, code: String, line: Integer, message: String)
	if state.diagnostic_count[0] == 0
		gate4_store_string(state.diagnostic_codes, 0, code)
		gate4_store_integer(state.diagnostic_lines, 0, line)
		gate4_store_string(state.diagnostic_messages, 0, message)
		gate4_store_integer(state.diagnostic_modules, 0, state.active_module[0])
		state.diagnostic_count[0] = 1
	end
	return
end

def gate4_character_in(character: String, characters: String): Boolean
	mut index := 0
	while index < characters.size()
		if characters[index] == character
			return true
		end
		index += 1
	end
	return false
end

def gate4_number_character(character: String): Boolean
	if gate4_character_in(character, "0123456789")
		return true
	end
	return character == "_"
end

def gate4_push_token(mut state: Gate4Compiler, kind: Integer, text: String, line: Integer)
	mut index := state.token_count[0]
	# The following token distinguishes a complete right literal from a postfix.
	if index >= 3
		if gate4_load_integer(state.token_kinds, index - 3) == 3
			if gate4_load_integer(state.token_kinds, index - 2) == 5
				if gate4_load_string(state.token_texts, index - 2) == "+"
					if gate4_load_integer(state.token_kinds, index - 1) == 3
						if text != "."
							if text != "["
								combined := gate4_load_string(state.token_texts, index - 3) + gate4_load_string(state.token_texts, index - 1)
								gate4_store_string(state.token_texts, index - 3, combined)
								index -= 2
							end
						end
					end
				end
			end
		end
	end
	gate4_store_integer(state.token_kinds, index, kind)
	gate4_store_string(state.token_texts, index, text)
	gate4_store_integer(state.token_lines, index, line)
	state.token_count[0] = index + 1
	return
end

def gate4_scan_identifier(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if gate4_character_in(
					source[position[0]],
					"0123456789fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
				)
				gate4_project_advance(position, 1)
			else
				scanning = false
			end
		end
	end
	gate4_push_token(state, 1, gate4_source_slice(source, start, position[0]), line)
	return
end

def gate4_scan_number(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if gate4_number_character(source[position[0]])
				gate4_project_advance(position, 1)
			else
				scanning = false
			end
		end
	end
	if position[0] + 1 < source.size()
		if source[position[0]] == "."
			if gate4_character_in(source[position[0] + 1], "0123456789")
				gate4_project_advance(position, 1)
				scanning = true
				while scanning
					if position[0] >= source.size()
						scanning = false
					else
						if gate4_number_character(source[position[0]])
							gate4_project_advance(position, 1)
						else
							scanning = false
						end
					end
				end
			end
		end
	end
	gate4_push_token(state, 2, gate4_source_slice(source, start, position[0]), line)
	return
end

def gate4_decode_escape(mut state: Gate4Compiler, escaped: String, line: Integer): String
	mut value := ""
	if escaped == "n"
		value = "\n"
	else
		if escaped == "t"
			value = "\t"
		else
			if escaped == "r"
				value = "\r"
			else
				if escaped == "\""
					value = "\""
				else
					if escaped == "\\"
						value = "\\"
					else
						gate4_diagnostic(state, "TRBN4001", line, "unsupported String escape")
					end
				end
			end
		end
	end
	return value
end

def gate4_scan_string(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	gate4_project_advance(position, 1)
	mut text := ""
	mut chunk_start := position[0]
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			current := source[position[0]]
			if current == "\""
				text += gate4_source_slice(source, chunk_start, position[0])
				closed = true
				scanning = false
				gate4_project_advance(position, 1)
			else
				if current == "\n"
					gate4_diagnostic(state, "TRBN4001", line, "unterminated String literal")
					scanning = false
				else
					if current == "\\"
						text += gate4_source_slice(source, chunk_start, position[0])
						gate4_project_advance(position, 1)
						if position[0] >= source.size()
							gate4_diagnostic(state, "TRBN4001", line, "unterminated String escape")
							scanning = false
						else
							text += gate4_decode_escape(state, source[position[0]], line)
							gate4_project_advance(position, 1)
							chunk_start = position[0]
						end
					else
						gate4_project_advance(position, 1)
					end
				end
			end
		end
	end
	if closed
		gate4_push_token(state, 3, text, line)
	else
		if !gate4_has_diagnostic(state)
			gate4_diagnostic(state, "TRBN4001", line, "unterminated String literal")
		end
	end
	return
end

def gate4_two_character_symbol(pair: String): Boolean
	mut supported := false
	if pair == ":="
		supported = true
	end
	if pair == "=="
		supported = true
	end
	if pair == "!="
		supported = true
	end
	if pair == "<="
		supported = true
	end
	if pair == ">="
		supported = true
	end
	if pair == "+="
		supported = true
	end
	if pair == "-="
		supported = true
	end
	if pair == "*="
		supported = true
	end
	if pair == "/="
		supported = true
	end
	if pair == "->"
		supported = true
	end
	return supported
end

def gate4_scan_symbol(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	character := source[position[0]]
	mut symbol := character
	if position[0] + 1 < source.size()
		pair := character + source[position[0] + 1]
		if gate4_two_character_symbol(pair)
			symbol = pair
			gate4_project_advance(position, 1)
		end
	end
	if gate4_character_in(character, "()[]{}:,.+-*/%<>=!")
		gate4_push_token(state, 5, symbol, line)
	else
		gate4_diagnostic(state, "TRBN4001", line, "unsupported source character " + character)
	end
	gate4_project_advance(position, 1)
	return
end

def gate4_skip_comment(source: String, mut position: Array<Integer>)
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if source[position[0]] == "\n"
				scanning = false
			else
				gate4_project_advance(position, 1)
			end
		end
	end
	return
end

def gate4_lex_source(mut state: Gate4Compiler, source: String, terminal_kind: Integer): Boolean
	mut position := [0]
	mut line := 1
	mut character := ""
	while position[0] < source.size()
		character = source[position[0]]
		if character == " "
			gate4_project_advance(position, 1)
		else
			if character == "\t"
				gate4_project_advance(position, 1)
			else
				if character == "\r"
					gate4_project_advance(position, 1)
				else
					if character == "\n"
						gate4_push_token(state, 4, "\n", line)
						line += 1
						gate4_project_advance(position, 1)
					else
						if character == "#"
							gate4_skip_comment(source, position)
						else
							if gate4_character_in(
									character,
									"fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
								)
								gate4_scan_identifier(state, source, position, line)
							else
								if gate4_character_in(character, "0123456789")
									gate4_scan_number(state, source, position, line)
								else
									if character == "\""
										gate4_scan_string(state, source, position, line)
									else
										gate4_scan_symbol(state, source, position, line)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	gate4_push_token(state, terminal_kind, "", line)
	return !gate4_has_diagnostic(state)
end

def gate4_lex_module(mut state: Gate4Compiler, source: String, module_index: Integer): Boolean
	state.active_module[0] = module_index
	return gate4_lex_source(state, source, 6)
end

def gate4_lex(mut state: Gate4Compiler, source: String): Boolean
	if state.module_count[0] == 0
		gate4_add_module(state, "entry", "")
	end
	state.entry_module[0] = 0
	state.active_module[0] = 0
	return gate4_lex_source(state, source, 0)
end

def gate4_token_is(state: Gate4Compiler, index: Integer, text: String): Boolean
	kind := gate4_load_integer(state.token_kinds, index)
	if kind != 1
		if kind != 5
			return false
		end
	end
	return gate4_load_string(state.token_texts, index) == text
end

def gate4_advance(mut position: Array<Integer>)
	position[0] = position[0] + 1
	return
end

def gate4_skip_newlines(state: Gate4Compiler, mut position: Array<Integer>)
	while gate4_load_integer(state.token_kinds, position[0]) == 4
		position[0] = position[0] + 1
	end
	return
end

def gate4_expect(mut state: Gate4Compiler, mut position: Array<Integer>, text: String): Boolean
	if gate4_token_is(state, position[0], text)
		position[0] = position[0] + 1
		return true
	end
	gate4_diagnostic(
		state,
		"TRBN4002",
		gate4_load_integer(state.token_lines, position[0]),
		"expected " + text + ", found " + gate4_load_string(state.token_texts, position[0]),
	)
	return false
end

def gate4_expect_identifier(mut state: Gate4Compiler, mut position: Array<Integer>): String
	if gate4_load_integer(state.token_kinds, position[0]) == 1
		value := gate4_load_string(state.token_texts, position[0])
		position[0] = position[0] + 1
		return value
	end
	gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected an identifier")
	return ""
end

def gate4_parse_type(mut state: Gate4Compiler, mut position: Array<Integer>): String
	name := gate4_expect_identifier(state, position)
	if gate4_has_diagnostic(state)
		return ""
	end
	if gate4_token_is(state, position[0], "<")
		gate4_advance(position)
		argument := gate4_parse_type(state, position)
		if !gate4_expect(state, position, ">")
			return ""
		end
		return name + "<" + argument + ">"
	end
	return name
end

def gate4_binary_precedence(operator: String): Integer
	mut precedence := 0
	if operator == "=="
		precedence = 1
	end
	if operator == "!="
		precedence = 1
	end
	if operator == "<"
		precedence = 1
	end
	if operator == "<="
		precedence = 1
	end
	if operator == ">"
		precedence = 1
	end
	if operator == ">="
		precedence = 1
	end
	if operator == "+"
		precedence = 2
	end
	if operator == "-"
		precedence = 2
	end
	if operator == "*"
		precedence = 3
	end
	if operator == "/"
		precedence = 3
	end
	if operator == "%"
		precedence = 3
	end
	return precedence
end

def gate4_parse_arguments_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	gate4_skip_newlines(state, position)
	if gate4_token_is(state, position[0], ")")
		gate4_advance(position)
		return true
	end
	mut finished := false
	while !finished
		gate4_skip_newlines(state, position)
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			if gate4_load_integer(state.token_kinds, position[0]) == 1
				if gate4_token_is(state, position[0] + 1, ":")
					gate4_advance(position)
					gate4_advance(position)
				end
			end
			if !gate4_parse_expression_syntax(state, position, 1)
				return false
			end
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_skip_newlines(state, position)
	return gate4_expect(state, position, ")")
end

def gate4_parse_primary_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	kind := gate4_load_integer(state.token_kinds, position[0])
	if kind == 1
		gate4_advance(position)
	else
		if kind == 2
			gate4_advance(position)
		else
			if kind == 3
				gate4_advance(position)
			else
				if gate4_token_is(state, position[0], "(")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
					if !gate4_parse_expression_syntax(state, position, 1)
						return false
					end
					if !gate4_expect(state, position, ")")
						return false
					end
				else
					if gate4_token_is(state, position[0], "[")
						gate4_advance(position)
						gate4_skip_newlines(state, position)
						if !gate4_token_is(state, position[0], "]")
							mut finished := false
							while !finished
								if gate4_token_is(state, position[0], "]")
									finished = true
								else
									if !gate4_parse_expression_syntax(state, position, 1)
										return false
									end
									if gate4_token_is(state, position[0], ",")
										gate4_advance(position)
										gate4_skip_newlines(state, position)
									else
										finished = true
									end
								end
							end
						end
						gate4_skip_newlines(state, position)
						if !gate4_expect(state, position, "]")
							return false
						end
					else
						if gate4_token_is(state, position[0], "!")
							gate4_advance(position)
							return gate4_parse_primary_syntax(state, position)
						end
						if gate4_token_is(state, position[0], "-")
							gate4_advance(position)
							return gate4_parse_primary_syntax(state, position)
						end
						if gate4_token_is(state, position[0], "+")
							gate4_advance(position)
							return gate4_parse_primary_syntax(state, position)
						end
						gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected an expression")
						return false
					end
				end
			end
		end
	end
	mut postfix := true
	while postfix
		if gate4_token_is(state, position[0], "(")
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			if !gate4_parse_arguments_syntax(state, position)
				return false
			end
		else
			if gate4_token_is(state, position[0], ".")
				gate4_advance(position)
				gate4_expect_identifier(state, position)
				if gate4_has_diagnostic(state)
					return false
				end
				if gate4_token_is(state, position[0], "(")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
					if !gate4_parse_arguments_syntax(state, position)
						return false
					end
				end
			else
				if gate4_token_is(state, position[0], "[")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
					if !gate4_parse_expression_syntax(state, position, 1)
						return false
					end
					if !gate4_expect(state, position, "]")
						return false
					end
				else
					postfix = false
				end
			end
		end
	end
	return true
end

def gate4_parse_expression_syntax(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		minimum_precedence: Integer,
	): Boolean
	if !gate4_parse_primary_syntax(state, position)
		return false
	end
	mut scanning := true
	while scanning
		precedence := gate4_binary_precedence(gate4_load_string(state.token_texts, position[0]))
		if precedence < minimum_precedence
			scanning = false
		else
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			if !gate4_parse_expression_syntax(state, position, precedence + 1)
				return false
			end
		end
	end
	return true
end

def gate4_finish_statement(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	if gate4_load_integer(state.token_kinds, position[0]) == 4
		gate4_skip_newlines(state, position)
		return true
	end
	if gate4_terminal_token(state, position[0])
		return true
	end
	gate4_diagnostic(
		state,
		"TRBN4002",
		gate4_load_integer(state.token_lines, position[0]),
		"unexpected token " + gate4_load_string(state.token_texts, position[0]) + " after statement",
	)
	return false
end

def gate4_parse_declaration_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	if gate4_token_is(state, position[0], "mut")
		gate4_advance(position)
	end
	gate4_expect_identifier(state, position)
	if gate4_has_diagnostic(state)
		return false
	end
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		gate4_parse_type(state, position)
	end
	if !gate4_expect(state, position, ":=")
		return false
	end
	if !gate4_parse_expression_syntax(state, position, 1)
		return false
	end
	return gate4_finish_statement(state, position)
end

def gate4_parse_simple_statement_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	if !gate4_parse_expression_syntax(state, position, 1)
		return false
	end
	operator := gate4_load_string(state.token_texts, position[0])
	if operator == "="
		gate4_advance(position)
		if !gate4_parse_expression_syntax(state, position, 1)
			return false
		end
	else
		if gate4_assignment_operator(operator)
			gate4_advance(position)
			if !gate4_parse_expression_syntax(state, position, 1)
				return false
			end
		end
	end
	return gate4_finish_statement(state, position)
end

def gate4_assignment_operator(operator: String): Boolean
	mut supported := false
	if operator == "+="
		supported = true
	end
	if operator == "-="
		supported = true
	end
	if operator == "*="
		supported = true
	end
	if operator == "/="
		supported = true
	end
	return supported
end

def gate4_parse_block_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	gate4_skip_newlines(state, position)
	mut complete := false
	while !complete
		if gate4_terminal_token(state, position[0])
			gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected end")
			complete = true
		else
			if gate4_token_is(state, position[0], "end")
				complete = true
			else
				if gate4_token_is(state, position[0], "else")
					complete = true
				else
					if gate4_token_is(state, position[0], "if")
						gate4_advance(position)
						if gate4_parse_expression_syntax(state, position, 1)
							if gate4_finish_statement(state, position)
								gate4_parse_block_syntax(state, position)
								if gate4_token_is(state, position[0], "else")
									gate4_advance(position)
									gate4_finish_statement(state, position)
									gate4_parse_block_syntax(state, position)
								end
								if gate4_expect(state, position, "end")
									gate4_finish_statement(state, position)
								end
							end
						end
					else
						if gate4_token_is(state, position[0], "while")
							gate4_advance(position)
							if gate4_parse_expression_syntax(state, position, 1)
								if gate4_finish_statement(state, position)
									gate4_parse_block_syntax(state, position)
									if gate4_expect(state, position, "end")
										gate4_finish_statement(state, position)
									end
								end
							end
						else
							if gate4_token_is(state, position[0], "return")
								gate4_advance(position)
								if gate4_load_integer(state.token_kinds, position[0]) != 4
									if !gate4_terminal_token(state, position[0])
										gate4_parse_expression_syntax(state, position, 1)
									end
								end
								gate4_finish_statement(state, position)
							else
								mut declaration := false
								if gate4_token_is(state, position[0], "mut")
									declaration = true
								else
									if gate4_load_integer(state.token_kinds, position[0]) == 1
										if gate4_token_is(state, position[0] + 1, ":=")
											declaration = true
										else
											if gate4_token_is(state, position[0] + 1, ":")
												declaration = true
											end
										end
									end
								end
								if declaration
									gate4_parse_declaration_syntax(state, position)
								else
									gate4_parse_simple_statement_syntax(state, position)
								end
							end
						end
					end
				end
			end
		end
		if gate4_has_diagnostic(state)
			complete = true
		end
	end
	return !gate4_has_diagnostic(state)
end

def gate4_parse_record(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	name := gate4_expect_identifier(state, position)
	if !gate4_finish_statement(state, position)
		return false
	end
	record_index := state.record_count[0]
	gate4_store_string(state.record_names, record_index, name)
	gate4_store_integer(state.record_modules, record_index, state.active_module[0])
	gate4_store_integer(state.record_field_starts, record_index, state.field_count[0])
	gate4_store_integer(state.record_lines, record_index, line)
	mut count := 0
	while !gate4_token_is(state, position[0], "end")
		if gate4_terminal_token(state, position[0])
			gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected end for record " + name)
			return false
		end
		field_line := gate4_load_integer(state.token_lines, position[0])
		field_name := gate4_expect_identifier(state, position)
		if !gate4_expect(state, position, ":")
			return false
		end
		field_type := gate4_parse_type(state, position)
		if !gate4_finish_statement(state, position)
			return false
		end
		field_index := state.field_count[0]
		gate4_store_string(state.field_names, field_index, field_name)
		gate4_store_string(state.field_types, field_index, field_type)
		gate4_store_integer(state.field_lines, field_index, field_line)
		state.field_count[0] = field_index + 1
		count += 1
	end
	gate4_advance(position)
	gate4_store_integer(state.record_field_counts, record_index, count)
	state.record_count[0] = record_index + 1
	return gate4_finish_statement(state, position)
end

def gate4_parse_function(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	name := gate4_expect_identifier(state, position)
	if !gate4_expect(state, position, "(")
		return false
	end
	gate4_skip_newlines(state, position)
	parameter_start := state.parameter_count[0]
	mut parameter_count := 0
	if !gate4_token_is(state, position[0], ")")
		mut finished := false
		while !finished
			gate4_skip_newlines(state, position)
			if gate4_token_is(state, position[0], ")")
				finished = true
			else
				mut mutable := 0
				if gate4_token_is(state, position[0], "mut")
					mutable = 1
					gate4_advance(position)
				end
				parameter_line := gate4_load_integer(state.token_lines, position[0])
				parameter_name := gate4_expect_identifier(state, position)
				if !gate4_expect(state, position, ":")
					return false
				end
				parameter_type := gate4_parse_type(state, position)
				parameter_index := state.parameter_count[0]
				gate4_store_string(state.parameter_names, parameter_index, parameter_name)
				gate4_store_string(state.parameter_types, parameter_index, parameter_type)
				gate4_store_integer(state.parameter_mutable, parameter_index, mutable)
				gate4_store_integer(state.parameter_lines, parameter_index, parameter_line)
				state.parameter_count[0] = parameter_index + 1
				parameter_count += 1
				if gate4_token_is(state, position[0], ",")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
				else
					finished = true
				end
			end
		end
	end
	gate4_skip_newlines(state, position)
	if !gate4_expect(state, position, ")")
		return false
	end
	mut result_type := "Void"
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		result_type = gate4_parse_type(state, position)
	end
	if !gate4_finish_statement(state, position)
		return false
	end
	body_start := position[0]
	if !gate4_parse_block_syntax(state, position)
		return false
	end
	body_end := position[0]
	if !gate4_expect(state, position, "end")
		return false
	end
	if !gate4_finish_statement(state, position)
		return false
	end
	function_index := state.function_count[0]
	gate4_store_string(state.function_names, function_index, name)
	gate4_store_integer(state.function_modules, function_index, state.active_module[0])
	gate4_store_integer(state.function_parameter_starts, function_index, parameter_start)
	gate4_store_integer(state.function_parameter_counts, function_index, parameter_count)
	gate4_store_string(state.function_result_types, function_index, result_type)
	gate4_store_integer(state.function_body_starts, function_index, body_start)
	gate4_store_integer(state.function_body_ends, function_index, body_end)
	gate4_store_integer(state.function_lines, function_index, line)
	state.function_count[0] = function_index + 1
	return true
end

def gate4_append_import(
		mut state: Gate4Compiler,
		path: String,
		declaration: String,
		binding: String,
		kind: Integer,
		line: Integer,
	): Integer
	import_index := state.import_count[0]
	gate4_store_integer(state.import_modules, import_index, state.active_module[0])
	gate4_store_string(state.import_paths, import_index, path)
	gate4_store_string(state.import_symbols, import_index, binding)
	gate4_store_string(state.import_declarations, import_index, declaration)
	gate4_store_integer(state.import_kinds, import_index, kind)
	gate4_store_integer(state.import_lines, import_index, line)
	gate4_store_integer(state.import_targets, import_index, - 1)
	gate4_store_integer(state.import_used, import_index, 0)
	state.import_count[0] = import_index + 1
	return import_index
end

def gate4_parse_named_import(mut state: Gate4Compiler, mut position: Array<Integer>, line: Integer): Boolean
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	import_start := state.import_count[0]
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], "}")
			finished = true
		else
			symbol_line := gate4_load_integer(state.token_lines, position[0])
			declaration := gate4_expect_identifier(state, position)
			if gate4_has_diagnostic(state)
				return false
			end
			gate4_skip_newlines(state, position)
			mut binding := declaration
			if gate4_token_is(state, position[0], "as")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
				binding = gate4_expect_identifier(state, position)
				if gate4_has_diagnostic(state)
					return false
				end
				gate4_skip_newlines(state, position)
			end
			gate4_append_import(state, "", declaration, binding, 0, symbol_line)
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	if state.import_count[0] == import_start
		gate4_diagnostic(state, "TRBN4002", line, "named import must contain at least one declaration")
		return false
	end
	if !gate4_expect(state, position, "}")
		return false
	end
	gate4_skip_newlines(state, position)
	if !gate4_expect(state, position, "from")
		return false
	end
	mut path := ""
	while gate4_load_integer(state.token_kinds, position[0]) != 4
		if gate4_terminal_token(state, position[0])
			if path == ""
				gate4_diagnostic(state, "TRBN4002", line, "import path is required")
				return false
			end
			mut terminal_index := import_start
			while terminal_index < state.import_count[0]
				gate4_store_string(state.import_paths, terminal_index, path)
				terminal_index += 1
			end
			return true
		end
		path += gate4_load_string(state.token_texts, position[0])
		gate4_advance(position)
	end
	if path == ""
		gate4_diagnostic(state, "TRBN4002", line, "import path is required")
		return false
	end
	mut import_index := import_start
	while import_index < state.import_count[0]
		gate4_store_string(state.import_paths, import_index, path)
		import_index += 1
	end
	return gate4_finish_statement(state, position)
end

def gate4_parse_bare_import(mut state: Gate4Compiler, mut position: Array<Integer>, line: Integer): Boolean
	mut path := ""
	mut scanning := true
	while scanning
		if gate4_terminal_token(state, position[0])
			scanning = false
		else
			if gate4_load_integer(state.token_kinds, position[0]) == 4
				scanning = false
			else
				if gate4_token_is(state, position[0], "as")
					scanning = false
				else
					path += gate4_load_string(state.token_texts, position[0])
					gate4_advance(position)
				end
			end
		end
	end
	if path == ""
		gate4_diagnostic(state, "TRBN4002", line, "bare import path is required")
		return false
	end
	mut binding := ""
	if gate4_token_is(state, position[0], "as")
		gate4_advance(position)
		binding = gate4_expect_identifier(state, position)
		if gate4_has_diagnostic(state)
			return false
		end
	end
	gate4_append_import(state, path, "", binding, 1, line)
	return gate4_finish_statement(state, position)
end

def gate4_parse_module(mut state: Gate4Compiler, start: Integer, module_index: Integer): Boolean
	state.active_module[0] = module_index
	import_start := state.import_count[0]
	gate4_store_integer(state.module_import_starts, module_index, import_start)
	gate4_store_integer(state.module_import_counts, module_index, 0)
	mut position := [start]
	gate4_skip_newlines(state, position)
	while !gate4_terminal_token(state, position[0])
		if gate4_token_is(state, position[0], "import")
			line := gate4_load_integer(state.token_lines, position[0])
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			if gate4_token_is(state, position[0], "{")
				gate4_parse_named_import(state, position, line)
			else
				gate4_parse_bare_import(state, position, line)
			end
		else
			if gate4_token_is(state, position[0], "record")
				gate4_parse_record(state, position)
			else
				if gate4_token_is(state, position[0], "def")
					gate4_parse_function(state, position)
				else
					gate4_diagnostic(
						state,
						"TRBN4002",
						gate4_load_integer(state.token_lines, position[0]),
						"unsupported top-level declaration " + gate4_load_string(state.token_texts, position[0]),
					)
				end
			end
		end
		if gate4_has_diagnostic(state)
			return false
		end
		gate4_store_integer(
			state.module_import_counts,
			module_index,
			state.import_count[0] - import_start,
		)
		gate4_skip_newlines(state, position)
	end
	gate4_store_integer(
		state.module_import_counts,
		module_index,
		state.import_count[0] - import_start,
	)
	return true
end

def gate4_import_path_value(raw: String): String
	mut path := gate4_string_without_suffix(raw, ".trb")
	if path == ""
		return ""
	end
	if path[0] == "/"
		return ""
	end
	mut simple := true
	mut simple_index := 0
	while simple_index < path.size()
		character := path[simple_index]
		if character == ":"
			simple = false
		end
		if character == "/"
			simple = false
		end
		if character == "."
			simple = false
		end
		simple_index += 1
	end
	if simple
		return path
	end
	mut segments: Array<String> := []
	mut segment := ""
	mut index := 0
	while index <= path.size()
		mut character := "/"
		if index < path.size()
			character = path[index]
		end
		if character == ":"
			return ""
		end
		if character == "/"
			if segment == ".."
				return ""
			end
			if segment != ""
				if segment != "."
					segments.push(segment)
				end
			end
			segment = ""
		else
			segment += character
		end
		index += 1
	end
	if segments.size() == 0
		return ""
	end
	mut normalized := ""
	index = 0
	while index < segments.size()
		if normalized != ""
			normalized += "/"
		end
		normalized += segments[index]
		index += 1
	end
	return normalized
end

def gate4_normalize_import_path(mut state: Gate4Compiler, raw: String, line: Integer): String
	normalized := gate4_import_path_value(raw)
	if normalized == ""
		gate4_diagnostic(state, "TRBN4003", line, "invalid project import path " + raw)
	end
	return normalized
end

def gate4_ascii_fold(value: String): String
	upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	lower := "abcdefghijklmnopqrstuvwxyz"
	mut result := ""
	mut index := 0
	while index < value.size()
		character := value[index]
		mut folded := character
		mut letter := 0
		while letter < upper.size()
			if upper[letter] == character
				folded = lower[letter]
				letter = upper.size()
			else
				letter += 1
			end
		end
		result += folded
		index += 1
	end
	return result
end

def gate4_path_root_key(name: String): String
	mut without_underscores := ""
	mut index := 0
	while index < name.size()
		if name[index] != "_"
			without_underscores += name[index]
		end
		index += 1
	end
	return gate4_ascii_fold(without_underscores)
end

def gate4_import_root_segment(module_name: String): String
	mut logical := module_name
	if gate4_path_basename(logical) == "index"
		logical = gate4_path_directory(logical)
	end
	return gate4_path_basename(logical)
end

def gate4_standard_package_target(path: String): Integer
	if path == "trb/std/process"
		return - 2
	end
	if path == "trb/std/math"
		return - 3
	end
	return - 1
end

def gate4_standard_package_root(target: Integer): String
	if target == - 2
		return "Process"
	end
	return "Math"
end

def gate4_standard_package_import(
		mut state: Gate4Compiler,
		module_index: Integer,
		name: String,
	): Integer
	import_index := gate4_find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := gate4_load_integer(state.import_targets, import_index)
	if target < - 1
		gate4_store_integer(state.import_used, import_index, 1)
	end
	return target
end

def gate4_project_error_state(path: String, line: Integer, message: String): Gate4Compiler
	mut state := gate4_compiler_new(1024)
	module_index := gate4_add_module(state, "trbconfig", path)
	state.entry_module[0] = module_index
	state.active_module[0] = module_index
	gate4_diagnostic(state, "TRBN4010", line, message)
	return state
end

def gate4_project_join(root: String, relative: String): String
	if relative == "."
		return root
	end
	return gate4_path_join(root, relative)
end

def gate4_project_module_name(
		mut state: Gate4Compiler,
		source_root: String,
		path: String,
	): String
	mut prefix := source_root
	if prefix != "/"
		prefix += "/"
	end
	if !gate4_string_starts_with(path, prefix)
		gate4_diagnostic(state, "TRBN4010", 1, "project source is outside configured sourceDir")
	else
		if !gate4_string_ends_with(path, ".trb")
			gate4_diagnostic(state, "TRBN4010", 1, "project source does not end in .trb")
		else
			name := gate4_source_slice(path, prefix.size(), path.size() - 4)
			if name != ""
				return name
			end
			gate4_diagnostic(
				state,
				"TRBN4010",
				1,
				"project source has an empty module name",
			)
		end
	end
	return ""
end

def gate4_string_starts_at(value: String, start: Integer, prefix: String): Boolean
	mut index := 0
	while index < prefix.size()
		if value[start + index] != prefix[index]
			return false
		end
		index += 1
	end
	return true
end

def gate4_project_source_declares_main(source: String): Boolean
	mut index := 0
	while index + 9 <= source.size()
		if gate4_string_starts_at(source, index, "def main(")
			if index == 0
				return true
			end
			if source[index - 1] == "\n"
				return true
			end
		end
		index += 1
	end
	return false
end

def gate4_project_append_import_target(
		module_names: Gate4StringStorage,
		module_lookup: Gate4SymbolIndex,
		normalized: String,
		mut order: Array<Integer>,
		mut included: Array<Integer>,
	): Array<Integer>
	mut target := gate4_find_name(module_lookup, module_names, normalized)
	if target < 0
		target = gate4_find_name(module_lookup, module_names, normalized + "/index")
	end
	if target >= 0
		if included[target] == 0
			order.push(target)
			included[target] = 1
		end
	end
	return order
end

def gate4_project_bare_import_path(raw: String): String
	mut finish := raw.size()
	mut index := 0
	while index < raw.size()
		if raw[index] == " "
			finish = index
			index = raw.size()
		else
			if raw[index] == "\t"
				finish = index
				index = raw.size()
			else
				index += 1
			end
		end
	end
	return gate4_source_slice(raw, 0, finish)
end

def gate4_project_append_imports(
		module_names: Gate4StringStorage,
		module_lookup: Gate4SymbolIndex,
		source: String,
		mut order: Array<Integer>,
		mut included: Array<Integer>,
	): Array<Integer>
	mut index := 0
	while index + 6 <= source.size()
		if gate4_string_starts_at(source, index, " from ")
			mut cursor := index + 6
			mut collecting := true
			while collecting
				if cursor >= source.size()
					collecting = false
				else
					if source[cursor] == "\n"
						collecting = false
					else
						cursor += 1
					end
				end
			end
			raw := gate4_source_slice(source, index + 6, cursor)
			normalized := gate4_import_path_value(raw)
			order = gate4_project_append_import_target(
				module_names,
				module_lookup,
				normalized,
				order,
				included,
			)
			index = cursor
		end
		index += 1
	end
	index = 0
	while index + 7 <= source.size()
		mut line_start := index == 0
		if index > 0
			if source[index - 1] == "\n"
				line_start = true
			end
		end
		if line_start
			if gate4_string_starts_at(source, index, "import ")
				cursor := index + 7
				if cursor < source.size()
					if source[cursor] != "{"
						mut line_finish := cursor
						mut scanning := true
						while scanning
							if line_finish >= source.size()
								scanning = false
							else
								if source[line_finish] == "\n"
									scanning = false
								else
									line_finish += 1
								end
							end
						end
						raw := gate4_source_slice(source, cursor, line_finish)
						path := gate4_project_bare_import_path(raw)
						normalized := gate4_import_path_value(path)
						order = gate4_project_append_import_target(
							module_names,
							module_lookup,
							normalized,
							order,
							included,
						)
					end
				end
			end
		end
		index += 1
	end
	return order
end

def gate4_order_project_sources(source_root: String, bundle: Gate4ProjectSources): Gate4ProjectSources
	mut entry :=- 1
	mut included: Array<Integer> := []
	mut module_names := gate4_string_storage(bundle.paths.size())
	mut module_lookup := gate4_symbol_index_new(bundle.paths.size() * 4 + 16)
	mut prefix_size := source_root.size()
	if source_root != "/"
		prefix_size += 1
	end
	mut index := 0
	while index < bundle.paths.size()
		included.push(0)
		name := gate4_source_slice(
			bundle.paths[index],
			prefix_size,
			bundle.paths[index].size() - 4,
		)
		gate4_store_string(module_names, index, name)
		gate4_add_name_index(module_lookup, module_names, index + 1)
		if gate4_project_source_declares_main(bundle.sources[index])
			entry = index
		end
		index += 1
	end
	if entry < 0
		return bundle
	end

	mut order := [entry]
	included[entry] = 1
	mut cursor := 0
	while cursor < order.size()
		order = gate4_project_append_imports(
			module_names,
			module_lookup,
			bundle.sources[order[cursor]],
			order,
			included,
		)
		cursor += 1
	end
	index = 0
	while index < bundle.paths.size()
		if included[index] == 0
			order.push(index)
		end
		index += 1
	end

	mut paths: Array<String> := []
	mut sources: Array<String> := []
	index = 0
	while index < order.size()
		paths.push(bundle.paths[order[index]])
		sources.push(bundle.sources[order[index]])
		index += 1
	end
	return Gate4ProjectSources.new(paths: paths, sources: sources, error: "")
end

def gate4_project_select_entry(mut state: Gate4Compiler): Boolean
	mut entry :=- 1
	mut function_index := 0
	while function_index < state.function_count[0]
		if gate4_load_string(state.function_names, function_index) == "main"
			module_index := gate4_load_integer(state.function_modules, function_index)
			if entry >= 0
				state.active_module[0] = module_index
				gate4_diagnostic(
					state,
					"TRBN4010",
					gate4_load_integer(state.function_lines, function_index),
					"project has more than one top-level main function",
				)
				return false
			end
			entry = module_index
		end
		function_index += 1
	end
	if entry < 0
		state.active_module[0] = 0
		gate4_diagnostic(state, "TRBN4010", 1, "project must declare exactly one top-level main function")
		return false
	end
	state.entry_module[0] = entry
	state.active_module[0] = entry
	return true
end

def gate4_project_module_acyclic(mut state: Gate4Compiler, module_index: Integer): Boolean
	color := gate4_load_integer(state.function_lookup.next, module_index)
	if color > 0
		return color == 2
	end
	gate4_store_integer(state.function_lookup.next, module_index, 1)
	mut import_index := gate4_load_integer(state.module_import_starts, module_index)
	import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
	while import_index < import_end
		target := gate4_load_integer(state.import_targets, import_index)
		if target >= 0
			if !gate4_project_module_acyclic(state, target)
				return false
			end
		end
		import_index += 1
	end
	gate4_store_integer(state.function_lookup.next, module_index, 2)
	return true
end

def gate4_project_import_graph_acyclic(mut state: Gate4Compiler): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		gate4_store_integer(state.function_lookup.next, module_index, 0)
		module_index += 1
	end
	module_index = 0
	while module_index < state.module_count[0]
		if !gate4_project_module_acyclic(state, module_index)
			return false
		end
		module_index += 1
	end
	return true
end

def gate4_module_root_peer(name: String): String
	if gate4_string_ends_with(name, "/index")
		return gate4_string_without_suffix(name, "/index")
	end
	return name + "/index"
end

def gate4_validate_project_module_roots(mut state: Gate4Compiler): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		name := gate4_load_string(state.module_names, module_index)
		peer_name := gate4_module_root_peer(name)
		peer := gate4_find_module(state, peer_name)
		if peer >= 0
			if peer < module_index
				state.active_module[0] = module_index
				gate4_diagnostic(
					state,
					"TRBN4003",
					1,
					"module paths " + name + " and " + peer_name + " define the same import root",
				)
				return false
			end
		end
		module_index += 1
	end
	return true
end

def gate4_validate_new_module_root(mut state: Gate4Compiler, name: String, line: Integer): Boolean
	peer_name := gate4_module_root_peer(name)
	if gate4_find_module(state, peer_name) >= 0
		gate4_diagnostic(
			state,
			"TRBN4003",
			line,
			"module paths " + name + " and " + peer_name + " define the same import root",
		)
		return false
	end
	return true
end

def gate4_resolve_project_imports(mut state: Gate4Compiler): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := gate4_load_string(state.import_paths, import_index)
			line := gate4_load_integer(state.import_lines, import_index)
			normalized := gate4_normalize_import_path(state, raw_path, line)
			if gate4_has_diagnostic(state)
				return false
			end
			mut target := gate4_standard_package_target(normalized)
			if target < - 1
				if gate4_load_integer(state.import_kinds, import_index) != 1
					gate4_diagnostic(state, "TRBN4003", line, "supported standard packages require a bare import")
					return false
				end
			else
				if normalized == "trb"
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return false
				end
				if gate4_string_starts_with(normalized, "trb/")
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return false
				end
				target = gate4_find_module(state, normalized)
				if target < 0
					target = gate4_find_module(state, normalized + "/index")
				end
				if target < 0
					gate4_diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
					return false
				end
			end
			gate4_store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	if !gate4_project_import_graph_acyclic(state)
		module_index = 0
		while module_index < state.module_count[0]
			mut import_index := gate4_load_integer(state.module_import_starts, module_index)
			import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
			while import_index < import_end
				state.active_module[0] = module_index
				target := gate4_load_integer(state.import_targets, import_index)
				if target >= 0
					if gate4_module_reaches(state, target, module_index)
						raw_path := gate4_load_string(state.import_paths, import_index)
						line := gate4_load_integer(state.import_lines, import_index)
						gate4_diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
						return false
					end
				end
				import_index += 1
			end
			module_index += 1
		end
	end
	state.active_module[0] = state.entry_module[0]
	return true
end

def gate4_load_configured_project(config_source: String, config_path: String): Gate4Compiler
	config := gate4_parse_project_config(config_source)
	if config.error != ""
		return gate4_project_error_state(config_path, config.error_line, config.error)
	end
	root := gate4_path_directory(config_path)
	source_root := gate4_project_join(root, config.source_dir)
	out_root := gate4_project_join(root, config.out_dir)
	bundle := gate4_collect_project_sources(source_root, out_root)
	if bundle.error != ""
		return gate4_project_error_state(config_path, 1, "cannot collect project source " + bundle.error)
	end
	return gate4_load_project_sources(config_path, source_root, bundle)
end

def gate4_load_project_sources(
		config_path: String,
		source_root: String,
		bundle: Gate4ProjectSources,
	): Gate4Compiler
	if bundle.paths.size() == 0
		return gate4_project_error_state(config_path, 1, "no production .trb files found")
	end
	if bundle.paths.size() != bundle.sources.size()
		return gate4_project_error_state(config_path, 1, "project source adapter returned mismatched paths and sources")
	end
	ordered := gate4_order_project_sources(source_root, bundle)
	mut state := gate4_compiler_new(4194304)
	mut module_index := 0
	while module_index < ordered.paths.size()
		state.active_module[0] = module_index
		name := gate4_project_module_name(state, source_root, ordered.paths[module_index])
		if gate4_has_diagnostic(state)
			return state
		end
		gate4_add_module(state, name, ordered.paths[module_index])
		module_index += 1
	end
	if !gate4_validate_project_module_roots(state)
		return state
	end
	module_index = 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		gate4_lex_module(state, ordered.sources[module_index], module_index)
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, start, module_index)
		end
		if gate4_has_diagnostic(state)
			return state
		end
		module_index += 1
	end
	if !gate4_project_select_entry(state)
		return state
	end
	gate4_resolve_project_imports(state)
	return state
end

def gate4_module_reaches(state: Gate4Compiler, start: Integer, goal: Integer): Boolean
	if start == goal
		return true
	end
	mut visited: Array<Integer> := []
	mut index := 0
	while index < state.module_count[0]
		visited.push(0)
		index += 1
	end
	mut queue := [start]
	visited[start] = 1
	mut cursor := 0
	while cursor < queue.size()
		module_index := queue[cursor]
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			target := gate4_load_integer(state.import_targets, import_index)
			if target == goal
				return true
			end
			if target >= 0
				if visited[target] == 0
					visited[target] = 1
					queue.push(target)
				end
			end
			import_index += 1
		end
		cursor += 1
	end
	return false
end

def gate4_load_file_root(entry_source: String, entry_path: String): Gate4Compiler
	mut state := gate4_compiler_new(4194304)
	root := gate4_path_directory(entry_path)
	entry_name := gate4_string_without_suffix(gate4_path_basename(entry_path), ".trb")
	entry_module := gate4_add_module(state, entry_name, entry_path)
	state.entry_module[0] = entry_module
	mut sources := [entry_source]
	mut module_index := 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		gate4_lex_module(state, sources[module_index], module_index)
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, start, module_index)
		end
		if gate4_has_diagnostic(state)
			return state
		end
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := gate4_load_string(state.import_paths, import_index)
			line := gate4_load_integer(state.import_lines, import_index)
			normalized := gate4_normalize_import_path(state, raw_path, line)
			if gate4_has_diagnostic(state)
				return state
			end
			mut target := gate4_standard_package_target(normalized)
			mut target_added := false
			if target < - 1
				if gate4_load_integer(state.import_kinds, import_index) != 1
					gate4_diagnostic(state, "TRBN4003", line, "supported standard packages require a bare import")
					return state
				end
			else
				if normalized == "trb"
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return state
				end
				if gate4_string_starts_with(normalized, "trb/")
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return state
				end
				target = gate4_find_module(state, normalized)
			end
			if target == - 1
				direct_path := gate4_path_join(root, normalized + ".trb")
				if gate4_file_exists(direct_path)
					if !gate4_validate_new_module_root(state, normalized, line)
						return state
					end
					target = gate4_add_module(state, normalized, direct_path)
					sources.push(gate4_read_source(direct_path))
					target_added = true
				else
					index_name := normalized + "/index"
					target = gate4_find_module(state, index_name)
					if target < 0
						index_path := gate4_path_join(root, normalized + "/index.trb")
						if !gate4_file_exists(index_path)
							gate4_diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
							return state
						end
						if !gate4_validate_new_module_root(state, index_name, line)
							return state
						end
						target = gate4_add_module(state, index_name, index_path)
						sources.push(gate4_read_source(index_path))
						target_added = true
					end
				end
			end
			if !target_added
				if target >= 0
					if gate4_module_reaches(state, target, module_index)
						gate4_diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
						return state
					end
				end
			end
			gate4_store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	state.active_module[0] = state.entry_module[0]
	return state
end

def gate4_find_record_in_module(state: Gate4Compiler, module_index: Integer, name: String): Integer
	mut index := state.record_count[0] - 1
	while index >= 0
		if gate4_load_integer(state.record_modules, index) == module_index
			if gate4_load_string(state.record_names, index) == name
				return index
			end
		end
		index -= 1
	end
	return - 1
end

def gate4_find_function_in_module(state: Gate4Compiler, module_index: Integer, name: String): Integer
	return gate4_find_symbol(state.function_lookup, state.function_modules, state.function_names, module_index, name)
end

def gate4_find_import_binding(state: Gate4Compiler, module_index: Integer, name: String): Integer
	start := gate4_load_integer(state.module_import_starts, module_index)
	mut index := start + gate4_load_integer(state.module_import_counts, module_index) - 1
	while index >= start
		if gate4_load_string(state.import_symbols, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def gate4_find_visible_record(mut state: Gate4Compiler, module_index: Integer, name: String): Integer
	local := gate4_find_record_in_module(state, module_index, name)
	if local >= 0
		return local
	end
	import_index := gate4_find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := gate4_load_integer(state.import_targets, import_index)
	if target < 0
		return - 1
	end
	declaration := gate4_load_string(state.import_declarations, import_index)
	resolved := gate4_find_record_in_module(state, target, declaration)
	if resolved >= 0
		gate4_store_integer(state.import_used, import_index, 1)
	end
	return resolved
end

def gate4_find_visible_function(mut state: Gate4Compiler, module_index: Integer, name: String): Integer
	local := gate4_find_function_in_module(state, module_index, name)
	if local >= 0
		return local
	end
	import_index := gate4_find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := gate4_load_integer(state.import_targets, import_index)
	if target < 0
		return - 1
	end
	declaration := gate4_load_string(state.import_declarations, import_index)
	resolved := gate4_find_function_in_module(state, target, declaration)
	if resolved >= 0
		gate4_store_integer(state.import_used, import_index, 1)
	end
	return resolved
end

def gate4_record_type(record_index: Integer): String
	return "Record#" + gate4_integer_string(record_index)
end

def gate4_find_record_type(state: Gate4Compiler, type_name: String): Integer
	mut found :=- 1
	mut index := 0
	while index < state.record_count[0]
		if gate4_record_type(index) == type_name
			found = index
		end
		index += 1
	end
	return found
end

def gate4_type_display(state: Gate4Compiler, type_name: String): String
	record_index := gate4_find_record_type(state, type_name)
	if record_index >= 0
		return gate4_load_string(state.record_names, record_index)
	end
	return type_name
end

def gate4_find_field(state: Gate4Compiler, record_index: Integer, name: String): Integer
	start := gate4_load_integer(state.record_field_starts, record_index)
	mut index := start + gate4_load_integer(state.record_field_counts, record_index) - 1
	while index >= start
		if gate4_load_string(state.field_names, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def gate4_builtin_type_exists(type_name: String, allow_void: Boolean): Boolean
	if type_name == "Integer"
		return true
	end
	if type_name == "Float"
		return true
	end
	if type_name == "Boolean"
		return true
	end
	if type_name == "String"
		return true
	end
	if type_name == "Void"
		return allow_void
	end
	if gate4_array_element_type(type_name) != ""
		return true
	end
	return false
end

def gate4_resolve_type_name(
		mut state: Gate4Compiler,
		module_index: Integer,
		type_name: String,
		allow_void: Boolean,
	): String
	if gate4_builtin_type_exists(type_name, allow_void)
		return type_name
	end
	record_index := gate4_find_visible_record(state, module_index, type_name)
	if record_index >= 0
		return gate4_record_type(record_index)
	end
	return ""
end

def gate4_array_element_type(type_name: String): String
	if type_name == "Array<Integer>"
		return "Integer"
	end
	if type_name == "Array<String>"
		return "String"
	end
	if type_name == "Array<Float>"
		return "Float"
	end
	if type_name == "Array<Array<Integer>>"
		return "Array<Integer>"
	end
	if type_name == "Array<Array<String>>"
		return "Array<String>"
	end
	if type_name == "Array<Array<Float>>"
		return "Array<Float>"
	end
	if type_name == "Array<Array<Array<Integer>>>"
		return "Array<Array<Integer>>"
	end
	if type_name == "Array<Array<Array<String>>>"
		return "Array<Array<String>>"
	end
	if type_name == "Array<Array<Array<Float>>>"
		return "Array<Array<Float>>"
	end
	return ""
end

def gate4_array_type(element_type: String): String
	result := "Array<" + element_type + ">"
	if gate4_builtin_type_exists(result, false)
		return result
	end
	return ""
end

def gate4_common_array_element_type(left: String, right: String): String
	if left == ""
		return right
	end
	if left == right
		return left
	end
	if left == "Integer"
		if right == "Float"
			return "Float"
		end
	end
	if left == "Float"
		if right == "Integer"
			return "Float"
		end
	end
	return ""
end

def gate4_local_find(locals: Gate4Locals, name: String): Integer
	mut index := locals.count[0] - 1
	while index >= 0
		if gate4_load_string(locals.names, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def gate4_local_add(
		mut state: Gate4Compiler,
		mut locals: Gate4Locals,
		name: String,
		type_name: String,
		mutable: Integer,
		line: Integer,
	): Boolean
	if gate4_local_find(locals, name) >= 0
		gate4_diagnostic(state, "TRBN4003", line, "duplicate local declaration " + name)
		return false
	end
	index := locals.count[0]
	gate4_store_string(locals.names, index, name)
	gate4_store_string(locals.types, index, type_name)
	gate4_store_integer(locals.mutable, index, mutable)
	locals.count[0] = index + 1
	return true
end

def gate4_resolution_local_add(
		mut locals: Gate4Locals,
		name: String,
		type_name: String,
		mutable: Integer,
	)
	if gate4_local_find(locals, name) < 0
		index := locals.count[0]
		gate4_store_string(locals.names, index, name)
		gate4_store_string(locals.types, index, type_name)
		gate4_store_integer(locals.mutable, index, mutable)
		locals.count[0] = index + 1
	end
	return
end

def gate4_resolution_keyword(name: String): Boolean
	mut keyword := false
	if name == "if"
		keyword = true
	end
	if name == "else"
		keyword = true
	end
	if name == "end"
		keyword = true
	end
	if name == "while"
		keyword = true
	end
	if name == "return"
		keyword = true
	end
	if name == "mut"
		keyword = true
	end
	if name == "true"
		keyword = true
	end
	if name == "false"
		keyword = true
	end
	return keyword
end

def gate4_is_typed_local_declaration(state: Gate4Compiler, index: Integer): Boolean
	mut found := false
	mut scanning := true
	mut cursor := index + 2
	while scanning
		if gate4_terminal_token(state, cursor)
			scanning = false
		else
			if gate4_load_integer(state.token_kinds, cursor) == 4
				scanning = false
			else
				if gate4_token_is(state, cursor, ":=")
					found = true
					scanning = false
				else
					if gate4_token_is(state, cursor, ",")
						scanning = false
					else
						if gate4_token_is(state, cursor, ")")
							scanning = false
						else
							cursor += 1
						end
					end
				end
			end
		end
	end
	return found
end

def gate4_resolve_bare_imports(mut state: Gate4Compiler): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		if gate4_load_integer(state.import_kinds, import_index) == 1
			module_index := gate4_load_integer(state.import_modules, import_index)
			state.active_module[0] = module_index
			mut target := gate4_load_integer(state.import_targets, import_index)
			line := gate4_load_integer(state.import_lines, import_index)
			if target == - 1
				target = gate4_standard_package_target(
					gate4_import_path_value(gate4_load_string(state.import_paths, import_index)),
				)
				if target < - 1
					gate4_store_integer(state.import_targets, import_index, target)
				end
			end
			if target < 0
				if target < - 1
					declaration := gate4_standard_package_root(target)
					gate4_store_string(state.import_declarations, import_index, declaration)
					if gate4_load_string(state.import_symbols, import_index) == ""
						gate4_store_string(state.import_symbols, import_index, declaration)
					end
				else
					gate4_diagnostic(state, "TRBN4003", line, "bare import target is unresolved")
					return false
				end
			else
				segment := gate4_import_root_segment(gate4_load_string(state.module_names, target))
				wanted := gate4_path_root_key(segment)
				mut matches := 0
				mut declaration := ""
				mut candidates := ""
				mut record_index := 0
				while record_index < state.record_count[0]
					if gate4_load_integer(state.record_modules, record_index) == target
						name := gate4_load_string(state.record_names, record_index)
						if gate4_ascii_fold(name) == wanted
							if candidates != ""
								candidates += ", "
							end
							candidates += name
							declaration = name
							matches += 1
						end
					end
					record_index += 1
				end
				raw_path := gate4_load_string(state.import_paths, import_index)
				if matches == 0
					mut matching_function := false
					mut function_index := 0
					while function_index < state.function_count[0]
						if gate4_load_integer(state.function_modules, function_index) == target
							name := gate4_load_string(state.function_names, function_index)
							if gate4_ascii_fold(name) == wanted
								matching_function = true
							end
						end
						function_index += 1
					end
					if matching_function
						gate4_diagnostic(
							state,
							"TRBN4003",
							line,
							"import " + raw_path + " matches only a top-level function; use an exact named import",
						)
					else
						gate4_diagnostic(
							state,
							"TRBN4003",
							line,
							"import " + raw_path + " has no record root declaration matching " + segment,
						)
					end
					return false
				end
				if matches > 1
					gate4_diagnostic(
						state,
						"TRBN4003",
						line,
						"import " + raw_path + " has multiple record root declarations matching " + segment + ": " + candidates + "; use an exact named import",
					)
					return false
				end
				gate4_store_string(state.import_declarations, import_index, declaration)
				if gate4_load_string(state.import_symbols, import_index) == ""
					gate4_store_string(state.import_symbols, import_index, declaration)
				end
			end
		end
		import_index += 1
	end
	return true
end

def gate4_validate_import_bindings(mut state: Gate4Compiler): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		module_index := gate4_load_integer(state.import_modules, import_index)
		state.active_module[0] = module_index
		name := gate4_load_string(state.import_symbols, import_index)
		declaration := gate4_load_string(state.import_declarations, import_index)
		line := gate4_load_integer(state.import_lines, import_index)
		target := gate4_load_integer(state.import_targets, import_index)
		mut other := gate4_load_integer(state.module_import_starts, module_index)
		while other < import_index
			other_target := gate4_load_integer(state.import_targets, other)
			other_declaration := gate4_load_string(state.import_declarations, other)
			if target >= 0
				if other_target == target
					if other_declaration == declaration
						gate4_diagnostic(
							state,
							"TRBN4003",
							line,
							"declaration " + declaration + " from " + gate4_load_string(state.module_names, target) + " is already imported as " + gate4_load_string(state.import_symbols, other),
						)
					end
				end
			end
			if !gate4_has_diagnostic(state)
				if gate4_load_string(state.import_symbols, other) == name
					gate4_diagnostic(state, "TRBN4003", line, "duplicate import binding " + name)
				end
			end
			other += 1
		end
		if gate4_find_record_in_module(state, module_index, name) >= 0
			gate4_diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		if gate4_find_function_in_module(state, module_index, name) >= 0
			gate4_diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		mut exported := target < - 1
		if target >= 0
			if gate4_find_record_in_module(state, target, declaration) >= 0
				exported = true
			end
			if gate4_find_function_in_module(state, target, declaration) >= 0
				exported = true
			end
		end
		if !exported
			gate4_diagnostic(state, "TRBN4003", line, "module does not export " + declaration)
		end
		import_index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_validate_import_usage(mut state: Gate4Compiler): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		if gate4_load_integer(state.import_used, import_index) == 0
			state.active_module[0] = gate4_load_integer(state.import_modules, import_index)
			gate4_diagnostic(
				state,
				"TRBN4003",
				gate4_load_integer(state.import_lines, import_index),
				"unused import " + gate4_load_string(state.import_symbols, import_index),
			)
		end
		import_index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_resolve_declarations(mut state: Gate4Compiler): Boolean
	if !gate4_validate_import_bindings(state)
		return false
	end
	mut record_index := 0
	while record_index < state.record_count[0]
		module_index := gate4_load_integer(state.record_modules, record_index)
		state.active_module[0] = module_index
		mut other_record := record_index - 1
		while other_record >= 0
			if gate4_load_integer(state.record_modules, other_record) != module_index
				other_record =- 1
			else
				if gate4_load_string(state.record_names, other_record) == gate4_load_string(state.record_names, record_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.record_lines, record_index),
						"duplicate record declaration " + gate4_load_string(state.record_names, record_index),
					)
				end
				other_record -= 1
			end
		end
		start := gate4_load_integer(state.record_field_starts, record_index)
		finish := start + gate4_load_integer(state.record_field_counts, record_index)
		mut field_index := start
		while field_index < finish
			mut other_field := start
			while other_field < field_index
				if gate4_load_string(state.field_names, other_field) == gate4_load_string(state.field_names, field_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.field_lines, field_index),
						"duplicate field declaration " + gate4_load_string(state.field_names, field_index),
					)
				end
				other_field += 1
			end
			raw_type := gate4_load_string(state.field_types, field_index)
			resolved_type := gate4_resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.field_lines, field_index), "unknown field type " + raw_type)
			else
				gate4_store_string(state.field_types, field_index, resolved_type)
			end
			field_index += 1
		end
		record_index += 1
	end
	mut main_count := 0
	mut function_index := 0
	while function_index < state.function_count[0]
		module_index := gate4_load_integer(state.function_modules, function_index)
		state.active_module[0] = module_index
		if module_index == state.entry_module[0]
			if gate4_load_string(state.function_names, function_index) == "main"
				main_count += 1
				if gate4_load_integer(state.function_parameter_counts, function_index) != 0
					gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.function_lines, function_index), "main must take no parameters")
				end
				if gate4_load_string(state.function_result_types, function_index) != "Void"
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.function_lines, function_index),
						"main must return Void, found " + gate4_load_string(state.function_result_types, function_index),
					)
				end
			end
		end
		mut other_function := function_index - 1
		while other_function >= 0
			if gate4_load_integer(state.function_modules, other_function) != module_index
				other_function =- 1
			else
				if gate4_load_string(state.function_names, other_function) == gate4_load_string(state.function_names, function_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.function_lines, function_index),
						"duplicate function declaration " + gate4_load_string(state.function_names, function_index),
					)
				end
				other_function -= 1
			end
		end
		parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
		parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
		mut parameter_index := parameter_start
		while parameter_index < parameter_finish
			mut other_parameter := parameter_start
			while other_parameter < parameter_index
				if gate4_load_string(state.parameter_names, other_parameter) == gate4_load_string(state.parameter_names, parameter_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.parameter_lines, parameter_index),
						"duplicate parameter declaration " + gate4_load_string(state.parameter_names, parameter_index),
					)
				end
				other_parameter += 1
			end
			raw_type := gate4_load_string(state.parameter_types, parameter_index)
			resolved_type := gate4_resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.parameter_lines, parameter_index), "unknown parameter type " + raw_type)
			else
				gate4_store_string(state.parameter_types, parameter_index, resolved_type)
			end
			parameter_index += 1
		end
		raw_result := gate4_load_string(state.function_result_types, function_index)
		resolved_result := gate4_resolve_type_name(state, module_index, raw_result, true)
		if resolved_result == ""
			gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.function_lines, function_index), "unknown result type " + raw_result)
		else
			gate4_store_string(state.function_result_types, function_index, resolved_result)
		end
		function_index += 1
	end
	if main_count != 1
		state.active_module[0] = state.entry_module[0]
		gate4_diagnostic(state, "TRBN4003", 1, "program must declare exactly one main function")
	end
	return !gate4_has_diagnostic(state)
end

def gate4_resolve_function_body(
		mut state: Gate4Compiler,
		function_index: Integer,
		mut locals: Gate4Locals,
	): Boolean
	module_index := gate4_load_integer(state.function_modules, function_index)
	state.active_module[0] = module_index
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		gate4_resolution_local_add(
			locals,
			gate4_load_string(state.parameter_names, parameter_index),
			gate4_load_string(state.parameter_types, parameter_index),
			gate4_load_integer(state.parameter_mutable, parameter_index),
		)
		parameter_index += 1
	end
	mut index := gate4_load_integer(state.function_body_starts, function_index)
	finish := gate4_load_integer(state.function_body_ends, function_index)
	mut skipping_type := false
	while index < finish
		kind := gate4_load_integer(state.token_kinds, index)
		text := gate4_load_string(state.token_texts, index)
		if skipping_type
			if gate4_token_is(state, index, ":=")
				skipping_type = false
			end
		else
			if kind == 1
				if gate4_resolution_keyword(text)
				else
					mut previous := ""
					if index > gate4_load_integer(state.function_body_starts, function_index)
						previous = gate4_load_string(state.token_texts, index - 1)
					end
					if previous == "."
					else
						if gate4_token_is(state, index + 1, ":=")
							gate4_resolution_local_add(locals, text, "", 0)
						else
							if gate4_token_is(state, index + 1, ":")
								if gate4_is_typed_local_declaration(state, index)
									gate4_resolution_local_add(locals, text, "", 0)
									skipping_type = true
								end
							else
								if gate4_token_is(state, index + 1, "(")
									if text != "puts"
										if gate4_find_visible_function(state, module_index, text) < 0
											gate4_diagnostic(
												state,
												"TRBN4003",
												gate4_load_integer(state.token_lines, index),
												"unresolved function " + text,
											)
										end
									end
								else
									if gate4_token_is(state, index + 1, ".")
										if gate4_token_is(state, index + 2, "new")
											if gate4_find_visible_record(state, module_index, text) < 0
												gate4_diagnostic(
													state,
													"TRBN4003",
													gate4_load_integer(state.token_lines, index),
													"unresolved record " + text,
												)
											end
										else
											if gate4_local_find(locals, text) < 0
												if gate4_find_import_binding(state, module_index, text) < 0
													gate4_diagnostic(
														state,
														"TRBN4003",
														gate4_load_integer(state.token_lines, index),
														"unresolved local " + text,
													)
												end
											end
										end
									else
										if gate4_local_find(locals, text) < 0
											gate4_diagnostic(
												state,
												"TRBN4003",
												gate4_load_integer(state.token_lines, index),
												"unresolved local " + text,
											)
										end
									end
								end
							end
						end
					end
				end
			end
		end
		index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_resolve(mut state: Gate4Compiler): Boolean
	gate4_build_symbol_index(state.function_lookup, state.function_modules, state.function_names, state.function_count[0])
	if !gate4_resolve_bare_imports(state)
		return false
	end
	if !gate4_resolve_declarations(state)
		return false
	end
	mut function_index := 0
	while function_index < state.function_count[0]
		mut locals := gate4_locals_new(state.token_count[0] + 1)
		gate4_resolve_function_body(state, function_index, locals)
		function_index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_checked_value(
		type_name: String,
		category: Integer,
		name: String,
		mutable: Integer,
	): Gate4CheckedValue
	return Gate4CheckedValue.new(
		type_name: type_name,
		category: category,
		name: name,
		mutable: mutable,
	)
end

def gate4_type_diagnostic(
		mut state: Gate4Compiler,
		line: Integer,
		message: String,
	): Gate4CheckedValue
	gate4_diagnostic(state, "TRBN4004", line, message)
	return gate4_checked_value("Invalid", 0, "", 0)
end

def gate4_numeric_type(type_name: String): Boolean
	if type_name == "Integer"
		return true
	end
	return type_name == "Float"
end

def gate4_check_expected(
		mut state: Gate4Compiler,
		actual: String,
		expected: String,
		line: Integer,
	): Boolean
	if expected == ""
		return true
	end
	mut assignable := actual == expected
	if !assignable
		if actual == "Integer"
			assignable = expected == "Float"
		end
	end
	if assignable
		return true
	end
	gate4_diagnostic(
		state,
		"TRBN4004",
		line,
		"expected " + gate4_type_display(state, expected) + ", found " + gate4_type_display(state, actual),
	)
	return false
end

def gate4_check_array_literal(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		expected: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	contextual_element_type := gate4_array_element_type(expected)
	mut element_type := contextual_element_type
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], "]")
			finished = true
		else
			value := gate4_check_expression(state, position, locals, 1, contextual_element_type)
			if contextual_element_type == ""
				common_type := gate4_common_array_element_type(element_type, value.type_name)
				if common_type == ""
					gate4_check_expected(
						state,
						value.type_name,
						element_type,
						gate4_load_integer(state.token_lines, position[0]),
					)
				else
					element_type = common_type
				end
			end
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	if !gate4_expect(state, position, "]")
		return gate4_checked_value("Invalid", 0, "", 0)
	end
	if element_type == ""
		return gate4_type_diagnostic(state, line, "empty Array literal requires a contextual type")
	end
	result_type := gate4_array_type(element_type)
	if result_type == ""
		return gate4_type_diagnostic(state, line, "unsupported Array element type " + element_type)
	end
	gate4_check_expected(state, result_type, expected, line)
	return gate4_checked_value(result_type, 0, "", 1)
end

def gate4_check_primary(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		expected: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	kind := gate4_load_integer(state.token_kinds, position[0])
	if kind == 2
		literal := gate4_load_string(state.token_texts, position[0])
		gate4_advance(position)
		if gate4_number_is_float(literal)
			if !gate4_float_literal_in_range(literal)
				return gate4_type_diagnostic(state, line, "Float literal is outside the finite binary64 range")
			end
			return gate4_checked_value("Float", 0, "", 0)
		end
		if !gate4_integer_literal_in_range(literal)
			return gate4_type_diagnostic(state, line, "Integer literal is outside the portable range")
		end
		return gate4_checked_value("Integer", 0, "", 0)
	end
	if kind == 3
		gate4_advance(position)
		return gate4_checked_value("String", 0, "", 0)
	end
	if gate4_token_is(state, position[0], "[")
		return gate4_check_array_literal(state, position, locals, expected)
	end
	if gate4_token_is(state, position[0], "(")
		gate4_advance(position)
		gate4_skip_newlines(state, position)
		value := gate4_check_expression(state, position, locals, 1, expected)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		return value
	end
	if gate4_token_is(state, position[0], "!")
		gate4_advance(position)
		value := gate4_check_postfix(
			state,
			position,
			locals,
			gate4_check_primary(state, position, locals, "Boolean"),
		)
		gate4_check_expected(state, value.type_name, "Boolean", line)
		gate4_check_expected(state, "Boolean", expected, line)
		return gate4_checked_value("Boolean", 0, "", 0)
	end
	if gate4_token_is(state, position[0], "-")
		gate4_advance(position)
		value := gate4_check_postfix(
			state,
			position,
			locals,
			gate4_check_primary(state, position, locals, ""),
		)
		if !gate4_numeric_type(value.type_name)
			return gate4_type_diagnostic(state, line, "unary - requires Integer or Float")
		end
		return gate4_checked_value(value.type_name, 0, "", 0)
	end
	if gate4_token_is(state, position[0], "+")
		gate4_advance(position)
		value := gate4_check_postfix(
			state,
			position,
			locals,
			gate4_check_primary(state, position, locals, ""),
		)
		if !gate4_numeric_type(value.type_name)
			return gate4_type_diagnostic(state, line, "unary + requires Integer or Float")
		end
		return gate4_checked_value(value.type_name, 0, "", 0)
	end
	if kind == 1
		name := gate4_load_string(state.token_texts, position[0])
		gate4_advance(position)
		if name == "true"
			return gate4_checked_value("Boolean", 0, "", 0)
		end
		if name == "false"
			return gate4_checked_value("Boolean", 0, "", 0)
		end
		local_index := gate4_local_find(locals, name)
		if local_index >= 0
			return gate4_checked_value(
				gate4_load_string(locals.types, local_index),
				0,
				name,
				gate4_load_integer(locals.mutable, local_index),
			)
		end
		standard_package := gate4_standard_package_import(state, state.active_module[0], name)
		if standard_package < - 1
			return gate4_checked_value(gate4_standard_package_root(standard_package), 2 - standard_package, name, 0)
		end
		if name == "puts"
			return gate4_checked_value("", 1, name, 0)
		end
		if gate4_find_visible_function(state, state.active_module[0], name) >= 0
			return gate4_checked_value("", 1, name, 0)
		end
		if gate4_find_visible_record(state, state.active_module[0], name) >= 0
			return gate4_checked_value("", 2, name, 0)
		end
		return gate4_type_diagnostic(state, line, "unresolved value " + name)
	end
	return gate4_type_diagnostic(state, line, "expected an expression")
end

def gate4_check_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		callee: Gate4CheckedValue,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	mut function_index := gate4_find_visible_function(state, state.active_module[0], callee.name)
	mut parameter_start := 0
	mut parameter_count := 1
	mut result_type := "Void"
	if callee.name == "puts"
		function_index =- 1
	else
		if callee.category == 4
			function_index =- 1
			parameter_count = 0
			result_type = "Array<String>"
		else
			if callee.category == 5
				function_index =- 1
				result_type = "Float"
			else
				if function_index >= 0
					parameter_start = gate4_load_integer(state.function_parameter_starts, function_index)
					parameter_count = gate4_load_integer(state.function_parameter_counts, function_index)
					result_type = gate4_load_string(state.function_result_types, function_index)
				else
					gate4_diagnostic(state, "TRBN4004", line, "value is not callable")
				end
			end
		end
	end
	mut argument_count := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			mut argument_expected := "Invalid"
			if callee.category >= 4
				argument_expected = ""
			end
			if argument_count < parameter_count
				if callee.category == 5
					argument_expected = "Float"
				else
					if callee.name == "puts"
						argument_expected = "String"
					else
						argument_expected = gate4_load_string(state.parameter_types, parameter_start + argument_count)
					end
				end
			end
			gate4_check_expression(state, position, locals, 1, argument_expected)
			argument_count += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	if argument_count != parameter_count
		gate4_diagnostic(state, "TRBN4004", line, "call argument count does not match " + callee.name)
	end
	return gate4_checked_value(result_type, 0, "", 0)
end

def gate4_check_record_new(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		record_name: String,
	): Gate4CheckedValue
	record_index := gate4_find_visible_record(state, state.active_module[0], record_name)
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	field_start := gate4_load_integer(state.record_field_starts, record_index)
	field_count := gate4_load_integer(state.record_field_counts, record_index)
	mut argument_index := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			label := gate4_expect_identifier(state, position)
			gate4_expect(state, position, ":")
			mut expected := "Invalid"
			if argument_index < field_count
				expected = gate4_load_string(state.field_types, field_start + argument_index)
				if label != gate4_load_string(state.field_names, field_start + argument_index)
					gate4_diagnostic(
						state,
						"TRBN4004",
						line,
						"record fields must be initialized in declaration order",
					)
				end
			end
			gate4_check_expression(state, position, locals, 1, expected)
			argument_index += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	if argument_index != field_count
		gate4_diagnostic(state, "TRBN4004", line, "record field count does not match " + record_name)
	end
	return gate4_checked_value(gate4_record_type(record_index), 0, "", 1)
end

def gate4_check_method_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		receiver: Gate4CheckedValue,
		method: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	if method == "size"
		gate4_expect(state, position, ")")
		if receiver.type_name == "String"
			return gate4_checked_value("Integer", 0, "", 0)
		end
		if gate4_array_element_type(receiver.type_name) != ""
			return gate4_checked_value("Integer", 0, "", 0)
		end
		return gate4_type_diagnostic(state, line, "size is unavailable on " + gate4_type_display(state, receiver.type_name))
	end
	if method == "push"
		element_type := gate4_array_element_type(receiver.type_name)
		if element_type == ""
			return gate4_type_diagnostic(state, line, "push is unavailable on " + gate4_type_display(state, receiver.type_name))
		end
		if receiver.mutable == 0
			gate4_diagnostic(state, "TRBN4004", line, "push receiver is immutable")
		end
		gate4_check_expression(state, position, locals, 1, element_type)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		return gate4_checked_value("Void", 0, "", 0)
	end
	if method == "to_i"
		gate4_expect(state, position, ")")
		if receiver.type_name == "String"
			return gate4_checked_value("Integer", 0, "", 0)
		end
		if receiver.type_name == "Float"
			return gate4_checked_value("Integer", 0, "", 0)
		end
	end
	if method == "to_s"
		gate4_expect(state, position, ")")
		if receiver.type_name == "Integer"
			return gate4_checked_value("String", 0, "", 0)
		end
	end
	return gate4_type_diagnostic(state, line, "unsupported method " + method)
end

def gate4_check_postfix(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		initial: Gate4CheckedValue,
	): Gate4CheckedValue
	mut value := gate4_checked_value(initial.type_name, initial.category, initial.name, initial.mutable)
	mut scanning := true
	while scanning
		if gate4_token_is(state, position[0], "(")
			if value.category == 0
				value = gate4_type_diagnostic(
					state,
					gate4_load_integer(state.token_lines, position[0]),
					"value is not directly callable",
				)
				scanning = false
			else
				value = gate4_check_call(state, position, locals, value)
			end
		else
			if gate4_token_is(state, position[0], ".")
				gate4_advance(position)
				member := gate4_expect_identifier(state, position)
				if gate4_token_is(state, position[0], "(")
					if value.category >= 4
						mut expected_member := "sqrt"
						if value.category == 4
							expected_member = "argv"
						end
						if member != expected_member
							value = gate4_type_diagnostic(
								state,
								gate4_load_integer(state.token_lines, position[0]),
								"unsupported standard package member",
							)
							scanning = false
						end
					else
						if value.category == 2
							if member == "new"
								value = gate4_check_record_new(state, position, locals, value.name)
							else
								value = gate4_type_diagnostic(
									state,
									gate4_load_integer(state.token_lines, position[0]),
									"unsupported record constructor member " + member,
								)
								scanning = false
							end
						else
							value = gate4_check_method_call(state, position, locals, value, member)
						end
					end
				else
					record_index := gate4_find_record_type(state, value.type_name)
					if record_index < 0
						value = gate4_type_diagnostic(
							state,
							gate4_load_integer(state.token_lines, position[0]),
							"field access requires a record value",
						)
						scanning = false
					else
						field_index := gate4_find_field(state, record_index, member)
						if field_index < 0
							value = gate4_type_diagnostic(
								state,
								gate4_load_integer(state.token_lines, position[0]),
								"unknown field " + member + " on " + gate4_type_display(state, value.type_name),
							)
							scanning = false
						else
							value = gate4_checked_value(
								gate4_load_string(state.field_types, field_index),
								0,
								member,
								value.mutable,
							)
						end
					end
				end
			else
				if gate4_token_is(state, position[0], "[")
					line := gate4_load_integer(state.token_lines, position[0])
					gate4_advance(position)
					gate4_check_expression(state, position, locals, 1, "Integer")
					gate4_expect(state, position, "]")
					if value.type_name == "String"
						value = gate4_checked_value("String", 0, "", 0)
					else
						element_type := gate4_array_element_type(value.type_name)
						if element_type == ""
							value = gate4_type_diagnostic(
								state,
								line,
								"indexing is unavailable on " + value.type_name,
							)
							scanning = false
						else
							value = gate4_checked_value(element_type, 0, "", value.mutable)
						end
					end
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def gate4_binary_result_type(
		mut state: Gate4Compiler,
		operator: String,
		left: String,
		right: String,
		line: Integer,
	): String
	mut numeric_pair := false
	if gate4_numeric_type(left)
		if gate4_numeric_type(right)
			numeric_pair = true
		end
	end
	if left != right
		if !numeric_pair
			gate4_diagnostic(state, "TRBN4004", line, "binary operands have different types")
			return "Invalid"
		end
	end
	mut numeric_result := "Integer"
	if left == "Float"
		numeric_result = "Float"
	end
	if right == "Float"
		numeric_result = "Float"
	end
	if operator == "+"
		if numeric_pair
			return numeric_result
		end
		if left == "String"
			return "String"
		end
	end
	if operator == "-"
		if numeric_pair
			return numeric_result
		end
	end
	if operator == "*"
		if numeric_pair
			return numeric_result
		end
	end
	if operator == "/"
		if numeric_pair
			return numeric_result
		end
	end
	if operator == "%"
		if left == "Integer"
			if right == "Integer"
				return "Integer"
			end
		end
	end
	if operator == "=="
		if numeric_pair
			return "Boolean"
		end
		if left == right
			return "Boolean"
		end
	end
	if operator == "!="
		if numeric_pair
			return "Boolean"
		end
		if left == right
			return "Boolean"
		end
	end
	if operator == "<"
		if numeric_pair
			return "Boolean"
		end
	end
	if operator == "<="
		if numeric_pair
			return "Boolean"
		end
	end
	if operator == ">"
		if numeric_pair
			return "Boolean"
		end
	end
	if operator == ">="
		if numeric_pair
			return "Boolean"
		end
	end
	mut display_type := left
	if right == "Float"
		display_type = "Float"
	end
	gate4_diagnostic(state, "TRBN4004", line, "unsupported operator " + operator + " for " + display_type)
	return "Invalid"
end

def gate4_check_expression(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		minimum_precedence: Integer,
		expected: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	mut value := gate4_check_postfix(
		state,
		position,
		locals,
		gate4_check_primary(state, position, locals, expected),
	)
	mut scanning := true
	while scanning
		operator := gate4_load_string(state.token_texts, position[0])
		precedence := gate4_binary_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			right := gate4_check_expression(state, position, locals, precedence + 1, "")
			result_type := gate4_binary_result_type(state, operator, value.type_name, right.type_name, line)
			value = gate4_checked_value(result_type, 0, "", 0)
		end
	end
	gate4_check_expected(state, value.type_name, expected, line)
	return value
end

def gate4_compound_operator(operator: String): String
	if operator == "+="
		return "+"
	end
	if operator == "-="
		return "-"
	end
	if operator == "*="
		return "*"
	end
	if operator == "/="
		return "/"
	end
	return ""
end

def gate4_check_declaration(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
	): Boolean
	mut mutable := 0
	if gate4_token_is(state, position[0], "mut")
		mutable = 1
		gate4_advance(position)
	end
	line := gate4_load_integer(state.token_lines, position[0])
	name := gate4_expect_identifier(state, position)
	mut declared_type := ""
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		declared_type = gate4_parse_type(state, position)
		resolved_type := gate4_resolve_type_name(state, state.active_module[0], declared_type, false)
		if resolved_type == ""
			gate4_diagnostic(state, "TRBN4004", line, "unknown local type " + declared_type)
		else
			declared_type = resolved_type
		end
	end
	gate4_expect(state, position, ":=")
	value := gate4_check_expression(state, position, locals, 1, declared_type)
	mut local_type := declared_type
	if local_type == ""
		local_type = value.type_name
	end
	if local_type == "Void"
		gate4_diagnostic(state, "TRBN4004", line, "local binding cannot have type Void")
	end
	gate4_local_add(state, locals, name, local_type, mutable, line)
	return gate4_finish_statement(state, position)
end

def gate4_check_simple_statement(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
	): Boolean
	line := gate4_load_integer(state.token_lines, position[0])
	left := gate4_check_expression(state, position, locals, 1, "")
	operator := gate4_load_string(state.token_texts, position[0])
	if operator == "="
		if left.mutable == 0
			gate4_diagnostic(state, "TRBN4004", line, "assignment target is immutable")
		end
		gate4_advance(position)
		gate4_check_expression(state, position, locals, 1, left.type_name)
	else
		compound := gate4_compound_operator(operator)
		if compound != ""
			if left.mutable == 0
				gate4_diagnostic(state, "TRBN4004", line, "assignment target is immutable")
			end
			gate4_advance(position)
			right := gate4_check_expression(state, position, locals, 1, left.type_name)
			gate4_binary_result_type(state, compound, left.type_name, right.type_name, line)
		end
	end
	return gate4_finish_statement(state, position)
end

def gate4_check_block(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		result_type: String,
	): Boolean
	gate4_skip_newlines(state, position)
	mut complete := false
	while !complete
		if gate4_terminal_token(state, position[0])
			gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, position[0]), "unexpected end of input")
			complete = true
		else
			if gate4_token_is(state, position[0], "end")
				complete = true
			else
				if gate4_token_is(state, position[0], "else")
					complete = true
				else
					if gate4_token_is(state, position[0], "if")
						line := gate4_load_integer(state.token_lines, position[0])
						gate4_advance(position)
						condition := gate4_check_expression(state, position, locals, 1, "Boolean")
						gate4_check_expected(state, condition.type_name, "Boolean", line)
						gate4_finish_statement(state, position)
						saved_count := locals.count[0]
						gate4_check_block(state, position, locals, result_type)
						locals.count[0] = saved_count
						if gate4_token_is(state, position[0], "else")
							gate4_advance(position)
							gate4_finish_statement(state, position)
							gate4_check_block(state, position, locals, result_type)
							locals.count[0] = saved_count
						end
						gate4_expect(state, position, "end")
						gate4_finish_statement(state, position)
					else
						if gate4_token_is(state, position[0], "while")
							line := gate4_load_integer(state.token_lines, position[0])
							gate4_advance(position)
							condition := gate4_check_expression(state, position, locals, 1, "Boolean")
							gate4_check_expected(state, condition.type_name, "Boolean", line)
							gate4_finish_statement(state, position)
							saved_count := locals.count[0]
							gate4_check_block(state, position, locals, result_type)
							locals.count[0] = saved_count
							gate4_expect(state, position, "end")
							gate4_finish_statement(state, position)
						else
							if gate4_token_is(state, position[0], "return")
								line := gate4_load_integer(state.token_lines, position[0])
								gate4_advance(position)
								if gate4_load_integer(state.token_kinds, position[0]) == 4
									if result_type != "Void"
										gate4_diagnostic(state, "TRBN4004", line, "return value is required")
									end
								else
									if result_type == "Void"
										gate4_diagnostic(state, "TRBN4004", line, "Void function cannot return a value")
									else
										gate4_check_expression(state, position, locals, 1, result_type)
									end
								end
								gate4_finish_statement(state, position)
							else
								mut declaration := false
								if gate4_token_is(state, position[0], "mut")
									declaration = true
								else
									if gate4_load_integer(state.token_kinds, position[0]) == 1
										if gate4_token_is(state, position[0] + 1, ":=")
											declaration = true
										else
											if gate4_token_is(state, position[0] + 1, ":")
												declaration = true
											end
										end
									end
								end
								if declaration
									gate4_check_declaration(state, position, locals)
								else
									gate4_check_simple_statement(state, position, locals)
								end
							end
						end
					end
				end
			end
		end
		if gate4_has_diagnostic(state)
			complete = true
		end
	end
	return !gate4_has_diagnostic(state)
end

def gate4_check_function(mut state: Gate4Compiler, function_index: Integer): Boolean
	state.active_module[0] = gate4_load_integer(state.function_modules, function_index)
	mut locals := gate4_locals_new(state.token_count[0] + 1)
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		gate4_local_add(
			state,
			locals,
			gate4_load_string(state.parameter_names, parameter_index),
			gate4_load_string(state.parameter_types, parameter_index),
			gate4_load_integer(state.parameter_mutable, parameter_index),
			gate4_load_integer(state.parameter_lines, parameter_index),
		)
		parameter_index += 1
	end
	mut position := [gate4_load_integer(state.function_body_starts, function_index)]
	gate4_check_block(state, position, locals, gate4_load_string(state.function_result_types, function_index))
	if position[0] != gate4_load_integer(state.function_body_ends, function_index)
		gate4_diagnostic(
			state,
			"TRBN4004",
			gate4_load_integer(state.function_lines, function_index),
			"checker did not consume the complete function body",
		)
	end
	valid :=!gate4_has_diagnostic(state)
	gate4_reset_temporary_storage()
	return valid
end

def gate4_check(mut state: Gate4Compiler): Boolean
	mut function_index := 0
	while function_index < state.function_count[0]
		gate4_check_function(state, function_index)
		function_index += 1
	end
	if !gate4_has_diagnostic(state)
		gate4_validate_import_usage(state)
	end
	return !gate4_has_diagnostic(state)
end

def main()
	return
end
