import { Gate4IntegerStorage, Gate4StringStorage, gate4_integer_storage, gate4_load_integer, gate4_load_string, gate4_store_integer, gate4_store_string, gate4_string_storage } from storage
import { gate4_path_basename, gate4_path_directory, gate4_path_join, gate4_string_ends_with, gate4_string_starts_with, gate4_string_without_suffix } from path
import { gate4_ascii_code, gate4_integer_string, gate4_number_is_float, gate4_number_without_underscores, gate4_small_nonnegative_integer_operand } from literals
import { gate4_mir_block_index, gate4_mir_function_index, gate4_mir_value_type, gate4_optimize_verified_mir, gate4_verify_mir } from mir
import { Gate4Compiler, Gate4SymbolIndex, gate4_add_module, gate4_add_name_index, gate4_compiler_new, gate4_diagnostic, gate4_find_module, gate4_find_name, gate4_has_diagnostic, gate4_local_add, gate4_locals_new, gate4_symbol_index_new } from state
import { gate4_advance, gate4_binary_operator_id, gate4_binary_precedence, gate4_declaration_start, gate4_expect, gate4_expect_identifier, gate4_finish_statement, gate4_parse_module, gate4_parse_simple_statement_syntax, gate4_parse_type, gate4_skip_newlines, gate4_token_is } from parser
import { gate4_array_element_type, gate4_array_type, gate4_common_array_element_type, gate4_find_field, gate4_find_function_in_module, gate4_find_record_type, gate4_find_visible_function, gate4_find_visible_record, gate4_import_path_value, gate4_normalize_import_path, gate4_record_type, gate4_resolve, gate4_resolve_type_name, gate4_standard_package_import, gate4_standard_package_root, gate4_standard_package_target, gate4_validate_import_usage } from resolution
import { checked_binary_plan_type, gate4_check_block, gate4_mir_add_parameter, gate4_mir_nonnegative_fact, gate4_scalar_leaf_inline_eligible, gate4_scalar_mir_begin, gate4_scalar_mir_commit } from checked_program

record Gate4Output
	lines: Gate4StringStorage
	count: Array<Integer>
	runtime_flags: Array<Integer>
end

record Gate4EmitContext
	local_names: Gate4StringStorage
	local_types: Gate4StringStorage
	local_slots: Gate4StringStorage
	local_mutable: Gate4IntegerStorage
	local_inherited: Gate4IntegerStorage
	local_direct: Gate4IntegerStorage
	local_count: Array<Integer>
	slot_count: Array<Integer>
	managed_local_high_water: Array<Integer>
	temporary_roots_used: Array<Integer>
	temporary_count: Array<Integer>
	label_count: Array<Integer>
	loop_depth: Array<Integer>
	inline_budget: Array<Integer>
	scalar_inline_depth: Array<Integer>
	scalar_inline_range_failure_used: Array<Integer>
	array_bounds_failure_used: Array<Integer>
	array_header: Array<String>
	array_header_fallback: Array<Array<String>>
end

record Gate4EmittedValue
	operand: String
	type_name: String
	category: Integer
	name: String
	mutable: Integer
	address: String
end

record Gate4ProjectGoConfig
	module_name: String
	version: String
	root_package: String
end

record Gate4ProjectConfig
	name: String
	version: String
	mode: String
	source_dir: String
	out_dir: String
	copy_files: Boolean
	package_management: String
	go_config: Gate4ProjectGoConfig
	error: String
	error_line: Integer
end

record Gate4ProjectSources
	paths: Array<String>
	sources: Array<String>
	error: String
end

def gate4_reset_temporary_storage()
	return
end

# These declarations are typed compiler-runtime intrinsics. Their source bodies
# keep recovery compilation valid; the self-hosted emitter replaces calls from
# the compiler executable with the matching QBE runtime operations.
def gate4_file_exists(_path: String): Boolean
	return false
end

def gate4_read_source(_path: String): String
	return ""
end

def gate4_source_slice(source: String, start: Integer, finish: Integer): String
	mut value := ""
	mut index := start
	while index < finish
		value += source[index]
		index += 1
	end
	return value
end

def gate4_collect_project_sources(_source_root: String, _out_root: String): Gate4ProjectSources
	return Gate4ProjectSources.new(paths: [], sources: [], error: "")
end

def gate4_output_new(capacity: Integer, runtime_flags: Array<Integer>): Gate4Output
	return Gate4Output.new(lines: gate4_string_storage(capacity), count: [0], runtime_flags: runtime_flags)
end

def gate4_emit_context_new(
		capacity: Integer,
		inline_budget: Array<Integer>,
	): Gate4EmitContext
	return Gate4EmitContext.new(
		local_names: gate4_string_storage(capacity),
		local_types: gate4_string_storage(capacity),
		local_slots: gate4_string_storage(capacity),
		local_mutable: gate4_integer_storage(capacity),
		local_inherited: gate4_integer_storage(capacity),
		local_direct: gate4_integer_storage(capacity),
		local_count: [0],
		slot_count: [0],
		managed_local_high_water: [0],
		# The second cell is a monotonic GC-safe-point counter used while
		# deciding whether loop-root publication may move to the exit.
		temporary_roots_used: [0, 0],
		temporary_count: [0],
		label_count: [0],
		loop_depth: [0],
		inline_budget: inline_budget,
		scalar_inline_depth: [0],
		scalar_inline_range_failure_used: [0],
		array_bounds_failure_used: [0],
		array_header: gate4_array_header_new(),
		array_header_fallback: [gate4_array_header_new(), gate4_array_header_new()],
	)
end

def gate4_output_line(mut output: Gate4Output, line: String)
	index := output.count[0]
	gate4_store_string(output.lines, index, line)
	output.count[0] = index + 1
	return
end

def gate4_output_branch(
		mut output: Gate4Output,
		condition: String,
		when_true: String,
		when_false: String,
	)
	gate4_output_line(output, "\tjnz " + condition + ", " + when_true + ", " + when_false)
	return
end

def gate4_static_string_bytes(value: String): Array<Integer>
	mut bytes: Array<Integer> := []
	mut index := 0
	while index < value.size()
		code := gate4_ascii_code(value[index])
		if code < 0
			return []
		end
		bytes.push(code)
		index += 1
	end
	return bytes
end

def gate4_static_bytes_hash(bytes: Array<Integer>, index: Integer): Integer
	return ((bytes[index] * 257 + bytes[index + 1]) * 257 + bytes[index + 2]) % 512
end

def gate4_encode_static_bytes(bytes: Array<Integer>): Array<Integer>
	mut positions: Array<Integer> := []
	while positions.size() < 512
		positions.push(- 1)
	end
	mut encoded: Array<Integer> := []
	mut index := 0
	while index < bytes.size()
		mut match_length := 0
		mut match_distance := 0
		if index + 2 < bytes.size()
			hash := gate4_static_bytes_hash(bytes, index)
			previous := positions[hash]
			if previous >= 0
				distance := index - previous
				if distance <= 65535
					mut limit := bytes.size() - index
					if limit > 130
						limit = 130
					end
					mut length := 0
					mut matching := true
					while matching
						if length >= limit
							matching = false
						else
							if bytes[previous + length] == bytes[index + length]
								length += 1
							else
								matching = false
							end
						end
					end
					if length >= 4
						match_length = length
						match_distance = distance
					end
				end
			end
		end

		mut consumed := 1
		if match_length >= 4
			encoded.push(128 + match_length - 3)
			encoded.push(match_distance / 256)
			encoded.push(match_distance % 256)
			consumed = match_length
		else
			encoded.push(bytes[index])
		end

		mut update := index
		while update < index + consumed
			if update + 2 < bytes.size()
				positions[gate4_static_bytes_hash(bytes, update)] = update
			end
			update += 1
		end
		index += consumed
	end
	return encoded
end

def gate4_encode_static_string(value: String): Array<Integer>
	return gate4_encode_static_bytes(gate4_static_string_bytes(value))
end

def gate4_emit_static_byte_data(
		mut output: Gate4Output,
		symbol: String,
		bytes: Array<Integer>,
	)
	gate4_output_line(output, "data $" + symbol + " = {")
	mut line := "\tb"
	mut line_bytes := 0
	mut index := 0
	while index < bytes.size()
		line += " " + gate4_integer_string(bytes[index])
		line_bytes += 1
		if line_bytes == 16
			gate4_output_line(output, line + ",")
			line = "\tb"
			line_bytes = 0
		end
		index += 1
	end
	if line_bytes > 0
		gate4_output_line(output, line + ",")
	end
	gate4_output_line(output, "\tb 0 }")
	return
end

def gate4_emit_static_string_decoder(
		mut output: Gate4Output,
		compressed_tokens: Array<Integer>,
		compressed_sizes: Array<Integer>,
		decoded_sizes: Array<Integer>,
	)
	gate4_output_line(
		output,
		"function $g4_static_string_decode(l %target, l %encoded, l %encoded_length, l %decoded_length) {\n@start\n\tstorel 0, %target\n\t%length_address =l add %target, 8\n\tstorel %decoded_length, %length_address\n\t%output =l add %target, 16\n\tjmp @loop\n@loop\n\t%input_index =l phi @start 0, @literal %literal_next_input, @match_done %match_next_input\n\t%output_index =l phi @start 0, @literal %literal_next_output, @match_done %match_next_output\n\t%done =w cslel %encoded_length, %input_index\n\tjnz %done, @terminate, @read\n@read\n\t%encoded_address =l add %encoded, %input_index\n\t%header =w loadub %encoded_address\n\t%is_match =w csgtw %header, 127\n\tjnz %is_match, @match, @literal\n@literal\n\t%literal_address =l add %output, %output_index\n\tstoreb %header, %literal_address\n\t%literal_next_input =l add %input_index, 1\n\t%literal_next_output =l add %output_index, 1\n\tjmp @loop\n@match\n\t%high_address =l add %encoded_address, 1\n\t%low_address =l add %encoded_address, 2\n\t%high =w loadub %high_address\n\t%low =w loadub %low_address\n\t%high_long =l extuw %high\n\t%low_long =l extuw %low\n\t%high_shifted =l shl %high_long, 8\n\t%distance =l or %high_shifted, %low_long\n\t%match_length_word =w sub %header, 125\n\t%match_length =l extuw %match_length_word\n\tjmp @copy\n@copy\n\t%copy_index =l phi @match 0, @copy_byte %copy_next\n\t%copy_done =w cslel %match_length, %copy_index\n\tjnz %copy_done, @match_done, @copy_byte\n@copy_byte\n\t%source_base =l sub %output_index, %distance\n\t%source_index =l add %source_base, %copy_index\n\t%source_address =l add %output, %source_index\n\t%value =w loadub %source_address\n\t%destination_index =l add %output_index, %copy_index\n\t%destination_address =l add %output, %destination_index\n\tstoreb %value, %destination_address\n\t%copy_next =l add %copy_index, 1\n\tjmp @copy\n@match_done\n\t%match_next_input =l add %input_index, 3\n\t%match_next_output =l add %output_index, %match_length\n\tjmp @loop\n@terminate\n\t%terminator =l add %output, %decoded_length\n\tstoreb 0, %terminator\n\tret\n}",
	)
	gate4_output_line(output, "\nfunction $g4_static_strings_initialize() {\n@start")
	mut index := 0
	while index < compressed_tokens.size()
		token := gate4_integer_string(compressed_tokens[index])
		gate4_output_line(
			output,
			"\tcall $g4_static_string_decode(l $g4s" + token + ", l $g4c" + token +
			", l " + gate4_integer_string(compressed_sizes[index]) +
			", l " + gate4_integer_string(decoded_sizes[index]) + ")",
		)
		index += 1
	end
	gate4_output_line(output, "\tret\n}")
	return
end

def gate4_emit_static_strings(
		mut state: Gate4Compiler,
		mut output: Gate4Output,
	): Boolean
	deduplicate := gate4_compiler_entry_function(state) >= 0
	mut canonical_values: Array<String> := []
	mut canonical_tokens: Array<Integer> := []
	mut compressed_tokens: Array<Integer> := []
	mut compressed_sizes: Array<Integer> := []
	mut decoded_sizes: Array<Integer> := []
	mut token_index := 0
	while token_index < state.token_count[0]
		if gate4_load_integer(state.token_kinds, token_index) == 3
			value := gate4_load_string(state.token_texts, token_index)
			mut canonical := token_index
			mut value_index := 0
			mut found := false
			if deduplicate
				while value_index < canonical_values.size()
					if canonical_values[value_index] == value
						canonical = canonical_tokens[value_index]
						found = true
						value_index = canonical_values.size()
					else
						value_index += 1
					end
				end
			end
			if !found
				canonical_values.push(value)
				canonical_tokens.push(token_index)
				mut bytes: Array<Integer> := []
				mut has_static_bytes := false
				mut compressed: Array<Integer> := []
				if value.size() >= 256
					bytes = gate4_static_string_bytes(value)
					if bytes.size() == value.size()
						has_static_bytes = true
						compressed = gate4_encode_static_bytes(bytes)
					end
				end
				mut use_compressed := false
				if compressed.size() > 0
					if compressed.size() < value.size()
						use_compressed = true
					end
				end
				if use_compressed
					gate4_output_line(
						output,
						"data $g4s" + gate4_integer_string(token_index) + " = align 8 { z " +
						gate4_integer_string(value.size() + 17) + " }",
					)
					gate4_emit_static_byte_data(output, "g4c" + gate4_integer_string(token_index), compressed)
					compressed_tokens.push(token_index)
					compressed_sizes.push(compressed.size())
					decoded_sizes.push(value.size())
					output.runtime_flags[2] = 1
				else
					gate4_output_line(
						output,
						"data $g4s" + gate4_integer_string(token_index) +
						" = align 8 { l 0, l " + gate4_integer_string(value.size()) + ",",
					)
					mut line := "\tb"
					mut line_bytes := 0
					mut character_index := 0
					while character_index < value.size()
						mut code := 0
						if has_static_bytes
							code = bytes[character_index]
						else
							code = gate4_ascii_code(value[character_index])
						end
						if code < 0
							gate4_diagnostic(
								state,
								"TRBN4005",
								gate4_load_integer(state.token_lines, token_index),
								"Gate 4 QBE emission supports ASCII String literals only",
							)
						else
							line += " " + gate4_integer_string(code)
							line_bytes += 1
							if line_bytes == 16
								gate4_output_line(output, line + ",")
								line = "\tb"
								line_bytes = 0
							end
						end
						character_index += 1
					end
					if line_bytes > 0
						gate4_output_line(output, line + ",")
					end
					gate4_output_line(output, "\tb 0 }")
				end
			end
			gate4_store_integer(state.token_lines, token_index, canonical)
		end
		token_index += 1
	end
	if compressed_tokens.size() > 0
		gate4_emit_static_string_decoder(output, compressed_tokens, compressed_sizes, decoded_sizes)
	end
	gate4_output_line(output, "")
	return !gate4_has_diagnostic(state)
end

def gate4_emit_record_descriptors(state: Gate4Compiler, mut output: Gate4Output)
	mut record_index := 0
	while record_index < state.record_count[0]
		field_start := gate4_load_integer(state.record_field_starts, record_index)
		field_count := gate4_load_integer(state.record_field_counts, record_index)
		mut managed_count := 0
		mut entries := ""
		mut field_offset := 0
		while field_offset < field_count
			if gate4_type_is_managed(gate4_load_string(state.field_types, field_start + field_offset))
				entries += ", l " + gate4_integer_string(8 + field_offset * 8)
				managed_count += 1
			end
			field_offset += 1
		end
		gate4_output_line(
			output,
			"data $g4_desc_record" + gate4_integer_string(record_index) +
			" = align 8 { l 1, l " + gate4_integer_string(managed_count) + ", l " +
			gate4_integer_string(field_count * 8) + entries + " }",
		)
		record_index += 1
	end
	gate4_output_line(output, "")
	return
end

def gate4_project_runtime_qbe_line(value: String): Boolean
	if gate4_string_starts_with(value, "data $g4_project_")
		return true
	end
	if gate4_string_starts_with(value, "function l $g4_source_slice")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_c_")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_project_")
		return true
	end
	return gate4_string_starts_with(value, "function l $g4_collect_project_sources")
end

def gate4_emit_runtime(mut output: Gate4Output, project_runtime: Boolean)
	# The multiply helper's 26-bit fast entry proves the direct product is below
	# the portable limit; every other pair continues through its exact checks.
	lines := [
		"data $g4_newline = { b 10 }\ndata $g4_character_cache = align 8 { z 2048 }\ndata $g4_string_storage = align 8 { l 0, l 0, l 0 }\ndata $g4_temporary_storage = align 8 { l 0, l 0 }\ndata $g4_allocation_error = { b 112 97 110 105 99 58 32 97 108 108 111 99 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $g4_bounds_error = { b 112 97 110 105 99 58 32 105 110 100 101 120 32 105 115 32 111 117 116 32 111 102 32 98 111 117 110 100 115 10 }\ndata $g4_integer_error = { b 112 97 110 105 99 58 32 73 110 116 101 103 101 114 32 111 112 101 114 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $g4_integer_range_error = { b \"panic: Integer is outside the portable range\", b 10 }\ndata $g4_division_error = { b \"panic: division by zero\", b 10 }\ndata $g4_usage_error = { b \"usage: compiler {check|emit-qbe} SOURCE\", b 10, b \"       compiler build SOURCE --output OUTPUT --qbe QBE --cc CC\", b 10 }\ndata $g4_file_error = { b \"compiler: cannot read source file: \" }\ndata $g4_check = { b \"check\", b 0 }\ndata $g4_emit = { b \"emit-qbe\", b 0 }\ndata $g4_build = { b \"build\", b 0 }\ndata $g4_output_flag = { b \"--output\", b 0 }\ndata $g4_qbe_flag = { b \"--qbe\", b 0 }\ndata $g4_cc_flag = { b \"--cc\", b 0 }\ndata $g4_target_option = { b \"--target\", b 0 }\ndata $g4_source_arg = { b \"--source-content\", b 0 }\ndata $g4_rb = { b \"rb\", b 0 }\ndata $g4_wb = { b \"wb\", b 0 }\ndata $g4_ssa_suffix = { b \".trbn.ssa\", b 0 }\ndata $g4_asm_suffix = { b \".trbn.s\", b 0 }\ndata $g4_temp_suffix = { b \".trbn.XXXXXX\", b 0 }\ndata $g4_slash = { b \"/\", b 0 }\ndata $g4_target_flag = { b \"-t\", b 0 }\ndata $g4_profile_darwin_arm64 = { b \"darwin-arm64-v0\", b 0 }\ndata $g4_profile_linux_arm64 = { b \"linux-arm64-v0\", b 0 }\ndata $g4_profile_linux_amd64 = { b \"linux-amd64-v0\", b 0 }\ndata $g4_qbe_darwin_arm64 = { b \"arm64_apple\", b 0 }\ndata $g4_qbe_linux_arm64 = { b \"arm64\", b 0 }\ndata $g4_qbe_linux_amd64 = { b \"amd64_sysv\", b 0 }\ndata $g4_o_flag = { b \"-o\", b 0 }\ndata $g4_math_library = { b \"-lm\", b 0 }",
		"data $g4_project_assembler_input = { b \"-xassembler\", b 0 }",
		"data $g4_project_linker_lld = { b \"-fuse-ld=lld\", b 0 }",
		"data $g4_dead_strip_darwin = { b \"-Wl,-dead_strip,-x\", b 0 }",
		"data $g4_dead_strip_linux = { b \"-Wl,--gc-sections,--strip-all,--no-eh-frame-hdr\", b 0 }",
		"data $g4_selected_qbe_target = align 8 { l $g4_qbe_darwin_arm64 }",
		"data $g4_selected_dead_strip = align 8 { l $g4_dead_strip_darwin }",
		"data $g4_project_selected_linker = align 8 { l 0 }",
		"data $g4_project_paths = align 8 { l 0 }\ndata $g4_project_error = align 8 { l 0 }\ndata $g4_project_source_root = align 8 { l 0 }\ndata $g4_project_out_root = align 8 { l 0 }\ndata $g4_project_empty_string = align 8 { l 0, l 0, b 0 }\ndata $g4_project_trb_suffix = { b \".trb\", b 0 }\ndata $g4_project_test_suffix = { b \"_test.trb\", b 0 }\ndata $g4_project_git_component = { b \"/.git\", b 0 }\ndata $g4_project_trb_component = { b \"/.trb\", b 0 }\ndata $g4_project_node_modules_component = { b \"/node_modules\", b 0 }",
		"data $g4_target_error = { b \"compiler: unsupported target profile\", b 10 }\ndata $g4_intermediate_error = { b \"compiler: cannot create intermediate file\", b 10 }\ndata $g4_qbe_error = { b \"compiler: qbe failed\", b 10 }\ndata $g4_cc_error = { b \"compiler: cc failed\", b 10 }\ndata $g4_publish_error = { b \"compiler: cannot publish output\", b 10 }\n\nfunction $g4_fail(l %message, l %size) {\n@start\n\tcall $write(w 2, l %message, l %size)\n\tcall $exit(w 2)\n\thlt\n}\n\nfunction l $g4_alloc(l %size) {\n@start\n\t%pointer =l call $calloc(l 1, l %size)\n\t%failed =w ceql %pointer, 0\n\tjnz %failed, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ok\n\tret %pointer\n}\n\nfunction l $g4_string_alloc(l %size) {\n@start\n\t%result =l call $g4_gc_alloc(l $g4_desc_string, l %size, l 0)\n\tret %result\n}\n\nfunction l $g4_temp_alloc(l %size) {\n@start\n\t%storage =l loadl $g4_temporary_storage\n\t%missing =w ceql %storage, 0\n\tjnz %missing, @initialize, @allocate\n@initialize\n\t%allocated =l call $calloc(l 1, l 1048576)\n\t%failed =w ceql %allocated, 0\n\tjnz %failed, @allocation_failed, @initialized\n@allocation_failed\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@initialized\n\tstorel %allocated, $g4_temporary_storage\n\tjmp @allocate\n@allocate\n\t%base =l loadl $g4_temporary_storage\n\t%used_address =l add $g4_temporary_storage, 8\n\t%used =l loadl %used_address\n\t%with_padding =l add %size, 7\n\t%aligned =l and %with_padding, -8\n\t%next =l add %used, %aligned\n\t%overflow =w csltl 1048576, %next\n\tjnz %overflow, @capacity_failed, @ready\n@capacity_failed\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ready\n\t%result =l add %base, %used\n\tstorel %next, %used_address\n\tret %result\n}\n\nfunction $g4_temp_reset() {\n@start\n\t%used_address =l add $g4_temporary_storage, 8\n\tstorel 0, %used_address\n\tret\n}\n\nfunction l $g4_string_from_c(l %source) {\n@start\n\t%length =l call $strlen(l %source)\n\t%size =l add %length, 9\n\t%string =l call $g4_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 16\n\tcall $memcpy(l %data, l %source, l %length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %string\n}\n\nfunction l $g4_read_file(l %p) {\n@start\n\t%f =l call $fopen(l %p, l $g4_rb)\n\t%fm =w ceql %f, 0\n\tjnz %fm, @fail, @seek\n@seek\n\t%es =w call $fseek(l %f, l 0, w 2)\n\t%ef =w cnew %es, 0\n\tjnz %ef, @close, @len\n@len\n\t%n =l call $ftell(l %f)\n\t%neg =w csltl %n, 0\n\tjnz %neg, @close, @rewind\n@rewind\n\t%rs =w call $fseek(l %f, l 0, w 0)\n\t%rf =w cnew %rs, 0\n\tjnz %rf, @close, @alloc\n@alloc\n\t%sz =l add %n, 9\n\t%s =l call $g4_string_alloc(l %sz)\n\t%length_address =l add %s, 8\n\tstorel %n, %length_address\n\t%d =l add %s, 16\n\t%got =l call $fread(l %d, l 1, l %n, l %f)\n\t%cs =w call $fclose(l %f)\n\t%rfe =w cnel %got, %n\n\t%cfe =w cnew %cs, 0\n\t%bad =w or %rfe, %cfe\n\tjnz %bad, @fail, @done\n@done\n\t%e =l add %d, %n\n\tstoreb 0, %e\n\t%file_root =l add $g4_gc_global_roots, 8\n\tstorel %s, %file_root\n\tret %s\n@close\n\t%ignored =w call $fclose(l %f)\n\tjmp @fail\n@fail\n\tret 0\n}\n",
		"function l $g4_file_exists(l %path) {\n@start\n\t%data =l add %path, 16\n\t%status =w call $access(l %data, w 0)\n\t%ok =w ceqw %status, 0\n\t%result =l extuw %ok\n\tret %result\n}\n",
