def gate4_symbol_bucket_count(element_count: Integer): Integer
	if element_count == 0
		return 0
	end
	mut bucket_count := 16
	while bucket_count < element_count * 2
		bucket_count *= 2
	end
	return bucket_count
end

def gate4_string_bucket(name: String, bucket_count: Integer): Integer
	mut hash := 0
	mut index := 0
	while index < name.size()
		mut code := gate4_ascii_code(name[index])
		if code < 0
			code = 0
		end
		hash = (hash * 131 + code) % bucket_count
		index += 1
	end
	return hash
end

def gate4_symbol_bucket(module_index: Integer, name: String, bucket_count: Integer): Integer
	return (module_index * 257 + name.size()) % bucket_count
end

def gate4_build_symbol_index(
		mut symbol_index: Gate4SymbolIndex,
		modules: Gate4IntegerStorage,
		names: Gate4StringStorage,
		element_count: Integer,
	)
	bucket_count := gate4_symbol_bucket_count(element_count)
	mut bucket := 0
	while bucket < bucket_count
		gate4_store_integer(symbol_index.heads, bucket, - 1)
		bucket += 1
	end
	mut element := 0
	while element < element_count
		module_index := gate4_load_integer(modules, element)
		name := gate4_load_string(names, element)
		bucket = gate4_symbol_bucket(module_index, name, bucket_count)
		gate4_store_integer(symbol_index.next, element, gate4_load_integer(symbol_index.heads, bucket))
		gate4_store_integer(symbol_index.heads, bucket, element)
		element += 1
	end
	return
end

def gate4_find_symbol(
		symbol_index: Gate4SymbolIndex,
		modules: Gate4IntegerStorage,
		names: Gate4StringStorage,
		module_index: Integer,
		name: String,
	): Integer
	bucket_count := symbol_index.heads.used[0]
	if bucket_count == 0
		return - 1
	end
	bucket := gate4_symbol_bucket(module_index, name, bucket_count)
	mut element := gate4_load_integer(symbol_index.heads, bucket)
	while element >= 0
		if gate4_load_integer(modules, element) == module_index
			if gate4_load_string(names, element) == name
				return element
			end
		end
		element = gate4_load_integer(symbol_index.next, element)
	end
	return - 1
end

def gate4_build_function_index(mut state: Gate4Compiler)
	gate4_build_symbol_index(state.function_lookup, state.function_modules, state.function_names, state.function_count[0])
	return
end

def gate4_build_name_index(
		mut symbol_index: Gate4SymbolIndex,
		names: Gate4StringStorage,
		element_count: Integer,
	)
	bucket_count := gate4_symbol_bucket_count(element_count)
	mut bucket := 0
	while bucket < bucket_count
		gate4_store_integer(symbol_index.heads, bucket, - 1)
		bucket += 1
	end
	mut element := 0
	while element < element_count
		name := gate4_load_string(names, element)
		bucket = gate4_string_bucket(name, bucket_count)
		gate4_store_integer(symbol_index.next, element, gate4_load_integer(symbol_index.heads, bucket))
		gate4_store_integer(symbol_index.heads, bucket, element)
		element += 1
	end
	return
end

def gate4_add_name_index(
		mut symbol_index: Gate4SymbolIndex,
		names: Gate4StringStorage,
		element_count: Integer,
	)
	bucket_count := gate4_symbol_bucket_count(element_count)
	if symbol_index.heads.used[0] != bucket_count
		gate4_build_name_index(symbol_index, names, element_count)
		return
	end
	element := element_count - 1
	name := gate4_load_string(names, element)
	bucket := gate4_string_bucket(name, bucket_count)
	gate4_store_integer(symbol_index.next, element, gate4_load_integer(symbol_index.heads, bucket))
	gate4_store_integer(symbol_index.heads, bucket, element)
	return
end

def gate4_find_name(
		symbol_index: Gate4SymbolIndex,
		names: Gate4StringStorage,
		name: String,
	): Integer
	bucket_count := symbol_index.heads.used[0]
	if bucket_count == 0
		return - 1
	end
	bucket := gate4_string_bucket(name, bucket_count)
	mut element := gate4_load_integer(symbol_index.heads, bucket)
	while element >= 0
		if gate4_load_string(names, element) == name
			return element
		end
		element = gate4_load_integer(symbol_index.next, element)
	end
	return - 1
end

def gate4_add_module(mut state: Gate4Compiler, name: String, filename: String): Integer
	index := state.module_count[0]
	gate4_store_string(state.module_names, index, name)
	gate4_store_string(state.module_files, index, filename)
	gate4_store_integer(state.module_import_starts, index, state.import_count[0])
	gate4_store_integer(state.module_import_counts, index, 0)
	state.module_count[0] = index + 1
	gate4_add_name_index(state.module_lookup, state.module_names, state.module_count[0])
	return index
end

def gate4_find_module(state: Gate4Compiler, name: String): Integer
	return gate4_find_name(state.module_lookup, state.module_names, name)
end

def gate4_terminal_token(state: Gate4Compiler, index: Integer): Boolean
	kind := gate4_load_integer(state.token_kinds, index)
	if kind == 0
		return true
	end
	return kind == 6
end

