		local_names: gate4_string_storage(capacity),
		local_types: gate4_string_storage(capacity),
		local_slots: gate4_string_storage(capacity),
		local_mutable: gate4_integer_storage(capacity),
		local_count: [0],
		slot_count: [0],
		temporary_count: [0],
		label_count: [0],
		loop_depth: [0],
		inline_budget: inline_budget,
	)
end

def gate4_output_line(mut output: Gate4Output, line: String)
	index := output.count[0]
	gate4_store_string(output.lines, index, line)
	output.count[0] = index + 1
	return
end

def gate4_integer_string(value: Integer): String
	if value == 0
		return "0"
	end
	mut remaining := value
	mut negative := false
	if remaining < 0
		negative = true
		remaining = 0 - remaining
	end
	digits := "0123456789"
	mut result := ""
	while remaining > 0
		digit := remaining % 10
		result = digits[digit] + result
		remaining /= 10
	end
	if negative
		result = "-" + result
	end
	return result
end

def gate4_ascii_code(character: String): Integer
	if character == "\n"
		return 10
	end
	if character == "\r"
		return 13
	end
	if character == "\t"
		return 9
	end
	alphabet := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
	mut index := 0
	while index < alphabet.size()
		if alphabet[index] == character
			return index + 32
		end
		index += 1
	end
	return - 1
end

def gate4_small_nonnegative_integer_operand(value: String): Boolean
	if value.size() == 0
		return false
	end
	if value.size() > 4
		return false
	end
	mut parsed := 0
	mut index := 0
	while index < value.size()
		code := gate4_ascii_code(value[index])
		if code < 48
			return false
		end
		if code > 57
			return false
		end
		parsed = parsed * 10 + code - 48
		index += 1
	end
	return parsed <= 1024
end

def gate4_number_without_underscores(value: String): String
	mut result := ""
	mut index := 0
	while index < value.size()
		if value[index] != "_"
			result += value[index]
		end
		index += 1
	end
	return result
end

def gate4_number_is_float(value: String): Boolean
	mut index := 0
	while index < value.size()
		if value[index] == "."
			return true
		end
		index += 1
	end
	return false
end

def gate4_integer_literal_in_range(value: String): Boolean
	normalized := gate4_number_without_underscores(value)
	limit := "9007199254740991"
	mut first := 0
	mut scanning := true
	while scanning
		if first >= normalized.size()
			scanning = false
		else
			if normalized[first] == "0"
				first += 1
			else
				scanning = false
			end
		end
	end
	if first == normalized.size()
		return true
	end
	digits := normalized.size() - first
	if digits < limit.size()
		return true
	end
	if digits > limit.size()
		return false
	end
	mut index := 0
	while index < limit.size()
		actual := gate4_ascii_code(normalized[first + index])
		maximum := gate4_ascii_code(limit[index])
		if actual < maximum
			return true
		end
		if actual > maximum
			return false
		end
		index += 1
	end
	return true
end

def gate4_float_literal_in_range(value: String): Boolean
	normalized := gate4_number_without_underscores(value)
	# Round-to-nearest overflows at 2^1024 - 2^970. The tie rounds to
	# infinity, so a decimal magnitude must be strictly below this integer.
	limit := ""
	mut decimal := normalized.size()
	mut index := 0
	while index < normalized.size()
		if normalized[index] == "."
			decimal = index
			index = normalized.size()
		else
			index += 1
		end
	end
	mut first := 0
	mut scanning := true
	while scanning
		if first >= decimal
			scanning = false
		else
			if normalized[first] == "0"
				first += 1
			else
				scanning = false
			end
		end
	end
	integer_digits := decimal - first
	if integer_digits < limit.size()
		return true
	end
	if integer_digits > limit.size()
		return false
	end
	index = 0
	while index < limit.size()
		actual := gate4_ascii_code(normalized[first + index])
		maximum := gate4_ascii_code(limit[index])
		if actual < maximum
			return true
		end
		if actual > maximum
			return false
		end
		index += 1
	end
	return false
end

def gate4_emit_static_strings(
		mut state: Gate4Compiler,
		mut output: Gate4Output,
	): Boolean
	deduplicate := gate4_compiler_entry_function(state) >= 0
	mut canonical_values: Array<String> := []
	mut canonical_tokens: Array<Integer> := []
	mut token_index := 0
	while token_index < state.token_count[0]
		if gate4_load_integer(state.token_kinds, token_index) == 3
			value := gate4_load_string(state.token_texts, token_index)
			mut canonical := token_index
			mut value_index := 0
			mut found := false
			if deduplicate
				while value_index < canonical_values.size()
					if canonical_values[value_index] == value
						canonical = canonical_tokens[value_index]
						found = true
						value_index = canonical_values.size()
					else
						value_index += 1
					end
				end
			end
			gate4_store_integer(state.static_string_tokens, token_index, canonical)
			if !found
				canonical_values.push(value)
				canonical_tokens.push(token_index)
				gate4_output_line(
					output,
					"data $g4s" + gate4_integer_string(token_index) + " = align 8 { l " + gate4_integer_string(value.size()) + ",",
				)
				mut line := "\tb"
				mut line_bytes := 0
				mut character_index := 0
				while character_index < value.size()
					code := gate4_ascii_code(value[character_index])
					if code < 0
						gate4_diagnostic(
							state,
							"TRBN4005",
							gate4_load_integer(state.token_lines, token_index),
							"Gate 4 QBE emission supports ASCII String literals only",
						)
					else
						line += " " + gate4_integer_string(code)
						line_bytes += 1
						if line_bytes == 16
							gate4_output_line(output, line + ",")
							line = "\tb"
							line_bytes = 0
						end
					end
					character_index += 1
				end
				if line_bytes > 0
					gate4_output_line(output, line + ",")
				end
				gate4_output_line(output, "\tb 0 }")
			end
		end
		token_index += 1
	end
	gate4_output_line(output, "")
	return !gate4_has_diagnostic(state)
end

def gate4_project_runtime_qbe_line(value: String): Boolean
	if gate4_string_starts_with(value, "data $g4_project_")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_string_has_c_prefix")
		return true
	end
	if gate4_string_starts_with(value, "function l $g4_string_suffix_after_c_prefix")
		return true
	end
	if gate4_string_starts_with(value, "function l $g4_project_request_item")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_c_")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_project_")
		return true
	end
	return gate4_string_starts_with(value, "function l $g4_collect_project_sources")
end

def gate4_emit_runtime(mut output: Gate4Output, project_runtime: Boolean)
	lines := [
		"data $g4_newline = { b 10 }",
		"data $g4_character_cache = align 8 { z 2048 }",
		"data $g4_string_storage = align 8 { l 0, l 0, l 0 }",
		"data $g4_temporary_storage = align 8 { l 0, l 0 }",
		"data $g4_allocation_error = { b 112 97 110 105 99 58 32 97 108 108 111 99 97 116 105 111 110 32 102 97 105 108 101 100 10 }",
		"data $g4_bounds_error = { b 112 97 110 105 99 58 32 105 110 100 101 120 32 105 115 32 111 117 116 32 111 102 32 98 111 117 110 100 115 10 }",
		"data $g4_integer_error = { b 112 97 110 105 99 58 32 73 110 116 101 103 101 114 32 111 112 101 114 97 116 105 111 110 32 102 97 105 108 101 100 10 }",
		"data $g4_integer_range_error = { b \"panic: Integer is outside the portable range\", b 10 }",
		"data $g4_division_error = { b \"panic: division by zero\", b 10 }",
		"data $g4_usage_error = { b \"usage: compiler {check|emit-qbe} SOURCE\", b 10, b \"       compiler build SOURCE --output OUTPUT --qbe QBE --cc CC\", b 10 }",
		"data $g4_file_error = { b \"compiler: cannot read source file: \" }",
		"data $g4_check = { b \"check\", b 0 }",
		"data $g4_emit = { b \"emit-qbe\", b 0 }",
		"data $g4_build = { b \"build\", b 0 }",
		"data $g4_output_flag = { b \"--output\", b 0 }",
		"data $g4_qbe_flag = { b \"--qbe\", b 0 }",
		"data $g4_cc_flag = { b \"--cc\", b 0 }",
		"data $g4_target_option = { b \"--target\", b 0 }",
		"data $g4_source_arg = { b \"--source-content\", b 0 }",
		"data $g4_rb = { b \"rb\", b 0 }",
		"data $g4_wb = { b \"wb\", b 0 }",
		"data $g4_ssa_suffix = { b \".trbn.ssa\", b 0 }",
		"data $g4_asm_suffix = { b \".trbn.s\", b 0 }",
		"data $g4_temp_suffix = { b \".trbn.XXXXXX\", b 0 }",
		"data $g4_slash = { b \"/\", b 0 }",
		"data $g4_target_flag = { b \"-t\", b 0 }",
		"data $g4_profile_darwin_arm64 = { b \"darwin-arm64-v0\", b 0 }",
		"data $g4_profile_linux_arm64 = { b \"linux-arm64-v0\", b 0 }",
		"data $g4_qbe_darwin_arm64 = { b \"arm64_apple\", b 0 }",
		"data $g4_qbe_linux_arm64 = { b \"arm64\", b 0 }",
		"data $g4_o_flag = { b \"-o\", b 0 }",
		"data $g4_dead_strip_darwin = { b \"-Wl,-dead_strip\", b 0 }",
		"data $g4_dead_strip_linux = { b \"-Wl,--gc-sections,--strip-all\", b 0 }",
		"data $g4_selected_qbe_target = align 8 { l $g4_qbe_darwin_arm64 }",
		"data $g4_selected_dead_strip = align 8 { l $g4_dead_strip_darwin }",
		"data $g4_project_paths = align 8 { l 0 }",
		"data $g4_project_error = align 8 { l 0 }",
		"data $g4_project_source_root = align 8 { l 0 }",
		"data $g4_project_out_root = align 8 { l 0 }",
		"data $g4_project_request_source = align 8 { l 0 }",
		"data $g4_project_request_out = align 8 { l 0 }",
		"data $g4_project_request_result = align 8 { l 0 }",
		"data $g4_project_empty_string = align 8 { l 0, b 0 }",
		"data $g4_project_request_source_prefix = { b \"trbn-internal:project-sources-v1:source-root:\", b 0 }",
		"data $g4_project_request_out_prefix = { b \"trbn-internal:project-sources-v1:out-root:\", b 0 }",
		"data $g4_project_request_collect = { b \"trbn-internal:project-sources-v1:collect\", b 0 }",
		"data $g4_project_request_path_prefix = { b \"trbn-internal:project-sources-v1:path:\", b 0 }",
		"data $g4_project_request_body_prefix = { b \"trbn-internal:project-sources-v1:source:\", b 0 }",
		"data $g4_project_trb_suffix = { b \".trb\", b 0 }",
		"data $g4_project_test_suffix = { b \"_test.trb\", b 0 }",
		"data $g4_project_git_component = { b \"/.git\", b 0 }",
		"data $g4_project_trb_component = { b \"/.trb\", b 0 }",
		"data $g4_project_node_modules_component = { b \"/node_modules\", b 0 }",
		"data $g4_target_error = { b \"compiler: unsupported target profile\", b 10 }",
		"data $g4_intermediate_error = { b \"compiler: cannot create intermediate file\", b 10 }",
		"data $g4_qbe_error = { b \"compiler: qbe failed\", b 10 }",
		"data $g4_cc_error = { b \"compiler: cc failed\", b 10 }",
		"data $g4_publish_error = { b \"compiler: cannot publish output\", b 10 }",
		"",
		"function $g4_fail(l %message, l %size) {",
		"@start",
		"\tcall $write(w 2, l %message, l %size)",
		"\tcall $exit(w 2)",
		"\thlt",
		"}",
		"",
		"function l $g4_alloc(l %size) {",
		"@start",
		"\t%pointer =l call $calloc(l 1, l %size)",
		"\t%failed =w ceql %pointer, 0",
		"\tjnz %failed, @fail, @ok",
		"@fail",
		"\tcall $g4_fail(l $g4_allocation_error, l 26)",
		"\thlt",
		"@ok",
		"\tret %pointer",
		"}",
		"",
		"function l $g4_string_alloc(l %size) {",
		"@start",
		"\t%with_padding =l add %size, 7",
		"\t%aligned =l and %with_padding, -8",
		"\t%used_address =l add $g4_string_storage, 8",
		"\t%capacity_address =l add $g4_string_storage, 16",
		"\t%base =l loadl $g4_string_storage",
		"\t%missing =w ceql %base, 0",
		"\tjnz %missing, @grow, @check",
		"@check",
		"\t%used =l loadl %used_address",
		"\t%capacity =l loadl %capacity_address",
		"\t%next =l add %used, %aligned",
		"\t%fits =w cslel %next, %capacity",
		"\tjnz %fits, @allocate, @grow",
		"@grow",
		"\t%large =w csltl 65536, %aligned",
		"\tjnz %large, @large, @standard",
		"@standard",
		"\t%standard =l call $calloc(l 1, l 65536)",
		"\t%standard_failed =w ceql %standard, 0",
		"\tjnz %standard_failed, @fail, @standard_ready",
		"@standard_ready",
		"\tstorel %standard, $g4_string_storage",
		"\tstorel 0, %used_address",
		"\tstorel 65536, %capacity_address",
		"\tjmp @allocate",
		"@large",
		"\t%large_storage =l call $calloc(l 1, l %aligned)",
		"\t%large_failed =w ceql %large_storage, 0",
		"\tjnz %large_failed, @fail, @large_ready",
		"@large_ready",
		"\tstorel %large_storage, $g4_string_storage",
		"\tstorel 0, %used_address",
		"\tstorel %aligned, %capacity_address",
		"\tjmp @allocate",
		"@fail",
		"\tcall $g4_fail(l $g4_allocation_error, l 26)",
		"\thlt",
		"@allocate",
		"\t%current_base =l loadl $g4_string_storage",
		"\t%current_used =l loadl %used_address",
		"\t%result =l add %current_base, %current_used",
		"\t%next_used =l add %current_used, %aligned",
		"\tstorel %next_used, %used_address",
		"\tret %result",
		"}",
		"",
		"function l $g4_temp_alloc(l %size) {",
		"@start",
		"\t%storage =l loadl $g4_temporary_storage",
		"\t%missing =w ceql %storage, 0",
		"\tjnz %missing, @initialize, @allocate",
		"@initialize",
		"\t%allocated =l call $calloc(l 1, l 1048576)",
		"\t%failed =w ceql %allocated, 0",
		"\tjnz %failed, @allocation_failed, @initialized",
		"@allocation_failed",
		"\tcall $g4_fail(l $g4_allocation_error, l 26)",
		"\thlt",
		"@initialized",
		"\tstorel %allocated, $g4_temporary_storage",
		"\tjmp @allocate",
		"@allocate",
		"\t%base =l loadl $g4_temporary_storage",
		"\t%used_address =l add $g4_temporary_storage, 8",
		"\t%used =l loadl %used_address",
		"\t%with_padding =l add %size, 7",
		"\t%aligned =l and %with_padding, -8",
		"\t%next =l add %used, %aligned",
		"\t%overflow =w csltl 1048576, %next",
		"\tjnz %overflow, @capacity_failed, @ready",
		"@capacity_failed",
		"\tcall $g4_fail(l $g4_allocation_error, l 26)",
		"\thlt",
		"@ready",
		"\t%result =l add %base, %used",
		"\tstorel %next, %used_address",
		"\tret %result",
		"}",
		"",
		"function $g4_temp_reset() {",
		"@start",
		"\t%used_address =l add $g4_temporary_storage, 8",
		"\tstorel 0, %used_address",
		"\tret",
		"}",
		"",
		"function l $g4_string_from_c(l %source) {",
		"@start",
		"\t%length =l call $strlen(l %source)",
		"\t%size =l add %length, 9",
		"\t%string =l call $g4_string_alloc(l %size)",
		"\tstorel %length, %string",
		"\t%data =l add %string, 8",
		"\tcall $memcpy(l %data, l %source, l %length)",
		"\t%end =l add %data, %length",
		"\tstoreb 0, %end",
		"\tret %string",
		"}",
		"",
		"function l $g4_read_file(l %p) {\n@start\n\t%f =l call $fopen(l %p, l $g4_rb)\n\t%fm =w ceql %f, 0\n\tjnz %fm, @fail, @seek\n@seek\n\t%es =w call $fseek(l %f, l 0, w 2)\n\t%ef =w cnew %es, 0\n\tjnz %ef, @close, @len",
		"@len\n\t%n =l call $ftell(l %f)\n\t%neg =w csltl %n, 0\n\tjnz %neg, @close, @rewind\n@rewind\n\t%rs =w call $fseek(l %f, l 0, w 0)\n\t%rf =w cnew %rs, 0\n\tjnz %rf, @close, @alloc",
		"@alloc\n\t%sz =l add %n, 9\n\t%s =l call $g4_string_alloc(l %sz)\n\tstorel %n, %s\n\t%d =l add %s, 8\n\t%got =l call $fread(l %d, l 1, l %n, l %f)\n\t%cs =w call $fclose(l %f)\n\t%rfe =w cnel %got, %n\n\t%cfe =w cnew %cs, 0\n\t%bad =w or %rfe, %cfe\n\tjnz %bad, @fail, @done",
		"@done\n\t%e =l add %d, %n\n\tstoreb 0, %e\n\tret %s\n@close\n\t%ignored =w call $fclose(l %f)\n\tjmp @fail\n@fail\n\tret 0\n}\n",
		"function l $g4_file_exists(l %path) {\n@start\n\t%data =l add %path, 8\n\t%status =w call $access(l %data, w 0)\n\t%ok =w ceqw %status, 0\n\t%result =l extuw %ok\n\tret %result\n}\n",
		"function w $g4_string_has_c_prefix(l %value, l %prefix) {\n@start\n\t%value_length =l loadl %value\n\t%prefix_length =l call $strlen(l %prefix)\n\t%short =w csltl %value_length, %prefix_length\n\tjnz %short, @no, @compare\n@compare\n\t%data =l add %value, 8\n\t%comparison =w call $memcmp(l %data, l %prefix, l %prefix_length)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n",
		"function l $g4_string_suffix_after_c_prefix(l %value, l %prefix) {\n@start\n\t%value_length =l loadl %value\n\t%prefix_length =l call $strlen(l %prefix)\n\t%suffix_length =l sub %value_length, %prefix_length\n\t%size =l add %suffix_length, 9\n\t%result =l call $g4_string_alloc(l %size)\n\tstorel %suffix_length, %result\n\t%value_data =l add %value, 8\n\t%source =l add %value_data, %prefix_length\n\t%target =l add %result, 8\n\tcall $memcpy(l %target, l %source, l %suffix_length)\n\t%end =l add %target, %suffix_length\n\tstoreb 0, %end\n\tret %result\n}\n",
		"function l $g4_project_request_item(l %path, l %prefix, l %field_offset) {\n@start\n\t%result =l loadl $g4_project_request_result\n\t%missing =w ceql %result, 0\n\tjnz %missing, @empty, @index\n@index\n\t%prefix_length =l call $strlen(l %prefix)\n\t%path_data =l add %path, 8\n\t%index_data =l add %path_data, %prefix_length\n\t%requested =l call $strtol(l %index_data, l 0, w 10)\n\t%negative =w csltl %requested, 0\n\tjnz %negative, @empty, @array\n@array\n\t%field =l add %result, %field_offset\n\t%items =l loadl %field\n\t%count =l loadl %items\n\t%past =w cslel %count, %requested\n\tjnz %past, @empty, @load\n@load\n\t%data_slot =l add %items, 16\n\t%data =l loadl %data_slot\n\t%offset =l mul %requested, 8\n\t%slot =l add %data, %offset\n\t%item =l loadl %slot\n\tret %item\n@empty\n\tret $g4_project_empty_string\n}\n",
		"function l $g4_read_source(l %path) {\n@start\n\t%set_source =w call $g4_string_has_c_prefix(l %path, l $g4_project_request_source_prefix)\n\tjnz %set_source, @source_root, @check_out\n@source_root\n\t%source_value =l call $g4_string_suffix_after_c_prefix(l %path, l $g4_project_request_source_prefix)\n\tstorel %source_value, $g4_project_request_source\n\tret $g4_project_empty_string\n@check_out\n\t%set_out =w call $g4_string_has_c_prefix(l %path, l $g4_project_request_out_prefix)\n\tjnz %set_out, @out_root, @check_collect\n@out_root\n\t%out_value =l call $g4_string_suffix_after_c_prefix(l %path, l $g4_project_request_out_prefix)\n\tstorel %out_value, $g4_project_request_out\n\tret $g4_project_empty_string\n@check_collect\n\t%collect =w call $g4_string_has_c_prefix(l %path, l $g4_project_request_collect)\n\tjnz %collect, @collect, @check_path\n@collect\n\t%source_root =l loadl $g4_project_request_source\n\t%out_root =l loadl $g4_project_request_out\n\t%source_missing =w ceql %source_root, 0\n\t%out_missing =w ceql %out_root, 0\n\t%roots_missing =w or %source_missing, %out_missing\n\tjnz %roots_missing, @empty, @run_collect\n@run_collect\n\t%result =l call $g4_collect_project_sources(l %source_root, l %out_root)\n\tstorel %result, $g4_project_request_result\n\t%error_slot =l add %result, 16\n\t%error =l loadl %error_slot\n\tret %error\n@check_path\n\t%path_request =w call $g4_string_has_c_prefix(l %path, l $g4_project_request_path_prefix)\n\tjnz %path_request, @path_item, @check_body\n@path_item\n\t%path_item_value =l call $g4_project_request_item(l %path, l $g4_project_request_path_prefix, l 0)\n\tret %path_item_value\n@check_body\n\t%body_request =w call $g4_string_has_c_prefix(l %path, l $g4_project_request_body_prefix)\n\tjnz %body_request, @body_item, @file\n@body_item\n\t%body_item_value =l call $g4_project_request_item(l %path, l $g4_project_request_body_prefix, l 8)\n\tret %body_item_value\n@file\n\t%data =l add %path, 8\n\t%file_source =l call $g4_read_file(l %data)\n\tret %file_source\n@empty\n\tret $g4_project_empty_string\n}\n",
		"function w $g4_c_ends_with(l %value, l %suffix) {\n@start\n\t%value_length =l call $strlen(l %value)\n\t%suffix_length =l call $strlen(l %suffix)\n\t%short =w csltl %value_length, %suffix_length\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %value_length, %suffix_length\n\t%start =l add %value, %offset\n\t%comparison =w call $memcmp(l %start, l %suffix, l %suffix_length)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n",
		"function w $g4_c_is_test_source(l %path) {\n@start\n\t%length =l call $strlen(l %path)\n\t%short =w csltl %length, 9\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %length, 9\n\t%start =l add %path, %offset\n\t%comparison =w call $strncasecmp(l %start, l $g4_project_test_suffix, l 9)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n",
		"function w $g4_c_has_directory_component(l %path, l %component) {\n@start\n\t%component_length =l call $strlen(l %component)\n\tjmp @search\n@search\n\t%cursor =l phi @start %path, @advance %advanced\n\t%match =l call $strstr(l %cursor, l %component)\n\t%missing =w ceql %match, 0\n\tjnz %missing, @no, @boundary\n@boundary\n\t%after =l add %match, %component_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tjnz %matched, @yes, @advance\n@advance\n\t%advanced =l add %match, 1\n\tjmp @search\n@yes\n\tret 1\n@no\n\tret 0\n}\n",
		"function w $g4_c_path_has_prefix(l %path, l %prefix) {\n@start\n\t%path_length =l call $strlen(l %path)\n\t%prefix_length =l call $strlen(l %prefix)\n\t%short =w csltl %path_length, %prefix_length\n\tjnz %short, @no, @compare\n@compare\n\t%comparison =w call $memcmp(l %path, l %prefix, l %prefix_length)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @no, @boundary\n@boundary\n\t%after =l add %path, %prefix_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tret %matched\n@no\n\tret 0\n}\n",
		"function w $g4_project_path_excluded(l %path) {\n@start\n\t%source_root =l loadl $g4_project_source_root\n\t%source_comparison =w call $strcmp(l %path, l %source_root)\n\t%source =w ceqw %source_comparison, 0\n\tjnz %source, @no, @out_root\n@out_root\n\t%out_root =l loadl $g4_project_out_root\n\t%roots_comparison =w call $strcmp(l %source_root, l %out_root)\n\t%same_roots =w ceqw %roots_comparison, 0\n\tjnz %same_roots, @components, @out_prefix\n@out_prefix\n\t%inside_out =w call $g4_c_path_has_prefix(l %path, l %out_root)\n\tjnz %inside_out, @yes, @components\n@components\n\t%git =w call $g4_c_has_directory_component(l %path, l $g4_project_git_component)\n\tjnz %git, @yes, @trb\n@trb\n\t%hidden =w call $g4_c_has_directory_component(l %path, l $g4_project_trb_component)\n\tjnz %hidden, @yes, @node_modules\n@node_modules\n\t%node =w call $g4_c_has_directory_component(l %path, l $g4_project_node_modules_component)\n\tjnz %node, @yes, @no\n@yes\n\tret 1\n@no\n\tret 0\n}\n",
		"function w $g4_project_path_compare(l %left_cell, l %right_cell) {\n@start\n\t%left =l loadl %left_cell\n\t%right =l loadl %right_cell\n\t%left_length =l loadl %left\n\t%right_length =l loadl %right\n\t%left_shorter =w csltl %left_length, %right_length\n\tjnz %left_shorter, @left_minimum, @right_minimum\n@left_minimum\n\t%left_min =l copy %left_length\n\tjmp @compare\n@right_minimum\n\t%right_min =l copy %right_length\n\tjmp @compare\n@compare\n\t%minimum =l phi @left_minimum %left_min, @right_minimum %right_min\n\t%left_data =l add %left, 8\n\t%right_data =l add %right, 8\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %minimum)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @compared, @lengths\n@compared\n\tret %comparison\n@lengths\n\t%shorter =w csltl %left_length, %right_length\n\tjnz %shorter, @less, @longer\n@longer\n\t%greater =w csgtl %left_length, %right_length\n\tjnz %greater, @more, @equal\n@less\n\tret -1\n@more\n\tret 1\n@equal\n\tret 0\n}\n",
		"function w $g4_project_walk_callback(l %path, l %stat, w %type, l %walk) {\n@start\n\t%excluded =w call $g4_project_path_excluded(l %path)\n\tjnz %excluded, @ignore, @classify\n@classify\n\t%regular =w ceqw %type, 0\n\tjnz %regular, @regular, @directory\n@directory\n\t%directory =w ceqw %type, 1\n\tjnz %directory, @ignore, @walk_error\n@walk_error\n\t%denied =w ceqw %type, 2\n\t%unknown =w ceqw %type, 4\n\t%unreadable =w or %denied, %unknown\n\tjnz %unreadable, @error, @special\n@special\n\t%source_kind =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source_kind, @error, @ignore\n@regular\n\t%source =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source, @test, @ignore\n@test\n\t%test_source =w call $g4_c_is_test_source(l %path)\n\tjnz %test_source, @ignore, @collect\n@collect\n\t%owned =l call $g4_string_from_c(l %path)\n\t%paths =l loadl $g4_project_paths\n\tcall $g4_array_push(l %paths, l %owned)\n\tret 0\n@error\n\t%error =l call $g4_string_from_c(l %path)\n\tstorel %error, $g4_project_error\n\tret 1\n@ignore\n\tret 0\n}\n",
		"function l $g4_collect_project_sources(l %source_root, l %out_root) {\n@start\n\t%result =l call $g4_alloc(l 24)\n\t%paths =l call $g4_array_new()\n\t%sources =l call $g4_array_new()\n\tstorel %paths, %result\n\t%sources_slot =l add %result, 8\n\tstorel %sources, %sources_slot\n\t%error_slot =l add %result, 16\n\tstorel $g4_project_empty_string, %error_slot\n\tstorel %paths, $g4_project_paths\n\tstorel 0, $g4_project_error\n\t%source_data =l add %source_root, 8\n\t%out_data =l add %out_root, 8\n\tstorel %source_data, $g4_project_source_root\n\tstorel %out_data, $g4_project_out_root\n\t%walk_status =w call $nftw(l %source_data, l $g4_project_walk_callback, w 32, w 1)\n\t%walk_error =l loadl $g4_project_error\n\t%callback_failed =w cnel %walk_error, 0\n\tjnz %callback_failed, @failed, @walk_result\n@walk_result\n\t%walk_failed =w cnew %walk_status, 0\n\tjnz %walk_failed, @root_failed, @sort\n@root_failed\n\tstorel %source_root, %error_slot\n\tret %result\n@failed\n\tstorel %walk_error, %error_slot\n\tret %result\n@sort\n\t%path_count =l loadl %paths\n\t%multiple =w csltl 1, %path_count\n\tjnz %multiple, @sort_paths, @read_start\n@sort_paths\n\t%paths_data_slot =l add %paths, 16\n\t%paths_data =l loadl %paths_data_slot\n\tcall $qsort(l %paths_data, l %path_count, l 8, l $g4_project_path_compare)\n\tjmp @read_start\n@read_start\n\t%read_data_slot =l add %paths, 16\n\t%read_data =l loadl %read_data_slot\n\tjmp @read_loop\n@read_loop\n\t%index =l phi @read_start 0, @read_next %next_index\n\t%finished =w cslel %path_count, %index\n\tjnz %finished, @success, @read\n@read\n\t%offset =l mul %index, 8\n\t%path_slot =l add %read_data, %offset\n\t%path =l loadl %path_slot\n\t%path_data =l add %path, 8\n\t%source =l call $g4_read_file(l %path_data)\n\t%read_failed =w ceql %source, 0\n\tjnz %read_failed, @source_failed, @source_ready\n@source_failed\n\tstorel %path, %error_slot\n\tret %result\n@source_ready\n\tcall $g4_array_push(l %sources, l %source)\n\tjmp @read_next\n@read_next\n\t%next_index =l add %index, 1\n\tjmp @read_loop\n@success\n\tret %result\n}\n",
		"function l $g4_c_concat(l %a, l %b) {\n@start\n\t%an =l call $strlen(l %a)\n\t%bn =l call $strlen(l %b)\n\t%n =l add %an, %bn\n\t%sz =l add %n, 1\n\t%r =l call $g4_alloc(l %sz)\n\tcall $memcpy(l %r, l %a, l %an)\n\t%p =l add %r, %an\n\tcall $memcpy(l %p, l %b, l %bn)\n\tret %r\n}\n",
		"function l $g4_c_basename(l %path) {\n@start\n\t%slash =l call $strrchr(l %path, w 47)\n\t%missing =w ceql %slash, 0\n\tjnz %missing, @whole, @suffix\n@whole\n\tret %path\n@suffix\n\t%base =l add %slash, 1\n\tret %base\n}\n",
		"function w $g4_run(l %program, l %args) {\n@start\n\t%pid =w call $fork()\n\t%ff =w csltw %pid, 0\n\tjnz %ff, @fail, @child_check\n@child_check\n\t%child =w ceqw %pid, 0\n\tjnz %child, @child, @parent\n@child\n\t%ignored =w call $execv(l %program, l %args)\n\tcall $exit(w 127)\n\thlt\n@parent\n\t%sp =l alloc8 8\n\tstorew 0, %sp\n\t%waited =w call $waitpid(w %pid, l %sp, w 0)\n\t%wf =w csltw %waited, 0\n\tjnz %wf, @fail, @status\n@status\n\t%st =w loadw %sp\n\t%sig =w and %st, 127\n\t%signaled =w cnew %sig, 0\n\tjnz %signaled, @signal, @exited\n@signal\n\t%sr =w add %sig, 128\n\tret %sr\n@exited\n\t%shifted =w shr %st, 8\n\t%code =w and %shifted, 255\n\tret %code\n@fail\n\tret 127\n}\n",
		"function w $g4_run_qbe(l %qbe, l %ssa, l %assembly) {\n@start\n\t%target =l loadl $g4_selected_qbe_target\n\t%a =l alloc8 56\n\tstorel %qbe, %a\n\t%a1 =l add %a, 8\n\tstorel $g4_target_flag, %a1\n\t%a2 =l add %a, 16\n\tstorel %target, %a2\n\t%a3 =l add %a, 24\n\tstorel $g4_o_flag, %a3\n\t%a4 =l add %a, 32\n\tstorel %assembly, %a4\n\t%a5 =l add %a, 40\n\tstorel %ssa, %a5\n\t%a6 =l add %a, 48\n\tstorel 0, %a6\n\t%r =w call $g4_run(l %qbe, l %a)\n\tret %r\n}\n",
		"function w $g4_run_cc(l %cc, l %assembly, l %output) {\n@start\n\t%dead_strip =l loadl $g4_selected_dead_strip\n\t%a =l alloc8 48\n\tstorel %cc, %a\n\t%a1 =l add %a, 8\n\tstorel %assembly, %a1\n\t%a2 =l add %a, 16\n\tstorel %dead_strip, %a2\n\t%a3 =l add %a, 24\n\tstorel $g4_o_flag, %a3\n\t%a4 =l add %a, 32\n\tstorel %output, %a4\n\t%a5 =l add %a, 40\n\tstorel 0, %a5\n\t%r =w call $g4_run(l %cc, l %a)\n\tret %r\n}\n",
		"function $g4_cleanup(l %ssa, l %assembly) {\n@start\n\t%i0 =w call $unlink(l %ssa)\n\t%i1 =w call $unlink(l %assembly)\n\tret\n}\n",
		"function $g4_cleanup_output(l %output, l %directory) {\n@start\n\t%i0 =w call $unlink(l %output)\n\t%i1 =w call $rmdir(l %directory)\n\tret\n}\n",
		"function l $g4_string_concat(l %left, l %right) {",
		"@start",
		"\t%left_length =l loadl %left",
		"\t%right_length =l loadl %right",
		"\t%length =l add %left_length, %right_length",
		"\t%size =l add %length, 9",
		"\t%string =l call $g4_string_alloc(l %size)",
		"\tstorel %length, %string",
		"\t%data =l add %string, 8",
		"\t%left_data =l add %left, 8",
		"\tcall $memcpy(l %data, l %left_data, l %left_length)",
		"\t%right_target =l add %data, %left_length",
		"\t%right_data =l add %right, 8",
		"\tcall $memcpy(l %right_target, l %right_data, l %right_length)",
		"\t%end =l add %data, %length",
		"\tstoreb 0, %end",
		"\tret %string",
		"}",
		"",
		"function l $g4_string_equal(l %left, l %right) {",
		"@start",
		"\t%left_length =l loadl %left",
		"\t%right_length =l loadl %right",
		"\t%same_length =w ceql %left_length, %right_length",
		"\tjnz %same_length, @compare, @different",
		"@compare",
		"\t%left_data =l add %left, 8",
		"\t%right_data =l add %right, 8",
		"\t%comparison =w call $memcmp(l %left_data, l %right_data, l %left_length)",
		"\t%equal =w ceqw %comparison, 0",
		"\t%result =l extuw %equal",
		"\tret %result",
		"@different",
		"\tret 0",
		"}",
		"",
		"function l $g4_string_index(l %string, l %requested) {",
		"@start",
		"\t%length =l loadl %string",
		"\t%negative =w csltl %requested, 0",
		"\tjnz %negative, @negative, @check",
		"@negative",
		"\t%adjusted_negative =l add %length, %requested",
		"\tjmp @bounds",
		"@check",
		"\t%adjusted_positive =l copy %requested",
		"\tjmp @bounds",
		"@bounds",
		"\t%index =l phi @negative %adjusted_negative, @check %adjusted_positive",
		"\t%below =w csltl %index, 0",
		"\t%above =w cslel %length, %index",
		"\t%invalid =w or %below, %above",
		"\tjnz %invalid, @fail, @load",
		"@fail",
		"\tcall $g4_fail(l $g4_bounds_error, l 30)",
		"\thlt",
		"@load",
		"\t%data =l add %string, 8",
		"\t%address =l add %data, %index",
		"\t%character =w loadub %address",
		"\t%character_long =l extuw %character",
		"\t%cache_offset =l mul %character_long, 8",
		"\t%cache_slot =l add $g4_character_cache, %cache_offset",
		"\t%cached =l loadl %cache_slot",
		"\t%missing =w ceql %cached, 0",
		"\tjnz %missing, @allocate, @cached",
		"@cached",
		"\tret %cached",
		"@allocate",
		"\t%result =l call $g4_string_alloc(l 10)",
		"\tstorel 1, %result",
		"\t%result_data =l add %result, 8",
		"\tstoreb %character, %result_data",
		"\t%result_end =l add %result_data, 1",
		"\tstoreb 0, %result_end",
		"\tstorel %result, %cache_slot",
		"\tret %result",
		"}",
		"",
		"function $g4_puts(l %string) {",
		"@start",
		"\t%length =l loadl %string",
		"\t%data =l add %string, 8",
		"\tcall $write(w 1, l %data, l %length)",
		"\tcall $write(w 1, l $g4_newline, l 1)",
		"\tret",
		"}",
		"",
		"function $g4_eputs(l %string) {\n@start\n\t%length =l loadl %string\n\t%data =l add %string, 8\n\tcall $write(w 2, l %data, l %length)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret\n}\n",
		"function l $g4_array_new() {",
		"@start",
		"\t%array =l call $g4_alloc(l 24)",
		"\t%data =l call $g4_alloc(l 32)",
		"\tstorel 0, %array",
		"\t%capacity =l add %array, 8",
		"\tstorel 4, %capacity",
		"\t%data_slot =l add %array, 16",
		"\tstorel %data, %data_slot",
		"\tret %array",
		"}",
		"",
		"function $g4_array_push(l %array, l %value) {",
		"@start",
		"\t%length =l loadl %array",
		"\t%capacity_slot =l add %array, 8",
		"\t%capacity =l loadl %capacity_slot",
		"\t%full =w ceql %length, %capacity",
		"\tjnz %full, @grow, @store",
		"@grow",
		"\t%new_capacity =l mul %capacity, 2",
		"\t%new_bytes =l mul %new_capacity, 8",
		"\t%data_slot =l add %array, 16",
		"\t%data =l loadl %data_slot",
		"\t%new_data =l call $realloc(l %data, l %new_bytes)",
		"\t%failed =w ceql %new_data, 0",
		"\tjnz %failed, @fail, @grown",
		"@fail",
		"\tcall $g4_fail(l $g4_allocation_error, l 26)",
		"\thlt",
		"@grown",
		"\tstorel %new_capacity, %capacity_slot",
		"\tstorel %new_data, %data_slot",
		"\tjmp @store",
		"@store",
		"\t%current_data_slot =l add %array, 16",
		"\t%current_data =l loadl %current_data_slot",
		"\t%offset =l mul %length, 8",
		"\t%target =l add %current_data, %offset",
		"\tstorel %value, %target",
		"\t%new_length =l add %length, 1",
		"\tstorel %new_length, %array",
		"\tret",
		"}",
		"",
		"function l $g4_array_address(l %array, l %requested) {",
		"@start",
		"\t%length =l loadl %array",
		"\t%negative =w csltl %requested, 0",
		"\tjnz %negative, @negative, @check",
		"@negative",
		"\t%adjusted_negative =l add %length, %requested",
		"\tjmp @bounds",
		"@check",
		"\t%adjusted_positive =l copy %requested",
		"\tjmp @bounds",
		"@bounds",
		"\t%index =l phi @negative %adjusted_negative, @check %adjusted_positive",
		"\t%below =w csltl %index, 0",
		"\t%above =w cslel %length, %index",
		"\t%invalid =w or %below, %above",
		"\tjnz %invalid, @fail, @load",
		"@fail",
		"\tcall $g4_fail(l $g4_bounds_error, l 30)",
		"\thlt",
		"@load",
		"\t%data_slot =l add %array, 16",
		"\t%data =l loadl %data_slot",
		"\t%offset =l mul %index, 8",
		"\t%address =l add %data, %offset",
		"\tret %address",
		"}",
		"",
		"function l $g4_integer_add(l %left, l %right) {",
		"@start",
		"\t%result =l add %left, %right",
		"\t%too_high =w csgtl %result, 9007199254740991",
		"\tjnz %too_high, @fail, @check_low",
		"@check_low",
		"\t%too_low =w csltl %result, -9007199254740991",
		"\tjnz %too_low, @fail, @ok",
		"@fail",
		"\tcall $g4_fail(l $g4_integer_range_error, l 45)",
		"\thlt",
		"@ok",
		"\tret %result",
		"}",
		"",
		"function l $g4_integer_subtract(l %left, l %right) {",
		"@start",
		"\t%result =l sub %left, %right",
		"\t%too_high =w csgtl %result, 9007199254740991",
		"\tjnz %too_high, @fail, @check_low",
		"@check_low",
		"\t%too_low =w csltl %result, -9007199254740991",
		"\tjnz %too_low, @fail, @ok",
		"@fail",
		"\tcall $g4_fail(l $g4_integer_range_error, l 45)",
		"\thlt",
		"@ok",
		"\tret %result",
		"}",
		"",
		"function l $g4_integer_multiply(l %left, l %right) {",
		"@start",
		"\t%left_zero =w ceql %left, 0",
		"\tjnz %left_zero, @zero, @left_sign",
		"@left_sign",
		"\t%left_positive =w csgtl %left, 0",
		"\tjnz %left_positive, @left_positive, @left_negative",
		"@left_positive",
		"\t%right_positive =w csgtl %right, 0",
		"\tjnz %right_positive, @positive_positive, @positive_nonpositive",
		"@positive_positive",
		"\t%positive_limit =l div 9007199254740991, %right",
		"\t%positive_overflow =w csgtl %left, %positive_limit",
		"\tjnz %positive_overflow, @fail, @multiply",
		"@positive_nonpositive",
		"\t%right_zero =w ceql %right, 0",
		"\tjnz %right_zero, @zero, @positive_negative",
		"@positive_negative",
		"\t%negative_limit =l div -9007199254740991, %left",
		"\t%negative_overflow =w csltl %right, %negative_limit",
		"\tjnz %negative_overflow, @fail, @multiply",
		"@left_negative",
		"\t%right_positive_two =w csgtl %right, 0",
		"\tjnz %right_positive_two, @negative_positive, @negative_nonpositive",
		"@negative_positive",
		"\t%negative_limit_two =l div -9007199254740991, %right",
		"\t%negative_overflow_two =w csltl %left, %negative_limit_two",
		"\tjnz %negative_overflow_two, @fail, @multiply",
		"@negative_nonpositive",
		"\t%right_zero_two =w ceql %right, 0",
		"\tjnz %right_zero_two, @zero, @negative_negative",
		"@negative_negative",
		"\t%positive_limit_two =l div 9007199254740991, %right",
		"\t%positive_overflow_two =w csltl %left, %positive_limit_two",
		"\tjnz %positive_overflow_two, @fail, @multiply",
		"@multiply",
		"\t%result =l mul %left, %right",
		"\tret %result",
		"@zero",
		"\tret 0",
		"@fail",
		"\tcall $g4_fail(l $g4_integer_range_error, l 45)",
		"\thlt",
		"}",
		"",
		"function l $g4_integer_divide(l %left, l %right) {",
		"@start",
		"\t%zero =w ceql %right, 0",
		"\tjnz %zero, @fail, @ok",
		"@fail",
		"\tcall $g4_fail(l $g4_division_error, l 24)",
		"\thlt",
		"@ok",
		"\t%result =l div %left, %right",
		"\tret %result",
		"}",
		"",
		"function l $g4_integer_remainder(l %left, l %right) {",
		"@start",
		"\t%zero =w ceql %right, 0",
		"\tjnz %zero, @fail, @ok",
		"@fail",
		"\tcall $g4_fail(l $g4_division_error, l 24)",
		"\thlt",
		"@ok",
		"\t%result =l rem %left, %right",
		"\tret %result",
		"}",
		"",
	]
	mut index := 0
	while index < lines.size()
		line := lines[index]
		if project_runtime
			gate4_output_line(output, line)
		else
			if gate4_string_starts_with(line, "function l $g4_read_source")
				gate4_output_line(
					output,
					"function l $g4_read_source(l %path) {\n@start\n\t%data =l add %path, 8\n\t%source =l call $g4_read_file(l %data)\n\tret %source\n}\n",
				)
			else
				if !gate4_project_runtime_qbe_line(line)
					gate4_output_line(output, line)
				end
			end
		end
		index += 1
	end
	return
end

def gate4_emit_float_array_runtime(mut output: Gate4Output)
	mut start :=- 1
	mut index := 0
	while index < output.count[0]
		if gate4_load_string(output.lines, index) == "function $g4_array_push(l %array, l %value) {"
			start = index
			index = output.count[0]
		else
			index += 1
		end
	end
	if start < 0
		return
	end
	gate4_output_line(output, "")
	gate4_output_line(output, "function $g4_array_push_d(l %array, d %value) {")
	index = start + 1
	mut finished := false
	while !finished
		mut line := gate4_load_string(output.lines, index)
		if line == "\tstorel %value, %target"
			line = "\tstored %value, %target"
		end
		gate4_output_line(output, line)
		if line == "}"
			finished = true
		end
		index += 1
	end
end

def gate4_output_starts_with(output: Gate4Output, prefix: String): Boolean
	mut index := 0
	while index < output.count[0]
		if gate4_string_starts_with(gate4_load_string(output.lines, index), prefix)
			return true
		end
		index += 1
	end
	return false
end

def gate4_emitted_value(
		operand: String,
		type_name: String,
		category: Integer,
		name: String,
		mutable: Integer,
		address: String,
	): Gate4EmittedValue
	return Gate4EmittedValue.new(
		operand: operand,
		type_name: type_name,
		category: category,
		name: name,
		mutable: mutable,
		address: address,
	)
end

def gate4_qbe_type(type_name: String): String
	if type_name == "Float"
		return "d"
	end
	return "l"
end

def gate4_qbe_load(type_name: String): String
	if type_name == "Float"
		return "loadd"
	end
	return "loadl"
end

def gate4_qbe_store(type_name: String): String
	if type_name == "Float"
		return "stored"
	end
	return "storel"
end

def gate4_array_push_function(element_type: String): String
	if element_type == "Float"
		return "$g4_array_push_d"
	end
	return "$g4_array_push"
end

def gate4_emit_array_push(
		mut output: Gate4Output,
		array: String,
		element_type: String,
		operand: String,
	)
	gate4_output_line(
		output,
		"\tcall " + gate4_array_push_function(element_type) + "(l " + array + ", " +
		gate4_qbe_type(element_type) + " " + operand + ")",
	)
end

def gate4_emit_expected_type(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		value: Gate4EmittedValue,
		expected: String,
	): Gate4EmittedValue
	if expected == "Float"
		if value.type_name == "Integer"
			result := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + result + " =d sltof " + value.operand)
			return gate4_emitted_value(result, "Float", value.category, value.name, value.mutable, value.address)
		end
	end
	return value
end

def gate4_emit_temporary(mut context: Gate4EmitContext): String
	index := context.temporary_count[0]
	context.temporary_count[0] = index + 1
	return "%t" + gate4_integer_string(index)
end

def gate4_emit_label(mut context: Gate4EmitContext): String
	index := context.label_count[0]
	context.label_count[0] = index + 1
	return "@l" + gate4_integer_string(index)
end

def gate4_take_inline_budget(mut context: Gate4EmitContext): Boolean
	if context.loop_depth[0] <= 0
		return false
	end
	if context.inline_budget[0] <= 0
		return false
	end
	context.inline_budget[0] = context.inline_budget[0] - 1
	return true
end

def gate4_emit_checked_integer_add(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	too_high := gate4_emit_temporary(context)
	too_low := gate4_emit_temporary(context)
	check_low := gate4_emit_label(context)
	failure := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + result + " =l add " + left + ", " + right)
	gate4_output_line(output, "\t" + too_high + " =w csgtl " + result + ", 9007199254740991")
	gate4_output_line(output, "\tjnz " + too_high + ", " + failure + ", " + check_low)
	gate4_output_line(output, check_low)
	gate4_output_line(output, "\t" + too_low + " =w csltl " + result + ", -9007199254740991")
	gate4_output_line(output, "\tjnz " + too_low + ", " + failure + ", " + complete)
	gate4_output_line(output, failure)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_integer_range_error, l 45)")
	gate4_output_line(output, "\thlt")
	gate4_output_line(output, complete)
	return
end

def gate4_emit_checked_integer_subtract(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	too_high := gate4_emit_temporary(context)
	too_low := gate4_emit_temporary(context)
	check_low := gate4_emit_label(context)
	failure := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + result + " =l sub " + left + ", " + right)
	gate4_output_line(output, "\t" + too_high + " =w csgtl " + result + ", 9007199254740991")
	gate4_output_line(output, "\tjnz " + too_high + ", " + failure + ", " + check_low)
	gate4_output_line(output, check_low)
	gate4_output_line(output, "\t" + too_low + " =w csltl " + result + ", -9007199254740991")
	gate4_output_line(output, "\tjnz " + too_low + ", " + failure + ", " + complete)
	gate4_output_line(output, failure)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_integer_range_error, l 45)")
	gate4_output_line(output, "\thlt")
	gate4_output_line(output, complete)
	return
end

def gate4_emit_checked_integer_multiply(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	if gate4_small_nonnegative_integer_operand(right)
		if gate4_take_inline_budget(context)
			too_high := gate4_emit_temporary(context)
			too_low := gate4_emit_temporary(context)
			check_low := gate4_emit_label(context)
			failure := gate4_emit_label(context)
			complete := gate4_emit_label(context)
			gate4_output_line(output, "\t" + result + " =l mul " + left + ", " + right)
			gate4_output_line(output, "\t" + too_high + " =w csgtl " + result + ", 9007199254740991")
			gate4_output_line(output, "\tjnz " + too_high + ", " + failure + ", " + check_low)
			gate4_output_line(output, check_low)
			gate4_output_line(output, "\t" + too_low + " =w csltl " + result + ", -9007199254740991")
			gate4_output_line(output, "\tjnz " + too_low + ", " + failure + ", " + complete)
			gate4_output_line(output, failure)
			gate4_output_line(output, "\tcall $g4_fail(l $g4_integer_range_error, l 45)")
			gate4_output_line(output, "\thlt")
			gate4_output_line(output, complete)
			return
		end
	end
	gate4_output_line(
		output,
		"\t" + result + " =l call $g4_integer_multiply(l " + left + ", l " + right + ")",
	)
	return
end

def gate4_emit_checked_integer_divide(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	zero := gate4_emit_temporary(context)
	failure := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + zero + " =w ceql " + right + ", 0")
	gate4_output_line(output, "\tjnz " + zero + ", " + failure + ", " + complete)
	gate4_output_line(output, failure)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_division_error, l 24)")
	gate4_output_line(output, "\thlt")
	gate4_output_line(output, complete)
	gate4_output_line(output, "\t" + result + " =l div " + left + ", " + right)
	return
end

def gate4_emit_checked_integer_remainder(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result: String,
		left: String,
		right: String,
	)
	zero := gate4_emit_temporary(context)
	failure := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	gate4_output_line(output, "\t" + zero + " =w ceql " + right + ", 0")
	gate4_output_line(output, "\tjnz " + zero + ", " + failure + ", " + complete)
	gate4_output_line(output, failure)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_division_error, l 24)")
	gate4_output_line(output, "\thlt")
	gate4_output_line(output, complete)
	gate4_output_line(output, "\t" + result + " =l rem " + left + ", " + right)
	return
end

def gate4_emit_array_address(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		array: String,
		requested: String,
	): String
	length := gate4_emit_temporary(context)
	negative := gate4_emit_temporary(context)
	adjusted_negative := gate4_emit_temporary(context)
	adjusted_positive := gate4_emit_temporary(context)
	index := gate4_emit_temporary(context)
	below := gate4_emit_temporary(context)
	above := gate4_emit_temporary(context)
	invalid := gate4_emit_temporary(context)
	data_slot := gate4_emit_temporary(context)
	data := gate4_emit_temporary(context)
	offset := gate4_emit_temporary(context)
	address := gate4_emit_temporary(context)
	negative_label := gate4_emit_label(context)
	check_label := gate4_emit_label(context)
	bounds_label := gate4_emit_label(context)
	failure_label := gate4_emit_label(context)
	load_label := gate4_emit_label(context)
	gate4_output_line(output, "\t" + length + " =l loadl " + array)
	gate4_output_line(output, "\t" + negative + " =w csltl " + requested + ", 0")
	gate4_output_line(output, "\tjnz " + negative + ", " + negative_label + ", " + check_label)
	gate4_output_line(output, negative_label)
	gate4_output_line(output, "\t" + adjusted_negative + " =l add " + length + ", " + requested)
	gate4_output_line(output, "\tjmp " + bounds_label)
	gate4_output_line(output, check_label)
	gate4_output_line(output, "\t" + adjusted_positive + " =l copy " + requested)
	gate4_output_line(output, "\tjmp " + bounds_label)
	gate4_output_line(output, bounds_label)
	gate4_output_line(
		output,
		"\t" + index + " =l phi " + negative_label + " " + adjusted_negative + ", " + check_label + " " + adjusted_positive,
	)
	gate4_output_line(output, "\t" + below + " =w csltl " + index + ", 0")
	gate4_output_line(output, "\t" + above + " =w cslel " + length + ", " + index)
	gate4_output_line(output, "\t" + invalid + " =w or " + below + ", " + above)
	gate4_output_line(output, "\tjnz " + invalid + ", " + failure_label + ", " + load_label)
	gate4_output_line(output, failure_label)
	gate4_output_line(output, "\tcall $g4_fail(l $g4_bounds_error, l 30)")
	gate4_output_line(output, "\thlt")
	gate4_output_line(output, load_label)
	gate4_output_line(output, "\t" + data_slot + " =l add " + array + ", 16")
	gate4_output_line(output, "\t" + data + " =l loadl " + data_slot)
	gate4_output_line(output, "\t" + offset + " =l mul " + index + ", 8")
	gate4_output_line(output, "\t" + address + " =l add " + data + ", " + offset)
	return address
end

def gate4_emit_local_find(context: Gate4EmitContext, name: String): Integer
	mut index := context.local_count[0] - 1
	while index >= 0
		if gate4_load_string(context.local_names, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def gate4_emit_add_local(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		name: String,
		type_name: String,
		mutable: Integer,
		initial: String,
	): String
	index := context.local_count[0]
	slot_index := context.slot_count[0]
	slot := "%v" + gate4_integer_string(slot_index)
	gate4_store_string(context.local_names, index, name)
	gate4_store_string(context.local_types, index, type_name)
	gate4_store_string(context.local_slots, index, slot)
	gate4_store_integer(context.local_mutable, index, mutable)
	context.local_count[0] = index + 1
	context.slot_count[0] = slot_index + 1
	gate4_output_line(output, "\t" + slot + " =l alloc8 8")
	gate4_output_line(output, "\t" + gate4_qbe_store(type_name) + " " + initial + ", " + slot)
	return slot
end

def gate4_emit_loaded_local(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		index: Integer,
	): Gate4EmittedValue
	operand := gate4_emit_temporary(context)
	type_name := gate4_load_string(context.local_types, index)
	gate4_output_line(
		output,
		"\t" + operand + " =" + gate4_qbe_type(type_name) + " " + gate4_qbe_load(type_name) + " " +
		gate4_load_string(context.local_slots, index),
	)
	return gate4_emitted_value(
		operand,
		type_name,
		0,
		gate4_load_string(context.local_names, index),
		gate4_load_integer(context.local_mutable, index),
		gate4_load_string(context.local_slots, index),
	)
end

def gate4_emit_address(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		base: String,
		offset: Integer,
	): String
	if offset == 0
		return base
	end
	address := gate4_emit_temporary(context)
	gate4_output_line(output, "\t" + address + " =l add " + base + ", " + gate4_integer_string(offset))
	return address
end

def gate4_emit_array_literal(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		expected: String,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	contextual_element_type := gate4_array_element_type(expected)
	mut element_type := contextual_element_type
	mut operands: Array<String> := []
	mut value_types: Array<String> := []
	array := gate4_emit_temporary(context)
	gate4_output_line(output, "\t" + array + " =l call $g4_array_new()")
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], "]")
			finished = true
		else
			value := gate4_emit_expression(state, position, context, output, 1, contextual_element_type)
			if contextual_element_type == ""
				operands.push(value.operand)
				value_types.push(value.type_name)
				element_type = gate4_common_array_element_type(element_type, value.type_name)
			else
				gate4_emit_array_push(output, array, contextual_element_type, value.operand)
			end
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, "]")
	mut index := 0
	while index < operands.size()
		mut operand := operands[index]
		if element_type == "Float"
			if value_types[index] == "Integer"
				converted := gate4_emit_temporary(context)
				gate4_output_line(output, "\t" + converted + " =d sltof " + operand)
				operand = converted
			end
		end
		gate4_emit_array_push(output, array, element_type, operand)
		index += 1
	end
	return gate4_emitted_value(array, gate4_array_type(element_type), 0, "", 1, "")
end

def gate4_emit_direct_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		callee: Gate4EmittedValue,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	function_index := gate4_find_visible_function(state, state.active_module[0], callee.name)
	mut parameter_start := 0
	mut result_type := "Void"
	if function_index >= 0
		parameter_start = gate4_load_integer(state.function_parameter_starts, function_index)
		result_type = gate4_load_string(state.function_result_types, function_index)
	end
	mut arguments := ""
	mut argument_count := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			mut expected := "String"
			if function_index >= 0
				expected = gate4_load_string(state.parameter_types, parameter_start + argument_count)
			end
			value := gate4_emit_expression(state, position, context, output, 1, expected)
			if arguments != ""
				arguments += ", "
			end
			arguments += gate4_qbe_type(value.type_name) + " " + value.operand
			argument_count += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	if gate4_compiler_entry_function(state) >= 0
		if callee.name == "gate4_file_exists"
			result := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + result + " =l call $g4_file_exists(" + arguments + ")")
			return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
		end
		if callee.name == "gate4_read_source"
			result := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + result + " =l call $g4_read_source(" + arguments + ")")
			return gate4_emitted_value(result, "String", 0, "", 0, "")
		end
	end
	if callee.name == "puts"
		gate4_output_line(output, "\tcall $g4_puts(" + arguments + ")")
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	if callee.name == "gate4_eputs"
		gate4_output_line(output, "\tcall $g4_eputs(" + arguments + ")")
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	if callee.name == "gate4_reset_temporary_storage"
		gate4_output_line(output, "\tcall $g4_temp_reset()")
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	if result_type == "Void"
		gate4_output_line(
			output,
			"\tcall $g4f" + gate4_integer_string(function_index) + "(" + arguments + ")",
		)
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	result := gate4_emit_temporary(context)
	gate4_output_line(
		output,
		"\t" + result + " =" + gate4_qbe_type(result_type) + " call $g4f" +
		gate4_integer_string(function_index) + "(" + arguments + ")",
	)
	return gate4_emitted_value(result, result_type, 0, "", 0, "")
end

def gate4_emit_record_new(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		record_name: String,
	): Gate4EmittedValue
	record_index := gate4_find_visible_record(state, state.active_module[0], record_name)
	field_start := gate4_load_integer(state.record_field_starts, record_index)
	field_count := gate4_load_integer(state.record_field_counts, record_index)
	record_value := gate4_emit_temporary(context)
	mut allocator := "$g4_alloc"
	if record_name == "Gate4CheckedValue"
		allocator = "$g4_temp_alloc"
	end
	if record_name == "Gate4EmittedValue"
		allocator = "$g4_temp_alloc"
	end
	gate4_output_line(
		output,
		"\t" + record_value + " =l call " + allocator + "(l " + gate4_integer_string(field_count * 8) + ")",
	)
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	mut field_offset := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			gate4_expect_identifier(state, position)
			gate4_expect(state, position, ":")
			value := gate4_emit_expression(
				state,
				position,
				context,
				output,
				1,
				gate4_load_string(state.field_types, field_start + field_offset),
			)
			address := gate4_emit_address(context, output, record_value, field_offset * 8)
			field_type := gate4_load_string(state.field_types, field_start + field_offset)
			gate4_output_line(output, "\t" + gate4_qbe_store(field_type) + " " + value.operand + ", " + address)
			field_offset += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	return gate4_emitted_value(record_value, gate4_record_type(record_index), 0, "", 1, "")
end

def gate4_emit_method_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		receiver: Gate4EmittedValue,
		method: String,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	if method == "size"
		gate4_expect(state, position, ")")
		result := gate4_emit_temporary(context)
		gate4_output_line(output, "\t" + result + " =l loadl " + receiver.operand)
		return gate4_emitted_value(result, "Integer", 0, "", 0, "")
	end
	if method == "push"
		element_type := gate4_array_element_type(receiver.type_name)
		value := gate4_emit_expression(state, position, context, output, 1, element_type)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		gate4_emit_array_push(output, receiver.operand, element_type, value.operand)
		return gate4_emitted_value("", "Void", 0, "", 0, "")
	end
	return gate4_emitted_value("", "Invalid", 0, "", 0, "")
end

def gate4_emit_postfix(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		initial: Gate4EmittedValue,
	): Gate4EmittedValue
	mut value := gate4_emitted_value(
		initial.operand,
		initial.type_name,
		initial.category,
		initial.name,
		initial.mutable,
		initial.address,
	)
	mut scanning := true
	while scanning
		if gate4_token_is(state, position[0], "(")
			value = gate4_emit_direct_call(state, position, context, output, value)
		else
			if gate4_token_is(state, position[0], ".")
				gate4_advance(position)
				member := gate4_expect_identifier(state, position)
				if gate4_token_is(state, position[0], "(")
					if value.category == 2
						value = gate4_emit_record_new(state, position, context, output, value.name)
					else
						value = gate4_emit_method_call(state, position, context, output, value, member)
					end
				else
					record_index := gate4_find_record_type(state, value.type_name)
					field_index := gate4_find_field(state, record_index, member)
					offset := (field_index - gate4_load_integer(state.record_field_starts, record_index)) * 8
					address := gate4_emit_address(context, output, value.operand, offset)
					operand := gate4_emit_temporary(context)
					field_type := gate4_load_string(state.field_types, field_index)
					gate4_output_line(
						output,
						"\t" + operand + " =" + gate4_qbe_type(field_type) + " " + gate4_qbe_load(field_type) + " " + address,
					)
					value = gate4_emitted_value(
						operand,
						field_type,
						0,
						member,
						value.mutable,
						address,
					)
				end
			else
				if gate4_token_is(state, position[0], "[")
					gate4_advance(position)
					index := gate4_emit_expression(state, position, context, output, 1, "Integer")
					gate4_expect(state, position, "]")
					if value.type_name == "String"
						result := gate4_emit_temporary(context)
						gate4_output_line(
							output,
							"\t" + result + " =l call $g4_string_index(l " + value.operand + ", l " + index.operand + ")",
						)
						value = gate4_emitted_value(result, "String", 0, "", 0, "")
					else
						mut address := ""
						mut inline_address := false
						if gate4_small_nonnegative_integer_operand(index.operand)
							if gate4_take_inline_budget(context)
								inline_address = true
							end
						end
						if inline_address
							address = gate4_emit_array_address(context, output, value.operand, index.operand)
						else
							address = gate4_emit_temporary(context)
							gate4_output_line(
								output,
								"\t" + address + " =l call $g4_array_address(l " + value.operand + ", l " + index.operand + ")",
							)
						end
						element_type := gate4_array_element_type(value.type_name)
						operand := gate4_emit_temporary(context)
						gate4_output_line(
							output,
							"\t" + operand + " =" + gate4_qbe_type(element_type) + " " +
							gate4_qbe_load(element_type) + " " + address,
						)
						value = gate4_emitted_value(
							operand,
							element_type,
							0,
							"",
							value.mutable,
							address,
						)
					end
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def gate4_emit_primary(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		expected: String,
	): Gate4EmittedValue
	token_index := position[0]
	kind := gate4_load_integer(state.token_kinds, token_index)
	if kind == 2
		value := gate4_number_without_underscores(gate4_load_string(state.token_texts, token_index))
		gate4_advance(position)
		if gate4_number_is_float(value)
			return gate4_emitted_value("d_" + value, "Float", 0, "", 0, "")
		end
		return gate4_emitted_value(value, "Integer", 0, "", 0, "")
	end
	if kind == 3
		gate4_advance(position)
		canonical := gate4_load_integer(state.static_string_tokens, token_index)
		return gate4_emitted_value("$g4s" + gate4_integer_string(canonical), "String", 0, "", 0, "")
	end
	if gate4_token_is(state, token_index, "[")
		return gate4_emit_array_literal(state, position, context, output, expected)
	end
	if gate4_token_is(state, token_index, "(")
		gate4_advance(position)
		gate4_skip_newlines(state, position)
		value := gate4_emit_expression(state, position, context, output, 1, expected)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		return value
	end
	if gate4_token_is(state, token_index, "!")
		gate4_advance(position)
		value := gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, "Boolean"),
		)
		comparison := gate4_emit_temporary(context)
		result := gate4_emit_temporary(context)
		gate4_output_line(output, "\t" + comparison + " =w ceql " + value.operand + ", 0")
		gate4_output_line(output, "\t" + result + " =l extuw " + comparison)
		return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
	end
	if gate4_token_is(state, token_index, "-")
		gate4_advance(position)
		value := gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, ""),
		)
		result := gate4_emit_temporary(context)
		if value.type_name == "Float"
			gate4_output_line(output, "\t" + result + " =d sub d_-0.0, " + value.operand)
			return gate4_emitted_value(result, "Float", 0, "", 0, "")
		end
		gate4_output_line(output, "\t" + result + " =l call $g4_integer_subtract(l 0, l " + value.operand + ")")
		return gate4_emitted_value(result, "Integer", 0, "", 0, "")
	end
	if gate4_token_is(state, token_index, "+")
		gate4_advance(position)
		return gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, ""),
		)
	end
	if kind == 1
		name := gate4_load_string(state.token_texts, token_index)
		gate4_advance(position)
		if name == "true"
			return gate4_emitted_value("1", "Boolean", 0, "", 0, "")
		end
		if name == "false"
			return gate4_emitted_value("0", "Boolean", 0, "", 0, "")
		end
		local_index := gate4_emit_local_find(context, name)
		if local_index >= 0
			return gate4_emit_loaded_local(context, output, local_index)
		end
		if name == "puts"
			return gate4_emitted_value("", "", 1, name, 0, "")
		end
		if gate4_find_visible_function(state, state.active_module[0], name) >= 0
			return gate4_emitted_value("", "", 1, name, 0, "")
		end
		if gate4_find_visible_record(state, state.active_module[0], name) >= 0
			return gate4_emitted_value("", "", 2, name, 0, "")
		end
	end
	return gate4_emitted_value("", "Invalid", 0, "", 0, "")
end

def gate4_emit_binary(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		operator: String,
		left: Gate4EmittedValue,
		right: Gate4EmittedValue,
	): Gate4EmittedValue
	result_type := gate4_binary_result_type_name(operator, left.type_name, right.type_name)
	result := gate4_emit_temporary(context)
	mut left_operand := left.operand
	mut right_operand := right.operand
	mut float_operands := false
	if left.type_name == "Float"
		float_operands = true
	end
	if right.type_name == "Float"
		float_operands = true
	end
	if float_operands
		if left.type_name == "Integer"
			converted_left := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + converted_left + " =d sltof " + left_operand)
			left_operand = converted_left
		end
		if right.type_name == "Integer"
			converted_right := gate4_emit_temporary(context)
			gate4_output_line(output, "\t" + converted_right + " =d sltof " + right_operand)
			right_operand = converted_right
		end
	end
	if operator == "+"
		if left.type_name == "String"
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_string_concat(l " + left.operand + ", l " + right.operand + ")",
			)
		else
			if result_type == "Float"
				gate4_output_line(output, "\t" + result + " =d add " + left_operand + ", " + right_operand)
				return gate4_emitted_value(result, result_type, 0, "", 0, "")
			end
			if gate4_take_inline_budget(context)
				gate4_emit_checked_integer_add(context, output, result, left.operand, right.operand)
			else
				gate4_output_line(
					output,
					"\t" + result + " =l call $g4_integer_add(l " + left.operand + ", l " + right.operand + ")",
				)
			end
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "-"
		if result_type == "Float"
			gate4_output_line(output, "\t" + result + " =d sub " + left_operand + ", " + right_operand)
			return gate4_emitted_value(result, result_type, 0, "", 0, "")
		end
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_subtract(context, output, result, left.operand, right.operand)
		else
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_integer_subtract(l " + left.operand + ", l " + right.operand + ")",
			)
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "*"
		if result_type == "Float"
			gate4_output_line(output, "\t" + result + " =d mul " + left_operand + ", " + right_operand)
			return gate4_emitted_value(result, result_type, 0, "", 0, "")
		end
		gate4_emit_checked_integer_multiply(context, output, result, left.operand, right.operand)
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "/"
		if result_type == "Float"
			gate4_output_line(output, "\t" + result + " =d div " + left_operand + ", " + right_operand)
			return gate4_emitted_value(result, result_type, 0, "", 0, "")
		end
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_divide(context, output, result, left.operand, right.operand)
		else
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_integer_divide(l " + left.operand + ", l " + right.operand + ")",
			)
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if operator == "%"
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_remainder(context, output, result, left.operand, right.operand)
		else
			gate4_output_line(
				output,
				"\t" + result + " =l call $g4_integer_remainder(l " + left.operand + ", l " + right.operand + ")",
			)
		end
		return gate4_emitted_value(result, result_type, 0, "", 0, "")
	end
	if left.type_name == "String"
		mut compare_strings := operator == "=="
		if operator == "!="
			compare_strings = true
		end
		if compare_strings
			mut equality := result
			if operator == "!="
				equality = gate4_emit_temporary(context)
			end
			gate4_output_line(
				output,
				"\t" + equality + " =l call $g4_string_equal(l " + left.operand + ", l " + right.operand + ")",
			)
			if operator == "!="
				word := gate4_emit_temporary(context)
				gate4_output_line(output, "\t" + word + " =w ceql " + equality + ", 0")
				gate4_output_line(output, "\t" + result + " =l extuw " + word)
			end
			return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
		end
	end
	mut comparison := "ceql"
	if float_operands
		comparison = "ceqd"
	end
	if operator == "!="
		if float_operands
			comparison = "cned"
		else
			comparison = "cnel"
		end
	end
	if operator == "<"
		if float_operands
			comparison = "cltd"
		else
			comparison = "csltl"
		end
	end
	if operator == "<="
		if float_operands
			comparison = "cled"
		else
			comparison = "cslel"
		end
	end
	if operator == ">"
		if float_operands
			comparison = "cgtd"
		else
			comparison = "csgtl"
		end
	end
	if operator == ">="
		if float_operands
			comparison = "cged"
		else
			comparison = "csgel"
		end
	end
	word := gate4_emit_temporary(context)
	gate4_output_line(
		output,
		"\t" + word + " =w " + comparison + " " + left_operand + ", " + right_operand,
	)
	gate4_output_line(output, "\t" + result + " =l extuw " + word)
	return gate4_emitted_value(result, "Boolean", 0, "", 0, "")
end

def gate4_binary_result_type_name(operator: String, left: String, right: String): String
	if operator == "=="
		return "Boolean"
	end
	if operator == "!="
		return "Boolean"
	end
	if operator == "<"
		return "Boolean"
	end
	if operator == "<="
		return "Boolean"
	end
	if operator == ">"
		return "Boolean"
	end
	if operator == ">="
		return "Boolean"
	end
	if left == "Float"
		return "Float"
	end
	if right == "Float"
		return "Float"
	end
	return left
end

def gate4_emit_expression(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		minimum_precedence: Integer,
		expected: String,
	): Gate4EmittedValue
	mut value := gate4_emit_postfix(
		state,
		position,
		context,
		output,
		gate4_emit_primary(state, position, context, output, expected),
	)
	mut scanning := true
	while scanning
		operator := gate4_load_string(state.token_texts, position[0])
		precedence := gate4_binary_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			right := gate4_emit_expression(
				state,
				position,
				context,
				output,
				precedence + 1,
				"",
			)
			value = gate4_emit_binary(context, output, operator, value, right)
		end
	end
	return gate4_emit_expected_type(context, output, value, expected)
end

def gate4_emit_declaration(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
	): Boolean
	mut mutable := 0
	if gate4_token_is(state, position[0], "mut")
		mutable = 1
		gate4_advance(position)
	end
	name := gate4_expect_identifier(state, position)
	mut declared_type := ""
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		declared_type = gate4_parse_type(state, position)
		declared_type = gate4_resolve_type_name(state, state.active_module[0], declared_type, false)
	end
	gate4_expect(state, position, ":=")
	value := gate4_emit_expression(state, position, context, output, 1, declared_type)
	mut local_type := declared_type
	if local_type == ""
		local_type = value.type_name
	end
	gate4_emit_add_local(context, output, name, local_type, mutable, value.operand)
	return gate4_finish_statement(state, position)
end

def gate4_emit_simple_statement(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
	): Boolean
	left := gate4_emit_expression(state, position, context, output, 1, "")
	operator := gate4_load_string(state.token_texts, position[0])
	if operator == "="
		gate4_advance(position)
		right := gate4_emit_expression(state, position, context, output, 1, left.type_name)
		gate4_output_line(output, "\t" + gate4_qbe_store(left.type_name) + " " + right.operand + ", " + left.address)
	else
		compound := gate4_compound_operator(operator)
		if compound != ""
			gate4_advance(position)
			right := gate4_emit_expression(state, position, context, output, 1, left.type_name)
			result := gate4_emit_binary(context, output, compound, left, right)
			gate4_output_line(output, "\t" + gate4_qbe_store(left.type_name) + " " + result.operand + ", " + left.address)
		end
	end
	return gate4_finish_statement(state, position)
end

def gate4_emit_condition(
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		operand: String,
	): String
	condition := gate4_emit_temporary(context)
	gate4_output_line(output, "\t" + condition + " =w cnel " + operand + ", 0")
	return condition
end

def gate4_emit_block(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: Gate4Output,
		result_type: String,
	): Integer
	gate4_skip_newlines(state, position)
	mut complete := false
	mut terminated := 0
	while !complete
		if gate4_token_is(state, position[0], "end")
			complete = true
		else
			if gate4_token_is(state, position[0], "else")
				complete = true
			else
				if gate4_token_is(state, position[0], "if")
					gate4_advance(position)
					condition_value := gate4_emit_expression(state, position, context, output, 1, "Boolean")
					gate4_finish_statement(state, position)
					condition := gate4_emit_condition(context, output, condition_value.operand)
					when_true := gate4_emit_label(context)
					when_false := gate4_emit_label(context)
					join := gate4_emit_label(context)
					gate4_output_line(output, "\tjnz " + condition + ", " + when_true + ", " + when_false)
					gate4_output_line(output, when_true)
					saved_count := context.local_count[0]
					true_terminated := gate4_emit_block(state, position, context, output, result_type)
					context.local_count[0] = saved_count
					if true_terminated == 0
						gate4_output_line(output, "\tjmp " + join)
					end
					gate4_output_line(output, when_false)
					mut false_terminated := 0
					if gate4_token_is(state, position[0], "else")
						gate4_advance(position)
						gate4_finish_statement(state, position)
						false_terminated = gate4_emit_block(state, position, context, output, result_type)
						context.local_count[0] = saved_count
					end
					if false_terminated == 0
						gate4_output_line(output, "\tjmp " + join)
					end
					gate4_expect(state, position, "end")
					gate4_finish_statement(state, position)
					if true_terminated == 1
						if false_terminated == 1
							terminated = 1
						else
							gate4_output_line(output, join)
						end
					else
						gate4_output_line(output, join)
					end
				else
					if gate4_token_is(state, position[0], "while")
						header := gate4_emit_label(context)
						body := gate4_emit_label(context)
						done := gate4_emit_label(context)
						gate4_output_line(output, "\tjmp " + header)
						gate4_output_line(output, header)
						gate4_advance(position)
						context.loop_depth[0] = context.loop_depth[0] + 1
						condition_value := gate4_emit_expression(state, position, context, output, 1, "Boolean")
						gate4_finish_statement(state, position)
						condition := gate4_emit_condition(context, output, condition_value.operand)
						gate4_output_line(output, "\tjnz " + condition + ", " + body + ", " + done)
						gate4_output_line(output, body)
						saved_count := context.local_count[0]
						body_terminated := gate4_emit_block(state, position, context, output, result_type)
						context.local_count[0] = saved_count
						if body_terminated == 0
							gate4_output_line(output, "\tjmp " + header)
						end
						gate4_expect(state, position, "end")
						gate4_finish_statement(state, position)
						gate4_output_line(output, done)
						context.loop_depth[0] = context.loop_depth[0] - 1
					else
						if gate4_token_is(state, position[0], "return")
							gate4_advance(position)
							if gate4_load_integer(state.token_kinds, position[0]) == 4
								gate4_output_line(output, "\tret")
							else
								value := gate4_emit_expression(state, position, context, output, 1, result_type)
								gate4_output_line(output, "\tret " + value.operand)
							end
							gate4_finish_statement(state, position)
							terminated = 1
						else
							mut declaration := false
							if gate4_token_is(state, position[0], "mut")
								declaration = true
							else
								if gate4_load_integer(state.token_kinds, position[0]) == 1
									if gate4_token_is(state, position[0] + 1, ":=")
										declaration = true
									else
										if gate4_token_is(state, position[0] + 1, ":")
											declaration = true
										end
									end
								end
							end
							if declaration
								gate4_emit_declaration(state, position, context, output)
							else
								gate4_emit_simple_statement(state, position, context, output)
							end
						end
					end
				end
			end
		end
		if terminated == 1
			while !complete
				if gate4_token_is(state, position[0], "end")
					complete = true
				else
					if gate4_token_is(state, position[0], "else")
						complete = true
					else
						gate4_parse_simple_statement_syntax(state, position)
					end
				end
			end
		end
	end
	return terminated
end

def gate4_emit_function(
		mut state: Gate4Compiler,
		function_index: Integer,
		mut output: Gate4Output,
		inline_budget: Array<Integer>,
	)
	state.active_module[0] = gate4_load_integer(state.function_modules, function_index)
	mut context := gate4_emit_context_new(state.token_count[0] + 1, inline_budget)
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_count := gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameters := ""
	mut parameter_index := 0
	while parameter_index < parameter_count
		if parameters != ""
			parameters += ", "
		end
		parameter_type := gate4_load_string(state.parameter_types, parameter_start + parameter_index)
		parameters += gate4_qbe_type(parameter_type) + " %p" + gate4_integer_string(parameter_index)
		parameter_index += 1
	end
	mut result_prefix := ""
	result_type := gate4_load_string(state.function_result_types, function_index)
	if result_type != "Void"
		result_prefix = gate4_qbe_type(result_type) + " "
	end
	gate4_output_line(
		output,
		"function " + result_prefix + "$g4f" + gate4_integer_string(function_index) + "(" + parameters + ") {",
	)
	gate4_output_line(output, "@start")
	parameter_index = 0
	while parameter_index < parameter_count
		declaration_index := parameter_start + parameter_index
		gate4_emit_add_local(
			context,
			output,
			gate4_load_string(state.parameter_names, declaration_index),
			gate4_load_string(state.parameter_types, declaration_index),
			gate4_load_integer(state.parameter_mutable, declaration_index),
			"%p" + gate4_integer_string(parameter_index),
		)
		parameter_index += 1
	end
	mut position := [gate4_load_integer(state.function_body_starts, function_index)]
	terminated := gate4_emit_block(
		state,
		position,
		context,
		output,
		gate4_load_string(state.function_result_types, function_index),
	)
	if terminated == 0
		if gate4_load_string(state.function_result_types, function_index) == "Void"
			gate4_output_line(output, "\tret")
		else
			gate4_output_line(output, "\tcall $g4_fail(l $g4_integer_error, l 32)")
			gate4_output_line(output, "\thlt")
		end
	end
	gate4_output_line(output, "}")
	gate4_output_line(output, "")
	gate4_reset_temporary_storage()
	return
end

def gate4_compiler_entry_function(state: Gate4Compiler): Integer
	index := gate4_find_function_in_module(state, state.entry_module[0], "compiler_main")
	if index < 0
		return - 1
	end
	if gate4_load_integer(state.function_parameter_counts, index) != 3
		return - 1
	end
	start := gate4_load_integer(state.function_parameter_starts, index)
	if gate4_load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 2) != "Boolean"
		return - 1
	end
	if gate4_load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def gate4_compiler_file_entry_function(state: Gate4Compiler): Integer
	index := gate4_find_function_in_module(state, state.entry_module[0], "compiler_file_main")
	if index < 0
		return - 1
	end
	if gate4_load_integer(state.function_parameter_counts, index) != 4
		return - 1
	end
	start := gate4_load_integer(state.function_parameter_starts, index)
	if gate4_load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 2) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 3) != "Boolean"
		return - 1
	end
	if gate4_load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def gate4_emit_target_entry(mut output: Gate4Output)
	gate4_output_line(output, "")
	gate4_output_line(output, "export function w $main(w %argc, l %argv) {")
	gate4_output_line(output, "@start")
	gate4_output_line(output, "\tstorel $g4_qbe_darwin_arm64, $g4_selected_qbe_target")
	gate4_output_line(output, "\tstorel $g4_dead_strip_darwin, $g4_selected_dead_strip")
	gate4_output_line(output, "\t%a11 =w ceqw %argc, 11")
	gate4_output_line(output, "\tjnz %a11, @target_shape, @dispatch")
	gate4_output_line(output, "@target_shape")
	gate4_output_line(output, "\t%target_flag_pointer =l add %argv, 72")
	gate4_output_line(output, "\t%target_flag =l loadl %target_flag_pointer")
	gate4_output_line(output, "\t%target_flag_comparison =w call $strcmp(l %target_flag, l $g4_target_option)")
	gate4_output_line(output, "\t%target_flag_ok =w ceqw %target_flag_comparison, 0")
	gate4_output_line(output, "\tjnz %target_flag_ok, @target_profile, @dispatch")
	gate4_output_line(output, "@target_profile")
	gate4_output_line(output, "\t%profile_pointer =l add %argv, 80")
	gate4_output_line(output, "\t%profile =l loadl %profile_pointer")
	gate4_output_line(output, "\t%darwin_comparison =w call $strcmp(l %profile, l $g4_profile_darwin_arm64)")
	gate4_output_line(output, "\t%darwin =w ceqw %darwin_comparison, 0")
	gate4_output_line(output, "\tjnz %darwin, @target_darwin, @target_linux_check")
	gate4_output_line(output, "@target_darwin")
	gate4_output_line(output, "\tjmp @invoke_target")
	gate4_output_line(output, "@target_linux_check")
	gate4_output_line(output, "\t%linux_comparison =w call $strcmp(l %profile, l $g4_profile_linux_arm64)")
	gate4_output_line(output, "\t%linux =w ceqw %linux_comparison, 0")
	gate4_output_line(output, "\tjnz %linux, @target_linux, @target_error")
	gate4_output_line(output, "@target_linux")
	gate4_output_line(output, "\tstorel $g4_qbe_linux_arm64, $g4_selected_qbe_target")
	gate4_output_line(output, "\tstorel $g4_dead_strip_linux, $g4_selected_dead_strip")
	gate4_output_line(output, "\tjmp @invoke_target")
	gate4_output_line(output, "@target_error")
	gate4_output_line(output, "\tcall $write(w 2, l $g4_target_error, l 37)")
	gate4_output_line(output, "\tret 64")
	gate4_output_line(output, "@invoke_target")
	gate4_output_line(output, "\t%target_status =w call $g4_compiler_dispatch(w 9, l %argv)")
	gate4_output_line(output, "\tret %target_status")
	gate4_output_line(output, "@dispatch")
	gate4_output_line(output, "\t%dispatch_status =w call $g4_compiler_dispatch(w %argc, l %argv)")
	gate4_output_line(output, "\tret %dispatch_status")
	gate4_output_line(output, "}")
	return
end

def gate4_emit_entry(state: Gate4Compiler, mut output: Gate4Output)
	compiler_entry := gate4_compiler_entry_function(state)
	if compiler_entry >= 0
		compiler_file_entry := gate4_compiler_file_entry_function(state)
		gate4_output_line(output, "function w $g4_compiler_dispatch(w %argc, l %argv) {")
		gate4_output_line(output, "@start")
		gate4_output_line(
			output,
			"\t%a9 =w ceqw %argc, 9\n\tjnz %a9, @bshape, @other\n@bshape\n\t%bcmdp =l add %argv, 8\n\t%bcmd =l loadl %bcmdp\n\t%boc =w call $strcmp(l %bcmd, l $g4_build)\n\t%bok =w ceqw %boc, 0\n\t%bofp =l add %argv, 24\n\t%bof =l loadl %bofp\n\t%bofc =w call $strcmp(l %bof, l $g4_output_flag)\n\t%bofo =w ceqw %bofc, 0\n\t%bqfp =l add %argv, 40\n\t%bqf =l loadl %bqfp\n\t%bqfc =w call $strcmp(l %bqf, l $g4_qbe_flag)\n\t%bqfo =w ceqw %bqfc, 0\n\t%bcfp =l add %argv, 56\n\t%bcf =l loadl %bcfp\n\t%bcfc =w call $strcmp(l %bcf, l $g4_cc_flag)\n\t%bcfo =w ceqw %bcfc, 0\n\t%bv0 =w and %bok, %bofo\n\t%bv1 =w and %bqfo, %bcfo\n\t%bv =w and %bv0, %bv1\n\tjnz %bv, @build, @usage\n@build\n\t%bspp =l add %argv, 16\n\t%bsp =l loadl %bspp\n\t%bsrc =l call $g4_read_file(l %bsp)\n\t%bsm =w ceql %bsrc, 0\n\tjnz %bsm, @bread_error, @bpaths\n@bread_error\n\tcall $write(w 2, l $g4_file_error, l 35)\n\t%bspl =l call $strlen(l %bsp)\n\tcall $write(w 2, l %bsp, l %bspl)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret 66\n@bpaths\n\t%bop =l add %argv, 32\n\t%bo =l loadl %bop\n\t%bqp =l add %argv, 48\n\t%bqbe =l loadl %bqp\n\t%bcp =l add %argv, 64\n\t%bcc =l loadl %bcp\n\t%bssa =l call $g4_c_concat(l %bo, l $g4_ssa_suffix)\n\t%basm =l call $g4_c_concat(l %bo, l $g4_asm_suffix)\n\t%bf =l call $fopen(l %bssa, l $g4_wb)\n\t%bfm =w ceql %bf, 0\n\tjnz %bfm, @bfile_error, @bredirect\n@bfile_error\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bredirect\n\t%bfd =w call $fileno(l %bf)\n\t%bsaved =w call $dup(w 1)\n\t%bfdb =w csltw %bfd, 0\n\t%bsavedb =w csltw %bsaved, 0\n\t%brb =w or %bfdb, %bsavedb\n\tjnz %brb, @bredirect_error, @bset_stdout\n@bset_stdout\n\t%bset =w call $dup2(w %bfd, w 1)\n\t%bsetb =w csltw %bset, 0\n\tjnz %bsetb, @bredirect_error, @bcompile\n@bredirect_error\n\t%bci =w call $close(w %bsaved)\n\t%bfci =w call $fclose(l %bf)\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bcompile\n\t%bm =l call $g4_string_from_c(l $g4_emit)",
		)
		gate4_output_line(
			output,
			"\t%bpath =l call $g4_string_from_c(l %bsp)",
		)
		gate4_output_line(
			output,
			"\t%bst =l call $g4f" + gate4_integer_string(compiler_file_entry) +
			"(l %bsrc, l %bpath, l %bm, l 1)",
		)
		gate4_output_line(
			output,
			"\t%brestore =w call $dup2(w %bsaved, w 1)\n\t%bclosed =w call $close(w %bsaved)\n\t%bfclosed =w call $fclose(l %bf)\n\t%brb0 =w csltw %brestore, 0\n\t%brb1 =w csltw %bclosed, 0\n\t%brb2 =w cnew %bfclosed, 0\n\t%brb3 =w or %brb0, %brb1\n\t%brbad =w or %brb3, %brb2\n\tjnz %brbad, @bpost_error, @bcompiled\n@bpost_error\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bcompiled\n\t%bcfail =w cnel %bst, 0\n\tjnz %bcfail, @bcompiler_failed, @bqbe\n@bcompiler_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tret 1\n@bqbe\n\t%bqs =w call $g4_run_qbe(l %bqbe, l %bssa, l %basm)\n\t%bqfail =w cnew %bqs, 0\n\tjnz %bqfail, @bqbe_failed, @btemp\n@bqbe_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_qbe_error, l 21)\n\tret 70\n@btemp\n\t%btmpl =l call $g4_c_concat(l %bo, l $g4_temp_suffix)\n\t%bdir =l call $mkdtemp(l %btmpl)\n\t%bdfail =w ceql %bdir, 0\n\tjnz %bdfail, @btemp_failed, @btemp_path\n@btemp_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@btemp_path\n\t%bbase =l call $g4_c_basename(l %bo)\n\t%bdp =l call $g4_c_concat(l %bdir, l $g4_slash)\n\t%bexe =l call $g4_c_concat(l %bdp, l %bbase)\n\t%bcs =w call $g4_run_cc(l %bcc, l %basm, l %bexe)\n\t%bccfail =w cnew %bcs, 0\n\tjnz %bccfail, @bcc_failed, @bpublish\n@bcc_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $g4_cc_error, l 20)\n\tret 70\n@bpublish\n\t%bpr =w call $rename(l %bexe, l %bo)\n\t%bpf =w cnew %bpr, 0\n\tjnz %bpf, @bpublish_failed, @bsuccess\n@bpublish_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $g4_publish_error, l 32)\n\tret 73\n@bsuccess\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tret 0\n@other\n\t%a3 =w ceqw %argc, 3\n\tjnz %a3, @fargs, @hargc\n@hargc\n\t%a4 =w ceqw %argc, 4\n\tjnz %a4, @hargs, @usage\n@hargs\n\t%hfp =l add %argv, 8\n\t%hf =l loadl %hfp\n\t%hfc =w call $strcmp(l %hf, l $g4_source_arg)\n\t%valid_hf =w ceqw %hfc, 0\n\tjnz %valid_hf, @hidden, @usage\n@usage\n\tcall $write(w 2, l $g4_usage_error, l 103)\n\tret 64\n@hidden\n\t%hmp =l add %argv, 16\n\t%hmc =l loadl %hmp\n\t%hm =l call $g4_string_from_c(l %hmc)\n\t%hsp =l add %argv, 24\n\t%hsc =l loadl %hsp\n\t%hs =l call $g4_string_from_c(l %hsc)",
		)
		gate4_output_line(
			output,
			"\t%hst =l call $g4f" + gate4_integer_string(compiler_entry) +
			"(l %hs, l %hm, l 0)",
		)
		gate4_output_line(
			output,
			"\tret 0\n@fargs\n\t%fmp =l add %argv, 8\n\t%fmc =l loadl %fmp\n\t%cc =w call $strcmp(l %fmc, l $g4_check)\n\t%cm =w ceqw %cc, 0\n\t%ec =w call $strcmp(l %fmc, l $g4_emit)\n\t%em =w ceqw %ec, 0\n\t%valid_fm =w or %cm, %em\n\tjnz %valid_fm, @file, @usage\n@file\n\t%pp =l add %argv, 16\n\t%path =l loadl %pp\n\t%src =l call $g4_read_file(l %path)\n\t%rf =w ceql %src, 0\n\tjnz %rf, @read_error, @compile\n@read_error\n\tcall $write(w 2, l $g4_file_error, l 35)\n\t%pl =l call $strlen(l %path)\n\tcall $write(w 2, l %path, l %pl)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret 66\n@compile\n\t%fm =l call $g4_string_from_c(l %fmc)",
		)
		gate4_output_line(
			output,
			"\t%fpath =l call $g4_string_from_c(l %path)",
		)
		gate4_output_line(
			output,
			"\t%fst =l call $g4f" + gate4_integer_string(compiler_file_entry) +
			"(l %src, l %fpath, l %fm, l 1)",
		)
		gate4_output_line(output, "\t%failed =w cnel %fst, 0\n\tret %failed")
	else
		gate4_output_line(output, "export function w $main(w %argc, l %argv) {")
		gate4_output_line(output, "@start")
		main_index := gate4_find_function_in_module(state, state.entry_module[0], "main")
		gate4_output_line(output, "\tcall $g4f" + gate4_integer_string(main_index) + "()")
		gate4_output_line(output, "\tret 0")
	end
	gate4_output_line(output, "}")
	if compiler_entry >= 0
		gate4_emit_target_entry(output)
	end
	return
end

def gate4_emit_qbe(mut state: Gate4Compiler): Gate4Output
	mut output := gate4_output_new(state.token_count[0] * 24 + 4096)
	gate4_emit_static_strings(state, output)
	gate4_emit_runtime(output, gate4_compiler_entry_function(state) >= 0)
	mut inline_budget := [0]
	if state.function_count[0] <= 32
		inline_budget[0] = 64
	else
		if state.function_count[0] <= 96
			inline_budget[0] = 32
		end
	end
	mut function_index := 0
	while function_index < state.function_count[0]
		gate4_emit_function(state, function_index, output, inline_budget)
		function_index += 1
	end
	gate4_emit_entry(state, output)
	if gate4_output_starts_with(output, "\tcall $g4_array_push_d")
		gate4_emit_float_array_runtime(output)
	end
	return output
end

def gate4_eputs(_value: String)
	return
end

def gate4_print_diagnostic(state: Gate4Compiler, file_mode: Boolean)
	mut message := ""
	module_index := gate4_load_integer(state.diagnostic_modules, 0)
	if module_index > 0
		message += gate4_load_string(state.module_files, module_index) + ":"
	end
	message += gate4_load_string(state.diagnostic_codes, 0) + ":"
	message += gate4_integer_string(gate4_load_integer(state.diagnostic_lines, 0))
	message += ":"
	message += gate4_load_string(state.diagnostic_messages, 0)
	if file_mode
		gate4_eputs(message)
	else
		puts(message)
	end
	return
end

def gate4_compile_state(mut state: Gate4Compiler, mode: String, file_mode: Boolean): Integer
	if !gate4_has_diagnostic(state)
		gate4_resolve(state)
	end
	if !gate4_has_diagnostic(state)
		gate4_check(state)
	end
	if gate4_has_diagnostic(state)
		gate4_print_diagnostic(state, file_mode)
		return 1
	end
	if mode == "check"
		puts("ok")
		return 0
	end
	if mode == "emit-qbe"
		output := gate4_emit_qbe(state)
		if gate4_has_diagnostic(state)
			gate4_print_diagnostic(state, file_mode)
			return 1
		end
		mut index := 0
		while index < output.count[0]
			puts(gate4_load_string(output.lines, index))
			index += 1
		end
		return 0
	end
	message := "TRBN4006:1:unsupported compiler mode " + mode
	if file_mode
		gate4_eputs(message)
	else
		puts(message)
	end
	return 64
end

def gate4_project_set_error(
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		message: String,
		line: Integer,
	)
	if error[0] == ""
		error[0] = message
		error_line[0] = line
	end
	return
end

def gate4_project_advance(mut value: Array<Integer>, amount: Integer)
	value[0] = value[0] + amount
	return
end

def gate4_json_skip_ignored(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == " "
				gate4_project_advance(position, 1)
			else
				if character == "\t"
					gate4_project_advance(position, 1)
				else
					if character == "\r"
						gate4_project_advance(position, 1)
					else
						if character == "\n"
							gate4_project_advance(position, 1)
							gate4_project_advance(line, 1)
						else
							if character == "/"
								if position[0] + 1 < source.size()
									following := source[position[0] + 1]
									if following == "/"
										gate4_project_advance(position, 2)
										mut comment := true
										while comment
											if position[0] >= source.size()
												comment = false
											else
												if source[position[0]] == "\n"
													comment = false
												else
													gate4_project_advance(position, 1)
												end
											end
										end
									else
										if following == "*"
											start_line := line[0]
											gate4_project_advance(position, 2)
											mut comment := true
											mut closed := false
											while comment
												if position[0] >= source.size()
													comment = false
												else
													if source[position[0]] == "\n"
														gate4_project_advance(line, 1)
													end
													if source[position[0]] == "*"
														if position[0] + 1 < source.size()
															if source[position[0] + 1] == "/"
																gate4_project_advance(position, 2)
																closed = true
																comment = false
															end
														end
													end
													if comment
														gate4_project_advance(position, 1)
													end
												end
											end
											if !closed
												gate4_project_set_error(error, error_line, "unterminated JSONC block comment", start_line)
												scanning = false
											end
										else
											scanning = false
										end
									end
								else
									scanning = false
								end
							else
								scanning = false
							end
						end
					end
				end
			end
		end
	end
	return error[0] == ""
end

def gate4_json_hex_digit(character: String): Integer
	code := gate4_ascii_code(character)
	if code >= 48
		if code <= 57
			return code - 48
		end
	end
	if code >= 65
		if code <= 70
			return code - 55
		end
	end
	if code >= 97
		if code <= 102
			return code - 87
		end
	end
	return - 1
end

def gate4_json_ascii_character(code: Integer): String
	if code == 9
		return "\t"
	end
	if code == 10
		return "\n"
	end
	if code == 13
		return "\r"
	end
	if code < 32
		return ""
	end
	if code > 126
		return ""
	end
	alphabet := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
	return alphabet[code - 32]
end

def gate4_json_string(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if position[0] >= source.size()
		gate4_project_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	if source[position[0]] != "\""
		gate4_project_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	gate4_project_advance(position, 1)
	mut result := ""
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == "\""
				gate4_project_advance(position, 1)
				closed = true
				scanning = false
			else
				if character == "\n"
					gate4_project_set_error(error, error_line, "newline in JSON string", line[0])
					scanning = false
				else
					if character == "\\"
						gate4_project_advance(position, 1)
						if position[0] >= source.size()
							gate4_project_set_error(error, error_line, "unterminated JSON escape", line[0])
							scanning = false
						else
							escaped := source[position[0]]
							gate4_project_advance(position, 1)
							if escaped == "\""
								result += "\""
							else
								if escaped == "\\"
									result += "\\"
								else
									if escaped == "/"
										result += "/"
									else
										if escaped == "n"
											result += "\n"
										else
											if escaped == "r"
												result += "\r"
											else
												if escaped == "t"
													result += "\t"
												else
													if escaped == "u"
														mut code := 0
														mut digit_index := 0
														while digit_index < 4
															if position[0] >= source.size()
																gate4_project_set_error(error, error_line, "incomplete JSON Unicode escape", line[0])
																digit_index = 4
															else
																digit := gate4_json_hex_digit(source[position[0]])
																if digit < 0
																	gate4_project_set_error(error, error_line, "invalid JSON Unicode escape", line[0])
																	digit_index = 4
																else
																	code = code * 16 + digit
																	gate4_project_advance(position, 1)
																	digit_index += 1
																end
															end
														end
														if error[0] == ""
															decoded := gate4_json_ascii_character(code)
															if decoded == ""
																gate4_project_set_error(error, error_line, "non-ASCII JSON Unicode escape is not supported", line[0])
															else
																result += decoded
															end
														end
													else
														gate4_project_set_error(error, error_line, "unsupported JSON escape", line[0])
													end
												end
											end
										end
									end
								end
							end
							if error[0] != ""
								scanning = false
							end
						end
					else
						code := gate4_ascii_code(character)
						if code >= 0
							if code < 32
								gate4_project_set_error(error, error_line, "control character in JSON string", line[0])
								scanning = false
							end
						end
						if scanning
							result += character
							gate4_project_advance(position, 1)
						end
					end
				end
			end
		end
	end
	if !closed
		if error[0] == ""
			gate4_project_set_error(error, error_line, "unterminated JSON string", line[0])
		end
	end
	return result
end

def gate4_json_literal_at(source: String, position: Integer, literal: String): Boolean
	if position + literal.size() > source.size()
		return false
	end
	mut index := 0
	while index < literal.size()
		if source[position + index] != literal[index]
			return false
		end
		index += 1
	end
	return true
end

def gate4_json_boolean(
		source: String,
		mut position: Array<Integer>,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if gate4_json_literal_at(source, position[0], "true")
		gate4_project_advance(position, 4)
		return true
	end
	if gate4_json_literal_at(source, position[0], "false")
		gate4_project_advance(position, 5)
		return false
	end
	gate4_project_set_error(error, error_line, "expected JSON Boolean", line)
	return false
end

def gate4_string_array_contains(values: Array<String>, value: String): Boolean
	mut index := 0
	while index < values.size()
		if values[index] == value
			return true
		end
		index += 1
	end
	return false
end

def gate4_json_expect(
		source: String,
		mut position: Array<Integer>,
		expected: String,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if position[0] < source.size()
		if source[position[0]] == expected
			gate4_project_advance(position, 1)
			return true
		end
	end
	gate4_project_set_error(error, error_line, "expected JSON " + expected, line)
	return false
end

def gate4_parse_project_go_config(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Gate4ProjectGoConfig
	mut module_name := ""
	mut version := "1.27"
	mut root_package := "main"
	gate4_json_expect(source, position, "{", line[0], error, error_line)
	gate4_json_skip_ignored(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut finished := false
	while !finished
		if error[0] != ""
			finished = true
		else
			if position[0] < source.size()
				if source[position[0]] == "}"
					gate4_project_advance(position, 1)
					finished = true
				else
					key_line := line[0]
					key := gate4_json_string(source, position, line, error, error_line)
					if gate4_string_array_contains(seen, key)
						gate4_project_set_error(error, error_line, "duplicate go configuration field " + key, key_line)
					else
						seen.push(key)
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					gate4_json_expect(source, position, ":", line[0], error, error_line)
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if key == "module"
							module_name = gate4_json_string(source, position, line, error, error_line)
						else
							if key == "version"
								version = gate4_json_string(source, position, line, error, error_line)
							else
								if key == "rootPackage"
									root_package = gate4_json_string(source, position, line, error, error_line)
								else
									gate4_project_set_error(error, error_line, "unsupported go configuration field " + key, key_line)
								end
							end
						end
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if position[0] < source.size()
							if source[position[0]] == ","
								gate4_project_advance(position, 1)
								gate4_json_skip_ignored(source, position, line, error, error_line)
								if position[0] < source.size()
									if source[position[0]] == "}"
										gate4_project_set_error(error, error_line, "trailing comma in go configuration", line[0])
									end
								end
							else
								if source[position[0]] != "}"
									gate4_project_set_error(error, error_line, "expected JSON , or }", line[0])
								end
							end
						else
							gate4_project_set_error(error, error_line, "unterminated go configuration", line[0])
						end
					end
				end
			else
				gate4_project_set_error(error, error_line, "unterminated go configuration", line[0])
			end
		end
	end
	if version == ""
		version = "1.27"
	end
	if root_package == ""
		root_package = "main"
	end
	return Gate4ProjectGoConfig.new(module_name: module_name, version: version, root_package: root_package)
end

def gate4_project_blank(value: String): Boolean
	mut index := 0
	while index < value.size()
		character := value[index]
		mut whitespace := character == " "
		if character == "\t"
			whitespace = true
		end
		if character == "\r"
			whitespace = true
		end
		if character == "\n"
			whitespace = true
		end
		if !whitespace
			return false
		end
		index += 1
	end
	return true
end

def gate4_project_clean_relative(
		value: String,
		field: String,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if value.size() > 0
		if value[0] == "/"
			gate4_project_set_error(error, error_line, field + " must be relative to the project root", 1)
			return ""
		end
	end
	mut segments: Array<String> := []
	mut segment_count := 0
	mut segment := ""
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "/"
				boundary = true
			end
		end
		if boundary
			if segment == ".."
				if segment_count == 0
					gate4_project_set_error(error, error_line, field + " cannot escape the project root", 1)
				else
					segment_count -= 1
				end
			else
				if segment != ""
					if segment != "."
						if segment_count < segments.size()
							segments[segment_count] = segment
						else
							segments.push(segment)
						end
						segment_count += 1
					end
				end
			end
			segment = ""
		else
			segment += value[index]
		end
		index += 1
	end
	mut result := ""
	index = 0
	while index < segment_count
		if result != ""
			result += "/"
		end
		result += segments[index]
		index += 1
	end
	if result == ""
		return "."
	end
	return result
end

def gate4_project_go_version_supported(value: String): Boolean
	mut components: Array<Integer> := []
	mut current := 0
	mut digits := 0
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "."
				boundary = true
			end
		end
		if boundary
			if digits == 0
				return false
			end
			components.push(current)
			current = 0
			digits = 0
		else
			code := gate4_ascii_code(value[index])
			if code < 48
				return false
			end
			if code > 57
				return false
			end
			digit := code - 48
			if current > 900719925474099
				return false
			end
			if current == 900719925474099
				if digit > 1
					return false
				end
			end
			current = current * 10 + digit
			digits += 1
		end
		index += 1
	end
	if components.size() < 2
		return false
	end
	if components.size() > 3
		return false
	end
	if components[0] > 1
		return true
	end
	if components[0] < 1
		return false
	end
	return components[1] >= 27
end

def gate4_project_config_error(
		name: String,
		version: String,
		mode: String,
		source_dir: String,
		out_dir: String,
		copy_files: Boolean,
		package_management: String,
		go_config: Gate4ProjectGoConfig,
		error: String,
		error_line: Integer,
	): Gate4ProjectConfig
	return Gate4ProjectConfig.new(
		name: name,
		version: version,
		mode: mode,
		source_dir: source_dir,
		out_dir: out_dir,
		copy_files: copy_files,
		package_management: package_management,
		go_config: go_config,
		error: error,
		error_line: error_line,
	)
end

def gate4_parse_project_config(source: String): Gate4ProjectConfig
	mut position := [0]
	mut line := [1]
	mut error := [""]
	mut error_line := [1]
	mut name := ""
	mut version := "0.1.0"
	mut mode := ""
	mut source_dir := "."
	mut out_dir := "build"
	mut copy_files := true
	mut package_management := "managed"
	mut go_config := Gate4ProjectGoConfig.new(module_name: "", version: "1.27", root_package: "main")
	gate4_json_skip_ignored(source, position, line, error, error_line)
	gate4_json_expect(source, position, "{", line[0], error, error_line)
	gate4_json_skip_ignored(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut finished := false
	while !finished
		if error[0] != ""
			finished = true
		else
			if position[0] < source.size()
				if source[position[0]] == "}"
					gate4_project_advance(position, 1)
					finished = true
				else
					key_line := line[0]
					key := gate4_json_string(source, position, line, error, error_line)
					if gate4_string_array_contains(seen, key)
						gate4_project_set_error(error, error_line, "duplicate project configuration field " + key, key_line)
					else
						seen.push(key)
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					gate4_json_expect(source, position, ":", line[0], error, error_line)
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if key == "$schema"
							gate4_json_string(source, position, line, error, error_line)
						else
							if key == "name"
								name = gate4_json_string(source, position, line, error, error_line)
							else
								if key == "version"
									version = gate4_json_string(source, position, line, error, error_line)
								else
									if key == "mode"
										mode = gate4_json_string(source, position, line, error, error_line)
									else
										if key == "sourceDir"
											source_dir = gate4_json_string(source, position, line, error, error_line)
										else
											if key == "outDir"
												out_dir = gate4_json_string(source, position, line, error, error_line)
											else
												if key == "copyFiles"
													copy_files = gate4_json_boolean(source, position, line[0], error, error_line)
												else
													if key == "packageManagement"
														package_management = gate4_json_string(source, position, line, error, error_line)
													else
														if key == "go"
															go_config = gate4_parse_project_go_config(source, position, line, error, error_line)
														else
															gate4_project_set_error(error, error_line, "unsupported project configuration field " + key, key_line)
														end
													end
												end
											end
										end
									end
								end
							end
						end
					end
					gate4_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if position[0] < source.size()
							if source[position[0]] == ","
								gate4_project_advance(position, 1)
								gate4_json_skip_ignored(source, position, line, error, error_line)
								if position[0] < source.size()
									if source[position[0]] == "}"
										gate4_project_set_error(error, error_line, "trailing comma in project configuration", line[0])
									end
								end
							else
								if source[position[0]] != "}"
									gate4_project_set_error(error, error_line, "expected JSON , or }", line[0])
								end
							end
						else
							gate4_project_set_error(error, error_line, "unterminated project configuration", line[0])
						end
					end
				end
			else
				gate4_project_set_error(error, error_line, "unterminated project configuration", line[0])
			end
		end
	end
	gate4_json_skip_ignored(source, position, line, error, error_line)
	if error[0] == ""
		if position[0] != source.size()
			gate4_project_set_error(error, error_line, "unexpected data after project configuration", line[0])
		end
	end
	if error[0] == ""
		if gate4_project_blank(name)
			gate4_project_set_error(error, error_line, "name is required", 1)
		end
	end
	if error[0] == ""
		if mode != "go"
			gate4_project_set_error(error, error_line, "mode must be go for configured Native builds", 1)
		end
	end
	if source_dir == ""
		source_dir = "."
	end
	if out_dir == ""
		out_dir = "build"
	end
	if package_management == ""
		package_management = "managed"
	end
	if error[0] == ""
		source_dir = gate4_project_clean_relative(source_dir, "sourceDir", error, error_line)
	end
	if error[0] == ""
		out_dir = gate4_project_clean_relative(out_dir, "outDir", error, error_line)
	end
	if error[0] == ""
		mut package_mode_supported := package_management == "managed"
		if package_management == "external"
			package_mode_supported = true
		end
		if !package_mode_supported
			gate4_project_set_error(error, error_line, "packageManagement must be managed or external", 1)
		end
	end
	if error[0] == ""
		if gate4_project_blank(go_config.module_name)
			gate4_project_set_error(error, error_line, "go.module is required for mode go", 1)
		end
	end
	if error[0] == ""
		if !gate4_project_go_version_supported(go_config.version)
			gate4_project_set_error(error, error_line, "go.version must be 1.27 or later", 1)
		end
	end
	return gate4_project_config_error(
		name,
		version,
		mode,
		source_dir,
		out_dir,
		copy_files,
		package_management,
		go_config,
		error[0],
		error_line[0],
	)
end

def compiler_main(source: String, mode: String, file_mode: Boolean): Integer
	mut state := gate4_compiler_new(source.size() + 1)
	gate4_lex(state, source)
	if !gate4_has_diagnostic(state)
		gate4_parse(state)
	end
	return gate4_compile_state(state, mode, file_mode)
end

def compiler_file_main(source: String, path: String, mode: String, file_mode: Boolean): Integer
	mut state := gate4_compiler_new(1)
	if gate4_path_basename(path) == "trbconfig.jsonc"
		state = gate4_load_configured_project(source, path)
	else
		state = gate4_load_file_root(source, path)
	end
	return gate4_compile_state(state, mode, file_mode)
end

def gate4_has_diagnostic(state: Gate4Compiler): Boolean
	return state.diagnostic_count[0] > 0
end

def gate4_diagnostic(mut state: Gate4Compiler, code: String, line: Integer, message: String)
	if state.diagnostic_count[0] == 0
		gate4_store_string(state.diagnostic_codes, 0, code)
		gate4_store_integer(state.diagnostic_lines, 0, line)
		gate4_store_string(state.diagnostic_messages, 0, message)
		gate4_store_integer(state.diagnostic_modules, 0, state.active_module[0])
		state.diagnostic_count[0] = 1
	end
	return
end

def gate4_character_in(character: String, characters: String): Boolean
	mut index := 0
	while index < characters.size()
		if characters[index] == character
			return true
		end
		index += 1
	end
	return false
end

def gate4_identifier_start(character: String): Boolean
	return gate4_character_in(character, "fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_")
end

def gate4_identifier_continue(character: String): Boolean
	return gate4_character_in(character, "0123456789fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_")
end

def gate4_digit(character: String): Boolean
	return gate4_character_in(character, "0123456789")
end

def gate4_number_character(character: String): Boolean
	if gate4_digit(character)
		return true
	end
	return character == "_"
end

def gate4_push_token(mut state: Gate4Compiler, kind: Integer, text: String, line: Integer)
	index := state.token_count[0]
	gate4_store_integer(state.token_kinds, index, kind)
	gate4_store_string(state.token_texts, index, text)
	gate4_store_integer(state.token_lines, index, line)
	gate4_store_integer(state.token_modules, index, state.active_module[0])
	state.token_count[0] = index + 1
	return
end

def gate4_scan_identifier(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	mut text := ""
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if gate4_identifier_continue(source[position[0]])
				text += source[position[0]]
				gate4_project_advance(position, 1)
			else
				scanning = false
			end
		end
	end
	gate4_push_token(state, 1, text, line)
	return
end

def gate4_scan_number(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	mut text := ""
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if gate4_number_character(source[position[0]])
				text += source[position[0]]
				gate4_project_advance(position, 1)
			else
				scanning = false
			end
		end
	end
	if position[0] + 1 < source.size()
		if source[position[0]] == "."
			if gate4_digit(source[position[0] + 1])
				text += "."
				gate4_project_advance(position, 1)
				scanning = true
				while scanning
					if position[0] >= source.size()
						scanning = false
					else
						if gate4_number_character(source[position[0]])
							text += source[position[0]]
							gate4_project_advance(position, 1)
						else
							scanning = false
						end
					end
				end
			end
		end
	end
	gate4_push_token(state, 2, text, line)
	return
end

def gate4_decode_escape(mut state: Gate4Compiler, escaped: String, line: Integer): String
	mut value := ""
	if escaped == "n"
		value = "\n"
	else
		if escaped == "t"
			value = "\t"
		else
			if escaped == "r"
				value = "\r"
			else
				if escaped == "\""
					value = "\""
				else
					if escaped == "\\"
						value = "\\"
					else
						gate4_diagnostic(state, "TRBN4001", line, "unsupported String escape")
					end
				end
			end
		end
	end
	return value
end

def gate4_scan_string(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	gate4_project_advance(position, 1)
	mut text := ""
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			current := source[position[0]]
			if current == "\""
				closed = true
				scanning = false
				gate4_project_advance(position, 1)
			else
				if current == "\n"
					gate4_diagnostic(state, "TRBN4001", line, "unterminated String literal")
					scanning = false
				else
					if current == "\\"
						gate4_project_advance(position, 1)
						if position[0] >= source.size()
							gate4_diagnostic(state, "TRBN4001", line, "unterminated String escape")
							scanning = false
						else
							text += gate4_decode_escape(state, source[position[0]], line)
							gate4_project_advance(position, 1)
						end
					else
						text += current
						gate4_project_advance(position, 1)
					end
				end
			end
		end
	end
	if closed
		gate4_push_token(state, 3, text, line)
	else
		if !gate4_has_diagnostic(state)
			gate4_diagnostic(state, "TRBN4001", line, "unterminated String literal")
		end
	end
	return
end

def gate4_two_character_symbol(pair: String): Boolean
	mut supported := false
	if pair == ":="
		supported = true
	end
	if pair == "=="
		supported = true
	end
	if pair == "!="
		supported = true
	end
	if pair == "<="
		supported = true
	end
	if pair == ">="
		supported = true
	end
	if pair == "+="
		supported = true
	end
	if pair == "-="
		supported = true
	end
	if pair == "*="
		supported = true
	end
	if pair == "/="
		supported = true
	end
	if pair == "->"
		supported = true
	end
	return supported
end

def gate4_scan_symbol(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	character := source[position[0]]
	mut symbol := character
	if position[0] + 1 < source.size()
		pair := character + source[position[0] + 1]
		if gate4_two_character_symbol(pair)
			symbol = pair
			gate4_project_advance(position, 1)
		end
	end
	if gate4_character_in(character, "()[]{}:,.+-*/%<>=!")
		gate4_push_token(state, 5, symbol, line)
	else
		gate4_diagnostic(state, "TRBN4001", line, "unsupported source character " + character)
	end
	gate4_project_advance(position, 1)
	return
end

def gate4_skip_comment(source: String, mut position: Array<Integer>)
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if source[position[0]] == "\n"
				scanning = false
			else
				gate4_project_advance(position, 1)
			end
		end
	end
	return
end

def gate4_lex_source(mut state: Gate4Compiler, source: String, terminal_kind: Integer): Boolean
	mut position := [0]
	mut line := 1
	mut character := ""
	while position[0] < source.size()
		character = source[position[0]]
		if character == " "
			gate4_project_advance(position, 1)
		else
			if character == "\t"
				gate4_project_advance(position, 1)
			else
				if character == "\r"
					gate4_project_advance(position, 1)
				else
					if character == "\n"
						gate4_push_token(state, 4, "\n", line)
						line += 1
						gate4_project_advance(position, 1)
					else
						if character == "#"
							gate4_skip_comment(source, position)
						else
							if gate4_identifier_start(character)
								gate4_scan_identifier(state, source, position, line)
							else
								if gate4_digit(character)
									gate4_scan_number(state, source, position, line)
								else
									if character == "\""
										gate4_scan_string(state, source, position, line)
									else
										gate4_scan_symbol(state, source, position, line)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	gate4_push_token(state, terminal_kind, "", line)
	return !gate4_has_diagnostic(state)
end

def gate4_lex_module(mut state: Gate4Compiler, source: String, module_index: Integer): Boolean
	state.active_module[0] = module_index
	return gate4_lex_source(state, source, 6)
end

def gate4_lex(mut state: Gate4Compiler, source: String): Boolean
	if state.module_count[0] == 0
		gate4_add_module(state, "entry", "")
	end
	state.entry_module[0] = 0
	state.active_module[0] = 0
	return gate4_lex_source(state, source, 0)
end

def gate4_token_is(state: Gate4Compiler, index: Integer, text: String): Boolean
	if gate4_load_integer(state.token_kinds, index) == 1
		return gate4_load_string(state.token_texts, index) == text
	end
	if gate4_load_integer(state.token_kinds, index) == 5
		return gate4_load_string(state.token_texts, index) == text
	end
	return false
end

def gate4_advance(mut position: Array<Integer>)
	gate4_project_advance(position, 1)
	return
end

def gate4_skip_newlines(state: Gate4Compiler, mut position: Array<Integer>)
	while gate4_load_integer(state.token_kinds, position[0]) == 4
		gate4_advance(position)
	end
	return
end

def gate4_expect(mut state: Gate4Compiler, mut position: Array<Integer>, text: String): Boolean
	if gate4_token_is(state, position[0], text)
		gate4_advance(position)
		return true
	end
	gate4_diagnostic(
		state,
		"TRBN4002",
		gate4_load_integer(state.token_lines, position[0]),
		"expected " + text + ", found " + gate4_load_string(state.token_texts, position[0]),
	)
	return false
end

def gate4_expect_identifier(mut state: Gate4Compiler, mut position: Array<Integer>): String
	if gate4_load_integer(state.token_kinds, position[0]) == 1
		value := gate4_load_string(state.token_texts, position[0])
		gate4_advance(position)
		return value
	end
	gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected an identifier")
	return ""
end

def gate4_parse_type(mut state: Gate4Compiler, mut position: Array<Integer>): String
	name := gate4_expect_identifier(state, position)
	if gate4_has_diagnostic(state)
		return ""
	end
	if gate4_token_is(state, position[0], "<")
		gate4_advance(position)
		argument := gate4_parse_type(state, position)
		if !gate4_expect(state, position, ">")
			return ""
		end
		return name + "<" + argument + ">"
	end
	return name
end

def gate4_binary_precedence(operator: String): Integer
	mut precedence := 0
	if operator == "=="
		precedence = 1
	end
	if operator == "!="
		precedence = 1
	end
	if operator == "<"
		precedence = 1
	end
	if operator == "<="
		precedence = 1
	end
	if operator == ">"
		precedence = 1
	end
	if operator == ">="
		precedence = 1
	end
	if operator == "+"
		precedence = 2
	end
	if operator == "-"
		precedence = 2
	end
	if operator == "*"
		precedence = 3
	end
	if operator == "/"
		precedence = 3
	end
	if operator == "%"
		precedence = 3
	end
	return precedence
end

def gate4_parse_arguments_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	gate4_skip_newlines(state, position)
	if gate4_token_is(state, position[0], ")")
		gate4_advance(position)
		return true
	end
	mut finished := false
	while !finished
		gate4_skip_newlines(state, position)
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			if gate4_load_integer(state.token_kinds, position[0]) == 1
				if gate4_token_is(state, position[0] + 1, ":")
					gate4_advance(position)
					gate4_advance(position)
				end
			end
			if !gate4_parse_expression_syntax(state, position, 1)
				return false
			end
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_skip_newlines(state, position)
	return gate4_expect(state, position, ")")
end

def gate4_parse_primary_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	kind := gate4_load_integer(state.token_kinds, position[0])
	if kind == 1
		gate4_advance(position)
	else
		if kind == 2
			gate4_advance(position)
		else
			if kind == 3
				gate4_advance(position)
			else
				if gate4_token_is(state, position[0], "(")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
					if !gate4_parse_expression_syntax(state, position, 1)
						return false
					end
					if !gate4_expect(state, position, ")")
						return false
					end
				else
					if gate4_token_is(state, position[0], "[")
						gate4_advance(position)
						gate4_skip_newlines(state, position)
						if !gate4_token_is(state, position[0], "]")
							mut finished := false
							while !finished
								if gate4_token_is(state, position[0], "]")
									finished = true
								else
									if !gate4_parse_expression_syntax(state, position, 1)
										return false
									end
									if gate4_token_is(state, position[0], ",")
										gate4_advance(position)
										gate4_skip_newlines(state, position)
									else
										finished = true
									end
								end
							end
						end
						gate4_skip_newlines(state, position)
						if !gate4_expect(state, position, "]")
							return false
						end
					else
						if gate4_token_is(state, position[0], "!")
							gate4_advance(position)
							return gate4_parse_primary_syntax(state, position)
						end
						if gate4_token_is(state, position[0], "-")
							gate4_advance(position)
							return gate4_parse_primary_syntax(state, position)
						end
						if gate4_token_is(state, position[0], "+")
							gate4_advance(position)
							return gate4_parse_primary_syntax(state, position)
						end
						gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected an expression")
						return false
					end
				end
			end
		end
	end
	mut postfix := true
	while postfix
		if gate4_token_is(state, position[0], "(")
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			if !gate4_parse_arguments_syntax(state, position)
				return false
			end
		else
			if gate4_token_is(state, position[0], ".")
				gate4_advance(position)
				gate4_expect_identifier(state, position)
				if gate4_has_diagnostic(state)
					return false
				end
				if gate4_token_is(state, position[0], "(")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
					if !gate4_parse_arguments_syntax(state, position)
						return false
					end
				end
			else
				if gate4_token_is(state, position[0], "[")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
					if !gate4_parse_expression_syntax(state, position, 1)
						return false
					end
					if !gate4_expect(state, position, "]")
						return false
					end
				else
					postfix = false
				end
			end
		end
	end
	return true
end

def gate4_parse_expression_syntax(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		minimum_precedence: Integer,
	): Boolean
	if !gate4_parse_primary_syntax(state, position)
		return false
	end
	mut scanning := true
	while scanning
		precedence := gate4_binary_precedence(gate4_load_string(state.token_texts, position[0]))
		if precedence < minimum_precedence
			scanning = false
		else
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			if !gate4_parse_expression_syntax(state, position, precedence + 1)
				return false
			end
		end
	end
	return true
end

def gate4_finish_statement(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	if gate4_load_integer(state.token_kinds, position[0]) == 4
		gate4_skip_newlines(state, position)
		return true
	end
	if gate4_terminal_token(state, position[0])
		return true
	end
	gate4_diagnostic(
		state,
		"TRBN4002",
		gate4_load_integer(state.token_lines, position[0]),
		"unexpected token " + gate4_load_string(state.token_texts, position[0]) + " after statement",
	)
	return false
end

def gate4_parse_declaration_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	if gate4_token_is(state, position[0], "mut")
		gate4_advance(position)
	end
	gate4_expect_identifier(state, position)
	if gate4_has_diagnostic(state)
		return false
	end
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		gate4_parse_type(state, position)
	end
	if !gate4_expect(state, position, ":=")
		return false
	end
	if !gate4_parse_expression_syntax(state, position, 1)
		return false
	end
	return gate4_finish_statement(state, position)
end

def gate4_parse_simple_statement_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	if !gate4_parse_expression_syntax(state, position, 1)
		return false
	end
	operator := gate4_load_string(state.token_texts, position[0])
	if operator == "="
		gate4_advance(position)
		if !gate4_parse_expression_syntax(state, position, 1)
			return false
		end
	else
		if gate4_assignment_operator(operator)
			gate4_advance(position)
			if !gate4_parse_expression_syntax(state, position, 1)
				return false
			end
		end
	end
	return gate4_finish_statement(state, position)
end

def gate4_assignment_operator(operator: String): Boolean
	mut supported := false
	if operator == "+="
		supported = true
	end
	if operator == "-="
		supported = true
	end
	if operator == "*="
		supported = true
	end
	if operator == "/="
		supported = true
	end
	return supported
end

def gate4_parse_block_syntax(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	gate4_skip_newlines(state, position)
	mut complete := false
	while !complete
		if gate4_terminal_token(state, position[0])
			gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected end")
			complete = true
		else
			if gate4_token_is(state, position[0], "end")
				complete = true
			else
				if gate4_token_is(state, position[0], "else")
					complete = true
				else
					if gate4_token_is(state, position[0], "if")
						gate4_advance(position)
						if gate4_parse_expression_syntax(state, position, 1)
							if gate4_finish_statement(state, position)
								gate4_parse_block_syntax(state, position)
								if gate4_token_is(state, position[0], "else")
									gate4_advance(position)
									gate4_finish_statement(state, position)
									gate4_parse_block_syntax(state, position)
								end
								if gate4_expect(state, position, "end")
									gate4_finish_statement(state, position)
								end
							end
						end
					else
						if gate4_token_is(state, position[0], "while")
							gate4_advance(position)
							if gate4_parse_expression_syntax(state, position, 1)
								if gate4_finish_statement(state, position)
									gate4_parse_block_syntax(state, position)
									if gate4_expect(state, position, "end")
										gate4_finish_statement(state, position)
									end
								end
							end
						else
							if gate4_token_is(state, position[0], "return")
								gate4_advance(position)
								if gate4_load_integer(state.token_kinds, position[0]) != 4
									if !gate4_terminal_token(state, position[0])
										gate4_parse_expression_syntax(state, position, 1)
									end
								end
								gate4_finish_statement(state, position)
							else
								mut declaration := false
								if gate4_token_is(state, position[0], "mut")
									declaration = true
								else
									if gate4_load_integer(state.token_kinds, position[0]) == 1
										if gate4_token_is(state, position[0] + 1, ":=")
											declaration = true
										else
											if gate4_token_is(state, position[0] + 1, ":")
												declaration = true
											end
										end
									end
								end
								if declaration
									gate4_parse_declaration_syntax(state, position)
								else
									gate4_parse_simple_statement_syntax(state, position)
								end
							end
						end
					end
				end
			end
		end
		if gate4_has_diagnostic(state)
			complete = true
		end
	end
	return !gate4_has_diagnostic(state)
end

def gate4_parse_record(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	name := gate4_expect_identifier(state, position)
	if !gate4_finish_statement(state, position)
		return false
	end
	record_index := state.record_count[0]
	gate4_store_string(state.record_names, record_index, name)
	gate4_store_integer(state.record_modules, record_index, state.active_module[0])
	gate4_store_integer(state.record_field_starts, record_index, state.field_count[0])
	gate4_store_integer(state.record_lines, record_index, line)
	mut count := 0
	while !gate4_token_is(state, position[0], "end")
		if gate4_terminal_token(state, position[0])
			gate4_diagnostic(state, "TRBN4002", gate4_load_integer(state.token_lines, position[0]), "expected end for record " + name)
			return false
		end
		field_line := gate4_load_integer(state.token_lines, position[0])
		field_name := gate4_expect_identifier(state, position)
		if !gate4_expect(state, position, ":")
			return false
		end
		field_type := gate4_parse_type(state, position)
		if !gate4_finish_statement(state, position)
			return false
		end
		field_index := state.field_count[0]
		gate4_store_string(state.field_names, field_index, field_name)
		gate4_store_string(state.field_types, field_index, field_type)
		gate4_store_integer(state.field_lines, field_index, field_line)
		state.field_count[0] = field_index + 1
		count += 1
	end
	gate4_advance(position)
	gate4_store_integer(state.record_field_counts, record_index, count)
	state.record_count[0] = record_index + 1
	return gate4_finish_statement(state, position)
end

def gate4_parse_function(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	name := gate4_expect_identifier(state, position)
	if !gate4_expect(state, position, "(")
		return false
	end
	gate4_skip_newlines(state, position)
	parameter_start := state.parameter_count[0]
	mut parameter_count := 0
	if !gate4_token_is(state, position[0], ")")
		mut finished := false
		while !finished
			gate4_skip_newlines(state, position)
			if gate4_token_is(state, position[0], ")")
				finished = true
			else
				mut mutable := 0
				if gate4_token_is(state, position[0], "mut")
					mutable = 1
					gate4_advance(position)
				end
				parameter_line := gate4_load_integer(state.token_lines, position[0])
				parameter_name := gate4_expect_identifier(state, position)
				if !gate4_expect(state, position, ":")
					return false
				end
				parameter_type := gate4_parse_type(state, position)
				parameter_index := state.parameter_count[0]
				gate4_store_string(state.parameter_names, parameter_index, parameter_name)
				gate4_store_string(state.parameter_types, parameter_index, parameter_type)
				gate4_store_integer(state.parameter_mutable, parameter_index, mutable)
				gate4_store_integer(state.parameter_lines, parameter_index, parameter_line)
				state.parameter_count[0] = parameter_index + 1
				parameter_count += 1
				if gate4_token_is(state, position[0], ",")
					gate4_advance(position)
					gate4_skip_newlines(state, position)
				else
					finished = true
				end
			end
		end
	end
	gate4_skip_newlines(state, position)
	if !gate4_expect(state, position, ")")
		return false
	end
	mut result_type := "Void"
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		result_type = gate4_parse_type(state, position)
	end
	if !gate4_finish_statement(state, position)
		return false
	end
	body_start := position[0]
	if !gate4_parse_block_syntax(state, position)
		return false
	end
	body_end := position[0]
	if !gate4_expect(state, position, "end")
		return false
	end
	if !gate4_finish_statement(state, position)
		return false
	end
	function_index := state.function_count[0]
	gate4_store_string(state.function_names, function_index, name)
	gate4_store_integer(state.function_modules, function_index, state.active_module[0])
	gate4_store_integer(state.function_parameter_starts, function_index, parameter_start)
	gate4_store_integer(state.function_parameter_counts, function_index, parameter_count)
	gate4_store_string(state.function_result_types, function_index, result_type)
	gate4_store_integer(state.function_body_starts, function_index, body_start)
	gate4_store_integer(state.function_body_ends, function_index, body_end)
	gate4_store_integer(state.function_lines, function_index, line)
	state.function_count[0] = function_index + 1
	return true
end

def gate4_parse_import(mut state: Gate4Compiler, mut position: Array<Integer>): Boolean
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	if !gate4_token_is(state, position[0], "{")
		gate4_diagnostic(state, "TRBN4002", line, "only named project imports are supported")
		return false
	end
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	import_start := state.import_count[0]
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], "}")
			finished = true
		else
			symbol_line := gate4_load_integer(state.token_lines, position[0])
			symbol := gate4_expect_identifier(state, position)
			if gate4_has_diagnostic(state)
				return false
			end
			import_index := state.import_count[0]
			gate4_store_integer(state.import_modules, import_index, state.active_module[0])
			gate4_store_string(state.import_paths, import_index, "")
			gate4_store_string(state.import_symbols, import_index, symbol)
			gate4_store_integer(state.import_lines, import_index, symbol_line)
			gate4_store_integer(state.import_targets, import_index, - 1)
			gate4_store_integer(state.import_used, import_index, 0)
			state.import_count[0] = import_index + 1
			gate4_skip_newlines(state, position)
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	if state.import_count[0] == import_start
		gate4_diagnostic(state, "TRBN4002", line, "named import must contain at least one symbol")
		return false
	end
	if !gate4_expect(state, position, "}")
		return false
	end
	gate4_skip_newlines(state, position)
	if !gate4_expect(state, position, "from")
		return false
	end
	mut path := ""
	while gate4_load_integer(state.token_kinds, position[0]) != 4
		if gate4_terminal_token(state, position[0])
			if path == ""
				gate4_diagnostic(state, "TRBN4002", line, "import path is required")
				return false
			end
			mut terminal_index := import_start
			while terminal_index < state.import_count[0]
				gate4_store_string(state.import_paths, terminal_index, path)
				terminal_index += 1
			end
			return true
		end
		path += gate4_load_string(state.token_texts, position[0])
		gate4_advance(position)
	end
	if path == ""
		gate4_diagnostic(state, "TRBN4002", line, "import path is required")
		return false
	end
	mut import_index := import_start
	while import_index < state.import_count[0]
		gate4_store_string(state.import_paths, import_index, path)
		import_index += 1
	end
	return gate4_finish_statement(state, position)
end

def gate4_parse_module(mut state: Gate4Compiler, start: Integer, module_index: Integer): Boolean
	state.active_module[0] = module_index
	import_start := state.import_count[0]
	gate4_store_integer(state.module_import_starts, module_index, import_start)
	gate4_store_integer(state.module_import_counts, module_index, 0)
	mut position := [start]
	gate4_skip_newlines(state, position)
	while !gate4_terminal_token(state, position[0])
		if gate4_token_is(state, position[0], "import")
			gate4_parse_import(state, position)
		else
			if gate4_token_is(state, position[0], "record")
				gate4_parse_record(state, position)
			else
				if gate4_token_is(state, position[0], "def")
					gate4_parse_function(state, position)
				else
					gate4_diagnostic(
						state,
						"TRBN4002",
						gate4_load_integer(state.token_lines, position[0]),
						"unsupported top-level declaration " + gate4_load_string(state.token_texts, position[0]),
					)
				end
			end
		end
		if gate4_has_diagnostic(state)
			return false
		end
		gate4_store_integer(
			state.module_import_counts,
			module_index,
			state.import_count[0] - import_start,
		)
		gate4_skip_newlines(state, position)
	end
	gate4_store_integer(
		state.module_import_counts,
		module_index,
		state.import_count[0] - import_start,
	)
	return true
end

def gate4_parse(mut state: Gate4Compiler): Boolean
	return gate4_parse_module(state, 0, state.entry_module[0])
end

def gate4_import_path_value(raw: String): String
	mut path := gate4_string_without_suffix(raw, ".trb")
	if path == ""
		return ""
	end
	if path[0] == "/"
		return ""
	end
	mut simple := true
	mut simple_index := 0
	while simple_index < path.size()
		character := path[simple_index]
		if character == ":"
			simple = false
		end
		if character == "/"
			simple = false
		end
		if character == "."
			simple = false
		end
		simple_index += 1
	end
	if simple
		return path
	end
	mut segments: Array<String> := []
	mut segment := ""
	mut index := 0
	while index <= path.size()
		mut character := "/"
		if index < path.size()
			character = path[index]
		end
		if character == ":"
			return ""
		end
		if character == "/"
			if segment == ".."
				return ""
			end
			if segment != ""
				if segment != "."
					segments.push(segment)
				end
			end
			segment = ""
		else
			segment += character
		end
		index += 1
	end
	if segments.size() == 0
		return ""
	end
	mut normalized := ""
	index = 0
	while index < segments.size()
		if normalized != ""
			normalized += "/"
		end
		normalized += segments[index]
		index += 1
	end
	return normalized
end

def gate4_normalize_import_path(mut state: Gate4Compiler, raw: String, line: Integer): String
	normalized := gate4_import_path_value(raw)
	if normalized == ""
		gate4_diagnostic(state, "TRBN4003", line, "invalid project import path " + raw)
	end
	return normalized
end

def gate4_project_capacity(): Integer
	return 4194304
end

def gate4_project_error_state(path: String, line: Integer, message: String): Gate4Compiler
	mut state := gate4_compiler_new(1024)
	module_index := gate4_add_module(state, "trbconfig", path)
	state.entry_module[0] = module_index
	state.active_module[0] = module_index
	gate4_diagnostic(state, "TRBN4010", line, message)
	return state
end

def gate4_project_join(root: String, relative: String): String
	if relative == "."
		return root
	end
	return gate4_path_join(root, relative)
end

def gate4_project_module_name(
		mut state: Gate4Compiler,
		source_root: String,
		path: String,
	): String
	mut prefix := source_root
	if prefix != "/"
		prefix += "/"
	end
	if !gate4_string_starts_with(path, prefix)
		gate4_diagnostic(state, "TRBN4010", 1, "project source is outside configured sourceDir")
		return ""
	end
	if !gate4_string_ends_with(path, ".trb")
		gate4_diagnostic(state, "TRBN4010", 1, "project source does not end in .trb")
		return ""
	end
	mut name := ""
	mut index := prefix.size()
	finish := path.size() - 4
	while index < finish
		name += path[index]
		index += 1
	end
	if name == ""
		gate4_diagnostic(state, "TRBN4010", 1, "project source has an empty module name")
	end
	return name
end

def gate4_string_starts_at(value: String, start: Integer, prefix: String): Boolean
	mut index := 0
	while index < prefix.size()
		if value[start + index] != prefix[index]
			return false
		end
		index += 1
	end
	return true
end

def gate4_project_source_declares_main(source: String): Boolean
	mut index := 0
	while index + 9 <= source.size()
		if gate4_string_starts_at(source, index, "def main(")
			if index == 0
				return true
			end
			if source[index - 1] == "\n"
				return true
			end
		end
		index += 1
	end
	return false
end

def gate4_project_append_imports(
		bundle: Gate4ProjectSources,
		source: String,
		mut order: Array<Integer>,
	): Array<Integer>
	mut index := 0
	while index + 6 <= source.size()
		if gate4_string_starts_at(source, index, " from ")
			mut raw := ""
			mut cursor := index + 6
			mut collecting := true
			while cursor < source.size()
				if collecting
					if source[cursor] == "\n"
						collecting = false
					else
						raw += source[cursor]
					end
				end
				cursor += 1
			end
			normalized := gate4_import_path_value(raw)
			target := gate4_project_bundle_find_import(bundle, normalized)
			if target >= 0
				if !gate4_project_order_contains(order, target)
					order.push(target)
				end
			end
		end
		index += 1
	end
	return order
end

def gate4_project_bundle_find_import(bundle: Gate4ProjectSources, name: String): Integer
	direct := "/" + name + ".trb"
	mut index := 0
	while index < bundle.paths.size()
		if gate4_string_ends_with(bundle.paths[index], direct)
			return index
		end
		index += 1
	end
	return - 1
end

def gate4_project_order_contains(order: Array<Integer>, target: Integer): Boolean
	mut index := 0
	while index < order.size()
		if order[index] == target
			return true
		end
		index += 1
	end
	return false
end

def gate4_order_project_sources(bundle: Gate4ProjectSources): Gate4ProjectSources
	mut entry :=- 1
	mut index := 0
	while index < bundle.paths.size()
		if gate4_project_source_declares_main(bundle.sources[index])
			entry = index
		end
		index += 1
	end
	if entry < 0
		return bundle
	end

	mut order := [entry]
	mut cursor := 0
	while cursor < order.size()
		order = gate4_project_append_imports(bundle, bundle.sources[order[cursor]], order)
		cursor += 1
	end
	index = 0
	while index < bundle.paths.size()
		if !gate4_project_order_contains(order, index)
			order.push(index)
		end
		index += 1
	end

	mut paths: Array<String> := []
	mut sources: Array<String> := []
	index = 0
	while index < order.size()
		paths.push(bundle.paths[order[index]])
		sources.push(bundle.sources[order[index]])
		index += 1
	end
	return Gate4ProjectSources.new(paths: paths, sources: sources, error: "")
end

def gate4_project_select_entry(mut state: Gate4Compiler): Boolean
	mut entry :=- 1
	mut function_index := 0
	while function_index < state.function_count[0]
		if gate4_load_string(state.function_names, function_index) == "main"
			module_index := gate4_load_integer(state.function_modules, function_index)
			if entry >= 0
				state.active_module[0] = module_index
				gate4_diagnostic(
					state,
					"TRBN4010",
					gate4_load_integer(state.function_lines, function_index),
					"project has more than one top-level main function",
				)
				return false
			end
			entry = module_index
		end
		function_index += 1
	end
	if entry < 0
		state.active_module[0] = 0
		gate4_diagnostic(state, "TRBN4010", 1, "project must declare exactly one top-level main function")
		return false
	end
	state.entry_module[0] = entry
	state.active_module[0] = entry
	return true
end

def gate4_resolve_project_imports(mut state: Gate4Compiler): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := gate4_load_string(state.import_paths, import_index)
			line := gate4_load_integer(state.import_lines, import_index)
			normalized := gate4_normalize_import_path(state, raw_path, line)
			if gate4_has_diagnostic(state)
				return false
			end
			if normalized == "trb"
				gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
				return false
			end
			if gate4_string_starts_with(normalized, "trb/")
				gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
				return false
			end
			mut target := gate4_find_module(state, normalized)
			if target < 0
				target = gate4_find_module(state, normalized + "/index")
			end
			if target < 0
				gate4_diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
				return false
			end
			gate4_store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	module_index = 0
	while module_index < state.module_count[0]
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			target := gate4_load_integer(state.import_targets, import_index)
			if gate4_module_reaches(state, target, module_index)
				raw_path := gate4_load_string(state.import_paths, import_index)
				line := gate4_load_integer(state.import_lines, import_index)
				gate4_diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
				return false
			end
			import_index += 1
		end
		module_index += 1
	end
	state.active_module[0] = state.entry_module[0]
	return true
end

def gate4_load_configured_project(config_source: String, config_path: String): Gate4Compiler
	config := gate4_parse_project_config(config_source)
	if config.error != ""
		return gate4_project_error_state(config_path, config.error_line, config.error)
	end
	root := gate4_path_directory(config_path)
	source_root := gate4_project_join(root, config.source_dir)
	out_root := gate4_project_join(root, config.out_dir)
	bundle := gate4_collect_project_sources(source_root, out_root)
	if bundle.error != ""
		return gate4_project_error_state(config_path, 1, "cannot collect project source " + bundle.error)
	end
	return gate4_load_project_sources(config_path, source_root, bundle)
end

def gate4_load_project_sources(
		config_path: String,
		source_root: String,
		bundle: Gate4ProjectSources,
	): Gate4Compiler
	if bundle.paths.size() == 0
		return gate4_project_error_state(config_path, 1, "no production .trb files found")
	end
	if bundle.paths.size() != bundle.sources.size()
		return gate4_project_error_state(config_path, 1, "project source adapter returned mismatched paths and sources")
	end
	ordered := gate4_order_project_sources(bundle)
	mut state := gate4_compiler_new(gate4_project_capacity())
	mut module_index := 0
	while module_index < ordered.paths.size()
		state.active_module[0] = module_index
		name := gate4_project_module_name(state, source_root, ordered.paths[module_index])
		if gate4_has_diagnostic(state)
			return state
		end
		gate4_add_module(state, name, ordered.paths[module_index])
		module_index += 1
	end
	module_index = 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		gate4_lex_module(state, ordered.sources[module_index], module_index)
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, start, module_index)
		end
		if gate4_has_diagnostic(state)
			return state
		end
		module_index += 1
	end
	if !gate4_project_select_entry(state)
		return state
	end
	gate4_resolve_project_imports(state)
	return state
end

def gate4_module_reaches(state: Gate4Compiler, start: Integer, goal: Integer): Boolean
	if start == goal
		return true
	end
	mut visited: Array<Integer> := []
	mut index := 0
	while index < state.module_count[0]
		visited.push(0)
		index += 1
	end
	mut queue := [start]
	visited[start] = 1
	mut cursor := 0
	while cursor < queue.size()
		module_index := queue[cursor]
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			target := gate4_load_integer(state.import_targets, import_index)
			if target == goal
				return true
			end
			if target >= 0
				if visited[target] == 0
					visited[target] = 1
					queue.push(target)
				end
			end
			import_index += 1
		end
		cursor += 1
	end
	return false
end

def gate4_load_file_root(entry_source: String, entry_path: String): Gate4Compiler
	mut state := gate4_compiler_new(gate4_project_capacity())
	root := gate4_path_directory(entry_path)
	entry_name := gate4_string_without_suffix(gate4_path_basename(entry_path), ".trb")
	entry_module := gate4_add_module(state, entry_name, entry_path)
	state.entry_module[0] = entry_module
	mut sources := [entry_source]
	mut module_index := 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		gate4_lex_module(state, sources[module_index], module_index)
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, start, module_index)
		end
		if gate4_has_diagnostic(state)
			return state
		end
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := gate4_load_string(state.import_paths, import_index)
			line := gate4_load_integer(state.import_lines, import_index)
			normalized := gate4_normalize_import_path(state, raw_path, line)
			if gate4_has_diagnostic(state)
				return state
			end
			if normalized == "trb"
				gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
				return state
			end
			if gate4_string_starts_with(normalized, "trb/")
				gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
				return state
			end
			mut target := gate4_find_module(state, normalized)
			mut target_added := false
			if target < 0
				direct_path := gate4_path_join(root, normalized + ".trb")
				if gate4_file_exists(direct_path)
					target = gate4_add_module(state, normalized, direct_path)
					sources.push(gate4_read_source(direct_path))
					target_added = true
				else
					index_name := normalized + "/index"
					target = gate4_find_module(state, index_name)
					if target < 0
						index_path := gate4_path_join(root, normalized + "/index.trb")
						if !gate4_file_exists(index_path)
							gate4_diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
							return state
						end
						target = gate4_add_module(state, index_name, index_path)
						sources.push(gate4_read_source(index_path))
						target_added = true
					end
				end
			end
			if !target_added
				if gate4_module_reaches(state, target, module_index)
					gate4_diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
					return state
				end
			end
			gate4_store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	state.active_module[0] = state.entry_module[0]
	return state
end

def gate4_find_record_in_module(state: Gate4Compiler, module_index: Integer, name: String): Integer
	mut index := state.record_count[0] - 1
	while index >= 0
		if gate4_load_integer(state.record_modules, index) == module_index
			if gate4_load_string(state.record_names, index) == name
				return index
			end
		end
		index -= 1
	end
	return - 1
end

def gate4_find_function_in_module(state: Gate4Compiler, module_index: Integer, name: String): Integer
	return gate4_find_symbol(state.function_lookup, state.function_modules, state.function_names, module_index, name)
end

def gate4_find_import_binding(state: Gate4Compiler, module_index: Integer, name: String): Integer
	start := gate4_load_integer(state.module_import_starts, module_index)
	mut index := start + gate4_load_integer(state.module_import_counts, module_index) - 1
	while index >= start
		if gate4_load_string(state.import_symbols, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def gate4_find_visible_record(mut state: Gate4Compiler, module_index: Integer, name: String): Integer
	local := gate4_find_record_in_module(state, module_index, name)
	if local >= 0
		return local
	end
	import_index := gate4_find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := gate4_load_integer(state.import_targets, import_index)
	if target < 0
		return - 1
	end
	resolved := gate4_find_record_in_module(state, target, name)
	if resolved >= 0
		gate4_store_integer(state.import_used, import_index, 1)
	end
	return resolved
end

def gate4_find_visible_function(mut state: Gate4Compiler, module_index: Integer, name: String): Integer
	local := gate4_find_function_in_module(state, module_index, name)
	if local >= 0
		return local
	end
	import_index := gate4_find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := gate4_load_integer(state.import_targets, import_index)
	if target < 0
		return - 1
	end
	resolved := gate4_find_function_in_module(state, target, name)
	if resolved >= 0
		gate4_store_integer(state.import_used, import_index, 1)
	end
	return resolved
end

def gate4_record_type(record_index: Integer): String
	return "Record#" + gate4_integer_string(record_index)
end

def gate4_find_record_type(state: Gate4Compiler, type_name: String): Integer
	mut found :=- 1
	mut index := 0
	while index < state.record_count[0]
		if gate4_record_type(index) == type_name
			found = index
		end
		index += 1
	end
	return found
end

def gate4_type_display(state: Gate4Compiler, type_name: String): String
	record_index := gate4_find_record_type(state, type_name)
	if record_index >= 0
		return gate4_load_string(state.record_names, record_index)
	end
	return type_name
end

def gate4_find_field(state: Gate4Compiler, record_index: Integer, name: String): Integer
	start := gate4_load_integer(state.record_field_starts, record_index)
	mut index := start + gate4_load_integer(state.record_field_counts, record_index) - 1
	while index >= start
		if gate4_load_string(state.field_names, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def gate4_builtin_type_exists(type_name: String, allow_void: Boolean): Boolean
	if type_name == "Integer"
		return true
	end
	if type_name == "Float"
		return true
	end
	if type_name == "Boolean"
		return true
	end
	if type_name == "String"
		return true
	end
	if type_name == "Void"
		return allow_void
	end
	if gate4_array_element_type(type_name) != ""
		return true
	end
	return false
end

def gate4_resolve_type_name(
		mut state: Gate4Compiler,
		module_index: Integer,
		type_name: String,
		allow_void: Boolean,
	): String
	if gate4_builtin_type_exists(type_name, allow_void)
		return type_name
	end
	record_index := gate4_find_visible_record(state, module_index, type_name)
	if record_index >= 0
		return gate4_record_type(record_index)
	end
	return ""
end

def gate4_array_element_type(type_name: String): String
	if type_name == "Array<Integer>"
		return "Integer"
	end
	if type_name == "Array<String>"
		return "String"
	end
	if type_name == "Array<Float>"
		return "Float"
	end
	if type_name == "Array<Array<Integer>>"
		return "Array<Integer>"
	end
	if type_name == "Array<Array<String>>"
		return "Array<String>"
	end
	if type_name == "Array<Array<Float>>"
		return "Array<Float>"
	end
	if type_name == "Array<Array<Array<Integer>>>"
		return "Array<Array<Integer>>"
	end
	if type_name == "Array<Array<Array<String>>>"
		return "Array<Array<String>>"
	end
	if type_name == "Array<Array<Array<Float>>>"
		return "Array<Array<Float>>"
	end
	return ""
end

def gate4_array_type(element_type: String): String
	result := "Array<" + element_type + ">"
	if gate4_builtin_type_exists(result, false)
		return result
	end
	return ""
end

def gate4_common_array_element_type(left: String, right: String): String
	if left == ""
		return right
	end
	if left == right
		return left
	end
	if left == "Integer"
		if right == "Float"
			return "Float"
		end
	end
	if left == "Float"
		if right == "Integer"
			return "Float"
		end
	end
	return ""
end

def gate4_local_find(locals: Gate4Locals, name: String): Integer
	mut index := locals.count[0] - 1
	while index >= 0
		if gate4_load_string(locals.names, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def gate4_local_add(
		mut state: Gate4Compiler,
		mut locals: Gate4Locals,
		name: String,
		type_name: String,
		mutable: Integer,
		line: Integer,
	): Boolean
	if gate4_local_find(locals, name) >= 0
		gate4_diagnostic(state, "TRBN4003", line, "duplicate local declaration " + name)
		return false
	end
	index := locals.count[0]
	gate4_store_string(locals.names, index, name)
	gate4_store_string(locals.types, index, type_name)
	gate4_store_integer(locals.mutable, index, mutable)
	locals.count[0] = index + 1
	return true
end

def gate4_resolution_local_add(
		mut locals: Gate4Locals,
		name: String,
		type_name: String,
		mutable: Integer,
	)
	if gate4_local_find(locals, name) < 0
		index := locals.count[0]
		gate4_store_string(locals.names, index, name)
		gate4_store_string(locals.types, index, type_name)
		gate4_store_integer(locals.mutable, index, mutable)
		locals.count[0] = index + 1
	end
	return
end

def gate4_resolution_keyword(name: String): Boolean
	mut keyword := false
	if name == "if"
		keyword = true
	end
	if name == "else"
		keyword = true
	end
	if name == "end"
		keyword = true
	end
	if name == "while"
		keyword = true
	end
	if name == "return"
		keyword = true
	end
	if name == "mut"
		keyword = true
	end
	if name == "true"
		keyword = true
	end
	if name == "false"
		keyword = true
	end
	return keyword
end

def gate4_is_typed_local_declaration(state: Gate4Compiler, index: Integer): Boolean
	mut found := false
	mut scanning := true
	mut cursor := index + 2
	while scanning
		if gate4_terminal_token(state, cursor)
			scanning = false
		else
			if gate4_load_integer(state.token_kinds, cursor) == 4
				scanning = false
			else
				if gate4_token_is(state, cursor, ":=")
					found = true
					scanning = false
				else
					if gate4_token_is(state, cursor, ",")
						scanning = false
					else
						if gate4_token_is(state, cursor, ")")
							scanning = false
						else
							cursor += 1
						end
					end
				end
			end
		end
	end
	return found
end

def gate4_validate_import_bindings(mut state: Gate4Compiler): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		module_index := gate4_load_integer(state.import_modules, import_index)
		state.active_module[0] = module_index
		name := gate4_load_string(state.import_symbols, import_index)
		line := gate4_load_integer(state.import_lines, import_index)
		mut other := gate4_load_integer(state.module_import_starts, module_index)
		while other < import_index
			if gate4_load_string(state.import_symbols, other) == name
				gate4_diagnostic(state, "TRBN4003", line, "duplicate import binding " + name)
			end
			other += 1
		end
		if gate4_find_record_in_module(state, module_index, name) >= 0
			gate4_diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		if gate4_find_function_in_module(state, module_index, name) >= 0
			gate4_diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		target := gate4_load_integer(state.import_targets, import_index)
		mut exported := false
		if target >= 0
			if gate4_find_record_in_module(state, target, name) >= 0
				exported = true
			end
			if gate4_find_function_in_module(state, target, name) >= 0
				exported = true
			end
		end
		if !exported
			gate4_diagnostic(state, "TRBN4003", line, "module does not export " + name)
		end
		import_index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_validate_import_usage(mut state: Gate4Compiler): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		if gate4_load_integer(state.import_used, import_index) == 0
			state.active_module[0] = gate4_load_integer(state.import_modules, import_index)
			gate4_diagnostic(
				state,
				"TRBN4003",
				gate4_load_integer(state.import_lines, import_index),
				"unused import " + gate4_load_string(state.import_symbols, import_index),
			)
		end
		import_index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_resolve_declarations(mut state: Gate4Compiler): Boolean
	if !gate4_validate_import_bindings(state)
		return false
	end
	mut record_index := 0
	while record_index < state.record_count[0]
		module_index := gate4_load_integer(state.record_modules, record_index)
		state.active_module[0] = module_index
		mut other_record := record_index - 1
		while other_record >= 0
			if gate4_load_integer(state.record_modules, other_record) != module_index
				other_record =- 1
			else
				if gate4_load_string(state.record_names, other_record) == gate4_load_string(state.record_names, record_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.record_lines, record_index),
						"duplicate record declaration " + gate4_load_string(state.record_names, record_index),
					)
				end
				other_record -= 1
			end
		end
		start := gate4_load_integer(state.record_field_starts, record_index)
		finish := start + gate4_load_integer(state.record_field_counts, record_index)
		mut field_index := start
		while field_index < finish
			mut other_field := start
			while other_field < field_index
				if gate4_load_string(state.field_names, other_field) == gate4_load_string(state.field_names, field_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.field_lines, field_index),
						"duplicate field declaration " + gate4_load_string(state.field_names, field_index),
					)
				end
				other_field += 1
			end
			raw_type := gate4_load_string(state.field_types, field_index)
			resolved_type := gate4_resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.field_lines, field_index), "unknown field type " + raw_type)
			else
				gate4_store_string(state.field_types, field_index, resolved_type)
			end
			field_index += 1
		end
		record_index += 1
	end
	mut main_count := 0
	mut function_index := 0
	while function_index < state.function_count[0]
		module_index := gate4_load_integer(state.function_modules, function_index)
		state.active_module[0] = module_index
		if module_index == state.entry_module[0]
			if gate4_load_string(state.function_names, function_index) == "main"
				main_count += 1
				if gate4_load_integer(state.function_parameter_counts, function_index) != 0
					gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.function_lines, function_index), "main must take no parameters")
				end
				if gate4_load_string(state.function_result_types, function_index) != "Void"
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.function_lines, function_index),
						"main must return Void, found " + gate4_load_string(state.function_result_types, function_index),
					)
				end
			end
		end
		mut other_function := function_index - 1
		while other_function >= 0
			if gate4_load_integer(state.function_modules, other_function) != module_index
				other_function =- 1
			else
				if gate4_load_string(state.function_names, other_function) == gate4_load_string(state.function_names, function_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.function_lines, function_index),
						"duplicate function declaration " + gate4_load_string(state.function_names, function_index),
					)
				end
				other_function -= 1
			end
		end
		parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
		parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
		mut parameter_index := parameter_start
		while parameter_index < parameter_finish
			mut other_parameter := parameter_start
			while other_parameter < parameter_index
				if gate4_load_string(state.parameter_names, other_parameter) == gate4_load_string(state.parameter_names, parameter_index)
					gate4_diagnostic(
						state,
						"TRBN4003",
						gate4_load_integer(state.parameter_lines, parameter_index),
						"duplicate parameter declaration " + gate4_load_string(state.parameter_names, parameter_index),
					)
				end
				other_parameter += 1
			end
			raw_type := gate4_load_string(state.parameter_types, parameter_index)
			resolved_type := gate4_resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.parameter_lines, parameter_index), "unknown parameter type " + raw_type)
			else
				gate4_store_string(state.parameter_types, parameter_index, resolved_type)
			end
			parameter_index += 1
		end
		raw_result := gate4_load_string(state.function_result_types, function_index)
		resolved_result := gate4_resolve_type_name(state, module_index, raw_result, true)
		if resolved_result == ""
			gate4_diagnostic(state, "TRBN4003", gate4_load_integer(state.function_lines, function_index), "unknown result type " + raw_result)
		else
			gate4_store_string(state.function_result_types, function_index, resolved_result)
		end
		function_index += 1
	end
	if main_count != 1
		state.active_module[0] = state.entry_module[0]
		gate4_diagnostic(state, "TRBN4003", 1, "program must declare exactly one main function")
	end
	return !gate4_has_diagnostic(state)
end

def gate4_resolve_function_body(
		mut state: Gate4Compiler,
		function_index: Integer,
		mut locals: Gate4Locals,
	): Boolean
	module_index := gate4_load_integer(state.function_modules, function_index)
	state.active_module[0] = module_index
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		gate4_resolution_local_add(
			locals,
			gate4_load_string(state.parameter_names, parameter_index),
			gate4_load_string(state.parameter_types, parameter_index),
			gate4_load_integer(state.parameter_mutable, parameter_index),
		)
		parameter_index += 1
	end
	mut index := gate4_load_integer(state.function_body_starts, function_index)
	finish := gate4_load_integer(state.function_body_ends, function_index)
	mut skipping_type := false
	while index < finish
		kind := gate4_load_integer(state.token_kinds, index)
		text := gate4_load_string(state.token_texts, index)
		if skipping_type
			if gate4_token_is(state, index, ":=")
				skipping_type = false
			end
		else
			if kind == 1
				if gate4_resolution_keyword(text)
				else
					mut previous := ""
					if index > gate4_load_integer(state.function_body_starts, function_index)
						previous = gate4_load_string(state.token_texts, index - 1)
					end
					if previous == "."
					else
						if gate4_token_is(state, index + 1, ":=")
							gate4_resolution_local_add(locals, text, "", 0)
						else
							if gate4_token_is(state, index + 1, ":")
								if gate4_is_typed_local_declaration(state, index)
									gate4_resolution_local_add(locals, text, "", 0)
									skipping_type = true
								end
							else
								if gate4_token_is(state, index + 1, "(")
									if text != "puts"
										if gate4_find_visible_function(state, module_index, text) < 0
											gate4_diagnostic(
												state,
												"TRBN4003",
												gate4_load_integer(state.token_lines, index),
												"unresolved function " + text,
											)
										end
									end
								else
									if gate4_token_is(state, index + 1, ".")
										if gate4_token_is(state, index + 2, "new")
											if gate4_find_visible_record(state, module_index, text) < 0
												gate4_diagnostic(
													state,
													"TRBN4003",
													gate4_load_integer(state.token_lines, index),
													"unresolved record " + text,
												)
											end
										else
											if gate4_local_find(locals, text) < 0
												gate4_diagnostic(
													state,
													"TRBN4003",
													gate4_load_integer(state.token_lines, index),
													"unresolved local " + text,
												)
											end
										end
									else
										if gate4_local_find(locals, text) < 0
											gate4_diagnostic(
												state,
												"TRBN4003",
												gate4_load_integer(state.token_lines, index),
												"unresolved local " + text,
											)
										end
									end
								end
							end
						end
					end
				end
			end
		end
		index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_resolve(mut state: Gate4Compiler): Boolean
	gate4_build_function_index(state)
	if !gate4_resolve_declarations(state)
		return false
	end
	mut function_index := 0
	while function_index < state.function_count[0]
		mut locals := gate4_locals_new(state.token_count[0] + 1)
		gate4_resolve_function_body(state, function_index, locals)
		function_index += 1
	end
	return !gate4_has_diagnostic(state)
end

def gate4_checked_value(
		type_name: String,
		category: Integer,
		name: String,
		mutable: Integer,
	): Gate4CheckedValue
	return Gate4CheckedValue.new(
		type_name: type_name,
		category: category,
		name: name,
		mutable: mutable,
	)
end

def gate4_type_diagnostic(
		mut state: Gate4Compiler,
		line: Integer,
		message: String,
	): Gate4CheckedValue
	gate4_diagnostic(state, "TRBN4004", line, message)
	return gate4_checked_value("Invalid", 0, "", 0)
end

def gate4_types_equal(left: String, right: String): Boolean
	return left == right
end

def gate4_numeric_type(type_name: String): Boolean
	if type_name == "Integer"
		return true
	end
	return type_name == "Float"
end

def gate4_types_assignable(actual: String, expected: String): Boolean
	if gate4_types_equal(actual, expected)
		return true
	end
	if actual == "Integer"
		return expected == "Float"
	end
	return false
end

def gate4_check_expected(
		mut state: Gate4Compiler,
		actual: String,
		expected: String,
		line: Integer,
	): Boolean
	if expected == ""
		return true
	end
	if gate4_types_assignable(actual, expected)
		return true
	end
	gate4_diagnostic(
		state,
		"TRBN4004",
		line,
		"expected " + gate4_type_display(state, expected) + ", found " + gate4_type_display(state, actual),
	)
	return false
end

def gate4_check_array_literal(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		expected: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	contextual_element_type := gate4_array_element_type(expected)
	mut element_type := contextual_element_type
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], "]")
			finished = true
		else
			value := gate4_check_expression(state, position, locals, 1, contextual_element_type)
			if contextual_element_type == ""
				common_type := gate4_common_array_element_type(element_type, value.type_name)
				if common_type == ""
					gate4_check_expected(
						state,
						value.type_name,
						element_type,
						gate4_load_integer(state.token_lines, position[0]),
					)
				else
					element_type = common_type
				end
			end
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	if !gate4_expect(state, position, "]")
		return gate4_checked_value("Invalid", 0, "", 0)
	end
	if element_type == ""
		return gate4_type_diagnostic(state, line, "empty Array literal requires a contextual type")
	end
	result_type := gate4_array_type(element_type)
	if result_type == ""
		return gate4_type_diagnostic(state, line, "unsupported Array element type " + element_type)
	end
	gate4_check_expected(state, result_type, expected, line)
	return gate4_checked_value(result_type, 0, "", 1)
end

def gate4_check_primary(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		expected: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	kind := gate4_load_integer(state.token_kinds, position[0])
	if kind == 2
		literal := gate4_load_string(state.token_texts, position[0])
		gate4_advance(position)
		if gate4_number_is_float(literal)
			if !gate4_float_literal_in_range(literal)
				return gate4_type_diagnostic(state, line, "Float literal is outside the finite binary64 range")
			end
			return gate4_checked_value("Float", 0, "", 0)
		end
		if !gate4_integer_literal_in_range(literal)
			return gate4_type_diagnostic(state, line, "Integer literal is outside the portable range")
		end
		return gate4_checked_value("Integer", 0, "", 0)
	end
	if kind == 3
		gate4_advance(position)
		return gate4_checked_value("String", 0, "", 0)
	end
	if gate4_token_is(state, position[0], "[")
		return gate4_check_array_literal(state, position, locals, expected)
	end
	if gate4_token_is(state, position[0], "(")
		gate4_advance(position)
		gate4_skip_newlines(state, position)
		value := gate4_check_expression(state, position, locals, 1, expected)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		return value
	end
	if gate4_token_is(state, position[0], "!")
		gate4_advance(position)
		value := gate4_check_postfix(
			state,
			position,
			locals,
			gate4_check_primary(state, position, locals, "Boolean"),
		)
		gate4_check_expected(state, value.type_name, "Boolean", line)
		gate4_check_expected(state, "Boolean", expected, line)
		return gate4_checked_value("Boolean", 0, "", 0)
	end
	if gate4_token_is(state, position[0], "-")
		gate4_advance(position)
		value := gate4_check_postfix(
			state,
			position,
			locals,
			gate4_check_primary(state, position, locals, ""),
		)
		if !gate4_numeric_type(value.type_name)
			return gate4_type_diagnostic(state, line, "unary - requires Integer or Float")
		end
		return gate4_checked_value(value.type_name, 0, "", 0)
	end
	if gate4_token_is(state, position[0], "+")
		gate4_advance(position)
		value := gate4_check_postfix(
			state,
			position,
			locals,
			gate4_check_primary(state, position, locals, ""),
		)
		if !gate4_numeric_type(value.type_name)
			return gate4_type_diagnostic(state, line, "unary + requires Integer or Float")
		end
		return gate4_checked_value(value.type_name, 0, "", 0)
	end
	if kind == 1
		name := gate4_load_string(state.token_texts, position[0])
		gate4_advance(position)
		if name == "true"
			return gate4_checked_value("Boolean", 0, "", 0)
		end
		if name == "false"
			return gate4_checked_value("Boolean", 0, "", 0)
		end
		local_index := gate4_local_find(locals, name)
		if local_index >= 0
			return gate4_checked_value(
				gate4_load_string(locals.types, local_index),
				0,
				name,
				gate4_load_integer(locals.mutable, local_index),
			)
		end
		if name == "puts"
			return gate4_checked_value("", 1, name, 0)
		end
		if gate4_find_visible_function(state, state.active_module[0], name) >= 0
			return gate4_checked_value("", 1, name, 0)
		end
		if gate4_find_visible_record(state, state.active_module[0], name) >= 0
			return gate4_checked_value("", 2, name, 0)
		end
		return gate4_type_diagnostic(state, line, "unresolved value " + name)
	end
	return gate4_type_diagnostic(state, line, "expected an expression")
end

def gate4_check_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		callee: Gate4CheckedValue,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	mut function_index := gate4_find_visible_function(state, state.active_module[0], callee.name)
	mut parameter_start := 0
	mut parameter_count := 1
	mut result_type := "Void"
	if callee.name == "puts"
		function_index =- 1
		result_type = "Void"
	else
		if function_index >= 0
			parameter_start = gate4_load_integer(state.function_parameter_starts, function_index)
			parameter_count = gate4_load_integer(state.function_parameter_counts, function_index)
			result_type = gate4_load_string(state.function_result_types, function_index)
		else
			gate4_diagnostic(state, "TRBN4004", line, "value is not callable")
		end
	end
	mut argument_count := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			mut argument_expected := "Invalid"
			if argument_count < parameter_count
				if callee.name == "puts"
					argument_expected = "String"
				else
					argument_expected = gate4_load_string(state.parameter_types, parameter_start + argument_count)
				end
			end
			gate4_check_expression(state, position, locals, 1, argument_expected)
			argument_count += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	if argument_count != parameter_count
		gate4_diagnostic(state, "TRBN4004", line, "call argument count does not match " + callee.name)
	end
	return gate4_checked_value(result_type, 0, "", 0)
end

def gate4_check_record_new(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		record_name: String,
	): Gate4CheckedValue
	record_index := gate4_find_visible_record(state, state.active_module[0], record_name)
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	field_start := gate4_load_integer(state.record_field_starts, record_index)
	field_count := gate4_load_integer(state.record_field_counts, record_index)
	mut argument_index := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			label := gate4_expect_identifier(state, position)
			gate4_expect(state, position, ":")
			mut expected := "Invalid"
			if argument_index < field_count
				expected = gate4_load_string(state.field_types, field_start + argument_index)
				if label != gate4_load_string(state.field_names, field_start + argument_index)
					gate4_diagnostic(
						state,
						"TRBN4004",
						line,
						"record fields must be initialized in declaration order",
					)
				end
			end
			gate4_check_expression(state, position, locals, 1, expected)
			argument_index += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	if argument_index != field_count
		gate4_diagnostic(state, "TRBN4004", line, "record field count does not match " + record_name)
	end
	return gate4_checked_value(gate4_record_type(record_index), 0, "", 1)
end

def gate4_check_method_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		receiver: Gate4CheckedValue,
		method: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	if method == "size"
		gate4_expect(state, position, ")")
		if receiver.type_name == "String"
			return gate4_checked_value("Integer", 0, "", 0)
		end
		if gate4_array_element_type(receiver.type_name) != ""
			return gate4_checked_value("Integer", 0, "", 0)
		end
		return gate4_type_diagnostic(state, line, "size is unavailable on " + gate4_type_display(state, receiver.type_name))
	end
	if method == "push"
		element_type := gate4_array_element_type(receiver.type_name)
		if element_type == ""
			return gate4_type_diagnostic(state, line, "push is unavailable on " + gate4_type_display(state, receiver.type_name))
		end
		if receiver.mutable == 0
			gate4_diagnostic(state, "TRBN4004", line, "push receiver is immutable")
		end
		gate4_check_expression(state, position, locals, 1, element_type)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		return gate4_checked_value("Void", 0, "", 0)
	end
	return gate4_type_diagnostic(state, line, "unsupported method " + method)
end

def gate4_check_postfix(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		initial: Gate4CheckedValue,
	): Gate4CheckedValue
	mut value := gate4_checked_value(initial.type_name, initial.category, initial.name, initial.mutable)
	mut scanning := true
	while scanning
		if gate4_token_is(state, position[0], "(")
			if value.category == 1
				value = gate4_check_call(state, position, locals, value)
			else
				value = gate4_type_diagnostic(
					state,
					gate4_load_integer(state.token_lines, position[0]),
					"value is not directly callable",
				)
				scanning = false
			end
		else
			if gate4_token_is(state, position[0], ".")
				gate4_advance(position)
				member := gate4_expect_identifier(state, position)
				if gate4_token_is(state, position[0], "(")
					if value.category == 2
						if member == "new"
							value = gate4_check_record_new(state, position, locals, value.name)
						else
							value = gate4_type_diagnostic(
								state,
								gate4_load_integer(state.token_lines, position[0]),
								"unsupported record constructor member " + member,
							)
							scanning = false
						end
					else
						value = gate4_check_method_call(state, position, locals, value, member)
					end
				else
					record_index := gate4_find_record_type(state, value.type_name)
					if record_index < 0
						value = gate4_type_diagnostic(
							state,
							gate4_load_integer(state.token_lines, position[0]),
							"field access requires a record value",
						)
						scanning = false
					else
						field_index := gate4_find_field(state, record_index, member)
						if field_index < 0
							value = gate4_type_diagnostic(
								state,
								gate4_load_integer(state.token_lines, position[0]),
								"unknown field " + member + " on " + gate4_type_display(state, value.type_name),
							)
							scanning = false
						else
							value = gate4_checked_value(
								gate4_load_string(state.field_types, field_index),
								0,
								member,
								value.mutable,
							)
						end
					end
				end
			else
				if gate4_token_is(state, position[0], "[")
					line := gate4_load_integer(state.token_lines, position[0])
					gate4_advance(position)
					gate4_check_expression(state, position, locals, 1, "Integer")
					gate4_expect(state, position, "]")
					if value.type_name == "String"
						value = gate4_checked_value("String", 0, "", 0)
					else
						element_type := gate4_array_element_type(value.type_name)
						if element_type == ""
							value = gate4_type_diagnostic(
								state,
								line,
								"indexing is unavailable on " + value.type_name,
							)
							scanning = false
						else
							value = gate4_checked_value(element_type, 0, "", value.mutable)
						end
					end
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def gate4_binary_result_type(
		mut state: Gate4Compiler,
		operator: String,
		left: String,
		right: String,
		line: Integer,
	): String
	mut numeric_pair := false
	if gate4_numeric_type(left)
		if gate4_numeric_type(right)
			numeric_pair = true
		end
	end
	if left != right
		if !numeric_pair
			gate4_diagnostic(state, "TRBN4004", line, "binary operands have different types")
			return "Invalid"
		end
	end
	mut numeric_result := "Integer"
	if left == "Float"
		numeric_result = "Float"
	end
	if right == "Float"
		numeric_result = "Float"
	end
	if operator == "+"
		if numeric_pair
			return numeric_result
		end
		if left == "String"
			return "String"
		end
	end
	if operator == "-"
		if numeric_pair
			return numeric_result
		end
	end
	if operator == "*"
		if numeric_pair
			return numeric_result
		end
	end
	if operator == "/"
		if numeric_pair
			return numeric_result
		end
	end
	if operator == "%"
		if left == "Integer"
			if right == "Integer"
				return "Integer"
			end
		end
	end
	if operator == "=="
		if numeric_pair
			return "Boolean"
		end
		if left == right
			return "Boolean"
		end
	end
	if operator == "!="
		if numeric_pair
			return "Boolean"
		end
		if left == right
			return "Boolean"
		end
	end
	if operator == "<"
		if numeric_pair
			return "Boolean"
		end
	end
	if operator == "<="
		if numeric_pair
			return "Boolean"
		end
	end
	if operator == ">"
		if numeric_pair
			return "Boolean"
		end
	end
	if operator == ">="
		if numeric_pair
			return "Boolean"
		end
	end
	mut display_type := left
	if right == "Float"
		display_type = "Float"
	end
	gate4_diagnostic(state, "TRBN4004", line, "unsupported operator " + operator + " for " + display_type)
	return "Invalid"
end

def gate4_check_expression(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		minimum_precedence: Integer,
		expected: String,
	): Gate4CheckedValue
	line := gate4_load_integer(state.token_lines, position[0])
	mut value := gate4_check_postfix(
		state,
		position,
		locals,
		gate4_check_primary(state, position, locals, expected),
	)
	mut scanning := true
	while scanning
		operator := gate4_load_string(state.token_texts, position[0])
		precedence := gate4_binary_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			right := gate4_check_expression(state, position, locals, precedence + 1, "")
			result_type := gate4_binary_result_type(state, operator, value.type_name, right.type_name, line)
			value = gate4_checked_value(result_type, 0, "", 0)
		end
	end
	gate4_check_expected(state, value.type_name, expected, line)
	return value
end

def gate4_compound_operator(operator: String): String
	if operator == "+="
		return "+"
	end
	if operator == "-="
		return "-"
	end
	if operator == "*="
		return "*"
	end
	if operator == "/="
		return "/"
	end
	return ""
end

def gate4_check_declaration(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
	): Boolean
	mut mutable := 0
	if gate4_token_is(state, position[0], "mut")
		mutable = 1
		gate4_advance(position)
	end
	line := gate4_load_integer(state.token_lines, position[0])
	name := gate4_expect_identifier(state, position)
	mut declared_type := ""
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		declared_type = gate4_parse_type(state, position)
		resolved_type := gate4_resolve_type_name(state, state.active_module[0], declared_type, false)
		if resolved_type == ""
			gate4_diagnostic(state, "TRBN4004", line, "unknown local type " + declared_type)
		else
			declared_type = resolved_type
		end
	end
	gate4_expect(state, position, ":=")
	value := gate4_check_expression(state, position, locals, 1, declared_type)
	mut local_type := declared_type
	if local_type == ""
		local_type = value.type_name
	end
	if local_type == "Void"
		gate4_diagnostic(state, "TRBN4004", line, "local binding cannot have type Void")
	end
	gate4_local_add(state, locals, name, local_type, mutable, line)
	return gate4_finish_statement(state, position)
end

def gate4_check_simple_statement(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
	): Boolean
	line := gate4_load_integer(state.token_lines, position[0])
	left := gate4_check_expression(state, position, locals, 1, "")
	operator := gate4_load_string(state.token_texts, position[0])
	if operator == "="
		if left.mutable == 0
			gate4_diagnostic(state, "TRBN4004", line, "assignment target is immutable")
		end
		gate4_advance(position)
		gate4_check_expression(state, position, locals, 1, left.type_name)
	else
		compound := gate4_compound_operator(operator)
		if compound != ""
			if left.mutable == 0
				gate4_diagnostic(state, "TRBN4004", line, "assignment target is immutable")
			end
			gate4_advance(position)
			right := gate4_check_expression(state, position, locals, 1, left.type_name)
			gate4_binary_result_type(state, compound, left.type_name, right.type_name, line)
		end
	end
	return gate4_finish_statement(state, position)
end

def gate4_check_block(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut locals: Gate4Locals,
		result_type: String,
	): Boolean
	gate4_skip_newlines(state, position)
	mut complete := false
	while !complete
		if gate4_terminal_token(state, position[0])
			gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, position[0]), "unexpected end of input")
			complete = true
		else
			if gate4_token_is(state, position[0], "end")
				complete = true
			else
				if gate4_token_is(state, position[0], "else")
					complete = true
				else
					if gate4_token_is(state, position[0], "if")
						line := gate4_load_integer(state.token_lines, position[0])
						gate4_advance(position)
						condition := gate4_check_expression(state, position, locals, 1, "Boolean")
						gate4_check_expected(state, condition.type_name, "Boolean", line)
						gate4_finish_statement(state, position)
						saved_count := locals.count[0]
						gate4_check_block(state, position, locals, result_type)
						locals.count[0] = saved_count
						if gate4_token_is(state, position[0], "else")
							gate4_advance(position)
							gate4_finish_statement(state, position)
							gate4_check_block(state, position, locals, result_type)
							locals.count[0] = saved_count
						end
						gate4_expect(state, position, "end")
						gate4_finish_statement(state, position)
					else
						if gate4_token_is(state, position[0], "while")
							line := gate4_load_integer(state.token_lines, position[0])
							gate4_advance(position)
							condition := gate4_check_expression(state, position, locals, 1, "Boolean")
							gate4_check_expected(state, condition.type_name, "Boolean", line)
							gate4_finish_statement(state, position)
							saved_count := locals.count[0]
							gate4_check_block(state, position, locals, result_type)
							locals.count[0] = saved_count
							gate4_expect(state, position, "end")
							gate4_finish_statement(state, position)
						else
							if gate4_token_is(state, position[0], "return")
								line := gate4_load_integer(state.token_lines, position[0])
								gate4_advance(position)
								if gate4_load_integer(state.token_kinds, position[0]) == 4
									if result_type != "Void"
										gate4_diagnostic(state, "TRBN4004", line, "return value is required")
									end
								else
									if result_type == "Void"
										gate4_diagnostic(state, "TRBN4004", line, "Void function cannot return a value")
									else
										gate4_check_expression(state, position, locals, 1, result_type)
									end
								end
								gate4_finish_statement(state, position)
							else
								mut declaration := false
								if gate4_token_is(state, position[0], "mut")
									declaration = true
								else
									if gate4_load_integer(state.token_kinds, position[0]) == 1
										if gate4_token_is(state, position[0] + 1, ":=")
											declaration = true
										else
											if gate4_token_is(state, position[0] + 1, ":")
												declaration = true
											end
										end
									end
								end
								if declaration
									gate4_check_declaration(state, position, locals)
								else
									gate4_check_simple_statement(state, position, locals)
								end
							end
						end
					end
				end
			end
		end
		if gate4_has_diagnostic(state)
			complete = true
		end
	end
	return !gate4_has_diagnostic(state)
end

def gate4_check_function(mut state: Gate4Compiler, function_index: Integer): Boolean
	state.active_module[0] = gate4_load_integer(state.function_modules, function_index)
	mut locals := gate4_locals_new(state.token_count[0] + 1)
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		gate4_local_add(
			state,
			locals,
			gate4_load_string(state.parameter_names, parameter_index),
			gate4_load_string(state.parameter_types, parameter_index),
			gate4_load_integer(state.parameter_mutable, parameter_index),
			gate4_load_integer(state.parameter_lines, parameter_index),
		)
		parameter_index += 1
	end
	mut position := [gate4_load_integer(state.function_body_starts, function_index)]
	gate4_check_block(state, position, locals, gate4_load_string(state.function_result_types, function_index))
	if position[0] != gate4_load_integer(state.function_body_ends, function_index)
		gate4_diagnostic(
			state,
			"TRBN4004",
			gate4_load_integer(state.function_lines, function_index),
			"checker did not consume the complete function body",
		)
	end
	valid :=!gate4_has_diagnostic(state)
	gate4_reset_temporary_storage()
	return valid
end

def gate4_check(mut state: Gate4Compiler): Boolean
	mut function_index := 0
	while function_index < state.function_count[0]
		gate4_check_function(state, function_index)
		function_index += 1
	end
	if !gate4_has_diagnostic(state)
		gate4_validate_import_usage(state)
	end
	return !gate4_has_diagnostic(state)
end

def main()
	return
end
