def gate4_reset_temporary_storage()
	return
end

# These declarations are typed compiler-runtime intrinsics. Their source bodies
# keep recovery compilation valid; the self-hosted emitter replaces calls from
# the compiler executable with the matching QBE runtime operations.
def gate4_file_exists(_path: String): Boolean
	return false
end

def gate4_read_source(_path: String): String
	return ""
end

def gate4_project_source_request(action: String, value: String): String
	mut request := "trbn-internal:project-sources-v1:" + action
	if value != ""
		request += ":" + value
	end
	return request
end

def gate4_collect_project_sources(source_root: String, out_root: String): Gate4ProjectSources
	gate4_read_source(gate4_project_source_request("source-root", source_root))
	gate4_read_source(gate4_project_source_request("out-root", out_root))
	error := gate4_read_source(gate4_project_source_request("collect", ""))
	mut paths: Array<String> := []
	mut sources: Array<String> := []
	if error == ""
		mut index := 0
		mut collecting := true
		while collecting
			index_text := gate4_integer_string(index)
			path := gate4_read_source(gate4_project_source_request("path", index_text))
			if path == ""
				collecting = false
			else
				source := gate4_read_source(gate4_project_source_request("source", index_text))
				paths.push(path)
				sources.push(source)
				index += 1
			end
		end
	end
	return Gate4ProjectSources.new(paths: paths, sources: sources, error: error)
end

