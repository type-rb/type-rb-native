		module_import_starts: gate4_integer_storage(capacity),
		module_import_counts: gate4_integer_storage(capacity),
		module_lookup: gate4_symbol_index_new(capacity),
		entry_module: [0],
		active_module: [0],
		import_modules: gate4_integer_storage(capacity),
		import_paths: gate4_string_storage(capacity),
		import_symbols: gate4_string_storage(capacity),
		import_declarations: gate4_string_storage(capacity),
		import_kinds: gate4_integer_storage(capacity),
		import_lines: gate4_integer_storage(capacity),
		import_targets: gate4_integer_storage(capacity),
		import_used: gate4_integer_storage(capacity),
		import_count: [0],
		record_names: gate4_string_storage(capacity),
		record_modules: gate4_integer_storage(capacity),
		record_field_starts: gate4_integer_storage(capacity),
		record_field_counts: gate4_integer_storage(capacity),
		record_lines: gate4_integer_storage(capacity),
		record_count: [0],
		field_names: gate4_string_storage(capacity),
		field_types: gate4_string_storage(capacity),
		field_lines: gate4_integer_storage(capacity),
		field_count: [0],
		function_names: gate4_string_storage(capacity),
		function_modules: gate4_integer_storage(capacity),
		function_parameter_starts: gate4_integer_storage(capacity),
		function_parameter_counts: gate4_integer_storage(capacity),
		function_result_types: gate4_string_storage(capacity),
		function_body_starts: gate4_integer_storage(capacity),
		function_body_ends: gate4_integer_storage(capacity),
		function_lines: gate4_integer_storage(capacity),
		function_count: [0],
		function_lookup: gate4_symbol_index_new(capacity),
