		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(gate4_occurrence_count(qbe, "call $g4_gc_temp_push")).to_equal(2)
		expect(qbe.include?("\tcall $g4_gc_temp_push(l %t")).to_be_false()
		expect(qbe.include?("\tcall $g4_gc_temp_push(l %object)")).to_be_true()
		expect(qbe.include?("\tcall $g4_gc_temp_push(l %return_result)")).to_be_true()
	end

	test("omits managed root publication only without GC safe points") do
		prefix := "record FloatBucket\n\tvalues: Array<Float>\nend\n\n"
		no_safe_point := prefix + "def sum(bucket: FloatBucket): Float\n\tmut values := bucket.values\n\tmut total: Float := 0\n\tmut index := 0\n\twhile index < values.size()\n\t\ttotal += values[index]\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef main()\n\treturn\nend\n"
		mut no_safe_point_state := gate4_compiler_new(no_safe_point.size() + 1)
		expect(gate4_lex(no_safe_point_state, no_safe_point)).to_be_true()
		expect(gate4_parse_module(no_safe_point_state, 0, no_safe_point_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(no_safe_point_state)).to_be_true()
		expect(gate4_check(no_safe_point_state)).to_be_true()
		no_safe_point_qbe := gate4_output_source(gate4_emit_qbe(no_safe_point_state))
		expect(no_safe_point_qbe.include?("%temporary_roots =l loadl $g4_gc_temp_count")).to_be_false()
		expect(no_safe_point_qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_false()

		allocation := prefix + "def append(bucket: FloatBucket)\n\tmut values := bucket.values\n\tmut index := 0\n\twhile index < 1\n\t\tvalues.push(1.0)\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut allocation_state := gate4_compiler_new(allocation.size() + 1)
		expect(gate4_lex(allocation_state, allocation)).to_be_true()
		expect(gate4_parse_module(allocation_state, 0, allocation_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(allocation_state)).to_be_true()
		expect(gate4_check(allocation_state)).to_be_true()
		allocation_qbe := gate4_output_source(gate4_emit_qbe(allocation_state))
		expect(allocation_qbe.include?("%temporary_roots =l loadl $g4_gc_temp_count")).to_be_true()
		expect(allocation_qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_true()

		call := prefix + "def observe(_value: Float)\n\treturn\nend\n\ndef visit(bucket: FloatBucket)\n\tmut values := bucket.values\n\tmut index := 0\n\twhile index < values.size()\n\t\tobserve(values[index])\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut call_state := gate4_compiler_new(call.size() + 1)
		expect(gate4_lex(call_state, call)).to_be_true()
		expect(gate4_parse_module(call_state, 0, call_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(call_state)).to_be_true()
		expect(gate4_check(call_state)).to_be_true()
		call_qbe := gate4_output_source(gate4_emit_qbe(call_state))
		expect(call_qbe.include?("%temporary_roots =l loadl $g4_gc_temp_count")).to_be_true()
		expect(call_qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_true()
	end

	test("defers managed root publication until a safe-point-free loop exits") do
		source := "def observe(value: Array<String>)\n\treturn\nend\n\ndef carry(limit: Integer): String\n\tmut values: Array<String> := []\n\tvalues.push(\"kept\")\n\tmut index := 0\n\twhile index < limit\n\t\tindex += 1\n\tend\n\tvalues.push(\"after\")\n\treturn values[0]\nend\n\ndef call_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tobserve(values)\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef main()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("function l $g4f1(l %p0) {\n@start")).to_be_true()
		expect(qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_true()
		expect(
			qbe.include?(
				"@l0\n\t%t2 =l loadl %v2\n\t%t3 =l loadl %v0",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"@l2\n\t%t10 =l loadl $g4_gc_temp_data" +
				"\n\t%t11 =l mul %temporary_roots, 8" +
				"\n\t%t12 =l add %t10, %t11" +
				"\n\t%t13 =l loadl %v1" +
				"\n\tstorel %t13, %t12" +
				"\n\t%t14 =l add %temporary_roots, 1" +
				"\n\tstorel %t14, $g4_gc_temp_count" +
				"\n\t%t15 =l loadl %v1" +
				"\n\tcall $g4_array_push_paced(l %t15, l $g4s64)",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"@l0\n\t%t10 =l loadl $g4_gc_temp_data" +
				"\n\t%t11 =l mul %temporary_roots, 8" +
				"\n\t%t12 =l add %t10, %t11" +
				"\n\t%t13 =l loadl %v1" +
				"\n\tstorel %t13, %t12" +
				"\n\t%t14 =l add %temporary_roots, 1" +
				"\n\tstorel %t14, $g4_gc_temp_count" +
				"\n\t%t1 =l loadl %v2",
			),
		).to_be_true()
	end

	test("keeps managed root publication at every GC-safe loop header") do
		source := "def observe_loop_value(value: Array<String>)\n\treturn\nend\n\ndef make_loop_values(): Array<String>\n\treturn [\"made\"]\nend\n\ndef grow_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tvalues.push(\"grown\")\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef allocate_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tmade: Array<String> := []\n\t\tif made.size() > 0\n\t\t\tputs(\"unexpected\")\n\t\tend\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef managed_result_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tmade := make_loop_values()\n\t\tif made.size() == 0\n\t\t\tputs(\"unexpected\")\n\t\tend\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef opaque_call_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tobserve_loop_value(values)\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef main()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(
			gate4_occurrence_count(qbe, "@l0\n\t%t10 =l loadl $g4_gc_temp_data"),
		).to_equal(2)
		expect(
			gate4_occurrence_count(qbe, "@l0\n\t%t16 =l loadl $g4_gc_temp_data"),
		).to_equal(2)
		expect(qbe.include?("@l1\n\t%t6 =l loadl %v1\n\tcall $g4_array_push_paced")).to_be_true()
		expect(qbe.include?("@l1\n\t%t6 =l call $g4_array_new")).to_be_true()
		expect(qbe.include?("@l1\n\t%t6 =l call $g4f1()")).to_be_true()
		expect(qbe.include?("@l1\n\t%t6 =l loadl %v1\n\tcall $g4f0(l %t6)")).to_be_true()
	end

	test("reuses two recent Array headers until an explicit invalidation boundary") do
		mut context := gate4_emit_context_new(16, [64, 16, 2])
		mut output := gate4_output_new(16, [0, 0, 0, 0])
		context.loop_depth[0] = 1
		mut local_index := 0
		while local_index < 1
			gate4_store_string(context.local_types, local_index, "Array<Integer>")
			gate4_store_integer(context.local_inherited, local_index, 0)
			local_index += 1
		end
		context.local_count[0] = 1
		first_length := gate4_emit_array_header(context, output, "%first", "%v0", 1, "8", "%la0", "%l0")
		expect(output.count[0]).to_equal(2)
		second_length := gate4_emit_array_header(context, output, "%second", "%v1", 1, "8", "%la1", "%l1")
		expect(output.count[0]).to_equal(4)
		cached_first_length := gate4_emit_array_header(context, output, "%first", "%v0", 1, "8", "%la2", "%l2")
		expect(cached_first_length).to_equal(first_length)
		expect(output.count[0]).to_equal(4)
		cached_second_length := gate4_emit_array_header(context, output, "%second", "%v1", 1, "8", "%la3", "%l3")
		expect(cached_second_length).to_equal(second_length)
		expect(output.count[0]).to_equal(4)
		first_data := gate4_emit_array_header(context, output, "%first", "%v0", 2, "24", "%da0", "%d0")
		expect(output.count[0]).to_equal(6)
		second_data := gate4_emit_array_header(context, output, "%second", "%v1", 2, "24", "%da1", "%d1")
		expect(output.count[0]).to_equal(8)
		cached_first_data := gate4_emit_array_header(context, output, "%first", "%v0", 2, "24", "%da2", "%d2")
		expect(cached_first_data).to_equal(first_data)
		expect(output.count[0]).to_equal(8)
		cached_second_data := gate4_emit_array_header(context, output, "%second", "%v1", 2, "24", "%da3", "%d3")
		expect(cached_second_data).to_equal(second_data)
		expect(output.count[0]).to_equal(8)

		gate4_invalidate_array_header_cache(context)
		refreshed_first_length := gate4_emit_array_header(context, output, "%first", "%v0", 1, "8", "%la4", "%l4")
		expect(refreshed_first_length == first_length).to_be_false()
		expect(output.count[0]).to_equal(10)
		refreshed_second_length := gate4_emit_array_header(context, output, "%second", "%v1", 1, "8", "%la5", "%l5")
		expect(refreshed_second_length == second_length).to_be_false()
		expect(output.count[0]).to_equal(12)
	end

	test("keeps Array header loads local outside owned-managed loops") do
		mut context := gate4_emit_context_new(16, [64, 16, 2])
		mut output := gate4_output_new(16, [0, 0, 0, 0])
		first_length := gate4_emit_array_header(context, output, "%first", "", 1, "8", "%la0", "%l0")
		second_length := gate4_emit_array_header(context, output, "%second", "", 1, "8", "%la1", "%l1")
		expect(second_length == first_length).to_be_false()
		expect(output.count[0]).to_equal(4)
	end

	test("emits an opt-in sampled managed-runtime trace without changing stats v1") do
		source := "def main()\n\tmut value := \"seed\"\n\tmut index := 0\n\twhile index < 2\n\t\tvalue += \"x\"\n\t\tindex += 1\n\tend\n\tputs(value)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("TYPE_RB_NATIVE_RUNTIME_TRACE")).to_be_true()
		expect(qbe.include?("function $g4_gc_trace_initialize()")).to_be_true()
		expect(qbe.include?("function $g4_gc_trace(w %automatic, l %collection)")).to_be_true()
		expect(qbe.include?("\t%remainder =l rem %collection, 64")).to_be_true()
		expect(qbe.include?("type-rb-native-gc-trace-v1,root-capacity,")).to_be_true()
		expect(qbe.include?("\tcall $g4_gc_trace(w %automatic, l %next_count)")).to_be_true()
		expect(qbe.include?("@start\n\tcall $g4_gc_trace_initialize()\n\tcall $g4f0()")).to_be_true()
		expect(qbe.include?("%disabled =w and %stats_disabled, %trace_disabled")).to_be_true()
		expect(qbe.include?("type-rb-native-gc-stat-v1,collections,")).to_be_true()
		expect(qbe.include?("type-rb-native-gc-stat-v2")).to_be_false()
	end

	test("folds literal-only String concatenation and preserves postfix binding") do
		source := "def main()\n\tdirect := \"a\" + \"b\" + \"c\"\n\tdynamic := direct + \"d\"\n\tpostfix := \"a\" + \"b\".size().to_s()\n\tputs(dynamic)\n\tputs(postfix)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(gate4_occurrence_count(qbe, "call $g4_string_concat")).to_equal(2)
	end

	test("compresses only profitable static Strings at the registered boundary") do
		overlapping := gate4_repeat_text("a", 300)
		encoded := gate4_encode_static_string(overlapping)
		expect(encoded.size() < overlapping.size()).to_be_true()
		expect(encoded[0]).to_equal(97)
		expect(encoded[1]).to_equal(255)
		expect(encoded[2]).to_equal(0)
		expect(encoded[3]).to_equal(1)

		incompressible := "aaabaacaadaaeaafaagaahaaiaajaakaalaamaanaaoaapabbabcabdabeabfabgabhabiabjabkablabmabnaboabpacbaccacdaceacfacgachaciacjackaclacmacnacoacpadbadcaddadeadfadgadhadiadjadkadladmadnadoadpaebaecaedaeeaefaegaehaeiaejaekaelaemaenaeoaepafbafcafdafeaffafgafhafiafjafk"
		incompressible_encoded := gate4_encode_static_string(incompressible)
		expect(incompressible.size()).to_equal(256)
		expect(incompressible_encoded.size()).to_equal(incompressible.size())

		below := gate4_repeat_text("abcd", 63) + "abc"
		below_source := "def main()\n\tvalue := \"" + below + "\"\n\tputs(value)\n\treturn\nend\n"
		mut below_state := gate4_compiler_new(below_source.size() + 1)
		expect(gate4_lex(below_state, below_source)).to_be_true()
		expect(gate4_parse_module(below_state, 0, below_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(below_state)).to_be_true()
		expect(gate4_check(below_state)).to_be_true()
		below_qbe := gate4_output_source(gate4_emit_qbe(below_state))
		expect(below_qbe.include?("g4_static_string_decode")).to_be_false()
		expect(below_qbe.include?("g4_static_strings_initialize")).to_be_false()

		boundary := gate4_repeat_text("abcd", 64)
		boundary_source := "def main()\n\tvalue := \"" + boundary + "\"\n\tputs(value)\n\treturn\nend\n"
		mut boundary_state := gate4_compiler_new(boundary_source.size() + 1)
		expect(gate4_lex(boundary_state, boundary_source)).to_be_true()
		expect(gate4_parse_module(boundary_state, 0, boundary_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(boundary_state)).to_be_true()
		expect(gate4_check(boundary_state)).to_be_true()
		boundary_qbe := gate4_output_source(gate4_emit_qbe(boundary_state))
		expect(boundary_qbe.include?(" = align 8 { z 273 }")).to_be_true()
		expect(boundary_qbe.include?("data $g4c")).to_be_true()
		expect(boundary_qbe.include?("function $g4_static_string_decode")).to_be_true()
		expect(boundary_qbe.include?("\tstoreb 0, %terminator")).to_be_true()
		expect(boundary_qbe.include?("\tcall $g4_static_strings_initialize()")).to_be_true()

		deduplicated_source := "def compiler_main(source: String, mode: String, with_path: Boolean): Integer\n\tfirst := \"" + boundary + "\"\n\tsecond := \"" + boundary + "\"\n\tif first == second\n\t\treturn 0\n\telse\n\t\treturn 1\n\tend\nend\n\ndef main()\n\treturn\nend\n"
		mut deduplicated_state := gate4_compiler_new(deduplicated_source.size() + 1)
		expect(gate4_lex(deduplicated_state, deduplicated_source)).to_be_true()
		expect(gate4_parse_module(deduplicated_state, 0, deduplicated_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(deduplicated_state)).to_be_true()
		expect(gate4_check(deduplicated_state)).to_be_true()
		deduplicated_qbe := gate4_output_source(gate4_emit_qbe(deduplicated_state))
		expect(gate4_occurrence_count(deduplicated_qbe, " = align 8 { z 273 }")).to_equal(1)
		expect(gate4_occurrence_count(deduplicated_qbe, "call $g4_static_string_decode")).to_equal(1)
	end

	test("emits deterministic QBE and executes the registered source subset") do
		source := gate4_frontend_test_source()
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		first := gate4_output_source(gate4_emit_qbe(state))
		second := gate4_output_source(gate4_emit_qbe(state))
		expect(first).to_equal(second)
		expect(first.include?("function l $g4f0(l %p0, l %p1) {")).to_be_true()
		expect(first.include?("export function w $main(w %argc, l %argv) {")).to_be_true()
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate4-emitter"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case native_write_text(workspace + "/module.ssa", first)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case native_write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(workspace + "/program", [])
			when Result::Ok(result)
				expect(result.success).to_be_true()
				expect(result.stdout).to_equal("ok\n")
				expect(result.stderr).to_equal("")
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
		end
	end
end
