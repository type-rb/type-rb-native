import { Gate4Compiler, Gate4Output, Gate4ProjectSources, gate4_add_module, gate4_build_symbol_index, gate4_character_in, gate4_check, gate4_compiler_new, gate4_emit_qbe, gate4_find_field, gate4_find_function_in_module, gate4_find_import_binding, gate4_find_module, gate4_find_record_in_module, gate4_find_record_type, gate4_float_literal_in_range, gate4_has_diagnostic, gate4_lex, gate4_lex_module, gate4_load_file_root, gate4_load_project_sources, gate4_local_find, gate4_locals_new, gate4_number_is_float, gate4_number_without_underscores, gate4_parse_module, gate4_parse_project_config, gate4_resolve, gate4_string_bucket, gate4_symbol_bucket_count } from compiler
import { gate4_integer_storage, gate4_load_integer, gate4_load_string, gate4_store_integer, gate4_store_string, gate4_string_storage } from storage
import trb/std/filesystem
import trb/std/process
import trb/std/result
import trb/std/string_builder
import { describe, expect, test } from trb/std/test

def gate4_frontend_test_source(): String
	return "record Pair\n\tleft: Integer\n\tright: Integer\nend\n\ndef add(left: Integer, right: Integer): Integer\n\treturn left + right\nend\n\ndef main()\n\tpair := Pair.new(left: 20, right: 22)\n\tmut values: Array<Integer> := []\n\tvalues.push(add(pair.left, pair.right))\n\tmessage := \"o\" + \"k\"\n\tif values[0] == 42\n\t\tif message != \"bad\"\n\t\t\tputs(message)\n\t\telse\n\t\t\tputs(\"bad\")\n\t\tend\n\telse\n\t\tputs(\"bad\")\n\tend\n\treturn\nend\n"
end

def gate4_output_source(output: Gate4Output): String
	mut writer := StringBuilder.new()
	mut index := 0
	while index < output.count[0]
		writer.append(gate4_load_string(output.lines, index))
		writer.append("\n")
		index += 1
	end
	return writer.to_s()
end

def gate4_required_test_source(path: String): String
	case FileSystem.read_text(path)
	when Result::Ok(source)
		return source
	when Result::Err(error)
		puts(error.operation + ": " + error.message)
		return ""
	end
end

def gate4_scale_test_source(count: Integer): String
	mut writer := StringBuilder.new()
	writer.append("def f0(value: Integer): Integer\n\treturn value\nend\n\n")
	mut index := 1
	while index < count
		writer.append("def f" + index.to_s() + "(value: Integer): Integer\n\treturn f")
		writer.append((index - 1).to_s())
		writer.append("(value)\nend\n\n")
		index += 1
	end
	writer.append("def main()\n\tvalue := f" + (count - 1).to_s() + "(1)\n\treturn\nend\n")
	return writer.to_s()
end

describe("Gate 4 TypeRB frontend") do
	test("strictly decodes the configured-project projection and comments") do
		config := gate4_parse_project_config(
			"{\n" +
			"  // a comment outside a String\n" +
			"  \"$schema\": \"https://example.com/schema//v1\",\n" +
			"  \"name\": \"configured /* project */\",\n" +
			"  \"version\": \"2.0.0\",\n" +
			"  \"m\\u006fde\": \"go\",\n" +
			"  \"sourceDir\": \"src/./application/../lib\",\n" +
			"  \"outDir\": \"artifacts/native\",\n" +
			"  \"copyFiles\": false,\n" +
			"  \"packageManagement\": \"external\",\n" +
			"  /* the bounded portable Go projection */\n" +
			"  \"go\": {\n" +
			"    \"module\": \"example.com/configured\",\n" +
			"    \"version\": \"1.28.1\",\n" +
			"    \"rootPackage\": \"command\"\n" +
			"  }\n" +
			"}\n",
		)
		expect(config.error).to_equal("")
		expect(config.name).to_equal("configured /* project */")
		expect(config.version).to_equal("2.0.0")
		expect(config.mode).to_equal("go")
		expect(config.source_dir).to_equal("src/lib")
		expect(config.out_dir).to_equal("artifacts/native")
		expect(config.copy_files).to_be_false()
		expect(config.package_management).to_equal("external")
		expect(config.go_config.module_name).to_equal("example.com/configured")
		expect(config.go_config.version).to_equal("1.28.1")
		expect(config.go_config.root_package).to_equal("command")
	end

	test("applies the configured-project defaults") do
		config := gate4_parse_project_config(
			"{\"name\":\"minimal\",\"mode\":\"go\",\"go\":{\"module\":\"example.com/minimal\"}}",
		)
		expect(config.error).to_equal("")
		expect(config.version).to_equal("0.1.0")
		expect(config.source_dir).to_equal(".")
		expect(config.out_dir).to_equal("build")
		expect(config.copy_files).to_be_true()
		expect(config.package_management).to_equal("managed")
		expect(config.go_config.version).to_equal("1.27")
		expect(config.go_config.root_package).to_equal("main")
	end

	test("rejects ambiguous and unsupported configured-project input") do
		duplicate := gate4_parse_project_config(
			"{\"name\":\"first\",\"name\":\"second\",\"mode\":\"go\",\"go\":{\"module\":\"example.com/x\"}}",
		)
		expect(duplicate.error).to_equal("duplicate project configuration field name")

		trailing := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"go\",\"go\":{\"module\":\"example.com/x\",}}",
		)
		expect(trailing.error).to_equal("trailing comma in go configuration")

		unsupported := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"go\",\"packages\":{},\"go\":{\"module\":\"example.com/x\"}}",
		)
		expect(unsupported.error).to_equal("unsupported project configuration field packages")

		wrong_type := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"go\",\"copyFiles\":\"false\",\"go\":{\"module\":\"example.com/x\"}}",
		)
		expect(wrong_type.error).to_equal("expected JSON Boolean")
	end

	test("validates configured-project modes, versions, and paths") do
		wrong_mode := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"ruby\",\"go\":{\"module\":\"example.com/x\"}}",
		)
		expect(wrong_mode.error).to_equal("mode must be go for configured Native builds")

		missing_module := gate4_parse_project_config("{\"name\":\"x\",\"mode\":\"go\",\"go\":{}}")
		expect(missing_module.error).to_equal("go.module is required for mode go")

		old_go := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"go\",\"go\":{\"module\":\"example.com/x\",\"version\":\"1.26.9\"}}",
		)
		expect(old_go.error).to_equal("go.version must be 1.27 or later")

		overflowing_go := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"go\",\"go\":{\"module\":\"example.com/x\",\"version\":\"999999999999999999999999999.27\"}}",
		)
		expect(overflowing_go.error).to_equal("go.version must be 1.27 or later")

		absolute := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"go\",\"sourceDir\":\"/tmp/src\",\"go\":{\"module\":\"example.com/x\"}}",
		)
		expect(absolute.error).to_equal("sourceDir must be relative to the project root")

		escaping := gate4_parse_project_config(
			"{\"name\":\"x\",\"mode\":\"go\",\"outDir\":\"build/../../outside\",\"go\":{\"module\":\"example.com/x\"}}",
		)
		expect(escaping.error).to_equal("outDir cannot escape the project root")
	end

	test("loads every configured project module and selects its unique main") do
		mut state := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/lib/value/index.trb",
					"/project/src/unrelated.trb",
					"/project/src/application.trb",
				],
				sources: [
					"def configured_value(): Integer\n\treturn 42\nend\n",
					"def unrelated_value(): Integer\n\treturn 99\nend\n",
					"import { configured_value } from lib/value\n\ndef main()\n\tvalue := configured_value()\n\treturn\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_has_diagnostic(state)).to_be_false()
		expect(state.module_count[0]).to_equal(3)
		expect(gate4_load_string(state.module_names, 0)).to_equal("application")
		expect(gate4_load_string(state.module_names, 1)).to_equal("lib/value/index")
		expect(gate4_load_string(state.module_names, state.entry_module[0])).to_equal("application")
		indexed := gate4_find_module(state, "lib/value/index")
		expect(indexed >= 0).to_be_true()
		expect(gate4_load_integer(state.import_targets, 0)).to_equal(indexed)
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()

		mut forward := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/application.trb",
					"/project/src/middle.trb",
					"/project/src/value.trb",
				],
				sources: [
					"import { middle } from middle\n\ndef main()\n\tmiddle()\n\treturn\nend\n",
					"import { value } from value\n\ndef middle(): Integer\n\treturn value()\nend\n",
					"def value(): Integer\n\treturn 1\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_has_diagnostic(forward)).to_be_false()
		expect(gate4_resolve(forward)).to_be_true()
		expect(gate4_check(forward)).to_be_true()
	end

	test("orders configured modules like file-root discovery") do
		mut configured := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/m0000.trb",
					"/project/src/m0001.trb",
					"/project/src/main.trb",
				],
				sources: [
					"def f0000(): Integer\n\treturn 1\nend\n",
					"import { f0000 } from m0000\n\ndef f0001(): Integer\n\treturn f0000() + 1\nend\n",
					"import { f0001 } from m0001\n\ndef main()\n\tvalue := f0001()\n\treturn\nend\n",
				],
				error: "",
			),
		)
		mut file_order := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/main.trb",
					"/project/src/m0001.trb",
					"/project/src/m0000.trb",
				],
				sources: [
					"import { f0001 } from m0001\n\ndef main()\n\tvalue := f0001()\n\treturn\nend\n",
					"import { f0000 } from m0000\n\ndef f0001(): Integer\n\treturn f0000() + 1\nend\n",
					"def f0000(): Integer\n\treturn 1\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_load_string(configured.module_names, 0)).to_equal("main")
		expect(gate4_load_string(configured.module_names, 1)).to_equal("m0001")
		expect(gate4_load_string(configured.module_names, 2)).to_equal("m0000")
		expect(gate4_resolve(configured)).to_be_true()
		expect(gate4_check(configured)).to_be_true()
		expect(gate4_resolve(file_order)).to_be_true()
		expect(gate4_check(file_order)).to_be_true()
		expect(gate4_output_source(gate4_emit_qbe(configured))).to_equal(
			gate4_output_source(gate4_emit_qbe(file_order)),
		)
	end

	test("resolves exact aliases and unique record roots with canonical identities") do
		mut state := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/shared/ui/data_table/index.trb",
					"/project/src/main.trb",
					"/project/src/services/secure_random.trb",
					"/project/src/services/http.trb",
				],
				sources: [
					"record DataTable\n\trows: Integer\nend\n",
					"import { Response as WebResponse, status_code as read_status } from services/http\nimport services/secure_random as Random\nimport shared/ui/data_table\n\ndef main()\n\tresponse := WebResponse.new(status: read_status())\n\trandom := Random.new(value: response.status)\n\ttable := DataTable.new(rows: random.value)\n\treturn\nend\n",
					"record SecureRandom\n\tvalue: Integer\nend\n",
					"record Response\n\tstatus: Integer\nend\n\ndef status_code(): Integer\n\treturn 42\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_has_diagnostic(state)).to_be_false()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		expect(gate4_load_string(state.import_declarations, 0)).to_equal("Response")
		expect(gate4_load_string(state.import_symbols, 0)).to_equal("WebResponse")
		expect(gate4_load_string(state.import_declarations, 1)).to_equal("status_code")
		expect(gate4_load_string(state.import_symbols, 1)).to_equal("read_status")
		expect(gate4_load_string(state.import_declarations, 2)).to_equal("SecureRandom")
		expect(gate4_load_string(state.import_symbols, 2)).to_equal("Random")
		expect(gate4_load_string(state.import_declarations, 3)).to_equal("DataTable")
		expect(gate4_load_string(state.import_symbols, 3)).to_equal("DataTable")
		data_table_target := gate4_load_integer(state.import_targets, 3)
		expect(gate4_load_string(state.module_names, data_table_target)).to_equal(
			"shared/ui/data_table/index",
		)
	end

	test("rejects invalid declaration-root imports deterministically") do
		zero_match := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/main.trb", "/project/src/value.trb"],
				sources: [
					"import value\n\ndef main()\n\treturn\nend\n",
					"record Other\n\tnumber: Integer\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_resolve(zero_match)).to_be_false()
		expect(gate4_load_string(zero_match.diagnostic_messages, 0)).to_equal(
			"import value has no record root declaration matching value",
		)

		ambiguous := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/main.trb", "/project/src/json.trb"],
				sources: [
					"import json\n\ndef main()\n\treturn\nend\n",
					"record JSON\n\tvalue: Integer\nend\n\nrecord Json\n\tvalue: Integer\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_resolve(ambiguous)).to_be_false()
		expect(gate4_load_string(ambiguous.diagnostic_messages, 0)).to_equal(
			"import json has multiple record root declarations matching json: JSON, Json; use an exact named import",
		)

		bare_function := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/main.trb", "/project/src/worker.trb"],
				sources: [
					"import worker\n\ndef main()\n\treturn\nend\n",
					"def worker(): Integer\n\treturn 1\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_resolve(bare_function)).to_be_false()
		expect(gate4_load_string(bare_function.diagnostic_messages, 0)).to_equal(
			"import worker matches only a top-level function; use an exact named import",
		)

		unused_alias := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/main.trb", "/project/src/value.trb"],
				sources: [
					"import value as Renamed\n\ndef main()\n\treturn\nend\n",
					"record Value\n\tnumber: Integer\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_resolve(unused_alias)).to_be_true()
		expect(gate4_check(unused_alias)).to_be_false()
		expect(gate4_load_string(unused_alias.diagnostic_messages, 0)).to_equal(
			"unused import Renamed",
		)

		duplicate_identity := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/main.trb", "/project/src/value.trb"],
				sources: [
					"import { Value as First, Value as Second } from value\n\ndef main()\n\treturn\nend\n",
					"record Value\n\tnumber: Integer\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_resolve(duplicate_identity)).to_be_false()
		expect(gate4_load_string(duplicate_identity.diagnostic_messages, 0)).to_equal(
			"declaration Value from value is already imported as First",
		)

		equivalent_index_identity := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/main.trb",
					"/project/src/shared/data_table/index.trb",
				],
				sources: [
					"import { DataTable as First } from shared/data_table\nimport { DataTable as Second } from shared/data_table/index\n\ndef main()\n\treturn\nend\n",
					"record DataTable\n\trows: Integer\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_resolve(equivalent_index_identity)).to_be_false()
		expect(gate4_load_string(equivalent_index_identity.diagnostic_messages, 0)).to_equal(
			"declaration DataTable from shared/data_table/index is already imported as First",
		)

		binding_collision := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/main.trb",
					"/project/src/first.trb",
					"/project/src/second.trb",
				],
				sources: [
					"import { First as Shared } from first\nimport { Second as Shared } from second\n\ndef main()\n\treturn\nend\n",
					"record First\n\tnumber: Integer\nend\n",
					"record Second\n\tnumber: Integer\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_resolve(binding_collision)).to_be_false()
		expect(gate4_load_string(binding_collision.diagnostic_messages, 0)).to_equal(
			"duplicate import binding Shared",
		)
	end

	test("rejects invalid configured project bundles before checking") do
		empty := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(paths: [], sources: [], error: ""),
		)
		expect(gate4_load_string(empty.diagnostic_messages, 0)).to_equal("no production .trb files found")

		mismatched := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(paths: ["/project/src/main.trb"], sources: [], error: ""),
		)
		expect(gate4_load_string(mismatched.diagnostic_messages, 0)).to_equal(
			"project source adapter returned mismatched paths and sources",
		)

		outside := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/outside.trb"],
				sources: ["def main()\n\treturn\nend\n"],
				error: "",
			),
		)
		expect(gate4_load_string(outside.diagnostic_messages, 0)).to_equal(
			"project source is outside configured sourceDir",
		)

		conflicting_roots := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: [
					"/project/src/main.trb",
					"/project/src/lib/value.trb",
					"/project/src/lib/value/index.trb",
				],
				sources: [
					"import { Value } from lib/value\n\ndef main()\n\tvalue := Value.new(number: 1)\n\treturn\nend\n",
					"record Value\n\tnumber: Integer\nend\n",
					"record ValueIndex\n\tnumber: Integer\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_load_string(conflicting_roots.diagnostic_messages, 0)).to_equal(
			"module paths lib/value/index and lib/value define the same import root",
		)
	end

	test("checks unimported configured sources and unique entrypoints") do
		invalid := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/application.trb", "/project/src/unrelated.trb"],
				sources: ["def main()\n\treturn\nend\n", "def unfinished(\n"],
				error: "",
			),
		)
		expect(gate4_has_diagnostic(invalid)).to_be_true()
		expect(gate4_load_string(invalid.module_files, 1)).to_equal("/project/src/unrelated.trb")

		missing := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/library.trb"],
				sources: ["def value(): Integer\n\treturn 1\nend\n"],
				error: "",
			),
		)
		expect(gate4_load_string(missing.diagnostic_messages, 0)).to_equal(
			"project must declare exactly one top-level main function",
		)

		duplicate := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/first.trb", "/project/src/second.trb"],
				sources: ["def main()\n\treturn\nend\n", "def main()\n\treturn\nend\n"],
				error: "",
			),
		)
		expect(gate4_load_string(duplicate.diagnostic_messages, 0)).to_equal(
			"project has more than one top-level main function",
		)
	end

	test("rejects configured project missing imports and cycles") do
		missing := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/application.trb"],
				sources: ["import { value } from missing\n\ndef main()\n\treturn\nend\n"],
				error: "",
			),
		)
		expect(gate4_load_string(missing.diagnostic_messages, 0)).to_equal(
			"cannot resolve project import missing",
		)

		cycle := gate4_load_project_sources(
			"/project/trbconfig.jsonc",
			"/project/src",
			Gate4ProjectSources.new(
				paths: ["/project/src/application.trb", "/project/src/library.trb"],
				sources: [
					"import { value } from library\n\ndef main()\n\treturn\nend\n",
					"import { main } from application\n\ndef value(): Integer\n\treturn 1\nend\n",
				],
				error: "",
			),
		)
		expect(gate4_load_string(cycle.diagnostic_messages, 0)).to_equal(
			"import cycle through library",
		)
	end

	test("grows chunked storage only as elements are stored") do
		empty := gate4_integer_storage(0)
		expect(empty.chunks[0].size()).to_equal(0)
		expect(empty.used[0]).to_equal(0)
		expect(gate4_store_integer(empty, 0, 1)).to_be_false()

		integers := gate4_integer_storage(513)
		expect(integers.chunks[0].size()).to_equal(0)
		expect(gate4_store_integer(integers, 0, 10)).to_be_true()
		expect(gate4_store_integer(integers, 255, 20)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(1)
		expect(integers.chunks[0][0].size()).to_equal(256)
		expect(gate4_store_integer(integers, 256, 30)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(2)
		expect(gate4_store_integer(integers, 512, 40)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(3)
		expect(integers.chunks[0][1].size()).to_equal(256)
		expect(integers.chunks[0][2].size()).to_equal(256)
		expect(integers.used[0]).to_equal(513)
		expect(gate4_load_integer(integers, 0)).to_equal(10)
		expect(gate4_load_integer(integers, 255)).to_equal(20)
		expect(gate4_load_integer(integers, 256)).to_equal(30)
		expect(gate4_load_integer(integers, 512)).to_equal(40)
		expect(gate4_store_integer(integers, - 1, 50)).to_be_false()
		expect(gate4_store_integer(integers, 513, 50)).to_be_false()
		expect(integers.used[0]).to_equal(513)

		strings := gate4_string_storage(257)
		expect(gate4_store_string(strings, 0, "first")).to_be_true()
		expect(gate4_store_string(strings, 256, "last")).to_be_true()
		expect(gate4_load_string(strings, 0)).to_equal("first")
		expect(gate4_load_string(strings, 256)).to_equal("last")
		expect(gate4_store_string(strings, 257, "outside")).to_be_false()
	end

	test("returns the last matching symbol without changing missing lookup") do
		expect(gate4_character_in("a", "abc")).to_be_true()
		expect(gate4_character_in("c", "abc")).to_be_true()
		expect(gate4_character_in("z", "abc")).to_be_false()

		mut state := gate4_compiler_new(128)
		gate4_add_module(state, "shared", "/first.trb")
		gate4_add_module(state, "other", "/other.trb")
		gate4_add_module(state, "shared", "/last.trb")
		expect(gate4_find_module(state, "shared")).to_equal(2)
		expect(gate4_find_module(state, "missing")).to_equal(- 1)

		gate4_store_string(state.function_names, 0, "value")
		gate4_store_integer(state.function_modules, 0, 0)
		gate4_store_string(state.function_names, 1, "value")
		gate4_store_integer(state.function_modules, 1, 1)
		gate4_store_string(state.function_names, 2, "value")
		gate4_store_integer(state.function_modules, 2, 0)
		gate4_store_string(state.function_names, 3, "other")
		gate4_store_integer(state.function_modules, 3, 0)
		state.function_count[0] = 4
		gate4_store_string(state.record_names, 0, "Value")
		gate4_store_integer(state.record_modules, 0, 0)
		gate4_store_string(state.record_names, 1, "Value")
		gate4_store_integer(state.record_modules, 1, 1)
		gate4_store_string(state.record_names, 2, "Value")
		gate4_store_integer(state.record_modules, 2, 0)
		gate4_store_string(state.record_names, 3, "Other")
		gate4_store_integer(state.record_modules, 3, 0)
		state.record_count[0] = 4
		expect(gate4_find_record_type(state, "Record#2")).to_equal(2)
		expect(gate4_find_record_type(state, "Record#4")).to_equal(- 1)

		gate4_store_string(state.import_symbols, 0, "load")
		gate4_store_integer(state.import_modules, 0, 0)
		gate4_store_string(state.import_symbols, 1, "load")
		gate4_store_integer(state.import_modules, 1, 0)
		gate4_store_string(state.import_symbols, 2, "save")
		gate4_store_integer(state.import_modules, 2, 0)
		gate4_store_string(state.import_symbols, 3, "load")
		gate4_store_integer(state.import_modules, 3, 1)
		state.import_count[0] = 4
		gate4_store_integer(state.module_import_starts, 0, 0)
		gate4_store_integer(state.module_import_counts, 0, 3)
		gate4_store_integer(state.module_import_starts, 1, 3)
		gate4_store_integer(state.module_import_counts, 1, 1)
		expect(gate4_symbol_bucket_count(0)).to_equal(0)
		expect(gate4_symbol_bucket_count(8)).to_equal(16)
		expect(gate4_symbol_bucket_count(9)).to_equal(32)
		expect(gate4_symbol_bucket_count(65)).to_equal(256)
		gate4_build_symbol_index(state.function_lookup, state.function_modules, state.function_names, state.function_count[0])
		expect(gate4_find_function_in_module(state, 0, "value")).to_equal(2)
		expect(gate4_find_function_in_module(state, 0, "other")).to_equal(3)
		expect(gate4_find_function_in_module(state, 1, "value")).to_equal(1)
		expect(gate4_find_function_in_module(state, 0, "missing")).to_equal(- 1)
		expect(gate4_find_record_in_module(state, 0, "Value")).to_equal(2)
		expect(gate4_find_record_in_module(state, 0, "Other")).to_equal(3)
		expect(gate4_find_record_in_module(state, 0, "Missing")).to_equal(- 1)
		expect(gate4_find_import_binding(state, 0, "load")).to_equal(1)
		expect(gate4_find_import_binding(state, 0, "save")).to_equal(2)
		expect(gate4_find_import_binding(state, 1, "load")).to_equal(3)
		expect(gate4_find_import_binding(state, 0, "missing")).to_equal(- 1)

		gate4_store_integer(state.record_field_starts, 0, 0)
		gate4_store_integer(state.record_field_counts, 0, 3)
		gate4_store_string(state.field_names, 0, "item")
		gate4_store_string(state.field_names, 1, "other")
		gate4_store_string(state.field_names, 2, "item")
		expect(gate4_find_field(state, 0, "item")).to_equal(2)
		expect(gate4_find_field(state, 0, "missing")).to_equal(- 1)

		mut locals := gate4_locals_new(4)
		gate4_store_string(locals.names, 0, "item")
		gate4_store_string(locals.names, 1, "other")
		gate4_store_string(locals.names, 2, "item")
		locals.count[0] = 3
		expect(gate4_local_find(locals, "item")).to_equal(2)
		expect(gate4_local_find(locals, "missing")).to_equal(- 1)

	end

	test("indexes colliding fixed-width module names across deterministic growth") do
		expect(gate4_string_bucket("aa", 16)).to_equal(gate4_string_bucket("aq", 16))
		mut state := gate4_compiler_new(128)
		expect(gate4_find_module(state, "missing")).to_equal(- 1)
		gate4_add_module(state, "aa", "/first-aa.trb")
		gate4_add_module(state, "aq", "/aq.trb")
		gate4_add_module(state, "aa", "/last-aa.trb")
		expect(state.module_lookup.heads.used[0]).to_equal(16)
		expect(gate4_find_module(state, "aa")).to_equal(2)
		expect(gate4_find_module(state, "aq")).to_equal(1)
		additional := ["ba", "bb", "bc", "bd", "be", "bf"]
		mut index := 0
		while index < additional.size()
			gate4_add_module(state, additional[index], "/" + additional[index] + ".trb")
			index += 1
		end
		expect(state.module_count[0]).to_equal(9)
		expect(state.module_lookup.heads.used[0]).to_equal(32)
		index = 0
		while index < additional.size()
			expect(gate4_find_module(state, additional[index])).to_equal(index + 3)
			index += 1
		end
		expect(gate4_find_module(state, "missing")).to_equal(- 1)
	end

	test("preserves ASCII identifier and digit classification after hot-path ordering") do
		identifier_start := "fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_"
		identifier_continue := "0123456789" + identifier_start
		expect(gate4_character_in("a", identifier_start)).to_be_true()
		expect(gate4_character_in("Z", identifier_start)).to_be_true()
		expect(gate4_character_in("_", identifier_start)).to_be_true()
		expect(gate4_character_in("0", identifier_start)).to_be_false()
		expect(gate4_character_in("-", identifier_start)).to_be_false()
		expect(gate4_character_in("a", identifier_continue)).to_be_true()
		expect(gate4_character_in("Z", identifier_continue)).to_be_true()
		expect(gate4_character_in("_", identifier_continue)).to_be_true()
		expect(gate4_character_in("0", identifier_continue)).to_be_true()
		expect(gate4_character_in("-", identifier_continue)).to_be_false()
		expect(gate4_character_in("0", "0123456789")).to_be_true()
		expect(gate4_character_in("9", "0123456789")).to_be_true()
		expect(gate4_character_in("a", "0123456789")).to_be_false()
	end

	test("classifies decimal literals and enforces the finite binary64 boundary") do
		expect(gate4_number_is_float("1")).to_be_false()
		expect(gate4_number_is_float("1.0")).to_be_true()
		expect(gate4_number_without_underscores("1_0.5_0")).to_equal("10.50")
		expect(gate4_float_literal_in_range("1_0.5_0")).to_be_true()
		expect(
			gate4_float_literal_in_range(
				".0",
			),
		).to_be_true()
		expect(
			gate4_float_literal_in_range(
				".0",
			),
		).to_be_false()
		expect(
			gate4_float_literal_in_range(
				".0",
			),
		).to_be_false()
	end

	test("checks a generated declaration-chain scale probe") do
		source := gate4_scale_test_source(128)
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		expect(state.function_count[0]).to_equal(129)
		expect(gate4_output_source(gate4_emit_qbe(state)).include?("function l $g4f127")).to_be_true()
	end

	test("lexes and parses the registered declaration and expression subset") do
		source := gate4_frontend_test_source()
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_has_diagnostic(state)).to_be_false()
		expect(state.record_count[0]).to_equal(1)
		expect(gate4_load_string(state.record_names, 0)).to_equal("Pair")
		expect(state.field_count[0]).to_equal(2)
		expect(gate4_load_string(state.field_names, 0)).to_equal("left")
		expect(gate4_load_string(state.field_names, 1)).to_equal("right")
		expect(state.function_count[0]).to_equal(2)
		expect(gate4_load_string(state.function_names, 0)).to_equal("add")
		expect(gate4_load_string(state.function_names, 1)).to_equal("main")
		expect(gate4_load_string(state.function_result_types, 0)).to_equal("Integer")
		expect(gate4_load_string(state.function_result_types, 1)).to_equal("Void")
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
	end

	test("keeps declarations and named imports scoped to their source modules") do
		mut state := gate4_compiler_new(16384)
		gate4_add_module(state, "main", "/project/main.trb")
		gate4_add_module(state, "alpha", "/project/alpha.trb")
		gate4_add_module(state, "beta", "/project/beta.trb")
		state.entry_module[0] = 0
		sources := [
			"import { left } from alpha\nimport { right } from beta\n\ndef main()\n\tif left() + right() == 42\n\t\tputs(\"modules-ok\")\n\tend\n\treturn\nend\n",
			"record Value\n\tnumber: Integer\nend\n\ndef normalize(value: Integer): Integer\n\treturn value\nend\n\ndef left(): Integer\n\tvalue := Value.new(number: 20)\n\treturn normalize(value.number)\nend\n",
			"record Value\n\tnumber: Integer\nend\n\ndef normalize(value: Integer): Integer\n\treturn value\nend\n\ndef right(): Integer\n\tvalue := Value.new(number: 22)\n\treturn normalize(value.number)\nend\n",
		]
		mut module_index := 0
		while module_index < sources.size()
			start := state.token_count[0]
			expect(gate4_lex_module(state, sources[module_index], module_index)).to_be_true()
			expect(gate4_parse_module(state, start, module_index)).to_be_true()
			module_index += 1
		end
		expect(gate4_load_integer(state.module_import_starts, 0)).to_equal(0)
		expect(gate4_load_integer(state.module_import_counts, 0)).to_equal(2)
		expect(gate4_load_integer(state.module_import_starts, 1)).to_equal(2)
		expect(gate4_load_integer(state.module_import_counts, 1)).to_equal(0)
		expect(gate4_load_integer(state.module_import_starts, 2)).to_equal(2)
		expect(gate4_load_integer(state.module_import_counts, 2)).to_equal(0)
		mut import_index := 0
		while import_index < state.import_count[0]
			path := gate4_load_string(state.import_paths, import_index)
			if path == "alpha"
				gate4_store_integer(state.import_targets, import_index, 1)
			else
				gate4_store_integer(state.import_targets, import_index, 2)
			end
			import_index += 1
		end
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		expect(state.record_count[0]).to_equal(2)
		expect(state.function_count[0]).to_equal(5)
		first := gate4_output_source(gate4_emit_qbe(state))
		second := gate4_output_source(gate4_emit_qbe(state))
		expect(first).to_equal(second)
	end

	test("rejects an unsupported source character deterministically") do
		source := "def main()\n\t@\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_false()
		expect(state.diagnostic_count[0]).to_equal(1)
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4001")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("unsupported source character @")
	end

	test("rejects an unfinished function deterministically") do
		source := "def main()\n\tputs(\"missing\")\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4002")
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("expected end")
	end

	test("parses the checked-in compiler closure through its own frontend") do
		root := Process.environment("TYPE_RB_NATIVE_ROOT")
		if root == nil
			expect(true).to_be_true()
		else
			base := root + "/compiler/gate4/src/"
			sources := [
				gate4_required_test_source(base + "compiler.trb"),
				gate4_required_test_source(base + "storage.trb"),
				gate4_required_test_source(base + "path.trb"),
			]
			expect(!sources[0].empty?()).to_be_true()
			expect(!sources[1].empty?()).to_be_true()
			expect(!sources[2].empty?()).to_be_true()
			mut state := gate4_compiler_new(sources[0].size() + sources[1].size() + sources[2].size() + 3)
			gate4_add_module(state, "compiler", base + "compiler.trb")
			gate4_add_module(state, "storage", base + "storage.trb")
			gate4_add_module(state, "path", base + "path.trb")
			state.entry_module[0] = 0
			mut module_index := 0
			while module_index < sources.size()
				start := state.token_count[0]
				expect(gate4_lex_module(state, sources[module_index], module_index)).to_be_true()
				expect(gate4_parse_module(state, start, module_index)).to_be_true()
				module_index += 1
			end
			mut import_index := 0
			while import_index < state.import_count[0]
				if gate4_load_string(state.import_paths, import_index) == "storage"
					gate4_store_integer(state.import_targets, import_index, 1)
				else
					gate4_store_integer(state.import_targets, import_index, 2)
				end
				import_index += 1
			end
			expect(gate4_find_record_in_module(state, 0, "Gate4Compiler") >= 0).to_be_true()
			expect(state.record_count[0] > 5).to_be_true()
			expect(state.function_count[0] > 20).to_be_true()
			if !gate4_resolve(state)
				puts(
					gate4_load_string(state.diagnostic_codes, 0) + ":" + gate4_load_integer(state.diagnostic_lines, 0).to_s() + ":" +
					gate4_load_string(state.diagnostic_messages, 0),
				)
			end
			expect(gate4_has_diagnostic(state)).to_be_false()
			if !gate4_check(state)
				puts(
					gate4_load_string(state.diagnostic_codes, 0) + ":" + gate4_load_integer(state.diagnostic_lines, 0).to_s() + ":" +
					gate4_load_string(state.diagnostic_messages, 0),
				)
			end
			expect(gate4_has_diagnostic(state)).to_be_false()
		end
	end

	test("rejects duplicate declarations during resolution") do
		source := "def main()\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(5)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("duplicate function declaration main")
	end

	test("rejects an unresolved direct call during resolution") do
		source := "def main()\n\tmissing()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("unresolved function missing")
	end

	test("rejects a local initializer type mismatch during checking") do
		source := "def main()\n\tvalue: Integer := \"bad\"\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("expected Integer, found String")
	end

	test("enforces the portable Integer literal range during checking") do
		valid_source := "def main()\n\tvalue := 9007199254740991\n\treturn\nend\n"
		mut valid := gate4_compiler_new(valid_source.size() + 1)
		expect(gate4_lex(valid, valid_source)).to_be_true()
		expect(gate4_parse_module(valid, 0, valid.entry_module[0])).to_be_true()
		expect(gate4_resolve(valid)).to_be_true()
		expect(gate4_check(valid)).to_be_true()

		invalid_source := "def main()\n\tvalue := 9007199254740992\n\treturn\nend\n"
		mut invalid := gate4_compiler_new(invalid_source.size() + 1)
		expect(gate4_lex(invalid, invalid_source)).to_be_true()
		expect(gate4_parse_module(invalid, 0, invalid.entry_module[0])).to_be_true()
		expect(gate4_resolve(invalid)).to_be_true()
		expect(gate4_check(invalid)).to_be_false()
		expect(gate4_load_string(invalid.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(invalid.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(invalid.diagnostic_messages, 0)).to_equal(
			"Integer literal is outside the portable range",
		)
	end

	test("rejects direct-call arity mismatches during checking") do
		source := "def identity(value: Integer): Integer\n\treturn value\nend\n\ndef main()\n\tidentity()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(6)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("call argument count does not match identity")
	end

	test("rejects destructive calls through immutable bindings") do
		source := "def main()\n\tvalues: Array<Integer> := [1]\n\tvalues.push(2)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(3)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("push receiver is immutable")
	end

	test("checks and emits portable benchmark entry primitives") do
		source := "import trb/std/process\nimport trb/std/math as Numeric\n\ndef main()\n\tmut first := Process.argv()\n\tfirst.push(\"local\")\n\tsecond := Process.argv()\n\tparsed := second[0].to_i()\n\troot := Numeric.sqrt(parsed)\n\ttruncated := root.to_i()\n\tputs(first.size().to_s())\n\tputs(second.size().to_s())\n\tputs(truncated.to_s())\n\tnan := Numeric.sqrt(- 1)\n\tif nan != nan\n\t\tputs(\"nan\")\n\telse\n\t\tputs(\"number\")\n\tend\n\tputs(\"+9007199254740991\".to_i().to_s())\n\tputs(\"-9007199254740991\".to_i().to_s())\n\tvalue := - 2.75\n\tputs(value.to_i().to_s())\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		emitted := gate4_emit_qbe(state)
		expect(emitted.runtime_flags[1]).to_equal(1)
		expect(emitted.runtime_flags.size()).to_equal(2)
		qbe := gate4_output_source(emitted)
		expect(qbe.include?("storel %process_argc, $g4_process_argc")).to_be_true()
		expect(qbe.include?("function l $g4_process_argv()")).to_be_true()
		expect(qbe.include?("function l $g4_string_to_integer(l %string)")).to_be_true()
		expect(qbe.include?("function l $g4_integer_to_string(l %value)")).to_be_true()
		expect(qbe.include?("function l $g4_float_to_integer(d %value)")).to_be_true()
		expect(qbe.include?("=d call $sqrt(d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=l dtosi ")).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate6m-entry"
			case FileSystem.create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case FileSystem.write_text(workspace + "/module.ssa", qbe)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case FileSystem.write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(workspace + "/program", ["9"])
			when Result::Ok(result)
				expect(result.success).to_be_true()
				expect(result.stdout).to_equal("2\n1\n3\nnan\n9007199254740991\n-9007199254740991\n-2\n")
				expect(result.stderr).to_equal("")
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
		end
	end

	test("preserves portable numeric conversion failure classes") do
		source := "import trb/std/process\nimport trb/std/math\n\ndef main()\n\tmode := Process.argv()[0]\n\tif mode == \"invalid-format\"\n\t\tputs(\"12x\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"sign-only\"\n\t\tputs(\"+\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"integer-range\"\n\t\tputs(\"9007199254740992\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"nan\"\n\t\tputs(Math.sqrt(- 1).to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"infinity\"\n\t\tzero := 0.0\n\t\tinfinite := 1.0 / zero\n\t\tputs(infinite.to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"float-range\"\n\t\toutside := 9007199254740992.0\n\t\tputs(outside.to_i().to_s())\n\t\treturn\n\tend\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		checked := gate4_check(state)
		if !checked
			puts(gate4_load_integer(state.diagnostic_lines, 0).to_s() + ": " + gate4_load_string(state.diagnostic_messages, 0))
		end
		expect(checked).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate6m-failures"
			case FileSystem.create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case FileSystem.write_text(workspace + "/module.ssa", gate4_output_source(gate4_emit_qbe(state)))
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case FileSystem.write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			modes := ["invalid-format", "sign-only", "integer-range", "nan", "infinity", "float-range"]
			expected := ["panic: invalid Integer\n", "panic: invalid Integer\n", "panic: Integer is outside the portable range\n", "panic: Float cannot be converted to Integer\n", "panic: Float cannot be converted to Integer\n", "panic: Integer is outside the portable range\n"]
			mut index := 0
			while index < modes.size()
				case Process.run(workspace + "/program", [modes[index]])
				when Result::Ok(result)
					expect(result.success).to_be_false()
					expect(result.stdout).to_equal("")
					expect(result.stderr).to_equal(expected[index])
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
				index += 1
			end
		end
	end

	test("rejects unsupported benchmark entry boundaries deterministically") do
		unsupported_package := gate4_load_file_root(
			"import trb/std/random\n\ndef main()\n\treturn\nend\n",
			"/tmp/gate6m-unsupported-package.trb",
		)
		expect(gate4_load_string(unsupported_package.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(gate4_load_string(unsupported_package.diagnostic_messages, 0)).to_equal("package imports are not supported by this compiler subset")

		member_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.environment()\n\treturn\nend\n"
		mut member_state := gate4_compiler_new(member_source.size() + 1)
		expect(gate4_lex(member_state, member_source)).to_be_true()
		expect(gate4_parse_module(member_state, 0, member_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(member_state)).to_be_true()
		expect(gate4_check(member_state)).to_be_false()
		expect(gate4_load_string(member_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_string(member_state.diagnostic_messages, 0)).to_equal("unsupported standard package member")

		type_source := "import trb/std/math\n\ndef main()\n\tvalue := Math.sqrt(\"nine\")\n\treturn\nend\n"
		mut type_state := gate4_compiler_new(type_source.size() + 1)
		expect(gate4_lex(type_state, type_source)).to_be_true()
		expect(gate4_parse_module(type_state, 0, type_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(type_state)).to_be_true()
		expect(gate4_check(type_state)).to_be_false()
		expect(gate4_load_string(type_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_string(type_state.diagnostic_messages, 0)).to_equal("expected Float, found String")

		arity_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.argv(1)\n\treturn\nend\n"
		mut arity_state := gate4_compiler_new(arity_source.size() + 1)
		expect(gate4_lex(arity_state, arity_source)).to_be_true()
		expect(gate4_parse_module(arity_state, 0, arity_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(arity_state)).to_be_true()
		expect(gate4_check(arity_state)).to_be_false()
		expect(gate4_load_string(arity_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_string(arity_state.diagnostic_messages, 0)).to_equal("call argument count does not match Process")
	end

	test("emits direct binary64 cells for Float Arrays") do
		source := "record Floats\n\tvalues: Array<Float>\nend\n\ndef carry(values: Array<Float>): Array<Float>\n\treturn values\nend\n\ndef main()\n\tmut values := [1, 2.5]\n\tvalues.push(3)\n\tvalues[0] += 0.5\n\tbox := Floats.new(values: values)\n\tresult := carry(box.values)\n\tvalue := result[- 1]\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("function $g4_array_push_paced(l %array, l %value)")).to_be_true()
		expect(qbe.include?("function $g4_array_push_d(l %array, d %value)")).to_be_true()
		expect(qbe.include?("call $g4_gc_maybe_collect(l %growth)")).to_be_true()
		expect(qbe.include?("call $g4_array_preflight(l ")).to_be_false()
		expect(qbe.include?("call $g4_array_push_d(l ")).to_be_true()
		expect(qbe.include?(", d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=d loadd ")).to_be_true()
		expect(qbe.include?("stored ")).to_be_true()
		expect(qbe.include?("$g4_array_push_d(l %array, l %value)")).to_be_false()
		expect(qbe.include?("\tcall $g4_array_push(l %array, l 0)")).to_be_false()
	end

	test("emits exact logical root segments and one managed-return epilogue") do
		source := "record Bundle\n\tlabel: String\n\tlabels: Array<String>\nend\n\ndef select(mut bundle: Bundle, mut current: String): String\n\twhile current != \"done\"\n\t\tcurrent = bundle.label\n\t\tbundle = Bundle.new(label: \"done\", labels: bundle.labels)\n\t\treturn bundle.labels[0]\n\tend\n\treturn current\nend\n\ndef grow(mut current: String): String\n\tmut index := 0\n\twhile index < 2\n\t\tcurrent += \"x\"\n\t\tindex += 1\n\tend\n\treturn current\nend\n\ndef main()\n\tmut labels: Array<String> := []\n\tlabels.push(\"kept\")\n\tbundle := Bundle.new(label: \"next\", labels: labels)\n\tresult := grow(select(bundle, \"start\"))\n\tputs(result)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("\t%temporary_roots =l loadl $g4_gc_temp_count")).to_be_true()
		expect(qbe.include?("\tcall $g4_gc_temp_reset(l %temporary_roots)")).to_be_true()
		expect(qbe.include?("\tcall $g4_gc_temp_push(l %t")).to_be_true()
		expect(
			qbe.include?(
				"\tcall $g4_gc_temp_reset(l %temporary_roots)\n\t%return_result =l loadl %return_value\n\tcall $g4_gc_temp_push(l %return_result)\n\tret %return_result\n",
			),
		).to_be_true()
		expect(qbe.include?("$g4_gc_roots")).to_be_false()
		expect(qbe.include?("$g4_gc_frame_enter")).to_be_false()
		expect(qbe.include?("$g4_gc_frame_leave")).to_be_false()
	end

	test("emits deterministic QBE and executes the registered source subset") do
		source := gate4_frontend_test_source()
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		first := gate4_output_source(gate4_emit_qbe(state))
		second := gate4_output_source(gate4_emit_qbe(state))
		expect(first).to_equal(second)
		expect(first.include?("function l $g4f0(l %p0, l %p1) {")).to_be_true()
		expect(first.include?("export function w $main(w %argc, l %argv) {")).to_be_true()
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate4-emitter"
			case FileSystem.create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case FileSystem.write_text(workspace + "/module.ssa", first)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case FileSystem.write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(workspace + "/program", [])
			when Result::Ok(result)
				expect(result.success).to_be_true()
				expect(result.stdout).to_equal("ok\n")
				expect(result.stderr).to_equal("")
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
		end
	end
end
