		expect(gate4_parse_module(nested_reassigned, 0, nested_reassigned.entry_module[0])).to_be_true()
		expect(gate4_resolve(nested_reassigned)).to_be_true()
		expect(gate4_check(nested_reassigned)).to_be_true()
		nested_reassigned_qbe := gate4_output_source(gate4_emit_qbe(nested_reassigned))
		expect(gate4_occurrence_count(nested_reassigned_qbe, " =l sar ")).to_equal(1)

		nested_non_unit_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tmut pass := 0\n\t\twhile pass < 1\n\t\t\tvalue := values[index]\n\t\t\tindex += 2\n\t\t\tpass += 1\n\t\tend\n\tend\n\treturn\nend\n"
		mut nested_non_unit := gate4_compiler_new(nested_non_unit_source.size() + 1)
		expect(gate4_lex(nested_non_unit, nested_non_unit_source)).to_be_true()
		expect(gate4_parse_module(nested_non_unit, 0, nested_non_unit.entry_module[0])).to_be_true()
		expect(gate4_resolve(nested_non_unit)).to_be_true()
		expect(gate4_check(nested_non_unit)).to_be_true()
		nested_non_unit_qbe := gate4_output_source(gate4_emit_qbe(nested_non_unit))
		expect(gate4_occurrence_count(nested_non_unit_qbe, " =l sar ")).to_equal(1)

		shadowed_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tif true\n\t\t\tmut index := 0\n\t\t\tvalue := values[index]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut shadowed := gate4_compiler_new(shadowed_source.size() + 1)
		expect(gate4_lex(shadowed, shadowed_source)).to_be_true()
		expect(gate4_parse_module(shadowed, 0, shadowed.entry_module[0])).to_be_true()
		expect(gate4_resolve(shadowed)).to_be_true()
		expect(gate4_check(shadowed)).to_be_false()
		expect(gate4_load_string(shadowed.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(gate4_load_string(shadowed.diagnostic_messages, 0)).to_equal("duplicate local declaration index")

		function_scoped_source := "def first(values: Array<Integer>)\n\tmut index := 0\n\twhile index < values.size()\n\t\tvalue := values[index]\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef unrelated()\n\tmut index := 0\n\tindex =- 1\n\treturn\nend\n\ndef main()\n\tfirst([10, 20])\n\treturn\nend\n"
		mut function_scoped := gate4_compiler_new(function_scoped_source.size() + 1)
		expect(gate4_lex(function_scoped, function_scoped_source)).to_be_true()
		expect(gate4_parse_module(function_scoped, 0, function_scoped.entry_module[0])).to_be_true()
		expect(gate4_resolve(function_scoped)).to_be_true()
		expect(gate4_check(function_scoped)).to_be_true()
		function_scoped_qbe := gate4_output_source(gate4_emit_qbe(function_scoped))
		expect(gate4_occurrence_count(function_scoped_qbe, " =l sar ")).to_equal(0)
	end

	test("falls back to shared Array addressing after the loop budget") do
		mut source := "def main()\n\tvalues := [1]\n\tmut index := 0\n\tmut value := 0\n\twhile index < 1\n"
		mut access_count := 0
		while access_count < 65
			source += "\t\tvalue = values[index]\n"
			access_count += 1
		end
		source += "\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(gate4_occurrence_count(qbe, "call $g4_array_address")).to_equal(1)
		expect(gate4_occurrence_count(qbe, "function l $g4_array_address")).to_equal(1)
		expect(gate4_occurrence_count(qbe, "call $g4_fail(l $g4_bounds_error")).to_equal(3)
	end

