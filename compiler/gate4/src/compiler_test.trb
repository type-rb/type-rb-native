import {
	Gate4Compiler,
	Gate4Output,
	gate4_add_module,
	gate4_build_function_index,
	gate4_character_in,
	gate4_check,
	gate4_compiler_new,
	gate4_emit_context_new,
	gate4_emit_local_find,
	gate4_emit_qbe,
	gate4_digit,
	gate4_float_literal_in_range,
	gate4_find_field,
	gate4_find_function_in_module,
	gate4_find_import_binding,
	gate4_find_module,
	gate4_find_record_in_module,
	gate4_find_record_type,
	gate4_has_diagnostic,
	gate4_identifier_continue,
	gate4_identifier_start,
	gate4_lex,
	gate4_lex_module,
	gate4_local_find,
	gate4_locals_new,
	gate4_number_is_float,
	gate4_number_without_underscores,
	gate4_parse,
	gate4_parse_module,
	gate4_resolve,
	gate4_string_bucket,
	gate4_symbol_bucket_count,
} from compiler
import {
	gate4_integer_storage,
	gate4_load_integer,
	gate4_load_string,
	gate4_store_integer,
	gate4_store_string,
	gate4_string_storage,
} from storage
import { create_directory, read_text, write_text } from trb/std/filesystem
import { environment, run } from trb/std/process
import { Result } from trb/std/result
import trb/std/string_builder
import { describe, expect, test } from trb/std/test

def gate4_frontend_test_source(): String
	return "record Pair\n\tleft: Integer\n\tright: Integer\nend\n\ndef add(left: Integer, right: Integer): Integer\n\treturn left + right\nend\n\ndef main()\n\tpair := Pair.new(left: 20, right: 22)\n\tmut values: Array<Integer> := []\n\tvalues.push(add(pair.left, pair.right))\n\tmessage := \"o\" + \"k\"\n\tif values[0] == 42\n\t\tif message != \"bad\"\n\t\t\tputs(message)\n\t\telse\n\t\t\tputs(\"bad\")\n\t\tend\n\telse\n\t\tputs(\"bad\")\n\tend\n\treturn\nend\n"
end

def gate4_output_source(output: Gate4Output): String
	mut writer := string_builder.new()
	mut index := 0
	while index < output.count[0]
		writer.append(gate4_load_string(output.lines, index))
		writer.append("\n")
		index += 1
	end
	return writer.to_s()
end

def gate4_required_test_source(path: String): String
	case read_text(path)
	when Result::Ok(source)
		return source
	when Result::Err(error)
		puts(error.operation + ": " + error.message)
		return ""
	end
end

def gate4_scale_test_source(count: Integer): String
	mut writer := string_builder.new()
	writer.append("def f0(value: Integer): Integer\n\treturn value\nend\n\n")
	mut index := 1
	while index < count
		writer.append("def f" + index.to_s() + "(value: Integer): Integer\n\treturn f")
		writer.append((index - 1).to_s())
		writer.append("(value)\nend\n\n")
		index += 1
	end
	writer.append("def main()\n\tvalue := f" + (count - 1).to_s() + "(1)\n\treturn\nend\n")
	return writer.to_s()
end

describe("Gate 4 TypeRB frontend") do
	test("grows chunked storage only as elements are stored") do
		empty := gate4_integer_storage(0)
		expect(empty.chunks[0].size()).to_equal(0)
		expect(empty.used[0]).to_equal(0)
		expect(gate4_store_integer(empty, 0, 1)).to_be_false()

		integers := gate4_integer_storage(513)
		expect(integers.chunks[0].size()).to_equal(0)
		expect(gate4_store_integer(integers, 0, 10)).to_be_true()
		expect(gate4_store_integer(integers, 255, 20)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(1)
		expect(integers.chunks[0][0].size()).to_equal(256)
		expect(gate4_store_integer(integers, 256, 30)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(2)
		expect(gate4_store_integer(integers, 512, 40)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(3)
		expect(integers.chunks[0][1].size()).to_equal(256)
		expect(integers.chunks[0][2].size()).to_equal(256)
		expect(integers.used[0]).to_equal(513)
		expect(gate4_load_integer(integers, 0)).to_equal(10)
		expect(gate4_load_integer(integers, 255)).to_equal(20)
		expect(gate4_load_integer(integers, 256)).to_equal(30)
		expect(gate4_load_integer(integers, 512)).to_equal(40)
		expect(gate4_store_integer(integers, - 1, 50)).to_be_false()
		expect(gate4_store_integer(integers, 513, 50)).to_be_false()
		expect(integers.used[0]).to_equal(513)

		strings := gate4_string_storage(257)
		expect(gate4_store_string(strings, 0, "first")).to_be_true()
		expect(gate4_store_string(strings, 256, "last")).to_be_true()
		expect(gate4_load_string(strings, 0)).to_equal("first")
		expect(gate4_load_string(strings, 256)).to_equal("last")
		expect(gate4_store_string(strings, 257, "outside")).to_be_false()
	end

	test("returns the last matching symbol without changing missing lookup") do
		expect(gate4_character_in("a", "abc")).to_be_true()
		expect(gate4_character_in("c", "abc")).to_be_true()
		expect(gate4_character_in("z", "abc")).to_be_false()

		mut state := gate4_compiler_new(128)
		gate4_add_module(state, "shared", "/first.trb")
		gate4_add_module(state, "other", "/other.trb")
		gate4_add_module(state, "shared", "/last.trb")
		expect(gate4_find_module(state, "shared")).to_equal(2)
		expect(gate4_find_module(state, "missing")).to_equal(- 1)

		gate4_store_string(state.function_names, 0, "value")
		gate4_store_integer(state.function_modules, 0, 0)
		gate4_store_string(state.function_names, 1, "value")
		gate4_store_integer(state.function_modules, 1, 1)
		gate4_store_string(state.function_names, 2, "value")
		gate4_store_integer(state.function_modules, 2, 0)
		gate4_store_string(state.function_names, 3, "other")
		gate4_store_integer(state.function_modules, 3, 0)
		state.function_count[0] = 4
		gate4_store_string(state.record_names, 0, "Value")
		gate4_store_integer(state.record_modules, 0, 0)
		gate4_store_string(state.record_names, 1, "Value")
		gate4_store_integer(state.record_modules, 1, 1)
		gate4_store_string(state.record_names, 2, "Value")
		gate4_store_integer(state.record_modules, 2, 0)
		gate4_store_string(state.record_names, 3, "Other")
		gate4_store_integer(state.record_modules, 3, 0)
		state.record_count[0] = 4
		expect(gate4_find_record_type(state, "Record#2")).to_equal(2)
		expect(gate4_find_record_type(state, "Record#4")).to_equal(- 1)

		gate4_store_string(state.import_symbols, 0, "load")
		gate4_store_integer(state.import_modules, 0, 0)
		gate4_store_string(state.import_symbols, 1, "load")
		gate4_store_integer(state.import_modules, 1, 0)
		gate4_store_string(state.import_symbols, 2, "save")
		gate4_store_integer(state.import_modules, 2, 0)
		gate4_store_string(state.import_symbols, 3, "load")
		gate4_store_integer(state.import_modules, 3, 1)
		state.import_count[0] = 4
		gate4_store_integer(state.module_import_starts, 0, 0)
		gate4_store_integer(state.module_import_counts, 0, 3)
		gate4_store_integer(state.module_import_starts, 1, 3)
		gate4_store_integer(state.module_import_counts, 1, 1)
		expect(gate4_symbol_bucket_count(0)).to_equal(0)
		expect(gate4_symbol_bucket_count(8)).to_equal(16)
		expect(gate4_symbol_bucket_count(9)).to_equal(32)
		expect(gate4_symbol_bucket_count(65)).to_equal(256)
		gate4_build_function_index(state)
		expect(gate4_find_function_in_module(state, 0, "value")).to_equal(2)
		expect(gate4_find_function_in_module(state, 0, "other")).to_equal(3)
		expect(gate4_find_function_in_module(state, 1, "value")).to_equal(1)
		expect(gate4_find_function_in_module(state, 0, "missing")).to_equal(- 1)
		expect(gate4_find_record_in_module(state, 0, "Value")).to_equal(2)
		expect(gate4_find_record_in_module(state, 0, "Other")).to_equal(3)
		expect(gate4_find_record_in_module(state, 0, "Missing")).to_equal(- 1)
		expect(gate4_find_import_binding(state, 0, "load")).to_equal(1)
		expect(gate4_find_import_binding(state, 0, "save")).to_equal(2)
		expect(gate4_find_import_binding(state, 1, "load")).to_equal(3)
		expect(gate4_find_import_binding(state, 0, "missing")).to_equal(- 1)

		gate4_store_integer(state.record_field_starts, 0, 0)
		gate4_store_integer(state.record_field_counts, 0, 3)
		gate4_store_string(state.field_names, 0, "item")
		gate4_store_string(state.field_names, 1, "other")
		gate4_store_string(state.field_names, 2, "item")
		expect(gate4_find_field(state, 0, "item")).to_equal(2)
		expect(gate4_find_field(state, 0, "missing")).to_equal(- 1)

		mut locals := gate4_locals_new(4)
		gate4_store_string(locals.names, 0, "item")
		gate4_store_string(locals.names, 1, "other")
		gate4_store_string(locals.names, 2, "item")
		locals.count[0] = 3
		expect(gate4_local_find(locals, "item")).to_equal(2)
		expect(gate4_local_find(locals, "missing")).to_equal(- 1)

		mut context := gate4_emit_context_new(4, [0])
		gate4_store_string(context.local_names, 0, "item")
		gate4_store_string(context.local_names, 1, "other")
		gate4_store_string(context.local_names, 2, "item")
		context.local_count[0] = 3
		expect(gate4_emit_local_find(context, "item")).to_equal(2)
		expect(gate4_emit_local_find(context, "missing")).to_equal(- 1)
	end

	test("indexes colliding fixed-width module names across deterministic growth") do
		expect(gate4_string_bucket("aa", 16)).to_equal(gate4_string_bucket("aq", 16))
		mut state := gate4_compiler_new(128)
		expect(gate4_find_module(state, "missing")).to_equal(- 1)
		gate4_add_module(state, "aa", "/first-aa.trb")
		gate4_add_module(state, "aq", "/aq.trb")
		gate4_add_module(state, "aa", "/last-aa.trb")
		expect(state.module_lookup.heads.used[0]).to_equal(16)
		expect(gate4_find_module(state, "aa")).to_equal(2)
		expect(gate4_find_module(state, "aq")).to_equal(1)
		additional := ["ba", "bb", "bc", "bd", "be", "bf"]
		mut index := 0
		while index < additional.size()
			gate4_add_module(state, additional[index], "/" + additional[index] + ".trb")
			index += 1
		end
		expect(state.module_count[0]).to_equal(9)
		expect(state.module_lookup.heads.used[0]).to_equal(32)
		index = 0
		while index < additional.size()
			expect(gate4_find_module(state, additional[index])).to_equal(index + 3)
			index += 1
		end
		expect(gate4_find_module(state, "missing")).to_equal(- 1)
	end

	test("preserves ASCII identifier and digit classification after hot-path ordering") do
		expect(gate4_identifier_start("a")).to_be_true()
		expect(gate4_identifier_start("Z")).to_be_true()
		expect(gate4_identifier_start("_")).to_be_true()
		expect(gate4_identifier_start("0")).to_be_false()
		expect(gate4_identifier_start("-")).to_be_false()
		expect(gate4_identifier_continue("a")).to_be_true()
		expect(gate4_identifier_continue("Z")).to_be_true()
		expect(gate4_identifier_continue("_")).to_be_true()
		expect(gate4_identifier_continue("0")).to_be_true()
		expect(gate4_identifier_continue("-")).to_be_false()
		expect(gate4_digit("0")).to_be_true()
		expect(gate4_digit("9")).to_be_true()
		expect(gate4_digit("a")).to_be_false()
	end

	test("classifies decimal literals and enforces the finite binary64 boundary") do
		expect(gate4_number_is_float("1")).to_be_false()
		expect(gate4_number_is_float("1.0")).to_be_true()
		expect(gate4_number_without_underscores("1_0.5_0")).to_equal("10.50")
		expect(gate4_float_literal_in_range("1_0.5_0")).to_be_true()
		expect(
			gate4_float_literal_in_range(
				".0",
			),
		).to_be_true()
		expect(
			gate4_float_literal_in_range(
				".0",
			),
		).to_be_false()
		expect(
			gate4_float_literal_in_range(
				".0",
			),
		).to_be_false()
	end

	test("checks a generated declaration-chain scale probe") do
		source := gate4_scale_test_source(128)
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		expect(state.function_count[0]).to_equal(129)
		expect(gate4_output_source(gate4_emit_qbe(state)).include?("function l $g4f127")).to_be_true()
	end

	test("lexes and parses the registered declaration and expression subset") do
		source := gate4_frontend_test_source()
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_has_diagnostic(state)).to_be_false()
		expect(state.record_count[0]).to_equal(1)
		expect(gate4_load_string(state.record_names, 0)).to_equal("Pair")
		expect(state.field_count[0]).to_equal(2)
		expect(gate4_load_string(state.field_names, 0)).to_equal("left")
		expect(gate4_load_string(state.field_names, 1)).to_equal("right")
		expect(state.function_count[0]).to_equal(2)
		expect(gate4_load_string(state.function_names, 0)).to_equal("add")
		expect(gate4_load_string(state.function_names, 1)).to_equal("main")
		expect(gate4_load_string(state.function_result_types, 0)).to_equal("Integer")
		expect(gate4_load_string(state.function_result_types, 1)).to_equal("Void")
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
	end

	test("keeps declarations and named imports scoped to their source modules") do
		mut state := gate4_compiler_new(16384)
		gate4_add_module(state, "main", "/project/main.trb")
		gate4_add_module(state, "alpha", "/project/alpha.trb")
		gate4_add_module(state, "beta", "/project/beta.trb")
		state.entry_module[0] = 0
		sources := [
			"import { left } from alpha\nimport { right } from beta\n\ndef main()\n\tif left() + right() == 42\n\t\tputs(\"modules-ok\")\n\tend\n\treturn\nend\n",
			"record Value\n\tnumber: Integer\nend\n\ndef normalize(value: Integer): Integer\n\treturn value\nend\n\ndef left(): Integer\n\tvalue := Value.new(number: 20)\n\treturn normalize(value.number)\nend\n",
			"record Value\n\tnumber: Integer\nend\n\ndef normalize(value: Integer): Integer\n\treturn value\nend\n\ndef right(): Integer\n\tvalue := Value.new(number: 22)\n\treturn normalize(value.number)\nend\n",
		]
		mut module_index := 0
		while module_index < sources.size()
			start := state.token_count[0]
			expect(gate4_lex_module(state, sources[module_index], module_index)).to_be_true()
			expect(gate4_parse_module(state, start, module_index)).to_be_true()
			module_index += 1
		end
		expect(gate4_load_integer(state.module_import_starts, 0)).to_equal(0)
		expect(gate4_load_integer(state.module_import_counts, 0)).to_equal(2)
		expect(gate4_load_integer(state.module_import_starts, 1)).to_equal(2)
		expect(gate4_load_integer(state.module_import_counts, 1)).to_equal(0)
		expect(gate4_load_integer(state.module_import_starts, 2)).to_equal(2)
		expect(gate4_load_integer(state.module_import_counts, 2)).to_equal(0)
		mut import_index := 0
		while import_index < state.import_count[0]
			path := gate4_load_string(state.import_paths, import_index)
			if path == "alpha"
				gate4_store_integer(state.import_targets, import_index, 1)
			else
				gate4_store_integer(state.import_targets, import_index, 2)
			end
			import_index += 1
		end
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		expect(state.record_count[0]).to_equal(2)
		expect(state.function_count[0]).to_equal(5)
		first := gate4_output_source(gate4_emit_qbe(state))
		second := gate4_output_source(gate4_emit_qbe(state))
		expect(first).to_equal(second)
	end

	test("rejects an unsupported source character deterministically") do
		source := "def main()\n\t@\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_false()
		expect(state.diagnostic_count[0]).to_equal(1)
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4001")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("unsupported source character @")
	end

	test("rejects an unfinished function deterministically") do
		source := "def main()\n\tputs(\"missing\")\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4002")
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("expected end")
	end

	test("parses the checked-in compiler closure through its own frontend") do
		root := environment("TYPE_RB_NATIVE_ROOT")
		if root == nil
			expect(true).to_be_true()
		else
			base := root + "/compiler/gate4/src/"
			sources := [
				gate4_required_test_source(base + "compiler.trb"),
				gate4_required_test_source(base + "storage.trb"),
				gate4_required_test_source(base + "path.trb"),
			]
			expect(!sources[0].empty?()).to_be_true()
			expect(!sources[1].empty?()).to_be_true()
			expect(!sources[2].empty?()).to_be_true()
			mut state := gate4_compiler_new(sources[0].size() + sources[1].size() + sources[2].size() + 3)
			gate4_add_module(state, "compiler", base + "compiler.trb")
			gate4_add_module(state, "storage", base + "storage.trb")
			gate4_add_module(state, "path", base + "path.trb")
			state.entry_module[0] = 0
			mut module_index := 0
			while module_index < sources.size()
				start := state.token_count[0]
				expect(gate4_lex_module(state, sources[module_index], module_index)).to_be_true()
				expect(gate4_parse_module(state, start, module_index)).to_be_true()
				module_index += 1
			end
			mut import_index := 0
			while import_index < state.import_count[0]
				if gate4_load_string(state.import_paths, import_index) == "storage"
					gate4_store_integer(state.import_targets, import_index, 1)
				else
					gate4_store_integer(state.import_targets, import_index, 2)
				end
				import_index += 1
			end
			expect(gate4_find_record_in_module(state, 0, "Gate4Compiler") >= 0).to_be_true()
			expect(state.record_count[0] > 5).to_be_true()
			expect(state.function_count[0] > 20).to_be_true()
			if !gate4_resolve(state)
				puts(
					gate4_load_string(state.diagnostic_codes, 0) + ":" + gate4_load_integer(state.diagnostic_lines, 0).to_s() + ":" +
					gate4_load_string(state.diagnostic_messages, 0),
				)
			end
			expect(gate4_has_diagnostic(state)).to_be_false()
			if !gate4_check(state)
				puts(
					gate4_load_string(state.diagnostic_codes, 0) + ":" + gate4_load_integer(state.diagnostic_lines, 0).to_s() + ":" +
					gate4_load_string(state.diagnostic_messages, 0),
				)
			end
			expect(gate4_has_diagnostic(state)).to_be_false()
		end
	end

	test("rejects duplicate declarations during resolution") do
		source := "def main()\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(5)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("duplicate function declaration main")
	end

	test("rejects an unresolved direct call during resolution") do
		source := "def main()\n\tmissing()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("unresolved function missing")
	end

	test("rejects a local initializer type mismatch during checking") do
		source := "def main()\n\tvalue: Integer := \"bad\"\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("expected Integer, found String")
	end

	test("enforces the portable Integer literal range during checking") do
		valid_source := "def main()\n\tvalue := 9007199254740991\n\treturn\nend\n"
		mut valid := gate4_compiler_new(valid_source.size() + 1)
		expect(gate4_lex(valid, valid_source)).to_be_true()
		expect(gate4_parse(valid)).to_be_true()
		expect(gate4_resolve(valid)).to_be_true()
		expect(gate4_check(valid)).to_be_true()

		invalid_source := "def main()\n\tvalue := 9007199254740992\n\treturn\nend\n"
		mut invalid := gate4_compiler_new(invalid_source.size() + 1)
		expect(gate4_lex(invalid, invalid_source)).to_be_true()
		expect(gate4_parse(invalid)).to_be_true()
		expect(gate4_resolve(invalid)).to_be_true()
		expect(gate4_check(invalid)).to_be_false()
		expect(gate4_load_string(invalid.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(invalid.diagnostic_lines, 0)).to_equal(2)
		expect(gate4_load_string(invalid.diagnostic_messages, 0)).to_equal(
			"Integer literal is outside the portable range",
		)
	end

	test("rejects direct-call arity mismatches during checking") do
		source := "def identity(value: Integer): Integer\n\treturn value\nend\n\ndef main()\n\tidentity()\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(6)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("call argument count does not match identity")
	end

	test("rejects destructive calls through immutable bindings") do
		source := "def main()\n\tvalues: Array<Integer> := [1]\n\tvalues.push(2)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_false()
		expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_integer(state.diagnostic_lines, 0)).to_equal(3)
		expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("push receiver is immutable")
	end

	test("emits direct binary64 cells for Float Arrays") do
		source := "record Floats\n\tvalues: Array<Float>\nend\n\ndef carry(values: Array<Float>): Array<Float>\n\treturn values\nend\n\ndef main()\n\tmut values := [1, 2.5]\n\tvalues.push(3)\n\tvalues[0] += 0.5\n\tbox := Floats.new(values: values)\n\tresult := carry(box.values)\n\tvalue := result[- 1]\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("function $g4_array_push_d(l %array, d %value)")).to_be_true()
		expect(qbe.include?("call $g4_array_push_d(l ")).to_be_true()
		expect(qbe.include?(", d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=d loadd ")).to_be_true()
		expect(qbe.include?("stored ")).to_be_true()
		expect(qbe.include?("$g4_array_push_d(l %array, l %value)")).to_be_false()
		expect(qbe.include?("\tcall $g4_array_push(l %array, l 0)")).to_be_false()
	end

	test("emits deterministic QBE and executes the registered source subset") do
		source := gate4_frontend_test_source()
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse(state)).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		first := gate4_output_source(gate4_emit_qbe(state))
		second := gate4_output_source(gate4_emit_qbe(state))
		expect(first).to_equal(second)
		expect(first.include?("function l $g4f0(l %p0, l %p1) {")).to_be_true()
		expect(first.include?("export function w $main(w %argc, l %argv) {")).to_be_true()
		qbe := environment("TYPE_RB_NATIVE_QBE")
		if qbe == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate4-emitter"
			case create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case write_text(workspace + "/module.ssa", first)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case run(qbe, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case run("/usr/bin/cc", [workspace + "/module.s", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case run(workspace + "/program", [])
			when Result::Ok(result)
				expect(result.success).to_be_true()
				expect(result.stdout).to_equal("ok\n")
				expect(result.stderr).to_equal("")
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
		end
	end
end
