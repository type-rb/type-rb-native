		mutable_negative_qbe := gate4_output_source(gate4_emit_qbe(mutable_negative))
		expect(gate4_occurrence_count(mutable_negative_qbe, " =l sar ")).to_equal(1)

		later_reset_source := "def main()\n\tvalues := [10, 20]\n\tmut value := 0\n\tmut index := 0\n\twhile index < values.size()\n\t\tvalue = values[index]\n\t\tindex += 1\n\tend\n\tindex = 0\n\twhile index < values.size()\n\t\tvalue = values[index]\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut later_reset := gate4_compiler_new(later_reset_source.size() + 1)
		expect(gate4_lex(later_reset, later_reset_source)).to_be_true()
		expect(gate4_parse_module(later_reset, 0, later_reset.entry_module[0])).to_be_true()
		expect(gate4_resolve(later_reset)).to_be_true()
		expect(gate4_check(later_reset)).to_be_true()
		later_reset_qbe := gate4_output_source(gate4_emit_qbe(later_reset))
		expect(gate4_occurrence_count(later_reset_qbe, " =l sar ")).to_equal(1)

		nested_reassigned_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tif true\n\t\t\tvalue := values[index]\n\t\t\tindex = 0\n\t\tend\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut nested_reassigned := gate4_compiler_new(nested_reassigned_source.size() + 1)
