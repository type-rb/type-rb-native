		mutable_negative_source := "def main()\n\tvalues := [10, 20]\n\tmut index := -2\n\tmut round := 0\n\twhile round < 1\n\t\tvalue := values[index + 1]\n\t\tround += 1\n\tend\n\treturn\nend\n"
		mut mutable_negative := gate4_compiler_new(mutable_negative_source.size() + 1)
		expect(gate4_lex(mutable_negative, mutable_negative_source)).to_be_true()
		expect(gate4_parse_module(mutable_negative, 0, mutable_negative.entry_module[0])).to_be_true()
