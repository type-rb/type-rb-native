	test("splits common non-Float Array pushes from fixed quadruple growth") do
		source := "def main()\n\tmut managed: Array<String> := []\n\tmanaged.push(\"value\")\n\tmut scalar: Array<Integer> := []\n\tscalar.push(1)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("function $g4_array_push_paced(l %array, l %value) {")).to_be_true()
		expect(
			qbe.include?(
				"%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $g4_array_grow_paced(l %array, l %value, l %length, l %capacity)\n\tret\n@store",
			),
		).to_be_true()
		expect(qbe.include?("function $g4_array_grow_paced(l %array, l %value, l %length, l %capacity) {")).to_be_true()
		expect(qbe.include?("%new_capacity =l shl %capacity, 2\n\t%new_bytes =l shl %new_capacity, 3")).to_be_true()
		expect(qbe.include?("%offset =l shl %length, 3")).to_be_true()
		expect(qbe.include?("%managed_slot =l add %descriptor, 8")).to_be_false()
		expect(qbe.include?("function $g4_array_push(l %array, l %value) {")).to_be_true()
		expect(qbe.include?("call $g4_array_push_paced(l ")).to_be_true()
	end

	test("splits temporary-root push storage from growth") do
		source := "def keep(value: String): String\n\treturn value\nend\n\ndef main()\n\tputs(keep(\"kept\"))\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("function $g4_gc_temp_push(l %value) {")).to_be_true()
		expect(
			qbe.include?(
				"%full =w ceql %count, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $g4_gc_temp_grow(l %value, l %count, l %capacity)\n\tret\n@store",
			),
		).to_be_true()
		expect(qbe.include?("function $g4_gc_temp_grow(l %value, l %count, l %capacity) {")).to_be_true()
		expect(qbe.include?("%new_data =l call $realloc(l %data, l %bytes)")).to_be_true()
		expect(qbe.include?("%nil =w ceql %value, 0\n\tjnz %nil, @finish, @descriptor")).to_be_true()
		expect(qbe.include?("%descriptor_mark =l loadl %value\n\t%static =w ceql %descriptor_mark, 0")).to_be_true()
		expect(qbe.include?("%offset =l shl %count, 3")).to_be_true()
		expect(qbe.include?("storel %value, %slot\n\t%next_count =l add %count, 1")).to_be_true()
	end

	test("emits direct binary64 cells for Float Arrays") do
		source := "record Floats\n\tvalues: Array<Float>\nend\n\ndef carry(values: Array<Float>): Array<Float>\n\treturn values\nend\n\ndef main()\n\tmut values := [1, 2.5]\n\tvalues.push(3)\n\tvalues[0] += 0.5\n\tbox := Floats.new(values: values)\n\tresult := carry(box.values)\n\tvalue := result[- 1]\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("function $g4_array_push_paced(l %array, l %value)")).to_be_true()
		expect(qbe.include?("function $g4_array_push_d(l %array, d %value)")).to_be_true()
		expect(qbe.include?("call $g4_gc_maybe_collect(l %growth)")).to_be_true()
		expect(qbe.include?("call $g4_array_preflight(l ")).to_be_false()
		expect(qbe.include?("call $g4_array_push_d(l ")).to_be_true()
		expect(qbe.include?(", d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=d loadd ")).to_be_true()
		expect(qbe.include?("stored ")).to_be_true()
		expect(qbe.include?("$g4_array_push_d(l %array, l %value)")).to_be_false()
		expect(qbe.include?("\tcall $g4_array_push(l %array, l 0)")).to_be_false()
	end

