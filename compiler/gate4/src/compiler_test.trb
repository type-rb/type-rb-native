	test("inlines only eligible scalar leaf calls inside loops") do
		eligible_source := "def scalar(left: Integer, right: Integer): Integer\n\tsum := left + right\n\treturn sum * 2\nend\n\ndef main()\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := scalar(index, 1)\n\t\tindex += value\n\tend\n\treturn\nend\n"
		mut eligible := gate4_compiler_new(eligible_source.size() + 1)
		expect(gate4_lex(eligible, eligible_source)).to_be_true()
		expect(gate4_parse_module(eligible, 0, eligible.entry_module[0])).to_be_true()
		expect(gate4_resolve(eligible)).to_be_true()
		expect(gate4_check(eligible)).to_be_true()
		eligible_qbe := gate4_output_source(gate4_emit_qbe(eligible))
		expect(eligible_qbe.include?("call $g4f0")).to_be_false()
		expect(eligible_qbe.include?("function l $g4f0(")).to_be_false()
		expect(eligible_qbe.include?("# gate4 retained scalar call ")).to_be_false()
		expect(eligible_qbe.include?("@scalar_inline_integer_range_failure")).to_be_true()
		expect(
			gate4_occurrence_count(eligible_qbe, "@scalar_inline_integer_range_failure"),
		).to_equal(4)

		non_loop_source := "def scalar(value: Integer): Integer\n\treturn value + 1\nend\n\ndef main()\n\tvalue := scalar(1)\n\treturn\nend\n"
		mut non_loop := gate4_compiler_new(non_loop_source.size() + 1)
		expect(gate4_lex(non_loop, non_loop_source)).to_be_true()
		expect(gate4_parse_module(non_loop, 0, non_loop.entry_module[0])).to_be_true()
		expect(gate4_resolve(non_loop)).to_be_true()
		expect(gate4_check(non_loop)).to_be_true()
		non_loop_qbe := gate4_output_source(gate4_emit_qbe(non_loop))
		expect(non_loop_qbe.include?("call $g4f0")).to_be_true()
		expect(non_loop_qbe.include?("function l $g4f0(")).to_be_true()
		expect(non_loop_qbe.include?("# gate4 retained scalar call ")).to_be_false()
		expect(non_loop_qbe.include?("@scalar_inline_integer_range_failure")).to_be_false()

		ineligible_source := "def choose(value: Integer): Integer\n\tif value > 0\n\t\treturn value\n\telse\n\t\treturn 0\n\tend\nend\n\ndef main()\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := choose(index)\n\t\tindex += value + 1\n\tend\n\treturn\nend\n"
		mut ineligible := gate4_compiler_new(ineligible_source.size() + 1)
		expect(gate4_lex(ineligible, ineligible_source)).to_be_true()
		expect(gate4_parse_module(ineligible, 0, ineligible.entry_module[0])).to_be_true()
		expect(gate4_resolve(ineligible)).to_be_true()
		expect(gate4_check(ineligible)).to_be_true()
		expect(gate4_output_source(gate4_emit_qbe(ineligible)).include?("call $g4f0")).to_be_true()

		delegating_source := "def increment(value: Integer): Integer\n\treturn value + 1\nend\n\ndef delegating(value: Integer): Integer\n\treturn increment(value)\nend\n\ndef main()\n\tmut index := 0\n\twhile index < 1\n\t\tindex = delegating(index)\n\tend\n\treturn\nend\n"
		mut delegating := gate4_compiler_new(delegating_source.size() + 1)
		expect(gate4_lex(delegating, delegating_source)).to_be_true()
		expect(gate4_parse_module(delegating, 0, delegating.entry_module[0])).to_be_true()
		expect(gate4_resolve(delegating)).to_be_true()
		expect(gate4_check(delegating)).to_be_true()
		expect(gate4_output_source(gate4_emit_qbe(delegating)).include?("call $g4f1")).to_be_true()
	end

	test("limits scalar leaf inlining to two call sites per small program") do
