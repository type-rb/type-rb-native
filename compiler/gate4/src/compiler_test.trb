	test("selects LLD only for compiler-driven Linux links") do
		compiler_source := "def compiler_main(source: String, path: String, check_only: Boolean): Integer\n\treturn 0\nend\n\ndef main()\n\treturn\nend\n"
		mut compiler_state := gate4_compiler_new(compiler_source.size() + 1)
		expect(gate4_lex(compiler_state, compiler_source)).to_be_true()
		expect(gate4_parse_module(compiler_state, 0, compiler_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(compiler_state)).to_be_true()
		expect(gate4_check(compiler_state)).to_be_true()
		compiler_qbe := gate4_output_source(gate4_emit_qbe(compiler_state))
		expect(compiler_qbe.include?("data $g4_project_linker_lld = { b \"-fuse-ld=lld\", b 0 }")).to_be_true()
		expect(compiler_qbe.include?("data $g4_profile_linux_amd64 = { b \"linux-amd64-v0\", b 0 }")).to_be_true()
		expect(compiler_qbe.include?("data $g4_qbe_linux_amd64 = { b \"amd64_sysv\", b 0 }")).to_be_true()
		expect(compiler_qbe.include?("@target_linux_amd64_check")).to_be_true()
		expect(compiler_qbe.include?("storel $g4_qbe_linux_amd64, $g4_selected_qbe_target")).to_be_true()
		expect(compiler_qbe.include?("storel $g4_project_linker_lld, $g4_project_selected_linker")).to_be_true()
		expect(compiler_qbe.include?("%has_linker =w cnel %linker, 0")).to_be_true()
		expect(compiler_qbe.include?("%tail =l phi @linker %linker_tail, @default %default_tail")).to_be_true()

		application_source := "def main()\n\treturn\nend\n"
		mut application_state := gate4_compiler_new(application_source.size() + 1)
		expect(gate4_lex(application_state, application_source)).to_be_true()
		expect(gate4_parse_module(application_state, 0, application_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(application_state)).to_be_true()
		expect(gate4_check(application_state)).to_be_true()
		application_qbe := gate4_output_source(gate4_emit_qbe(application_state))
		expect(application_qbe.include?("g4_project_linker_lld")).to_be_false()
	end

	test("checks and emits portable benchmark entry primitives") do
		source := "import trb/std/process\nimport trb/std/math as Numeric\n\ndef main()\n\tmut first := Process.argv()\n\tfirst.push(\"local\")\n\tsecond := Process.argv()\n\tparsed := second[0].to_i()\n\troot := Numeric.sqrt(parsed)\n\ttruncated := root.to_i()\n\tputs(first.size().to_s())\n\tputs(second.size().to_s())\n\tputs(truncated.to_s())\n\tnan := Numeric.sqrt(- 1)\n\tif nan != nan\n\t\tputs(\"nan\")\n\telse\n\t\tputs(\"number\")\n\tend\n\tputs(\"+9007199254740991\".to_i().to_s())\n\tputs(\"-9007199254740991\".to_i().to_s())\n\tvalue := - 2.75\n\tputs(value.to_i().to_s())\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		emitted := gate4_emit_qbe(state)
		expect(emitted.runtime_flags[1]).to_equal(1)
		expect(emitted.runtime_flags[2]).to_equal(0)
		expect(emitted.runtime_flags.size()).to_equal(4)
		qbe := gate4_output_source(emitted)
		expect(qbe.include?("storel %process_argc, $g4_process_argc")).to_be_true()
		expect(qbe.include?("function l $g4_process_argv()")).to_be_true()
		expect(qbe.include?("function l $g4_string_to_integer(l %string)")).to_be_true()
		expect(qbe.include?("function l $g4_integer_to_string(l %value)")).to_be_true()
		expect(qbe.include?("function l $g4_float_to_integer(d %value)")).to_be_true()
		expect(qbe.include?("=d call $sqrt(d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=l dtosi ")).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate6m-entry"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case native_write_text(workspace + "/module.ssa", qbe)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case native_write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(workspace + "/program", ["9"])
			when Result::Ok(result)
				expect(result.success).to_be_true()
				expect(result.stdout).to_equal("2\n1\n3\nnan\n9007199254740991\n-9007199254740991\n-2\n")
				expect(result.stderr).to_equal("")
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
		end
	end

	test("preserves portable numeric conversion failure classes") do
		source := "import trb/std/process\nimport trb/std/math\n\ndef main()\n\tmode := Process.argv()[0]\n\tif mode == \"invalid-format\"\n\t\tputs(\"12x\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"sign-only\"\n\t\tputs(\"+\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"integer-range\"\n\t\tputs(\"9007199254740992\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"nan\"\n\t\tputs(Math.sqrt(- 1).to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"infinity\"\n\t\tzero := 0.0\n\t\tinfinite := 1.0 / zero\n\t\tputs(infinite.to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"float-range\"\n\t\toutside := 9007199254740992.0\n\t\tputs(outside.to_i().to_s())\n\t\treturn\n\tend\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		checked := gate4_check(state)
		if !checked
			puts(gate4_load_integer(state.diagnostic_lines, 0).to_s() + ": " + gate4_load_string(state.diagnostic_messages, 0))
		end
		expect(checked).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate6m-failures"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case native_write_text(workspace + "/module.ssa", gate4_output_source(gate4_emit_qbe(state)))
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case native_write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			modes := ["invalid-format", "sign-only", "integer-range", "nan", "infinity", "float-range"]
			expected := ["panic: invalid Integer\n", "panic: invalid Integer\n", "panic: Integer is outside the portable range\n", "panic: Float cannot be converted to Integer\n", "panic: Float cannot be converted to Integer\n", "panic: Integer is outside the portable range\n"]
			mut index := 0
			while index < modes.size()
				case Process.run(workspace + "/program", [modes[index]])
				when Result::Ok(result)
					expect(result.success).to_be_false()
					expect(result.stdout).to_equal("")
					expect(result.stderr).to_equal(expected[index])
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
				index += 1
			end
		end
	end

	test("rejects unsupported benchmark entry boundaries deterministically") do
		unsupported_package := gate4_load_file_root(
			"import trb/std/random\n\ndef main()\n\treturn\nend\n",
			"/tmp/gate6m-unsupported-package.trb",
		)
		expect(gate4_load_string(unsupported_package.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(gate4_load_string(unsupported_package.diagnostic_messages, 0)).to_equal("package imports are not supported by this compiler subset")

		member_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.environment()\n\treturn\nend\n"
		mut member_state := gate4_compiler_new(member_source.size() + 1)
		expect(gate4_lex(member_state, member_source)).to_be_true()
		expect(gate4_parse_module(member_state, 0, member_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(member_state)).to_be_true()
		expect(gate4_check(member_state)).to_be_false()
		expect(gate4_load_string(member_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_string(member_state.diagnostic_messages, 0)).to_equal("unsupported standard package member")

		type_source := "import trb/std/math\n\ndef main()\n\tvalue := Math.sqrt(\"nine\")\n\treturn\nend\n"
		mut type_state := gate4_compiler_new(type_source.size() + 1)
		expect(gate4_lex(type_state, type_source)).to_be_true()
		expect(gate4_parse_module(type_state, 0, type_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(type_state)).to_be_true()
		expect(gate4_check(type_state)).to_be_false()
		expect(gate4_load_string(type_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_string(type_state.diagnostic_messages, 0)).to_equal("expected Float, found String")

		arity_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.argv(1)\n\treturn\nend\n"
		mut arity_state := gate4_compiler_new(arity_source.size() + 1)
		expect(gate4_lex(arity_state, arity_source)).to_be_true()
		expect(gate4_parse_module(arity_state, 0, arity_state.entry_module[0])).to_be_true()
		expect(gate4_resolve(arity_state)).to_be_true()
		expect(gate4_check(arity_state)).to_be_false()
		expect(gate4_load_string(arity_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(gate4_load_string(arity_state.diagnostic_messages, 0)).to_equal("call argument count does not match Process")
	end

	test("inlines bounded scalar helpers outside lexical loops") do
		source := "def scalar(value: Integer): Integer\n\tsum := value + 1\n\tproduct := sum * 2\n\treturn product / 2\nend\n\ndef main()\n\tmut values: Array<Integer> := [0]\n\tmut index := 0\n\twhile index < 1\n\t\tvalues[0] = scalar(index)\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("call $g4_integer_add")).to_be_false()
		expect(qbe.include?("call $g4_integer_multiply")).to_be_false()
		expect(qbe.include?("call $g4_integer_divide")).to_be_false()
		expect(qbe.include?("call $g4_array_address")).to_be_false()
	end

	test("routes dynamic Integer multiplication through the bounded checked entry") do
		source := "def multiply(left: Integer, right: Integer): Integer\n\treturn left * right\nend\n\ndef main()\n\tvalue := multiply(2, 3)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("call $g4_integer_multiply(l ")).to_be_true()
		expect(qbe.include?("%c =l or %left, %right")).to_be_true()
		expect(qbe.include?("%u =l shr %c, 26")).to_be_true()
		expect(qbe.include?("jnz %u, @left_sign, @multiply")).to_be_true()
		expect(gate4_occurrence_count(qbe, "%right_zero =w ceql %right, 0")).to_equal(1)
	end

	test("omits only the impossible lower check for bounded nonnegative literal addition") do
		source := "def add_right(value: Integer): Integer\n\treturn value + 1\nend\n\ndef add_left(value: Integer): Integer\n\treturn 1 + value\nend\n\ndef add_limit(value: Integer): Integer\n\treturn value + 1024\nend\n\ndef add_large(value: Integer): Integer\n\treturn value + 1025\nend\n\ndef add_dynamic(left: Integer, right: Integer): Integer\n\treturn left + right\nend\n\ndef main()\n\tfirst := add_right(1)\n\tsecond := add_left(first)\n\tthird := add_limit(second)\n\tfourth := add_large(third)\n\tvalue := add_dynamic(fourth, 1)\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(
			gate4_occurrence_count(
				qbe,
				"%t0 =l add %p0, 1\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l1",
			),
		).to_equal(2)
		expect(
			qbe.include?(
				"%t0 =l add %p0, 1024\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l1\n" +
				"@l0\n\tcall $g4_fail",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"%t0 =l add %p0, 1025\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l2\n" +
				"@l2\n\t%t2 =w csltl %t0, -9007199254740991",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"%t0 =l add %p0, %p1\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l2\n" +
				"@l2\n\t%t2 =w csltl %t0, -9007199254740991",
			),
		).to_be_true()
	end

	test("keeps the loop reserve independent when the non-loop reserve is exhausted") do
		source := "def scalar(value: Integer): Integer\n\tmut result := value\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\treturn result\nend\n\ndef main()\n\tmut values: Array<Integer> := [0]\n\tmut index := 0\n\twhile index < 1\n\t\tvalues[0] = scalar(index)\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(qbe.include?("call $g4_integer_add")).to_be_true()
		expect(qbe.include?("call $g4_array_address")).to_be_false()
	end

	test("spends the loop inline budget on dynamic Array reads and mutation") do
		source := "def main()\n\tmut values: Array<Integer> := [10, 20]\n\tindices := [1, - 2]\n\tmut position := 0\n\twhile position < indices.size()\n\t\tindex := indices[position]\n\t\tvalues[index] = values[index] + 1\n\t\tposition += 1\n\tend\n\treturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		qbe := gate4_output_source(gate4_emit_qbe(state))
		expect(gate4_occurrence_count(qbe, "call $g4_array_address")).to_equal(0)
		expect(gate4_occurrence_count(qbe, "function l $g4_array_address")).to_equal(0)
		expect(gate4_occurrence_count(qbe, "call $g4_fail(l $g4_bounds_error")).to_equal(2)
	end

	test("omits negative Array-index normalization only for proven induction locals") do
		proven_source := "def main()\n\tmut values: Array<Integer> := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tvalues[index] = values[index] + 1\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut proven := gate4_compiler_new(proven_source.size() + 1)
		expect(gate4_lex(proven, proven_source)).to_be_true()
		expect(gate4_parse_module(proven, 0, proven.entry_module[0])).to_be_true()
		expect(gate4_resolve(proven)).to_be_true()
		expect(gate4_check(proven)).to_be_true()
		proven_qbe := gate4_output_source(gate4_emit_qbe(proven))
		expect(gate4_occurrence_count(proven_qbe, " =l sar ")).to_equal(0)
		expect(gate4_occurrence_count(proven_qbe, " =w cultl ")).to_equal(2)

		direct_derived_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := values[index + 1]\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut direct_derived := gate4_compiler_new(direct_derived_source.size() + 1)
		expect(gate4_lex(direct_derived, direct_derived_source)).to_be_true()
		expect(gate4_parse_module(direct_derived, 0, direct_derived.entry_module[0])).to_be_true()
		expect(gate4_resolve(direct_derived)).to_be_true()
		expect(gate4_check(direct_derived)).to_be_true()
		mut verified_index_facts := 0
		mut unresolved_index_facts := 0
		mut fact_index := 0
		while fact_index < direct_derived.token_count[0]
			if gate4_load_string(direct_derived.token_texts, fact_index) == "]"
				fact := gate4_mir_nonnegative_fact(direct_derived, fact_index)
				if fact == 2
					verified_index_facts += 1
				end
				if fact < 0
					unresolved_index_facts += 1
				end
			end
			fact_index += 1
		end
		expect(verified_index_facts).to_equal(1)
		expect(unresolved_index_facts).to_equal(0)
		direct_derived_qbe := gate4_output_source(gate4_emit_qbe(direct_derived))
		expect(gate4_occurrence_count(direct_derived_qbe, " =l sar ")).to_equal(0)

		reassigned_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tvalue := values[index]\n\t\tindex =- 1\n\tend\n\treturn\nend\n"
		mut reassigned := gate4_compiler_new(reassigned_source.size() + 1)
		expect(gate4_lex(reassigned, reassigned_source)).to_be_true()
		expect(gate4_parse_module(reassigned, 0, reassigned.entry_module[0])).to_be_true()
		expect(gate4_resolve(reassigned)).to_be_true()
		expect(gate4_check(reassigned)).to_be_true()
		reassigned_qbe := gate4_output_source(gate4_emit_qbe(reassigned))
		expect(gate4_occurrence_count(reassigned_qbe, " =l sar ")).to_equal(1)

		non_unit_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tvalue := values[index]\n\t\tindex += 2\n\tend\n\treturn\nend\n"
		mut non_unit := gate4_compiler_new(non_unit_source.size() + 1)
		expect(gate4_lex(non_unit, non_unit_source)).to_be_true()
		expect(gate4_parse_module(non_unit, 0, non_unit.entry_module[0])).to_be_true()
		expect(gate4_resolve(non_unit)).to_be_true()
		expect(gate4_check(non_unit)).to_be_true()
		non_unit_qbe := gate4_output_source(gate4_emit_qbe(non_unit))
		expect(gate4_occurrence_count(non_unit_qbe, " =l sar ")).to_equal(1)

		nested_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tif index == 0\n\t\t\tvalue := values[index]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut nested := gate4_compiler_new(nested_source.size() + 1)
		expect(gate4_lex(nested, nested_source)).to_be_true()
		expect(gate4_parse_module(nested, 0, nested.entry_module[0])).to_be_true()
		expect(gate4_resolve(nested)).to_be_true()
		expect(gate4_check(nested)).to_be_true()
		nested_qbe := gate4_output_source(gate4_emit_qbe(nested))
		expect(gate4_occurrence_count(nested_qbe, " =l sar ")).to_equal(1)

		safe_nested_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tmut pass := 0\n\t\twhile pass < 1\n\t\t\tvalue := values[index]\n\t\t\tpass += 1\n\t\tend\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut safe_nested := gate4_compiler_new(safe_nested_source.size() + 1)
