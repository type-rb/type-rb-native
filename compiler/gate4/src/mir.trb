import { gate4_float_literal_in_range, gate4_integer_literal_in_range, gate4_number_is_float, gate4_small_nonnegative_integer_operand } from literals

# Compact bootstrap MIR rows use these fixed layouts:
# function: id, entry block, origin source/line, parameter range, block range;
# block: id, origin source/line, parameter and instruction ranges, terminator;
# value: function, id, type, origin source/line; and
# instruction: kind, result, two operands, literal, failure block, origin.
# Array regions retain parameter, access, and effect operations.
# The verifier derives their plans; input facts remain empty.
# A verified pass may mark the complete Array induction plan as optimized
# (kind 5, mode 2). The verifier re-derives the loop proof before a backend may
# consume its invariant header and redundant-check decisions.
record Gate4MirModule
	source_count: Array<Integer>
	entry_function: Array<Integer>
	functions: Array<Array<Integer>>
	blocks: Array<Array<Integer>>
	values: Array<Array<Integer>>
	instructions: Array<Array<Integer>>
	arguments: Array<Integer>
	array_regions: Array<Array<Integer>>
	facts: Array<Integer>
	literal_texts: Array<String>
end

def gate4_mir_range_valid(start: Integer, count: Integer, size: Integer): Boolean
	if start >= 0
		if count >= 0
			if start <= size
				return count <= size - start
			end
		end
	end
	return false
end

def gate4_mir_origin_valid(source: Integer, line: Integer, source_count: Integer): Boolean
	if source >= 0
		if source < source_count
			return line > 0
		end
	end
	return false
end

def gate4_mir_function_index(native_module: Gate4MirModule, function_id: Integer): Integer
	mut index := 0
	while index < native_module.functions.size()
		row := native_module.functions[index]
		if row.size() == 8
			if row[0] == function_id
				return index
			end
		end
		index += 1
	end
	return - 1
end

def gate4_mir_block_index(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		block_id: Integer,
	): Integer
	mut index := function[6]
	finish := index + function[7]
	while index < finish
		if native_module.blocks[index][0] == block_id
			return index
		end
		index += 1
	end
	return - 1
end

def gate4_mir_value_index(
		native_module: Gate4MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	mut index := 0
	while index < native_module.values.size()
		row := native_module.values[index]
		if row.size() == 5
			if row[0] == function_id
				if row[1] == value_id
					return index
				end
			end
		end
		index += 1
	end
	return - 1
end

def gate4_mir_value_type(
		native_module: Gate4MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	index := gate4_mir_value_index(native_module, function_id, value_id)
	if index < 0
		return 0
	end
	return native_module.values[index][2]
end

def gate4_mir_array_element_type(type_id: Integer): Integer
	if type_id == 3
		return 1
	end
	if type_id == 6
		return 5
	end
	return 0
end

def gate4_mir_argument_contains(
		native_module: Gate4MirModule,
		start: Integer,
		count: Integer,
		value_id: Integer,
	): Boolean
	mut index := start
	finish := start + count
	while index < finish
		if native_module.arguments[index] == value_id
			return true
		end
		index += 1
	end
	return false
end

def gate4_mir_value_available(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		block: Array<Integer>,
		instruction_finish: Integer,
		value_id: Integer,
	): Boolean
	if gate4_mir_argument_contains(native_module, function[4], function[5], value_id)
		return true
	end
	if gate4_mir_argument_contains(native_module, block[3], block[4], value_id)
		return true
	end
	mut index := block[5]
	while index < instruction_finish
		if native_module.instructions[index][1] == value_id
			return true
		end
		index += 1
	end
	return false
end

def gate4_mir_definition_count(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		value_id: Integer,
	): Integer
	mut count := 0
	mut index := function[4]
	mut finish := index + function[5]
	while index < finish
		if native_module.arguments[index] == value_id
			count += 1
		end
		index += 1
	end
	mut block_index := function[6]
	block_finish := block_index + function[7]
	while block_index < block_finish
		block := native_module.blocks[block_index]
		index = block[3]
		finish = index + block[4]
		while index < finish
			if native_module.arguments[index] == value_id
				count += 1
			end
			index += 1
		end
		index = block[5]
		finish = index + block[6]
		while index < finish
			if native_module.instructions[index][1] == value_id
				count += 1
			end
			index += 1
		end
		block_index += 1
	end
	return count
end

def gate4_mir_failure_error(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		failure: Integer,
	): String
	block_index := gate4_mir_block_index(native_module, function, failure)
	if block_index < 0
		return "MIR failure target does not exist"
	end
	if native_module.blocks[block_index][7] != 4
		return "MIR failure target is not a trap block"
	end
	return ""
end

def gate4_mir_exact_integer_literal(
		native_module: Gate4MirModule,
		instruction: Array<Integer>,
		text: String,
	): Boolean
	if instruction.size() != 8
		return false
	end
	if instruction[0] != 6
		return false
	end
	literal := instruction[4]
	if literal < 0
		return false
	end
	if literal >= native_module.literal_texts.size()
		return false
	end
	return native_module.literal_texts[literal] == text
end

def gate4_mir_induction_address(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		block: Array<Integer>,
		instruction: Array<Integer>,
	): Boolean
	if function[7] != 6
		return false
	end
	if function[5] != 1
		return false
	end
	array_type := gate4_mir_value_type(native_module, function[0], native_module.arguments[function[4]])
	if gate4_mir_array_element_type(array_type) == 0
		return false
	end
	entry := native_module.blocks[function[6]]
	header := native_module.blocks[function[6] + 1]
	body := native_module.blocks[function[6] + 2]
	exit := native_module.blocks[function[6] + 3]
	if block[0] != body[0]
		return false
	end
	if entry[7] != 1
		return false
	end
	if header[7] != 2
		return false
	end
	if body[7] != 1
		return false
	end
	if entry[9] != header[0]
		return false
	end
	if header[9] != body[0]
		return false
	end
	if header[10] != exit[0]
		return false
	end
	if body[9] != header[0]
		return false
	end
	if header[4] < 1
		return false
	end
	if header[4] > 2
		return false
	end
	if body[4] != header[4]
		return false
	end
	header_value := native_module.arguments[header[3]]
	body_value := native_module.arguments[body[3]]
	if instruction[3] != body_value
		return false
	end
	if native_module.arguments[header[11]] != header_value
		return false
	end
	if entry[6] != header[4]
		return false
	end
	if header[6] != 2
		return false
	end
	if body[6] != header[4] + 3
		return false
	end
	zero := native_module.instructions[entry[5]]
	if !gate4_mir_exact_integer_literal(native_module, zero, "0")
		return false
	end
	if native_module.arguments[entry[11]] != zero[1]
		return false
	end
	length := native_module.instructions[header[5]]
	comparison := native_module.instructions[header[5] + 1]
	if length[0] != 4
		return false
	end
	if comparison[0] != 7
		return false
	end
	if comparison[4] != 8
		return false
	end
	if comparison[2] != header_value
		return false
	end
	if comparison[3] != length[1]
		return false
	end
	if header[8] != comparison[1]
		return false
	end
	load := native_module.instructions[body[5] + 1]
	if load.size() != 8
		return false
	end
	if load[0] != 10
		return false
	end
	if load[2] != instruction[1]
		return false
	end
	one := native_module.instructions[body[5] + body[6] - 2]
	add := native_module.instructions[body[5] + body[6] - 1]
	if add.size() != 8
		return false
	end
	if !gate4_mir_exact_integer_literal(native_module, one, "1")
		return false
	end
	if add[0] != 7
		return false
	end
	if add[4] != 1
		if add[4] != 13
			return false
		end
	end
	if add[2] != body_value
		return false
	end
	if add[3] != one[1]
		return false
	end
	if native_module.arguments[body[11]] != add[1]
		return false
	end
	if header[4] == 1
		return true
	end
	if entry[12] != 2
		return false
	end
	if header[12] != 2
		return false
	end
	if header[14] != 1
		return false
	end
	if body[12] != 2
		return false
	end
	if exit[4] != 1
		return false
	end
	if !gate4_mir_range_valid(exit[3], 1, native_module.arguments.size())
		return false
	end
	accumulator_zero := native_module.instructions[entry[5] + 1]
	mut zero_literal := "0"
	if array_type == 6
		zero_literal = "0.0"
	end
	if !gate4_mir_exact_integer_literal(native_module, accumulator_zero, zero_literal)
		return false
	end
	header_accumulator := native_module.arguments[header[3] + 1]
	body_accumulator := native_module.arguments[body[3] + 1]
	exit_accumulator := native_module.arguments[exit[3]]
	if native_module.arguments[entry[11] + 1] != accumulator_zero[1]
		return false
	end
	if native_module.arguments[header[11] + 1] != header_accumulator
		return false
	end
	if native_module.arguments[header[13]] != header_accumulator
		return false
	end
	reduction := native_module.instructions[body[5] + 2]
	if reduction[0] != 7
		return false
	end
	if reduction[4] != 1
		if reduction[4] != 13
			return false
		end
	end
	if reduction[2] != body_accumulator
		return false
	end
	if reduction[3] != load[1]
		return false
	end
	if native_module.arguments[body[11] + 1] != reduction[1]
		return false
	end
	if exit[15] != exit_accumulator
		return false
	end
	return true
end

# A raw parameter-header region uses three-cell operations:
# 1 parameter (type, origin): type 0 scalar, 1 immutable Array, 2 mutable
# Array. Parameters are an ordered prefix; their row position is their ordinal.
# Parameter origins are declaration-table indexes; other origins are tokens.
# 4 parameter Array access (ordinal, origin);
# 6 opaque effect/control (0, origin).
# The result is a parameter ordinal, -1 for no reusable header, or -2 for
# malformed MIR. Parameters dominate every use and never leave lexical scope;
# this proof owns neither local aliases nor removal of any access check.
def gate4_mir_array_header(operations: Array<Integer>): Integer
	if operations.size() % 3 != 0
		return - 2
	end
	mut parameter_count := 0
	mut parameter_origin :=- 1
	mut selected :=- 1
	mut blocked := false
	mut index := 0
	while index < operations.size()
		kind := operations[index]
		slot := operations[index + 1]
		origin := operations[index + 2]
		if origin < 0
			return - 2
		end
		if slot < 0
			return - 2
		end
		if kind == 1
			if index != parameter_count * 3
				return - 2
			end
			if slot > 2
				return - 2
			end
			if origin <= parameter_origin
				return - 2
			end
			parameter_origin = origin
			parameter_count += 1
		else
			if kind == 4
				if slot >= parameter_count
					return - 2
				end
				binding_type := operations[slot * 3 + 1]
				if binding_type == 0
					return - 2
				end
				if binding_type == 1
					if selected == - 1
						selected = slot
					end
				end
			else
				if kind != 6
					return - 2
				end
				if slot != 0
					return - 2
				end
				blocked = true
			end
		end
		index += 3
	end
	if blocked
		return - 1
	end
	return selected
end

def gate4_optimize_verified_mir(mut native_module: Gate4MirModule)
	mut index := 0
	while index < native_module.instructions.size()
		mut instruction := native_module.instructions[index]
		if instruction[0] == 5
			if instruction[4] == 1
				instruction[4] = 2
			end
		end
		if instruction[0] == 7
			if instruction[5] >= 0
				if instruction[4] == 1
					instruction[4] = 13
				else
					if instruction[4] == 3
						instruction[4] = 12
					end
				end
			end
		end
		index += 1
	end
	index = 0
	while index < native_module.array_regions.size()
		header := gate4_mir_array_header(native_module.array_regions[index])
		if header < - 1
			return
		end
		if native_module.facts.size() == index
			native_module.facts.push(header)
		else
			native_module.facts[index] = header
		end
		index += 1
	end
	return
end

def gate4_mir_instruction_error(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		block: Array<Integer>,
		instruction_index: Integer,
	): String
	instruction := native_module.instructions[instruction_index]
	if instruction.size() != 8
		return "MIR instruction row size differs"
	end
	if !gate4_mir_origin_valid(instruction[6], instruction[7], native_module.source_count[0])
		return "MIR instruction origin is invalid"
	end
	function_id := function[0]
	result_type := gate4_mir_value_type(native_module, function_id, instruction[1])
	first_type := gate4_mir_value_type(native_module, function_id, instruction[2])
	second_type := gate4_mir_value_type(native_module, function_id, instruction[3])
	first_available := gate4_mir_value_available(
		native_module,
		function,
		block,
		instruction_index,
		instruction[2],
	)
	second_available := gate4_mir_value_available(
		native_module,
		function,
		block,
		instruction_index,
		instruction[3],
	)
	if instruction[0] == 1
		if result_type != 1
			return "MIR Integer constant result type differs"
		end
		if instruction[2] == - 1
			if instruction[3] == - 1
				if instruction[5] == - 1
					return ""
				end
			end
		end
		return "MIR Integer constant shape differs"
	end
	if instruction[0] == 2
		if instruction[4] != 0
			return "MIR checked Integer add shape differs"
		end
		if result_type == 1
			if first_available
				if first_type == 1
					if second_available
						if second_type == 1
							return gate4_mir_failure_error(native_module, function, instruction[5])
						end
					end
				end
			end
		end
		return "MIR checked Integer add type differs"
	end
	if instruction[0] == 3
		if instruction[4] == 0
			if instruction[5] == - 1
				if result_type == 2
					if first_available
						if first_type == 1
							if second_available
								if second_type == 1
									return ""
								end
							end
						end
					end
				end
				return "MIR Integer comparison type differs"
			end
		end
		return "MIR Integer comparison shape differs"
	end
	if instruction[0] == 4
		if instruction[3] == - 1
			if instruction[4] == 0
				if instruction[5] == - 1
					if result_type == 1
						if first_available
							if gate4_mir_array_element_type(first_type) > 0
								return ""
							end
						end
					end
					return "MIR Array length type differs"
				end
			end
		end
		return "MIR Array length shape differs"
	end
	if instruction[0] == 5
		if instruction[4] < 0
			return "MIR Array address shape differs"
		end
		if instruction[4] > 2
			return "MIR Array address shape differs"
		end
		if result_type == first_type + 1
			if first_available
				if gate4_mir_array_element_type(first_type) > 0
					if second_available
						if second_type == 1
							error := gate4_mir_failure_error(native_module, function, instruction[5])
							if error != ""
								return error
							end
							if instruction[4] >= 1
								if !gate4_mir_induction_address(native_module, function, block, instruction)
									return "MIR Array induction proof differs"
								end
							end
							return ""
						end
					end
				end
			end
		end
		return "MIR Array address type differs"
	end
	if instruction[0] == 6
		if instruction[2] < 0
			return "MIR scalar literal shape differs"
		end
		if instruction[2] > 1
			return "MIR scalar literal shape differs"
		end
		if instruction[3] != - 1
			return "MIR scalar literal shape differs"
		end
		if instruction[5] != - 1
			return "MIR scalar literal shape differs"
		end
		if instruction[4] < 0
			return "MIR scalar literal index is invalid"
		end
		if instruction[4] >= native_module.literal_texts.size()
			return "MIR scalar literal index is invalid"
		end
		literal := native_module.literal_texts[instruction[4]]
		if result_type == 1
			if !gate4_number_is_float(literal)
				if gate4_integer_literal_in_range(literal)
					mut expected_fact := 0
					if gate4_small_nonnegative_integer_operand(literal)
						expected_fact = 1
					end
					if instruction[2] == expected_fact
						return ""
					end
					return "MIR Integer literal fact differs"
				end
			end
			return "MIR Integer literal is invalid"
		end
		if result_type == 2
			if instruction[2] != 0
				return "MIR Boolean literal fact differs"
			end
			if literal == "true"
				return ""
			end
			if literal == "false"
				return ""
			end
			return "MIR Boolean literal is invalid"
		end
		if result_type == 5
			if instruction[2] != 0
				return "MIR Float literal fact differs"
			end
			if gate4_number_is_float(literal)
				if gate4_float_literal_in_range(literal)
					return ""
				end
			end
			return "MIR Float literal is invalid"
		end
		return "MIR scalar literal result type differs"
	end
	if instruction[0] == 7
		if !first_available
			return "MIR scalar binary operand is undefined"
		end
		if !second_available
			return "MIR scalar binary operand is undefined"
		end
		mut operator := instruction[4]
		if operator == 12
			operator = 3
		end
		if operator == 13
			operator = 1
		end
		mut numeric := false
		if first_type == 1
			if second_type == 1
				numeric = true
			end
			if second_type == 5
				numeric = true
			end
		end
		if first_type == 5
			if second_type == 1
				numeric = true
			end
			if second_type == 5
				numeric = true
			end
		end
		mut valid := false
		mut checked := false
		if operator >= 1
			if operator <= 4
				if numeric
					mut expected := 1
					if first_type == 5
						expected = 5
					end
					if second_type == 5
						expected = 5
					end
					valid = result_type == expected
					checked = expected == 1
				end
			else
				if operator == 5
					valid = first_type == 1
					if valid
						valid = second_type == 1
					end
					if valid
						valid = result_type == 1
					end
					checked = valid
				else
					if operator <= 11
						if result_type == 2
							if operator <= 7
								valid = numeric
								if !valid
									valid = first_type == second_type
								end
							else
								valid = numeric
							end
						end
					end
				end
			end
		end
		if !valid
			return "MIR scalar binary type differs"
		end
		if checked
			return gate4_mir_failure_error(native_module, function, instruction[5])
		end
		if instruction[5] != - 1
			return "MIR scalar binary failure shape differs"
		end
		return ""
	end
	if instruction[0] == 8
		if instruction[3] != - 1
			return "MIR scalar unary shape differs"
		end
		if instruction[5] != - 1
			return "MIR scalar unary shape differs"
		end
		if !first_available
			return "MIR scalar unary operand is undefined"
		end
		if instruction[4] == 1
			if first_type == 2
				if result_type == 2
					return ""
				end
			end
		else
			if instruction[4] == 2
				if first_type == result_type
					if result_type == 1
						return ""
					end
					if result_type == 5
						return ""
					end
				end
			end
			if instruction[4] == 3
				if first_type == result_type
					if result_type == 1
						return ""
					end
					if result_type == 5
						return ""
					end
				end
			end
		end
		return "MIR scalar unary type differs"
	end
	if instruction[0] == 9
		if instruction[3] == - 1
			if instruction[4] == 0
				if instruction[5] == - 1
					if first_available
						if first_type == 1
							if result_type == 5
								return ""
							end
						end
					end
				end
			end
		end
		return "MIR Integer-to-Float conversion type differs"
	end
	if instruction[0] == 10
		if instruction[3] == - 1
			if instruction[4] == 0
				if instruction[5] == - 1
					if first_available
						if result_type == gate4_mir_array_element_type(first_type - 1)
							return ""
						end
					end
				end
			end
		end
		return "MIR Array load type differs"
	end
	return "MIR instruction kind is unsupported"
end

def gate4_mir_target_arguments_error(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		block: Array<Integer>,
		target: Integer,
		start: Integer,
		count: Integer,
	): String
	target_index := gate4_mir_block_index(native_module, function, target)
	if target_index < 0
		return "MIR terminator target does not exist"
	end
	target_block := native_module.blocks[target_index]
	if count != target_block[4]
		return "MIR block argument arity differs"
	end
	mut index := 0
	while index < count
		value_id := native_module.arguments[start + index]
		if !gate4_mir_value_available(
				native_module,
				function,
				block,
				block[5] + block[6],
				value_id,
			)
			return "MIR block argument is undefined"
		end
		target_value := native_module.arguments[target_block[3] + index]
		actual_type := gate4_mir_value_type(native_module, function[0], value_id)
		target_type := gate4_mir_value_type(native_module, function[0], target_value)
		if actual_type != target_type
			return "MIR block argument type differs"
		end
		index += 1
	end
	return ""
end

def gate4_mir_terminator_error(
		native_module: Gate4MirModule,
		function: Array<Integer>,
		block: Array<Integer>,
	): String
	kind := block[7]
	if kind == 1
		if block[8] == - 1
			if block[10] == - 1
				if block[14] == 0
					if block[15] == - 1
						return gate4_mir_target_arguments_error(
							native_module,
							function,
							block,
							block[9],
							block[11],
							block[12],
						)
					end
				end
			end
		end
		return "MIR jump shape differs"
	end
	if kind == 2
		condition_type := gate4_mir_value_type(native_module, function[0], block[8])
		condition_available := gate4_mir_value_available(
			native_module,
			function,
			block,
			block[5] + block[6],
			block[8],
		)
		if condition_available
			if condition_type == 2
				if block[15] == - 1
					first := gate4_mir_target_arguments_error(
						native_module,
						function,
						block,
						block[9],
						block[11],
						block[12],
					)
					if first != ""
						return first
					end
					return gate4_mir_target_arguments_error(
						native_module,
						function,
						block,
						block[10],
						block[13],
						block[14],
					)
				end
			end
		end
		return "MIR branch shape differs"
	end
	if kind == 3
		if block[8] == - 1
			if block[9] == - 1
				if block[10] == - 1
					if block[12] == 0
						if block[14] == 0
							if block[15] >= 0
								if !gate4_mir_value_available(
										native_module,
										function,
										block,
										block[5] + block[6],
										block[15],
									)
									return "MIR return value is undefined"
								end
							end
							return ""
						end
					end
				end
			end
		end
		return "MIR return shape differs"
	end
	if kind == 4
		if block[8] == - 1
			if block[9] == - 1
				if block[10] == - 1
					if block[11] == 0
						if block[12] == 0
							if block[13] == 0
								if block[14] == 0
									if block[15] == - 1
										return ""
									end
								end
							end
						end
					end
				end
			end
		end
		return "MIR trap shape differs"
	end
	return "MIR terminator kind is unsupported"
end

def gate4_mir_function_error(native_module: Gate4MirModule, function: Array<Integer>): String
	if !gate4_mir_range_valid(function[4], function[5], native_module.arguments.size())
		return "MIR function parameter range is invalid"
	end
	if !gate4_mir_range_valid(function[6], function[7], native_module.blocks.size())
		return "MIR function block range is invalid"
	end
	if gate4_mir_block_index(native_module, function, function[1]) < 0
		return "MIR function entry block does not exist"
	end
	mut index := function[4]
	mut finish := index + function[5]
	while index < finish
		if gate4_mir_value_type(native_module, function[0], native_module.arguments[index]) == 0
			return "MIR function parameter is undefined"
		end
		index += 1
	end
	mut block_index := function[6]
	block_finish := block_index + function[7]
	while block_index < block_finish
		block := native_module.blocks[block_index]
		if block.size() != 16
			return "MIR block row size differs"
		end
		if !gate4_mir_origin_valid(block[1], block[2], native_module.source_count[0])
			return "MIR block origin is invalid"
		end
		mut previous := function[6]
		while previous < block_index
			if native_module.blocks[previous][0] == block[0]
				return "MIR block identifier is duplicated"
			end
			previous += 1
		end
		if !gate4_mir_range_valid(block[3], block[4], native_module.arguments.size())
			return "MIR block parameter range is invalid"
		end
		if !gate4_mir_range_valid(block[5], block[6], native_module.instructions.size())
			return "MIR block instruction range is invalid"
		end
		if !gate4_mir_range_valid(block[11], block[12], native_module.arguments.size())
			return "MIR terminator argument range is invalid"
		end
		if !gate4_mir_range_valid(block[13], block[14], native_module.arguments.size())
			return "MIR alternate argument range is invalid"
		end
		index = block[3]
		finish = index + block[4]
		while index < finish
			if gate4_mir_value_type(native_module, function[0], native_module.arguments[index]) == 0
				return "MIR block parameter is undefined"
			end
			index += 1
		end
		index = block[5]
		finish = index + block[6]
		while index < finish
			error := gate4_mir_instruction_error(native_module, function, block, index)
			if error != ""
				return error
			end
			index += 1
		end
		error := gate4_mir_terminator_error(native_module, function, block)
		if error != ""
			return error
		end
		block_index += 1
	end
	return ""
end

def gate4_verify_mir(native_module: Gate4MirModule, optimized: Boolean): String
	if native_module.source_count[0] <= 0
		return "MIR module has no sources"
	end
	mut entry_found := false
	mut index := 0
	if optimized
		if native_module.facts.size() != native_module.array_regions.size()
			return "MIR optimized Array-header fact is invalid"
		end
	else
		if native_module.facts.size() != 0
			return "MIR input cannot supply optimization facts"
		end
	end
	while index < native_module.array_regions.size()
		header := gate4_mir_array_header(native_module.array_regions[index])
		if header < - 1
			return "MIR Array region is invalid"
		end
		if optimized
			if native_module.facts[index] != header
				return "MIR optimized Array-header fact is invalid"
			end
		end
		index += 1
	end
	if native_module.functions.size() == 0
		return ""
	end
	index = 0
	while index < native_module.functions.size()
		function := native_module.functions[index]
		if function.size() != 8
			return "MIR function row size differs"
		end
		if function[0] < 0
			return "MIR function identifier is invalid"
		end
		if !gate4_mir_origin_valid(function[2], function[3], native_module.source_count[0])
			return "MIR function origin is invalid"
		end
		mut previous := 0
		while previous < index
			if native_module.functions[previous][0] == function[0]
				return "MIR function identifier is duplicated"
			end
			previous += 1
		end
		if function[0] == native_module.entry_function[0]
			entry_found = true
		end
		index += 1
	end
	if !entry_found
		return "MIR entry function does not exist"
	end
	index = 0
	while index < native_module.values.size()
		value := native_module.values[index]
		if value.size() != 5
			return "MIR value row size differs"
		end
		function_index := gate4_mir_function_index(native_module, value[0])
		if function_index < 0
			return "MIR value identity is invalid"
		end
		if value[1] < 0
			return "MIR value identity is invalid"
		end
		if value[2] < 1
			return "MIR value type is invalid"
		end
		if value[2] > 7
			return "MIR value type is invalid"
		end
		if !gate4_mir_origin_valid(value[3], value[4], native_module.source_count[0])
			return "MIR value origin is invalid"
		end
		mut previous := 0
		while previous < index
			other := native_module.values[previous]
			if other[0] == value[0]
				if other[1] == value[1]
					return "MIR value is defined more than once"
				end
			end
			previous += 1
		end
		function := native_module.functions[function_index]
		if gate4_mir_definition_count(native_module, function, value[1]) != 1
			return "MIR value definition count differs"
		end
		index += 1
	end
	index = 0
	while index < native_module.functions.size()
		error := gate4_mir_function_error(native_module, native_module.functions[index])
		if error != ""
			return error
		end
		index += 1
	end
	return ""
end
