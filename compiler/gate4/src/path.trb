def gate4_string_ends_with(value: String, suffix: String): Boolean
	if suffix.size() > value.size()
		return false
	end
	mut index := 0
	start := value.size() - suffix.size()
	while index < suffix.size()
		if value[start + index] != suffix[index]
			return false
		end
		index += 1
	end
	return true
end

def gate4_string_starts_with(value: String, prefix: String): Boolean
	if prefix.size() > value.size()
		return false
	end
	mut index := 0
	while index < prefix.size()
		if value[index] != prefix[index]
			return false
		end
		index += 1
	end
	return true
end

def gate4_string_without_suffix(value: String, suffix: String): String
	if !gate4_string_ends_with(value, suffix)
		return value
	end
	mut result := ""
	mut index := 0
	finish := value.size() - suffix.size()
	while index < finish
		result += value[index]
		index += 1
	end
	return result
end

def gate4_path_directory(path: String): String
	mut slash :=- 1
	mut index := 0
	while index < path.size()
		if path[index] == "/"
			slash = index
		end
		index += 1
	end
	if slash < 0
		return "."
	end
	if slash == 0
		return "/"
	end
	mut result := ""
	index = 0
	while index < slash
		result += path[index]
		index += 1
	end
	return result
end

def gate4_path_basename(path: String): String
	mut slash :=- 1
	mut index := 0
	while index < path.size()
		if path[index] == "/"
			slash = index
		end
		index += 1
	end
	mut result := ""
	index = slash + 1
	while index < path.size()
		result += path[index]
		index += 1
	end
	return result
end

def gate4_path_join(root: String, relative: String): String
	if root == "/"
		return root + relative
	end
	return root + "/" + relative
end
