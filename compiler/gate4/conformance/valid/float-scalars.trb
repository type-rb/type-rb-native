	if 1.0 >= 1
	else
		ok = false
	end
	if 1.0 <= 1.0
	else
		ok = false
	end
	if 1.0 >= 1.0
	else
		ok = false
	end
	if separated == 10.5
	else
		ok = false
	end
	if minimum > 0.0
