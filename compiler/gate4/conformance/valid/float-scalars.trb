		ok = false
	end
	if maximum > 1.0
	else
		ok = false
	end
	if maximum - maximum == 0.0
	else
		ok = false
	end
	if positive_infinity > 1.0
	else
		ok = false
	end
	if negative_infinity < - 1.0
	else
		ok = false
	end
	if not_a_number != not_a_number
	else
