	end
	if 1 == 1.0
	else
		ok = false
	end
	if 1.0 == 1
	else
		ok = false
	end
	if 1 != 2.0
	else
		ok = false
	end
	if 1.0 != 2
	else
		ok = false
	end
	if 1 < 1.5
	else
		ok = false
	end
	if 1.5 < 2
	else
		ok = false
	end
	if 2 > 1.5
	else
		ok = false
	end
	if 1.5 > 1
	else
		ok = false
	end
	if 1 <= 1.0
	else
		ok = false
	end
	if 1.0 <= 1
	else
		ok = false
