record FloatBox
	value: Float
end

def widened(value: Integer): Float
	return value
end

def combine(left: Float, right: Float): Float
	return (left + right) * 2.0 / 4.0 - 0.25
end

def main()
	mut ok := true
	mut box := FloatBox.new(value: 1)
	box.value = combine(box.value, 2)
	mut value: Float := box.value
	value += 1
	value -= 0.5
	value *= 2
	value /= 2.0
	mut assigned: Float := 0
	assigned = 2
	assigned += 1
	separated := 1_0.5_0
	minimum := 0.
	negative_underflow :=- 0.
	maximum := .0
	positive_infinity := 1.0 / 0.0
	negative_zero :=- 0.0
	negative_infinity := 1.0 / negative_zero
	not_a_number := 0.0 / 0.0
	if value == 1.75
	else
		ok = false
	end
	if + value == value
	else
		ok = false
	end
	if assigned == 3.0
	else
