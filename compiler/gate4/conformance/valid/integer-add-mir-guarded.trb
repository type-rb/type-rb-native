def sum(left: Integer, right: Integer): Integer
	return left + right
end

def main()
	lefts := [1, 0, 4503599627370495, - 1, 4503599627370496, 9007199254740991]
	rights := [2, 0, 4503599627370495, 2, 1, 0]
	mut index := 0
	while index < lefts.size()
		puts(sum(lefts[index], rights[index]).to_s())
		index += 1
	end
	return
end
