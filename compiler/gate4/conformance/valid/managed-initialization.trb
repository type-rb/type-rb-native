record ManagedEnvelope
	label: String
	values: Array<String>
	count: Integer
end

record ScalarEnvelope
	count: Integer
	ready: Boolean
end

def churn(): String
	mut index := 0
	while index < 40000
		discarded := "garbage-" + index.to_s()
		if discarded == ""
			puts("unexpected")
		end
		index += 1
	end
	return "ready"
end

def main()
	managed := ManagedEnvelope.new(label: churn(), values: ["kept"], count: 1)
	scalar := ScalarEnvelope.new(count: managed.count, ready: true)
	if scalar.ready
		puts(managed.label)
		puts(managed.values[- 1])
		puts(scalar.count.to_s())
	end
	return
end
