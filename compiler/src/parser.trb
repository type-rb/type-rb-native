import { NewtypeDefinition } from newtype_model
import { newtype_type } from newtype_types
import { parse_newtype_header } from newtype_syntax
import { generic_application } from generic_arguments
import { GlobalDeclaration } from global_model
import { TransformSyntax, transform_kind } from transform_model
import { NamespaceDeclaration, namespace_qualify } from namespace_model
import { enum_type, enum_uppercase } from enum_types
import { expand_quoted_token } from literal_syntax
import { parse_type_alias } from alias_syntax
import { LambdaSyntax } from callable_types
import { parse_lambda_parameters } from lambda_syntax
import { GenericDefinition, GenericField, GenericFunction, GenericParameter, GenericVariant } from generic_model
import { CatchSyntax } from result_model
import { nominal_application_end, nominal_application_name, parse_generic_parameters } from generic_syntax
import { advance, expect, expect_identifier, finish_statement, parse_type, skip_newlines, token_is, valid_identifier } from syntax_tokens
import { parse_enum } from enum_syntax
import iteration_syntax
import { CompilerState, ControlBranch, ControlSyntax, DefaultInitializer, diagnostic, function_index_key, has_diagnostic, terminal_token } from state
import { load_integer, load_string, sparse_integer_at, sparse_string_at, store_integer, store_string } from storage

def declaration_start(state: CompilerState, index: Integer): Boolean
	if token_is(state, index, "mut")
		return true
	end
	if load_integer(state.token_kinds, index) != 1
		return false
	end
	if token_is(state, index + 1, ":=")
		return true
	end
	return token_is(state, index + 1, ":")
end

def syntax_block_end(state: CompilerState, index: Integer): Boolean
	kind := load_integer(state.token_kinds, index)
	if kind != 1
		if kind != 5
			return false
		end
	end
	word := load_string(state.token_texts, index)
	if word == "end"
		return true
	end
	return word == "}"
end

def syntax_conditional_tail(state: CompilerState, index: Integer): Boolean
	if token_is(state, index, "else")
		return true
	end
	if token_is(state, index, "elsif")
		return true
	end
	return token_is(state, index, "when")
end

def syntax_expression_precedence(operator: String): Integer
	if operator == ".." || operator == "..."
		return 3
	end
	# Keep scalar spelling recognition in the shared operator catalog.
	identity := binary_operator_id(operator)
	if identity == 0
		return 0
	end
	if identity <= 2
		return 6
	end
	if identity <= 5
		return 7
	end
	if identity <= 7
		return 4
	end
	if identity <= 11
		return 5
	end
	if identity == 12
		return 1
	end
	if identity == 13
		return 2
	end
	return 0
end

def parse_argument_label(state: CompilerState, mut position: Array<Integer>): String
	if load_integer(state.token_kinds, position[0]) == 1 && token_is(state, position[0] + 1, ":")
		label := load_string(state.token_texts, position[0])
		position[0] += 2
		return label
	end
	return ""
end

def parse_arguments_syntax(mut state: CompilerState, mut position: Array<Integer>): Boolean
	skip_newlines(state, position)
	if token_is(state, position[0], ")")
		advance(position)
		return true
	end
	mut finished := false
	while !finished
		skip_newlines(state, position)
		if token_is(state, position[0], ")")
			finished = true
		else
			if load_integer(state.token_kinds, position[0]) == 1
				if token_is(state, position[0] + 1, ":")
					if !valid_identifier(state, position[0])
						return false
					end
					advance(position)
					advance(position)
				end
			end
			if !parse_expression_syntax(state, position, 1)
				return false
			end
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	skip_newlines(state, position)
	return expect(state, position, ")")
end

def syntax_iteration_suffix(state: CompilerState, origin: Integer): Integer
	if (!token_is(state, origin, ".") && !token_is(state, origin, "&.")) || (!token_is(state, origin + 1, "each") && !token_is(state, origin + 1, "each_slice"))
		return - 1
	end
	mut cursor := origin + 2
	if token_is(state, origin + 1, "each_slice") && token_is(state, cursor, "(")
		mut depth := 1
		cursor += 1
		while cursor < state.token_count[0] && depth > 0
			if token_is(state, cursor, "(")
				depth += 1
			elsif token_is(state, cursor, ")")
				depth -= 1
			end
			cursor += 1
		end
		if depth != 0
			return - 1
		end
	elsif token_is(state, cursor, "(") && token_is(state, cursor + 1, ")")
		cursor += 2
	end
	if token_is(state, cursor, ".") && token_is(state, cursor + 1, "with_index")
		cursor += 2
		if token_is(state, cursor, "(") && token_is(state, cursor + 1, ")")
			cursor += 2
		end
	end
	if token_is(state, cursor, "do") || token_is(state, cursor, "{")
		return cursor
	end
	return - 1
end

# A name such as map/select may also be an ordinary nominal method.
# Only an actual block suffix selects collection-transform syntax.
def syntax_transform_suffix(state: CompilerState, origin: Integer): Integer
	if (!token_is(state, origin, ".") && !token_is(state, origin, "&.")) || transform_kind(load_string(state.token_texts, origin + 1)) == 0
		return - 1
	end
	mut cursor := origin + 2
	if token_is(state, cursor, "(")
		mut depth := 1
		cursor += 1
		while cursor < state.token_count[0] && depth > 0
			if token_is(state, cursor, "(")
				depth += 1
			elsif token_is(state, cursor, ")")
				depth -= 1
			end
			cursor += 1
		end
		if depth != 0
			return - 1
		end
	end
	if token_is(state, cursor, ".") && token_is(state, cursor + 1, "with_index")
		cursor += 2
		if token_is(state, cursor, "(") && token_is(state, cursor + 1, ")")
			cursor += 2
		end
	end
	if token_is(state, cursor, "do") || token_is(state, cursor, "{")
		return cursor
	end
	return - 1
end

def parse_iteration_statement(mut state: CompilerState, mut position: Array<Integer>, origin: Integer): Boolean
	receiver_finish := position[0]
	delimiter := syntax_iteration_suffix(state, receiver_finish)
	if delimiter < 0
		return false
	end
	brace := token_is(state, delimiter, "{")
	mut slice_start :=- 1
	mut slice_finish :=- 1
	position[0] = receiver_finish + 2
	if token_is(state, receiver_finish + 1, "each_slice")
		if !expect(state, position, "(")
			return false
		end
		skip_newlines(state, position)
		slice_start = position[0]
		if !parse_expression_syntax(state, position, 1)
			return false
		end
		slice_finish = position[0]
		skip_newlines(state, position)
		if token_is(state, position[0], ",")
			advance(position)
			skip_newlines(state, position)
		end
		if !expect(state, position, ")")
			return false
		end
	end
	mut indexed := false
	mut scan := position[0]
	while scan < delimiter
		if token_is(state, scan, "with_index")
			indexed = true
		end
		scan += 1
	end
	position[0] = delimiter + 1
	if !expect(state, position, "|")
		return false
	end
	element_origin := position[0]
	expect_identifier(state, position)
	mut second_origin :=- 1
	if indexed || token_is(state, position[0], ",")
		if !expect(state, position, ",")
			return false
		end
		second_origin = position[0]
		expect_identifier(state, position)
	end
	if !expect(state, position, "|")
		return false
	end
	if brace
		skip_newlines(state, position)
	elsif !finish_statement(state, position)
		return false
	end
	body_start := position[0]
	mut terminator := "end"
	if brace
		terminator = "}"
	end
	if !parse_statement_block(state, position)
		return false
	end
	body_finish := position[0]
	if !expect(state, position, terminator)
		return false
	end
	# Re-parsing unreachable syntax must not replace an already checked plan.
	if sparse_integer_at(state.iteration_origins, origin) == 0
		state.iterations.push(IterationSyntax.new(origin: origin, receiver_finish: receiver_finish, slice_start: slice_start, slice_finish: slice_finish, element_origin: element_origin, second_origin: second_origin, body_start: body_start, body_finish: body_finish, finish: position[0]))
		store_integer(state.iteration_origins, origin, state.iterations.size())
		store_integer(state.iteration_origins, body_finish, - state.iterations.size())
	end
	return finish_statement(state, position)
end

def parse_primary_syntax(mut state: CompilerState, mut position: Array<Integer>): Boolean
	if !expand_quoted_token(state, position[0], true)
		return false
	end
	symbol := token_is(state, position[0], ":")
	if symbol
		advance(position)
		if !expand_quoted_token(state, position[0], false)
			return false
		end
		kind := load_integer(state.token_kinds, position[0])
		if kind == 0 || kind == 4 || kind == 6
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "expected a Symbol literal name")
			return false
		end
		store_integer(state.token_kinds, position[0], 3)
		advance(position)
	end
	if !symbol && token_is(state, position[0], "try")
		advance(position)
		return parse_primary_syntax(state, position)
	end
	mut control := false
	mut lambda := false
	mut hash_literal := false
	if !symbol
		control = token_is(state, position[0], "if")
		if !control
			control = token_is(state, position[0], "case")
		end
		lambda = token_is(state, position[0], "fn")
		hash_literal = token_is(state, position[0], "{")
	end
	if control && !parse_control_syntax(state, position)
		return false
	end
	if lambda && !parse_lambda_syntax(state, position)
		return false
	end
	if hash_literal
		advance(position)
		skip_newlines(state, position)
		while !token_is(state, position[0], "}")
			key_start := position[0]
			if !parse_expression_syntax(state, position, 1)
				return false
			end
			if token_is(state, position[0], ":")
				mut first := key_start
				mut last := position[0] - 1
				while first < last && token_is(state, first, "(") && token_is(state, last, ")")
					first += 1
					last -= 1
					while first < last && load_integer(state.token_kinds, first) == 4
						first += 1
					end
				end
				# Parentheses preserve an identifier label; other expressions retain
				# their evaluated key and are checked against the Hash key types.
				if first == last && load_integer(state.token_kinds, first) == 1 && !token_is(state, first, "true") && !token_is(state, first, "false") && !token_is(state, first, "nil")
					store_integer(state.token_kinds, first, 3)
				end
				store_string(state.token_texts, position[0], "=>")
			end
			if !expect(state, position, "=>")
				return false
			end
			if !parse_expression_syntax(state, position, 1)
				return false
			end
			skip_newlines(state, position)
			if !token_is(state, position[0], ",")
				break
			end
			advance(position)
			skip_newlines(state, position)
		end
		if !expect(state, position, "}")
			return false
		end
	end
	kind := load_integer(state.token_kinds, position[0])
	if hash_literal || control || lambda || symbol
	elsif kind == 1
		application_end := nominal_application_end(state, position[0])
		if application_end >= 0
			position[0] = nominal_application_name(state, position[0])
			parse_type(state, position)
		else
			advance(position)
		end
	else
		if kind == 2
			advance(position)
		else
			if kind == 3
				advance(position)
			else
				if token_is(state, position[0], "(")
					advance(position)
					skip_newlines(state, position)
					if !parse_expression_syntax(state, position, 1)
						return false
					end
					if !expect(state, position, ")")
						return false
					end
				else
					if token_is(state, position[0], "[")
						advance(position)
						skip_newlines(state, position)
						if !token_is(state, position[0], "]")
							mut finished := false
							while !finished
								if token_is(state, position[0], "]")
									finished = true
								else
									if !parse_expression_syntax(state, position, 1)
										return false
									end
									if token_is(state, position[0], ",")
										advance(position)
										skip_newlines(state, position)
									else
										finished = true
									end
								end
							end
						end
						skip_newlines(state, position)
						if !expect(state, position, "]")
							return false
						end
					else
						if token_is(state, position[0], "!")
							advance(position)
							return parse_primary_syntax(state, position)
						end
						if token_is(state, position[0], "-")
							advance(position)
							return parse_primary_syntax(state, position)
						end
						if token_is(state, position[0], "+")
							advance(position)
							return parse_primary_syntax(state, position)
						end
						diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "expected an expression")
						return false
					end
				end
			end
		end
	end
	mut postfix := true
	while postfix
		if token_is(state, position[0], "(")
			advance(position)
			skip_newlines(state, position)
			if !parse_arguments_syntax(state, position)
				return false
			end
		else
			if syntax_transform_suffix(state, position[0]) >= 0
				if !parse_transform_syntax(state, position)
					return false
				end
				next
			end
			if token_is(state, position[0], ".") || token_is(state, position[0], "&.") || token_is(state, position[0], "::")
				advance(position)
				member := expect_identifier(state, position)
				if (member == "each" || member == "each_slice") && syntax_iteration_suffix(state, position[0] - 2) >= 0
					position[0] -= 2
					break
				end
				if has_diagnostic(state)
					return false
				end
				if token_is(state, position[0], "(")
					advance(position)
					skip_newlines(state, position)
					if !parse_arguments_syntax(state, position)
						return false
					end
				end
			else
				if token_is(state, position[0], "[")
					advance(position)
					skip_newlines(state, position)
					if !parse_expression_syntax(state, position, 1)
						return false
					end
					if !expect(state, position, "]")
						return false
					end
				else
					postfix = false
				end
			end
		end
	end
	return true
end

def parse_lambda_syntax(mut state: CompilerState, mut position: Array<Integer>): Boolean
	origin := position[0]
	advance(position)
	parameters := parse_lambda_parameters(state, position)
	if has_diagnostic(state)
		return false
	end
	mut result_type := "Void"
	if token_is(state, position[0], ":")
		advance(position)
		result_type = parse_type(state, position)
		if result_type == "Void"
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, origin), "fn without a result must omit the return annotation")
			return false
		end
	end
	if !finish_statement(state, position)
		return false
	end
	body_start := position[0]
	if !parse_statement_block(state, position)
		return false
	end
	body_finish := position[0]
	if !expect(state, position, "end")
		return false
	end
	# Unreachable syntax may be parsed again after resolution. Never replace
	# immutable syntax or register a lambda in the ordinary function catalog.
	if sparse_integer_at(state.lambda_origins, origin) == 0
		state.lambdas.push(LambdaSyntax.new(origin: origin, parameters: parameters, result_type: result_type, body_start: body_start, body_finish: body_finish, finish: position[0]))
		store_integer(state.lambda_origins, origin, state.lambdas.size())
	end
	return !has_diagnostic(state)
end

def parse_binary_syntax(
		mut state: CompilerState,
		mut position: Array<Integer>,
		minimum_precedence: Integer,
	): Boolean
	if !parse_primary_syntax(state, position)
		return false
	end
	mut scanning := true
	while scanning
		precedence := syntax_expression_precedence(load_string(state.token_texts, position[0]))
		if precedence < minimum_precedence
			scanning = false
		else
			advance(position)
			skip_newlines(state, position)
			if !parse_expression_syntax(state, position, precedence + 1)
				return false
			end
		end
	end
	return true
end

def parse_expression_syntax(mut state: CompilerState, mut position: Array<Integer>, minimum_precedence: Integer): Boolean
	if !parse_binary_syntax(state, position, minimum_precedence)
		return false
	end
	if minimum_precedence == 1 && token_is(state, position[0], "?")
		origin := position[0]
		advance(position)
		skip_newlines(state, position)
		first := position[0]
		if !parse_binary_syntax(state, position, 1)
			return false
		end
		first_finish := position[0]
		if !expect(state, position, ":")
			return false
		end
		skip_newlines(state, position)
		second := position[0]
		if !parse_binary_syntax(state, position, 1)
			return false
		end
		if token_is(state, position[0], "?")
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "nested conditional expressions must be parenthesized")
			return false
		end
		publish_control(state, ControlSyntax.new(kind: 3, origin: origin, finish: position[0], selector: - 1, selector_finish: - 1, branches: [ControlBranch.new(condition: - 1, condition_finish: - 1, body: first, finish: first_finish), ControlBranch.new(condition: - 1, condition_finish: - 1, body: second, finish: position[0])]))
	end
	return true
end

def syntax_statement_boundary(state: CompilerState, origin: Integer): Boolean
	if load_integer(state.token_kinds, origin) == 4
		return true
	end
	return token_is(state, origin, "}")
end

def parse_declaration_statement(mut state: CompilerState, mut position: Array<Integer>): Boolean
	# The reference treats a statement-leading next as loop control, not a
	# binding. Keep contextual identifiers (including mut next) unchanged.
	if token_is(state, position[0], "next")
		diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "next does not take a value")
		return false
	end
	if token_is(state, position[0], "mut")
		advance(position)
	end
	expect_identifier(state, position)
	if has_diagnostic(state)
		return false
	end
	if token_is(state, position[0], ":")
		advance(position)
		parse_type(state, position)
	end
	if !expect(state, position, ":=")
		return false
	end
	if !parse_statement_value_syntax(state, position)
		return false
	end
	return finish_statement(state, position)
end

def parse_simple_statement(mut state: CompilerState, mut position: Array<Integer>): Boolean
	origin := position[0]
	if !parse_statement_value_syntax(state, position)
		return false
	end
	operator := load_string(state.token_texts, position[0])
	if (operator == "." || operator == "&.") && syntax_iteration_suffix(state, position[0]) >= 0
		return parse_iteration_statement(state, position, origin)
	end
	if operator == "="
		advance(position)
		if !parse_statement_value_syntax(state, position)
			return false
		end
	else
		if binary_operator_id(operator) >= 17
			advance(position)
			if !parse_statement_value_syntax(state, position)
				return false
			end
		end
	end
	return finish_statement(state, position)
end

def syntax_loop_transfer_kind(state: CompilerState, origin: Integer): Integer
	if token_is(state, origin, "break")
		return 1
	end
	if token_is(state, origin, "next")
		return 2
	end
	return 0
end

def parse_statement_block(mut state: CompilerState, mut position: Array<Integer>): Boolean
	skip_newlines(state, position)
	while true
		if terminal_token(state, position[0])
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "expected end")
			break
		elsif syntax_block_end(state, position[0])
			break
		elsif syntax_conditional_tail(state, position[0])
			break
		elsif token_is(state, position[0], "if") || token_is(state, position[0], "case")
			parse_control_syntax(state, position)
			finish_statement(state, position)
		elsif token_is(state, position[0], "while")
			origin := position[0]
			advance(position)
			if parse_expression_syntax(state, position, 1)
				if finish_statement(state, position)
					parse_statement_block(state, position)
					if expect(state, position, "end")
						store_integer(state.loop_finishes, origin, position[0])
						finish_statement(state, position)
					end
				end
			end
		elsif syntax_loop_transfer_kind(state, position[0]) > 0 || token_is(state, position[0], "return")
			parse_transfer_syntax(state, position)
		elsif declaration_start(state, position[0])
			parse_declaration_statement(state, position)
		else
			parse_simple_statement(state, position)
		end
		if has_diagnostic(state)
			break
		end
	end
	return !has_diagnostic(state)
end

def parse_default_initializer(mut state: CompilerState, mut position: Array<Integer>, kind: Integer, owner: Integer, slot: Integer): Boolean
	advance(position)
	start := position[0]
	if !parse_expression_syntax(state, position, 1)
		return false
	end
	state.default_initializers.push(DefaultInitializer.new(kind: kind, owner: owner, slot: slot, start: start, finish: position[0]))
	state.default_functions.push(- 1)
	if kind == 0
		store_integer(state.parameter_defaults, slot, state.default_initializers.size())
	else
		store_integer(state.field_defaults, slot, state.default_initializers.size())
	end
	return true
end

def parse_record(mut state: CompilerState, mut position: Array<Integer>): Boolean
	line := load_integer(state.token_lines, position[0])
	advance(position)
	name := namespace_qualify(state.declaration_owner[0], expect_identifier(state, position))
	mut parameters: Array<String> := []
	mut fields: Array<GenericField> := []
	if token_is(state, position[0], "<")
		parameters = parse_generic_parameters(state, position, line)
	end
	if !finish_statement(state, position)
		return false
	end
	record_index := state.record_count[0]
	if parameters.size() == 0
		store_string(state.record_names, record_index, name)
		store_integer(state.record_modules, record_index, state.active_module[0])
		store_integer(state.record_field_starts, record_index, state.field_count[0])
		store_integer(state.record_lines, record_index, line)
	end
	mut count := 0
	mut default_seen := false
	while !token_is(state, position[0], "end")
		if terminal_token(state, position[0])
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "expected end for record " + name)
			return false
		end
		field_line := load_integer(state.token_lines, position[0])
		field_name := expect_identifier(state, position)
		if !expect(state, position, ":")
			return false
		end
		field_type := parse_type(state, position)
		mut default_start :=- 1
		mut default_finish :=- 1
		if token_is(state, position[0], "=")
			if parameters.size() > 0
				advance(position)
				default_start = position[0]
				if !parse_expression_syntax(state, position, 1)
					return false
				end
				default_finish = position[0]
			elsif !parse_default_initializer(state, position, 1, record_index, state.field_count[0])
				return false
			end
			default_seen = true
		elsif default_seen
			diagnostic(state, "TRBN4002", field_line, "required record field cannot follow a default field")
			return false
		end
		if !finish_statement(state, position)
			return false
		end
		if parameters.size() > 0
			fields.push(GenericField.new(name: field_name, type_name: field_type, line: field_line, named_only: true, default_start: default_start, default_finish: default_finish))
		else
			field_index := state.field_count[0]
			store_string(state.field_names, field_index, field_name)
			store_string(state.field_types, field_index, field_type)
			store_integer(state.field_lines, field_index, field_line)
			state.field_count[0] = field_index + 1
		end
		count += 1
	end
	advance(position)
	if parameters.size() > 0
		variant := GenericVariant.new(name: name, line: line, fields: fields)
		state.generic_definitions.push(GenericDefinition.new(kind: 1, name: name, source_id: state.active_module[0], line: line, parameters: parameters, variants: [variant]))
	else
		store_integer(state.record_field_counts, record_index, count)
		state.record_count[0] = record_index + 1
	end
	return finish_statement(state, position)
end

def parse_function(mut state: CompilerState, mut position: Array<Integer>, receiver_type: String, outer_parameters: Array<String>): Boolean
	line := load_integer(state.token_lines, position[0])
	advance(position)
	mut name := expect_identifier(state, position)
	if name == "self" && token_is(state, position[0], ".")
		if receiver_type != ""
			diagnostic(state, "TRBN4002", line, "enum class methods are not supported")
			return false
		end
		if state.declaration_owner[0] == ""
			diagnostic(state, "TRBN4002", line, "class method requires a declaration owner")
			return false
		end
		advance(position)
		name = expect_identifier(state, position)
	elsif state.declaration_owner[0] != "" && receiver_type == ""
		diagnostic(state, "TRBN4002", line, "module methods currently require def self.name")
		return false
	end
	name = namespace_qualify(state.declaration_owner[0], name)
	mut type_parameters: Array<String> := []
	outer_parameters.each do |parameter|
		type_parameters.push(parameter)
	end
	mut generic_parameters: Array<GenericParameter> := []
	if token_is(state, position[0], "<")
		type_parameters = parse_generic_parameters(state, position, line)
		if state.declaration_owner[0] != ""
			diagnostic(state, "TRBN4002", line, "module methods do not support type parameters")
			return false
		end
	end
	if !expect(state, position, "(")
		return false
	end
	skip_newlines(state, position)
	parameter_start := state.parameter_count[0]
	mut parameter_count := 0
	if receiver_type != ""
		if type_parameters.size() > 0
			generic_parameters.push(GenericParameter.new(name: "self", type_name: receiver_type, line: line, mutable: 0, named_only: 0, default_start: - 1, default_finish: - 1))
		else
			store_string(state.parameter_names, parameter_start, "self")
			store_string(state.parameter_types, parameter_start, receiver_type)
			store_integer(state.parameter_mutable, parameter_start, 0)
			store_integer(state.parameter_named_only, parameter_start, 0)
			store_integer(state.parameter_lines, parameter_start, line)
			state.parameter_count[0] += 1
		end
		parameter_count = 1
	end
	mut named_only := 0
	mut named_count := 0
	mut default_seen := false
	if !token_is(state, position[0], ")")
		mut finished := false
		while !finished
			skip_newlines(state, position)
			if token_is(state, position[0], ")")
				finished = true
			elsif token_is(state, position[0], "*")
				if named_only == 1
					diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "parameter list has more than one named-only boundary")
					return false
				end
				named_only = 1
				default_seen = false
				advance(position)
				if !expect(state, position, ",")
					return false
				end
			else
				mut mutable := 0
				if token_is(state, position[0], "mut")
					mutable = 1
					advance(position)
				end
				parameter_line := load_integer(state.token_lines, position[0])
				parameter_name := expect_identifier(state, position)
				if !expect(state, position, ":")
					return false
				end
				parameter_type := parse_type(state, position)
				parameter_index := state.parameter_count[0]
				mut default_start :=- 1
				mut default_finish :=- 1
				if token_is(state, position[0], "=")
					if type_parameters.size() > 0
						advance(position)
						default_start = position[0]
						if !parse_expression_syntax(state, position, 1)
							return false
						end
						default_finish = position[0]
					elsif !parse_default_initializer(state, position, 0, state.function_count[0], parameter_index)
						return false
					end
					default_seen = true
				elsif default_seen
					diagnostic(state, "TRBN4002", parameter_line, "required parameter cannot follow a default parameter in the same parameter group")
					return false
				end
				if type_parameters.size() > 0
					generic_parameters.push(GenericParameter.new(name: parameter_name, type_name: parameter_type, line: parameter_line, mutable: mutable, named_only: named_only, default_start: default_start, default_finish: default_finish))
				else
					store_string(state.parameter_names, parameter_index, parameter_name)
					store_string(state.parameter_types, parameter_index, parameter_type)
					store_integer(state.parameter_mutable, parameter_index, mutable)
					store_integer(state.parameter_named_only, parameter_index, named_only)
					store_integer(state.parameter_lines, parameter_index, parameter_line)
					state.parameter_count[0] = parameter_index + 1
				end
				named_count += named_only
				parameter_count += 1
				if token_is(state, position[0], ",")
					advance(position)
					skip_newlines(state, position)
				else
					finished = true
				end
			end
		end
	end
	if named_only == 1 && named_count == 0
		diagnostic(state, "TRBN4002", line, "named-only boundary requires a parameter")
		return false
	end
	skip_newlines(state, position)
	if !expect(state, position, ")")
		return false
	end
	mut result_type := "Void"
	if token_is(state, position[0], ":")
		advance(position)
		result_type = parse_type(state, position)
	end
	if !finish_statement(state, position)
		return false
	end
	body_start := position[0]
	if !parse_statement_block(state, position)
		return false
	end
	body_end := position[0]
	if !expect(state, position, "end")
		return false
	end
	if !finish_statement(state, position)
		return false
	end
	if type_parameters.size() > 0
		state.generic_functions.push(GenericFunction.new(receiver_type: receiver_type, name: name, source_id: state.active_module[0], line: line, type_parameters: type_parameters, parameters: generic_parameters, result_type: result_type, body_start: body_start, body_finish: body_end))
		return true
	end
	function_index := state.function_count[0]
	store_string(state.function_receivers, function_index, receiver_type)
	store_string(state.function_names, function_index, name)
	store_integer(state.function_modules, function_index, state.active_module[0])
	store_integer(state.function_parameter_starts, function_index, parameter_start)
	store_integer(state.function_parameter_counts, function_index, parameter_count)
	store_string(state.function_result_types, function_index, result_type)
	store_integer(state.function_body_starts, function_index, body_start)
	store_integer(state.function_body_ends, function_index, body_end)
	store_integer(state.function_lines, function_index, line)
	state.function_lookup[function_index_key(state.active_module[0], name)] = function_index
	state.function_count[0] = function_index + 1
	return true
end

def append_import(
		mut state: CompilerState,
		path: String,
		declaration: String,
		binding: String,
		kind: Integer,
		line: Integer,
	): Integer
	import_index := state.import_count[0]
	store_integer(state.import_modules, import_index, state.active_module[0])
	store_string(state.import_paths, import_index, path)
	store_string(state.import_symbols, import_index, binding)
	store_string(state.import_declarations, import_index, declaration)
	store_integer(state.import_kinds, import_index, kind)
	store_integer(state.import_lines, import_index, line)
	store_integer(state.import_targets, import_index, - 1)
	store_integer(state.import_used, import_index, 0)
	state.import_count[0] = import_index + 1
	return import_index
end

def parse_named_import(mut state: CompilerState, mut position: Array<Integer>, line: Integer): Boolean
	advance(position)
	skip_newlines(state, position)
	import_start := state.import_count[0]
	mut finished := false
	while !finished
		if token_is(state, position[0], "}")
			finished = true
		else
			symbol_line := load_integer(state.token_lines, position[0])
			declaration := expect_identifier(state, position)
			if has_diagnostic(state)
				return false
			end
			skip_newlines(state, position)
			mut binding := declaration
			if token_is(state, position[0], "as")
				advance(position)
				skip_newlines(state, position)
				binding = expect_identifier(state, position)
				if has_diagnostic(state)
					return false
				end
				skip_newlines(state, position)
			end
			append_import(state, "", declaration, binding, 0, symbol_line)
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	if state.import_count[0] == import_start
		diagnostic(state, "TRBN4002", line, "named import must contain at least one declaration")
		return false
	end
	if !expect(state, position, "}")
		return false
	end
	skip_newlines(state, position)
	if !expect(state, position, "from")
		return false
	end
	mut path := ""
	while load_integer(state.token_kinds, position[0]) != 4
		if terminal_token(state, position[0])
			if path == ""
				diagnostic(state, "TRBN4002", line, "import path is required")
				return false
			end
			mut terminal_index := import_start
			while terminal_index < state.import_count[0]
				store_string(state.import_paths, terminal_index, path)
				terminal_index += 1
			end
			return true
		end
		path += load_string(state.token_texts, position[0])
		advance(position)
	end
	if path == ""
		diagnostic(state, "TRBN4002", line, "import path is required")
		return false
	end
	mut import_index := import_start
	while import_index < state.import_count[0]
		store_string(state.import_paths, import_index, path)
		import_index += 1
	end
	return finish_statement(state, position)
end

def parse_bare_import(mut state: CompilerState, mut position: Array<Integer>, line: Integer): Boolean
	mut path := ""
	mut scanning := true
	while scanning
		if terminal_token(state, position[0])
			scanning = false
		else
			if load_integer(state.token_kinds, position[0]) == 4
				scanning = false
			else
				if token_is(state, position[0], "as")
					scanning = false
				else
					path += load_string(state.token_texts, position[0])
					advance(position)
				end
			end
		end
	end
	if path == ""
		diagnostic(state, "TRBN4002", line, "bare import path is required")
		return false
	end
	mut binding := ""
	if token_is(state, position[0], "as")
		advance(position)
		binding = expect_identifier(state, position)
		if has_diagnostic(state)
			return false
		end
	end
	append_import(state, path, "", binding, 1, line)
	return finish_statement(state, position)
end

def parse_namespace(mut state: CompilerState, mut position: Array<Integer>): Boolean
	line := load_integer(state.token_lines, position[0])
	advance(position)
	leaf := expect_identifier(state, position)
	if !enum_uppercase(leaf)
		diagnostic(state, "TRBN4002", line, "module name must start with an uppercase letter")
		return false
	end
	parent := state.declaration_owner[0]
	name := namespace_qualify(parent, leaf)
	mut found := false
	state.namespaces.each do |declaration|
		if declaration.source_id == state.active_module[0] && declaration.name == name
			found = true
		end
	end
	if !found
		state.namespaces.push(NamespaceDeclaration.new(name: name, source_id: state.active_module[0], line: line))
	end
	if !finish_statement(state, position)
		return false
	end
	start := position[0]
	state.declaration_owner[0] = name
	while !terminal_token(state, position[0]) && !token_is(state, position[0], "end") && !has_diagnostic(state)
		parse_declaration(state, position)
		skip_newlines(state, position)
	end
	mut token := start
	while token < position[0]
		if sparse_string_at(state.token_namespaces, token) == ""
			store_string(state.token_namespaces, token, name)
		end
		token += 1
	end
	state.declaration_owner[0] = parent
	if has_diagnostic(state) || !expect(state, position, "end")
		return false
	end
	return finish_statement(state, position)
end

def parse_global(mut state: CompilerState, mut position: Array<Integer>): Boolean
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	mut mutable := false
	if token_is(state, position[0], "mut")
		mutable = true
		advance(position)
	end
	constant := enum_uppercase(load_string(state.token_texts, position[0]))
	leaf := expect_identifier(state, position)
	name := namespace_qualify(state.declaration_owner[0], leaf)
	if leaf == "_"
		diagnostic(state, "TRBN4002", line, "blank binding _ is only valid as a parameter or pattern binding")
		return false
	end
	if constant && mutable
		diagnostic(state, "TRBN4002", line, "constant cannot be mutable")
		return false
	end
	mut annotation := ""
	if token_is(state, position[0], ":")
		advance(position)
		annotation = parse_type(state, position)
	end
	if !expect(state, position, ":=")
		return false
	end
	start := position[0]
	if !parse_expression_syntax(state, position, 1)
		return false
	end
	state.globals.push(GlobalDeclaration.new(constant: constant, mutable: mutable, name: name, source_id: state.active_module[0], line: line, origin: origin, start: start, finish: position[0], annotation: annotation))
	return finish_statement(state, position)
end

def parse_declaration(mut state: CompilerState, mut position: Array<Integer>): Boolean
	if declaration_start(state, position[0])
		return parse_global(state, position)
	end
	if token_is(state, position[0], "module")
		return parse_namespace(state, position)
	end
	if token_is(state, position[0], "newtype")
		return parse_newtype_declaration(state, position)
	end
	if token_is(state, position[0], "alias")
		return parse_type_alias(state, position)
	end
	if token_is(state, position[0], "enum")
		return parse_enum_declaration(state, position)
	end
	if token_is(state, position[0], "record")
		return parse_record(state, position)
	end
	if token_is(state, position[0], "def")
		return parse_function(state, position, "", [])
	end
	mut scope := ""
	if state.declaration_owner[0] == ""
		scope = "top-level "
	end
	diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "unsupported " + scope + "declaration " + load_string(state.token_texts, position[0]))
	return false
end

def parse_module(mut state: CompilerState, start: Integer, module_index: Integer): Boolean
	state.active_module[0] = module_index
	state.declaration_owner[0] = ""
	import_start := state.import_count[0]
	store_integer(state.module_import_starts, module_index, import_start)
	store_integer(state.module_import_counts, module_index, 0)
	mut position := [start]
	skip_newlines(state, position)
	while !terminal_token(state, position[0])
		if token_is(state, position[0], "import")
			line := load_integer(state.token_lines, position[0])
			advance(position)
			skip_newlines(state, position)
			if token_is(state, position[0], "{")
				parse_named_import(state, position, line)
			else
				parse_bare_import(state, position, line)
			end
		else
			parse_declaration(state, position)
		end
		if has_diagnostic(state)
			return false
		end
		store_integer(
			state.module_import_counts,
			module_index,
			state.import_count[0] - import_start,
		)
		skip_newlines(state, position)
	end
	store_integer(
		state.module_import_counts,
		module_index,
		state.import_count[0] - import_start,
	)
	return true
end

def binary_operator_id(operator: String): Integer
	if operator == "+"
		return 1
	end
	if operator == "-"
		return 2
	end
	if operator == "*"
		return 3
	end
	if operator == "/"
		return 4
	end
	if operator == "%"
		return 5
	end
	if operator == "=="
		return 6
	end
	if operator == "!="
		return 7
	end
	if operator == "<"
		return 8
	end
	if operator == "<="
		return 9
	end
	if operator == ">"
		return 10
	end
	if operator == ">="
		return 11
	end
	if operator == "||"
		return 12
	end
	if operator == "&&"
		return 13
	end
	# The high tag identifies the four supported compound assignments.
	if operator == "+="
		return 17
	end
	if operator == "-="
		return 18
	end
	if operator == "*="
		return 19
	end
	if operator == "/="
		return 20
	end
	return 0
end

def publish_control(mut state: CompilerState, control: ControlSyntax)
	encoded := sparse_integer_at(state.control_origins, control.origin)
	if encoded == 0
		state.controls.push(control)
		store_integer(state.control_origins, control.origin, state.controls.size())
	end
end

def parse_control_syntax(mut state: CompilerState, mut position: Array<Integer>): Boolean
	origin := position[0]
	encoded := sparse_integer_at(state.control_origins, origin)
	if encoded > 0
		position[0] = state.controls[encoded - 1].finish
		return true
	end
	mut kind := 1
	if token_is(state, origin, "case")
		kind = 2
	end
	advance(position)
	selector := position[0]
	if !parse_expression_syntax(state, position, 1)
		return false
	end
	selector_finish := position[0]
	if !finish_statement(state, position)
		return false
	end
	mut branches: Array<ControlBranch> := []
	if kind == 1
		body := position[0]
		if !parse_statement_block(state, position)
			return false
		end
		branches.push(ControlBranch.new(condition: selector, condition_finish: selector_finish, body: body, finish: position[0]))
	end
	while token_is(state, position[0], "elsif") || token_is(state, position[0], "when")
		if (kind == 1 && !token_is(state, position[0], "elsif")) || (kind == 2 && !token_is(state, position[0], "when"))
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "unexpected control branch")
			return false
		end
		advance(position)
		condition := position[0]
		if !parse_expression_syntax(state, position, 1)
			return false
		end
		while kind == 2 && token_is(state, position[0], ",")
			advance(position)
			if !parse_expression_syntax(state, position, 1)
				return false
			end
		end
		condition_finish := position[0]
		if !finish_statement(state, position)
			return false
		end
		body := position[0]
		if !parse_statement_block(state, position)
			return false
		end
		branches.push(ControlBranch.new(condition: condition, condition_finish: condition_finish, body: body, finish: position[0]))
	end
	if token_is(state, position[0], "else")
		advance(position)
		if !finish_statement(state, position)
			return false
		end
		body := position[0]
		if !parse_statement_block(state, position)
			return false
		end
		branches.push(ControlBranch.new(condition: - 1, condition_finish: - 1, body: body, finish: position[0]))
	end
	if branches.size() == 0 || (kind == 2 && branches[0].condition < 0)
		diagnostic(state, "TRBN4002", load_integer(state.token_lines, origin), "case requires at least one when branch")
		return false
	end
	if !expect(state, position, "end")
		return false
	end
	publish_control(state, ControlSyntax.new(kind: kind, origin: origin, finish: position[0], selector: selector, selector_finish: selector_finish, branches: branches))
	return true
end

def parse_transfer_syntax(mut state: CompilerState, mut position: Array<Integer>): Boolean
	origin := position[0]
	returns := token_is(state, origin, "return")
	advance(position)
	if returns && !syntax_statement_boundary(state, position[0]) && !token_is(state, position[0], "if")
		if !parse_statement_value_syntax(state, position)
			return false
		end
	end
	body_finish := position[0]
	if token_is(state, position[0], "if")
		advance(position)
		condition := position[0]
		if !parse_expression_syntax(state, position, 1)
			return false
		end
		publish_control(state, ControlSyntax.new(kind: 4, origin: origin, finish: position[0], selector: condition, selector_finish: position[0], branches: [ControlBranch.new(condition: condition, condition_finish: position[0], body: origin, finish: body_finish)]))
	elsif !returns && !syntax_statement_boundary(state, position[0])
		diagnostic(state, "TRBN4002", load_integer(state.token_lines, origin), load_string(state.token_texts, origin) + " does not take a value")
		return false
	end
	return finish_statement(state, position)
end

# Catch attaches only to a whole statement value. Nested argument/element
# expressions continue through parse_expression_syntax and cannot consume it.
def parse_statement_value_syntax(mut state: CompilerState, mut position: Array<Integer>): Boolean
	origin := position[0]
	if !parse_expression_syntax(state, position, 1)
		return false
	end
	if !token_is(state, position[0], "catch")
		return true
	end
	operand_finish := position[0]
	advance(position)
	if !expect(state, position, "|")
		return false
	end
	binding := position[0]
	expect_identifier(state, position)
	if !expect(state, position, "|") || !finish_statement(state, position)
		return false
	end
	skip_newlines(state, position)
	body := position[0]
	if !parse_statement_block(state, position) || !expect(state, position, "end")
		return false
	end
	state.catch_syntax.push(CatchSyntax.new(origin: origin, operand_finish: operand_finish, binding: binding, body: body, finish: position[0]))
	store_integer(state.catch_origins, origin, state.catch_syntax.size())
	return true
end

# Parse the shared statement grammar inside an expression-owned block.
def parse_transform_syntax(mut state: CompilerState, mut position: Array<Integer>): Boolean
	origin := position[0]
	kind := transform_kind(load_string(state.token_texts, origin + 1))
	position[0] += 2
	mut initial_start :=- 1
	mut initial_finish :=- 1
	if kind == 3
		if !expect(state, position, "(")
			return false
		end
		skip_newlines(state, position)
		initial_start = position[0]
		if !parse_expression_syntax(state, position, 1)
			return false
		end
		initial_finish = position[0]
		skip_newlines(state, position)
		if !expect(state, position, ")")
			return false
		end
	elsif token_is(state, position[0], "(")
		advance(position)
		if !expect(state, position, ")")
			return false
		end
	end
	mut indexed := false
	if kind <= 2 && token_is(state, position[0], ".") && token_is(state, position[0] + 1, "with_index")
		indexed = true
		position[0] += 2
		if token_is(state, position[0], "(")
			advance(position)
			if !expect(state, position, ")")
				return false
			end
		end
	end
	brace := token_is(state, position[0], "{")
	mut terminator := "end"
	if brace
		terminator = "}"
		advance(position)
	elsif !expect(state, position, "do")
		return false
	end
	if !expect(state, position, "|")
		return false
	end
	mut accumulator_origin :=- 1
	if kind == 3
		accumulator_origin = position[0]
		expect_identifier(state, position)
		if !expect(state, position, ",")
			return false
		end
	end
	element_origin := position[0]
	expect_identifier(state, position)
	mut second_origin :=- 1
	if indexed
		if !expect(state, position, ",")
			return false
		end
		second_origin = position[0]
		expect_identifier(state, position)
	end
	if !expect(state, position, "|")
		return false
	end
	if !brace && !finish_statement(state, position)
		return false
	end
	skip_newlines(state, position)
	body_start := position[0]
	if !parse_statement_block(state, position)
		return false
	end
	body_finish := position[0]
	if !expect(state, position, terminator)
		return false
	end
	if sparse_integer_at(state.transform_origins, origin) == 0
		shape := IterationSyntax.new(origin: origin, receiver_finish: origin, slice_start: - 1, slice_finish: - 1, element_origin: element_origin, second_origin: second_origin, body_start: body_start, body_finish: body_finish, finish: position[0])
		state.transforms.push(TransformSyntax.new(iteration: shape, kind: kind, initial_start: initial_start, initial_finish: initial_finish, accumulator_origin: accumulator_origin))
		store_integer(state.transform_origins, origin, state.transforms.size())
		store_integer(state.transform_origins, body_finish, - state.transforms.size())
	end
	return !has_diagnostic(state)
end

# Variant syntax is parsed separately; method bodies reuse ordinary functions.
def parse_enum_declaration(mut state: CompilerState, mut position: Array<Integer>): Boolean
	mut method_owner := [- 1, - 1]
	if !parse_enum(state, position, method_owner)
		return false
	end
	owner := method_owner[0]
	generic_owner := method_owner[1]
	if owner < 0 && generic_owner < 0
		return true
	end
	mut name := ""
	mut receiver_type := ""
	mut parameters: Array<String> := []
	if generic_owner >= 0
		definition := state.generic_definitions[generic_owner]
		name = definition.name
		parameters = definition.parameters
		receiver_type = generic_application(name, parameters)
	else
		name = state.enums[owner].name
		receiver_type = enum_type(owner)
	end
	while token_is(state, position[0], "def") && !has_diagnostic(state)
		method_name := load_string(state.token_texts, position[0] + 1)
		if method_name == "raw_value" || method_name == "from_raw"
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "enum method name " + method_name + " is reserved")
			return false
		end
		parent := state.declaration_owner[0]
		start := position[0]
		state.declaration_owner[0] = name
		parsed := parse_function(state, position, receiver_type, parameters)
		mut token := start
		while token < position[0]
			store_string(state.token_namespaces, token, name)
			token += 1
		end
		state.declaration_owner[0] = parent
		if !parsed
			return false
		end
	end
	if !expect(state, position, "end")
		return false
	end
	return finish_statement(state, position)
end

# Method bodies retain their lexical construction authority in token origins.
def parse_newtype_declaration(mut state: CompilerState, mut position: Array<Integer>): Boolean
	owner := parse_newtype_header(state, position)
	if owner < 0 || has_diagnostic(state)
		return false
	end
	if !token_is(state, position[0], "do")
		return finish_statement(state, position)
	end
	advance(position)
	if !finish_statement(state, position)
		return false
	end
	mut method_seen := false
	while !token_is(state, position[0], "end") && !has_diagnostic(state)
		skip_newlines(state, position)
		if token_is(state, position[0], "end")
			break
		end
		row := state.newtypes[owner]
		if token_is(state, position[0], "private")
			if method_seen || row.closed
				diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "private new must occur once before newtype methods")
				return false
			end
			advance(position)
			if !expect(state, position, "new") || !finish_statement(state, position)
				return false
			end
			state.newtypes[owner] = NewtypeDefinition.new(name: row.name, source_id: row.source_id, line: row.line, target: row.target, representation: row.representation, closed: true)
			next
		end
		if !token_is(state, position[0], "def")
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, position[0]), "newtype body accepts only methods and private new")
			return false
		end
		method_seen = true
		mut name_origin := position[0] + 1
		mut receiver := newtype_type(owner)
		if token_is(state, name_origin, "self") && token_is(state, name_origin + 1, ".")
			name_origin += 2
			receiver = ""
		end
		name := load_string(state.token_texts, name_origin)
		if name == "new" || name == "value" || name == "initialize"
			diagnostic(state, "TRBN4002", load_integer(state.token_lines, name_origin), "newtype method name " + name + " is reserved")
			return false
		end
		parent := state.declaration_owner[0]
		start := position[0]
		state.declaration_owner[0] = row.name
		parsed := parse_function(state, position, receiver, [])
		mut token := start
		while token < position[0]
			store_string(state.token_namespaces, token, row.name)
			token += 1
		end
		state.declaration_owner[0] = parent
		if !parsed
			return false
		end
	end
	if !expect(state, position, "end")
		return false
	end
	return finish_statement(state, position)
end
