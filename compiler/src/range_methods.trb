import { CheckedValue, checked_mir_value, checked_value, scalar_mir_binary, scalar_mir_literal } from checked_values
import { mir_checked_array_operation } from mir_arrays
import { mir_binding_initialize, mir_binding_read } from mir_bindings
import { mir_control_active, mir_control_allocate, mir_control_conditional, mir_control_enter, mir_control_loop_begin, mir_control_loop_end, mir_control_prepare } from mir_control
import { mir_iteration_range_test } from mir_iteration_control
import { mir_checked_range_field } from mir_ranges
import { CheckedLocals, CompilerState, local_bind_temporary } from state
import { load_integer, store_integer } from storage

# Materialization uses the same endpoint test as each, with ordinary typed
# edges and a private result binding. No synthetic source iteration is needed.
def mir_range_array(mut state: CompilerState, mut locals: CheckedLocals, receiver: CheckedValue, origin: Integer): CheckedValue
	mir_control_prepare(state, locals)
	if !mir_control_active(locals)
		return checked_value("Array<Integer>", 0, origin, 1)
	end
	outer := locals.count[0]
	line := load_integer(state.source_tokens.token_lines, origin)
	owner := local_bind_temporary(locals, "$range.owner", "Range<Integer>", 1)
	mir_binding_initialize(state, locals, owner, receiver, origin)
	first := mir_checked_range_field(state, locals, checked_mir_value(receiver), 0, origin)
	cursor := local_bind_temporary(locals, "$range.cursor", "Integer", 1)
	mir_binding_initialize(state, locals, cursor, first, origin)
	empty := mir_checked_array_operation(state, locals, 19, - 1, - 1, 0, "Array<Integer>", origin)
	result_slot := local_bind_temporary(locals, "$range.result", "Array<Integer>", 1)
	mir_binding_initialize(state, locals, result_slot, empty, origin)
	exit := mir_control_loop_begin(state, locals, origin, line)
	frame := locals.mir_loops[locals.mir_control[8] - 1]
	body := mir_control_allocate(locals)
	mir_iteration_range_test(state, locals, frame, body, owner)
	mir_control_enter(state, locals, body, line)
	result := mir_binding_read(state, locals, result_slot, origin)
	current := mir_binding_read(state, locals, cursor, origin)
	mir_checked_array_operation(state, locals, 24, checked_mir_value(result), checked_mir_value(current), 0, "Void", origin)
	span := mir_binding_read(state, locals, owner, origin)
	bound := mir_checked_range_field(state, locals, checked_mir_value(span), 1, origin)
	last := scalar_mir_binary(state, locals, "==", current, bound, "Boolean", origin)
	advance := mir_control_allocate(locals)
	mir_control_conditional(state, locals, checked_mir_value(last), exit, frame.exit_binding_count, advance, frame.binding_count)
	mir_control_enter(state, locals, advance, line)
	position := mir_binding_read(state, locals, cursor, origin)
	one := scalar_mir_literal(state, locals, "Integer", origin, "1")
	next_position := scalar_mir_binary(state, locals, "+", position, one, "Integer", origin)
	store_integer(locals.mir_values, cursor, checked_mir_value(next_position) + 1)
	mir_control_loop_end(state, locals, line)
	output := mir_binding_read(state, locals, result_slot, origin)
	locals.count[0] = outer
	return checked_value(output.type_name, output.category, origin, 1)
end
