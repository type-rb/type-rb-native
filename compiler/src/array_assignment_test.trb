import { describe, expect, test } from trb/std/test
import { gate4_check, gate4_emit_qbe, gate4_lex } from compiler
import { gate4_parse_module } from parser
import { gate4_resolve } from resolution
import { gate4_compiler_new, gate4_has_diagnostic } from state
import { gate4_load_string, gate4_store_integer } from storage
import { checked_array_assignment_store } from checked_program
import { mir_array_assignment_valid } from mir

describe("Checked Array assignment targets") do
	test("verifies paired target and store origins") do
		expect(mir_array_assignment_valid(3, 8, 3, 10)).to_be_true()
		expect(mir_array_assignment_valid(- 1, 8, - 1, 10)).to_be_false()
		expect(mir_array_assignment_valid(8, 8, 8, 10)).to_be_false()
		expect(mir_array_assignment_valid(3, 10, 3, 10)).to_be_false()
		expect(mir_array_assignment_valid(3, 8, 4, 10)).to_be_false()
	end

	test("rejects missing and malformed plans without lowering a stale store") do
		source := "def main()\nmut values := [1, 2]\nvalues[-1] = 9\nend\n"
		mut mode := 0
		while mode < 4
			mut state := gate4_compiler_new(source.size() + 1)
			expect(gate4_lex(state, source)).to_be_true()
			expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(gate4_resolve(state)).to_be_true()
			expect(gate4_check(state)).to_be_true()
			mut store_origin := 0
			while gate4_load_string(state.token_texts, store_origin) != "="
				store_origin += 1
			end
			mut index_origin := store_origin
			while gate4_load_string(state.token_texts, index_origin) != "["
				index_origin -= 1
			end
			expect(checked_array_assignment_store(state, index_origin)).to_equal(store_origin)
			if mode == 0
				gate4_store_integer(state.array_assignment_targets, index_origin, 0)
			elsif mode == 1
				gate4_store_integer(state.array_assignment_targets, index_origin, state.token_count[0] + 1)
			elsif mode == 2
				gate4_store_integer(state.array_assignment_targets, store_origin, index_origin)
			else
				gate4_store_integer(state.array_assignment_targets, index_origin, index_origin + 1)
			end
			gate4_emit_qbe(state)
			expect(gate4_has_diagnostic(state)).to_be_true()
			expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("invalid checked Array assignment target")
			mode += 1
		end
	end
end
