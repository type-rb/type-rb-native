import { MirIteration, MirRangeConstruction, mir_iteration_shape_valid, mir_iteration_valid, mir_range_valid } from iteration_mir
import { syntax_iteration_suffix, token_is } from parser
import { array_element_type } from resolution
import { CompilerState, diagnostic } from state
import { load_integer, sparse_integer_at } from storage

def checked_iteration_shape(state: CompilerState, plan: MirIteration, origin: Integer): Boolean
	if !mir_iteration_shape_valid(plan, origin, state.token_count[0])
		return false
	end
	# The parser pairs both boundaries. A stale end cannot silently skip
	# statements or retarget a checked iteration to a different lexical body.
	if sparse_integer_at(state.iteration_origins, plan.body_finish) != - sparse_integer_at(state.iteration_origins, origin)
		return false
	end
	delimiter := syntax_iteration_suffix(state, plan.receiver_finish)
	if delimiter < 0
		return false
	end
	if plan.element_origin != delimiter + 2 || !token_is(state, delimiter + 1, "|")
		return false
	end
	mut indexed := false
	mut suffix := plan.receiver_finish + 2
	while suffix < delimiter
		if token_is(state, suffix, "with_index")
			indexed = true
		end
		suffix += 1
	end
	if ((indexed && plan.index_origin < 0) || (!indexed && plan.index_origin >= 0)) || load_integer(state.token_kinds, plan.element_origin) != 1
		return false
	end
	mut close := plan.element_origin + 1
	if plan.index_origin >= 0
		if plan.index_origin != close + 1 || !token_is(state, close, ",") || load_integer(state.token_kinds, plan.index_origin) != 1
			return false
		end
		close = plan.index_origin + 1
	end
	if !token_is(state, close, "|")
		return false
	end
	if token_is(state, delimiter, "do") && load_integer(state.token_kinds, close + 1) != 4
		return false
	end
	mut cursor := close + 1
	while load_integer(state.token_kinds, cursor) == 4
		cursor += 1
	end
	mut terminator := "end"
	if token_is(state, delimiter, "{")
		terminator = "}"
	end
	if cursor != plan.body_start
		return false
	end
	return token_is(state, plan.body_finish, terminator)
end

def checked_iteration_require(mut state: CompilerState, origin: Integer, parent_loop: Integer): MirIteration
	encoded := sparse_integer_at(state.iteration_origins, origin)
	invalid := MirIteration.new(origin: - 1, receiver_finish: - 1, element_origin: - 1, index_origin: - 1, body_start: - 1, body_finish: - 1, finish: - 1, parent_loop: - 1, source_kind: 1, type_name: "", element_type: "")
	if encoded > 0 && encoded <= state.iterations.size()
		plan := state.iterations[encoded - 1]
		if checked_iteration_shape(state, plan, origin) && plan.parent_loop == parent_loop
			if mir_iteration_valid(plan, origin, state.token_count[0], plan.type_name, iteration_element_type(plan.type_name))
				return plan
			end
		end
	end
	mut line := 1
	if origin >= 0 && origin < state.token_count[0]
		line = load_integer(state.token_lines, origin)
	end
	diagnostic(state, "TRBN4004", line, "invalid checked iteration")
	return invalid
end

def iteration_element_type(type_name: String): String
	if type_name == "Range<Integer>"
		return "Integer"
	end
	return array_element_type(type_name)
end

def checked_range_require(mut state: CompilerState, origin: Integer, operator_origin: Integer, end_origin: Integer, finish: Integer): MirRangeConstruction
	encoded := sparse_integer_at(state.range_origins, operator_origin)
	if encoded > 0 && encoded <= state.ranges.size()
		plan := state.ranges[encoded - 1]
		if mir_range_valid(plan, origin, operator_origin, end_origin, finish, state.token_count[0])
			mut spelling := ".."
			if plan.exclusive == 1
				spelling = "..."
			end
			if token_is(state, operator_origin, spelling)
				mut next_origin := operator_origin + 1
				while load_integer(state.token_kinds, next_origin) == 4
					next_origin += 1
				end
				if next_origin == end_origin
					return plan
				end
			end
		end
	end
	mut line := 1
	if operator_origin >= 0 && operator_origin < state.token_count[0]
		line = load_integer(state.token_lines, operator_origin)
	end
	diagnostic(state, "TRBN4004", line, "invalid checked Range construction")
	return MirRangeConstruction.new(origin: - 1, operator_origin: - 1, end_origin: - 1, finish: - 1, exclusive: - 1, start_type: "", end_type: "")
end
