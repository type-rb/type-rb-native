import { MirTransform, TransformSyntax, mir_transform_valid, transform_kind, transform_syntax_valid } from transform_model
import { token_is } from syntax_tokens
import { MirIteration, MirRangeConstruction, mir_iteration_valid, mir_range_valid } from iteration_mir
import { IterationSyntax, iteration_syntax_valid } from iteration_syntax
import { syntax_iteration_suffix } from parser
import { array_element_type } from type_resolution
import { CompilerState, diagnostic } from state
import { load_integer, load_string, sparse_integer_at } from storage

def checked_iteration_shape(state: CompilerState, plan: IterationSyntax, origin: Integer): Boolean
	if !iteration_syntax_valid(plan, origin, state.token_count[0])
		return false
	end
	# The parser pairs both boundaries. A stale end cannot silently skip
	# statements or retarget a checked iteration to a different lexical body.
	if sparse_integer_at(state.iteration_origins, plan.body_finish) != - sparse_integer_at(state.iteration_origins, origin)
		return false
	end
	delimiter := syntax_iteration_suffix(state, plan.receiver_finish)
	if delimiter < 0
		return false
	end
	if plan.element_origin != delimiter + 2 || !token_is(state, delimiter + 1, "|")
		return false
	end
	mut indexed := false
	mut suffix := plan.receiver_finish + 2
	while suffix < delimiter
		if token_is(state, suffix, "with_index")
			indexed = true
		end
		suffix += 1
	end
	if ((indexed && plan.index_origin < 0) || (!indexed && plan.index_origin >= 0)) || load_integer(state.token_kinds, plan.element_origin) != 1
		return false
	end
	mut close := plan.element_origin + 1
	if plan.index_origin >= 0
		if plan.index_origin != close + 1 || !token_is(state, close, ",") || load_integer(state.token_kinds, plan.index_origin) != 1
			return false
		end
		close = plan.index_origin + 1
	end
	if !token_is(state, close, "|")
		return false
	end
	if token_is(state, delimiter, "do") && load_integer(state.token_kinds, close + 1) != 4
		return false
	end
	mut cursor := close + 1
	while load_integer(state.token_kinds, cursor) == 4
		cursor += 1
	end
	mut terminator := "end"
	if token_is(state, delimiter, "{")
		terminator = "}"
	end
	if cursor != plan.body_start
		return false
	end
	return token_is(state, plan.body_finish, terminator)
end

def checked_iteration_require(mut state: CompilerState, origin: Integer, parent_loop: Integer): MirIteration
	encoded := sparse_integer_at(state.checked[0].iteration_origins, origin)
	syntax := IterationSyntax.new(origin: - 1, receiver_finish: - 1, element_origin: - 1, index_origin: - 1, body_start: - 1, body_finish: - 1, finish: - 1)
	invalid := MirIteration.new(syntax: syntax, parent_loop: - 1, source_kind: 1, type_name: "", element_type: "")
	if encoded > 0 && encoded <= state.checked[0].iterations.size()
		plan := state.checked[0].iterations[encoded - 1]
		if checked_iteration_shape(state, plan.syntax, origin) && plan.parent_loop == parent_loop
			if mir_iteration_valid(plan, origin, state.token_count[0], plan.type_name, iteration_element_type(plan.type_name))
				return plan
			end
		end
	end
	mut line := 1
	if origin >= 0 && origin < state.token_count[0]
		line = load_integer(state.token_lines, origin)
	end
	diagnostic(state, "TRBN4004", line, "invalid checked iteration")
	return invalid
end

def iteration_element_type(type_name: String): String
	if type_name == "Range<Integer>"
		return "Integer"
	end
	return array_element_type(type_name)
end

def checked_range_require(mut state: CompilerState, origin: Integer, operator_origin: Integer, end_origin: Integer, finish: Integer): MirRangeConstruction
	encoded := sparse_integer_at(state.checked[0].range_origins, operator_origin)
	if encoded > 0 && encoded <= state.checked[0].ranges.size()
		plan := state.checked[0].ranges[encoded - 1]
		if mir_range_valid(plan, origin, operator_origin, end_origin, finish, state.token_count[0])
			mut spelling := ".."
			if plan.exclusive == 1
				spelling = "..."
			end
			if token_is(state, operator_origin, spelling)
				mut next_origin := operator_origin + 1
				while load_integer(state.token_kinds, next_origin) == 4
					next_origin += 1
				end
				if next_origin == end_origin
					return plan
				end
			end
		end
	end
	mut line := 1
	if operator_origin >= 0 && operator_origin < state.token_count[0]
		line = load_integer(state.token_lines, operator_origin)
	end
	diagnostic(state, "TRBN4004", line, "invalid checked Range construction")
	return MirRangeConstruction.new(origin: - 1, operator_origin: - 1, end_origin: - 1, finish: - 1, exclusive: - 1, start_type: "", end_type: "")
end

def checked_transform_shape(state: CompilerState, plan: TransformSyntax, origin: Integer): Boolean
	if !transform_syntax_valid(plan, origin, state.token_count[0]) || !token_is(state, origin, ".") || transform_kind(load_string(state.token_texts, origin + 1)) != plan.kind
		return false
	end
	shape := plan.iteration
	if sparse_integer_at(state.transform_origins, origin) < 1 || sparse_integer_at(state.transform_origins, shape.body_finish) != - sparse_integer_at(state.transform_origins, origin)
		return false
	end
	mut cursor := origin + 2
	if plan.kind == 3
		if !token_is(state, cursor, "(")
			return false
		end
		cursor += 1
		while load_integer(state.token_kinds, cursor) == 4
			cursor += 1
		end
		if cursor != plan.initial_start
			return false
		end
		cursor = plan.initial_finish
		while load_integer(state.token_kinds, cursor) == 4
			cursor += 1
		end
		if !token_is(state, cursor, ")")
			return false
		end
		cursor += 1
	elsif token_is(state, cursor, "(")
		if !token_is(state, cursor + 1, ")")
			return false
		end
		cursor += 2
	end
	if shape.index_origin >= 0
		if !token_is(state, cursor, ".") || !token_is(state, cursor + 1, "with_index")
			return false
		end
		cursor += 2
		if token_is(state, cursor, "(")
			if !token_is(state, cursor + 1, ")")
				return false
			end
			cursor += 2
		end
	end
	brace := token_is(state, cursor, "{")
	if (!brace && !token_is(state, cursor, "do")) || !token_is(state, cursor + 1, "|")
		return false
	end
	cursor += 2
	if plan.kind == 3
		if cursor != plan.accumulator_origin || load_integer(state.token_kinds, cursor) != 1 || !token_is(state, cursor + 1, ",")
			return false
		end
		cursor += 2
	end
	if cursor != shape.element_origin || load_integer(state.token_kinds, cursor) != 1
		return false
	end
	cursor += 1
	if shape.index_origin >= 0
		if !token_is(state, cursor, ",") || cursor + 1 != shape.index_origin || load_integer(state.token_kinds, cursor + 1) != 1
			return false
		end
		cursor += 2
	end
	if !token_is(state, cursor, "|")
		return false
	end
	cursor += 1
	if !brace && load_integer(state.token_kinds, cursor) != 4
		return false
	end
	while load_integer(state.token_kinds, cursor) == 4
		cursor += 1
	end
	mut terminator := "end"
	if brace
		terminator = "}"
	end
	if cursor != shape.body_start
		return false
	end
	return token_is(state, shape.body_finish, terminator)
end

def checked_transform_require(mut state: CompilerState, origin: Integer): MirTransform
	encoded := sparse_integer_at(state.checked[0].transform_origins, origin)
	if encoded > 0 && encoded <= state.checked[0].transforms.size()
		plan := state.checked[0].transforms[encoded - 1]
		if checked_transform_shape(state, plan.syntax, origin) && mir_transform_valid(plan, origin, state.token_count[0], iteration_element_type(plan.iteration.type_name))
			if plan.syntax.kind == 3 || array_element_type(plan.type_name) != ""
				if plan.syntax.kind != 2 || array_element_type(plan.type_name) == plan.iteration.element_type
					return plan
				end
			end
		end
	end
	diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked collection transform")
	shape := IterationSyntax.new(origin: - 1, receiver_finish: - 1, element_origin: - 1, index_origin: - 1, body_start: - 1, body_finish: - 1, finish: - 1)
	syntax := TransformSyntax.new(iteration: shape, kind: 0, initial_start: - 1, initial_finish: - 1, accumulator_origin: - 1)
	iteration := MirIteration.new(syntax: shape, parent_loop: - 1, source_kind: 0, type_name: "", element_type: "")
	return MirTransform.new(syntax: syntax, iteration: iteration, type_name: "")
end
