import { QbeOutput, qbe_output_line } from qbe_output
import { emit_unicode_case_data } from unicode_case_data

# The pinned reference applies simple Unicode mappings, independent of locale.
# Measure encoded widths before allocating once; decode malformed bytes as U+FFFD.
def emit_string_case_runtime(mut output: QbeOutput)
	emit_unicode_case_data(output)
	qbe_output_line(output, "\nfunction l $trbn_case_point(l %point, l %mode) {\n@start\n %lower =w ceql %mode, 1\n jnz %lower, @lower, @upper\n@lower\n %lower_count =l loadl $trbn_case_lower_count\n jmp @search_start\n@upper\n %upper_count =l loadl $trbn_case_upper_count\n jmp @search_start\n@search_start\n %table =l phi @lower $trbn_case_lower, @upper $trbn_case_upper\n %count =l phi @lower %lower_count, @upper %upper_count\n jmp @search\n@search\n %low =l phi @search_start 0, @left %low, @right %next_low\n %high =l phi @search_start %count, @left %middle, @right %high\n %done =w csgel %low, %high\n jnz %done, @unchanged, @inspect\n@inspect\n %sum =l add %low, %high\n %middle =l shr %sum, 1\n %offset =l mul %middle, 8\n %row =l add %table, %offset\n %key_word =w loadw %row\n %key =l extuw %key_word\n %equal =w ceql %key, %point\n jnz %equal, @found, @compare\n@compare\n %before =w csltl %point, %key\n jnz %before, @left, @right\n@left\n jmp @search\n@right\n %next_low =l add %middle, 1\n jmp @search\n@found\n %value_slot =l add %row, 4\n %value_word =w loadw %value_slot\n %value =l extuw %value_word\n ret %value\n@unchanged\n ret %point\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_utf8_encoded_width(l %point) {\n@start\n %ascii =w csltl %point, 128\n jnz %ascii, @one, @multi\n@one\n ret 1\n@multi\n %two =w csltl %point, 2048\n jnz %two, @two, @longer\n@two\n ret 2\n@longer\n %three =w csltl %point, 65536\n jnz %three, @three, @four\n@three\n ret 3\n@four\n ret 4\n}\nfunction l $trbn_utf8_write(l %data, l %point) {\n@start\n %width =l call $trbn_utf8_encoded_width(l %point)\n %ascii =w ceql %width, 1\n jnz %ascii, @one, @tail\n@one\n storeb %point, %data\n ret 1\n@tail\n %last =l sub %width, 1\n jmp @loop\n@loop\n %index =l phi @tail %last, @write %previous\n %remaining =l phi @tail %point, @write %next_point\n %done =w ceql %index, 0\n jnz %done, @head, @write\n@write\n %low =l and %remaining, 63\n %byte =l or %low, 128\n %address =l add %data, %index\n storeb %byte, %address\n %next_point =l shr %remaining, 6\n %previous =l sub %index, 1\n jmp @loop\n@head\n %shift =l sub 8, %width\n %bits =l shl 255, %shift\n %first =l or %bits, %remaining\n storeb %first, %data\n ret %width\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_string_case(l %source, l %mode) {\n@start\n %length_slot =l add %source, 8\n %length =l loadl %length_slot\n %points_slot =l add %source, 16\n %points =l loadl %points_slot\n %data =l add %source, 24\n jmp @measure\n@measure\n %offset =l phi @start 0, @measured %next\n %size =l phi @start 0, @measured %next_size\n %done =w ceql %offset, %length\n jnz %done, @allocate, @inspect\n@inspect\n %input =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %input, l %remaining)\n %point =l call $trbn_utf8_scalar(l %input, l %remaining)\n %mapped =l call $trbn_case_point(l %point, l %mode)\n %encoded =l call $trbn_utf8_encoded_width(l %mapped)\n %next_size =l add %size, %encoded\n %next =l add %offset, %width\n jmp @measured\n@measured\n jmp @measure\n@allocate\n %payload =l add %size, 17\n %result =l call $trbn_string_alloc(l %payload)\n %result_length =l add %result, 8\n storel %size, %result_length\n %result_points =l add %result, 16\n storel %points, %result_points\n %result_data =l add %result, 24\n %terminator =l add %result_data, %size\n storeb 0, %terminator\n jmp @copy\n@copy\n %position =l phi @allocate 0, @copied %next_position\n %output_position =l phi @allocate 0, @copied %next_output\n %finished =w ceql %position, %length\n jnz %finished, @finish, @decode\n@decode\n %from =l add %data, %position\n %left =l sub %length, %position\n %input_width =l call $trbn_utf8_width(l %from, l %left)\n %decoded =l call $trbn_utf8_scalar(l %from, l %left)\n %converted =l call $trbn_case_point(l %decoded, l %mode)\n %to =l add %result_data, %output_position\n %output_width =l call $trbn_utf8_write(l %to, l %converted)\n %next_position =l add %position, %input_width\n %next_output =l add %output_position, %output_width\n jmp @copied\n@copied\n jmp @copy\n@finish\n ret %result\n}\n")
end
