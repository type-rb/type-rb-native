import { ascii_code } from literals

record ProjectGoConfig
	module_name: String
	version: String
	root_package: String
end

record ProjectConfig
	name: String
	version: String
	mode: String
	source_dir: String
	out_dir: String
	copy_files: Boolean
	package_management: String
	go_config: ProjectGoConfig
	error: String
	error_line: Integer
end

def project_config_set_error(
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		message: String,
		line: Integer,
	)
	if error[0] == ""
		error[0] = message
		error_line[0] = line
	end
	return
end

def project_config_advance(mut value: Array<Integer>, amount: Integer)
	value[0] = value[0] + amount
	return
end

def project_json_skip_ignored(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == " "
				project_config_advance(position, 1)
			else
				if character == "\t"
					project_config_advance(position, 1)
				else
					if character == "\r"
						project_config_advance(position, 1)
					else
						if character == "\n"
							project_config_advance(position, 1)
							project_config_advance(line, 1)
						else
							if character == "/"
								if position[0] + 1 < source.size()
									following := source[position[0] + 1]
									if following == "/"
										project_config_advance(position, 2)
										mut comment := true
										while comment
											if position[0] >= source.size()
												comment = false
											else
												if source[position[0]] == "\n"
													comment = false
												else
													project_config_advance(position, 1)
												end
											end
										end
									else
										if following == "*"
											start_line := line[0]
											project_config_advance(position, 2)
											mut comment := true
											mut closed := false
											while comment
												if position[0] >= source.size()
													comment = false
												else
													if source[position[0]] == "\n"
														project_config_advance(line, 1)
													end
													if source[position[0]] == "*"
														if position[0] + 1 < source.size()
															if source[position[0] + 1] == "/"
																project_config_advance(position, 2)
																closed = true
																comment = false
															end
														end
													end
													if comment
														project_config_advance(position, 1)
													end
												end
											end
											if !closed
												project_config_set_error(error, error_line, "unterminated JSONC block comment", start_line)
												scanning = false
											end
										else
											scanning = false
										end
									end
								else
									scanning = false
								end
							else
								scanning = false
							end
						end
					end
				end
			end
		end
	end
	return error[0] == ""
end

def project_json_hex_digit(character: String): Integer
	code := ascii_code(character)
	if code >= 48
		if code <= 57
			return code - 48
		end
	end
	if code >= 65
		if code <= 70
			return code - 55
		end
	end
	if code >= 97
		if code <= 102
			return code - 87
		end
	end
	return - 1
end

def project_json_ascii_character(code: Integer): String
	if code == 9
		return "\t"
	end
	if code == 10
		return "\n"
	end
	if code == 13
		return "\r"
	end
	if code < 32
		return ""
	end
	if code > 126
		return ""
	end
	return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"[code - 32]
end

def project_json_string(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if position[0] >= source.size()
		project_config_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	if source[position[0]] != "\""
		project_config_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	project_config_advance(position, 1)
	mut result := ""
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == "\""
				project_config_advance(position, 1)
				closed = true
				scanning = false
			else
				if character == "\n"
					project_config_set_error(error, error_line, "newline in JSON string", line[0])
					scanning = false
				else
					if character == "\\"
						project_config_advance(position, 1)
						if position[0] >= source.size()
							project_config_set_error(error, error_line, "unterminated JSON escape", line[0])
							scanning = false
						else
							escaped := source[position[0]]
							project_config_advance(position, 1)
							if escaped == "\""
								result += "\""
							else
								if escaped == "\\"
									result += "\\"
								else
									if escaped == "/"
										result += "/"
									else
										if escaped == "n"
											result += "\n"
										else
											if escaped == "r"
												result += "\r"
											else
												if escaped == "t"
													result += "\t"
												else
													if escaped == "u"
														mut code := 0
														mut digit_index := 0
														while digit_index < 4
															if position[0] >= source.size()
																project_config_set_error(error, error_line, "incomplete JSON Unicode escape", line[0])
																digit_index = 4
															else
																digit := project_json_hex_digit(source[position[0]])
																if digit < 0
																	project_config_set_error(error, error_line, "invalid JSON Unicode escape", line[0])
																	digit_index = 4
																else
																	code = code * 16 + digit
																	project_config_advance(position, 1)
																	digit_index += 1
																end
															end
														end
														if error[0] == ""
															decoded := project_json_ascii_character(code)
															if decoded == ""
																project_config_set_error(error, error_line, "non-ASCII JSON Unicode escape is not supported", line[0])
															else
																result += decoded
															end
														end
													else
														project_config_set_error(error, error_line, "unsupported JSON escape", line[0])
													end
												end
											end
										end
									end
								end
							end
							if error[0] != ""
								scanning = false
							end
						end
					else
						code := ascii_code(character)
						if code >= 0
							if code < 32
								project_config_set_error(error, error_line, "control character in JSON string", line[0])
								scanning = false
							end
						end
						if scanning
							result += character
							project_config_advance(position, 1)
						end
					end
				end
			end
		end
	end
	if !closed
		if error[0] == ""
			project_config_set_error(error, error_line, "unterminated JSON string", line[0])
		end
	end
	return result
end

def project_json_literal_at(source: String, position: Integer, literal: String): Boolean
	if position + literal.size() > source.size()
		return false
	end
	mut index := 0
	while index < literal.size()
		if source[position + index] != literal[index]
			return false
		end
		index += 1
	end
	return true
end

def project_json_boolean(
		source: String,
		mut position: Array<Integer>,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if project_json_literal_at(source, position[0], "true")
		project_config_advance(position, 4)
		return true
	end
	if project_json_literal_at(source, position[0], "false")
		project_config_advance(position, 5)
		return false
	end
	project_config_set_error(error, error_line, "expected JSON Boolean", line)
	return false
end

def project_config_has_key(values: Array<String>, value: String): Boolean
	values.each do |item|
		if item == value
			return true
		end
	end
	return false
end

def project_json_expect(
		source: String,
		mut position: Array<Integer>,
		expected: String,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if position[0] < source.size()
		if source[position[0]] == expected
			project_config_advance(position, 1)
			return true
		end
	end
	project_config_set_error(error, error_line, "expected JSON " + expected, line)
	return false
end

def parse_project_go_config(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): ProjectGoConfig
	mut module_name := ""
	mut version := "1.27"
	mut root_package := "main"
	project_json_expect(source, position, "{", line[0], error, error_line)
	project_json_skip_ignored(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut finished := false
	while !finished
		if error[0] != ""
			finished = true
		else
			if position[0] < source.size()
				if source[position[0]] == "}"
					project_config_advance(position, 1)
					finished = true
				else
					key_line := line[0]
					key := project_json_string(source, position, line, error, error_line)
					if project_config_has_key(seen, key)
						project_config_set_error(error, error_line, "duplicate go configuration field " + key, key_line)
					else
						seen.push(key)
					end
					project_json_skip_ignored(source, position, line, error, error_line)
					project_json_expect(source, position, ":", line[0], error, error_line)
					project_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if key == "module"
							module_name = project_json_string(source, position, line, error, error_line)
						else
							if key == "version"
								version = project_json_string(source, position, line, error, error_line)
							else
								if key == "rootPackage"
									root_package = project_json_string(source, position, line, error, error_line)
								else
									project_config_set_error(error, error_line, "unsupported go configuration field " + key, key_line)
								end
							end
						end
					end
					project_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if position[0] < source.size()
							if source[position[0]] == ","
								project_config_advance(position, 1)
								project_json_skip_ignored(source, position, line, error, error_line)
								if position[0] < source.size()
									if source[position[0]] == "}"
										project_config_set_error(error, error_line, "trailing comma in go configuration", line[0])
									end
								end
							else
								if source[position[0]] != "}"
									project_config_set_error(error, error_line, "expected JSON , or }", line[0])
								end
							end
						else
							project_config_set_error(error, error_line, "unterminated go configuration", line[0])
						end
					end
				end
			else
				project_config_set_error(error, error_line, "unterminated go configuration", line[0])
			end
		end
	end
	if version == ""
		version = "1.27"
	end
	if root_package == ""
		root_package = "main"
	end
	return ProjectGoConfig.new(module_name: module_name, version: version, root_package: root_package)
end

def project_config_blank(value: String): Boolean
	mut index := 0
	while index < value.size()
		character := value[index]
		mut whitespace := character == " "
		if character == "\t"
			whitespace = true
		end
		if character == "\r"
			whitespace = true
		end
		if character == "\n"
			whitespace = true
		end
		if !whitespace
			return false
		end
		index += 1
	end
	return true
end

def project_config_clean_relative(
		value: String,
		field: String,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if value.size() > 0
		if value[0] == "/"
			project_config_set_error(error, error_line, field + " must be relative to the project root", 1)
			return ""
		end
	end
	mut segments: Array<String> := []
	mut segment_count := 0
	mut segment := ""
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "/"
				boundary = true
			end
		end
		if boundary
			if segment == ".."
				if segment_count == 0
					project_config_set_error(error, error_line, field + " cannot escape the project root", 1)
				else
					segment_count -= 1
				end
			else
				if segment != ""
					if segment != "."
						if segment_count < segments.size()
							segments[segment_count] = segment
						else
							segments.push(segment)
						end
						segment_count += 1
					end
				end
			end
			segment = ""
		else
			segment += value[index]
		end
		index += 1
	end
	mut result := ""
	index = 0
	while index < segment_count
		if result != ""
			result += "/"
		end
		result += segments[index]
		index += 1
	end
	if result == ""
		return "."
	end
	return result
end

def project_go_version_supported(value: String): Boolean
	mut components: Array<Integer> := []
	mut current := 0
	mut digits := 0
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "."
				boundary = true
			end
		end
		if boundary
			if digits == 0
				return false
			end
			components.push(current)
			current = 0
			digits = 0
		else
			code := ascii_code(value[index])
			if code < 48
				return false
			end
			if code > 57
				return false
			end
			digit := code - 48
			if current > 900719925474099
				return false
			end
			if current == 900719925474099
				if digit > 1
					return false
				end
			end
			current = current * 10 + digit
			digits += 1
		end
		index += 1
	end
	if components.size() < 2
		return false
	end
	if components.size() > 3
		return false
	end
	if components[0] > 1
		return true
	end
	if components[0] < 1
		return false
	end
	return components[1] >= 27
end

def project_config_result(
		name: String,
		version: String,
		mode: String,
		source_dir: String,
		out_dir: String,
		copy_files: Boolean,
		package_management: String,
		go_config: ProjectGoConfig,
		error: String,
		error_line: Integer,
	): ProjectConfig
	return ProjectConfig.new(
		name: name,
		version: version,
		mode: mode,
		source_dir: source_dir,
		out_dir: out_dir,
		copy_files: copy_files,
		package_management: package_management,
		go_config: go_config,
		error: error,
		error_line: error_line,
	)
end

def parse_project_config(source: String): ProjectConfig
	mut position := [0]
	mut line := [1]
	mut error := [""]
	mut error_line := [1]
	mut name := ""
	mut version := "0.1.0"
	mut mode := ""
	mut source_dir := "."
	mut out_dir := "build"
	mut copy_files := true
	mut package_management := "managed"
	mut go_config := ProjectGoConfig.new(module_name: "", version: "1.27", root_package: "main")
	project_json_skip_ignored(source, position, line, error, error_line)
	project_json_expect(source, position, "{", line[0], error, error_line)
	project_json_skip_ignored(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut finished := false
	while !finished
		if error[0] != ""
			finished = true
		else
			if position[0] < source.size()
				if source[position[0]] == "}"
					project_config_advance(position, 1)
					finished = true
				else
					key_line := line[0]
					key := project_json_string(source, position, line, error, error_line)
					if project_config_has_key(seen, key)
						project_config_set_error(error, error_line, "duplicate project configuration field " + key, key_line)
					else
						seen.push(key)
					end
					project_json_skip_ignored(source, position, line, error, error_line)
					project_json_expect(source, position, ":", line[0], error, error_line)
					project_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if key == "$schema"
							project_json_string(source, position, line, error, error_line)
						else
							if key == "name"
								name = project_json_string(source, position, line, error, error_line)
							else
								if key == "version"
									version = project_json_string(source, position, line, error, error_line)
								else
									if key == "mode"
										mode = project_json_string(source, position, line, error, error_line)
									else
										if key == "sourceDir"
											source_dir = project_json_string(source, position, line, error, error_line)
										else
											if key == "outDir"
												out_dir = project_json_string(source, position, line, error, error_line)
											else
												if key == "copyFiles"
													copy_files = project_json_boolean(source, position, line[0], error, error_line)
												else
													if key == "packageManagement"
														package_management = project_json_string(source, position, line, error, error_line)
													else
														if key == "go"
															go_config = parse_project_go_config(source, position, line, error, error_line)
														else
															project_config_set_error(error, error_line, "unsupported project configuration field " + key, key_line)
														end
													end
												end
											end
										end
									end
								end
							end
						end
					end
					project_json_skip_ignored(source, position, line, error, error_line)
					if error[0] == ""
						if position[0] < source.size()
							if source[position[0]] == ","
								project_config_advance(position, 1)
								project_json_skip_ignored(source, position, line, error, error_line)
								if position[0] < source.size()
									if source[position[0]] == "}"
										project_config_set_error(error, error_line, "trailing comma in project configuration", line[0])
									end
								end
							else
								if source[position[0]] != "}"
									project_config_set_error(error, error_line, "expected JSON , or }", line[0])
								end
							end
						else
							project_config_set_error(error, error_line, "unterminated project configuration", line[0])
						end
					end
				end
			else
				project_config_set_error(error, error_line, "unterminated project configuration", line[0])
			end
		end
	end
	project_json_skip_ignored(source, position, line, error, error_line)
	if error[0] == ""
		if position[0] != source.size()
			project_config_set_error(error, error_line, "unexpected data after project configuration", line[0])
		end
	end
	if error[0] == ""
		if project_config_blank(name)
			project_config_set_error(error, error_line, "name is required", 1)
		end
	end
	if error[0] == ""
		if mode != "go"
			if mode != "trb"
				if mode != ""
					project_config_set_error(error, error_line, "mode must be go or trb for configured Native builds", 1)
				end
			end
		end
	end
	if source_dir == ""
		source_dir = "."
	end
	if out_dir == ""
		out_dir = "build"
	end
	if package_management == ""
		package_management = "managed"
	end
	if error[0] == ""
		source_dir = project_config_clean_relative(source_dir, "sourceDir", error, error_line)
	end
	if error[0] == ""
		out_dir = project_config_clean_relative(out_dir, "outDir", error, error_line)
	end
	if error[0] == ""
		mut package_mode_supported := package_management == "managed"
		if package_management == "external"
			package_mode_supported = true
		end
		if !package_mode_supported
			project_config_set_error(error, error_line, "packageManagement must be managed or external", 1)
		end
	end
	if error[0] == ""
		if mode == "go"
			if project_config_blank(go_config.module_name)
				project_config_set_error(error, error_line, "go.module is required for mode go", 1)
			end
		end
	end
	if error[0] == ""
		if !project_go_version_supported(go_config.version)
			project_config_set_error(error, error_line, "go.version must be 1.27 or later", 1)
		end
	end
	return project_config_result(
		name,
		version,
		mode,
		source_dir,
		out_dir,
		copy_files,
		package_management,
		go_config,
		error[0],
		error_line[0],
	)
end
