import { ascii_code } from literals

record ProjectGoConfig
	module_name: String
	version: String
	root_package: String
	sqldef_present: Boolean
	sqldef_command: String
	sqldef_database: String
	sqldef_schema: String
end

# A TypeRB package requirement: a version or Git source, or a local path.
record ProjectPackageRequirement
	name: String
	source: String
	version: String
	path: String
end

# A localPackages entry that maps an import name to a source directory.
record ProjectLocalPackage
	name: String
	path: String
end

# The validated parts of a db section. Its other settings belong to the
# database commands.
record ProjectDatabaseSection
	adapter: String
	schema: String
	lock: String
	source_present: Boolean
	value: String
	environment: String
end

record ProjectLintSection
	preset: String
	rules: Array<String>
	levels: Array<String>
end

record ProjectConfig
	name: String
	version: String
	mode: String
	source_dir: String
	out_dir: String
	copy_files: Boolean
	package_management: String
	go_config: ProjectGoConfig
	packages: Array<ProjectPackageRequirement>
	local_packages: Array<ProjectLocalPackage>
	error: String
	error_line: Integer
end

def project_config_set_error(
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		message: String,
		line: Integer,
	)
	if error[0] == ""
		error[0] = message
		error_line[0] = line
	end
	return
end

def project_config_advance(mut value: Array<Integer>, amount: Integer)
	value[0] = value[0] + amount
	return
end

def project_json_skip_ignored(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == " "
				project_config_advance(position, 1)
			else
				if character == "\t"
					project_config_advance(position, 1)
				else
					if character == "\r"
						project_config_advance(position, 1)
					else
						if character == "\n"
							project_config_advance(position, 1)
							project_config_advance(line, 1)
						else
							if character == "/"
								if position[0] + 1 < source.size()
									following := source[position[0] + 1]
									if following == "/"
										project_config_advance(position, 2)
										mut comment := true
										while comment
											if position[0] >= source.size()
												comment = false
											else
												if source[position[0]] == "\n"
													comment = false
												else
													project_config_advance(position, 1)
												end
											end
										end
									else
										if following == "*"
											start_line := line[0]
											project_config_advance(position, 2)
											mut comment := true
											mut closed := false
											while comment
												if position[0] >= source.size()
													comment = false
												else
													if source[position[0]] == "\n"
														project_config_advance(line, 1)
													end
													if source[position[0]] == "*"
														if position[0] + 1 < source.size()
															if source[position[0] + 1] == "/"
																project_config_advance(position, 2)
																closed = true
																comment = false
															end
														end
													end
													if comment
														project_config_advance(position, 1)
													end
												end
											end
											if !closed
												project_config_set_error(error, error_line, "unterminated JSONC block comment", start_line)
												scanning = false
											end
										else
											scanning = false
										end
									end
								else
									scanning = false
								end
							else
								scanning = false
							end
						end
					end
				end
			end
		end
	end
	return error[0] == ""
end

def project_json_hex_digit(character: String): Integer
	code := ascii_code(character)
	if code >= 48
		if code <= 57
			return code - 48
		end
	end
	if code >= 65
		if code <= 70
			return code - 55
		end
	end
	if code >= 97
		if code <= 102
			return code - 87
		end
	end
	return -1
end

def project_json_ascii_character(code: Integer): String
	if code == 9
		return "\t"
	end
	if code == 10
		return "\n"
	end
	if code == 13
		return "\r"
	end
	if code < 32
		return ""
	end
	if code > 126
		return ""
	end
	return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"[code - 32]
end

def project_json_string(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if position[0] >= source.size()
		project_config_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	if source[position[0]] != "\""
		project_config_set_error(error, error_line, "expected JSON string", line[0])
		return ""
	end
	project_config_advance(position, 1)
	mut result := ""
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			character := source[position[0]]
			if character == "\""
				project_config_advance(position, 1)
				closed = true
				scanning = false
			else
				if character == "\n"
					project_config_set_error(error, error_line, "newline in JSON string", line[0])
					scanning = false
				else
					if character == "\\"
						project_config_advance(position, 1)
						if position[0] >= source.size()
							project_config_set_error(error, error_line, "unterminated JSON escape", line[0])
							scanning = false
						else
							escaped := source[position[0]]
							project_config_advance(position, 1)
							if escaped == "\""
								result += "\""
							else
								if escaped == "\\"
									result += "\\"
								else
									if escaped == "/"
										result += "/"
									else
										if escaped == "n"
											result += "\n"
										else
											if escaped == "r"
												result += "\r"
											else
												if escaped == "t"
													result += "\t"
												else
													if escaped == "u"
														mut code := 0
														mut digit_index := 0
														while digit_index < 4
															if position[0] >= source.size()
																project_config_set_error(error, error_line, "incomplete JSON Unicode escape", line[0])
																digit_index = 4
															else
																digit := project_json_hex_digit(source[position[0]])
																if digit < 0
																	project_config_set_error(error, error_line, "invalid JSON Unicode escape", line[0])
																	digit_index = 4
																else
																	code = code * 16 + digit
																	project_config_advance(position, 1)
																	digit_index += 1
																end
															end
														end
														if error[0] == ""
															decoded := project_json_ascii_character(code)
															if decoded == ""
																project_config_set_error(error, error_line, "non-ASCII JSON Unicode escape is not supported", line[0])
															else
																result += decoded
															end
														end
													else
														project_config_set_error(error, error_line, "unsupported JSON escape", line[0])
													end
												end
											end
										end
									end
								end
							end
							if error[0] != ""
								scanning = false
							end
						end
					else
						code := ascii_code(character)
						if code >= 0
							if code < 32
								project_config_set_error(error, error_line, "control character in JSON string", line[0])
								scanning = false
							end
						end
						if scanning
							result += character
							project_config_advance(position, 1)
						end
					end
				end
			end
		end
	end
	if !closed
		if error[0] == ""
			project_config_set_error(error, error_line, "unterminated JSON string", line[0])
		end
	end
	return result
end

def project_json_literal_at(source: String, position: Integer, literal: String): Boolean
	if position + literal.size() > source.size()
		return false
	end
	mut index := 0
	while index < literal.size()
		if source[position + index] != literal[index]
			return false
		end
		index += 1
	end
	return true
end

def project_json_boolean(
		source: String,
		mut position: Array<Integer>,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if project_json_literal_at(source, position[0], "true")
		project_config_advance(position, 4)
		return true
	end
	if project_json_literal_at(source, position[0], "false")
		project_config_advance(position, 5)
		return false
	end
	project_config_set_error(error, error_line, "expected JSON Boolean", line)
	return false
end

def project_config_has_key(values: Array<String>, value: String): Boolean
	values.each do |item|
		if item == value
			return true
		end
	end
	return false
end

def project_json_expect(
		source: String,
		mut position: Array<Integer>,
		expected: String,
		line: Integer,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): Boolean
	if position[0] < source.size()
		if source[position[0]] == expected
			project_config_advance(position, 1)
			return true
		end
	end
	project_config_set_error(error, error_line, "expected JSON " + expected, line)
	return false
end

def project_json_object_open(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	)
	project_json_expect(source, position, "{", line[0], error, error_line)
	project_json_skip_ignored(source, position, line, error, error_line)
	return
end

# Reads the next object key and its colon, or consumes the closing brace and
# sets done. Declared structures reject duplicate keys; maps and opaque values
# accept them like the reference decoder, where the last value wins.
def project_json_object_key(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		mut seen: Array<String>,
		context: String,
		check_duplicates: Boolean,
		mut done: Array<Boolean>,
		mut key_line: Array<Integer>,
	): String
	if error[0] != ""
		done[0] = true
		return ""
	end
	if position[0] >= source.size()
		project_config_set_error(error, error_line, "unterminated " + context, line[0])
		done[0] = true
		return ""
	end
	if source[position[0]] == "}"
		project_config_advance(position, 1)
		done[0] = true
		return ""
	end
	key_line[0] = line[0]
	key := project_json_string(source, position, line, error, error_line)
	if check_duplicates
		if project_config_has_key(seen, key)
			project_config_set_error(error, error_line, "duplicate " + context + " field " + key, key_line[0])
		else
			seen.push(key)
		end
	end
	project_json_skip_ignored(source, position, line, error, error_line)
	project_json_expect(source, position, ":", line[0], error, error_line)
	project_json_skip_ignored(source, position, line, error, error_line)
	if error[0] != ""
		done[0] = true
	end
	return key
end

def project_json_object_after_value(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		context: String,
	)
	project_json_skip_ignored(source, position, line, error, error_line)
	if error[0] != ""
		return
	end
	if position[0] >= source.size()
		project_config_set_error(error, error_line, "unterminated " + context, line[0])
		return
	end
	if source[position[0]] == ","
		project_config_advance(position, 1)
		project_json_skip_ignored(source, position, line, error, error_line)
		if position[0] < source.size() && source[position[0]] == "}"
			project_config_set_error(error, error_line, "trailing comma in " + context, line[0])
		end
		return
	end
	if source[position[0]] != "}"
		project_config_set_error(error, error_line, "expected JSON , or }", line[0])
	end
	return
end

def project_json_number_character(character: String): Boolean
	code := ascii_code(character)
	if code >= 48 && code <= 57
		return true
	end
	if character == "-" || character == "+" || character == "." || character == "e" || character == "E"
		return true
	end
	return false
end

# Reads a JSON array. Elements are Strings when strings_only is set and are
# otherwise skipped as opaque values.
def project_json_array(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		strings_only: Boolean,
	)
	project_json_expect(source, position, "[", line[0], error, error_line)
	project_json_skip_ignored(source, position, line, error, error_line)
	if error[0] != ""
		return
	end
	if position[0] < source.size() && source[position[0]] == "]"
		project_config_advance(position, 1)
		return
	end
	mut scanning := true
	while scanning
		if strings_only
			project_json_string(source, position, line, error, error_line)
		else
			project_json_skip_value(source, position, line, error, error_line)
		end
		project_json_skip_ignored(source, position, line, error, error_line)
		if error[0] != ""
			scanning = false
		elsif position[0] >= source.size()
			project_config_set_error(error, error_line, "unterminated JSON array", line[0])
			scanning = false
		elsif source[position[0]] == ","
			project_config_advance(position, 1)
			project_json_skip_ignored(source, position, line, error, error_line)
			if position[0] < source.size() && source[position[0]] == "]"
				project_config_set_error(error, error_line, "trailing comma in JSON array", line[0])
				scanning = false
			end
		elsif source[position[0]] == "]"
			project_config_advance(position, 1)
			scanning = false
		else
			project_config_set_error(error, error_line, "expected JSON , or ]", line[0])
			scanning = false
		end
	end
	return
end

# Skips one JSON value whose content the configuration keeps opaque, such as
# a packageOptions entry.
def project_json_skip_value(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	)
	if error[0] != ""
		return
	end
	if position[0] >= source.size()
		project_config_set_error(error, error_line, "expected JSON value", line[0])
		return
	end
	character := source[position[0]]
	if character == "\""
		project_json_string(source, position, line, error, error_line)
	elsif character == "{"
		project_json_object_open(source, position, line, error, error_line)
		mut seen: Array<String> := []
		mut done := [false]
		mut key_line := [0]
		while !done[0]
			project_json_object_key(source, position, line, error, error_line, seen, "JSON object", false, done, key_line)
			if !done[0]
				project_json_skip_value(source, position, line, error, error_line)
				project_json_object_after_value(source, position, line, error, error_line, "JSON object")
			end
		end
	elsif character == "["
		project_json_array(source, position, line, error, error_line, false)
	elsif project_json_literal_at(source, position[0], "true")
		project_config_advance(position, 4)
	elsif project_json_literal_at(source, position[0], "false")
		project_config_advance(position, 5)
	elsif project_json_literal_at(source, position[0], "null")
		project_config_advance(position, 4)
	elsif project_json_number_character(character)
		while position[0] < source.size() && project_json_number_character(source[position[0]])
			project_config_advance(position, 1)
		end
	else
		project_config_set_error(error, error_line, "expected JSON value", line[0])
	end
	return
end

# Reads an object of String values. A repeated key replaces the earlier value.
def project_json_string_map(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		context: String,
		mut keys: Array<String>,
		mut values: Array<String>,
	)
	project_json_object_open(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut done := [false]
	mut key_line := [0]
	while !done[0]
		key := project_json_object_key(source, position, line, error, error_line, seen, context, false, done, key_line)
		if !done[0]
			value := project_json_string(source, position, line, error, error_line)
			mut index := 0
			mut replaced := false
			while index < keys.size()
				if keys[index] == key
					values[index] = value
					replaced = true
				end
				index += 1
			end
			if !replaced
				keys.push(key)
				values.push(value)
			end
			project_json_object_after_value(source, position, line, error, error_line, context)
		end
	end
	return
end

def parse_project_go_config(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): ProjectGoConfig
	mut module_name := ""
	mut version := "1.27"
	mut root_package := "main"
	mut sqldef_present := false
	mut sqldef_command := ""
	mut sqldef_database := ""
	mut sqldef_schema := ""
	project_json_object_open(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut done := [false]
	mut key_line := [0]
	while !done[0]
		key := project_json_object_key(source, position, line, error, error_line, seen, "go configuration", true, done, key_line)
		if !done[0]
			if key == "module"
				module_name = project_json_string(source, position, line, error, error_line)
			elsif key == "version"
				version = project_json_string(source, position, line, error, error_line)
			elsif key == "rootPackage"
				root_package = project_json_string(source, position, line, error, error_line)
			elsif key == "indirectDependencies"
				mut names: Array<String> := []
				mut versions: Array<String> := []
				project_json_string_map(source, position, line, error, error_line, "go.indirectDependencies", names, versions)
			elsif key == "sqldef"
				sqldef_present = true
				project_json_object_open(source, position, line, error, error_line)
				mut sqldef_seen: Array<String> := []
				mut sqldef_done := [false]
				mut sqldef_key_line := [0]
				while !sqldef_done[0]
					field := project_json_object_key(source, position, line, error, error_line, sqldef_seen, "go.sqldef configuration", true, sqldef_done, sqldef_key_line)
					if !sqldef_done[0]
						if field == "command"
							sqldef_command = project_json_string(source, position, line, error, error_line)
						elsif field == "database"
							sqldef_database = project_json_string(source, position, line, error, error_line)
						elsif field == "schema"
							sqldef_schema = project_json_string(source, position, line, error, error_line)
						elsif field == "arguments"
							project_json_array(source, position, line, error, error_line, true)
						else
							project_config_set_error(error, error_line, "unsupported go.sqldef configuration field " + field, sqldef_key_line[0])
						end
						project_json_object_after_value(source, position, line, error, error_line, "go.sqldef configuration")
					end
				end
			else
				project_config_set_error(error, error_line, "unsupported go configuration field " + key, key_line[0])
			end
			project_json_object_after_value(source, position, line, error, error_line, "go configuration")
		end
	end
	if version == ""
		version = "1.27"
	end
	if root_package == ""
		root_package = "main"
	end
	return ProjectGoConfig.new(
		module_name: module_name,
		version: version,
		root_package: root_package,
		sqldef_present: sqldef_present,
		sqldef_command: sqldef_command,
		sqldef_database: sqldef_database,
		sqldef_schema: sqldef_schema,
	)
end

# A requirement is a version String or an object with source, version or path.
def parse_project_package_requirement(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		name: String,
	): ProjectPackageRequirement
	mut requirement_source := ""
	mut version := ""
	mut path := ""
	if position[0] < source.size() && source[position[0]] == "\""
		version = project_json_string(source, position, line, error, error_line)
	elsif project_json_literal_at(source, position[0], "null")
		project_config_set_error(error, error_line, "package requirement cannot be null", line[0])
	else
		project_json_object_open(source, position, line, error, error_line)
		mut seen: Array<String> := []
		mut done := [false]
		mut key_line := [0]
		while !done[0]
			key := project_json_object_key(source, position, line, error, error_line, seen, "package requirement", true, done, key_line)
			if !done[0]
				if key == "source"
					requirement_source = project_json_string(source, position, line, error, error_line)
				elsif key == "version"
					version = project_json_string(source, position, line, error, error_line)
				elsif key == "path"
					path = project_json_string(source, position, line, error, error_line)
				else
					project_config_set_error(error, error_line, "unsupported package requirement field " + key, key_line[0])
				end
				project_json_object_after_value(source, position, line, error, error_line, "package requirement")
			end
		end
	end
	return ProjectPackageRequirement.new(name: name, source: requirement_source, version: version, path: path)
end

def parse_project_packages(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		mut packages: Array<ProjectPackageRequirement>,
	)
	project_json_object_open(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut done := [false]
	mut key_line := [0]
	while !done[0]
		name := project_json_object_key(source, position, line, error, error_line, seen, "packages", false, done, key_line)
		if !done[0]
			requirement := parse_project_package_requirement(source, position, line, error, error_line, name)
			mut index := 0
			mut replaced := false
			while index < packages.size()
				if packages[index].name == name
					packages[index] = requirement
					replaced = true
				end
				index += 1
			end
			if !replaced
				packages.push(requirement)
			end
			project_json_object_after_value(source, position, line, error, error_line, "packages")
		end
	end
	return
end

# Reads a section whose declared fields are all Strings, returning them in
# the order of fields. Unknown fields are rejected like the reference decoder.
def parse_project_string_section(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
		context: String,
		fields: Array<String>,
		map_field: String,
	): Array<String>
	mut values: Array<String> := []
	mut initialized := 0
	while initialized < fields.size()
		values.push("")
		initialized += 1
	end
	project_json_object_open(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut done := [false]
	mut key_line := [0]
	while !done[0]
		key := project_json_object_key(source, position, line, error, error_line, seen, context + " configuration", true, done, key_line)
		if !done[0]
			mut matched := false
			mut index := 0
			while index < fields.size()
				if fields[index] == key
					values[index] = project_json_string(source, position, line, error, error_line)
					matched = true
				end
				index += 1
			end
			if !matched
				if key == map_field
					mut names: Array<String> := []
					mut entries: Array<String> := []
					project_json_string_map(source, position, line, error, error_line, context + "." + map_field, names, entries)
				else
					project_config_set_error(error, error_line, "unsupported " + context + " configuration field " + key, key_line[0])
				end
			end
			project_json_object_after_value(source, position, line, error, error_line, context + " configuration")
		end
	end
	return values
end

def parse_project_database(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): ProjectDatabaseSection
	mut adapter := ""
	mut schema := ""
	mut lock := ""
	mut source_present := false
	mut value := ""
	mut environment := ""
	project_json_object_open(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut done := [false]
	mut key_line := [0]
	while !done[0]
		key := project_json_object_key(source, position, line, error, error_line, seen, "db configuration", true, done, key_line)
		if !done[0]
			if key == "adapter"
				adapter = project_json_string(source, position, line, error, error_line)
			elsif key == "schema"
				schema = project_json_string(source, position, line, error, error_line)
			elsif key == "lock"
				lock = project_json_string(source, position, line, error, error_line)
			elsif key == "database"
				if project_json_literal_at(source, position[0], "null")
					project_config_advance(position, 4)
				elsif position[0] < source.size() && source[position[0]] == "\""
					source_present = true
					value = project_json_string(source, position, line, error, error_line)
				else
					source_present = true
					project_json_object_open(source, position, line, error, error_line)
					mut database_seen: Array<String> := []
					mut database_done := [false]
					mut database_key_line := [0]
					while !database_done[0]
						field := project_json_object_key(source, position, line, error, error_line, database_seen, "db.database", true, database_done, database_key_line)
						if !database_done[0]
							if field == "environment"
								environment = project_json_string(source, position, line, error, error_line)
							else
								project_config_set_error(error, error_line, "db.database must be a string or an environment source", database_key_line[0])
							end
							project_json_object_after_value(source, position, line, error, error_line, "db.database")
						end
					end
				end
			elsif key == "sqldef"
				project_json_object_open(source, position, line, error, error_line)
				mut sqldef_seen: Array<String> := []
				mut sqldef_done := [false]
				mut sqldef_key_line := [0]
				while !sqldef_done[0]
					field := project_json_object_key(source, position, line, error, error_line, sqldef_seen, "db.sqldef configuration", true, sqldef_done, sqldef_key_line)
					if !sqldef_done[0]
						if field == "command" || field == "version"
							project_json_string(source, position, line, error, error_line)
						elsif field == "arguments"
							project_json_array(source, position, line, error, error_line, true)
						else
							project_config_set_error(error, error_line, "unsupported db.sqldef configuration field " + field, sqldef_key_line[0])
						end
						project_json_object_after_value(source, position, line, error, error_line, "db.sqldef configuration")
					end
				end
			else
				project_config_set_error(error, error_line, "unsupported db configuration field " + key, key_line[0])
			end
			project_json_object_after_value(source, position, line, error, error_line, "db configuration")
		end
	end
	return ProjectDatabaseSection.new(
		adapter: adapter,
		schema: schema,
		lock: lock,
		source_present: source_present,
		value: value,
		environment: environment,
	)
end

def parse_project_lint(
		source: String,
		mut position: Array<Integer>,
		mut line: Array<Integer>,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): ProjectLintSection
	mut preset := ""
	mut rules: Array<String> := []
	mut levels: Array<String> := []
	project_json_object_open(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut done := [false]
	mut key_line := [0]
	while !done[0]
		key := project_json_object_key(source, position, line, error, error_line, seen, "lint configuration", true, done, key_line)
		if !done[0]
			if key == "preset"
				preset = project_json_string(source, position, line, error, error_line)
			elsif key == "rules"
				project_json_string_map(source, position, line, error, error_line, "lint.rules", rules, levels)
			else
				project_config_set_error(error, error_line, "unsupported lint configuration field " + key, key_line[0])
			end
			project_json_object_after_value(source, position, line, error, error_line, "lint configuration")
		end
	end
	return ProjectLintSection.new(preset: preset, rules: rules, levels: levels)
end

def project_config_blank(value: String): Boolean
	mut index := 0
	while index < value.size()
		character := value[index]
		mut whitespace := character == " "
		if character == "\t"
			whitespace = true
		end
		if character == "\r"
			whitespace = true
		end
		if character == "\n"
			whitespace = true
		end
		if !whitespace
			return false
		end
		index += 1
	end
	return true
end

def project_config_clean_relative(
		value: String,
		field: String,
		mut error: Array<String>,
		mut error_line: Array<Integer>,
	): String
	if value.size() > 0
		if value[0] == "/"
			project_config_set_error(error, error_line, field + " must be relative to the project root", 1)
			return ""
		end
	end
	mut segments: Array<String> := []
	mut segment_count := 0
	mut segment := ""
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "/"
				boundary = true
			end
		end
		if boundary
			if segment == ".."
				if segment_count == 0
					project_config_set_error(error, error_line, field + " cannot escape the project root", 1)
				else
					segment_count -= 1
				end
			else
				if segment != ""
					if segment != "."
						if segment_count < segments.size()
							segments[segment_count] = segment
						else
							segments.push(segment)
						end
						segment_count += 1
					end
				end
			end
			segment = ""
		else
			segment += value[index]
		end
		index += 1
	end
	mut result := ""
	index = 0
	while index < segment_count
		if result != ""
			result += "/"
		end
		result += segments[index]
		index += 1
	end
	if result == ""
		return "."
	end
	return result
end

def project_go_version_supported(value: String): Boolean
	mut components: Array<Integer> := []
	mut current := 0
	mut digits := 0
	mut index := 0
	while index <= value.size()
		mut boundary := index == value.size()
		if !boundary
			if value[index] == "."
				boundary = true
			end
		end
		if boundary
			if digits == 0
				return false
			end
			components.push(current)
			current = 0
			digits = 0
		else
			code := ascii_code(value[index])
			if code < 48
				return false
			end
			if code > 57
				return false
			end
			digit := code - 48
			if current > 900719925474099
				return false
			end
			if current == 900719925474099
				if digit > 1
					return false
				end
			end
			current = current * 10 + digit
			digits += 1
		end
		index += 1
	end
	if components.size() < 2
		return false
	end
	if components.size() > 3
		return false
	end
	if components[0] > 1
		return true
	end
	if components[0] < 1
		return false
	end
	return components[1] >= 27
end

def project_config_trimmed(value: String): String
	mut start := 0
	mut finish := value.size()
	while start < finish && project_config_blank(value[start])
		start += 1
	end
	while finish > start && project_config_blank(value[finish - 1])
		finish -= 1
	end
	mut result := ""
	mut index := start
	while index < finish
		result += value[index]
		index += 1
	end
	return result
end

def project_config_lower_ascii(value: String): String
	mut result := ""
	mut index := 0
	while index < value.size()
		code := ascii_code(value[index])
		if code >= 65 && code <= 90
			result += project_json_ascii_character(code + 32)
		else
			result += value[index]
		end
		index += 1
	end
	return result
end

def project_config_absolute(path: String): Boolean
	if path.size() > 0 && path[0] == "/"
		return true
	end
	return false
end

# Reports whether a relative path leaves its root once cleaned, matching the
# reference's filepath.Clean check.
def project_config_escapes_root(path: String): Boolean
	mut depth := 0
	mut segment := ""
	mut index := 0
	while index <= path.size()
		if index == path.size() || path[index] == "/"
			if segment == ".."
				depth -= 1
				if depth < 0
					return true
				end
			elsif segment != "" && segment != "."
				depth += 1
			end
			segment = ""
		else
			segment += path[index]
		end
		index += 1
	end
	return false
end

def project_config_below_root(path: String): Boolean
	if project_config_absolute(path) || project_config_escapes_root(path)
		return false
	end
	return true
end

# A package name is a clean relative path outside trb/ without spaces,
# backslashes or @, like the reference's validPackageName.
def project_config_valid_package_name(name: String): Boolean
	if name == "" || project_config_absolute(name)
		return false
	end
	if name.size() >= 4 && name[0] == "t" && name[1] == "r" && name[2] == "b" && name[3] == "/"
		return false
	end
	mut segment := ""
	mut index := 0
	while index <= name.size()
		if index == name.size() || name[index] == "/"
			if segment == "" || segment == "." || segment == ".."
				return false
			end
			segment = ""
		else
			character := name[index]
			if character == " " || character == "\\" || character == "@"
				return false
			end
			segment += character
		end
		index += 1
	end
	return true
end

def project_config_declared_mode(mode: String): Boolean
	if mode == "go" || mode == "ruby" || mode == "typescript" || mode == "trb"
		return true
	end
	return false
end

# Explains why a valid configuration cannot be loaded yet, or returns "".
def project_config_support_error(config: ProjectConfig): String
	if config.packages.size() > 0
		return "TypeRB package loading is not implemented"
	end
	return ""
end

def parse_project_config(source: String): ProjectConfig
	mut position := [0]
	mut line := [1]
	mut error := [""]
	mut error_line := [1]
	mut name := ""
	mut version := "0.1.0"
	mut mode := ""
	mut source_dir := "."
	mut out_dir := "build"
	mut copy_files := true
	mut package_management := "managed"
	mut go_config := ProjectGoConfig.new(
		module_name: "",
		version: "1.27",
		root_package: "main",
		sqldef_present: false,
		sqldef_command: "",
		sqldef_database: "",
		sqldef_schema: "",
	)
	mut packages: Array<ProjectPackageRequirement> := []
	mut local_names: Array<String> := []
	mut local_paths: Array<String> := []
	mut dependency_names: Array<String> := []
	mut dependency_versions: Array<String> := []
	mut development_names: Array<String> := []
	mut development_versions: Array<String> := []
	mut ruby_loader := ""
	mut typescript_runtime := ""
	mut database_present := false
	mut database := ProjectDatabaseSection.new(adapter: "", schema: "", lock: "", source_present: false, value: "", environment: "")
	mut jobs_present := false
	mut jobs_configuration := ""
	mut no_rules: Array<String> := []
	mut no_levels: Array<String> := []
	mut lint := ProjectLintSection.new(preset: "", rules: no_rules, levels: no_levels)
	project_json_skip_ignored(source, position, line, error, error_line)
	project_json_object_open(source, position, line, error, error_line)
	mut seen: Array<String> := []
	mut done := [false]
	mut key_line := [0]
	while !done[0]
		key := project_json_object_key(source, position, line, error, error_line, seen, "project configuration", true, done, key_line)
		if !done[0]
			if key == "$schema"
				project_json_string(source, position, line, error, error_line)
			elsif key == "name"
				name = project_json_string(source, position, line, error, error_line)
			elsif key == "version"
				version = project_json_string(source, position, line, error, error_line)
			elsif key == "mode"
				mode = project_json_string(source, position, line, error, error_line)
			elsif key == "sourceDir"
				source_dir = project_json_string(source, position, line, error, error_line)
			elsif key == "outDir"
				out_dir = project_json_string(source, position, line, error, error_line)
			elsif key == "copyFiles"
				copy_files = project_json_boolean(source, position, line[0], error, error_line)
			elsif key == "packageManagement"
				package_management = project_json_string(source, position, line, error, error_line)
			elsif key == "packages"
				parse_project_packages(source, position, line, error, error_line, packages)
			elsif key == "dependencies"
				project_json_string_map(source, position, line, error, error_line, "dependencies", dependency_names, dependency_versions)
			elsif key == "devDependencies"
				project_json_string_map(source, position, line, error, error_line, "devDependencies", development_names, development_versions)
			elsif key == "localPackages"
				project_json_string_map(source, position, line, error, error_line, "localPackages", local_names, local_paths)
			elsif key == "packageOptions"
				# Package options stay opaque here; the owning package validates them.
				project_json_object_open(source, position, line, error, error_line)
				mut option_seen: Array<String> := []
				mut option_done := [false]
				mut option_key_line := [0]
				while !option_done[0]
					project_json_object_key(source, position, line, error, error_line, option_seen, "packageOptions", false, option_done, option_key_line)
					if !option_done[0]
						project_json_skip_value(source, position, line, error, error_line)
						project_json_object_after_value(source, position, line, error, error_line, "packageOptions")
					end
				end
			elsif key == "ruby"
				ruby := parse_project_string_section(source, position, line, error, error_line, "ruby", ["source", "version", "loader"], "")
				ruby_loader = ruby[2]
			elsif key == "go"
				go_config = parse_project_go_config(source, position, line, error, error_line)
			elsif key == "typescript"
				typescript := parse_project_string_section(source, position, line, error, error_line, "typescript", ["packageManager", "moduleType", "runtime"], "scripts")
				typescript_runtime = typescript[2]
			elsif key == "db"
				database_present = true
				database = parse_project_database(source, position, line, error, error_line)
			elsif key == "jobs"
				jobs_present = true
				jobs := parse_project_string_section(source, position, line, error, error_line, "jobs", ["configuration"], "")
				jobs_configuration = jobs[0]
			elsif key == "lint"
				lint = parse_project_lint(source, position, line, error, error_line)
			else
				project_config_set_error(error, error_line, "unsupported project configuration field " + key, key_line[0])
			end
			project_json_object_after_value(source, position, line, error, error_line, "project configuration")
		end
	end
	project_json_skip_ignored(source, position, line, error, error_line)
	if error[0] == "" && position[0] != source.size()
		project_config_set_error(error, error_line, "unexpected data after project configuration", line[0])
	end
	if error[0] == "" && project_config_blank(name)
		project_config_set_error(error, error_line, "name is required", 1)
	end
	if error[0] == "" && mode != "" && !project_config_declared_mode(mode)
		project_config_set_error(error, error_line, "mode must be go, ruby, typescript, or trb", 1)
	end
	if source_dir == ""
		source_dir = "."
	end
	if out_dir == ""
		out_dir = "build"
	end
	if package_management == ""
		package_management = "managed"
	end
	if error[0] == ""
		source_dir = project_config_clean_relative(source_dir, "sourceDir", error, error_line)
	end
	if error[0] == ""
		out_dir = project_config_clean_relative(out_dir, "outDir", error, error_line)
	end
	if error[0] == "" && package_management != "managed" && package_management != "external"
		project_config_set_error(error, error_line, "packageManagement must be managed or external", 1)
	end
	mut local_packages: Array<ProjectLocalPackage> := []
	mut local_index := 0
	while local_index < local_names.size()
		local_name := local_names[local_index]
		if error[0] == "" && !project_config_valid_package_name(local_name)
			project_config_set_error(error, error_line, "invalid local package name " + local_name, 1)
		end
		if error[0] == "" && project_config_blank(local_paths[local_index])
			project_config_set_error(error, error_line, "local package " + local_name + " requires a path", 1)
		end
		local_packages.push(ProjectLocalPackage.new(name: local_name, path: local_paths[local_index]))
		local_index += 1
	end
	mut package_index := 0
	while package_index < packages.size()
		requirement := packages[package_index]
		if error[0] == "" && !project_config_valid_package_name(requirement.name)
			project_config_set_error(error, error_line, "invalid TypeRB package name " + requirement.name, 1)
		end
		if error[0] == "" && !project_config_blank(requirement.path)
			if !project_config_blank(requirement.source) || !project_config_blank(requirement.version)
				project_config_set_error(error, error_line, "TypeRB package " + requirement.name + " path cannot be combined with source or version", 1)
			end
		elsif error[0] == "" && project_config_blank(requirement.version)
			project_config_set_error(error, error_line, "TypeRB package " + requirement.name + " requires a version or path", 1)
		end
		package_index += 1
	end
	mut dependency_index := 0
	while error[0] == "" && mode == "typescript" && dependency_index < dependency_names.size()
		dependency := dependency_names[dependency_index]
		mut requirement_index := 0
		while requirement_index < packages.size()
			if error[0] == "" && packages[requirement_index].name == dependency
				project_config_set_error(error, error_line, "dependency " + dependency + " is declared as both a TypeRB package and a native TypeScript package", 1)
			end
			requirement_index += 1
		end
		if error[0] == "" && project_config_has_key(local_names, dependency)
			project_config_set_error(error, error_line, "dependency " + dependency + " is declared as both a local TypeRB package and a native TypeScript package", 1)
		end
		dependency_index += 1
	end
	if error[0] == "" && mode == "go" && project_config_blank(go_config.module_name)
		project_config_set_error(error, error_line, "go.module is required for mode go", 1)
	end
	if error[0] == "" && !project_go_version_supported(go_config.version)
		project_config_set_error(error, error_line, "go.version must be 1.27 or later", 1)
	end
	if error[0] == "" && go_config.sqldef_present
		if project_config_blank(go_config.sqldef_command) || project_config_blank(go_config.sqldef_database) || project_config_blank(go_config.sqldef_schema)
			project_config_set_error(error, error_line, "go.sqldef requires command, database, and schema", 1)
		elsif !project_config_below_root(go_config.sqldef_database) || !project_config_below_root(go_config.sqldef_schema)
			project_config_set_error(error, error_line, "go.sqldef database and schema must stay below the project root", 1)
		end
	end
	if error[0] == "" && database_present
		adapter := project_config_lower_ascii(project_config_trimmed(database.adapter))
		if adapter != "sqlite" && adapter != "postgresql" && adapter != "mysql"
			project_config_set_error(error, error_line, "db.adapter must be sqlite, postgresql, or mysql", 1)
		elsif !project_config_below_root(database.schema)
			project_config_set_error(error, error_line, "db.schema must stay below the project root", 1)
		elsif !project_config_below_root(database.lock)
			project_config_set_error(error, error_line, "db.lock must stay below the project root", 1)
		elsif database.source_present && project_config_blank(database.value) && project_config_blank(database.environment)
			project_config_set_error(error, error_line, "db.database must be a non-empty string or environment source", 1)
		end
	end
	if error[0] == "" && jobs_present
		mut configuration := project_config_trimmed(jobs_configuration)
		if configuration.size() >= 4 && configuration[configuration.size() - 4] == "." && configuration[configuration.size() - 3] == "t" && configuration[configuration.size() - 2] == "r" && configuration[configuration.size() - 1] == "b"
			mut stem := ""
			mut stem_index := 0
			while stem_index < configuration.size() - 4
				stem += configuration[stem_index]
				stem_index += 1
			end
			configuration = stem
		end
		if configuration == ""
			project_config_set_error(error, error_line, "jobs.configuration is required", 1)
		elsif !project_config_below_root(configuration)
			project_config_set_error(error, error_line, "jobs.configuration must stay below sourceDir", 1)
		end
	end
	if error[0] == ""
		preset := project_config_trimmed(lint.preset)
		if preset != "" && preset != "recommended" && preset != "none"
			project_config_set_error(error, error_line, "lint.preset must be recommended or none", 1)
		end
	end
	mut rule_index := 0
	while error[0] == "" && rule_index < lint.rules.size()
		level := project_config_trimmed(lint.levels[rule_index])
		if level != "off" && level != "warning" && level != "error"
			project_config_set_error(error, error_line, "lint rule " + lint.rules[rule_index] + " level must be off, warning, or error", 1)
		end
		rule_index += 1
	end
	if error[0] == "" && ruby_loader != "" && ruby_loader != "require_relative" && ruby_loader != "zeitwerk"
		project_config_set_error(error, error_line, "ruby.loader must be require_relative or zeitwerk", 1)
	end
	if error[0] == "" && typescript_runtime != "" && typescript_runtime != "browser" && typescript_runtime != "bun" && typescript_runtime != "node"
		project_config_set_error(error, error_line, "typescript.runtime must be browser, bun, or node", 1)
	end
	return ProjectConfig.new(
		name: name,
		version: version,
		mode: mode,
		source_dir: source_dir,
		out_dir: out_dir,
		copy_files: copy_files,
		package_management: package_management,
		go_config: go_config,
		packages: packages,
		local_packages: local_packages,
		error: error[0],
		error_line: error_line[0],
	)
end
