import { alias_matches_type } from alias_patterns
import { parse_namespace_reference } from namespace_references
import { advance, expect, expect_identifier, skip_newlines, token_is } from syntax_tokens
import { argument_binding_slot } from argument_binding
import { CheckedValue, checked_mir_value } from checked_values
import { mir_enum_operation } from enum_mir
import { EnumPattern } from enum_model
import { enum_argument_bindings, find_enum_variant } from enum_types
import { generic_instance_for_type } from type_resolution
import { enum_type } from enum_types
import { find_result_pattern, find_visible_alias, find_visible_enum } from declaration_lookup
import { nullable_replace } from nullable_flow
import { parse_argument_label } from syntax_forms
import { CheckedLocals, CompilerState, ControlSyntax, diagnostic, has_diagnostic, local_bind, local_require_use } from state
import { load_integer, load_string, sparse_integer_at, store_integer } from storage

# Check the complete closed family before choosing the exhaustive final edge.
def check_enum_patterns(mut state: CompilerState, control: ControlSyntax, owner: Integer): Boolean
	mut seen: Array<Integer> := []
	mut otherwise := false
	mut branch_index := 0
	while branch_index < control.branches.size() && !has_diagnostic(state)
		branch := control.branches[branch_index]
		branch_index += 1
		if branch.condition < 0
			otherwise = true
			next
		end
		mut position := [branch.condition]
		line := load_integer(state.source_tokens.token_lines, position[0])
		pattern_name := parse_namespace_reference(state, position)
		mut pattern_owner := find_visible_enum(state, state.module_graph.active_module[0], pattern_name)
		instance := generic_instance_for_type(state, enum_type(owner))
		if instance >= 0 && find_result_pattern(state, state.module_graph.active_module[0], pattern_name) == state.type_resolution.generic_instances[instance].definition
			pattern_owner = owner
		end
		alias_index := find_visible_alias(state, state.module_graph.active_module[0], pattern_name)
		if alias_index >= 0 && alias_matches_type(state, alias_index, enum_type(owner))
			pattern_owner = owner
		end
		if pattern_owner != owner || !expect(state, position, "::")
			diagnostic(state, "TRBN4004", line, "case pattern must belong to the selector enum")
			return false
		end
		variant := find_enum_variant(state, owner, expect_identifier(state, position))
		if variant < 0
			diagnostic(state, "TRBN4004", line, "unknown enum pattern variant")
			return false
		end
		mut previous := 0
		while previous < seen.size()
			if seen[previous] == variant
				diagnostic(state, "TRBN4004", line, "enum variant is handled more than once")
				return false
			end
			previous += 1
		end
		seen.push(variant)
		row := state.enum_variants[variant]
		mut bindings := enum_argument_bindings(state, variant)
		if row.field_count > 0
			if !expect(state, position, "(")
				return false
			end
			skip_newlines(state, position)
			while !token_is(state, position[0], ")") && !has_diagnostic(state)
				label := parse_argument_label(state, position)
				slot := argument_binding_slot(bindings, label)
				if slot < 0
					diagnostic(state, "TRBN4004", line, bindings.error[0])
					return false
				end
				binding := position[0]
				name := expect_identifier(state, position)
				previous = 0
				while previous < bindings.values.size()
					if bindings.values[previous] >= 0 && load_string(state.source_tokens.token_texts, bindings.values[previous]) == name
						diagnostic(state, "TRBN4004", line, "enum pattern binding is duplicated")
						return false
					end
					previous += 1
				end
				bindings.values[slot] = binding
				skip_newlines(state, position)
				if !token_is(state, position[0], ",")
					break
				end
				advance(position)
				skip_newlines(state, position)
			end
			if !expect(state, position, ")")
				return false
			end
		end
		if position[0] != branch.condition_finish
			diagnostic(state, "TRBN4004", line, "enum pattern requires exactly one qualified variant and its bindings")
			return false
		end
		previous = 0
		while previous < row.field_count
			if !bindings.provided[previous]
				diagnostic(state, "TRBN4004", line, "enum pattern must bind every payload field")
				return false
			end
			previous += 1
		end
		pattern := EnumPattern.new(origin: branch.condition, variant: variant, bindings: bindings.values)
		encoded := sparse_integer_at(state.checked[0].enum_pattern_origins, branch.condition)
		if encoded > 0
			state.checked[0].enum_patterns[encoded - 1] = pattern
		else
			state.checked[0].enum_patterns.push(pattern)
			store_integer(state.checked[0].enum_pattern_origins, branch.condition, state.checked[0].enum_patterns.size())
		end
	end
	if !otherwise && seen.size() != state.enums[owner].variant_count
		diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, control.origin), "enum case is not exhaustive")
	end
	return !has_diagnostic(state)
end

def check_enum_bindings(mut state: CompilerState, mut locals: CheckedLocals, selector: CheckedValue, origin: Integer)
	pattern := state.checked[0].enum_patterns[sparse_integer_at(state.checked[0].enum_pattern_origins, origin) - 1]
	row := state.enum_variants[pattern.variant]
	mut slot := 0
	while slot < pattern.bindings.size()
		binding := pattern.bindings[slot]
		type_name := state.enum_fields[row.field_start + slot].type_name
		value := mir_enum_operation(state, locals, 39, selector, - 1, row.field_start + slot, type_name, binding)
		index := local_bind(locals, load_string(state.source_tokens.token_texts, binding), type_name, 0)
		local_require_use(locals, index, load_string(state.source_tokens.token_texts, binding), binding, 3)
		store_integer(locals.mir_values, index, checked_mir_value(value) + 1)
		nullable_replace(locals, index, type_name)
		slot += 1
	end
end
