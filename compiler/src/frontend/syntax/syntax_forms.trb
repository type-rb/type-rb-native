import { loop_transfer_break, loop_transfer_continue, loop_transfer_none } from state/control_kinds
import { binary_add, binary_add_assign, binary_and, binary_and_assign, binary_divide, binary_divide_assign, binary_equal, binary_greater, binary_greater_equal, binary_invalid, binary_less, binary_less_equal, binary_multiply, binary_multiply_assign, binary_not_equal, binary_or, binary_or_assign, binary_power, binary_remainder, binary_subtract, binary_subtract_assign } from frontend/types/operators
import { token_kind_identifier, token_kind_newline, token_kind_symbol } from state/token_kinds
import { transform_kind } from frontend/types/transform_model
import { token_is } from frontend/syntax/syntax_tokens
import { CompilerState } from state/state
import { load_integer, load_string } from support/storage

def declaration_start(state: CompilerState, index: Integer): Boolean
	if token_is(state, index, "mut")
		return true
	end
	if load_integer(state.source_tokens.token_kinds, index) != token_kind_identifier()
		return false
	end
	if token_is(state, index + 1, ":=")
		return true
	end
	return token_is(state, index + 1, ":")
end

def syntax_block_end(state: CompilerState, index: Integer): Boolean
	kind := load_integer(state.source_tokens.token_kinds, index)
	if kind != token_kind_identifier()
		if kind != token_kind_symbol()
			return false
		end
	end
	word := load_string(state.source_tokens.token_texts, index)
	if word == "end"
		return true
	end
	return word == "}"
end

def syntax_conditional_tail(state: CompilerState, index: Integer): Boolean
	if token_is(state, index, "else")
		return true
	end
	if token_is(state, index, "elsif")
		return true
	end
	return token_is(state, index, "when")
end

def syntax_expression_precedence(operator: String): Integer
	if operator == "**"
		return 8
	end
	if operator == ".." || operator == "..."
		return 3
	end
	# Keep scalar spelling recognition in the shared operator catalog.
	identity := binary_operator_id(operator)
	if identity == binary_invalid()
		return 0
	end
	if identity <= binary_subtract()
		return 6
	end
	if identity <= binary_remainder()
		return 7
	end
	if identity <= binary_not_equal()
		return 4
	end
	if identity <= binary_greater_equal()
		return 5
	end
	if identity == binary_or()
		return 1
	end
	if identity == binary_and()
		return 2
	end
	return 0
end

def parse_argument_label(state: CompilerState, mut position: Array<Integer>): String
	if load_integer(state.source_tokens.token_kinds, position[0]) == token_kind_identifier() && token_is(state, position[0] + 1, ":")
		label := load_string(state.source_tokens.token_texts, position[0])
		position[0] += 2
		return label
	end
	return ""
end

def syntax_iteration_suffix(state: CompilerState, origin: Integer): Integer
	if (!token_is(state, origin, ".") && !token_is(state, origin, "&.")) || (!token_is(state, origin + 1, "each") && !token_is(state, origin + 1, "each_slice"))
		return -1
	end
	mut cursor := origin + 2
	if token_is(state, origin + 1, "each_slice") && token_is(state, cursor, "(")
		mut depth := 1
		cursor += 1
		while cursor < state.source_tokens.token_count[0] && depth > 0
			if token_is(state, cursor, "(")
				depth += 1
			elsif token_is(state, cursor, ")")
				depth -= 1
			end
			cursor += 1
		end
		if depth != 0
			return -1
		end
	elsif token_is(state, cursor, "(") && token_is(state, cursor + 1, ")")
		cursor += 2
	end
	if token_is(state, cursor, ".") && token_is(state, cursor + 1, "with_index")
		cursor += 2
		if token_is(state, cursor, "(") && token_is(state, cursor + 1, ")")
			cursor += 2
		end
	end
	if token_is(state, cursor, "do") || token_is(state, cursor, "{")
		return cursor
	end
	return -1
end

# A name such as map/select may also be an ordinary nominal method.
# Only an actual block suffix selects collection-transform syntax.
def syntax_transform_suffix(state: CompilerState, origin: Integer): Integer
	if (!token_is(state, origin, ".") && !token_is(state, origin, "&.")) || transform_kind(load_string(state.source_tokens.token_texts, origin + 1)) == 0
		return -1
	end
	mut cursor := origin + 2
	if token_is(state, cursor, "(")
		mut depth := 1
		cursor += 1
		while cursor < state.source_tokens.token_count[0] && depth > 0
			if token_is(state, cursor, "(")
				depth += 1
			elsif token_is(state, cursor, ")")
				depth -= 1
			end
			cursor += 1
		end
		if depth != 0
			return -1
		end
	end
	if token_is(state, cursor, ".") && token_is(state, cursor + 1, "with_index")
		cursor += 2
		if token_is(state, cursor, "(") && token_is(state, cursor + 1, ")")
			cursor += 2
		end
	end
	if token_is(state, cursor, "do") || token_is(state, cursor, "{")
		return cursor
	end
	return -1
end

def syntax_statement_boundary(state: CompilerState, origin: Integer): Boolean
	if load_integer(state.source_tokens.token_kinds, origin) == token_kind_newline()
		return true
	end
	return token_is(state, origin, "}")
end

def syntax_loop_transfer_kind(state: CompilerState, origin: Integer): Integer
	if token_is(state, origin, "break")
		return loop_transfer_break()
	end
	if token_is(state, origin, "next")
		return loop_transfer_continue()
	end
	return loop_transfer_none()
end

def binary_operator_id(operator: String): Integer
	if operator == "+"
		return binary_add()
	end
	if operator == "-"
		return binary_subtract()
	end
	if operator == "*"
		return binary_multiply()
	end
	if operator == "/"
		return binary_divide()
	end
	if operator == "%"
		return binary_remainder()
	end
	if operator == "=="
		return binary_equal()
	end
	if operator == "!="
		return binary_not_equal()
	end
	if operator == "<"
		return binary_less()
	end
	if operator == "<="
		return binary_less_equal()
	end
	if operator == ">"
		return binary_greater()
	end
	if operator == ">="
		return binary_greater_equal()
	end
	if operator == "||"
		return binary_or()
	end
	if operator == "&&"
		return binary_and()
	end
	if operator == "**"
		return binary_power()
	end
	# The high tag identifies supported compound assignments.
	if operator == "+="
		return binary_add_assign()
	end
	if operator == "-="
		return binary_subtract_assign()
	end
	if operator == "*="
		return binary_multiply_assign()
	end
	if operator == "/="
		return binary_divide_assign()
	end
	if operator == "||="
		return binary_or_assign()
	end
	if operator == "&&="
		return binary_and_assign()
	end
	return binary_invalid()
end
