# Receiver-specific method identities. Equal integers in different receiver
# families are unrelated; arity, checked lowering and REPL share these names.
# The none tag is a lookup miss, not an executable method. Ordered groups retain
# their established boundaries for range tests and MIR payload offsets.

def array_method_none(): Integer
	return 0
end

def array_method_empty(): Integer
	return 1
end

def array_method_first(): Integer
	return 2
end

