import { test_provider_kind } from frontend/providers/test_declarations
import { TypeAlias } from frontend/types/alias_model
import { parse_statement_block } from frontend/syntax/body_syntax
import { lex_module } from frontend/syntax/lexer
import { package_json_quote } from project/package_json
import { CompilerState, diagnostic, has_diagnostic } from state/state
import { integer_string } from support/literals
import { load_integer, load_string, store_integer, store_string } from support/storage

record TestCallOrigin
	path: String
	line: Integer
	column: Integer
end

def test_call_origin(state: CompilerState, origin: Integer): TestCallOrigin
	return TestCallOrigin.new(path: load_string(state.module_graph.module_files, state.module_graph.active_module[0]), line: load_integer(state.source_tokens.token_lines, origin), column: load_integer(state.source_tokens.token_columns, origin))
end

# Two same-type expect calls must never share the first call's source location.
# Internal assertions already receive an explicit origin and can share bodies.
def test_origin_specialization_key(state: CompilerState, definition: Integer, origin: Integer): String
	kind := test_provider_kind(state, definition)
	if kind >= 1 && kind <= 3
		return ":origin:" + integer_string(origin)
	end
	return ""
end

def test_origin_quote(value: String): String
	return package_json_quote(value).replace_all("#", "\\u0023")
end

def test_expectation_body(kind: Integer, origin: TestCallOrigin): String
	mut constructor := "Expectation<Target>"
	mut suffix := ""
	if kind == 2 || kind == 3
		constructor = "ResultExpectation<Target,Error>"
		suffix = ".ok()"
		if kind == 3
			suffix = ".err()"
		end
	end
	return "return " + constructor + ".new(actual, " + test_origin_quote(origin.path) + ", " + integer_string(origin.line) + ", " + integer_string(origin.column) + ")" + suffix + "\nend\n"
end

def specialize_test_expectation(mut state: CompilerState, function: Integer, arguments: Array<String>, kind: Integer, origin: TestCallOrigin): Boolean
	if state.type_resolution.generic_template_mode[0]
		return true
	end
	if kind < 1 || kind > 3 || origin.line < 1 || origin.column < 1 || arguments.size() < 1
		diagnostic(state, "TRBN4003", origin.line, "test expectation requires an authored call origin")
		return false
	end
	owner := load_integer(state.declarations.function_modules, function)
	namespace := "$test_origin" + integer_string(function)
	state.type_resolution.type_aliases.push(TypeAlias.new(name: namespace + "::Target", source_id: owner, line: origin.line, parameters: [], target: arguments[0]))
	if kind == 2 || kind == 3
		if arguments.size() != 2
			diagnostic(state, "TRBN4003", origin.line, "test Result expectation requires both variant types")
			return false
		end
		state.type_resolution.type_aliases.push(TypeAlias.new(name: namespace + "::Error", source_id: owner, line: origin.line, parameters: [], target: arguments[1]))
	end
	previous_module := state.module_graph.active_module[0]
	previous_owner := state.global_bindings.declaration_owner[0]
	start := state.source_tokens.token_count[0]
	lex_module(state, test_expectation_body(kind, origin), owner)
	state.global_bindings.declaration_owner[0] = namespace
	mut token := start
	while token < state.source_tokens.token_count[0]
		store_string(state.source_tokens.token_namespaces, token, namespace)
		token += 1
	end
	mut position := [start]
	if !has_diagnostic(state)
		parse_statement_block(state, position)
	end
	store_integer(state.declarations.function_body_starts, function, start)
	store_integer(state.declarations.function_body_ends, function, position[0])
	state.module_graph.active_module[0] = previous_module
	state.global_bindings.declaration_owner[0] = previous_owner
	return !has_diagnostic(state)
end
