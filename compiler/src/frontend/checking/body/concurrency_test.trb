	test("borrowed element selected by conditional") do
		state := rejected_concurrent_source("def transform(values: Array<Array<Integer>>): Array<Integer>\n\treturn values.concurrent_map do |items|\n\t\tmut selected := if true\n\t\t\titems\n\t\telse\n\t\t\t[0]\n\t\tend\n\t\tselected[0] = selected[0] + 1\n\t\tselected[0]\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
