		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("interface dispatch has no safety contract") do
		state := rejected_concurrent_source("interface Counter\n\tadd(): Integer\nend\n\ndef transform(values: Array<Counter>): Array<Integer>\n\treturn values.concurrent_map do |counter|\n\t\tcounter.add()\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("function value has no safety contract") do
		state := rejected_concurrent_source("alias Mapper = (Integer) -> Integer\n\ndef transform(values: Array<Mapper>): Array<Integer>\n\treturn values.concurrent_map do |callable|\n\t\tcallable(1)\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
