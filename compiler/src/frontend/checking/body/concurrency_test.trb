		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("borrowed branch assignment followed by fresh branch assignment") do
		state := rejected_concurrent_source("def transform(values: Array<Array<Integer>>): Array<Integer>\n\treturn values.concurrent_map do |items|\n\t\tmut selected := [0]\n\n\t\tif items[0] >= 0\n\t\t\tselected = items\n\t\telse\n\t\t\tselected = [0]\n\t\tend\n\n\t\tselected[0] = selected[0] + 1\n\t\tselected[0]\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("fresh reassignment does not clear borrowed binding") do
		state := rejected_concurrent_source("def transform(values: Array<Array<Integer>>): Array<Integer>\n\treturn values.concurrent_map do |items|\n\t\tmut selected := items\n\t\tselected = [0]\n\t\tselected[0] = selected[0] + 1\n\t\tselected[0]\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("nullable narrowing does not hide borrowed assignment") do
		state := rejected_concurrent_source("def transform(values: Array<Array<Integer>>): Array<Integer>\n\treturn values.concurrent_map do |items|\n\t\tmut selected: Array<Integer>? := [0]\n\t\tif selected != nil\n\t\t\tselected = items\n\t\tend\n\t\tif selected != nil\n\t\t\tselected[0] = selected[0] + 1\n\t\tend\n\t\t0\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("case assignment remains borrowed after fresh alternative") do
		state := rejected_concurrent_source("def transform(values: Array<Array<Integer>>): Array<Integer>\n\treturn values.concurrent_map do |items|\n\t\tmut selected := [0]\n\t\tcase items[0]\n\t\twhen 0\n\t\t\tselected = items\n\t\telse\n\t\t\tselected = [0]\n\t\tend\n\t\tselected[0] = selected[0] + 1\n\t\tselected[0]\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("loop assignment cannot clear preexisting borrow") do
		state := rejected_concurrent_source("def transform(values: Array<Array<Integer>>): Array<Integer>\n\treturn values.concurrent_map do |items|\n\t\tmut selected := items\n\t\twhile false\n\t\t\tselected = [0]\n\t\tend\n\t\tselected[0] = selected[0] + 1\n\t\tselected[0]\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("accepts owned locals, borrowed reads and nested serial groups") do
		mut state := logical_checked_source("def length(items: Array<Integer>): Integer\nreturn items.size()\nend\ndef local(value: Integer): Integer\nmut owned := [value]\nowned.push(value + 1)\nreturn owned[1]\nend\ndef main()\noffset := 2\nvalues := [[1], [2, 3]].concurrent_map(limit: 2) do |items|\nlength(items) + offset\nend\nnested := [1, 2].concurrent_map do |outer|\n[3, 4].concurrent_map(limit: 1) { |inner| local(inner + outer) }[0]\nend\nputs(values[0])\nputs(nested[1])\nend\n")
		expect_compiler_phase(state, "concurrent map", check(state))
	end
	test("parenthesized literal zero") do
		state := rejected_concurrent_source("def main()\nvalues := [1].concurrent_map(limit: ((0))) { |v| v }\nputs(values.size())\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end

	test("borrowed result through catch") do
		state := rejected_concurrent_source("import trb/std/result\ndef main()\nvalues := [[1]].concurrent_map do |items|\nwrapped := Result<Array<Integer>, String>::Ok(items)\nmut chosen := wrapped catch |_error|\n[0]\nend\nchosen[0] = 2\nchosen[0]\nend\nputs(values[0])\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end

	test("borrowed class union write") do
		state := rejected_concurrent_source("class A\n@value: Integer := 1\nend\nclass B\n@value: Integer := 2\nend\ndef transform(values: Array<A | B>): Array<Integer>\nreturn values.concurrent_map do |item|\nitem.value = 3\nitem.value\nend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end

	test("unary signed limits remain runtime contracts") do
		mut state := logical_checked_source("def main()\nvalues := [1].concurrent_map(limit: -1) { |v| v }\nputs(values.size())\nend\n")
		expect_compiler_phase(state, "signed concurrent limit", check(state))
	end

	test("owns mapping MIR independently of checked syntax and under forced collection") do
		managed_mir_test_fixture("concurrent-map-values", 1)
		managed_mir_test_fixture("concurrent-map-owned", 1)
	end

end
