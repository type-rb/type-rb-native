import { managed_mir_test_fixture } from testing/mir/managed
import { lex } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { resolve } from frontend/checking/program/resolution
import { CompilerState, compiler_new, has_diagnostic } from state/state
import { check } from compiler
import { expect_compiler_phase, logical_checked_source } from testing/pipeline
import { load_string } from support/storage
import { describe, expect, test } from trb/std/test

# Rejected syntax and rejected checked bodies are distinct successful controls.
def rejected_concurrent_source(source: String): CompilerState
	mut state := compiler_new(source.size() + 1)
	if lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state)
		check(state)
	end
	return state
end

describe("Structured concurrent map checking") do
	test("non array receiver") do
		state := rejected_concurrent_source("def transform(values: Range<Integer>): Array<Integer>\n\treturn values.concurrent_map do |value|\n\t\tvalue\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("non positive literal limit") do
		state := rejected_concurrent_source("def transform(values: Array<Integer>): Array<Integer>\n\treturn values.concurrent_map(limit: 0) do |value|\n\t\tvalue\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
		end
		expect(load_string(state.diagnostics.messages, 0).include?("concurrent_map")).to_be_true()
	end
	test("positional limit") do
		state := rejected_concurrent_source("def transform(values: Array<Integer>): Array<Integer>\n\treturn values.concurrent_map(2) do |value|\n\t\tvalue\n\tend\nend\ndef main()\nend\n")
		expect(has_diagnostic(state)).to_be_true()
		if !load_string(state.diagnostics.messages, 0).include?("concurrent_map")
			puts(load_string(state.diagnostics.messages, 0))
