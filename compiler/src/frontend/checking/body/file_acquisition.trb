import { analyze_file_body, lower_checked_file_body } from frontend/checking/body/file_bodies
import { check_expression } from frontend/checking/body/expressions
import { CheckedValue, checked_mir_value, checked_value, scalar_mir_literal } from frontend/checking/body/values
import { type_diagnostic } from frontend/checking/body/types
import { argument_binding_slot, argument_bindings } from frontend/resolution/argument_binding
import { find_function_in_module, find_generic_function_in_module } from frontend/resolution/declaration_lookup
import { instantiate_generic_function } from frontend/resolution/generic_functions
import { next_generic_depth } from frontend/types/generic_bindings
import { scoped_resource_name } from frontend/types/resource_types
import { checked_category_value } from frontend/types/value_categories
import { advance, expect, skip_newlines, token_is } from frontend/syntax/syntax_tokens
import { parse_argument_label } from frontend/syntax/syntax_forms
import { mir_checked_call } from mir/lowering/calls
import { checking_lowering } from state/checking_phases
import { CheckedLocals } from state/local_state
import { standard_source_filesystem_host } from state/standard_source_kinds
import { CompilerState, has_diagnostic } from state/state
import { load_integer, load_string, sparse_integer_at, store_integer } from support/storage

# Only the exact File declaration selects this operation. A parsed body never
# becomes a callable value, and no acquired resource reaches the caller's SSA.
def check_file_acquisition(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, resource_type: String, declared: String): CheckedValue
	origin := position[0]
	line := load_integer(state.source_tokens.token_lines, origin)
	if scoped_resource_name(state, resource_type) != "File"
		return type_diagnostic(state, line, "File.open requires the owned File declaration")
	end
	mut source := -1
	mut index := 0
	while index < state.module_graph.module_count[0]
		if sparse_integer_at(state.standard_modules, index) == standard_source_filesystem_host()
			source = index
		end
		index += 1
	end
	path_function := find_function_in_module(state, source, "path_value")
	mode_function := find_function_in_module(state, source, "mode_value")
	error_definition := find_generic_function_in_module(state, source, "failure")
	if path_function < 0 || mode_function < 0 || error_definition < 0
		return type_diagnostic(state, line, "File.open requires its owned filesystem provider")
	end
	path_type := load_string(state.declarations.parameter_types, load_integer(state.declarations.function_parameter_starts, path_function))
	mode_type := load_string(state.declarations.parameter_types, load_integer(state.declarations.function_parameter_starts, mode_function))
	mut bindings := argument_bindings(["path", "mode"], [false, true])
	mut path := checked_value("String", checked_category_value(), origin, 0)
	mut mode := scalar_mir_literal(state, locals, "Integer", origin, "0")
	advance(position)
	skip_newlines(state, position)
	while !token_is(state, position[0], ")") && !has_diagnostic(state)
		label := parse_argument_label(state, position)
		slot := argument_binding_slot(bindings, label)
		if slot < 0
			return type_diagnostic(state, line, bindings.error[0])
		end
		if slot == 0
			value := check_expression(state, position, locals, 1, path_type)
			path = mir_checked_call(state, locals, path_function, [checked_mir_value(value)], "String", origin)
		else
			value := check_expression(state, position, locals, 1, mode_type)
			mode = mir_checked_call(state, locals, mode_function, [checked_mir_value(value)], "Integer", origin)
		end
		skip_newlines(state, position)
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	if !expect(state, position, ")") || has_diagnostic(state)
		return checked_value("Invalid", checked_category_value(), origin, 0)
	end
	if !bindings.provided[0]
		return type_diagnostic(state, line, "File.open requires a Path argument")
	end
	encoded := sparse_integer_at(state.callables.call_block_origins, position[0])
	if encoded <= 0 || encoded > state.callables.call_blocks.size()
		return type_diagnostic(state, line, "File.open requires a structured block")
	end
	syntax := state.callables.call_blocks[encoded - 1]
	if locals.file_value[0] != syntax.call_start || locals.file_value[1] == 0
		return type_diagnostic(state, line, "File.open must be the direct value of a declaration, assignment, or return")
	end
	if locals.file_value[1] == 2 && (token_is(state, syntax.call_start, "try") || sparse_integer_at(state.parsed.catch_origins, syntax.call_start) > 0)
		return type_diagnostic(state, line, "try or catch over File.open requires a declaration or return")
	end
	position[0] = syntax.finish
	if state.callables.lambda_phase[0] == checking_lowering()
		error := sparse_integer_at(state.callables.checked[0].generic_calls, origin) - 1
		if error < 0
			return type_diagnostic(state, line, "File.open has no checked error constructor")
		end
		return lower_checked_file_body(state, locals, syntax.origin, error, path, mode)
	end
	body_index := analyze_file_body(state, locals, syntax, resource_type, declared)
	if body_index < 0 || has_diagnostic(state)
		return checked_value("Invalid", checked_category_value(), origin, 0)
	end
	body := state.callables.file_bodies[body_index]
	error := instantiate_generic_function(state, error_definition, [body.yield_type], next_generic_depth(state))
	if error < 0 || has_diagnostic(state)
		return checked_value("Invalid", checked_category_value(), origin, 0)
	end
	store_integer(state.callables.checked[0].generic_calls, origin, error + 1)
	return checked_value(body.result_type, checked_category_value(), origin, 0)
end
