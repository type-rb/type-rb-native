import { mir_checked_nullable, mir_literal_scalar, mir_nullable_coerce } from mir/lowering/nullable
import { mir_sliced_iteration_begin, mir_sliced_iteration_end } from frontend/checking/collections/sliced_iteration
import { mir_array_sort_keys } from frontend/checking/builtins/array_sorting
import { MirTransform } from frontend/types/transform_model
import { mir_binding_initialize, mir_binding_read } from mir/build/bindings
import { binding_scope_check } from frontend/checking/nominal/results
import { finish_statement, token_is } from frontend/syntax/syntax_tokens
import { nullable_apply, nullable_finish, nullable_loop_writes, nullable_nil_condition } from frontend/checking/nominal/nullable_flow
import { nullable_element, nullable_type } from frontend/types/nullable_types
import { mir_checked_iteration_begin, mir_checked_iteration_end, mir_transform_search_yield, mir_transform_yield } from mir/build/iteration
import { mir_checked_array_operation } from mir/lowering/arrays
import { check_expected, type_diagnostic } from frontend/checking/body/types
import { CheckedValue, checked_mir_value, checked_value, checked_view, scalar_mir_disable, scalar_mir_literal } from frontend/checking/body/values
import { hash_key_type, hash_value_type } from frontend/types/hash_types
import { checked_iteration_parameters, checked_iteration_require, checked_iteration_shape, checked_slice_zero_literal, checked_transform_require, checked_transform_shape, iteration_element_type } from frontend/checking/collections/iteration
import { MirIteration } from mir/model/iteration
import { mir_control_branch, mir_control_enter, mir_control_jump } from mir/build/control
import { array_element_type, array_type } from frontend/resolution/type_resolution
import { CompilerState, diagnostic, has_diagnostic } from state/state
import { CheckedLocals, local_bind, local_bind_temporary, local_require_use } from state/local_state
import { load_integer, load_string, sparse_integer_at, sparse_string_at, store_integer, store_string } from support/storage
import { check_expression } from frontend/checking/body/expressions
import { check_block, check_block_value } from frontend/checking/body/statements

def checked_iteration(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String, parent_loop: Integer): CheckedValue
	flow_parent := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	origin := position[0]
	encoded := sparse_integer_at(state.parsed.iteration_origins, origin)
	if encoded < 1 || encoded > state.parsed.iterations.size()
		return checked_value("Invalid", 0, origin, 0)
	end
	shape := state.parsed.iterations[encoded - 1]
	if !checked_iteration_shape(state, shape, origin)
		diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, origin), "invalid iteration syntax plan")
		return checked_value("Invalid", 0, origin, 0)
	end
	mut receiver := check_expression(state, position, locals, 1, "")
	saved_mir := locals.mir_state[0]
	mut optional := false
	if token_is(state, shape.receiver_finish, "&.") && nullable_element(receiver.type_name) != ""
		optional = true
	end
	mut absent := -1
	if optional
		condition := nullable_nil_condition(state, locals, receiver, true, shape.receiver_finish)
		absent = mir_control_branch(state, locals, condition, load_integer(state.source_tokens.token_lines, origin))
		nullable_apply(locals, condition.truth)
		present_type := nullable_element(receiver.type_name)
		payload := mir_checked_nullable(state, locals, 36, receiver, present_type, 0, shape.receiver_finish)
		receiver = checked_view(receiver, present_type, payload.category)
	end
	element_type := iteration_element_type(receiver.type_name)
	if element_type == "" || position[0] != shape.receiver_finish
		diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, origin), "ordinary each requires a supported Array, Range or Hash receiver")
		return checked_value("Invalid", 0, origin, 0)
	end
	mut source_kind := 1
	if receiver.type_name == "Range<Integer>"
		source_kind = 2
	end
	if hash_key_type(receiver.type_name) != ""
		source_kind = 3
	end
	plan := MirIteration.new(syntax: shape, parent_loop: parent_loop, source_kind: source_kind, type_name: receiver.type_name, element_type: element_type)
	if !checked_iteration_parameters(state, plan)
		diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, origin), "each block parameters differ from its receiver and with_index mode")
		return checked_value("Invalid", 0, origin, 0)
	end
	mut size := checked_value("Integer", 0, origin, 0)
	mut block_type := element_type
	if shape.slice_start >= 0
		position[0] = shape.slice_start
		size = check_expression(state, position, locals, 1, "Integer")
		if !check_expected(state, size.type_name, "Integer", load_integer(state.source_tokens.token_lines, shape.slice_start))
			return checked_value("Invalid", 0, origin, 0)
		end
		if position[0] != shape.slice_finish
			diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, origin), "invalid each_slice size boundary")
			return checked_value("Invalid", 0, origin, 0)
		end
		if checked_slice_zero_literal(state, size.origin)
			diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, shape.slice_start), "each_slice size must be greater than zero")
			return checked_value("Invalid", 0, origin, 0)
		end
		block_type = array_type(element_type)
	end
	state.callables.checked[0].iterations.push(plan)
	store_integer(state.callables.checked[0].iteration_origins, origin, state.callables.checked[0].iterations.size())
	checked_iteration_require(state, origin, parent_loop)
	# A size expression may leave its enclosing function or loop. Still check
	# the unreachable block, without constructing an iteration or Never operand.
	if size.type_name == "Never"
		scalar_mir_disable(locals)
	end
	saved := locals.count[0]
	mut element := checked_value(block_type, 0, plan.syntax.element_origin, 1)
	if shape.slice_start >= 0
		local_bind_temporary(locals, "$slice.receiver", receiver.type_name, 1)
		local_bind_temporary(locals, "$slice.cursor", "Integer", 1)
		local_bind_temporary(locals, "$slice.ordinal", "Integer", 1)
		local_bind_temporary(locals, "$slice.size", "Integer", 1)
		local_bind_temporary(locals, "$slice.finished", "Boolean", 1)
		element = mir_sliced_iteration_begin(state, locals, plan, receiver, size, saved)
	else
		# Hidden receiver/cursor bindings provide the loop-carried MIR values.
		local_bind(locals, "$iteration.receiver", receiver.type_name, 1)
		local_bind(locals, "$iteration.cursor", "Integer", 1)
		if source_kind == 2 && plan.syntax.second_origin >= 0
			local_bind(locals, "$iteration.ordinal", "Integer", 1)
		end
		if source_kind == 3
			local_bind(locals, "$iteration.keys", array_type(element_type), 1)
			local_bind(locals, "$iteration.values", array_type(hash_value_type(receiver.type_name)), 1)
		end
		element = mir_checked_iteration_begin(state, locals, plan, receiver, saved)
	end
	element_name := load_string(state.source_tokens.token_texts, plan.syntax.element_origin)
	local_bind(locals, element_name, block_type, 1)
	local_require_use(locals, locals.count[0] - 1, element_name, plan.syntax.element_origin, 2)
	mir_binding_initialize(state, locals, locals.count[0] - 1, element, plan.syntax.element_origin)
	if plan.syntax.second_origin >= 0
		if load_string(state.source_tokens.token_texts, plan.syntax.element_origin) == load_string(state.source_tokens.token_texts, plan.syntax.second_origin)
			diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, plan.syntax.second_origin), "iteration block parameter is duplicated")
			return checked_value("Invalid", 0, origin, 0)
		end
		mut second_type := "Integer"
		if source_kind == 3
			second_type = hash_value_type(receiver.type_name)
		end
		second_name := load_string(state.source_tokens.token_texts, plan.syntax.second_origin)
		local_bind(locals, second_name, second_type, 1)
		local_require_use(locals, locals.count[0] - 1, second_name, plan.syntax.second_origin, 2)
		mut index_slot := saved + 1
		if source_kind == 2 || shape.slice_start >= 0
			index_slot = saved + 2
		end
		mut second := mir_binding_read(state, locals, index_slot, plan.syntax.second_origin)
		if source_kind == 3
			values := mir_binding_read(state, locals, saved + 3, plan.syntax.second_origin)
			second = mir_checked_array_operation(state, locals, 22, checked_mir_value(values), checked_mir_value(second), 0, second_type, plan.syntax.second_origin)
		end
		mir_binding_initialize(state, locals, locals.count[0] - 1, second, plan.syntax.second_origin)
	end
	position[0] = plan.syntax.body_start
	nullable_loop_writes(state, locals, plan.syntax.body_start, plan.syntax.body_finish)
	check_block(state, position, locals, result_type, origin, saved)
	if position[0] != plan.syntax.body_finish
		diagnostic(state, "TRBN4004", load_integer(state.source_tokens.token_lines, origin), "invalid iteration body boundary")
	end
	binding_scope_check(state, locals, saved)
	if shape.slice_start >= 0
		mir_sliced_iteration_end(state, locals, plan, saved)
	else
		mir_checked_iteration_end(state, locals, plan, saved)
	end
	locals.count[0] = saved
	if size.type_name == "Never"
		locals.mir_state[0] = saved_mir
	end
	if absent >= 0
		mir_control_jump(state, locals, absent, saved)
		mir_control_enter(state, locals, absent, load_integer(state.source_tokens.token_lines, origin))
	end
	nullable_finish(locals, flow_parent, flow_first, saved)
	position[0] = plan.syntax.finish
	finish_statement(state, position)
	if size.type_name == "Never" && !optional
		return checked_value("Never", 0, origin, 0)
	end
	return checked_value("Void", 0, origin, 0)
end

def check_transform(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue): CheckedValue
	origin := position[0]
	line := load_integer(state.source_tokens.token_lines, origin)
	encoded := sparse_integer_at(state.parsed.transform_origins, origin)
	if encoded < 1 || encoded > state.parsed.transforms.size()
		return type_diagnostic(state, line, "missing collection transform syntax")
	end
	syntax := state.parsed.transforms[encoded - 1]
	shape := syntax.iteration
	if !checked_transform_shape(state, syntax, origin)
		return type_diagnostic(state, line, "invalid collection transform syntax")
	end
	element_type := iteration_element_type(receiver.type_name)
	if element_type == "" || hash_key_type(receiver.type_name) != ""
		return type_diagnostic(state, line, "collection transform requires a supported Array or Range receiver")
	end
	if syntax.kind >= 9 && array_element_type(receiver.type_name) == ""
		return type_diagnostic(state, line, "key-based sorting requires an Array receiver")
	end
	mut initial := checked_value("Void", 0, origin, 0)
	mut output := array_type(element_type)
	mut key_type := ""
	if syntax.kind >= 9
		key_type = sparse_string_at(state.callables.checked[0].transform_key_types, origin)
	end
	if syntax.kind == 1
		output = sparse_string_at(state.callables.checked[0].transform_types, origin)
	elsif syntax.kind == 7
		output = nullable_type(element_type)
	elsif syntax.kind == 8
		output = "Integer?"
	elsif syntax.kind >= 4 && syntax.kind <= 6
		output = "Boolean"
	elsif syntax.kind == 3
		position[0] = syntax.initial_start
		initial = check_expression(state, position, locals, 1, "")
		if position[0] != syntax.initial_finish || initial.type_name == "Void"
			return type_diagnostic(state, line, "reduce requires an initial value")
		end
		if initial.type_name == "Never"
			position[0] = shape.finish
			return initial
		end
		output = initial.type_name
	end
	mut source_kind := 1
	if receiver.type_name == "Range<Integer>"
		source_kind = 2
	end
	plan := MirIteration.new(syntax: shape, parent_loop: locals.lexical_loop[0], source_kind: source_kind, type_name: receiver.type_name, element_type: element_type)
	outer := locals.count[0]
	flow_parent := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	local_bind(locals, "$transform.result", output, 1)
	if syntax.kind == 7 || syntax.kind == 8
		initial = mir_checked_nullable(state, locals, 33, initial, output, 0, origin)
	elsif syntax.kind >= 4 && syntax.kind <= 6
		mut empty := "true"
		if syntax.kind == 4
			empty = "false"
		end
		initial = scalar_mir_literal(state, locals, "Boolean", origin, empty)
	elsif syntax.kind != 3
		initial = mir_checked_array_operation(state, locals, 19, -1, -1, 0, output, origin)
	end
	mir_binding_initialize(state, locals, outer, initial, origin)
	if syntax.kind >= 9
		local_bind(locals, "$transform.keys", array_type(key_type), 1)
		keys := mir_checked_array_operation(state, locals, 19, -1, -1, 0, array_type(key_type), origin)
		mir_binding_initialize(state, locals, outer + 1, keys, origin)
	end
	saved := locals.count[0]
	local_bind(locals, "$iteration.receiver", receiver.type_name, 1)
	local_bind(locals, "$iteration.cursor", "Integer", 1)
	if source_kind == 2 && shape.second_origin >= 0
		local_bind(locals, "$iteration.ordinal", "Integer", 1)
	end
	element := mir_checked_iteration_begin(state, locals, plan, receiver, saved)
	if syntax.kind == 3
		accumulator := mir_binding_read(state, locals, outer, syntax.accumulator_origin)
		accumulator_name := load_string(state.source_tokens.token_texts, syntax.accumulator_origin)
		local_bind(locals, accumulator_name, output, 1)
		local_require_use(locals, locals.count[0] - 1, accumulator_name, syntax.accumulator_origin, 2)
		mir_binding_initialize(state, locals, locals.count[0] - 1, accumulator, syntax.accumulator_origin)
		if load_string(state.source_tokens.token_texts, syntax.accumulator_origin) == load_string(state.source_tokens.token_texts, shape.element_origin)
			return type_diagnostic(state, line, "collection block parameter is duplicated")
		end
	end
	transform_name := load_string(state.source_tokens.token_texts, shape.element_origin)
	local_bind(locals, transform_name, element_type, 1)
	local_require_use(locals, locals.count[0] - 1, transform_name, shape.element_origin, 2)
	mir_binding_initialize(state, locals, locals.count[0] - 1, element, shape.element_origin)
	if shape.second_origin >= 0
		if load_string(state.source_tokens.token_texts, shape.second_origin) == load_string(state.source_tokens.token_texts, shape.element_origin)
			return type_diagnostic(state, line, "collection block parameter is duplicated")
		end
		mut index_slot := saved + 1
		if source_kind == 2
			index_slot = saved + 2
		end
		ordinal := mir_binding_read(state, locals, index_slot, shape.second_origin)
		ordinal_name := load_string(state.source_tokens.token_texts, shape.second_origin)
		local_bind(locals, ordinal_name, "Integer", 1)
		local_require_use(locals, locals.count[0] - 1, ordinal_name, shape.second_origin, 2)
		mir_binding_initialize(state, locals, locals.count[0] - 1, ordinal, shape.second_origin)
	end
	position[0] = shape.body_start
	nullable_loop_writes(state, locals, shape.body_start, shape.body_finish)
	previous_block := locals.value_block[0]
	locals.value_block[0] = true
	mut yielded := check_block_value(state, position, locals, "Void", -1, true, "", outer)
	locals.value_block[0] = previous_block
	if has_diagnostic(state)
		return yielded
	end
	if position[0] != shape.body_finish || yielded.type_name == "Void" || yielded.type_name == "Never"
		return type_diagnostic(state, line, "collection block must end with a result expression")
	end
	if syntax.kind == 1
		output = array_type(yielded.type_name)
		analyzed := sparse_string_at(state.callables.checked[0].transform_types, origin)
		if state.callables.lambda_phase[0] == 2 && analyzed != output
			return type_diagnostic(state, line, "collection result differs from analyzed type")
		end
		store_string(locals.types, outer, output)
	elsif syntax.kind >= 9
		yielded = mir_literal_scalar(state, locals, yielded, origin)
		key_type = yielded.type_name
		if key_type != "Integer" && key_type != "Float" && key_type != "String"
			return type_diagnostic(state, line, "sorting key requires portable natural order")
		end
		analyzed_key := sparse_string_at(state.callables.checked[0].transform_key_types, origin)
		if state.callables.lambda_phase[0] == 2 && analyzed_key != key_type
			return type_diagnostic(state, line, "sorting key differs from analyzed type")
		end
		store_string(locals.types, outer + 1, array_type(key_type))
		store_string(state.callables.checked[0].transform_key_types, origin, key_type)
	elsif syntax.kind == 2 || syntax.kind >= 4
		check_expected(state, yielded.type_name, "Boolean", line)
	else
		check_expected(state, yielded.type_name, output, line)
		yielded = mir_nullable_coerce(state, locals, yielded, output, origin)
	end
	store_string(state.callables.checked[0].transform_types, origin, output)
	transformation := MirTransform.new(syntax: syntax, iteration: plan, type_name: output, key_type: key_type)
	state.callables.checked[0].transforms.push(transformation)
	store_integer(state.callables.checked[0].transform_origins, origin, state.callables.checked[0].transforms.size())
	checked_transform_require(state, origin)
	binding_scope_check(state, locals, saved)
	if syntax.kind >= 9
		values := mir_binding_read(state, locals, outer, origin)
		mir_checked_array_operation(state, locals, 24, checked_mir_value(values), checked_mir_value(element), 0, "Void", origin)
		keys := mir_binding_read(state, locals, outer + 1, origin)
		mir_checked_array_operation(state, locals, 24, checked_mir_value(keys), checked_mir_value(yielded), 0, "Void", origin)
	elsif syntax.kind >= 7
		mir_transform_search_yield(state, locals, transformation, outer, element, yielded)
	else
		mir_transform_yield(state, locals, syntax.kind, outer, element, yielded, origin)
	end
	mir_checked_iteration_end(state, locals, plan, saved)
	mut result := mir_binding_read(state, locals, outer, origin)
	if syntax.kind >= 9
		keys := mir_binding_read(state, locals, outer + 1, origin)
		result = mir_array_sort_keys(state, locals, result, keys, syntax.kind == 10, origin)
	end
	locals.count[0] = outer
	nullable_finish(locals, flow_parent, flow_first, outer)
	position[0] = shape.finish
	# A transform result is an expression, not an assignable source binding.
	return checked_value(output, result.category, origin, 1)
end

# Preserve source order and lexical transfers before lowering a receiver method.
