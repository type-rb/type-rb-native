import { standard_source_oidc } from state/standard_source_kinds
import { store_integer } from support/storage
import { check } from compiler
import { lex } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { resolve } from frontend/checking/program/resolution
import { compiler_new } from state/state
import { load_string } from support/storage
import { expect_compiler_phase } from testing/pipeline
import { describe, expect, test } from trb/std/test

describe("Scoped resource synchronous calls") do
	test("rejects owned OIDC edges before MIR including unused generic borrows") do
		["", "<T>"].each do |generic|
			mut state := compiler_new(1048576)
			source := "import trb/std/file\nimport trb/internal/auth/oidc_host as Host\ndef borrow" + generic + "(_file: File): String\nreturn Host.environment(\"RESOURCE_TEST_UNUSED\")\nend\ndef main()\nreturn\nend\n"
			expect_compiler_phase(state, "lex", lex(state, source))
			expect_compiler_phase(state, "parse", parse_module(state, 0, 0))
			# A synthetic trusted provider tests the foreign edge. Authored
			# imports cannot acquire this owner in the ordinary module loader.
			store_integer(state.standard_modules, 0, standard_source_oidc())
			expect_compiler_phase(state, "resolve", resolve(state))
			expect(check(state)).to_be_false()
			expect(load_string(state.diagnostics.messages, 0).include?("scoped resource borrow")).to_be_true()
		end
	end

	test("rejects indirect calls reached from an ordinary or unused generic borrow") do
		[
			"def borrow(_file: File, callback: () -> String): String\nreturn callback()\nend\n",
			"def middle(callback: () -> String): String\nreturn callback()\nend\ndef borrow(_file: File, callback: () -> String): String\nreturn middle(callback)\nend\n",
			"def middle(callback: () -> String): String\nreturn callback()\nend\ndef borrow<T>(_file: File, callback: () -> String): String\nreturn middle(callback)\nend\n",
			"def middle<T>(callback: () -> String): String\nreturn callback()\nend\ndef borrow(_file: File, callback: () -> String): String\nreturn middle<Integer>(callback)\nend\n",
			"def middle(callback: () -> String, value: String = callback()): String\nreturn value\nend\ndef borrow(_file: File, callback: () -> String): String\nreturn middle(callback)\nend\n",
			"class Reader\ndef initialize(callback: () -> String)\nputs(callback())\nend\nend\ndef borrow(_file: File, callback: () -> String)\n_reader := Reader.new(callback)\nend\n",
			"class Reader\ndef read(callback: () -> String): String\nreturn callback()\nend\nend\ndef borrow(_file: File, callback: () -> String): String\nreturn Reader.new().read(callback)\nend\n",
		].each do |declarations|
			mut state := compiler_new(1048576)
			source := "import trb/std/file\n" + declarations + "def main()\nreturn\nend\n"
			expect_compiler_phase(state, "lex", lex(state, source))
			expect_compiler_phase(state, "parse", parse_module(state, 0, 0))
			expect_compiler_phase(state, "resolve", resolve(state))
			expect(check(state)).to_be_false()
			expect(load_string(state.diagnostics.messages, 0).include?("scoped resource borrow")).to_be_true()
		end
	end

	test("accepts recursive source borrows and leaves unrelated callbacks usable") do
		[
			"def helper(value: Integer): Integer\nif value > 0\nreturn helper(value - 1)\nend\nreturn 0\nend\ndef borrow(_file: File): Integer\nreturn helper(2)\nend\n",
			"def helper(value: Integer): Integer\nreturn value + 1\nend\ndef borrow<T>(_file: File): Integer\nreturn helper(2)\nend\n",
			"def unrelated(callback: () -> String): String\nreturn callback()\nend\ndef borrow(_file: File): String\nreturn \"ok\"\nend\n",
		].each do |declarations|
			mut state := compiler_new(1048576)
			source := "import trb/std/file\n" + declarations + "def main()\nreturn\nend\n"
			expect_compiler_phase(state, "lex", lex(state, source))
			expect_compiler_phase(state, "parse", parse_module(state, 0, 0))
			expect_compiler_phase(state, "resolve", resolve(state))
			expect_compiler_phase(state, "check", check(state))
		end
	end
end
