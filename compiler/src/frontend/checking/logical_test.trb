import { native_read_text } from project/native_file_system
import { check, emit_qbe } from compiler
import { lex } from frontend/syntax/lexer
import { mir_function_index, mir_logical_plan, mir_logical_short_value } from mir/mir
import { control_test_output } from testing/mir/control
import { verify_mir } from mir/mir_verifier
import { parse_module } from frontend/syntax/parser
import { syntax_expression_precedence } from frontend/syntax/syntax_forms
import { resolve } from frontend/checking/resolution
import { compiler_new } from state/state
import { load_integer, load_string, store_string } from support/storage
import { describe, expect, test } from trb/std/test
import { logical_checked_source } from testing/pipeline
import { logical_run_qbe } from testing/qbe_runner
import trb/std/process
import trb/std/result

# Use a fresh workspace so concurrent correctness runs cannot share artifacts.

describe("Short-circuit Boolean expressions") do
	test("recognizes logical and block pipes but rejects bitwise expressions") do
		mut valid := compiler_new(64)
		expect(lex(valid, "true||false&&true")).to_be_true()
		expect(load_string(valid.source_tokens.token_texts, 1)).to_equal("||")
		expect(load_string(valid.source_tokens.token_texts, 3)).to_equal("&&")
		invalid := ["true|false", "true&false", "true|||false", "true&&&false"]
		mut index := 0
		while index < invalid.size()
			mut state := compiler_new(64)
			if lex(state, "def main()\nputs(" + invalid[index] + ")\nend\n")
				expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_false()
			end
			index += 1
		end
	end

	test("orders logical operators below comparisons and arithmetic") do
		expect(syntax_expression_precedence("||")).to_equal(1)
		expect(syntax_expression_precedence("&&")).to_equal(2)
		expect(syntax_expression_precedence("==")).to_equal(4)
		expect(syntax_expression_precedence("<")).to_equal(5)
		expect(syntax_expression_precedence("+")).to_equal(6)
		expect(syntax_expression_precedence("*")).to_equal(7)
		expect(syntax_expression_precedence("|")).to_equal(0)
	end

	test("constructs only Boolean logical plans and rejects all other tags") do
		types := ["Boolean", "Boolean?", "Integer", "Float", "String", "Void", "Invalid"]
		mut operator_id := 0
		while operator_id <= 20
			mut left := 0
			while left < types.size()
				mut right := 0
				while right < types.size()
					mut expected := 0
					if left == 0
						if right == 0
							if operator_id == 12
								expected = 76
							end
							if operator_id == 13
								expected = 77
							end
						end
					end
					expect(mir_logical_plan(operator_id, types[left], types[right])).to_equal(expected)
					right += 1
				end
				left += 1
			end
			operator_id += 1
		end
		mut plan := -1
		while plan < 100
			mut expected := -1
			if plan == 76
				expected = 1
			end
			if plan == 77
				expected = 0
			end
			expect(mir_logical_short_value(plan)).to_equal(expected)
			plan += 1
		end
	end

	test("checks both operands even when the left literal skips the right at runtime") do
		expressions := ["true || 1", "false && 0", "1 || true", "0 && false", "true || 1.0", "false && \"text\"", "false && (1 + true)"]
		mut index := 0
		while index < expressions.size()
			source := "def main()\n\tputs(" + expressions[index] + ")\n\treturn\nend\n"
			mut state := logical_checked_source(source)
			expect(check(state)).to_be_false()
			expect(state.diagnostics.count[0] > 0).to_be_true()
			index += 1
		end
	end

	test("still resolves a name on a skipped right-hand side") do
		source := "def main()\n\tputs(true || missing)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_false()
		expect(state.diagnostics.count[0] > 0).to_be_true()
	end

	test("rejects non-Boolean or immutable logical assignment targets") do
		cases := ["mut value := 1\nvalue ||= true", "mut value := true\nvalue &&= 1", "value := false\nvalue ||= true"]
		cases.each do |body|
			source := "def main()\n" + body + "\nend\n"
			mut state := logical_checked_source(source)
			expect(check(state)).to_be_false()
			expect(state.diagnostics.count[0] > 0).to_be_true()
		end
	end

	test("publishes conditional RHS blocks and emits after source bodies are erased") do
		source := "def choose(a: Boolean, b: Boolean, c: Boolean): Boolean\n\treturn !a && (b || c)\nend\ndef main()\n\tputs(choose(false, false, true))\n\treturn\nend\n"
		mut state := logical_checked_source(source)
		expect(check(state)).to_be_true()
		index := mir_function_index(state.scalar_mir, 0)
		expect(index >= 0).to_be_true()
		expect(state.scalar_mir.functions[index].kind).to_equal(3)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		before := control_test_output(emit_qbe(state))
		mut token := load_integer(state.declarations.function_body_starts, 0)
		while token < load_integer(state.declarations.function_body_ends, 0)
			store_string(state.source_tokens.token_texts, token, "unavailable")
			token += 1
		end
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		expect(state.diagnostics.count[0]).to_equal(0)
	end

	test("keeps logical assignment effects conditional in verified MIR") do
		source := "def bump(mut calls: Array<Integer>): Boolean\ncalls[0] += 1\nreturn true\nend\ndef index(mut calls: Array<Integer>): Integer\ncalls[0] += 1\nreturn 0\nend\ndef main()\nmut calls := [0]\nmut yes := true\nmut no := false\nyes ||= bump(calls)\nno &&= bump(calls)\nputs(calls[0])\nno ||= bump(calls)\nyes &&= bump(calls)\nputs(calls[0])\nmut flags := [true]\nflags[index(calls)] ||= bump(calls)\nputs(calls[0])\nflags[index(calls)] &&= bump(calls)\nputs(calls[0])\nend\n"
		mut state := logical_checked_source(source)
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		before := control_test_output(emit_qbe(state))
		mut function_id := 0
		while function_id < state.declarations.function_count[0]
			mut token := load_integer(state.declarations.function_body_starts, function_id)
			while token < load_integer(state.declarations.function_body_ends, function_id)
				store_string(state.source_tokens.token_texts, token, "unavailable")
				token += 1
			end
			function_id += 1
		end
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, before)
			when Result::Ok(output)
				expect(output).to_equal("0\n2\n3\n5\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("executes nested logical calls and loops with reversed MIR block storage") do
		root := Process.environment("TYPE_RB_NATIVE_ROOT")
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if root != nil
			if qbe != nil
				fixture := root + "/compiler/conformance/valid/scalar-short-circuit"
				source := case native_read_text(fixture + ".trb")
				when Result::Ok(text)
					text
				when Result::Err(error)
					puts(error.message)
					""
				end
				mut state := logical_checked_source(source)
				expect(check(state)).to_be_true()
				state.scalar_mir.functions.each do |function|
					if function.kind == 3
						mut left := function.block_start
						mut right := left + function.block_count - 1
						while left < right
							saved := state.scalar_mir.blocks[left]
							state.scalar_mir.blocks[left] = state.scalar_mir.blocks[right]
							state.scalar_mir.blocks[right] = saved
							left += 1
							right -= 1
						end
						mut token := load_integer(state.declarations.function_body_starts, function.id)
						while token < load_integer(state.declarations.function_body_ends, function.id)
							store_string(state.source_tokens.token_texts, token, "unavailable")
							token += 1
						end
					end
				end
				expect(verify_mir(state.scalar_mir, true)).to_equal("")
				expected := case native_read_text(fixture + ".out")
				when Result::Ok(text)
					text
				when Result::Err(error)
					puts(error.message)
					""
				end
				case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
				when Result::Ok(output)
					expect(output).to_equal(expected)
				when Result::Err(error)
					puts(error)
					expect(false).to_be_true()
				end
			end
		end
	end

end
