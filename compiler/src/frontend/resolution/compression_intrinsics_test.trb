import { standard_compression } from frontend/resolution/compression_intrinsics
import { official_source_kind } from project/official_catalog
import { expect_compiler_phase, logical_checked_source } from testing/pipeline
import { check, emit_qbe } from compiler
import { CompilerState, compiler_new } from state/state
import { load_integer, store_integer, store_string } from support/storage
import { lex } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { resolve } from frontend/checking/program/resolution
import { MirCall, MirSignature } from mir/model/module
import { mir_adapter_gzip, mir_signature_standard } from mir/model/call_kinds
import { verify_mir } from mir/verify/module
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { control_test_output } from testing/mir/control
import { describe, expect, test } from trb/std/test

def compression_test_state(): CompilerState
	source := "import trb/internal/web/compression as Compressor\ndef main()\nvalue := (6).to_s().to_bytes()\nresult := Compressor.gzip(value)\nputs(result.size())\nputs(value.to_s())\nend\n"
	mut state := compiler_new(1048576)
	expect_compiler_phase(state, "lex", lex(state, source))
	store_integer(state.standard_modules, 0, official_source_kind("trb/web/middleware/compression"))
	expect_compiler_phase(state, "parse", parse_module(state, 0, 0))
	expect_compiler_phase(state, "resolve", resolve(state))
	expect_compiler_phase(state, "check", check(state))
	return state
end

describe("owned gzip compression boundary") do
	test("retains semantic Bytes and conservative effects after source erasure") do
		mut state := compression_test_state()
		mut found := 0
		state.scalar_mir.calls.each do |call|
			row := state.scalar_mir.signatures[call.callee]
			if standard_compression(state, row.id)
				found += 1
				expect(row.kind).to_equal(mir_signature_standard())
				expect(row.adapter).to_equal(mir_adapter_gzip())
				expect(row.parameter_types).to_equal(["Bytes"])
				expect(row.result_type).to_equal("Bytes")
				expect(call.effects).to_equal(15)
			end
		end
		expect(found).to_equal(1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		intrinsic_mir_erase(state)
		output := control_test_output(emit_qbe(state))
		expect(output.include?("call $libdeflate_gzip_compress(")).to_be_true()
		expect(output.include?("call $libdeflate_free_compressor(")).to_be_true()
	end

	test("does not authorize an authored gzip declaration") do
		mut state := logical_checked_source("def gzip(value: Bytes): Bytes\nreturn value\nend\ndef main()\nputs(gzip(\"ordinary\".to_bytes()).size())\nend\n")
		expect(check(state)).to_be_true()
		state.scalar_mir.signatures.each do |row|
			expect(standard_compression(state, row.id)).to_be_false()
		end
		expect(control_test_output(emit_qbe(state)).include?("libdeflate")).to_be_false()
	end

	test("rejects incomplete or forged loader declarations") do
		["owner", "name", "count", "parameter", "parameter_name", "mutable", "named", "default", "body", "result"].each do |damage|
			mut state := compression_test_state()
			state.scalar_mir.signatures.each do |row|
				if standard_compression(state, row.id)
					parameter := load_integer(state.declarations.function_parameter_starts, row.id)
					if damage == "owner"
						store_integer(state.standard_modules, row.source_id, 0)
					elsif damage == "name"
						store_string(state.declarations.function_names, row.id, "authored_gzip")
					elsif damage == "count"
						store_integer(state.declarations.function_parameter_counts, row.id, 0)
					elsif damage == "parameter"
						store_string(state.declarations.parameter_types, parameter, "String")
					elsif damage == "parameter_name"
						store_string(state.declarations.parameter_names, parameter, "other")
					elsif damage == "mutable"
						store_integer(state.declarations.parameter_mutable, parameter, 1)
					elsif damage == "named"
						store_integer(state.declarations.parameter_named_only, parameter, 1)
					elsif damage == "default"
						store_integer(state.parsed.parameter_defaults, parameter, 1)
					elsif damage == "body"
						store_integer(state.declarations.function_body_ends, row.id, 99999)
					else
						store_string(state.declarations.function_result_types, row.id, "String")
					end
					expect(standard_compression(state, row.id)).to_be_false()
				end
			end
		end
	end

	test("independently rejects changed MIR signatures and removed effects") do
		["name", "parameter", "mutable", "result", "effects"].each do |damage|
			mut state := compression_test_state()
			state.scalar_mir.signatures.each.with_index do |row, index|
				if row.kind == mir_signature_standard() && row.adapter == mir_adapter_gzip() && damage != "effects"
					mut name := row.name
					mut parameters := row.parameter_types
					mut mutable := row.parameter_mutable
					mut result := row.result_type
					if damage == "name"
						name = "authored.gzip"
					elsif damage == "parameter"
						parameters = ["String"]
					elsif damage == "mutable"
						mutable = [1]
					else
						result = "String"
					end
					state.scalar_mir.signatures[index] = MirSignature.new(id: row.id, kind: row.kind, name: name, adapter: row.adapter, source_id: row.source_id, line: row.line, parameter_types: parameters, parameter_mutable: mutable, result_type: result)
				end
			end
			if damage == "effects"
				state.scalar_mir.calls.each.with_index do |row, index|
					if state.scalar_mir.signatures[row.callee].adapter == mir_adapter_gzip()
						state.scalar_mir.calls[index] = MirCall.new(callee: row.callee, argument_start: row.argument_start, argument_count: row.argument_count, effects: 0)
					end
				end
			end
			expect(verify_mir(state.scalar_mir, true) != "").to_be_true()
		end
	end
end
