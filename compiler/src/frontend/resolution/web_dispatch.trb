import { find_record_type } from frontend/resolution/type_resolution
import { official_source_kind } from project/official_catalog
import { find_object_type } from frontend/types/object_types
import { CompilerState } from state/state
import { load_integer, load_string, sparse_integer_at } from support/storage

def web_dispatch_nominal(state: CompilerState, type_name: String, name: String): Boolean
	owner := find_object_type(state, type_name)
	if owner < 0
		return false
	end
	row := state.nominal.objects[state.nominal.object_instances[owner].definition]
	if sparse_integer_at(state.standard_modules, row.source_id) != official_source_kind("trb/web") || row.name != name || row.parameters.size() != 0
		return false
	end
	return true
end

# This selects only the reference's explicit REPL-unavailable provider entry.
# Compiled execution uses its ordinary checked body, with no special MIR call.
def web_dispatch_function(state: CompilerState, function: Integer): Boolean
	if function < 0 || function >= state.declarations.function_count[0]
		return false
	end
	owner := load_integer(state.declarations.function_modules, function)
	if sparse_integer_at(state.standard_modules, owner) != official_source_kind("trb/web/testing") || load_string(state.declarations.function_names, function) != "dispatch" || load_integer(state.declarations.function_parameter_counts, function) != 1
		return false
	end
	parameter := load_integer(state.declarations.function_parameter_starts, function)
	if load_integer(state.declarations.parameter_named_only, parameter) != 0 || load_integer(state.declarations.parameter_mutable, parameter) != 0 || sparse_integer_at(state.parsed.parameter_defaults, parameter) != 0 || load_string(state.declarations.parameter_names, parameter) != "request"
		return false
	end
	if !web_dispatch_nominal(state, load_string(state.declarations.parameter_types, parameter), "Request") || !web_dispatch_nominal(state, load_string(state.declarations.function_result_types, function), "Response")
		return false
	end
	return true
end

# The reference type-checks Web.serve but has no REPL runtime adapter.
def web_serve_function(state: CompilerState, function: Integer): Boolean
	if function < 0 || function >= state.declarations.function_count[0]
		return false
	end
	owner := load_integer(state.declarations.function_modules, function)
	if sparse_integer_at(state.standard_modules, owner) != official_source_kind("trb/web") || load_string(state.declarations.function_names, function) != "Web::serve" || load_integer(state.declarations.function_parameter_counts, function) != 1 || load_string(state.declarations.function_result_types, function) != "Void"
		return false
	end
	parameter := load_integer(state.declarations.function_parameter_starts, function)
	if load_string(state.declarations.parameter_names, parameter) != "config" || load_integer(state.declarations.parameter_mutable, parameter) != 0 || load_integer(state.declarations.parameter_named_only, parameter) != 0
		return false
	end
	record_index := find_record_type(state, load_string(state.declarations.parameter_types, parameter))
	if record_index < 0
		return false
	end
	if load_integer(state.declarations.record_modules, record_index) != owner || load_string(state.declarations.record_names, record_index) != "Web::ServerConfig"
		return false
	end
	return true
end
