import { standard_source_compression } from state/standard_source_kinds
import { CompilerState } from state/state
import { load_integer, load_string, sparse_integer_at } from support/storage

# Only the complete loader-owned declaration may call the gzip boundary.
def standard_compression(state: CompilerState, function: Integer): Boolean
	if function < 0 || function >= state.declarations.function_count[0]
		return false
	end
	owner := load_integer(state.declarations.function_modules, function)
	if sparse_integer_at(state.standard_modules, owner) != standard_source_compression()
		return false
	end
	if load_string(state.declarations.function_names, function) != "gzip" || load_integer(state.declarations.function_parameter_counts, function) != 1 || load_string(state.declarations.function_result_types, function) != "Bytes"
		return false
	end
	if load_integer(state.declarations.function_body_starts, function) != load_integer(state.declarations.function_body_ends, function) || sparse_integer_at(state.parsed.function_expression_bodies, function) != 0
		return false
	end
	parameter := load_integer(state.declarations.function_parameter_starts, function)
	if load_string(state.declarations.parameter_names, parameter) != "value" || load_string(state.declarations.parameter_types, parameter) != "Bytes" || load_integer(state.declarations.parameter_mutable, parameter) != 0 || load_integer(state.declarations.parameter_named_only, parameter) != 0 || sparse_integer_at(state.parsed.parameter_defaults, parameter) != 0
		return false
	end
	return true
end
