import { standard_source_time_host } from state/standard_source_kinds
import { CompilerState } from state/state
import { load_integer, load_string, sparse_integer_at } from support/storage

# Loader identity, complete signature and an empty declaration body are all
# required. Authored names and paths cannot grant host clock or file access.
def standard_time_host(state: CompilerState, function: Integer): Integer
	if function < 0 || function >= state.declarations.function_count[0]
		return 0
	end
	owner := load_integer(state.declarations.function_modules, function)
	if sparse_integer_at(state.standard_modules, owner) != standard_source_time_host()
		return 0
	end
	name := load_string(state.declarations.function_names, function)
	mut kind := 0
	mut parameter_name := ""
	mut parameter_type := ""
	mut result := ""
	mut mutable := 0
	if name == "clock"
		kind = 1
		parameter_name = "parts"
		parameter_type = "Array<Integer>"
		result = "Boolean"
		mutable = 1
	elsif name == "zone_data"
		kind = 2
		parameter_name = "path"
		parameter_type = "String"
		result = "String"
	else
		return 0
	end
	if load_integer(state.declarations.function_parameter_counts, function) != 1 || load_string(state.declarations.function_result_types, function) != result || load_integer(state.declarations.function_body_starts, function) != load_integer(state.declarations.function_body_ends, function)
		return 0
	end
	if sparse_integer_at(state.parsed.function_expression_bodies, function) != 0
		return 0
	end
	parameter := load_integer(state.declarations.function_parameter_starts, function)
	if load_string(state.declarations.parameter_names, parameter) != parameter_name || load_string(state.declarations.parameter_types, parameter) != parameter_type || load_integer(state.declarations.parameter_mutable, parameter) != mutable || load_integer(state.declarations.parameter_named_only, parameter) != 0 || sparse_integer_at(state.parsed.parameter_defaults, parameter) > 0
		return 0
	end
	return kind
end
