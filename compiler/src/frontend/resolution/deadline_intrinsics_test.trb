import { standard_runtime_deadline } from frontend/resolution/standard_intrinsics
import { check, emit_qbe } from compiler
import { lex } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { resolve } from frontend/checking/program/resolution
import { CompilerState, compiler_new } from state/state
import { standard_source_web_timeout } from state/standard_source_kinds
import { store_integer } from support/storage
import { MirModule } from mir/model/module
import { mir_op_deadline_checkpoint } from mir/model/instructions
import { mir_deadline_checkpoints_error } from mir/verify/deadlines
import { verify_mir } from mir/verify/module
import { mir_test_block_with_cell } from testing/mir/model
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { control_test_output } from testing/mir/control
import { callable_forced_collection } from testing/mir/callables
import { expect_compiler_phase, logical_checked_source } from testing/pipeline
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

# Exercise the exact loader-owned generic declaration without importing the
# full Web package. Public timeout applications are a separate CLI authority.
def deadline_intrinsic_test_state(): CompilerState
	source := "import trb/internal/runtime\ndef main()\nslow := fn(): Integer\nmut index := 0\nwhile index < 1000000000\nindex += 1\nend\nreturn index\nend\nputs(Runtime.deadline<Integer>(slow, 10, 7))\nfast := fn(): Float\nreturn 2.5\nend\nputs(Runtime.deadline<Float>(fast, 1000, 9.5))\nputs(Runtime.deadline<Float>(fast, 0, 9.5))\nputs(123)\nend\n"
	mut state := compiler_new(1048576)
	expect_compiler_phase(state, "lex", lex(state, source))
	store_integer(state.standard_modules, state.module_graph.entry_module[0], standard_source_web_timeout())
	expect_compiler_phase(state, "parse", parse_module(state, 0, state.module_graph.entry_module[0]))
	expect_compiler_phase(state, "resolve", resolve(state))
	expect_compiler_phase(state, "check", check(state))
	return state
end

def deadline_test_remove_checkpoint(mut native_module: MirModule, entry: Boolean)
	mut block_index := 0
	while block_index < native_module.blocks.size()
		block := native_module.blocks[block_index]
		mut position := block.instruction_start
		while position < block.instruction_start + block.instruction_count
			if native_module.instructions[position].kind == mir_op_deadline_checkpoint() && ((position == block.instruction_start) == entry)
				start := native_module.instructions.size()
				mut copied := block.instruction_start
				while copied < block.instruction_start + block.instruction_count
					if copied != position
						native_module.instructions.push(native_module.instructions[copied])
					end
					copied += 1
				end
				changed := mir_test_block_with_cell(block, 5, start)
				native_module.blocks[block_index] = mir_test_block_with_cell(changed, 6, block.instruction_count - 1)
				return
			end
			position += 1
		end
		block_index += 1
	end
	expect(false).to_be_true()
end

describe("Owned managed deadline lowering") do
	test("requires loader ownership and preserves verified cancellation after source erasure") do
		mut state := deadline_intrinsic_test_state()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		before := control_test_output(emit_qbe(state))
		expect(before.include?("call $trbn_deadline_checkpoint()")).to_be_true()
		mut owned := 0
		state.scalar_mir.signatures.each do |signature|
			if standard_runtime_deadline(state, signature.id)
				owned += 1
				expect(signature.adapter).to_equal(67)
			end
		end
		expect(owned).to_equal(2)
		intrinsic_mir_erase(state)
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			# The watchdog bounds a broken checkpoint implementation independently
			# of the managed clock; the fixed source loop is deliberately long.
			bounded := callable_forced_collection(before).split("export function w $main() {\n@start").join("export function w $main() {\n@start\n call $alarm(w 5)")
			case logical_run_qbe(qbe, bounded)
			when Result::Ok(actual)
				expect(actual).to_equal("7\n2.5\n9.5\n123\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("rejects removal of a required entry or continuation checkpoint") do
		[true, false].each do |entry|
			mut state := deadline_intrinsic_test_state()
			deadline_test_remove_checkpoint(state.scalar_mir, entry)
			expect(mir_deadline_checkpoints_error(state.scalar_mir).include?("checkpoint")).to_be_true()
			# Full verification also rejects any now-stale derived plan.
			expect(verify_mir(state.scalar_mir, true) != "").to_be_true()
		end
	end

	test("does not grant a deadline by its authored spelling") do
		mut state := deadline_intrinsic_test_state()
		mut tested := false
		state.scalar_mir.signatures.each do |signature|
			if standard_runtime_deadline(state, signature.id)
				tested = true
				store_integer(state.standard_modules, signature.source_id, 0)
				expect(standard_runtime_deadline(state, signature.id)).to_be_false()
			end
		end
		expect(tested).to_be_true()
	end

	test("keeps a program without deadlines free of clock imports and polling") do
		mut state := logical_checked_source("def main()\nputs(123)\nend\n")
		expect_compiler_phase(state, "check", check(state))
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		output := control_test_output(emit_qbe(state))
		expect(output.include?("trbn_deadline")).to_be_false()
		expect(output.include?("$clock_gettime")).to_be_false()
	end
end
