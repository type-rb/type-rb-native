import { find_enum_type } from enum_types
import { find_function_in_module } from declaration_lookup
import { CompilerState } from state
import { sparse_string_at } from storage

# The receiver's nominal declaration chooses an ordinary function identity.
# The hidden self parameter remains explicit in its signature and typed MIR call.
def enum_method_function(state: CompilerState, type_name: String, member: String): Integer
	owner := find_enum_type(state, type_name)
	if owner < 0
		return - 1
	end
	definition := state.enums[owner]
	function := find_function_in_module(state, definition.source_id, definition.name + "::" + member)
	if function < 0
		return - 1
	end
	if sparse_string_at(state.function_receivers, function) != type_name
		return - 1
	end
	return function
end
