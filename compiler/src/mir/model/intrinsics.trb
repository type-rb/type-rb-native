import { network_adapter_start, network_names, network_parameters, network_result } from mir/model/network_contract
import { callable_type } from frontend/types/callable_types
import { mir_adapter_argv, mir_adapter_collect_package_files, mir_adapter_collect_project_sources, mir_adapter_entropy, mir_adapter_eputs, mir_adapter_file_exists, mir_adapter_host, mir_adapter_literal_byte, mir_adapter_none, mir_adapter_reset_temporary_storage, mir_adapter_runtime_fail, mir_adapter_runtime_recover, mir_adapter_source_is_utf8, mir_adapter_source_slice, mir_adapter_sqrt, mir_adapter_string_bytes, mir_adapter_time_clock, mir_adapter_time_zone_data, mir_signature_compiler_runtime, mir_signature_host, mir_signature_interface, mir_signature_ordinary, mir_signature_standard } from mir/model/call_kinds
import { ascii_code, integer_string } from support/literals
import { MirModule, MirSignature, mir_type_id } from mir/model/module
import { mir_semantic_type_name, mir_semantic_value_type } from mir/model/types

# The checked declaration owns the adapter. Source aliases and call-site spelling
# never select a runtime operation, and the backend never resolves them again.
def mir_runtime_adapter(name: String): Integer
	if name == "compiler_collect_package_files"
		return mir_adapter_collect_package_files()
	end
	if name == "compiler_literal_byte"
		return mir_adapter_literal_byte()
	end
	names := ["compiler_file_exists", "compiler_read_source", "compiler_source_is_utf8", "compiler_string_bytes", "compiler_source_slice", "compiler_collect_project_sources", "compiler_eputs", "compiler_reset_temporary_storage"]
	mut index := 0
	while index < names.size()
		if names[index] == name
			return index + mir_adapter_file_exists()
		end
		index += 1
	end
	return mir_adapter_none()
end

def mir_call_symbol(signature: MirSignature): String
	if signature.kind == mir_signature_standard()
		if signature.adapter >= network_adapter_start() && signature.adapter < network_adapter_start() + network_names().size()
			return "trbn_network_" + network_names()[signature.adapter - network_adapter_start()]
		end
		if signature.adapter == mir_adapter_entropy()
			return "trbn_entropy_read"
		end
		if signature.adapter == mir_adapter_argv()
			return "trbn_process_argv"
		end
		if signature.adapter == mir_adapter_runtime_fail()
			return "trbn_runtime_fail"
		end
		if signature.adapter == mir_adapter_runtime_recover()
			return "trbn_runtime_recover_l"
		end
		if signature.adapter == mir_adapter_time_clock()
			return "trbn_time_clock"
		end
		if signature.adapter == mir_adapter_time_zone_data()
			return "trbn_time_zone_data"
		end
		return "sqrt"
	end
	if signature.kind == mir_signature_ordinary() || signature.kind == mir_signature_interface()
		return "trbnf" + integer_string(signature.id)
	end
	if signature.kind == mir_signature_host()
		return signature.name
	end
	if signature.adapter == mir_adapter_collect_package_files()
		return "trbn_collect_package_files"
	end
	if signature.adapter == mir_adapter_literal_byte()
		return "trbn_literal_byte"
	end
	symbols := ["trbn_file_exists", "trbn_read_source", "trbn_string_is_utf8", "trbn_string_bytes", "trbn_source_slice", "trbn_collect_project_sources", "trbn_eputs", "trbn_temp_reset"]
	return symbols[signature.adapter - mir_adapter_file_exists()]
end

def mir_host_symbol_valid(name: String): Boolean
	if name.size() == 0
		return false
	end
	mut index := 0
	while index < name.size()
		code := ascii_code(name[index])
		mut valid := code == 95
		if code >= 65 && code <= 90
			valid = true
		end
		if code >= 97 && code <= 122
			valid = true
		end
		if index > 0 && code >= 48 && code <= 57
			valid = true
		end
		if !valid
			return false
		end
		index += 1
	end
	return true
end

def mir_project_sources_result(native_module: MirModule, name: String): Boolean
	native_module.records.each do |definition|
		if mir_semantic_type_name(native_module, definition.type_id) == name
			if definition.name != "CompilerProjectSources" || definition.field_count != 3
				return false
			end
			names := ["paths", "sources", "error"]
			types := ["Array<String>", "Array<String>", "String"]
			mut index := 0
			while index < 3
				field := native_module.fields[definition.field_start + index]
				if field.name != names[index] || mir_semantic_type_name(native_module, field.type_id) != types[index]
					return false
				end
				index += 1
			end
			return true
		end
	end
	return false
end

def mir_intrinsic_signature_error(native_module: MirModule, signature: MirSignature): String
	if signature.kind == mir_signature_interface()
		# The independent object verifier checks method ownership and ABI.
		return ""
	end
	if signature.kind == mir_signature_standard()
		mut name := "trb/std/process.argv"
		mut parameters: Array<String> := []
		mut result := "Array<String>"
		if signature.adapter == mir_adapter_sqrt()
			name = "trb/std/math.sqrt"
			parameters = ["Float"]
			result = "Float"
		elsif signature.adapter == mir_adapter_runtime_fail() || signature.adapter == mir_adapter_runtime_recover()
			name = "trb/internal/runtime.fail"
			parameters = ["String"]
			result = signature.result_type
			if signature.adapter == mir_adapter_runtime_recover()
				name = "trb/internal/runtime.recover"
				parameters = [callable_type([], result), result]
			end
			mut valid := mir_semantic_value_type(native_module, mir_type_id(result))
			native_module.types.each do |row|
				if row.name == result
					valid = true
				end
			end
			if !valid || result == "Void" || result == "Address" || result == "Invalid"
				return "MIR runtime failure result type is invalid"
			end
		elsif signature.adapter == mir_adapter_time_clock()
			name = "trb/internal/time_host.clock"
			parameters = ["Array<Integer>"]
			result = "Boolean"
		elsif signature.adapter == mir_adapter_time_zone_data()
			name = "trb/internal/time_host.zone_data"
			parameters = ["String"]
			result = "String"
		elsif signature.adapter == mir_adapter_entropy()
			name = "trb/internal/entropy.read"
			parameters = ["Integer"]
			result = "String"
		elsif signature.adapter >= network_adapter_start() && signature.adapter < network_adapter_start() + network_names().size()
			network := signature.adapter - network_adapter_start()
			name = "trb/internal/network_host." + network_names()[network]
			parameters = network_parameters(network)
			result = network_result(network)
		elsif signature.adapter != mir_adapter_argv()
			return "MIR standard package adapter is invalid"
		end
		if signature.name != name || signature.result_type != result || signature.parameter_types.size() != parameters.size()
			return "MIR standard package signature differs"
		end
		mut index := 0
		while index < parameters.size()
			mut mutable := 0
			if signature.adapter == mir_adapter_time_clock()
				mutable = 1
			end
			if signature.parameter_types[index] != parameters[index] || signature.parameter_mutable[index] != mutable
				return "MIR standard package parameter differs"
			end
			index += 1
		end
		return ""
	end
	if signature.kind == mir_signature_ordinary()
		if signature.adapter != mir_adapter_none()
			return "MIR ordinary declaration has an external adapter"
		end
		return ""
	end
	adapter := signature.adapter
	if signature.kind == mir_signature_host()
		if adapter != mir_adapter_host()
			return "MIR host adapter differs"
		end
		if !mir_host_symbol_valid(signature.name)
			return "MIR host symbol is invalid"
		end
		return ""
	end
	if signature.kind != mir_signature_compiler_runtime() || adapter < mir_adapter_file_exists() || (adapter > mir_adapter_reset_temporary_storage() && adapter != mir_adapter_literal_byte() && adapter != mir_adapter_collect_package_files())
		return "MIR external adapter is invalid"
	end
	if mir_runtime_adapter(signature.name) != adapter
		return "MIR runtime declaration identity differs"
	end
	mut parameters := ["String"]
	mut result := "String"
	if adapter == mir_adapter_file_exists() || adapter == mir_adapter_source_is_utf8()
		result = "Boolean"
	elsif adapter == mir_adapter_string_bytes()
		result = "Array<Integer>"
	elsif adapter == mir_adapter_source_slice()
		parameters = ["String", "Integer", "Integer"]
	elsif adapter == mir_adapter_collect_project_sources() || adapter == mir_adapter_collect_package_files()
		parameters = ["String"]
		if adapter == mir_adapter_collect_project_sources()
			parameters.push("String")
		end
		result = signature.result_type
		if !mir_project_sources_result(native_module, result)
			return "MIR project source result layout differs"
		end
	elsif adapter == mir_adapter_eputs()
		result = "Void"
	elsif adapter == mir_adapter_reset_temporary_storage()
		parameters = []
		result = "Void"
	elsif adapter == mir_adapter_literal_byte()
		parameters = ["Integer"]
	end
	if signature.parameter_types.size() != parameters.size() || signature.result_type != result
		return "MIR runtime signature differs"
	end
	mut index := 0
	while index < parameters.size()
		if signature.parameter_types[index] != parameters[index] || signature.parameter_mutable[index] != 0
			return "MIR runtime parameter differs"
		end
		index += 1
	end
	return ""
end
