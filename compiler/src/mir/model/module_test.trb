import { mir_definition_index } from mir/analysis/identities
import { mir_build_flow, mir_flow_blocks, mir_flow_position, mir_flow_type, mir_value_available } from mir/analysis/flow
import { MirFunction, MirInstruction, MirValue, mir_value_index, mir_value_type } from mir/model/module
import { optimize_verified_mir } from mir/passes/optimize
import { verify_mir } from mir/verify/module
import { describe, expect, test } from trb/std/test
import { mir_test_block_with_cell, mir_test_instruction_with_cell, mir_test_module } from testing/mir/model

describe("Native MIR model and verifier") do
	test("indexes dense value types directly and sparse identities through Hash") do
		mut native_module := mir_test_module(false, false)
		function := native_module.functions[0]
		mut flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		expect(flow.dense_types.size()).to_equal(9)
		expect(flow.dense_definitions.size()).to_equal(9)
		expect(flow.definitions.size()).to_equal(0)
		expect(flow.types.size()).to_equal(0)
		expect(mir_flow_type(flow, 6)).to_equal(4)
		expect(mir_flow_type(flow, 9)).to_equal(0)
		expect(mir_flow_position(flow, 1)).to_equal(0)
		expect(mir_flow_position(flow, 9)).to_equal(-1)
		expect(mir_value_available(flow, native_module.blocks[0], 0, 1)).to_be_false()
		expect(mir_value_available(flow, native_module.blocks[0], 1, 1)).to_be_true()
		expect(mir_value_available(flow, native_module.blocks[0], 1, 0)).to_be_true()
		expect(mir_value_available(flow, native_module.blocks[0], 1, 9)).to_be_false()
		native_module.values[8] = MirValue.new(function_id: 1, id: 9007199254740991, type_id: 2, source_id: 0, line: 4)
		flow = mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		expect(flow.dense_types.size()).to_equal(0)
		expect(flow.dense_definitions.size()).to_equal(0)
		expect(flow.definitions.size()).to_equal(9)
		expect(flow.types.size()).to_equal(9)
		expect(mir_flow_type(flow, 9007199254740991)).to_equal(2)
		expect(mir_flow_type(flow, 8)).to_equal(0)
		expect(mir_flow_position(flow, 1)).to_equal(0)
		expect(mir_value_available(flow, native_module.blocks[0], 1, 1)).to_be_true()
	end

	test("keeps malformed out-of-range result identities in the sparse fallback") do
		mut native_module := mir_test_module(false, false)
		function := native_module.functions[0]
		native_module.instructions[5] = mir_test_instruction_with_cell(native_module.instructions[5], 1, 999)
		flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		expect(flow.dense_definitions.size()).to_equal(9)
		expect(flow.definitions.size()).to_equal(1)
		expect(mir_flow_position(flow, 999)).to_equal(5)
		expect(mir_value_available(flow, native_module.blocks[2], 6, 999)).to_be_true()
	end

	test("looks up sparse values in grouped and interleaved function rows") do
		mut native_module := mir_test_module(false, false)
		native_module.values.push(MirValue.new(function_id: 90, id: 700, type_id: 2, source_id: 0, line: 1))
		expect(mir_value_index(native_module, 90, 700)).to_equal(9)
		expect(mir_value_type(native_module, 90, 700)).to_equal(2)
		native_module.values.push(MirValue.new(function_id: 1, id: 999, type_id: 3, source_id: 0, line: 1))
		expect(mir_value_index(native_module, 1, 999)).to_equal(10)
		expect(mir_value_type(native_module, 1, 999)).to_equal(3)
		expect(mir_value_index(native_module, 90, 701)).to_equal(-1)
	end

	test("verifies a checked scalar and Array loop MIR skeleton") do
		native_module := mir_test_module(false, false)
		expect(verify_mir(native_module, false)).to_equal("")
	end

	test("rejects an undefined MIR Array index") do
		native_module := mir_test_module(false, true)
		expect(verify_mir(native_module, false)).to_equal("MIR Array address type differs")
	end

	test("rejects invalid value identities, types, origins and absent definitions") do
		rows := [
			MirValue.new(function_id: 99, id: 0, type_id: 3, source_id: 0, line: 1),
			MirValue.new(function_id: 1, id: -1, type_id: 3, source_id: 0, line: 1),
			MirValue.new(function_id: 1, id: 0, type_id: 0, source_id: 0, line: 1),
			MirValue.new(function_id: 1, id: 0, type_id: 9, source_id: 0, line: 1),
			MirValue.new(function_id: 1, id: 0, type_id: 3, source_id: 1, line: 1),
			MirValue.new(function_id: 1, id: 0, type_id: 3, source_id: 0, line: 0),
			MirValue.new(function_id: 1, id: 99, type_id: 3, source_id: 0, line: 1),
		]
		expected := [
			"MIR value identity is invalid", "MIR value identity is invalid",
			"MIR value type is invalid", "MIR value type is invalid",
			"MIR value origin is invalid", "MIR value origin is invalid",
			"MIR value definition count differs",
		]
		mut index := 0
		while index < rows.size()
			mut native_module := mir_test_module(false, false)
			native_module.values[0] = rows[index]
			expect(verify_mir(native_module, false)).to_equal(expected[index])
			index += 1
		end
	end

	test("rejects repeated value identities independently of instruction definitions") do
		mut native_module := mir_test_module(false, false)
		native_module.values.push(MirValue.new(function_id: 1, id: 0, type_id: 3, source_id: 0, line: 1))
		expect(verify_mir(native_module, false)).to_equal("MIR value is defined more than once")
	end
end

describe("Native MIR function carrier invariants") do
	test("rejects malformed function identity, origin, entry and ranges") do
		rows := [
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: -1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: -1, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 1, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 0, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: -1, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 99, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: -1, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 7, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 99, parameter_count: 1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: -1, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 7, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 9007199254740991, block_start: 0, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: -1, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 6, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 99, block_count: 5),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: -1),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 6),
			MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 9007199254740991),
		]
		expected := [
			"MIR function identifier is invalid",
			"MIR function origin is invalid",
			"MIR function origin is invalid",
			"MIR function origin is invalid",
			"MIR function entry block does not exist",
			"MIR function entry block does not exist",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
		]
		mut index := 0
		while index < rows.size()
			mut native_module := mir_test_module(false, false)
			native_module.functions[0] = rows[index]
			expect(verify_mir(native_module, false)).to_equal(expected[index])
			expect(verify_mir(native_module, true)).to_equal(expected[index])
			index += 1
		end
	end

	test("rejects duplicate function identities") do
		mut native_module := mir_test_module(false, false)
		native_module.functions.push(native_module.functions[0])
		expect(verify_mir(native_module, false)).to_equal("MIR function identifier is duplicated")
	end

	test("rejects malformed block ranges before traversing value definitions or targets") do
		fields := [3, 4, 5, 6, 11, 12, 13, 14]
		messages := [
			"MIR block parameter range is invalid", "MIR block parameter range is invalid",
			"MIR block instruction range is invalid", "MIR block instruction range is invalid",
			"MIR terminator argument range is invalid", "MIR terminator argument range is invalid",
			"MIR alternate argument range is invalid", "MIR alternate argument range is invalid",
		]
		invalid := [-1, 99, 9007199254740991]
		mut index := 0
		while index < fields.size()
			mut value_index := 0
			while value_index < invalid.size()
				mut native_module := mir_test_module(false, false)
				native_module.blocks[0] = mir_test_block_with_cell(native_module.blocks[0], fields[index], invalid[value_index])
				expect(verify_mir(native_module, false)).to_equal(messages[index])
				expect(verify_mir(native_module, true)).to_equal(messages[index])
				value_index += 1
			end
			index += 1
		end
	end

end

describe("Native MIR block carrier semantics") do
	test("preserves block origins, identities, terminators and successor checks") do
		changes := [
			[0, 1, -1],
			[0, 1, 1],
			[0, 2, 0],
			[0, 7, 99],
			[0, 8, 0],
			[0, 9, 99],
			[0, 10, 12],
			[0, 12, 0],
			[1, 8, 99],
			[1, 10, 99],
			[4, 15, 99],
			[3, 11, 1],
		]
		expected := [
			"MIR block origin is invalid",
			"MIR block origin is invalid",
			"MIR block origin is invalid",
			"MIR terminator kind is unsupported",
			"MIR jump shape differs",
			"MIR terminator target does not exist",
			"MIR jump shape differs",
			"MIR block argument arity differs",
			"MIR branch shape differs",
			"MIR terminator target does not exist",
			"MIR return value is undefined",
			"MIR trap shape differs",
		]
		mut index := 0
		while index < changes.size()
			mut native_module := mir_test_module(false, false)
			change := changes[index]
			native_module.blocks[change[0]] = mir_test_block_with_cell(native_module.blocks[change[0]], change[1], change[2])
			expect(verify_mir(native_module, false)).to_equal(expected[index])
			expect(verify_mir(native_module, true)).to_equal(expected[index])
			index += 1
		end
	end
end

describe("Native MIR duplicate block identity") do
	test("rejects a duplicate trap block without duplicated definitions") do
		mut native_module := mir_test_module(false, false)
		native_module.blocks.push(native_module.blocks[3])
		native_module.functions[0] = MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 6)
		expect(verify_mir(native_module, false)).to_equal("MIR block identifier is duplicated")
		expect(verify_mir(native_module, true)).to_equal("MIR block identifier is duplicated")
	end
end

describe("Native MIR instruction carrier semantics") do
	test("preserves instruction kind, origin, operands, payload and failure checks") do
		changes := [[0, 0, 99], [0, 1, 99], [0, 2, 0], [0, 3, 0], [0, 5, 13], [0, 6, 1], [0, 7, 0], [1, 2, 99], [1, 4, 1], [2, 2, 99], [2, 4, 1], [3, 3, 99], [3, 4, 3], [3, 5, 99], [3, 5, 14], [5, 2, 8], [5, 4, 1]]
		expected := [
			"MIR instruction kind is unsupported", "MIR value definition count differs",
			"MIR Integer constant shape differs", "MIR Integer constant shape differs", "MIR Integer constant shape differs",
			"MIR instruction origin is invalid", "MIR instruction origin is invalid",
			"MIR Array length type differs", "MIR Array length shape differs",
			"MIR Integer comparison type differs", "MIR Integer comparison shape differs",
			"MIR Array address type differs", "MIR Array address shape differs",
			"MIR failure target does not exist", "MIR failure target is not a trap block",
			"MIR checked Integer add type differs", "MIR checked Integer add shape differs",
		]
		mut index := 0
		while index < changes.size()
			mut native_module := mir_test_module(false, false)
			change := changes[index]
			native_module.instructions[change[0]] = mir_test_instruction_with_cell(native_module.instructions[change[0]], change[1], change[2])
			expect(verify_mir(native_module, false)).to_equal(expected[index])
			expect(verify_mir(native_module, true)).to_equal(expected[index])
			index += 1
		end
	end
end

describe("Native MIR instruction replacement") do
	test("retains instruction snapshots across repeated verified rewrites") do
		mut native_module := mir_test_module(false, false)
		native_module.instructions[5] = MirInstruction.new(kind: 7, result: 8, first: 5, second: 7, payload: 1, failure: 13, source_id: 0, line: 4)
		original := native_module.instructions[5]
		expect(verify_mir(native_module, false)).to_equal("")
		optimize_verified_mir(native_module)
		expect(original.payload).to_equal(1)
		expect(native_module.instructions[5]).to_equal(MirInstruction.new(kind: 7, result: 8, first: 5, second: 7, payload: 13, failure: 13, source_id: 0, line: 4))
		expect(verify_mir(native_module, true)).to_equal("")
		rewritten := native_module.instructions[5]
		optimize_verified_mir(native_module)
		expect(native_module.instructions[5]).to_equal(rewritten)
		expect(verify_mir(native_module, true)).to_equal("")
	end
end

describe("MIR definition index") do
	test("separates function-local IDs and retains sparse and repeated definitions") do
		mut native_module := mir_test_module(false, false)
		function := native_module.functions[0]
		native_module.functions.push(MirFunction.new(kind: function.kind, result_type: function.result_type, integer_guard: function.integer_guard, id: 12, entry_block: function.entry_block, source_id: function.source_id, line: function.line, parameter_start: function.parameter_start, parameter_count: function.parameter_count, block_start: function.block_start, block_count: function.block_count))
		native_module.instructions[0] = mir_test_instruction_with_cell(native_module.instructions[0], 1, 23)
		index := mir_definition_index(native_module)
		# Decimal IDs must have a boundary: 1:23 and 12:3 are distinct.
		expect(index["1:23"]).to_equal(1)
		expect(index["12:3"]).to_equal(1)
		expect(index["1:0"]).to_equal(1)
		expect(index["12:0"]).to_equal(1)
		expect(index.key?("1:99")).to_be_false()
		native_module.instructions[0] = mir_test_instruction_with_cell(native_module.instructions[0], 1, 0)
		repeated := mir_definition_index(native_module)
		expect(repeated["1:0"]).to_equal(2)
		expect(repeated.key?("1:23")).to_be_false()
		native_module.instructions[0] = mir_test_instruction_with_cell(native_module.instructions[0], 1, 9007199254740991)
		sparse := mir_definition_index(native_module)
		expect(sparse["1:9007199254740991"]).to_equal(1)
		expect(sparse["12:9007199254740991"]).to_equal(1)
		expect(sparse["1:0"]).to_equal(1)
		expect(sparse.size()).to_equal(index.size())
	end
end
