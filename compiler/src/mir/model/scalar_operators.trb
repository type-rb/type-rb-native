# Verified scalar rewrites prefer inline add/multiply using these payload tags.
# They are not the source logical OR/AND operators with the same numeric values;
# logical expressions lower to control flow before scalar MIR is built.

def mir_scalar_inline_multiply(): Integer
	return 12
end

def mir_scalar_inline_add(): Integer
	return 13
end

# Eager conjunction/disjunction of canonical Boolean SSA values. Source logical
# operators still lower to short-circuit control flow; these do not evaluate RHS.
def mir_scalar_boolean_and(): Integer
	return 15
end

def mir_scalar_boolean_or(): Integer
	return 16
end
