# Composite row categories differ from value type IDs and instruction kinds.
# The absent category is a query result only; no stored type row has that kind.

def mir_type_kind_none(): Integer
	return 0
end

def mir_type_kind_array(): Integer
	return 1
end

def mir_type_kind_record(): Integer
	return 2
end

def mir_type_kind_hash(): Integer
	return 3
end

