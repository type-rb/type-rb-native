import { mir_adapter_none, mir_adapter_sqrt } from mir/model/call_kinds

# Standard math identities are shared by checking, MIR verification and emission.
# Keep the established sqrt adapter; new adapters do not overlap runtime families.
def math_adapter_sin(): Integer
	return 67
end

def math_adapter_cos(): Integer
	return 68
end

def math_adapter_pow(): Integer
	return 69
end

def math_adapter(member: String): Integer
	if member == "sqrt"
		return mir_adapter_sqrt()
	elsif member == "sin"
		return math_adapter_sin()
	elsif member == "cos"
		return math_adapter_cos()
	elsif member == "pow"
		return math_adapter_pow()
	end
	return mir_adapter_none()
end

def math_member(adapter: Integer): String
	if adapter == mir_adapter_sqrt()
		return "sqrt"
	elsif adapter == math_adapter_sin()
		return "sin"
	elsif adapter == math_adapter_cos()
		return "cos"
	elsif adapter == math_adapter_pow()
		return "pow"
	end
	return ""
end

def math_parameter_names(adapter: Integer): Array<String>
	if adapter == math_adapter_pow()
		return ["base", "exponent"]
	end
	return ["value"]
end

def math_parameters(adapter: Integer): Array<String>
	if adapter == math_adapter_pow()
		return ["Float", "Float"]
	end
	return ["Float"]
end
