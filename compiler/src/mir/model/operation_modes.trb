# Each instruction owns its payload domain. Equal numeric encodings across
# these families do not make them interchangeable. Empty payloads, SSA operands
# and table indices remain distinct from modes. Runtime wire values stay fixed.

# conversion

def mir_convert_integer_to_string(): Integer
	return 1
end

def mir_convert_string_to_integer(): Integer
	return 2
end

def mir_convert_float_to_integer(): Integer
	return 3
end

def mir_convert_float_to_string(): Integer
	return 4
end

def mir_convert_boolean_to_string(): Integer
	return 5
end

def mir_convert_string_to_float(): Integer
	return 6
end

def mir_convert_string_integer_status(): Integer
	return 7
end

def mir_convert_string_float_status(): Integer
	return 8
end

