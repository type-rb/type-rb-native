import { emit_qbe } from compiler
import { CompilerState } from state/state
import { optimize_verified_mir } from mir/passes/optimize
import { mir_array_version_count } from mir/passes/array_loop_versions
import { verify_mir } from mir/verify/module
import { array_loop_mir_check } from testing/mir/array_loops
import { control_test_output } from testing/mir/control
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

def versioned_array_access_count(state: CompilerState): Integer
	mut count := 0
	state.scalar_mir.array_loops.each do |plans|
		plans.each do |plan|
			plan.headers.each do |header|
				count += header.bounded_accesses.size()
			end
		end
	end
	return count
end

def versioned_array_run(output: String, expected: String)
	qbe := Process.environment("TYPE_RB_NATIVE_QBE")
	if qbe != nil
		case logical_run_qbe(qbe, output)
		when Result::Ok(actual)
			expect(actual).to_equal(expected)
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
	end
end

describe("MIR Array loop versioning") do
	test("versions an independent loop after earlier guard arms rejoin") do
		mut state := array_loop_mir_check("def update(left: Array<Integer>, mut right: Array<Integer>): Integer\nmut index := 0\nwhile index < left.size()\nright[index] += left[index]\nindex += 1\nend\nindex = 0\nwhile index < left.size()\nright[index] += left[index]\nindex += 1\nend\nreturn right[0]\nend\ndef main()\nputs(update([2, 3], [10, 20]))\nputs(update([], [7]))\nend\n")
		expect(mir_array_version_count(state.scalar_mir, state.scalar_mir.functions[0])).to_equal(2)
		before := control_test_output(emit_qbe(state))
		count := state.scalar_mir.blocks.size()
		intrinsic_mir_erase(state)
		optimize_verified_mir(state.scalar_mir)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(state.scalar_mir.blocks.size()).to_equal(count)
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		versioned_array_run(before, "14\n7\n")
	end

	test("guards scalar bounds once and retains zero negative and short-array paths") do
		mut state := array_loop_mir_check("def sum(values: Array<Integer>, limit: Integer): Integer\nmut total := 0\nmut index := 0\nwhile index < limit\nif index == 2\nbreak\nend\ntotal += values[index]\nindex += 1\nend\nreturn total\nend\ndef main()\nputs(sum([10, 20, 30], 3))\nputs(sum([10, 20], 4))\nputs(sum([], 0))\nputs(sum([], -1))\nend\n")
		expect(versioned_array_access_count(state) > 0).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		before := control_test_output(emit_qbe(state))
		count := state.scalar_mir.blocks.size()
		intrinsic_mir_erase(state)
		optimize_verified_mir(state.scalar_mir)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(state.scalar_mir.blocks.size()).to_equal(count)
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		versioned_array_run(before, "30\n30\n0\n0\n")
	end

	test("guards peer lengths and preserves nested induction and mutable elements") do
		mut state := array_loop_mir_check("def update(left: Array<Integer>, mut right: Array<Integer>): Integer\nmut index := 0\nwhile index < left.size()\nmut other := index + 1\nwhile other < left.size()\nright[other] += left[index]\nother += 1\nend\nright[index] += left[index]\nindex += 1\nend\nreturn right[2]\nend\ndef main()\nputs(update([2, 3, 5], [10, 20, 30]))\nend\n")
		expect(versioned_array_access_count(state) > 0).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		output := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		# Reordering physical SSA rows must not change alias or value ownership.
		mut first := 0
		mut last := state.scalar_mir.values.size() - 1
		while first < last
			saved := state.scalar_mir.values[first]
			state.scalar_mir.values[first] = state.scalar_mir.values[last]
			state.scalar_mir.values[last] = saved
			first += 1
			last -= 1
		end
		optimize_verified_mir(state.scalar_mir)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(control_test_output(emit_qbe(state))).to_equal(output)
		versioned_array_run(output, "40\n")
	end

	test("keeps failures at their original access after preceding observable work") do
		state := array_loop_mir_check("def update(left: Array<Integer>, mut right: Array<Integer>)\nmut index := 0\nwhile index < left.size()\nright[index] = left[index]\nindex += 1\nend\nend\ndef main()\nupdate([10, 20], [0])\nend\n")
		expect(versioned_array_access_count(state) > 0).to_be_true()
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
			when Result::Ok(_actual)
				expect(false).to_be_true()
			when Result::Err(error)
				expect(error).to_equal("panic: index is out of bounds\n")
			end
		end
	end

	test("keeps the version budget across repeated optimization") do
		body := "index = 0\nwhile index < limit\ntotal += values[index]\nindex += 1\nend\n"
		mut state := array_loop_mir_check("def sum(values: Array<Integer>, limit: Integer): Integer\nmut total := 0\nmut index := 0\n" + body + body + body + "\nreturn total\nend\ndef main()\nputs(sum([10, 20], 2))\nend\n")
		count := state.scalar_mir.blocks.size()
		optimize_verified_mir(state.scalar_mir)
		expect(state.scalar_mir.blocks.size()).to_equal(count)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		versioned_array_run(control_test_output(emit_qbe(state)), "90\n")
	end

	test("rejects resizing and allocating operations inside a candidate loop") do
		["values.pop()", "touch(values)"].each do |operation|
			state := array_loop_mir_check("def touch(mut values: Array<Integer>)\nvalues.push(1)\nend\ndef sum(mut values: Array<Integer>, limit: Integer): Integer\nmut total := 0\nmut index := 0\nwhile index < limit\n" + operation + "\ntotal += values[index]\nindex += 1\nend\nreturn total\nend\ndef main()\nend\n")
			expect(versioned_array_access_count(state)).to_equal(0)
		end
	end
end
