import { emit_qbe } from compiler
import { mir_function_value_groups } from mir/analysis/flow
import { mir_terminator_branch } from mir/model/control
import { mir_op_scalar_binary } from mir/model/instructions
import { MirBlock, MirInstruction, MirModule } from mir/model/module
import { mir_integer_edge_block, mir_integer_edge_operands } from mir/passes/integer_edges
import { optimize_verified_mir } from mir/passes/optimize
import { verify_mir } from mir/verify/module
import { CompilerState } from state/state
import { array_loop_mir_check } from testing/mir/array_loops
import { control_test_output } from testing/mir/control
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

def integer_edge_run(state: CompilerState, expected: String, failure: Boolean)
	qbe := Process.environment("TYPE_RB_NATIVE_QBE")
	if qbe != nil
		case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
		when Result::Ok(actual)
			expect(failure).to_be_false()
			expect(actual).to_equal(expected)
		when Result::Err(error)
			if !failure
				puts(error)
			end
			expect(failure).to_be_true()
			expect(error).to_equal(expected)
		end
	end
end

def integer_edge_branch(native_module: MirModule): Integer
	function := native_module.functions[0]
	mut index := function.block_start
	while index < function.block_start + function.block_count
		block := native_module.blocks[index]
		if block.terminator == mir_terminator_branch()
			return index
		end
		index += 1
	end
	return -1
end

def integer_edge_condition(native_module: MirModule, block: MirBlock): MirInstruction
	mut position := block.instruction_start
	while position < block.instruction_start + block.instruction_count
		instruction := native_module.instructions[position]
		if instruction.result == block.condition
			return instruction
		end
		position += 1
	end
	expect(false).to_be_true()
	return native_module.instructions[block.instruction_start]
end

def integer_edge_span(native_module: MirModule, start: Integer, count: Integer): Array<Integer>
	mut values: Array<Integer> := []
	mut index := 0
	while index < count
		values.push(native_module.arguments[start + index])
		index += 1
	end
	return values
end

describe("MIR Integer equality edges") do
	test("forwards a literal only on the equality arm in either operand order") do
		conditions := ["value == 1", "1 == value", "value != 1", "1 != value"]
		conditions.each.with_index do |condition, mode|
			state := array_loop_mir_check("def choose(value: Integer): Integer\nmut result := value\nif " + condition + "\nresult += 10\nelse\nresult += 20\nend\nreturn result\nend\ndef main()\nputs(choose(1))\nputs(choose(2))\nputs(choose(-1))\nend\n")
			index := integer_edge_branch(state.scalar_mir)
			expect(index >= 0).to_be_true()
			block := state.scalar_mir.blocks[index]
			comparison := integer_edge_condition(state.scalar_mir, block)
			expect(comparison.kind).to_equal(mir_op_scalar_binary())
			mut literal := comparison.second
			mut value := comparison.first
			if mode == 1 || mode == 3
				literal = comparison.first
				value = comparison.second
			end
			mut equal_start := block.first_argument_start
			mut equal_count := block.first_argument_count
			mut other_start := block.second_argument_start
			mut other_count := block.second_argument_count
			if mode >= 2
				equal_start = block.second_argument_start
				equal_count = block.second_argument_count
				other_start = block.first_argument_start
				other_count = block.first_argument_count
			end
			equal := integer_edge_span(state.scalar_mir, equal_start, equal_count)
			other := integer_edge_span(state.scalar_mir, other_start, other_count)
			expect(equal.include?(literal)).to_be_true()
			expect(equal.include?(value)).to_be_false()
			expect(other.include?(value)).to_be_true()
			if mode < 2
				integer_edge_run(state, "11\n22\n19\n", false)
			else
				integer_edge_run(state, "21\n12\n9\n", false)
			end
		end
	end

	test("copies shared argument spans for distinct and parallel targets") do
		mut state := array_loop_mir_check("def choose(value: Integer): Integer\nmut result := value\nif value == 1\nresult += 10\nelse\nresult += 20\nend\nreturn result\nend\ndef main()\nputs(choose(1))\nputs(choose(2))\nend\n")
		index := integer_edge_branch(state.scalar_mir)
		block := state.scalar_mir.blocks[index]
		comparison := integer_edge_condition(state.scalar_mir, block)
		expect(block.first_argument_count).to_equal(block.second_argument_count)
		# Reuse the unequal arm's original arguments on both edges, making a
		# write through either old span observable.
		shared := MirBlock.new(id: block.id, source_id: block.source_id, line: block.line, parameter_start: block.parameter_start, parameter_count: block.parameter_count, instruction_start: block.instruction_start, instruction_count: block.instruction_count, terminator: block.terminator, condition: block.condition, first_target: block.first_target, second_target: block.second_target, first_argument_start: block.second_argument_start, first_argument_count: block.second_argument_count, second_argument_start: block.second_argument_start, second_argument_count: block.second_argument_count, return_value: block.return_value)
		state.scalar_mir.blocks[index] = shared
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		before := integer_edge_span(state.scalar_mir, shared.second_argument_start, shared.second_argument_count)
		values := mir_function_value_groups(state.scalar_mir)
		rewritten := mir_integer_edge_block(state.scalar_mir, shared, values[0])
		expect(rewritten.first_argument_start != shared.first_argument_start).to_be_true()
		expect(rewritten.second_argument_start).to_equal(shared.second_argument_start)
		expect(integer_edge_span(state.scalar_mir, shared.second_argument_start, shared.second_argument_count)).to_equal(before)
		expect(integer_edge_span(state.scalar_mir, rewritten.first_argument_start, rewritten.first_argument_count).include?(comparison.second)).to_be_true()
		# A parallel edge must receive a private span as well. Keep this check
		# at the MIR boundary so both original arithmetic arms stay reachable
		# in the executable fixture below.
		parallel := MirBlock.new(id: shared.id, source_id: shared.source_id, line: shared.line, parameter_start: shared.parameter_start, parameter_count: shared.parameter_count, instruction_start: shared.instruction_start, instruction_count: shared.instruction_count, terminator: shared.terminator, condition: shared.condition, first_target: shared.second_target, second_target: shared.second_target, first_argument_start: shared.first_argument_start, first_argument_count: shared.first_argument_count, second_argument_start: shared.second_argument_start, second_argument_count: shared.second_argument_count, return_value: shared.return_value)
		parallel_rewritten := mir_integer_edge_block(state.scalar_mir, parallel, values[0])
		expect(parallel_rewritten.first_target).to_equal(parallel_rewritten.second_target)
		expect(parallel_rewritten.first_argument_start != parallel_rewritten.second_argument_start).to_be_true()
		expect(integer_edge_span(state.scalar_mir, parallel_rewritten.first_argument_start, parallel_rewritten.first_argument_count)).to_equal(integer_edge_span(state.scalar_mir, rewritten.first_argument_start, rewritten.first_argument_count))
		expect(integer_edge_span(state.scalar_mir, parallel_rewritten.second_argument_start, parallel_rewritten.second_argument_count)).to_equal(before)
		state.scalar_mir.blocks[index] = rewritten
		optimize_verified_mir(state.scalar_mir)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		integer_edge_run(state, "11\n22\n", false)
	end

	test("preserves negative values portable boundaries and checked failures") do
		state := array_loop_mir_check("def keep(value: Integer): Integer\nmut result := value\nif value == 0\nresult += 1\nend\nif result != 9007199254740991\nreturn result\nend\nreturn result\nend\ndef main()\nputs(keep(-9007199254740991))\nputs(keep(-1))\nputs(keep(0))\nputs(keep(9007199254740991))\nend\n")
		integer_edge_run(state, "-9007199254740991\n-1\n1\n9007199254740991\n", false)
		overflow := array_loop_mir_check("def add(value: Integer): Integer\nif value == 9007199254740991\nreturn value + 1\nend\nreturn value\nend\ndef main()\nputs(add(9007199254740991))\nend\n")
		integer_edge_run(overflow, "panic: Integer is outside the portable range\n", true)
		bounds := array_loop_mir_check("def read(values: Array<Integer>, index: Integer): Integer\nif index == 0\nreturn values[index]\nend\nreturn values[index]\nend\ndef main()\nputs(read([], 0))\nend\n")
		integer_edge_run(bounds, "panic: index is out of bounds\n", true)
	end

	test("leaves negative expressions and already constant comparisons stable") do
		mut state := array_loop_mir_check("def negative(value: Integer): Integer\nmut result := value\nif value == -1\nresult += 10\nend\nreturn result\nend\ndef constants(value: Integer): Integer\nmut result := value\nif 1 == 2\nresult += 10\nelse\nresult += 20\nend\nreturn result\nend\ndef main()\nputs(negative(-1))\nputs(negative(2))\nputs(constants(3))\nend\n")
		before := state.scalar_mir.arguments.size()
		optimize_verified_mir(state.scalar_mir)
		expect(state.scalar_mir.arguments.size()).to_equal(before)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		integer_edge_run(state, "9\n2\n23\n", false)
	end

	test("excludes Float signed zero and Boolean comparisons") do
		state := array_loop_mir_check("def keep(value: Float): Float\nmut result := value\nif value == 0.0\nresult = value\nelse\nresult = 1.0\nend\nreturn result\nend\ndef flag(value: Boolean): Boolean\nif value == true\nreturn value\nend\nreturn value\nend\ndef main()\nputs(1.0 / keep(-0.0) < 0.0)\nputs(1.0 / keep(0.0) < 0.0)\nputs(flag(true))\nputs(flag(false))\nend\n")
		index := integer_edge_branch(state.scalar_mir)
		block := state.scalar_mir.blocks[index]
		values := mir_function_value_groups(state.scalar_mir)
		before := state.scalar_mir.arguments.size()
		expect(mir_integer_edge_block(state.scalar_mir, block, values[0])).to_equal(block)
		expect(state.scalar_mir.arguments.size()).to_equal(before)
		mut function_index := 0
		while function_index < 2
			function := state.scalar_mir.functions[function_index]
			mut position := function.block_start
			while position < function.block_start + function.block_count
				owner := state.scalar_mir.blocks[position]
				if owner.terminator == mir_terminator_branch()
					comparison := integer_edge_condition(state.scalar_mir, owner)
					expect(mir_integer_edge_operands(values[function_index], comparison)).to_be_false()
				end
				position += 1
			end
			function_index += 1
		end
		integer_edge_run(state, "true\nfalse\ntrue\nfalse\n", false)
	end

	test("keeps a loop exit fact after source erasure block reordering and repeated optimization") do
		mut state := array_loop_mir_check("def reduce(value: Integer): Integer\nmut remaining := value\nwhile remaining != 1\nremaining -= 1\nend\nmut result := remaining\nwhile result < 4\nresult += 1\nend\nreturn result\nend\ndef main()\nputs(reduce(1))\nputs(reduce(7))\nend\n")
		integer_edge_run(state, "4\n4\n", false)
		arguments := state.scalar_mir.arguments.size()
		before := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		optimize_verified_mir(state.scalar_mir)
		expect(state.scalar_mir.arguments.size()).to_equal(arguments)
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		function := state.scalar_mir.functions[0]
		mut left := function.block_start
		mut right := left + function.block_count - 1
		while left < right
			saved := state.scalar_mir.blocks[left]
			state.scalar_mir.blocks[left] = state.scalar_mir.blocks[right]
			state.scalar_mir.blocks[right] = saved
			left += 1
			right -= 1
		end
		optimize_verified_mir(state.scalar_mir)
		expect(state.scalar_mir.arguments.size()).to_equal(arguments)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		integer_edge_run(state, "4\n4\n", false)
	end
end
