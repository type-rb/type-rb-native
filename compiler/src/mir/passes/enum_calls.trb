import { mir_signature_ordinary } from mir/model/call_kinds
import { mir_function_control, mir_terminator_return } from mir/model/control
import { mir_op_direct_call, mir_op_enum_field, mir_op_enum_new, mir_op_enum_test, mir_op_integer_less, mir_op_integer_to_float, mir_op_scalar_binary, mir_op_scalar_literal, mir_op_scalar_unary, mir_op_string_literal } from mir/model/instructions
import { integer_string } from support/literals
import { MirFunction, MirModule, MirValue, mir_block_index, mir_function_index, mir_value_type } from mir/model/module
import { mir_enum_id, mir_managed_type } from mir/model/types
import { mir_enum_stack_definition, mir_enum_stack_result_type, mir_enum_stack_scalar_payloads } from mir/analysis/enum_stack
import { mir_refine_call_effects } from mir/analysis/call_effects
import { mir_managed_add, mir_managed_contains } from mir/analysis/roots
import { mir_block } from mir/build/blocks
import { mir_enum_component_fields, mir_scalarize_enum_components } from mir/passes/enum_components
import { mir_rewrite_arguments, mir_rewrite_block, mir_rewrite_commit, mir_rewrite_fork, mir_rewrite_function, mir_rewrite_instruction, mir_rewrite_next_block, mir_rewrite_next_value, mir_rewrite_value } from mir/passes/rewrite

def mir_enum_body_size(native_module: MirModule, function: MirFunction): Integer
	mut count := 0
	mut index := function.block_start
	while index < function.block_start + function.block_count
		count += native_module.blocks[index].instruction_count
		index += 1
	end
	return count
end

# Topological elimination includes unreachable blocks. A recursive call edge is
# rejected separately; neither a source ordering nor a guessed trip count proves
# that a body is acyclic.
def mir_enum_acyclic(native_module: MirModule, function: MirFunction): Boolean
	mut removed: Array<Integer> := []
	mut round := 0
	while round < function.block_count
		mut selected := -1
		mut index := function.block_start
		while index < function.block_start + function.block_count && selected < 0
			block := native_module.blocks[index]
			if !mir_managed_contains(removed, block.id)
				mut incoming := false
				mut other := function.block_start
				while other < function.block_start + function.block_count
					predecessor := native_module.blocks[other]
					if !mir_managed_contains(removed, predecessor.id) && (predecessor.first_target == block.id || predecessor.second_target == block.id)
						incoming = true
					end
					other += 1
				end
				if !incoming
					selected = block.id
				end
			end
			index += 1
		end
		if selected < 0
			return false
		end
		mir_managed_add(removed, selected)
		round += 1
	end
	return true
end

def mir_enum_callee_eligible(native_module: MirModule, function: MirFunction, path: Array<Integer>): Boolean
	if path.size() >= 3 || mir_managed_contains(path, function.id) || function.kind != mir_op_integer_less() || function.block_count > 24 || function.parameter_count > 8 || mir_enum_body_size(native_module, function) > 64
		return false
	end
	if function.id < 0 || function.id >= native_module.signatures.size() || native_module.signatures[function.id].kind != mir_signature_ordinary()
		return false
	end
	entry := mir_block_index(native_module, function, function.entry_block)
	if entry < 0 || native_module.blocks[entry].parameter_count != 0
		return false
	end
	if mir_enum_component_fields(native_module, mir_enum_stack_result_type(native_module, function.id)).size() == 0 || !mir_enum_acyclic(native_module, function)
		return false
	end
	mut count := 0
	native_module.values.each do |value|
		if value.function_id == function.id
			count += 1
		end
	end
	if count > 128
		return false
	end
	mut parameter := 0
	while parameter < function.parameter_count
		type_id := mir_value_type(native_module, function.id, native_module.arguments[function.parameter_start + parameter])
		if mir_managed_type(native_module, type_id) && !mir_enum_stack_scalar_payloads(native_module, type_id)
			return false
		end
		parameter += 1
	end
	mut nested: Array<Integer> := []
	path.each do |id|
		nested.push(id)
	end
	mir_managed_add(nested, function.id)
	mut index := function.block_start
	while index < function.block_start + function.block_count
		block := native_module.blocks[index]
		if block.terminator == mir_terminator_return()
			definition := mir_enum_stack_definition(native_module, function, block.return_value)
			if definition < 0 || (native_module.instructions[definition].kind != mir_op_enum_new() && native_module.instructions[definition].kind != mir_op_direct_call())
				return false
			end
		end
		mut cursor := block.instruction_start
		while cursor < block.instruction_start + block.instruction_count
			instruction := native_module.instructions[cursor]
			kind := instruction.kind
			if kind == mir_op_direct_call()
				callee := mir_function_index(native_module, native_module.calls[instruction.payload].callee)
				if callee < 0 || !mir_enum_callee_eligible(native_module, native_module.functions[callee], nested)
					return false
				end
			elsif kind != mir_op_scalar_literal() && kind != mir_op_scalar_binary() && kind != mir_op_scalar_unary() && kind != mir_op_integer_to_float() && kind != mir_op_string_literal() && kind != mir_op_enum_new() && kind != mir_op_enum_test() && kind != mir_op_enum_field()
				return false
			end
			cursor += 1
		end
		index += 1
	end
	return true
end

def mir_expand_enum_call(mut native_module: MirModule, function_index: Integer, block_index: Integer, instruction_index: Integer, callee: MirFunction)
	function := native_module.functions[function_index]
	block := native_module.blocks[block_index]
	instruction := native_module.instructions[instruction_index]
	call := native_module.calls[instruction.payload]
	mut values: Hash<String, Integer> := {}
	mut blocks: Hash<String, Integer> := {}
	mut next_value := mir_rewrite_next_value(native_module, function)
	mut next_block := mir_rewrite_next_block(native_module, function)
	continuation := next_block
	next_block += 1
	mut parameter := 0
	while parameter < callee.parameter_count
		values[integer_string(native_module.arguments[callee.parameter_start + parameter])] = native_module.arguments[call.argument_start + parameter]
		parameter += 1
	end
	# Snapshot rows before appending clones: mutating an iterated owner would
	# otherwise make alias and GC behavior depend on container growth.
	mut callee_values: Array<MirValue> := []
	native_module.values.each do |value|
		if value.function_id == callee.id
			callee_values.push(value)
		end
	end
	callee_values.each do |value|
		if !values.key?(integer_string(value.id))
			values[integer_string(value.id)] = next_value
			native_module.values.push(MirValue.new(function_id: function.id, id: next_value, type_id: value.type_id, source_id: value.source_id, line: value.line))
			next_value += 1
		end
	end
	mut index := callee.block_start
	while index < callee.block_start + callee.block_count
		blocks[integer_string(native_module.blocks[index].id)] = next_block
		next_block += 1
		index += 1
	end
	start := native_module.blocks.size()
	index = function.block_start
	while index < function.block_start + function.block_count
		if index == block_index
			native_module.blocks.push(mir_block(block.id, block.source_id, block.line, block.parameter_start, block.parameter_count, block.instruction_start, instruction_index - block.instruction_start, 1, -1, blocks[integer_string(callee.entry_block)], -1, 0, 0, 0, 0, -1))
		else
			native_module.blocks.push(native_module.blocks[index])
		end
		index += 1
	end
	parameter_start := native_module.arguments.size()
	native_module.arguments.push(instruction.result)
	native_module.blocks.push(mir_block(continuation, block.source_id, block.line, parameter_start, 1, instruction_index + 1, block.instruction_start + block.instruction_count - instruction_index - 1, block.terminator, block.condition, block.first_target, block.second_target, block.first_argument_start, block.first_argument_count, block.second_argument_start, block.second_argument_count, block.return_value))
	index = callee.block_start
	while index < callee.block_start + callee.block_count
		body := native_module.blocks[index]
		instruction_start := native_module.instructions.size()
		mut cursor := body.instruction_start
		while cursor < body.instruction_start + body.instruction_count
			native_module.instructions.push(mir_rewrite_instruction(native_module, native_module.instructions[cursor], values, blocks))
			cursor += 1
		end
		if body.terminator == mir_terminator_return()
			arguments := native_module.arguments.size()
			native_module.arguments.push(mir_rewrite_value(values, body.return_value))
			parameters := mir_rewrite_arguments(native_module, body.parameter_start, body.parameter_count, values)
			native_module.blocks.push(mir_block(blocks[integer_string(body.id)], body.source_id, body.line, parameters, body.parameter_count, instruction_start, body.instruction_count, 1, -1, continuation, -1, arguments, 1, 0, 0, -1))
		else
			native_module.blocks.push(mir_rewrite_block(native_module, body, values, blocks, instruction_start, body.instruction_count))
		end
		index += 1
	end
	native_module.functions[function_index] = mir_rewrite_function(function, start, function.block_count + callee.block_count + 1)
end

def mir_enum_call_candidate(native_module: MirModule, function: MirFunction, eligible: Array<Integer>): Array<Integer>
	mut index := function.block_start
	while index < function.block_start + function.block_count
		block := native_module.blocks[index]
		mut cursor := block.instruction_start
		while cursor < block.instruction_start + block.instruction_count
			instruction := native_module.instructions[cursor]
			if instruction.kind == mir_op_direct_call()
				callee := mir_function_index(native_module, native_module.calls[instruction.payload].callee)
				if callee >= 0 && eligible[callee] == 1
					return [index, cursor, callee]
				end
			end
			cursor += 1
		end
		index += 1
	end
	return []
end

def mir_expand_enum_calls(mut native_module: MirModule)
	mut eligible: Array<Integer> := []
	mut any := false
	native_module.functions.each do |function|
		mut selected := 0
		if mir_enum_callee_eligible(native_module, function, [])
			selected = 1
			any = true
		end
		eligible.push(selected)
	end
	if !any
		return
	end
	mut module_calls := 0
	mut module_growth := 0
	mut changed := false
	mut function_index := 0
	while function_index < native_module.functions.size()
		function := native_module.functions[function_index]
		original_size := mir_enum_body_size(native_module, function)
		if function.kind == mir_function_control() && function.block_count <= 64 && original_size <= 256 && mir_enum_id(native_module, mir_enum_stack_result_type(native_module, function.id)) < 0
			mut candidate := mir_enum_call_candidate(native_module, function, eligible)
			if candidate.size() > 0
				mut rewritten := mir_rewrite_fork(native_module)
				mut expanded := 0
				mut growth := 0
				mut block_growth := 0
				while candidate.size() > 0 && expanded < 8 && module_calls + expanded < 32
					callee := rewritten.functions[candidate[2]]
					size := mir_enum_body_size(rewritten, callee)
					if growth + size > 256 || module_growth + growth + size > 1024 || block_growth + callee.block_count + 1 > 127
						break
					end
					mir_expand_enum_call(rewritten, function_index, candidate[0], candidate[1], callee)
					expanded += 1
					growth += size
					block_growth += callee.block_count + 1
					candidate = mir_enum_call_candidate(rewritten, rewritten.functions[function_index], eligible)
				end
				mut accepted := false
				if expanded > 0 && candidate.size() == 0
					accepted = mir_scalarize_enum_components(rewritten, function_index)
				end
				final_growth := mir_enum_body_size(rewritten, rewritten.functions[function_index]) - original_size
				if final_growth > growth
					growth = final_growth
				end
				if accepted && growth <= 256 && module_growth + growth <= 1024
					mir_rewrite_commit(native_module, rewritten)
					module_calls += expanded
					module_growth += growth
					changed = true
				end
			end
		end
		function_index += 1
	end
	if changed
		mir_refine_call_effects(native_module)
	end
end
