import { emit_qbe } from compiler
import { MirFunction, MirValue } from mir/model/module
import { mir_build_flow, mir_flow_blocks, mir_function_value_groups } from mir/analysis/flow
import { mir_forward_block_values, mir_forward_value_mapping } from mir/passes/forward_values
import { mir_rewrite_function } from mir/passes/rewrite
import { verify_mir } from mir/verify/module
import { array_loop_mir_check } from testing/mir/array_loops
import { control_test_output } from testing/mir/control
import { mir_test_block_with_cell, mir_test_module } from testing/mir/model
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

describe("MIR SSA value forwarding") do
	test("forwards a body parameter but retains a changing loop header") do
		native_module := mir_test_module(false, false)
		function := native_module.functions[0]
		flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		mapping := mir_forward_value_mapping(native_module, function, flow)
		expect(mapping.values.key?("2")).to_be_false()
		expect(mapping.values["5"]).to_equal(2)
	end

	test("checks both parallel branch arguments before forwarding") do
		mut native_module := mir_test_module(false, false)
		branch := native_module.blocks[1]
		native_module.blocks[1] = mir_test_block_with_cell(mir_test_block_with_cell(mir_test_block_with_cell(branch, 10, 12), 13, native_module.arguments.size()), 14, 1)
		# First edge supplies the loop index; the other supplies a different
		# available Integer. Both must participate even with the same target.
		native_module.arguments.push(3)
		function := native_module.functions[0]
		flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		mapping := mir_forward_value_mapping(native_module, function, flow)
		expect(mapping.values.key?("5")).to_be_false()
	end

	test("converges across a forwarding cycle only with an external definition") do
		mut native_module := mir_test_module(false, false)
		# The body forwards the header value instead of incrementing it. The
		# header's initial value then anchors both parameters to one definition.
		native_module.arguments[5] = 5
		function := native_module.functions[0]
		flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		mapping := mir_forward_value_mapping(native_module, function, flow)
		expect(mapping.values["2"]).to_equal(1)
		expect(mapping.values["5"]).to_equal(1)
		# Without an available external anchor the header cannot be removed.
		native_module.arguments[1] = 2
		unanchored := mir_forward_value_mapping(native_module, function, flow)
		expect(unanchored.values.key?("2")).to_be_false()
	end

	test("handles sparse identities without allocating by the maximum ID") do
		mut native_module := mir_test_module(false, false)
		value := native_module.values[5]
		native_module.values[5] = MirValue.new(function_id: value.function_id, id: 9007199254740991, type_id: value.type_id, source_id: value.source_id, line: value.line)
		native_module.arguments[4] = 9007199254740991
		function := native_module.functions[0]
		flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		mapping := mir_forward_value_mapping(native_module, function, flow)
		expect(mapping.values["9007199254740991"]).to_equal(2)
		expect(mapping.values.key?("2")).to_be_false()
	end

	test("requires matching semantic types and an available definition") do
		mut native_module := mir_test_module(false, false)
		value := native_module.values[5]
		native_module.values[5] = MirValue.new(function_id: value.function_id, id: value.id, type_id: 3, source_id: value.source_id, line: value.line)
		function := native_module.functions[0]
		flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		mapping := mir_forward_value_mapping(native_module, function, flow)
		expect(mapping.values.key?("5")).to_be_false()
		native_module.values[5] = value
		native_module.arguments[3] = 8
		late_flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		expect(mir_forward_value_mapping(native_module, function, late_flow).values.key?("5")).to_be_false()
	end

	test("preserves managed values and independently changing nested loop variables") do
		state := array_loop_mir_check("def count(flag: Boolean): Integer\nmut values := [7, 11]\nmut count := 0\nmut outer := 0\nwhile outer < 4\nmut inner := 0\nwhile inner < 3\nif flag\ncount += values[0]\nelse\ncount += values[1]\nend\ninner += 1\nend\nouter += 1\nend\nreturn count\nend\ndef main()\nputs(count(true))\nputs(count(false))\nend\n")
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
			when Result::Ok(actual)
				expect(actual).to_equal("84\n132\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("does not overwrite the original instruction or argument storage") do
		mut native_module := mir_test_module(false, false)
		function := native_module.functions[0]
		native_module.functions[0] = mir_rewrite_function(function, function.block_start, function.block_count)
		# Another function retains independent block rows with the same physical
		# instruction spans. Only the rewritten function may receive new uses.
		start := native_module.blocks.size()
		mut block_index := function.block_start
		while block_index < function.block_start + function.block_count
			native_module.blocks.push(native_module.blocks[block_index])
			block_index += 1
		end
		native_module.functions.push(MirFunction.new(kind: function.kind, result_type: function.result_type, integer_guard: function.integer_guard, id: 2, entry_block: function.entry_block, source_id: function.source_id, line: function.line, parameter_start: function.parameter_start, parameter_count: function.parameter_count, block_start: start, block_count: function.block_count))
		old_instruction := native_module.instructions[3]
		old_argument := native_module.arguments[3]
		expect(mir_forward_block_values(native_module, mir_function_value_groups(native_module))).to_be_true()
		expect(native_module.instructions[3].second).to_equal(old_instruction.second)
		expect(native_module.arguments[3]).to_equal(old_argument)
		body := native_module.blocks[2]
		expect(native_module.instructions[body.instruction_start + 2].first).to_equal(2)
		expect(native_module.instructions[body.instruction_start].failure).to_equal(old_instruction.failure)
		expect(native_module.instructions[body.instruction_start].line).to_equal(old_instruction.line)
	end
end
