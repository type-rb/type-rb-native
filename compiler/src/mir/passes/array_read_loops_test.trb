import { emit_qbe } from compiler
import { mir_build_flow, mir_flow_blocks } from mir/analysis/flow
import { mir_natural_loop } from mir/analysis/loops
import { mir_managed_contains } from mir/analysis/roots
import { mir_op_array_load } from mir/model/instructions
import { MirModule } from mir/model/module
import { optimize_verified_mir } from mir/passes/optimize
import { verify_mir } from mir/verify/module
import { array_loop_mir_check } from testing/mir/array_loops
import { control_test_output } from testing/mir/control
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

def nested_array_read_count(native_module: MirModule): Integer
	function := native_module.functions[0]
	flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
	mut count := 0
	mut member := 0
	while member < function.block_count
		mut depth := 0
		mut header := 0
		while header < function.block_count
			loop := mir_natural_loop(native_module, function, flow, header)
			if loop.preheader >= 0 && mir_managed_contains(loop.members, member)
				depth += 1
			end
			header += 1
		end
		if depth > 1
			block := native_module.blocks[function.block_start + member]
			mut position := block.instruction_start
			while position < block.instruction_start + block.instruction_count
				if native_module.instructions[position].kind == mir_op_array_load()
					count += 1
				end
				position += 1
			end
		end
		member += 1
	end
	return count
end

def nested_array_read_run(source: String, expected: String)
	mut state := array_loop_mir_check(source)
	before := control_test_output(emit_qbe(state))
	intrinsic_mir_erase(state)
	optimize_verified_mir(state.scalar_mir)
	expect(verify_mir(state.scalar_mir, true)).to_equal("")
	expect(control_test_output(emit_qbe(state))).to_equal(before)
	qbe := Process.environment("TYPE_RB_NATIVE_QBE")
	if qbe != nil
		case logical_run_qbe(qbe, before)
		when Result::Ok(actual)
			expect(actual).to_equal(expected)
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
	end
end

describe("MIR nested readonly Array loads") do
	test("moves independently bounded reads and retains empty and zero-trip behavior") do
		definition := "def sum(values: Array<Integer>, rounds: Integer): Integer\nmut index := 0\nmut total := 0\nwhile index < values.size()\nmut round := 0\nwhile round < rounds\ntotal += values[index]\nround += 1\nend\nindex += 1\nend\nreturn total\nend\n"
		state := array_loop_mir_check(definition + "def main()\nend\n")
		expect(nested_array_read_count(state.scalar_mir)).to_equal(0)
		nested_array_read_run(definition + "def main()\nputs(sum([2, 3], 4))\nputs(sum([], 4))\nputs(sum([2, 3], 0))\nputs(sum([2, 3], -1))\nend\n", "20\n0\n0\n0\n")
	end

	test("does not speculate an inner-only bound or changing index") do
		definition := "def sum(values: Array<Integer>, rounds: Integer): Integer\nmut round := 0\nmut total := 0\nwhile round < rounds\nmut index := 0\nwhile index < values.size()\ntotal += values[index]\nindex += 1\nend\nround += 1\nend\nreturn total\nend\n"
		state := array_loop_mir_check(definition + "def main()\nend\n")
		expect(nested_array_read_count(state.scalar_mir) > 0).to_be_true()
		nested_array_read_run(definition + "def main()\nputs(sum([], 2))\nputs(sum([2, 3], 2))\nend\n", "0\n10\n")
		unsafe := "def sum(values: Array<Integer>, rounds: Integer): Integer\nmut index := 0\nmut total := 0\nwhile index < 2\nmut round := 0\nwhile round < rounds\ntotal += values[index]\nround += 1\nend\nindex += 1\nend\nreturn total\nend\n"
		nested_array_read_run(unsafe + "def main()\nputs(sum([], 0))\nputs(sum([], -1))\nend\n", "0\n0\n")
	end

	test("preserves direct writes resize barriers and mutating calls") do
		["values[index] += 1", "values.push(9)", "touch(values)"].each do |barrier|
			definition := "def sum(mut values: Array<Integer>): Integer\nmut index := 0\nmut total := 0\nwhile index < values.size()\nmut round := 0\nwhile round < 2\ntotal += values[index]\n" + barrier + "\nround += 1\nend\nindex += 1\nif index == 1\nbreak\nend\nend\nreturn total\nend\ndef touch(mut values: Array<Integer>)\nvalues[0] += 1\nend\n"
			state := array_loop_mir_check(definition + "def main()\nend\n")
			expect(nested_array_read_count(state.scalar_mir) > 0).to_be_true()
			mut expected := "5\n"
			if barrier == "values.push(9)"
				expected = "4\n"
			end
			nested_array_read_run(definition + "def main()\nputs(sum([2]))\nend\n", expected)
		end
	end

	test("preserves aliases and permits only independently guarded disjoint writes") do
		definition := "def update(left: Array<Integer>, mut right: Array<Integer>): Integer\nmut index := 0\nmut total := 0\nwhile index < left.size()\nmut other := 0\nwhile other < left.size()\nold := left[index]\nright[other] = old + 1\ntotal += left[index]\nother += 1\nend\nindex += 1\nend\nreturn total\nend\n"
		nested_array_read_run(definition + "def main()\nputs(update([2, 3], [0, 0]))\nmut shared := [2, 3]\nputs(update(shared, shared))\nputs(update([], []))\nend\n", "10\n15\n0\n")
	end

	test("retains Float signed zero without changing arithmetic") do
		definition := "def negative(values: Array<Float>, rounds: Integer): Boolean\nmut index := 0\nmut result := false\nwhile index < values.size()\nmut round := 0\nwhile round < rounds\nresult = 1.0 / values[index] < 0.0\nround += 1\nend\nindex += 1\nend\nreturn result\nend\n"
		state := array_loop_mir_check(definition + "def main()\nend\n")
		expect(nested_array_read_count(state.scalar_mir)).to_equal(0)
		nested_array_read_run(definition + "def main()\nputs(negative([-0.0], 3))\nputs(negative([0.0], 3))\nputs(negative([], 3))\nend\n", "true\nfalse\nfalse\n")
	end

	test("keeps short-array failure on the fallback arm") do
		state := array_loop_mir_check("def sum(bound: Array<Integer>, values: Array<Integer>): Integer\nmut index := 0\nmut total := 0\nwhile index < bound.size()\nmut round := 0\nwhile round < 2\ntotal += values[index]\nround += 1\nend\nindex += 1\nend\nreturn total\nend\ndef main()\nputs(sum([1, 2], [3]))\nend\n")
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
			when Result::Ok(_actual)
				expect(false).to_be_true()
			when Result::Err(error)
				expect(error).to_equal("panic: index is out of bounds\n")
			end
		end
	end
end
