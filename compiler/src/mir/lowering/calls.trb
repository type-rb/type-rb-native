import { oidc_adapter_start, oidc_names } from mir/model/oidc_contract
import { standard_oidc_host } from frontend/resolution/oidc_intrinsics
import { crypto_adapter_start, crypto_signature_name } from mir/model/crypto_contract
import { standard_crypto } from frontend/resolution/crypto_intrinsics
import { standard_compression } from frontend/resolution/compression_intrinsics
import { mir_adapter_gzip } from mir/model/call_kinds
import { standard_string_builder } from frontend/resolution/string_builder_intrinsics
import { builder_adapter_start, builder_signature_name } from mir/model/string_builder_contract
import { network_adapter_start, network_names } from mir/model/network_contract
import { standard_network_host } from frontend/resolution/network_intrinsics
import { standard_entropy } from frontend/resolution/secure_random_intrinsics
import { mir_adapter_entropy } from mir/model/call_kinds
import { standard_time_host } from frontend/resolution/time_intrinsics
import { mir_adapter_time_clock, mir_adapter_time_zone_data } from mir/model/call_kinds
import { standard_runtime_fail, standard_runtime_recover } from frontend/resolution/standard_intrinsics
import { checked_category_math, checked_category_value } from frontend/types/value_categories
import { mir_state_enabled_slot } from state/local_slots
import { mir_adapter_host, mir_adapter_none, mir_adapter_runtime_fail, mir_adapter_runtime_recover, mir_signature_compiler_runtime, mir_signature_host, mir_signature_interface, mir_signature_ordinary, mir_signature_standard } from mir/model/call_kinds
import { mir_function_fixture } from mir/model/control
import { mir_op_direct_call } from mir/model/instructions
import { object_abstract_function } from frontend/types/object_types
