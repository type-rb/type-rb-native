import { mir_hash_integer_key } from mir/lowering/hashes
import { mir_semantic_type_id, mir_types_error } from mir/model/types
import { check, emit_qbe } from compiler
import { compiler_test_instruction_with_cell } from testing/compiler
import { control_test_output } from testing/mir/control
import { logical_checked_source } from testing/pipeline
import { logical_run_qbe } from testing/qbe_runner
import { MirType, mir_module_new } from mir/model/module
import { verify_mir } from mir/verify/module
import { managed_mir_test_fixture } from testing/mir/managed
import { array_mir_test_read } from testing/mir/arrays
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

describe("Plain Integer Hash probe ownership") do
	test("specializes the unchanged Integer workload and its reused slot") do
		root := Process.environment("TYPE_RB_NATIVE_ROOT")
		if root != nil
			mut state := logical_checked_source(array_mir_test_read(root + "/benchmarks/features/hash-integer-keys/src/main.trb"))
			expect(check(state)).to_be_true()
			expect(verify_mir(state.scalar_mir, true)).to_equal("")
			text := control_test_output(emit_qbe(state))
			expect(text.include?("call $trbn_hash_existing_slot_integer(")).to_be_false()
			expect(text.include?("call $trbn_hash_slot_integer(")).to_be_true()
			expect(text.include?(" =l copy %hash_membership_")).to_be_true()
			expect(text.include?("call $trbn_hash_get_integer(")).to_be_false()
			expect(state.scalar_mir.hash_lookup_reuse[0].size() > 0).to_be_true()
		end
	end

	test("keeps boxed literal key domains on generic probes") do
		mut state := logical_checked_source("alias Key = 1 | 2\ndef main()\nkey: Key := 1\nmut table: Hash<Key, Integer> := {key => 9}\nputs(table.key?(key))\nputs(table[key])\nend\n")
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		text := control_test_output(emit_qbe(state))
		expect(text.include?("$trbn_hash_slot_integer(")).to_be_false()
		expect(text.include?("call $trbn_hash_get(")).to_be_true()
	end

	test("independently rejects malformed typed read operands and result") do
		mut mutation := 1
		while mutation < 4
			mut state := logical_checked_source("def main()\nmut table: Hash<Integer, String> := {}\ntable[1] = \"kept\"\nputs(table[1])\nend\n")
			expect(check(state)).to_be_true()
			expect(verify_mir(state.scalar_mir, true)).to_equal("")
			mut index := 0
			while state.scalar_mir.instructions[index].kind != 28
				index += 1
			end
			instruction := state.scalar_mir.instructions[index]
			mut invalid := 999999
			if mutation == 1
				invalid = 2
			end
			state.scalar_mir.instructions[index] = compiler_test_instruction_with_cell(instruction, mutation, invalid)
			expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
			mutation += 1
		end
	end

	test("selects only the verified plain Integer key id") do
		mut native_module := mir_module_new()
		integers := mir_semantic_type_id(native_module, "Hash<Integer,Integer>")
		words := mir_semantic_type_id(native_module, "Hash<String,Integer>")
		empty := mir_semantic_type_id(native_module, "Hash")
		expect(mir_types_error(native_module)).to_equal("")
		expect(mir_hash_integer_key(native_module, integers)).to_be_true()
		expect(mir_hash_integer_key(native_module, words)).to_be_false()
		expect(mir_hash_integer_key(native_module, empty)).to_be_false()
		expect(mir_hash_integer_key(native_module, 1)).to_be_false()
		expect(mir_hash_integer_key(native_module, -1)).to_be_false()
		row := native_module.types[integers - 9]
		native_module.types[integers - 9] = MirType.new(kind: row.kind, name: row.name, element: row.element, key: 8, declaration: row.declaration)
		expect(mir_types_error(native_module)).to_equal("MIR composite type identity differs")
	end

	test("emits both typed key families while preserving generic mutation") do
		mut state := logical_checked_source("def main()\nmut integers: Hash<Integer, String> := {}\nintegers[-1] = \"kept\"\nputs(integers.key?(-1))\nputs(integers[-1])\nmut words: Hash<String, Integer> := {}\nwords[\"key\"] = 2\nputs(words.key?(\"key\"))\nputs(words[\"key\"])\nend\n")
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		text := control_test_output(emit_qbe(state))
		expect(text.include?("call $trbn_hash_get_integer(l ")).to_be_true()
		expect(text.include?("call $trbn_hash_contains_integer(l ")).to_be_true()
		expect(text.include?("call $trbn_hash_get_string(l ")).to_be_true()
		expect(text.include?("call $trbn_hash_contains_string(l ")).to_be_true()
		expect(text.include?("call $trbn_hash_set(l ")).to_be_true()
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, text)
			when Result::Ok(actual)
				expect(actual).to_equal("true\nkept\ntrue\n2\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end
end

describe("Plain Integer Hash managed lifetimes") do

	test("hash-integer-boundary-lifetime") do
		managed_mir_test_fixture("hash-integer-boundary-lifetime", 6)
	end
	test("hash-integer-alias-lifetime") do
		managed_mir_test_fixture("hash-integer-alias-lifetime", 6)
	end
	test("hash-integer-recursive-lifetime") do
		managed_mir_test_fixture("hash-integer-recursive-lifetime", 6)
	end
end
