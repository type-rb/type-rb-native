import { mir_range_field_exclusive, mir_range_field_first } from mir/model/operation_modes
import { checked_category_value } from frontend/types/value_categories
import { mir_type_boolean, mir_type_integer } from mir/model/type_ids
import { mir_op_range_field, mir_op_range_new } from mir/model/instructions
import { CheckedValue, checked_mir_value, checked_value, mir_checked_value, scalar_mir_disable, scalar_mir_instruction, scalar_mir_value } from frontend/checking/body/values
import { MirBlock, MirFunction, MirInstruction, MirModule } from mir/model/module
import { mir_control_active, mir_control_prepare } from mir/build/control
import { MirFlow, mir_flow_type, mir_value_available } from mir/analysis/flow
import { mir_semantic_type_id, mir_semantic_type_name } from mir/model/types
import { CompilerState } from state/state
import { CheckedLocals } from state/local_state
import { load_integer } from support/storage

# Range construction captures endpoints and exclusivity; field reads are immutable.
# Iteration uses ordinary verified blocks and scalar comparisons, not source spans.
def mir_checked_range_new(mut state: CompilerState, mut locals: CheckedLocals, first: CheckedValue, last: CheckedValue, exclusive: Integer, origin: Integer): CheckedValue
	mir_control_prepare(state, locals)
	left := checked_mir_value(first)
	right := checked_mir_value(last)
	if left < 0 || right < 0
		scalar_mir_disable(locals)
	end
	if !mir_control_active(locals)
		return checked_value("Range<Integer>", checked_category_value(), origin, 0)
	end
	type_id := mir_semantic_type_id(state.scalar_mir, "Range<Integer>")
	result := scalar_mir_value(state, locals, type_id, origin)
	scalar_mir_instruction(state, locals, mir_op_range_new(), result, left, right, exclusive, -1, load_integer(state.source_tokens.token_lines, origin))
	return mir_checked_value("Range<Integer>", result, origin, 0)
end

def mir_checked_range_field(mut state: CompilerState, mut locals: CheckedLocals, owner: Integer, field: Integer, origin: Integer): CheckedValue
	mut type_name := "Integer"
	mut type_id := mir_type_integer()
	if field == mir_range_field_exclusive()
		type_name = "Boolean"
		type_id = mir_type_boolean()
	end
	if owner < 0
		scalar_mir_disable(locals)
	end
	if !mir_control_active(locals)
		return checked_value(type_name, checked_category_value(), origin, 0)
	end
	result := scalar_mir_value(state, locals, type_id, origin)
	scalar_mir_instruction(state, locals, mir_op_range_field(), result, owner, -1, field, -1, load_integer(state.source_tokens.token_lines, origin))
	return mir_checked_value(type_name, result, origin, 0)
end

def mir_range_instruction_error(flow: MirFlow, native_module: MirModule, function: MirFunction, block: MirBlock, index: Integer, instruction: MirInstruction): String
	result := mir_flow_type(flow, instruction.result)
	first := mir_flow_type(flow, instruction.first)
	if instruction.failure != -1 || !mir_value_available(flow, block, index, instruction.first)
		return "MIR Range owner or endpoint is undefined"
	end
	if instruction.kind == mir_op_range_new()
		if first != mir_type_integer() || mir_flow_type(flow, instruction.second) != mir_type_integer() || !mir_value_available(flow, block, index, instruction.second) || instruction.payload < 0 || instruction.payload > 1 || mir_semantic_type_name(native_module, result) != "Range<Integer>"
			return "MIR Range construction type or shape differs"
		end
		return ""
	end
	if mir_semantic_type_name(native_module, first) != "Range<Integer>" || instruction.second != -1 || instruction.payload < mir_range_field_first() || instruction.payload > mir_range_field_exclusive()
		return "MIR Range component shape differs"
	end
	mut expected := 1
	if instruction.payload == mir_range_field_exclusive()
		expected = 2
	end
	if result != expected
		return "MIR Range component type differs"
	end
	return ""
end
