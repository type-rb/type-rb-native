import { checked_category_value } from frontend/types/value_categories
import { hash_action_copy, hash_action_delete, hash_action_empty, hash_action_fetch, hash_action_has_key, hash_action_keys, hash_action_merge, hash_action_none, hash_action_size, hash_action_update, hash_action_values } from mir/model/hash_actions
import { mir_type_boolean, mir_type_composite_start, mir_type_none } from mir/model/type_ids
import { mir_type_kind_empty_hash, mir_type_kind_none, mir_type_kind_union } from mir/model/type_kinds
import { mir_op_hash_get, mir_op_hash_method, mir_op_hash_new, mir_op_hash_set } from mir/model/instructions
import { hash_key_storage_type } from frontend/types/hash_types
import { mir_nullable_coerce } from mir/lowering/nullable
import { CheckedValue, checked_bound_value, checked_mir_value, checked_value, mir_checked_value, scalar_mir_disable, scalar_mir_instruction, scalar_mir_value } from frontend/checking/body/values
import { mir_hash_capacity } from mir/model/hashes
import { MirBlock, MirFunction, MirIndexedTarget, MirInstruction, MirModule, mir_type_id } from mir/model/module
import { mir_control_active, mir_control_prepare } from mir/build/control
import { MirFlow, mir_flow_type, mir_value_available } from mir/analysis/flow
import { mir_element_type, mir_hash_key_type, mir_hash_kind, mir_hash_value_type, mir_semantic_type_id, mir_semantic_type_name } from mir/model/types
import { CompilerState } from state/state
import { CheckedLocals } from state/local_state
import { load_integer } from support/storage

# 27 allocates a Hash with a verified capacity hint; 28 is required lookup;
# 29 stores payload into owner[key]; 30 carries the existing method identity.
# A store captures the owner and key before checking its RHS, never a slot address.
# Only the canonical nominal Integer key id permits the private read adapter.
# Literal, boxed and unknown keys keep their verified generic representation.
def mir_hash_integer_key(native_module: MirModule, owner: Integer): Boolean
	return mir_hash_key_type(native_module, owner) == mir_type_id("Integer")
end

# Canonical String identity excludes boxed literal unions and unknown keys.
def mir_hash_string_key(native_module: MirModule, owner: Integer): Boolean
	return mir_hash_key_type(native_module, owner) == mir_type_id("String")
end

def mir_hash_key_flags(native_module: MirModule, owner: Integer): Integer
	key := mir_hash_key_type(native_module, owner)
	mut flags := 0
	if hash_key_storage_type(mir_semantic_type_name(native_module, key)) == "String"
		flags = 1
	end
	if key >= mir_type_composite_start() && key - mir_type_composite_start() < native_module.types.size()
		if native_module.types[key - mir_type_composite_start()].kind == mir_type_kind_union()
			flags += 4
		end
	end
	return flags
end

def mir_checked_hash_operation(mut state: CompilerState, mut locals: CheckedLocals, kind: Integer, first: Integer, second: Integer, payload: Integer, type_name: String, origin: Integer): CheckedValue
	mir_control_prepare(state, locals)
	type_id := mir_semantic_type_id(state.scalar_mir, type_name)
	if (type_id == mir_type_none() && type_name != "Void") || (kind != mir_op_hash_new() && first < 0) || ((kind == mir_op_hash_get() || kind == mir_op_hash_set()) && second < 0) || (kind == mir_op_hash_set() && payload < 0)
		scalar_mir_disable(locals)
	end
	mut mutable := 0
	if kind == mir_op_hash_new()
		mutable = 1
	end
	if !mir_control_active(locals)
		return checked_value(type_name, checked_category_value(), origin, mutable)
	end
	mut result := -1
	if type_name != "Void"
		result = scalar_mir_value(state, locals, type_id, origin)
	end
	scalar_mir_instruction(state, locals, kind, result, first, second, payload, -1, load_integer(state.source_tokens.token_lines, origin))
	return mir_checked_value(type_name, result, origin, mutable)
end

def mir_checked_hash_literal(mut state: CompilerState, mut locals: CheckedLocals, type_name: String, value_type: String, origin: Integer, keys: Array<Integer>, values: Array<CheckedValue>): CheckedValue
	mut operands: Array<Integer> := []
	values.each do |value|
		operand := mir_nullable_coerce(state, locals, value, value_type, origin)
		operands.push(checked_mir_value(operand))
	end
	table := mir_checked_hash_operation(state, locals, mir_op_hash_new(), -1, -1, mir_hash_capacity(keys.size()), type_name, origin)
	mut index := 0
	while index < keys.size()
		mir_checked_hash_operation(state, locals, mir_op_hash_set(), checked_mir_value(table), keys[index], operands[index], "Void", origin)
		index += 1
	end
	return table
end

def mir_checked_hash_index(mut state: CompilerState, mut locals: CheckedLocals, receiver: CheckedValue, key: CheckedValue, type_name: String, origin: Integer, assignment: Boolean): CheckedValue
	owner := checked_mir_value(receiver)
	index := checked_mir_value(key)
	if assignment
		locals.mir_targets.push(MirIndexedTarget.new(origin: origin, owner: owner, index: index))
		return checked_bound_value(type_name, checked_category_value(), origin, receiver.mutable, receiver.binding)
	end
	value := mir_checked_hash_operation(state, locals, mir_op_hash_get(), owner, index, 0, type_name, origin)
	return checked_bound_value(type_name, value.category, origin, receiver.mutable, receiver.binding)
end

def mir_checked_hash_store(mut state: CompilerState, mut locals: CheckedLocals, target: CheckedValue, value: CheckedValue, type_name: String, conversion: Integer)
	mut index := locals.mir_targets.size() - 1
	while index >= 0
		row := locals.mir_targets[index]
		if row.origin == target.origin
			if mir_control_active(locals) && row.owner >= 0 && mir_hash_kind(state.scalar_mir, locals.mir_value_rows[row.owner].type_id) == mir_type_kind_empty_hash()
				locals.mir_hash_refinements.push(row.owner)
				locals.mir_hash_refinements.push(mir_semantic_type_id(state.scalar_mir, type_name))
			end
			mir_checked_hash_operation(state, locals, mir_op_hash_set(), row.owner, row.index, checked_mir_value(value), "Void", target.origin)
			if conversion >= 0 && mir_control_active(locals)
				locals.mir_hash_numeric_candidates.push(locals.mir_instructions.size() - 1)
				locals.mir_hash_numeric_candidates.push(conversion)
				locals.mir_hash_numeric_candidates.push(row.owner)
			end
			return
		end
		index -= 1
	end
	scalar_mir_disable(locals)
end

def mir_checked_hash_method(mut state: CompilerState, mut locals: CheckedLocals, receiver: CheckedValue, argument: Integer, method: Integer, result_type: String, origin: Integer): CheckedValue
	if (method == hash_action_has_key() || method == hash_action_delete() || method == hash_action_merge() || method == hash_action_update() || method == hash_action_fetch()) && argument < 0
		scalar_mir_disable(locals)
	end
	owner := checked_mir_value(receiver)
	if method == hash_action_merge()
		# The copied table is an explicit SSA value, rooted across update's
		# allocations. Both authored operands have already been evaluated.
		copy := mir_checked_hash_operation(state, locals, mir_op_hash_method(), owner, -1, 7, result_type, origin)
		mir_checked_hash_operation(state, locals, mir_op_hash_method(), checked_mir_value(copy), argument, 9, "Void", origin)
		return copy
	end
	return mir_checked_hash_operation(state, locals, mir_op_hash_method(), owner, argument, method, result_type, origin)
end

def mir_hash_instruction_error(flow: MirFlow, native_module: MirModule, function: MirFunction, block: MirBlock, index: Integer, instruction: MirInstruction): String
	kind := instruction.kind
	result := mir_flow_type(flow, instruction.result)
	if instruction.failure != -1
		return "MIR Hash failure shape differs"
	end
	if kind == mir_op_hash_new()
		capacity := instruction.payload
		if mir_hash_kind(native_module, result) == mir_type_kind_none() || instruction.first != -1 || instruction.second != -1 || capacity < 0 || capacity > 9007199254740991
			return "MIR Hash construction shape differs"
		end
		if mir_hash_kind(native_module, result) == mir_type_kind_empty_hash() && capacity != 0
			return "MIR empty Hash capacity differs"
		end
		mut reduced := capacity
		while reduced > 8 && reduced % 2 == 0
			reduced /= 2
		end
		if reduced != 0 && reduced != 8
			return "MIR Hash capacity is invalid"
		end
		return ""
	end
	if !mir_value_available(flow, block, index, instruction.first)
		return "MIR Hash owner is undefined"
	end
	owner := mir_flow_type(flow, instruction.first)
	if mir_hash_kind(native_module, owner) == mir_type_kind_none()
		return "MIR Hash owner type differs"
	end
	method := instruction.payload
	if kind == mir_op_hash_method() && (method == hash_action_size() || method == hash_action_empty())
		mut expected := 1
		if method == hash_action_empty()
			expected = 2
		end
		if instruction.second == -1 && result == expected
			return ""
		end
		return "MIR Hash size result differs"
	end
	key := mir_hash_key_type(native_module, owner)
	value := mir_hash_value_type(native_module, owner)
	if key == mir_type_none() || value == mir_type_none()
		return "MIR Hash operation needs concrete key and value types"
	end
	if kind == mir_op_hash_get() || kind == mir_op_hash_set() || (kind == mir_op_hash_method() && (method == hash_action_has_key() || method == hash_action_delete() || method == hash_action_update() || method == hash_action_fetch()))
		if !mir_value_available(flow, block, index, instruction.second)
			return "MIR Hash operand is undefined"
		end
		mut expected := key
		if kind == mir_op_hash_method() && method == hash_action_update()
			expected = owner
		end
		if mir_flow_type(flow, instruction.second) != expected
			return "MIR Hash operand type differs"
		end
	elsif instruction.second != -1
		return "MIR Hash unused operand differs"
	end
	if kind == mir_op_hash_get()
		if method == hash_action_none() && result == value
			return ""
		end
	elsif kind == mir_op_hash_set()
		if !mir_value_available(flow, block, index, instruction.payload)
			return "MIR Hash stored value is undefined"
		end
		if instruction.result == -1 && mir_flow_type(flow, instruction.payload) == value
			return ""
		end
	elsif kind == mir_op_hash_method()
		if (method == hash_action_has_key() && result == mir_type_boolean()) || ((method == hash_action_delete() || method == hash_action_fetch()) && result == value) || (method == hash_action_copy() && result == owner) || (method == hash_action_update() && instruction.result == -1)
			return ""
		end
		if (method == hash_action_keys() && mir_element_type(native_module, result) == key) || (method == hash_action_values() && mir_element_type(native_module, result) == value)
			return ""
		end
	end
	return "MIR Hash method or result differs"
end
