import { mir_type_string } from mir/model/type_ids
import { mir_function_control } from mir/model/control
import { mir_op_array_join, mir_op_array_new, mir_op_array_push, mir_op_string_literal } from mir/model/instructions
import { mir_effect_none } from mir/model/effects
import { MirArrayJoin, MirBlock, MirFunction, MirModule, MirRootPlan, MirValue } from mir/model/module
import { MirFlow, mir_build_flow_with_values, mir_flow_blocks, mir_flow_position, mir_flow_type, mir_value_available } from mir/analysis/flow
import { mir_semantic_type_name } from mir/model/types
import { mir_instruction_effects } from mir/analysis/call_effects
import { mir_live_add, mir_live_before, mir_live_equal } from mir/analysis/roots

# Mechanical plan lookup shared by root lowering and backend consumption.
def mir_array_join_elides(plan: MirArrayJoin, instruction: Integer): Boolean
	if instruction == plan.construction
		return true
	end
	mut index := 0
	while index < plan.appends.size()
		if plan.appends[index] == instruction
			return true
		end
		index += 1
	end
	return false
end

# Only canonical semantic uses count. Include call/capture argument spans and
# terminator arguments, even on unreachable edges or physically reordered blocks.
def mir_array_join_uses_safe(native_module: MirModule, function: MirFunction, plan: MirArrayJoin): Boolean
	mut block_index := function.block_start
	while block_index < function.block_start + function.block_count
		block := native_module.blocks[block_index]
		if block.return_value == plan.array || block.condition == plan.array
			return false
		end
		mut argument := block.first_argument_start
		while argument < block.first_argument_start + block.first_argument_count
			if native_module.arguments[argument] == plan.array
				return false
			end
			argument += 1
		end
		argument = block.second_argument_start
		while argument < block.second_argument_start + block.second_argument_count
			if native_module.arguments[argument] == plan.array
				return false
			end
			argument += 1
		end
		mut index := block.instruction_start
		while index < block.instruction_start + block.instruction_count
			instruction := native_module.instructions[index]
			uses := mir_live_before(native_module, [plan.array], instruction, [])
			if uses.size() > 0 && index != plan.join && !mir_array_join_elides(plan, index)
				return false
			end
			index += 1
		end
		block_index += 1
	end
	return true
end

# All fragments precede construction. Admit an already available separator or
# a static literal defined later in this same block; no allocation is reordered.
def mir_array_join_separator_safe(native_module: MirModule, flow: MirFlow, block: MirBlock, construction: Integer, join: Integer): Boolean
	separator := native_module.instructions[join].second
	if mir_value_available(flow, block, construction, separator)
		return true
	end
	position := mir_flow_position(flow, separator)
	if position > construction && position < join && native_module.instructions[position].kind == mir_op_string_literal()
		return true
	end
	return false
end

def mir_function_array_joins(native_module: MirModule, function: MirFunction, values: Array<MirValue>): Array<MirArrayJoin>
	mut plans: Array<MirArrayJoin> := []
	if function.kind != mir_function_control()
		return plans
	end
	# Avoid constructing CFG/type indexes in functions without a join.
	mut found := false
	mut block_index := function.block_start
	while block_index < function.block_start + function.block_count
		block := native_module.blocks[block_index]
		mut index := block.instruction_start
		while index < block.instruction_start + block.instruction_count
			if native_module.instructions[index].kind == mir_op_array_join()
				found = true
			end
			index += 1
		end
		block_index += 1
	end
	if !found
		return plans
	end
	flow := mir_build_flow_with_values(native_module, function, mir_flow_blocks(native_module, function), values)
	block_index = function.block_start
	while block_index < function.block_start + function.block_count
		block := native_module.blocks[block_index]
		mut construction := block.instruction_start
		while construction < block.instruction_start + block.instruction_count
			array := native_module.instructions[construction]
			if array.kind == mir_op_array_new() && mir_semantic_type_name(native_module, mir_flow_type(flow, array.result)) == "Array<String>"
				mut elements: Array<Integer> := []
				mut appends: Array<Integer> := []
				mut join := -1
				mut index := construction + 1
				while index < block.instruction_start + block.instruction_count
					instruction := native_module.instructions[index]
					if instruction.kind == mir_op_array_join() && instruction.first == array.result
						join = index
						break
					end
					if instruction.kind == mir_op_array_push() && instruction.first == array.result
						if elements.size() >= 4 || mir_flow_type(flow, instruction.second) != mir_type_string() || !mir_value_available(flow, block, construction, instruction.second)
							break
						end
						elements.push(instruction.second)
						appends.push(index)
					elsif mir_instruction_effects(native_module, instruction) != mir_effect_none()
						# Unrelated calls, mutation, allocation and checked failures
						# retain the ordinary container and failure ordering.
						break
					end
					index += 1
				end
				if join >= 0 && mir_array_join_separator_safe(native_module, flow, block, construction, join)
					plan := MirArrayJoin.new(construction: construction, array: array.result, join: join, appends: appends, elements: elements)
					if mir_array_join_uses_safe(native_module, function, plan)
						plans.push(plan)
					end
				end
			end
			construction += 1
		end
		block_index += 1
	end
	# Stable instruction identity, independent of physical block storage order.
	mut index := 1
	while index < plans.size()
		plan := plans[index]
		mut at := index
		while at > 0 && plans[at - 1].construction > plan.construction
			plans[at] = plans[at - 1]
			at -= 1
		end
		plans[at] = plan
		index += 1
	end
	return plans
end

def mir_array_joins_equal(left: Array<MirArrayJoin>, right: Array<MirArrayJoin>): Boolean
	if left.size() != right.size()
		return false
	end
	mut index := 0
	while index < left.size()
		a := left[index]
		b := right[index]
		if a.construction != b.construction || a.array != b.array || a.join != b.join || !mir_live_equal(a.appends, b.appends) || !mir_live_equal(a.elements, b.elements)
			return false
		end
		index += 1
	end
	return true
end

# Canonical liveness sees the Array, including every pre-allocation fragment.
# Remove elided safepoints and replace each remaining live virtual Array with
# its already available String owners. Workspace pointers are never GC roots.
def mir_array_join_roots(ordinary: MirRootPlan, plans: Array<MirArrayJoin>): MirRootPlan
	if plans.size() == 0
		return ordinary
	end
	mut instructions: Array<Integer> := []
	mut roots: Array<Array<Integer>> := []
	mut capacity := 0
	mut index := 0
	while index < ordinary.instructions.size()
		instruction := ordinary.instructions[index]
		mut elided := false
		plans.each do |plan|
			if mir_array_join_elides(plan, instruction)
				elided = true
			end
		end
		if !elided
			mut live: Array<Integer> := []
			ordinary.roots[index].each do |value|
				mut virtual := false
				plans.each do |plan|
					if value == plan.array
						virtual = true
						plan.elements.each do |element|
							mir_live_add(live, element)
						end
					end
				end
				if !virtual
					mir_live_add(live, value)
				end
			end
			instructions.push(instruction)
			roots.push(live)
			if live.size() > capacity
				capacity = live.size()
			end
		end
		index += 1
	end
	return MirRootPlan.new(function_id: ordinary.function_id, instructions: instructions, roots: roots, capacity: capacity)
end
