import { mir_effect_allocation } from mir/model/effects
import { mir_planned_instruction_effects } from mir/analysis/callables
import { mir_managed_type } from mir/model/types
import { integer_string } from support/literals
import { MirBlock, MirFunction, MirInstruction, MirModule, MirRootPlan, MirStringConcat, MirValue, mir_function_index } from mir/model/module
import { mir_flow_blocks } from mir/analysis/flow
import { mir_string_concat_index } from mir/analysis/string_concats

def mir_live_add(mut live: Array<Integer>, value: Integer)
	mut index := 0
	while index < live.size()
		if live[index] == value
			return
		end
		if live[index] > value
			break
		end
		index += 1
	end
	live.push(value)
	mut cursor := live.size() - 1
	while cursor > index
		live[cursor] = live[cursor - 1]
		cursor -= 1
	end
	live[index] = value
end

def mir_live_equal(left: Array<Integer>, right: Array<Integer>): Boolean
	if left.size() != right.size()
		return false
	end
	mut index := 0
	while index < left.size()
		if left[index] != right[index]
			return false
		end
		index += 1
	end
	return true
end

# Sparse MIR IDs need compact membership storage. Snapshot v4 cannot use an
# Integer-keyed Hash here; ordered IDs append cheaply and reordered IDs insert.
def mir_managed_add(mut managed: Array<Integer>, value: Integer)
	if managed.size() == 0 || managed[managed.size() - 1] < value
		managed.push(value)
	else
		mir_live_add(managed, value)
	end
end

def mir_managed_contains(managed: Array<Integer>, value: Integer): Boolean
	mut start := 0
	mut finish := managed.size()
	while start < finish
		middle := start + (finish - start) / 2
		if managed[middle] == value
			return true
		end
		if managed[middle] < value
			start = middle + 1
		else
			finish = middle
		end
	end
	return false
end

def mir_live_operand(managed: Array<Integer>, mut live: Array<Integer>, value: Integer)
	if mir_managed_contains(managed, value)
		mir_live_add(live, value)
	end
end

def mir_live_before(native_module: MirModule, managed: Array<Integer>, instruction: MirInstruction, after: Array<Integer>): Array<Integer>
	mut live: Array<Integer> := []
	after.each do |value|
		if value != instruction.result
			live.push(value)
		end
	end
	kind := instruction.kind
	if kind == 42
		mir_live_operand(managed, live, instruction.first)
		mut index := instruction.payload
		while index < instruction.payload + instruction.second
			mir_live_operand(managed, live, native_module.arguments[index])
			index += 1
		end
	elsif kind == 11
		call := native_module.calls[instruction.payload]
		mut index := call.argument_start
		while index < call.argument_start + call.argument_count
			mir_live_operand(managed, live, native_module.arguments[index])
			index += 1
		end
	elsif kind == 25 || kind == 37 || kind == 41
		mut index := instruction.first
		while index < instruction.first + instruction.second
			mir_live_operand(managed, live, native_module.arguments[index])
			index += 1
		end
	elsif kind != 6 && kind != 12 && kind != 57 && kind != 27
		mir_live_operand(managed, live, instruction.first)
		if kind == 7 || kind == 13 || kind == 14 || kind == 16 || kind >= 21
			mir_live_operand(managed, live, instruction.second)
		end
	end
	if kind == 23 || kind == 29 || kind == 61
		mir_live_operand(managed, live, instruction.payload)
	end
	return live
end

# Only demanded target parameters make their incoming arguments live. Carrying
# every lexical binding on an edge must not retain an otherwise dead object.
def mir_live_edge(native_module: MirModule, function: MirFunction, blocks: Hash<String, Integer>, target: Integer, start: Integer, mut live: Array<Integer>, incoming: Array<Array<Integer>>)
	index := blocks[integer_string(target)]
	block := native_module.blocks[function.block_start + index]
	incoming[index].each do |value|
		mut source := value
		mut parameter := 0
		while parameter < block.parameter_count
			if native_module.arguments[block.parameter_start + parameter] == value
				source = native_module.arguments[start + parameter]
			end
			parameter += 1
		end
		mir_live_add(live, source)
	end
end

def mir_concat_live_before(native_module: MirModule, plans: Array<MirStringConcat>, managed: Array<Integer>, index: Integer, after: Array<Integer>): Array<Integer>
	plan := mir_string_concat_index(plans, index)
	if plan == -1
		return mir_live_before(native_module, managed, native_module.instructions[index], after)
	end
	if plans[plan].fragments.size() == 0
		return after
	end
	mut live: Array<Integer> := []
	after.each do |value|
		if value != native_module.instructions[index].result
			live.push(value)
		end
	end
	plans[plan].fragments.each do |value|
		mir_live_operand(managed, live, value)
	end
	return live
end

def mir_live_exit(native_module: MirModule, function: MirFunction, blocks: Hash<String, Integer>, managed: Array<Integer>, block: MirBlock, incoming: Array<Array<Integer>>): Array<Integer>
	mut live: Array<Integer> := []
	if block.terminator == 1 || block.terminator == 2
		mir_live_edge(native_module, function, blocks, block.first_target, block.first_argument_start, live, incoming)
	end
	if block.terminator == 2
		mir_live_edge(native_module, function, blocks, block.second_target, block.second_argument_start, live, incoming)
	end
	if block.terminator == 3
		mir_live_operand(managed, live, block.return_value)
	end
	return live
end

# Each block transfers (live-out - definitions) union uses. Summarize its
# instructions once; repeated fixed-point steps must not allocate one live set
# per instruction. Parameters stay live here so edges can substitute them.
record MirLiveTransfer
	uses: Array<Integer>
	definitions: Array<Integer>
end

def mir_live_transfer(native_module: MirModule, plans: Array<MirStringConcat>, managed: Array<Integer>, block: MirBlock): MirLiveTransfer
	mut uses: Array<Integer> := []
	mut definitions: Array<Integer> := []
	mut cursor := block.instruction_start + block.instruction_count - 1
	while cursor >= block.instruction_start
		instruction := native_module.instructions[cursor]
		uses = mir_concat_live_before(native_module, plans, managed, cursor, uses)
		mir_live_operand(managed, definitions, instruction.result)
		cursor -= 1
	end
	return MirLiveTransfer.new(uses: uses, definitions: definitions)
end

def mir_live_apply(transfer: MirLiveTransfer, after: Array<Integer>): Array<Integer>
	mut live: Array<Integer> := []
	mut definition := 0
	after.each do |value|
		while definition < transfer.definitions.size() && transfer.definitions[definition] < value
			definition += 1
		end
		if definition == transfer.definitions.size() || transfer.definitions[definition] != value
			live.push(value)
		end
	end
	transfer.uses.each do |value|
		mir_live_add(live, value)
	end
	return live
end

# All blocks participate, including unreachable regions. A changed live-in set
# schedules only predecessors, with both branch edges retained by mir_live_exit.
# Queue storage is bounded by the block count, independent of sparse value IDs.
def mir_live_incoming(native_module: MirModule, function: MirFunction, blocks: Hash<String, Integer>, managed: Array<Integer>): Array<Array<Integer>>
	mut plans: Array<MirStringConcat> := []
	function_index := mir_function_index(native_module, function.id)
	if function_index >= 0 && function_index < native_module.string_concats.size()
		plans = native_module.string_concats[function_index]
	end
	mut incoming: Array<Array<Integer>> := []
	mut predecessors: Array<Array<Integer>> := []
	mut transfers: Array<MirLiveTransfer> := []
	mut pending: Array<Integer> := []
	mut queued: Array<Boolean> := []
	mut index := 0
	while index < function.block_count
		incoming.push([])
		predecessors.push([])
		pending.push(index)
		queued.push(true)
		transfers.push(mir_live_transfer(native_module, plans, managed, native_module.blocks[function.block_start + index]))
		index += 1
	end
	index = 0
	while index < function.block_count
		block := native_module.blocks[function.block_start + index]
		if block.terminator == 1 || block.terminator == 2
			predecessors[blocks[integer_string(block.first_target)]].push(index)
		end
		if block.terminator == 2
			predecessors[blocks[integer_string(block.second_target)]].push(index)
		end
		index += 1
	end
	mut depth := pending.size()
	while depth > 0
		depth -= 1
		index = pending[depth]
		queued[index] = false
		block := native_module.blocks[function.block_start + index]
		live := mir_live_apply(transfers[index], mir_live_exit(native_module, function, blocks, managed, block, incoming))
		if !mir_live_equal(incoming[index], live)
			incoming[index] = live
			predecessors[index].each do |previous|
				if !queued[previous]
					queued[previous] = true
					pending[depth] = previous
					depth += 1
				end
			end
		end
	end
	return incoming
end

# Called only after storage/types/uses are verified. Sparse IDs have no bearing
# on allocation size. The least fixed point includes loop/backedge liveness.
def mir_function_roots_with_values(native_module: MirModule, function: MirFunction, values: Array<MirValue>): MirRootPlan
	mut points: Array<Integer> := []
	mut roots: Array<Array<Integer>> := []
	if function.kind != 3
		return MirRootPlan.new(function_id: function.id, instructions: points, roots: roots, capacity: 0)
	end
	blocks := mir_flow_blocks(native_module, function)
	mut concats: Array<MirStringConcat> := []
	function_index := mir_function_index(native_module, function.id)
	if function_index >= 0 && function_index < native_module.string_concats.size()
		concats = native_module.string_concats[function_index]
	end
	mut managed: Array<Integer> := []
	mut managed_count := 0
	values.each do |value|
		if value.function_id == function.id && mir_managed_type(native_module, value.type_id)
			mir_managed_add(managed, value.id)
			managed_count += 1
		end
	end
	mut incoming: Array<Array<Integer>> := []
	if managed_count > 0
		incoming = mir_live_incoming(native_module, function, blocks, managed)
	else
		mut index := 0
		while index < function.block_count
			incoming.push([])
			index += 1
		end
	end
	mut capacity := 0
	mut index := 0
	while index < function.block_count
		block := native_module.blocks[function.block_start + index]
		mut live := mir_live_exit(native_module, function, blocks, managed, block, incoming)
		mut cursor := block.instruction_start + block.instruction_count - 1
		while cursor >= block.instruction_start
			instruction := native_module.instructions[cursor]
			if managed_count > 0
				live = mir_concat_live_before(native_module, concats, managed, cursor, live)
			end
			concat := mir_string_concat_index(concats, cursor)
			mut skipped := false
			if concat >= 0
				skipped = concats[concat].fragments.size() == 0
			end
			# Allocation is the least significant effect bit; modulo 2 selects it.
			if !skipped && mir_planned_instruction_effects(native_module, instruction, cursor) % 2 == mir_effect_allocation()
				if managed_count == 0
					# Retained empty root lists must remain independent between points.
					live = []
				end
				if live.size() > capacity
					capacity = live.size()
				end
				# Sorting by instruction identity keeps plans stable when a pass
				# reorders physical block storage without changing the graph.
				points.push(cursor)
				roots.push(live)
				mut at := points.size() - 1
				while at > 0 && points[at - 1] > cursor
					points[at] = points[at - 1]
					roots[at] = roots[at - 1]
					at -= 1
				end
				points[at] = cursor
				roots[at] = live
			end
			cursor -= 1
		end
		index += 1
	end
	return MirRootPlan.new(function_id: function.id, instructions: points, roots: roots, capacity: capacity)
end

def mir_function_roots(native_module: MirModule, function: MirFunction): MirRootPlan
	mut values: Array<MirValue> := []
	native_module.values.each do |value|
		if value.function_id == function.id
			values.push(value)
		end
	end
	return mir_function_roots_with_values(native_module, function, values)
end

def mir_root_plan_equal(left: MirRootPlan, right: MirRootPlan): Boolean
	if left.function_id != right.function_id || left.capacity != right.capacity
		return false
	end
	if !mir_live_equal(left.instructions, right.instructions) || left.roots.size() != right.roots.size()
		return false
	end
	mut index := 0
	while index < left.roots.size()
		if !mir_live_equal(left.roots[index], right.roots[index])
			return false
		end
		index += 1
	end
	return true
end
