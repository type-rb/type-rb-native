import { emit_qbe } from compiler
import { mir_build_flow, mir_flow_blocks } from mir/analysis/flow
import { mir_natural_loop } from mir/analysis/loops
import { mir_array_loops_equal } from mir/analysis/array_loops
import { MirModule } from mir/model/module
import { optimize_verified_mir } from mir/passes/optimize
import { verify_mir } from mir/verify/module
import { array_loop_mir_check } from testing/mir/array_loops
import { control_test_output } from testing/mir/control
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

def dominating_header_outer_owners(native_module: MirModule): Integer
	function := native_module.functions[0]
	flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
	mut largest := 0
	mut outer := -1
	mut index := 0
	while index < function.block_count
		loop := mir_natural_loop(native_module, function, flow, index)
		if loop.members.size() > largest
			largest = loop.members.size()
			outer = native_module.blocks[function.block_start + index].id
		end
		index += 1
	end
	expect(outer >= 0).to_be_true()
	mut owners := 0
	native_module.array_loops[0].each do |plan|
		if plan.header == outer
			owners = plan.headers.size()
		end
	end
	return owners
end

describe("MIR dominating Array header owners") do
	test("retains record fields across the empty preheader of a versioned outer loop") do
		mut state := array_loop_mir_check("record Buffers\nvalues: Array<Integer>\nother: Array<Integer>\nend\ndef update(buffers: Buffers, rounds: Integer): Integer\nmut round := 0\nwhile round < rounds\nmut values := buffers.values\nother := buffers.other\nmut index := 0\nwhile index < values.size()\nvalues[index] += other[index]\nindex += 1\nend\nround += 1\nend\nreturn buffers.values.size()\nend\ndef main()\nmut values := [3000, 4000]\nmut other := [7, 11]\nputs(update(Buffers.new(values: values, other: other), 2))\nputs(values[0])\nputs(values[1])\nputs(update(Buffers.new(values: [], other: []), 0))\nputs(update(Buffers.new(values: [], other: []), 2))\nputs(update(Buffers.new(values: values, other: values), 1))\nputs(values[0])\nend\n")
		function := state.scalar_mir.functions[0]
		expect(dominating_header_outer_owners(state.scalar_mir)).to_equal(2)
		before := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		optimize_verified_mir(state.scalar_mir)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		plans := state.scalar_mir.array_loops[0]
		mut left := function.block_start
		mut right := left + function.block_count - 1
		while left < right
			saved := state.scalar_mir.blocks[left]
			state.scalar_mir.blocks[left] = state.scalar_mir.blocks[right]
			state.scalar_mir.blocks[right] = saved
			left += 1
			right -= 1
		end
		optimize_verified_mir(state.scalar_mir)
		expect(mir_array_loops_equal(plans, state.scalar_mir.array_loops[0])).to_be_true()
		state.scalar_mir.array_loops[0][0].headers[0].accesses.pop()
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR Array-loop plan differs")
		optimize_verified_mir(state.scalar_mir)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
			when Result::Ok(actual)
				expect(actual).to_equal("2\n3014\n4022\n0\n0\n2\n6028\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("rejects resizing a dominating field through either direct mutation or a call") do
		["values.pop()", "touch(values)"].each do |mutation|
			state := array_loop_mir_check("record Box\nvalues: Array<Integer>\nend\ndef update(box: Box, rounds: Integer): Integer\nmut total := 0\nmut round := 0\nwhile round < rounds\nmut values := box.values\n" + mutation + "\nmut index := 0\nwhile index < values.size()\ntotal += values[index]\nindex += 1\nend\nround += 1\nend\nreturn total\nend\ndef touch(mut values: Array<Integer>)\nvalues.pop()\nend\ndef main()\nend\n")
			expect(dominating_header_outer_owners(state.scalar_mir)).to_equal(0)
		end
	end

	test("does not move a changing receiver's Array to its outer entry") do
		state := array_loop_mir_check("record Box\nvalues: Array<Integer>\nend\ndef sum(mut first: Box, mut second: Box, rounds: Integer): Integer\nmut active := first\nmut total := 0\nmut round := 0\nwhile round < rounds\nvalues := active.values\nmut index := 0\nwhile index < values.size()\ntotal += values[index]\nindex += 1\nend\nactive = second\nround += 1\nend\nreturn total\nend\ndef main()\nputs(sum(Box.new(values: [3000]), Box.new(values: [4000, 5000]), 2))\nputs(sum(Box.new(values: []), Box.new(values: []), 0))\nend\n")
		expect(dominating_header_outer_owners(state.scalar_mir)).to_equal(0)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
			when Result::Ok(actual)
				expect(actual).to_equal("12000\n0\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end
end
