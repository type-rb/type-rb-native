import { mir_op_object_copy, mir_op_object_identity } from mir/model/instructions
import { mir_array_mutate_unshift, mir_convert_boolean_to_string, mir_convert_float_to_string, mir_convert_integer_to_string, mir_puts_any_mode } from mir/model/operation_modes
import { hash_action_copy, hash_action_delete, hash_action_fetch, hash_action_keys, hash_action_update, hash_action_values } from mir/model/hash_actions
import { mir_adapter_runtime_fail, mir_adapter_sqrt, mir_signature_ordinary, mir_signature_standard } from mir/model/call_kinds
import { mir_function_control, mir_function_scalar, mir_terminator_jump, mir_terminator_trap } from mir/model/control
import { mir_op_array_copy, mir_op_array_join, mir_op_array_load, mir_op_array_mutate, mir_op_array_new, mir_op_array_position, mir_op_array_push, mir_op_array_store, mir_op_bytes_at, mir_op_bytes_concat, mir_op_bytes_to_string, mir_op_callable_new, mir_op_direct_call, mir_op_enum_field, mir_op_enum_new, mir_op_global_read, mir_op_global_write, mir_op_hash_get, mir_op_hash_method, mir_op_hash_new, mir_op_hash_set, mir_op_indirect_call, mir_op_nullable_extract, mir_op_nullable_inject, mir_op_object_convert, mir_op_object_new, mir_op_object_store, mir_op_puts, mir_op_range_new, mir_op_record_new, mir_op_scalar_conversion, mir_op_scalar_literal, mir_op_string_case, mir_op_string_concat, mir_op_string_index, mir_op_string_sequence, mir_op_string_slice, mir_op_string_split, mir_op_string_trim, mir_op_union_extract, mir_op_union_inject } from mir/model/instructions
import { mir_effect_allocation_failure, mir_effect_allocation_io_failure, mir_effect_allocation_mutation_failure, mir_effect_conservative, mir_effect_failure, mir_effect_io_failure, mir_effect_mutation, mir_effect_mutation_failure, mir_effect_none } from mir/model/effects
import { MirCall, MirFunction, MirInstruction, MirModule, MirSignature, mir_function_index, mir_table_span_valid } from mir/model/module

# Effects are allocation, mutation, I/O and failure bits. Runtime-internal
# terminal failures stay with their operation; they never resume a MIR edge.
def mir_instruction_effects(native_module: MirModule, instruction: MirInstruction): Integer
	kind := instruction.kind
	if kind == mir_op_bytes_concat() || kind == mir_op_bytes_to_string()
		return mir_effect_allocation_failure()
	end
	if kind == mir_op_bytes_at()
		return mir_effect_failure()
	end
	if kind >= mir_op_string_split() && kind <= mir_op_string_case()
		return mir_effect_allocation_failure()
	end
	if kind == mir_op_object_store()
		return mir_effect_mutation()
	end
	if kind == mir_op_global_write()
		return mir_effect_mutation_failure()
	end
	if kind == mir_op_array_mutate()
		if instruction.payload == mir_array_mutate_unshift()
			return mir_effect_allocation_mutation_failure()
		end
		return mir_effect_mutation_failure()
	end
	if kind == mir_op_callable_new() || kind == mir_op_string_sequence() || kind == mir_op_string_slice() || kind == mir_op_array_copy() || kind == mir_op_array_join() || kind == mir_op_string_trim()
		return mir_effect_allocation_failure()
	end
	if kind == mir_op_indirect_call()
		return mir_effect_conservative()
	end
	if kind == mir_op_nullable_inject() || kind == mir_op_enum_new() || kind == mir_op_union_inject()
		return mir_effect_allocation_failure()
	end
	if kind == mir_op_nullable_extract() || kind == mir_op_enum_field() || kind == mir_op_global_read() || kind == mir_op_union_extract()
		return mir_effect_failure()
	end
	if kind == mir_op_array_new() || kind == mir_op_record_new() || kind == mir_op_hash_new() || kind == mir_op_range_new() || kind == mir_op_object_new() || kind == mir_op_object_convert() || kind == mir_op_object_copy()
		return mir_effect_allocation_failure()
	end
	if kind == mir_op_hash_get()
		return mir_effect_failure()
	end
	if kind == mir_op_hash_method()
		method := instruction.payload
		if method == hash_action_delete() || method == hash_action_update()
			return mir_effect_allocation_mutation_failure()
		end
		if method == hash_action_copy() || method == hash_action_keys() || method == hash_action_values()
			return mir_effect_allocation_failure()
		end
		if method == hash_action_fetch()
			return mir_effect_failure()
		end
	end
	if kind == mir_op_array_push() || kind == mir_op_hash_set()
		return mir_effect_allocation_mutation_failure()
	end
	if kind == mir_op_array_position() || kind == mir_op_array_load()
		return mir_effect_failure()
	end
	if kind == mir_op_array_store()
		return mir_effect_mutation_failure()
	end
	if kind == mir_op_direct_call()
		return native_module.calls[instruction.payload].effects
	end
	if kind == mir_op_string_concat() || kind == mir_op_string_index() || (kind == mir_op_scalar_conversion() && (instruction.payload == mir_convert_integer_to_string() || instruction.payload == mir_convert_float_to_string()))
		return mir_effect_allocation_failure()
	end
	if kind == mir_op_scalar_conversion() && instruction.payload == mir_convert_boolean_to_string()
		return mir_effect_none()
	end
	if kind == mir_op_scalar_conversion() || instruction.failure >= 0
		return mir_effect_failure()
	end
	if kind == mir_op_puts()
		if instruction.payload == mir_puts_any_mode()
			return mir_effect_allocation_io_failure()
		end
		return mir_effect_io_failure()
	end
	return mir_effect_none()
end

# Declarations without an inspected ordinary body stay conservative. Only the
# independently verified standard math adapter has no effects by contract.
def mir_call_effects(signature: MirSignature): Integer
	if signature.kind == mir_signature_standard() && signature.adapter == mir_adapter_sqrt()
		return mir_effect_none()
	end
	if signature.kind == mir_signature_standard() && signature.adapter == mir_adapter_runtime_fail()
		return mir_effect_io_failure()
	end
	return mir_effect_conservative()
end

# Read local effects once and retain reverse dependencies for direct calls.
# Reaching the conservative class needs no further traversal of this body.
def mir_body_call_effects(native_module: MirModule, function: MirFunction, caller: Integer, mut callers: Array<Array<Integer>>): Integer
	if function.kind == mir_function_scalar()
		# Scalar adapters already have a checked no-allocation contract.
		return mir_effect_failure()
	end
	if function.kind != mir_function_control() || function.block_count < 1 || !mir_table_span_valid(function.block_start, function.block_count, native_module.blocks.size())
		return mir_effect_conservative()
	end
	mut local := mir_effect_none()
	mut block_index := function.block_start
	while block_index < function.block_start + function.block_count
		block := native_module.blocks[block_index]
		if block.terminator < mir_terminator_jump() || block.terminator > mir_terminator_trap() || !mir_table_span_valid(block.instruction_start, block.instruction_count, native_module.instructions.size())
			return mir_effect_conservative()
		end
		if block.terminator == mir_terminator_trap()
			local = mir_effect_failure()
		end
		mut position := block.instruction_start
		while position < block.instruction_start + block.instruction_count
			instruction := native_module.instructions[position]
			mut observed := mir_effect_conservative()
			if instruction.kind == mir_op_direct_call()
				if instruction.payload < 0 || instruction.payload >= native_module.calls.size()
					return mir_effect_conservative()
				end
				callee := native_module.calls[instruction.payload].callee
				if callee < 0 || callee >= callers.size()
					return mir_effect_conservative()
				end
				# Ignore the stored effects, including on recursive edges.
				mut incoming := callers[callee]
				incoming.push(caller)
				observed = mir_effect_none()
			elsif instruction.kind >= mir_op_scalar_literal() && instruction.kind <= mir_op_object_identity()
				observed = mir_instruction_effects(native_module, instruction)
			end
			if observed != mir_effect_none() && observed != mir_effect_failure()
				return mir_effect_conservative()
			end
			if observed == mir_effect_failure()
				local = mir_effect_failure()
			end
			position += 1
		end
		block_index += 1
	end
	return local
end

# This three-element lattice preserves failure while grouping allocation,
# mutation, I/O and unknown behavior into the existing conservative class.
# Summaries belong to this invocation, never to caller-supplied MIR metadata.
def mir_call_effect_summaries(native_module: MirModule): Array<Integer>
	mut effects: Array<Integer> := []
	mut callers: Array<Array<Integer>> := []
	mut index := 0
	while index < native_module.signatures.size()
		effects.push(mir_call_effects(native_module.signatures[index]))
		callers.push([])
		index += 1
	end
	index = 0
	while index < native_module.signatures.size()
		signature := native_module.signatures[index]
		if signature.kind == mir_signature_ordinary()
			body_index := mir_function_index(native_module, signature.id)
			if body_index >= 0
				effects[index] = mir_body_call_effects(native_module, native_module.functions[body_index], index, callers)
			end
		end
		index += 1
	end
	# Each summary can increase only twice (0 -> 8 -> 15). Propagating changes
	# over reverse edges terminates for cycles without a call-depth heuristic.
	mut pending: Array<Integer> := []
	index = 0
	while index < effects.size()
		if effects[index] > mir_effect_none()
			pending.push(index)
		end
		index += 1
	end
	index = 0
	while index < pending.size()
		callee := pending[index]
		callers[callee].each do |caller|
			if effects[callee] > effects[caller]
				effects[caller] = effects[callee]
				pending.push(caller)
			end
		end
		index += 1
	end
	return effects
end

def mir_refine_call_effects(mut native_module: MirModule)
	effects := mir_call_effect_summaries(native_module)
	mut index := 0
	while index < native_module.calls.size()
		call := native_module.calls[index]
		if call.callee >= 0 && call.callee < effects.size()
			if effects[call.callee] != call.effects
				native_module.calls[index] = MirCall.new(callee: call.callee, argument_start: call.argument_start, argument_count: call.argument_count, effects: effects[call.callee])
			end
		end
		index += 1
	end
end
