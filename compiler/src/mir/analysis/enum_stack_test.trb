import { check, emit_qbe } from compiler
import { lex } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { resolve } from frontend/checking/program/resolution
import { compiler_new, has_diagnostic } from state/state
import { optimize_verified_mir } from mir/passes/optimize
import { object_execution_state } from testing/objects
import { store_string } from support/storage
import { string_starts_with } from support/path
import { logical_run_qbe } from testing/qbe_runner
import { control_test_output } from testing/mir/control
import { verify_mir } from mir/verify/module
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

describe("MIR borrowed mixed enum") do
	test("returns payload and payloadless variants through safe direct arguments") do
		source := "enum Command\nAdd(amount: Integer)\nReset\nend\ndef command(index: Integer): Command\nif index == 0\nreturn Command::Reset\nend\nreturn Command::Add(index)\nend\ndef step(next: Command): Integer\ncase next\nwhen Command::Add(amount)\nreturn amount\nwhen Command::Reset\nreturn 0\nend\nend\ndef main()\nputs(step(command(0)))\nputs(step(command(7)))\nend\n"
		mut state := compiler_new(source.size() * 3 + 16)
		expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state) && check(state)).to_be_true()
		mut command_id := -1
		state.scalar_mir.signatures.each.with_index do |signature, index|
			if signature.name == "command"
				command_id = index
			end
		end
		expect(command_id >= 0).to_be_true()
		expect(state.scalar_mir.enum_stack_functions[command_id]).to_equal(1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		qbe := control_test_output(emit_qbe(state))
		expect(qbe.include?("%enum_slot")).to_be_true()
		expect(qbe.include?("=l copy $trbn_static_enum")).to_be_false()
		qbe_binary := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_binary != nil
			mut forced := ""
			mut ordinary := false
			qbe.split("\n").each do |line|
				if line.start_with?("function ")
					ordinary = line.include?("$trbnf")
				end
				if line == "}"
					ordinary = false
				end
				forced += line + "\n"
				if ordinary && line.include?("call $trbnf")
					forced += "\tcall $trbn_gc_collect(w 0)\n"
				end
			end
			case logical_run_qbe(qbe_binary, forced)
			when Result::Ok(actual)
				expect(actual).to_equal("0\n7\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
		state.scalar_mir.enum_stack_functions[command_id] = 0
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR enum stack plan differs")
	end

	test("preserves scalar Float payload bits across borrowed calls") do
		source := "enum Token\nFloatValue(value: Float)\nEmpty\nend\ndef make(present: Boolean): Token\nif present\nreturn Token::FloatValue(3.5)\nend\nreturn Token::Empty\nend\ndef read(token: Token): Integer\ncase token\nwhen Token::FloatValue(value)\nreturn value.to_i()\nwhen Token::Empty\nreturn 0\nend\nend\ndef main()\nputs(read(make(true)))\nputs(read(make(false)))\nend\n"
		mut state := compiler_new(source.size() * 3 + 16)
		expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state) && check(state)).to_be_true()
		mut make_id := -1
		state.scalar_mir.signatures.each.with_index do |signature, index|
			if signature.name == "make"
				make_id = index
			end
		end
		expect(make_id >= 0).to_be_true()
		expect(state.scalar_mir.enum_stack_functions[make_id]).to_equal(1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		qbe_binary := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_binary != nil
			case logical_run_qbe(qbe_binary, control_test_output(emit_qbe(state)))
			when Result::Ok(actual)
				expect(actual).to_equal("3\n0\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("keeps escaped, indirect, recursive and managed enum values boxed") do
		base := "enum Command\nAdd(amount: Integer)\nReset\nend\ndef command(index: Integer): Command\nif index == 0\nreturn Command::Reset\nend\nreturn Command::Add(index)\nend\n"
		sources := [
			base + "def save(): Array<Command>\nreturn [command(1)]\nend\ndef main()\nputs(save().size())\nend\n",
			base + "def consume(value: Command): Integer\ncase value\nwhen Command::Add(amount)\nreturn amount\nwhen Command::Reset\nreturn 0\nend\nend\ndef main()\ncallback := command\nputs(consume(callback(1)))\nend\n",
			base + "def forward(value: Command): Command\nreturn value\nend\ndef main()\ncase forward(command(1))\nwhen Command::Add(amount)\nputs(amount)\nwhen Command::Reset\nputs(0)\nend\nend\n",
			base + "def consume(value: Command): Integer\nif true\nitems := [value]\nreturn items.size()\nend\nreturn 0\nend\ndef main()\nputs(consume(command(1)))\nend\n",
			"enum Command\nAdd(amount: Integer)\nReset\nend\ndef command(index: Integer): Command\nif index > 0\nreturn command(index - 1)\nend\nreturn Command::Add(0)\nend\ndef main()\ncase command(2)\nwhen Command::Add(amount)\nputs(amount)\nwhen Command::Reset\nputs(0)\nend\nend\n",
			"enum Message\nText(value: String)\nReset\nend\ndef command(index: Integer): Message\nif index == 0\nreturn Message::Reset\nend\nreturn Message::Text(\"payload\")\nend\ndef consume(value: Message): String\ncase value\nwhen Message::Text(text)\nputs(\"safe\" + \"point\")\nreturn text\nwhen Message::Reset\nreturn \"none\"\nend\nend\ndef main()\nputs(consume(command(1)))\nend\n",
			"enum Command\nPair(left: Integer, right: Integer)\nReset\nend\ndef command(index: Integer): Command\nif index == 0\nreturn Command::Reset\nend\nreturn Command::Pair(index, index + 1)\nend\ndef main()\ncase command(1)\nwhen Command::Pair(left, right)\nputs(left + right)\nwhen Command::Reset\nputs(0)\nend\nend\n",
		]
		mut index := 0
		sources.each do |source|
			mut state := compiler_new(source.size() * 3 + 16)
			valid := lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state) && check(state)
			if !valid
				puts(index)
			end
			expect(valid).to_be_true()
			if valid
				mut command_id := -1
				state.scalar_mir.signatures.each.with_index do |signature, candidate|
					if signature.name == "command"
						command_id = candidate
					end
				end
				expect(command_id >= 0).to_be_true()
				expect(state.scalar_mir.enum_stack_functions[command_id]).to_equal(0)
				expect(verify_mir(state.scalar_mir, true)).to_equal("")
				if index == 5
					# The managed payload remains reachable from the boxed enum at
					# the caller's real safe point before the direct call.
					mut consume_id := -1
					state.scalar_mir.signatures.each.with_index do |signature, candidate|
						if signature.name == "consume"
							consume_id = candidate
						end
					end
					expect(consume_id >= 0).to_be_true()
					qbe_binary := Process.environment("TYPE_RB_NATIVE_QBE")
					if qbe_binary != nil
						mut forced := ""
						mut ordinary := false
						control_test_output(emit_qbe(state)).split("\n").each do |line|
							if line.start_with?("function ")
								ordinary = line.include?("$trbnf")
							end
							if line == "}"
								ordinary = false
							end
							if ordinary && line.include?("call $trbnf" + consume_id.to_s() + "(")
								forced += "\tcall $trbn_gc_collect(w 0)\n"
							end
							forced += line + "\n"
						end
						case logical_run_qbe(qbe_binary, forced)
						when Result::Ok(actual)
							expect(actual).to_equal("safepoint\npayload\n")
						when Result::Err(error)
							puts(error)
							expect(false).to_be_true()
						end
					end
				end
				state.scalar_mir.enum_stack_functions[command_id] = 1
				expect(verify_mir(state.scalar_mir, true)).to_equal("MIR enum stack plan differs")
			end
			index += 1
		end
		# Fieldful enum equality is rejected by the checker, so a borrowed
		# caller slot cannot become observable through this source operation.
		identity_source := base + "def main()\nputs(command(1) == command(1))\nend\n"
		mut identity := compiler_new(identity_source.size() * 3 + 16)
		expect(lex(identity, identity_source) && parse_module(identity, 0, identity.module_graph.entry_module[0]) && resolve(identity)).to_be_true()
		expect(check(identity)).to_be_false()
	end
end

def interface_enum_return_control(source: String, expected: String, minimum_hooks: Integer)
	mut state := object_execution_state(source)
	mut methods := 0
	state.scalar_mir.object_witnesses.each do |witness|
		witness.methods.each do |index|
			function_id := state.scalar_mir.object_methods[index].function
			expect(state.scalar_mir.enum_stack_functions[function_id]).to_equal(0)
			state.scalar_mir.enum_stack_functions[function_id] = 1
			expect(verify_mir(state.scalar_mir, true)).to_equal("MIR enum stack plan differs")
			state.scalar_mir.enum_stack_functions[function_id] = 0
			methods += 1
		end
	end
	expect(methods >= 2).to_be_true()
	expect(verify_mir(state.scalar_mir, true)).to_equal("")
	before := control_test_output(emit_qbe(state))
	mut origin := 0
	while origin < state.source_tokens.token_count[0]
		store_string(state.source_tokens.token_texts, origin, "erased")
		origin += 1
	end
	while state.nominal.objects.size() > 0
		state.nominal.objects.pop()
	end
	while state.nominal.object_instances.size() > 0
		state.nominal.object_instances.pop()
	end
	while state.type_resolution.generic_functions.size() > 0
		state.type_resolution.generic_functions.pop()
	end
	while state.type_resolution.generic_function_instances.size() > 0
		state.type_resolution.generic_function_instances.pop()
	end
	expect(control_test_output(emit_qbe(state))).to_equal(before)
	mut left := 0
	mut right := state.scalar_mir.functions.size() - 1
	while left < right
		saved := state.scalar_mir.functions[left]
		state.scalar_mir.functions[left] = state.scalar_mir.functions[right]
		state.scalar_mir.functions[right] = saved
		roots := state.scalar_mir.root_plans[left]
		state.scalar_mir.root_plans[left] = state.scalar_mir.root_plans[right]
		state.scalar_mir.root_plans[right] = roots
		loops := state.scalar_mir.array_loops[left]
		state.scalar_mir.array_loops[left] = state.scalar_mir.array_loops[right]
		state.scalar_mir.array_loops[right] = loops
		reuse := state.scalar_mir.array_check_reuse[left]
		state.scalar_mir.array_check_reuse[left] = state.scalar_mir.array_check_reuse[right]
		state.scalar_mir.array_check_reuse[right] = reuse
		left += 1
		right -= 1
	end
	state.scalar_mir.functions.each do |function|
		mut start := function.block_start
		mut finish := start + function.block_count - 1
		while start < finish
			saved := state.scalar_mir.blocks[start]
			state.scalar_mir.blocks[start] = state.scalar_mir.blocks[finish]
			state.scalar_mir.blocks[finish] = saved
			start += 1
			finish -= 1
		end
	end
	expect(verify_mir(state.scalar_mir, true)).to_equal("")
	optimize_verified_mir(state.scalar_mir)
	expect(verify_mir(state.scalar_mir, true)).to_equal("")
	emitted := control_test_output(emit_qbe(state))
	expect(emitted.include?(" =l loadl ")).to_be_true()
	expect(has_diagnostic(state)).to_be_false()
	qbe := Process.environment("TYPE_RB_NATIVE_QBE")
	if qbe != nil
		mut forced := ""
		mut ordinary := false
		mut hooks := 0
		mut indirect := 0
		emitted.split("\n").each do |line|
			if string_starts_with(line, "function ")
				ordinary = line.include?("$trbnf")
			end
			if line == "}"
				ordinary = false
			end
			allocates := line.include?("call $trbn_gc_alloc(") || line.include?("call $trbn_array_new(") || line.include?("call $trbn_array_push_") || line.include?("call $trbn_string_concat(") || line.include?("call $trbnf")
			if ordinary && (allocates || line.include?("call %"))
				forced += "\tcall $trbn_gc_collect(w 0)\n"
				hooks += 1
				if line.include?("call %")
					indirect += 1
				end
			end
			forced += line + "\n"
		end
		expect(hooks >= minimum_hooks).to_be_true()
		expect(indirect > 0).to_be_true()
		puts("interface Enum collection hooks: " + hooks.to_s())
		case logical_run_qbe(qbe, forced)
		when Result::Ok(actual)
			expect(actual).to_equal(expected)
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
	end
end

describe("MIR interface Enum return") do
	test("preserves original-managed after erasure reorder reoptimization and real GC") do
		interface_enum_return_control("enum Response\nValue(text: String)\nend\ninterface Reader\nread(depth: Integer): Response\nend\nclass First implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nreturn Response::Value(held)\nend\nend\nclass Second implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nreturn Response::Value(held)\nend\nend\ndef main()\nitems: Array<Reader> := [First.new(\"left\"), Second.new(\"right\")]\nmut retained: Array<String> := [\"he\" + \"ld\"]\nitems.each do |item|\ncase item.read(0)\nwhen Response::Value(value)\nputs(value)\nend\nretained.push(\"kee\" + \"p\")\nend\nputs(retained[0])\nend\n", "left!\nright!\nheld\n", 18)
	end

	test("preserves integer after erasure reorder reoptimization and real GC") do
		interface_enum_return_control("enum Response\nValue(number: Integer)\nend\ninterface Reader\nread(depth: Integer): Response\nend\nclass First implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nreturn Response::Value(held.size())\nend\nend\nclass Second implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nreturn Response::Value(held.size())\nend\nend\ndef main()\nitems: Array<Reader> := [First.new(\"left\"), Second.new(\"right\")]\nmut retained: Array<String> := [\"he\" + \"ld\"]\nitems.each do |item|\ncase item.read(0)\nwhen Response::Value(value)\nputs(value)\nend\nretained.push(\"kee\" + \"p\")\nend\nputs(retained[0])\nend\n", "5\n6\nheld\n", 6)
	end

	test("preserves float after erasure reorder reoptimization and real GC") do
		interface_enum_return_control("enum Response\nValue(number: Float)\nend\ninterface Reader\nread(depth: Integer): Response\nend\nclass First implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nif held.size() == 0\nreturn Response::Value(0.0)\nend\nreturn Response::Value(2.5)\nend\nend\nclass Second implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nif held.size() == 0\nreturn Response::Value(0.0)\nend\nreturn Response::Value(2.5)\nend\nend\ndef main()\nitems: Array<Reader> := [First.new(\"left\"), Second.new(\"right\")]\nmut retained: Array<String> := [\"he\" + \"ld\"]\nitems.each do |item|\ncase item.read(0)\nwhen Response::Value(value)\nputs(value)\nend\nretained.push(\"kee\" + \"p\")\nend\nputs(retained[0])\nend\n", "2.5\n2.5\nheld\n", 6)
	end

	test("preserves managed-record after erasure reorder reoptimization and real GC") do
		interface_enum_return_control("record Packet\ntext: String\nend\nenum Response\nValue(packet: Packet)\nend\ninterface Reader\nread(depth: Integer): Response\nend\nclass First implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nreturn Response::Value(Packet.new(text: held))\nend\nend\nclass Second implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nreturn Response::Value(Packet.new(text: held))\nend\nend\ndef main()\nitems: Array<Reader> := [First.new(\"left\"), Second.new(\"right\")]\nmut retained: Array<String> := [\"he\" + \"ld\"]\nitems.each do |item|\ncase item.read(0)\nwhen Response::Value(value)\nputs(value.text)\nend\nretained.push(\"kee\" + \"p\")\nend\nputs(retained[0])\nend\n", "left!\nright!\nheld\n", 6)
	end

	test("preserves multiple-named-contracts after erasure reorder reoptimization and real GC") do
		interface_enum_return_control("enum Response\nValue(text: String)\nend\ninterface Reader\nread(depth: Integer, *, scale: Float, suffix: String): Response\nend\ninterface Other\nread(depth: Integer, *, scale: Float, suffix: String): Response\nend\nclass First implements Reader, Other\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer, *, suffix: String, scale: Float): Response\nheld := @label + suffix\nreturn Response::Value(held)\nend\nend\nclass Second implements Reader, Other\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer, *, suffix: String, scale: Float): Response\nheld := @label + suffix\nreturn Response::Value(held)\nend\nend\ndef main()\nitems: Array<Reader> := [First.new(\"left\"), Second.new(\"right\")]\nmut retained: Array<String> := [\"he\" + \"ld\"]\nitems.each do |item|\ncase item.read(0, scale: 2.5, suffix: \"!\")\nwhen Response::Value(value)\nputs(value)\nend\nretained.push(\"kee\" + \"p\")\nend\nother: Other := First.new(\"third\")\ncase other.read(0, suffix: \"?\", scale: 3.5)\nwhen Response::Value(value)\nputs(value)\nend\nputs(retained[0])\nend\n", "left!\nright!\nthird?\nheld\n", 6)
	end

	test("preserves recursive-captured after erasure reorder reoptimization and real GC") do
		interface_enum_return_control("enum Response\nValue(text: String)\nend\ninterface Reader\nread(depth: Integer): Response\nend\nclass First implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nif depth > 0\nreturn route(self, depth - 1)\nend\nreturn Response::Value(held)\nend\nend\nclass Second implements Reader\n@label: String\ndef initialize(label: String)\n@label = label + \"\"\nend\ndef read(depth: Integer): Response\nheld := @label + \"!\"\nif depth > 0\nreturn route(self, depth - 1)\nend\nreturn Response::Value(held)\nend\nend\ndef route(value: Reader, depth: Integer): Response\nreturn value.read(depth)\nend\ndef main()\nitems: Array<Reader> := [First.new(\"left\"), Second.new(\"right\")]\nmut retained: Array<String> := [\"he\" + \"ld\"]\nitems.each do |item|\nmethod := fn(depth: Integer): Response\nreturn item.read(depth)\nend\ncase method(2)\nwhen Response::Value(value)\nputs(value)\nend\nretained.push(\"kee\" + \"p\")\nend\nputs(retained[0])\nend\n", "left!\nright!\nheld\n", 6)
	end

end
