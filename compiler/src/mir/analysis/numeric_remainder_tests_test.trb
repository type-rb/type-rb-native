import { mir_numeric_remainder_test_mode } from mir/model/numeric_modes
import { emit_qbe } from compiler
import { mir_numeric_find, mir_numeric_plans_equal } from mir/analysis/numeric
import { MirNumericOperation } from mir/model/module
import { optimize_verified_mir } from mir/passes/optimize
import { verify_mir } from mir/verify/module
import { integer_string } from support/literals
import { array_loop_mir_check } from testing/mir/array_loops
import { control_test_output } from testing/mir/control
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

describe("MIR remainder zero comparisons") do
	test("preserves equality and reversed inequality for signed endpoints") do
		[1, 2, 8, 4503599627370496].each do |divisor|
			mut source := "def multiple(value: Integer): Boolean\nreturn value % " + integer_string(divisor) + " == 0\nend\ndef nonmultiple(value: Integer): Boolean\nreturn 0 != value % " + integer_string(divisor) + "\nend\ndef main()\n"
			mut expected := ""
			[-9007199254740991, -divisor - 1, -divisor, -1, 0, 1, divisor - 1, divisor, divisor + 1, 9007199254740991].each do |value|
				source += "puts(multiple(" + integer_string(value) + "))\nputs(nonmultiple(" + integer_string(value) + "))\n"
				if value % divisor == 0
					expected += "true\nfalse\n"
				else
					expected += "false\ntrue\n"
				end
			end
			source += "end\n"
			state := array_loop_mir_check(source)
			plan := mir_numeric_find(state.scalar_mir.numeric_plans[0], 0, -1, -1)
			expect(plan.operations[1].mode).to_equal(mir_numeric_remainder_test_mode())
			qbe := Process.environment("TYPE_RB_NATIVE_QBE")
			if qbe != nil
				case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
				when Result::Ok(actual)
					expect(actual).to_equal(expected)
				when Result::Err(error)
					puts(error)
					expect(false).to_be_true()
				end
			end
		end
	end

	test("keeps signed results for other consumers and rederives erased-source plans") do
		mut state := array_loop_mir_check("def report(value: Integer): Integer\nremainder := value % 8\nif remainder == 0\nputs(100)\nend\nreturn remainder\nend\ndef main()\nputs(report(-9))\nputs(report(-8))\nputs(report(9))\nend\n")
		plans := state.scalar_mir.numeric_plans[0]
		before := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		optimize_verified_mir(state.scalar_mir)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(mir_numeric_plans_equal(plans, state.scalar_mir.numeric_plans[0])).to_be_true()
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, before)
			when Result::Ok(actual)
				expect(actual).to_equal("-1\n100\n0\n1\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("does not change other comparisons or unsupported divisors") do
		["value % 2 == 1", "value % 2 < 0", "value % 0 == 0", "value % -2 == 0", "value % 3 == 0", "value % other == 0"].each do |expression|
			state := array_loop_mir_check("def compare(value: Integer, other: Integer): Boolean\nreturn " + expression + "\nend\ndef main()\nend\n")
			plan := mir_numeric_find(state.scalar_mir.numeric_plans[0], 0, -1, -1)
			plan.operations.each do |operation|
				expect(operation.mode == mir_numeric_remainder_test_mode()).to_be_false()
			end
		end
	end

	test("rejects a forged original dividend") do
		mut state := array_loop_mir_check("def multiple(value: Integer): Boolean\nreturn value % 2 == 0\nend\ndef main()\nend\n")
		mut plan := mir_numeric_find(state.scalar_mir.numeric_plans[0], 0, -1, -1)
		original := plan.operations[1]
		plan.operations[1] = MirNumericOperation.new(instruction: original.instruction, mode: original.mode, tested_value: original.tested_value + 1, divisor: original.divisor, reciprocal: original.reciprocal, shift: original.shift)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR numeric plan differs")
	end
end
