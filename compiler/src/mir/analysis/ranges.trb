import { ascii_code, integer_string } from support/literals
import { MirFunction, MirInstruction, MirModule, mir_block_index, mir_value_type } from mir/model/module
import { MirFlow, MirFlowAliases, mir_flow_alias, mir_flow_block_index, mir_flow_definition_block, mir_flow_dominates, mir_flow_position, mir_flow_type } from mir/analysis/flow

def mir_exact_integer_literal(
		native_module: MirModule,
		instruction: MirInstruction,
		text: String,
	): Boolean
	if instruction.kind != 6
		return false
	end
	literal := instruction.payload
	if literal < 0
		return false
	end
	if literal >= native_module.literal_texts.size()
		return false
	end
	return native_module.literal_texts[literal] == text
end

record MirScalarRange
	low: Integer
	high: Integer
end

# Parse only a nonnegative portable decimal; malformed MIR must not make
# range analysis itself fail or overflow. Underscores carry no value.
def mir_scalar_literal(text: String): Integer
	mut digits := 0
	mut value := 0
	mut index := 0
	while index < text.size()
		character := text[index]
		if character != "_"
			digit := ascii_code(character) - 48
			if digit < 0 || digit > 9
				return -1
			end
			if value > (9007199254740991 - digit) / 10
				return -1
			end
			digits += 1
			value = value * 10 + digit
		end
		index += 1
	end
	if digits == 0
		return -1
	end
	return value
end

# A true entry is a portable Integer known to be nonnegative on every reachable
# path. Start optimistically and remove unsupported entries until loop-carried
# parameters settle; checked additions preserve nonnegativity or terminate.
record MirNonnegative
	dense: Array<Integer>
	sparse: Hash<String, Integer>
end

def mir_nonnegative_value(values: MirNonnegative, value: Integer): Boolean
	if values.dense.size() > 0
		if value >= 0 && value < values.dense.size()
			return values.dense[value] == 1
		end
		return false
	end
	key := integer_string(value)
	if !values.sparse.key?(key)
		return false
	end
	return values.sparse[key] == 1
end

def mir_nonnegative_instruction(native_module: MirModule, instruction: MirInstruction, values: MirNonnegative): Boolean
	# Verified collection lengths cannot be negative, even when receivers change.
	if instruction.kind == 20 || (instruction.kind == 15 && instruction.payload == 0)
		return true
	end
	if instruction.kind == 6
		if instruction.payload >= 0 && instruction.payload < native_module.literal_texts.size()
			return mir_scalar_literal(native_module.literal_texts[instruction.payload]) >= 0
		end
	end
	if instruction.kind == 7 && (instruction.payload == 1 || instruction.payload == 13) && instruction.failure >= 0
		if mir_nonnegative_value(values, instruction.first)
			return mir_nonnegative_value(values, instruction.second)
		end
	end
	return false
end

def mir_nonnegative_block_parameter(native_module: MirModule, function: MirFunction, flow: MirFlow, value: Integer, values: MirNonnegative): Boolean
	owner := mir_flow_definition_block(flow, value)
	if owner < 0 || owner >= function.block_count || flow.ranks[owner] < 0 || flow.predecessors[owner].size() == 0
		return false
	end
	block := native_module.blocks[function.block_start + owner]
	mut slot := 0
	while slot < block.parameter_count && native_module.arguments[block.parameter_start + slot] != value
		slot += 1
	end
	if slot == block.parameter_count
		return false
	end
	mut edge := 0
	while edge < flow.incoming_starts[owner].size()
		incoming := native_module.arguments[flow.incoming_starts[owner][edge] + slot]
		if !mir_nonnegative_value(values, incoming)
			return false
		end
		edge += 1
	end
	return true
end

def mir_nonnegative_values(native_module: MirModule, function: MirFunction, flow: MirFlow): MirNonnegative
	mut dense: Array<Integer> := []
	mut sparse: Hash<String, Integer> := {}
	mut integers: Array<Integer> := []
	if flow.dense_types.size() > 0
		mut value := 0
		while value < flow.dense_types.size()
			mut proven := 0
			if flow.dense_types[value] == 1
				proven = 1
				integers.push(value)
			end
			dense.push(proven)
			value += 1
		end
	else
		native_module.values.each do |value|
			if value.function_id == function.id && value.type_id == 1
				sparse[integer_string(value.id)] = 1
				integers.push(value.id)
			end
		end
	end
	mut values := MirNonnegative.new(dense: dense, sparse: sparse)
	mut changed := true
	while changed
		changed = false
		integers.each do |value|
			if mir_nonnegative_value(values, value)
				position := mir_flow_position(flow, value)
				mut proven := false
				if position >= 0
					proven = mir_nonnegative_instruction(native_module, native_module.instructions[position], values)
				else
					proven = mir_nonnegative_block_parameter(native_module, function, flow, value, values)
				end
				if !proven
					if values.dense.size() > 0
						values.dense[value] = 0
					else
						values.sparse[integer_string(value)] = 0
					end
					changed = true
				end
			end
		end
	end
	return values
end

# A nonzero guard is an exclusive power-of-two bound on every Integer
# parameter. All intermediate Integer ranges must fit the portable domain.
# This bounded proof accepts only a complete straight-line scalar entry.
def mir_scalar_guard_proves(native_module: MirModule, function: MirFunction, limit: Integer): Integer
	if function.block_count != 2 || function.parameter_count < 1 || function.parameter_count > 4
		return -1
	end
	entry := mir_block_index(native_module, function, function.entry_block)
	if entry < 0
		return -1
	end
	block := native_module.blocks[entry]
	if block.terminator != 3 || block.instruction_count > 32
		return -1
	end
	mut ranges: Array<MirScalarRange> := []
	mut index := 0
	while index < function.parameter_count
		value := native_module.arguments[function.parameter_start + index]
		if value != index || mir_value_type(native_module, function.id, value) != 1
			return -1
		end
		ranges.push(MirScalarRange.new(low: 0, high: limit - 1))
		index += 1
	end
	mut checked := 0
	index = block.instruction_start
	finish := index + block.instruction_count
	while index < finish
		instruction := native_module.instructions[index]
		if instruction.result != ranges.size()
			return -1
		end
		mut low := 0
		mut high := 0
		result_type := mir_value_type(native_module, function.id, instruction.result)
		if instruction.kind == 6
			if result_type == 1
				low = mir_scalar_literal(native_module.literal_texts[instruction.payload])
				if low < 0
					return -1
				end
				high = low
			end
		elsif instruction.kind == 7
			if result_type == 1
				left := instruction.first
				right := instruction.second
				if left < 0 || right < 0 || left >= ranges.size() || right >= ranges.size()
					return -1
				end
				left_range := ranges[left]
				right_range := ranges[right]
				operator := instruction.payload
				if operator == 1 || operator == 13
					if left_range.high > 9007199254740991 - right_range.high
						return 0
					end
					low = left_range.low + right_range.low
					high = left_range.high + right_range.high
				elsif operator == 3 || operator == 12
					if right_range.high > 0
						if left_range.high > 9007199254740991 / right_range.high
							return 0
						end
					end
					low = left_range.low * right_range.low
					high = left_range.high * right_range.high
				elsif operator == 4
					if right_range.low == 0
						return -1
					end
					low = left_range.low / right_range.high
					high = left_range.high / right_range.low
				else
					return -1
				end
				checked += 1
			end
		elsif instruction.kind != 9
			return -1
		end
		ranges.push(MirScalarRange.new(low: low, high: high))
		index += 1
	end
	if checked < 3
		return -1
	end
	return 1
end

def mir_scalar_guard(native_module: MirModule, function: MirFunction): Integer
	if native_module.functions.size() > 32
		return 0
	end
	if function.block_count != 2 || function.parameter_count < 1 || function.parameter_count > 4
		return 0
	end
	# Begin with the existing multiplication fast-path operand domain and
	# shrink the common input domain until the entire region is safe.
	mut limit := 67108864
	while limit >= 2
		proof := mir_scalar_guard_proves(native_module, function, limit)
		if proof < 0
			return 0
		elsif proof > 0
			return limit
		end
		limit = limit / 2
	end
	return 0
end

# Normalize a comparison of the exact parameter and a portable nonnegative
# literal. Unsupported polarity and strict maximum bounds remain unknown.
def mir_comparison_lower_bound(native_module: MirModule, flow: MirFlow, aliases: MirFlowAliases, comparison: MirInstruction, parameter: Integer, taken: Boolean): Integer
	if comparison.kind != 7 || comparison.failure != -1 || mir_flow_type(flow, comparison.result) != 2
		return -1
	end
	mut operator := comparison.payload
	mut literal := comparison.second
	if mir_flow_alias(aliases, comparison.first) != parameter
		if mir_flow_alias(aliases, comparison.second) != parameter
			return -1
		end
		literal = comparison.first
		if operator == 8
			operator = 10
		elsif operator == 9
			operator = 11
		elsif operator == 10
			operator = 8
		elsif operator == 11
			operator = 9
		end
	end
	if mir_flow_type(flow, literal) != 1
		return -1
	end
	position := mir_flow_position(flow, literal)
	if position < 0
		return -1
	end
	instruction := native_module.instructions[position]
	if instruction.kind != 6
		return -1
	end
	bound := mir_scalar_literal(native_module.literal_texts[instruction.payload])
	if bound < 0
		return -1
	end
	mut strict := false
	if taken
		if operator == 10
			strict = true
		elsif operator != 11
			return -1
		end
	else
		if operator == 9
			strict = true
		elsif operator != 8
			return -1
		end
	end
	if strict
		if bound == 9007199254740991
			return -1
		end
		return bound + 1
	end
	return bound
end

# A function parameter has one immutable scalar identity throughout a call.
# A sole incoming edge to a dominating successor makes its predicate hold at
# this use. Unanimous aliases transport identity, never a changed value.
def mir_parameter_subtraction_proven(native_module: MirModule, function: MirFunction, flow: MirFlow, aliases: MirFlowAliases, block: Integer, instruction: MirInstruction): Boolean
	if instruction.kind != 7 || instruction.payload != 2 || instruction.failure < 0
		return false
	end
	if mir_flow_type(flow, instruction.first) != 1 || mir_flow_type(flow, instruction.second) != 1 || mir_flow_type(flow, instruction.result) != 1
		return false
	end
	parameter := mir_flow_alias(aliases, instruction.first)
	if parameter < 0 || mir_flow_definition_block(flow, parameter) != -1 || flow.ranks[block] < 0
		return false
	end
	position := mir_flow_position(flow, instruction.second)
	if position < 0
		return false
	end
	right := native_module.instructions[position]
	if right.kind != 6
		return false
	end
	amount := mir_scalar_literal(native_module.literal_texts[right.payload])
	if amount < 0
		return false
	end
	mut index := 0
	while index < function.block_count
		guard := native_module.blocks[function.block_start + index]
		if flow.ranks[index] >= 0 && guard.terminator == 2 && guard.first_target != guard.second_target
			condition := mir_flow_position(flow, guard.condition)
			if condition >= guard.instruction_start && condition < guard.instruction_start + guard.instruction_count
				comparison := native_module.instructions[condition]
				mut arm := 0
				while arm < 2
					mut target := guard.first_target
					if arm == 1
						target = guard.second_target
					end
					successor := mir_flow_block_index(flow, target)
					if successor != flow.entry && flow.predecessors[successor].size() == 1 && flow.predecessors[successor][0] == index
						if mir_flow_dominates(flow, successor, block)
							lower := mir_comparison_lower_bound(native_module, flow, aliases, comparison, parameter, arm == 0)
							# 0 <= amount <= lower <= parameter <= portable maximum.
							if lower >= amount
								return true
							end
						end
					end
					arm += 1
				end
			end
		end
		index += 1
	end
	return false
end
