import { binary_less } from frontend/types/operators
import { mir_adapter_sqrt, mir_signature_standard } from mir/model/call_kinds
import { mir_terminator_branch, mir_terminator_jump } from mir/model/control
import { mir_effect_none } from mir/model/effects
import { mir_op_array_load, mir_op_array_position, mir_op_array_size, mir_op_array_store, mir_op_direct_call, mir_op_integer_to_float, mir_op_scalar_binary, mir_op_scalar_literal } from mir/model/instructions
import { MirArrayCachedValue, MirArrayLoop, MirBlock, MirFunction, MirModule } from mir/model/module
import { mir_element_type } from mir/model/types
import { MirArraySeparation, mir_array_primitive_value, mir_array_values_disjoint } from mir/analysis/array_values
import { mir_instruction_effects } from mir/analysis/call_effects
import { MirFlow, MirFlowAliases, mir_flow_alias, mir_flow_aliases, mir_flow_block_index, mir_flow_dominates, mir_flow_parameter_slot, mir_flow_position, mir_flow_type, mir_value_available } from mir/analysis/flow
import { mir_natural_loop } from mir/analysis/loops
import { MirNonnegative, mir_guarded_increment_proven, mir_increment_operand, mir_nonnegative_value } from mir/analysis/ranges
import { mir_live_add, mir_live_equal, mir_managed_contains } from mir/analysis/liveness

def mir_array_cache_index(native_module: MirModule, flow: MirFlow, aliases: MirFlowAliases, value: Integer): Integer
	position := mir_flow_position(flow, value)
	if position >= 0 && native_module.instructions[position].kind == mir_op_array_position()
		return mir_flow_alias(aliases, native_module.instructions[position].second)
	end
	return mir_flow_alias(aliases, value)
end

# Restrict promotion to one straight-line body with one exclusive normal exit.
# The moving index starts at checked i + 1 and advances by one, while i is an
# unchanged nonnegative header parameter. Thus accesses at j cannot observe i.
# This structural candidate does not yet authorize any memory optimization.
def mir_array_cache_shapes(native_module: MirModule, function: MirFunction, flow: MirFlow, origins: MirFlowAliases, nonnegative: MirNonnegative, header_index: Integer): Array<MirArrayCachedValue>
	mut caches: Array<MirArrayCachedValue> := []
	header := native_module.blocks[function.block_start + header_index]
	if header.terminator != mir_terminator_branch() || header.first_target == header.second_target
		return caches
	end
	loop := mir_natural_loop(native_module, function, flow, header_index)
	if loop.preheader < 0 || loop.members.size() != 2
		return caches
	end
	body_index := mir_flow_block_index(flow, header.first_target)
	exit_index := mir_flow_block_index(flow, header.second_target)
	if !mir_managed_contains(loop.members, body_index) || mir_managed_contains(loop.members, exit_index)
		return caches
	end
	body := native_module.blocks[function.block_start + body_index]
	if body.terminator != mir_terminator_jump() || body.first_target != header.id || body.instruction_count > 128
		return caches
	end
	if flow.predecessors[body_index].size() != 1 || flow.predecessors[body_index][0] != header_index || flow.predecessors[exit_index].size() != 1 || flow.predecessors[exit_index][0] != header_index
		return caches
	end
	condition_position := mir_flow_position(flow, header.condition)
	if condition_position < header.instruction_start || condition_position >= header.instruction_start + header.instruction_count
		return caches
	end
	condition := native_module.instructions[condition_position]
	if condition.kind != mir_op_scalar_binary() || condition.payload != binary_less()
		return caches
	end
	moving_slot := mir_flow_parameter_slot(native_module, header, condition.first)
	if moving_slot < 0
		return caches
	end
	aliases := mir_flow_aliases(native_module, function, flow, header)
	preheader := native_module.blocks[function.block_start + loop.preheader]
	initial := native_module.arguments[preheader.first_argument_start + moving_slot]
	initial_position := mir_flow_position(flow, initial)
	if initial_position < 0
		return caches
	end
	initial_index := mir_increment_operand(native_module, flow, native_module.instructions[initial_position])
	if initial_index < 0
		return caches
	end
	backedge_value := mir_flow_alias(aliases, native_module.arguments[body.first_argument_start + moving_slot])
	next_position := mir_flow_position(flow, backedge_value)
	if next_position < 0
		return caches
	end
	next_index := mir_increment_operand(native_module, flow, native_module.instructions[next_position])
	if next_index < 0 || mir_flow_alias(aliases, next_index) != condition.first
		return caches
	end
	mut position := body.instruction_start
	while position < body.instruction_start + body.instruction_count
		store := native_module.instructions[position]
		if store.kind == mir_op_array_store() && mir_array_primitive_value(mir_flow_type(flow, store.payload))
			index := mir_array_cache_index(native_module, flow, aliases, store.second)
			slot := mir_flow_parameter_slot(native_module, header, index)
			owner := mir_flow_alias(origins, store.first)
			if slot >= 0 && slot != moving_slot && owner >= 0 && mir_nonnegative_value(nonnegative, index)
				from := native_module.arguments[preheader.first_argument_start + slot]
				again := mir_flow_alias(aliases, native_module.arguments[body.first_argument_start + slot])
				mut repeated := false
				caches.each do |cache|
					if cache.owner == owner
						repeated = true
					end
				end
				if from == initial_index && again == index && !repeated && caches.size() < 4
					mut loads: Array<Integer> := []
					mut stores: Array<Integer> := []
					mut valid := true
					mut scan := body.instruction_start
					while scan < body.instruction_start + body.instruction_count
						access := native_module.instructions[scan]
						if access.kind >= mir_op_array_position() && access.kind <= mir_op_array_store() && mir_flow_alias(origins, access.first) == owner
							at := mir_array_cache_index(native_module, flow, aliases, access.second)
							if at == index
								if access.kind == mir_op_array_load()
									mir_live_add(loads, scan)
								elsif access.kind == mir_op_array_store()
									mir_live_add(stores, scan)
								end
							elsif at != condition.first
								valid = false
							end
						end
						scan += 1
					end
					if valid && loads.size() > 0 && stores.size() > 0
						caches.push(MirArrayCachedValue.new(owner: owner, index: index, type_id: mir_flow_type(flow, store.payload), body: body.id, exit: header.second_target, loads: loads, stores: stores, storage_header: -1, storage_identity: -1))
					end
				end
			end
		end
		position += 1
	end
	return caches
end

# Versioning can supply identity comparisons for a promising inner loop. Keep
# the complete required set or retain the existing guard unchanged; a partial
# set must never spend the budget while failing to enable any promotion.
def mir_array_promotion_separations(native_module: MirModule, function: MirFunction, flow: MirFlow, origins: MirFlowAliases, nonnegative: MirNonnegative, preheader: MirBlock, members: Array<Integer>, existing: Array<MirArraySeparation>): Array<MirArraySeparation>
	mut pairs: Array<MirArraySeparation> := []
	existing.each do |pair|
		pairs.push(pair)
	end
	mut headers: Array<Integer> := []
	members.each do |member|
		mir_live_add(headers, native_module.blocks[function.block_start + member].id)
	end
	headers.each do |id|
		shapes := mir_array_cache_shapes(native_module, function, flow, origins, nonnegative, mir_flow_block_index(flow, id))
		shapes.each do |cache|
			body := native_module.blocks[function.block_start + mir_flow_block_index(flow, cache.body)]
			mut owners: Array<Integer> := []
			mut position := body.instruction_start
			while position < body.instruction_start + body.instruction_count
				access := native_module.instructions[position]
				if access.kind == mir_op_array_load() || access.kind == mir_op_array_store()
					owner := mir_flow_alias(origins, access.first)
					if owner < 0
						return existing
					end
					mir_live_add(owners, owner)
				end
				position += 1
			end
			owners.each do |owner|
				if owner != cache.owner
					mut known := false
					pairs.each do |pair|
						if (pair.reader == owner && pair.writer == cache.owner) || (pair.writer == owner && pair.reader == cache.owner)
							known = true
						end
					end
					if !known
						available := preheader.instruction_start + preheader.instruction_count
						if pairs.size() >= 16 || mir_flow_type(flow, owner) != mir_flow_type(flow, cache.owner) || !mir_value_available(flow, preheader, available, owner) || !mir_value_available(flow, preheader, available, cache.owner)
							return existing
						end
						pairs.push(MirArraySeparation.new(reader: cache.owner, writer: owner))
					end
				end
			end
		end
	end
	return pairs
end

# Every operation in this small region is either non-observing and infallible,
# an already bounded primitive access, or a checked increment independently
# proven not to overflow. No call may observe an intermediate deferred store.
def mir_array_cache_region_safe(native_module: MirModule, function: MirFunction, flow: MirFlow, header: MirBlock, body: MirBlock, bounded: Array<Integer>): Boolean
	[header, body].each do |block|
		mut position := block.instruction_start
		while position < block.instruction_start + block.instruction_count
			instruction := native_module.instructions[position]
			kind := instruction.kind
			if kind >= mir_op_array_position() && kind <= mir_op_array_store()
				if block.id == header.id || !mir_managed_contains(bounded, position) || !mir_array_primitive_value(mir_element_type(native_module, mir_flow_type(flow, instruction.first)))
					return false
				end
			elsif kind == mir_op_direct_call()
				signature := native_module.signatures[native_module.calls[instruction.payload].callee]
				if signature.kind != mir_signature_standard() || signature.adapter != mir_adapter_sqrt()
					return false
				end
			elsif kind == mir_op_array_size() || (kind >= mir_op_scalar_literal() && kind <= mir_op_integer_to_float())
				if mir_instruction_effects(native_module, instruction) != mir_effect_none() && !mir_guarded_increment_proven(native_module, function, flow, mir_flow_block_index(flow, block.id), instruction)
					return false
				end
			else
				return false
			end
			position += 1
		end
	end
	return true
end

def mir_array_promoted_loops(native_module: MirModule, function: MirFunction, flow: MirFlow, nonnegative: MirNonnegative, plans: Array<MirArrayLoop>): Array<MirArrayLoop>
	if native_module.functions.size() > 96 || function.block_count > 128
		return plans
	end
	mut bounded: Array<Integer> := []
	plans.each do |plan|
		plan.accesses.each do |access|
			mir_live_add(bounded, access)
		end
		plan.headers.each do |header|
			header.bounded_accesses.each do |access|
				mir_live_add(bounded, access)
			end
		end
	end
	origins := mir_flow_aliases(native_module, function, flow, native_module.blocks[function.block_start + flow.entry])
	mut result: Array<MirArrayLoop> := []
	plans.each do |plan|
		header_index := mir_flow_block_index(flow, plan.header)
		header := native_module.blocks[function.block_start + header_index]
		shapes := mir_array_cache_shapes(native_module, function, flow, origins, nonnegative, header_index)
		mut caches: Array<MirArrayCachedValue> := []
		shapes.each do |cache|
			body_index := mir_flow_block_index(flow, cache.body)
			body := native_module.blocks[function.block_start + body_index]
			mut valid := mir_array_cache_region_safe(native_module, function, flow, header, body, bounded)
			mut position := body.instruction_start
			while position < body.instruction_start + body.instruction_count && valid
				access := native_module.instructions[position]
				if access.kind == mir_op_array_load() || access.kind == mir_op_array_store()
					owner := mir_flow_alias(origins, access.first)
					if owner != cache.owner && !mir_array_values_disjoint(native_module, function, flow, origins, body_index, cache.owner, access.first)
						valid = false
					end
				end
				position += 1
			end
			if valid
				caches.push(mir_array_cache_storage(flow, origins, header_index, cache, plans))
			end
		end
		result.push(MirArrayLoop.new(header: plan.header, preheader: plan.preheader, owner: plan.owner, length: plan.length, accesses: plan.accesses, headers: plan.headers, reserved_pushes: plan.reserved_pushes, cached_values: caches, peel_body: plan.peel_body, peel_nonempty: plan.peel_nonempty))
	end
	return result
end

def mir_array_cached_values_equal(left: Array<MirArrayCachedValue>, right: Array<MirArrayCachedValue>): Boolean
	if left.size() != right.size()
		return false
	end
	mut index := 0
	while index < left.size()
		a := left[index]
		b := right[index]
		if a.storage_header != b.storage_header || a.storage_identity != b.storage_identity || a.owner != b.owner || a.index != b.index || a.type_id != b.type_id || a.body != b.body || a.exit != b.exit || !mir_live_equal(a.loads, b.loads) || !mir_live_equal(a.stores, b.stores)
			return false
		end
		index += 1
	end
	return true
end

# A stable backing observation can also supply the initialization address of
# a promoted element. Require that observation to dominate the header and to
# cover the original access; the cache region has no intervening resizing.
def mir_array_cache_storage(flow: MirFlow, origins: MirFlowAliases, header_index: Integer, cache: MirArrayCachedValue, plans: Array<MirArrayLoop>): MirArrayCachedValue
	plans.each do |plan|
		if mir_flow_dominates(flow, mir_flow_block_index(flow, plan.preheader), header_index)
			mut found := false
			mut identity := -1
			if plan.owner >= 0 && mir_flow_alias(origins, plan.owner) == cache.owner && mir_managed_contains(plan.accesses, cache.loads[0])
				found = true
			end
			plan.headers.each do |storage|
				if mir_flow_alias(origins, storage.owner) == cache.owner && mir_managed_contains(storage.accesses, cache.loads[0])
					identity = storage.identity
					found = true
				end
			end
			if found
				return MirArrayCachedValue.new(owner: cache.owner, index: cache.index, type_id: cache.type_id, body: cache.body, exit: cache.exit, loads: cache.loads, stores: cache.stores, storage_header: plan.header, storage_identity: identity)
			end
		end
	end
	return cache
end
