import { mir_loop_alias, mir_loop_alias_store, mir_loop_alias_table, mir_loop_aliases } from mir/analysis/array_loops
import { mir_build_flow, mir_flow_blocks } from mir/analysis/flow
import { MirFunction, MirValue } from mir/model/module
import { flow_test_module } from testing/mir/flow
import { verify_mir } from mir/verify/module
import { mir_test_block_with_cell, mir_test_instruction_with_cell, mir_test_module } from testing/mir/model
import { describe, expect, test } from trb/std/test

describe("MIR loop alias storage") do
	test("keeps dense holes unknown and stores extreme identities sparsely") do
		native_module := mir_test_module(false, false)
		function := native_module.functions[0]
		flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
		mut aliases := mir_loop_alias_table(flow)
		expect(aliases.dense.size()).to_equal(9)
		expect(mir_loop_alias(aliases, 0)).to_equal(-2)
		expect(mir_loop_alias(aliases, 8)).to_equal(-2)
		expect(mir_loop_alias(aliases, 9)).to_equal(-2)
		expect(mir_loop_alias(aliases, -1)).to_equal(-2)
		mir_loop_alias_store(aliases, 0, 0)
		mir_loop_alias_store(aliases, 8, -1)
		mir_loop_alias_store(aliases, 9007199254740991, 8)
		mir_loop_alias_store(aliases, -1, 0)
		expect(mir_loop_alias(aliases, 0)).to_equal(0)
		expect(mir_loop_alias(aliases, 8)).to_equal(-1)
		expect(mir_loop_alias(aliases, 9007199254740991)).to_equal(8)
		expect(mir_loop_alias(aliases, -1)).to_equal(0)
		expect(aliases.dense.size()).to_equal(9)
		expect(aliases.sparse.size()).to_equal(2)
		expect(flow.dense_types[8]).to_equal(1)
	end

	test("preserves header identities and loop forwarding for compact and sparse values") do
		[0, 9007199254740900].each do |offset|
			mut native_module := mir_test_module(false, false)
			mut index := 0
			while index < native_module.values.size()
				value := native_module.values[index]
				native_module.values[index] = MirValue.new(function_id: value.function_id, id: value.id + offset, type_id: value.type_id, source_id: value.source_id, line: value.line)
				index += 1
			end
			index = 0
			while index < native_module.arguments.size()
				native_module.arguments[index] += offset
				index += 1
			end
			index = 0
			while index < native_module.instructions.size()
				mut instruction := native_module.instructions[index]
				instruction = mir_test_instruction_with_cell(instruction, 1, instruction.result + offset)
				if instruction.first >= 0
					instruction = mir_test_instruction_with_cell(instruction, 2, instruction.first + offset)
				end
				if instruction.second >= 0
					instruction = mir_test_instruction_with_cell(instruction, 3, instruction.second + offset)
				end
				native_module.instructions[index] = instruction
				index += 1
			end
			native_module.blocks[1] = mir_test_block_with_cell(native_module.blocks[1], 8, 4 + offset)
			function := native_module.functions[0]
			[false, true].each do |reordered|
				mut header_index := 1
				if reordered
					saved := native_module.blocks[1]
					native_module.blocks[1] = native_module.blocks[2]
					native_module.blocks[2] = saved
					header_index = 2
				end
				flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
				aliases := mir_loop_aliases(native_module, function, flow, native_module.blocks[header_index])
				expect(aliases.dense.size() == 0).to_equal(offset != 0)
				# Header parameter 2 stays itself despite incoming 1 and 8. The
				# body's parameter 5 forwards that identity across the loop edge.
				mut value := 0
				[0, 1, 2, 3, 4, 2, 6, 7, 8].each do |identity|
					expect(mir_loop_alias(aliases, offset + value)).to_equal(offset + identity)
					value += 1
				end
				expect(mir_loop_alias(aliases, offset + 9)).to_equal(-2)
			end
		end
	end

	test("joins both branch arms without turning a conflict into an identity") do
		[false, true].each do |same|
			[false, true].each do |sparse|
				mut native_module := flow_test_module([[1, 1], [], []])
				native_module.functions[0] = MirFunction.new(kind: 0, result_type: "Void", integer_guard: 0, id: 7, entry_block: 100, source_id: 0, line: 1, parameter_start: 0, parameter_count: 3, block_start: 0, block_count: 3)
				mut index := 0
				if !sparse
					while index < 3
						native_module.values[index + 1] = MirValue.new(function_id: 7, id: index + 4, type_id: 1, source_id: 0, line: 1)
						native_module.instructions[index] = mir_test_instruction_with_cell(native_module.instructions[index], 1, index + 4)
						index += 1
					end
				end
				[1, 2, 3].each do |id|
					native_module.values.push(MirValue.new(function_id: 7, id: id, type_id: 1, source_id: 0, line: 1))
				end
				[1, 2, 3, 1, 2].each do |value|
					native_module.arguments.push(value)
				end
				if same
					native_module.arguments[5] = 1
				end
				native_module.blocks[0] = mir_test_block_with_cell(native_module.blocks[0], 11, 4)
				native_module.blocks[0] = mir_test_block_with_cell(native_module.blocks[0], 12, 1)
				native_module.blocks[0] = mir_test_block_with_cell(native_module.blocks[0], 13, 5)
				native_module.blocks[0] = mir_test_block_with_cell(native_module.blocks[0], 14, 1)
				native_module.blocks[1] = mir_test_block_with_cell(native_module.blocks[1], 3, 3)
				native_module.blocks[1] = mir_test_block_with_cell(native_module.blocks[1], 4, 1)
				expect(verify_mir(native_module, false)).to_equal("")
				function := native_module.functions[0]
				flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
				aliases := mir_loop_aliases(native_module, function, flow, native_module.blocks[2])
				expect(aliases.dense.size() == 0).to_equal(sparse)
				mut expected := -1
				if same
					expected = 1
				end
				expect(mir_loop_alias(aliases, 3)).to_equal(expected)
			end
		end
	end
end
