import { MirHashLookupReuse, MirInstruction, MirModule, mir_value_type } from mir/model/module
import { mir_hash_key_type } from mir/model/types

# Only admitted scalar operations can separate a lookup from its store. Calls,
# allocations, mutation, other reads and future instruction kinds invalidate it.
# Scalar failures stay in place and never turn a missing get into an insertion.
def mir_hash_lookup_preserves(instruction: MirInstruction): Boolean
	if instruction.kind >= 1 && instruction.kind <= 3
		return true
	end
	if instruction.kind >= 6 && instruction.kind <= 9
		return true
	end
	if instruction.kind == 12 || instruction.kind == 43
		return true
	end
	return false
end

def mir_hash_lookup_plans(native_module: MirModule): Array<MirHashLookupReuse>
	mut plans: Array<MirHashLookupReuse> := []
	# Physical instruction spans can be shared by distinct logical functions.
	# Such storage cannot own a module-wide lookup fact. Count all occurrences.
	mut occurrences: Array<Integer> := []
	mut cursor := 0
	while cursor < native_module.instructions.size()
		occurrences.push(0)
		cursor += 1
	end
	native_module.functions.each do |function|
		mut at := function.block_start
		while at < function.block_start + function.block_count
			block := native_module.blocks[at]
			cursor = block.instruction_start
			while cursor < block.instruction_start + block.instruction_count
				occurrences[cursor] += 1
				cursor += 1
			end
			at += 1
		end
	end
	native_module.functions.each do |function|
		mut block_index := function.block_start
		while block_index < function.block_start + function.block_count
			block := native_module.blocks[block_index]
			mut producer := -1
			mut index := block.instruction_start
			while index < block.instruction_start + block.instruction_count
				instruction := native_module.instructions[index]
				if occurrences[index] != 1
					producer = -1
				elsif instruction.kind == 28
					producer = index
				elsif instruction.kind == 29
					if producer >= 0
						get := native_module.instructions[producer]
						if get.first == instruction.first && get.second == instruction.second
							owner_type := mir_value_type(native_module, function.id, get.first)
							key_type := mir_hash_key_type(native_module, owner_type)
							if key_type == 1 || key_type == 8
								plans.push(MirHashLookupReuse.new(producer: producer, store: index))
							end
						end
					end
					producer = -1
				elsif !mir_hash_lookup_preserves(instruction)
					producer = -1
				end
				index += 1
			end
			block_index += 1
		end
	end
	# Block/function storage order is not an optimization input. Nonoverlapping
	# pairs have the same producer and store order, enabling both binary lookups.
	mut index := 1
	while index < plans.size()
		row := plans[index]
		mut position := index
		while position > 0 && plans[position - 1].producer > row.producer
			plans[position] = plans[position - 1]
			position -= 1
		end
		plans[position] = row
		index += 1
	end
	return plans
end

def mir_hash_lookup_equal(left: Array<MirHashLookupReuse>, right: Array<MirHashLookupReuse>): Boolean
	if left.size() != right.size()
		return false
	end
	mut index := 0
	while index < left.size()
		if left[index].producer != right[index].producer || left[index].store != right[index].store
			return false
		end
		index += 1
	end
	return true
end

def mir_hash_lookup_find(plans: Array<MirHashLookupReuse>, instruction: Integer, producer: Boolean): Integer
	mut lower := 0
	mut upper := plans.size()
	while lower < upper
		middle := lower + (upper - lower) / 2
		mut identity := plans[middle].store
		if producer
			identity = plans[middle].producer
		end
		if identity == instruction
			return plans[middle].producer
		elsif identity < instruction
			lower = middle + 1
		else
			upper = middle
		end
	end
	return -1
end
