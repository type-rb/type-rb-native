import { emit_qbe } from compiler
import { mir_function_index } from mir/model/module
import { optimize_verified_mir } from mir/passes/optimize
import { verify_mir } from mir/verify/module
import { array_loop_mir_check } from testing/mir/array_loops
import { control_test_output } from testing/mir/control
import { intrinsic_mir_erase } from testing/mir/intrinsics
import { logical_run_qbe } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

def copy_test_source(body: String): String
	return "def copy_prefix(mut destination: Array<Integer>, source: Array<Integer>, mut count: Integer): Integer\nmut index := 0\nwhile index < count\n" + body + "\nend\nreturn index\nend\ndef main()\nend\n"
end

describe("Scalar Array copy MIR") do
	test("derives a complete scalar prefix region and keeps its checked fallback") do
		state := array_loop_mir_check(copy_test_source("destination[index] = source[index]\nindex += 1"))
		index := mir_function_index(state.scalar_mir, 0)
		expect(state.scalar_mir.array_copies[index].size()).to_equal(1)
		qbe := control_test_output(emit_qbe(state))
		expect(qbe.include?("%mir_copy_index")).to_be_true()
		expect(qbe.include?("call $memcpy")).to_be_true()
		expect(qbe.include?("call $trbn_fail(l $trbn_bounds_error, l 30)")).to_be_true()
	end

	test("rejects shifts arithmetic extra effects and changing loop-carried values") do
		bodies := [
			"destination[index] = source[index + 1]\nindex += 1",
			"destination[index + 1] = source[index]\nindex += 1",
			"destination[index] += source[index]\nindex += 1",
			"destination[index] = source[index]\nindex += 2",
			"destination[index] = source[index]\ncount -= 1\nindex += 1",
			"destination[index] = source[index]\nputs(index)\nindex += 1",
			"destination[index] = source[index]\nif index == 1\nbreak\nend\nindex += 1",
		]
		bodies.each do |body|
			state := array_loop_mir_check(copy_test_source(body))
			expect(state.scalar_mir.array_copies[mir_function_index(state.scalar_mir, 0)].size()).to_equal(0)
		end
		managed := "def copy_prefix(mut destination: Array<String>, source: Array<String>, count: Integer)\nmut index := 0\nwhile index < count\ndestination[index] = source[index]\nindex += 1\nend\nend\ndef main()\nend\n"
		state := array_loop_mir_check(managed)
		expect(state.scalar_mir.array_copies[mir_function_index(state.scalar_mir, 0)].size()).to_equal(0)
	end

	test("executes exact Integer Float alias and empty copies after canonical erasure") do
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			source := "def copy_prefix(mut destination: Array<Integer>, source: Array<Integer>, mut count: Integer): Integer\nmut index := 0\nwhile index < count\ndestination[index] = source[index]\nindex += 1\nend\nreturn index\nend\ndef copy_float(mut destination: Array<Float>, source: Array<Float>, count: Integer): Integer\nmut index := 0\nwhile index < count\ndestination[index] = source[index]\nindex += 1\nend\nreturn index\nend\ndef main()\nmut destination := [0, 0, 9]\nsource := [-9007199254740991, 9007199254740991, 8]\nputs(copy_prefix(destination, source, 2))\nputs(destination[0])\nputs(destination[1])\nputs(destination[2])\nputs(copy_prefix(destination, destination, 3))\nputs(copy_prefix(destination, source, 0))\nputs(copy_prefix(destination, source, -3))\nmut floats := [0.0, 0.0]\nputs(copy_float(floats, [1.5, -2.5], 2))\nputs(floats[0] == 1.5)\nputs(floats[1] == -2.5)\nend\n"
			mut state := array_loop_mir_check(source)
			expect(state.scalar_mir.array_copies[0].size()).to_equal(1)
			expect(state.scalar_mir.array_copies[1].size()).to_equal(1)
			before := control_test_output(emit_qbe(state))
			intrinsic_mir_erase(state)
			expect(control_test_output(emit_qbe(state))).to_equal(before)
			state.scalar_mir.functions.each do |function|
				mut left := function.block_start
				mut right := left + function.block_count - 1
				while left < right
					saved := state.scalar_mir.blocks[left]
					state.scalar_mir.blocks[left] = state.scalar_mir.blocks[right]
					state.scalar_mir.blocks[right] = saved
					left += 1
					right -= 1
				end
			end
			expect(verify_mir(state.scalar_mir, true)).to_equal("")
			saved := state.scalar_mir.functions[0]
			state.scalar_mir.functions[0] = state.scalar_mir.functions[1]
			state.scalar_mir.functions[1] = saved
			optimize_verified_mir(state.scalar_mir)
			expect(verify_mir(state.scalar_mir, true)).to_equal("")
			case logical_run_qbe(qbe, control_test_output(emit_qbe(state)))
			when Result::Ok(actual)
				expect(actual).to_equal("2\n-9007199254740991\n9007199254740991\n9\n3\n0\n0\n2\ntrue\ntrue\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end
end
