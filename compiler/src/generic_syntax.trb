import { CompilerState, diagnostic, has_diagnostic } from state
import { load_integer } from storage
import { advance, expect, expect_identifier, skip_newlines, token_is } from syntax_tokens

# Syntactic type applications require a call or constructor suffix.
# Comparison operators never consume a speculative type argument list.
def nominal_application_name(state: CompilerState, origin: Integer): Integer
	mut token := origin
	while (token_is(state, token + 1, "::") || token_is(state, token + 1, ".")) && load_integer(state.source_tokens.token_kinds, token + 2) == 1
		token += 2
	end
	return token
end

def nominal_application_end(state: CompilerState, origin: Integer): Integer
	name_origin := nominal_application_name(state, origin)
	if !token_is(state, name_origin + 1, "<")
		return - 1
	end
	mut depth := 1
	mut token := name_origin + 2
	while token < state.source_tokens.token_count[0] && depth > 0
		if token_is(state, token, "<")
			depth += 1
		elsif token_is(state, token, ">")
			depth -= 1
		elsif token_is(state, token, ">>")
			depth -= 2
		elsif token_is(state, token, ")")
			# A parameter group belongs to a function type only before its arrow.
			# Parenthesized comparison operands remain ordinary expressions.
			if !token_is(state, token + 1, "->")
				return - 1
			end
		elsif token_is(state, token, "(") || token_is(state, token, "->")
		elsif load_integer(state.source_tokens.token_kinds, token) != 1 && load_integer(state.source_tokens.token_kinds, token) != 2 && load_integer(state.source_tokens.token_kinds, token) != 3 && load_integer(state.source_tokens.token_kinds, token) != 7 && !token_is(state, token, "-") && load_integer(state.source_tokens.token_kinds, token) != 4 && !token_is(state, token, ",") && !token_is(state, token, "?") && !token_is(state, token, "|") && !token_is(state, token, "::")
			return - 1
		end
		token += 1
	end
	if depth == 0 && (token_is(state, token, "(") || token_is(state, token, "::") || (token_is(state, token, ".") && token_is(state, token + 1, "new")))
		return token
	end
	return - 1
end

def parse_generic_parameters(mut state: CompilerState, mut position: Array<Integer>, line: Integer): Array<String>
	advance(position)
	mut parameters: Array<String> := []
	skip_newlines(state, position)
	while !token_is(state, position[0], ">") && !has_diagnostic(state)
		parameter := expect_identifier(state, position)
		parameters.each do |previous|
			if previous == parameter
				diagnostic(state, "TRBN4003", line, "duplicate type parameter " + parameter)
			end
		end
		parameters.push(parameter)
		skip_newlines(state, position)
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	if parameters.size() == 0 || !expect(state, position, ">")
		diagnostic(state, "TRBN4002", line, "generic declaration requires type parameters")
		return []
	end
	return parameters
end
