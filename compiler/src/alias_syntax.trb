import { enum_uppercase } from enum_types
import { TypeAlias } from alias_model
import { parse_generic_parameters } from generic_syntax
import { advance, expect, expect_identifier, finish_statement, parse_type, token_is } from syntax_tokens
import { CompilerState, diagnostic, has_diagnostic } from state
import { load_integer } from storage

def parse_type_alias(mut state: CompilerState, mut position: Array<Integer>): Boolean
	line := load_integer(state.token_lines, position[0])
	advance(position)
	name := expect_identifier(state, position)
	if !enum_uppercase(name)
		diagnostic(state, "TRBN4002", line, "type alias name must start with an uppercase letter")
		return false
	end
	mut parameters: Array<String> := []
	if token_is(state, position[0], "<")
		parameters = parse_generic_parameters(state, position, line)
	end
	if has_diagnostic(state) || !expect(state, position, "=")
		return false
	end
	target := parse_type(state, position)
	if has_diagnostic(state) || !finish_statement(state, position)
		return false
	end
	state.type_aliases.push(TypeAlias.new(name: name, source_id: state.active_module[0], line: line, parameters: parameters, target: target))
	return true
end
