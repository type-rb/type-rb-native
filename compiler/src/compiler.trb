record Gate4EmitContext
	local_names: Gate4StringStorage
	local_types: Gate4StringStorage
	local_slots: Gate4StringStorage
	local_inherited: Gate4IntegerStorage
	local_direct: Gate4IntegerStorage
	local_count: Array<Integer>
	slot_count: Array<Integer>
	managed_local_high_water: Array<Integer>
	temporary_roots_used: Array<Integer>
	temporary_count: Array<Integer>
	label_count: Array<Integer>
	loop_depth: Array<Integer>
	inline_budget: Array<Integer>
	scalar_inline_depth: Array<Integer>
	scalar_inline_range_failure_used: Array<Boolean>
	array_bounds_failure_used: Array<Boolean>
	array_header_local_origins: Array<Integer>
	array_headers: Array<Array<String>>
	array_header_count: Array<Integer>
	array_loop_headers: Array<Array<Integer>>
	array_header_fallback: Array<Array<String>>
end

record Gate4EmittedValue
	operand: String
	type_name: String
	category: Integer
	name: String
	# Bindings and record fields use addresses; category 3 uses a validated
	# Array position and owner. Plain element reads carry no pending target.
	slot: String
	owner: String
end

record Gate4ProjectSources
	paths: Array<String>
	sources: Array<String>
	error: String
end

def gate4_reset_temporary_storage()
	return
end

# These declarations are typed compiler-runtime intrinsics. Their source bodies
# keep recovery compilation valid; the self-hosted emitter replaces calls from
# the compiler executable with the matching QBE runtime operations.
def gate4_file_exists(_path: String): Boolean
	return false
end

def gate4_read_source(_path: String): String
	return ""
end

def gate4_source_slice(source: String, start: Integer, finish: Integer): String
	mut value := ""
	mut index := start
	while index < finish
		value += source[index]
		index += 1
	end
	return value
end

def gate4_collect_project_sources(_source_root: String, _out_root: String): Gate4ProjectSources
	return Gate4ProjectSources.new(paths: [], sources: [], error: "")
end

def gate4_emit_context_new(
		capacity: Integer,
		inline_budget: Array<Integer>,
	): Gate4EmitContext
	return Gate4EmitContext.new(
		local_names: gate4_string_storage(capacity),
		local_types: gate4_string_storage(capacity),
		local_slots: gate4_string_storage(capacity),
		local_inherited: gate4_integer_storage(capacity),
		local_direct: gate4_integer_storage(capacity),
		local_count: [0],
		slot_count: [0],
		managed_local_high_water: [0],
		# The second cell is a monotonic GC-safe-point counter used while
		# deciding whether loop-root publication may move to the exit.
		temporary_roots_used: [0, 0],
		temporary_count: [0],
		label_count: [0],
		loop_depth: [0],
		inline_budget: inline_budget,
		scalar_inline_depth: [0],
		scalar_inline_range_failure_used: [false],
		array_bounds_failure_used: [false],
		array_header_local_origins: [],
		array_headers: [],
		array_header_count: [0],
		array_loop_headers: [],
		array_header_fallback: [gate4_array_header_new(), gate4_array_header_new()],
	)
end

def gate4_static_string_bytes(value: String): Array<Integer>
	mut bytes: Array<Integer> := []
	mut index := 0
	while index < value.size()
		code := gate4_ascii_code(value[index])
		if code < 0
			return []
		end
		bytes.push(code)
		index += 1
	end
	return bytes
end

def gate4_static_bytes_hash(bytes: Array<Integer>, index: Integer): Integer
	return ((bytes[index] * 257 + bytes[index + 1]) * 257 + bytes[index + 2]) % 512
end

def gate4_encode_static_bytes(bytes: Array<Integer>): Array<Integer>
	mut positions: Array<Integer> := []
	while positions.size() < 512
		positions.push(- 1)
	end
	mut encoded: Array<Integer> := []
	mut index := 0
	while index < bytes.size()
		mut match_length := 0
		mut match_distance := 0
		if index + 2 < bytes.size()
			hash := gate4_static_bytes_hash(bytes, index)
			previous := positions[hash]
			if previous >= 0
				distance := index - previous
				if distance <= 65535
					mut limit := bytes.size() - index
					if limit > 130
						limit = 130
					end
					mut length := 0
					mut matching := true
					while matching
						if length >= limit
							matching = false
						else
							if bytes[previous + length] == bytes[index + length]
								length += 1
							else
								matching = false
							end
						end
					end
					if length >= 4
						match_length = length
						match_distance = distance
					end
				end
			end
		end

		mut consumed := 1
		if match_length >= 4
			encoded.push(128 + match_length - 3)
			encoded.push(match_distance / 256)
			encoded.push(match_distance % 256)
			consumed = match_length
		else
			encoded.push(bytes[index])
		end

		mut update := index
		while update < index + consumed
			if update + 2 < bytes.size()
				positions[gate4_static_bytes_hash(bytes, update)] = update
			end
			update += 1
		end
		index += consumed
	end
	return encoded
end

def gate4_encode_static_string(value: String): Array<Integer>
	return gate4_encode_static_bytes(gate4_static_string_bytes(value))
end

def gate4_emit_static_byte_data(
		mut output: QbeOutput,
		symbol: String,
		bytes: Array<Integer>,
	)
	qbe_output_line(output, "data $" + symbol + " = {")
	mut line := "\tb"
	mut line_bytes := 0
	mut index := 0
	while index < bytes.size()
		line += " " + gate4_integer_string(bytes[index])
		line_bytes += 1
		if line_bytes == 16
			qbe_output_line(output, line + ",")
			line = "\tb"
			line_bytes = 0
		end
		index += 1
	end
	if line_bytes > 0
		qbe_output_line(output, line + ",")
	end
	qbe_output_line(output, "\tb 0 }")
	return
end

def gate4_emit_static_string_decoder(
		mut output: QbeOutput,
		compressed_tokens: Array<Integer>,
		compressed_sizes: Array<Integer>,
		decoded_sizes: Array<Integer>,
	)
	qbe_output_line(
		output,
		"function $g4_static_string_decode(l %target, l %encoded, l %encoded_length, l %decoded_length) {\n@start\n\tstorel 0, %target\n\t%length_address =l add %target, 8\n\tstorel %decoded_length, %length_address\n\t%output =l add %target, 16\n\tjmp @loop\n@loop\n\t%input_index =l phi @start 0, @literal %literal_next_input, @match_done %match_next_input\n\t%output_index =l phi @start 0, @literal %literal_next_output, @match_done %match_next_output\n\t%done =w cslel %encoded_length, %input_index\n\tjnz %done, @terminate, @read\n@read\n\t%encoded_address =l add %encoded, %input_index\n\t%header =w loadub %encoded_address\n\t%is_match =w csgtw %header, 127\n\tjnz %is_match, @match, @literal\n@literal\n\t%literal_address =l add %output, %output_index\n\tstoreb %header, %literal_address\n\t%literal_next_input =l add %input_index, 1\n\t%literal_next_output =l add %output_index, 1\n\tjmp @loop\n@match\n\t%high_address =l add %encoded_address, 1\n\t%low_address =l add %encoded_address, 2\n\t%high =w loadub %high_address\n\t%low =w loadub %low_address\n\t%high_long =l extuw %high\n\t%low_long =l extuw %low\n\t%high_shifted =l shl %high_long, 8\n\t%distance =l or %high_shifted, %low_long\n\t%match_length_word =w sub %header, 125\n\t%match_length =l extuw %match_length_word\n\tjmp @copy\n@copy\n\t%copy_index =l phi @match 0, @copy_byte %copy_next\n\t%copy_done =w cslel %match_length, %copy_index\n\tjnz %copy_done, @match_done, @copy_byte\n@copy_byte\n\t%source_base =l sub %output_index, %distance\n\t%source_index =l add %source_base, %copy_index\n\t%source_address =l add %output, %source_index\n\t%value =w loadub %source_address\n\t%destination_index =l add %output_index, %copy_index\n\t%destination_address =l add %output, %destination_index\n\tstoreb %value, %destination_address\n\t%copy_next =l add %copy_index, 1\n\tjmp @copy\n@match_done\n\t%match_next_input =l add %input_index, 3\n\t%match_next_output =l add %output_index, %match_length\n\tjmp @loop\n@terminate\n\t%terminator =l add %output, %decoded_length\n\tstoreb 0, %terminator\n\tret\n}",
	)
	qbe_output_line(output, "\nfunction $g4_static_strings_initialize() {\n@start")
	mut index := 0
	while index < compressed_tokens.size()
		token := gate4_integer_string(compressed_tokens[index])
		qbe_output_line(
			output,
			"\tcall $g4_static_string_decode(l $g4s" + token + ", l $g4c" + token +
			", l " + gate4_integer_string(compressed_sizes[index]) +
			", l " + gate4_integer_string(decoded_sizes[index]) + ")",
		)
		index += 1
	end
	qbe_output_line(output, "\tret\n}")
	return
end

def gate4_emit_static_strings(
		mut state: Gate4Compiler,
		mut output: QbeOutput,
	): Boolean
	deduplicate := gate4_compiler_entry_function(state) >= 0
	mut canonical_values: Array<String> := []
	mut canonical_tokens: Array<Integer> := []
	mut compressed_tokens: Array<Integer> := []
	mut compressed_sizes: Array<Integer> := []
	mut decoded_sizes: Array<Integer> := []
	mut token_index := 0
	while token_index < state.token_count[0]
		if gate4_load_integer(state.token_kinds, token_index) == 3
			value := gate4_load_string(state.token_texts, token_index)
			mut canonical := token_index
			mut value_index := 0
			mut found := false
			if deduplicate
				while value_index < canonical_values.size()
					if canonical_values[value_index] == value
						canonical = canonical_tokens[value_index]
						found = true
						value_index = canonical_values.size()
					else
						value_index += 1
					end
				end
			end
			if !found
				canonical_values.push(value)
				canonical_tokens.push(token_index)
				mut bytes: Array<Integer> := []
				mut has_static_bytes := false
				mut compressed: Array<Integer> := []
				if value.size() >= 256
					bytes = gate4_static_string_bytes(value)
					if bytes.size() == value.size()
						has_static_bytes = true
						compressed = gate4_encode_static_bytes(bytes)
					end
				end
				mut use_compressed := false
				if compressed.size() > 0
					if compressed.size() < value.size()
						use_compressed = true
					end
				end
				if use_compressed
					qbe_output_line(
						output,
						"data $g4s" + gate4_integer_string(token_index) + " = align 8 { z " +
						gate4_integer_string(value.size() + 17) + " }",
					)
					gate4_emit_static_byte_data(output, "g4c" + gate4_integer_string(token_index), compressed)
					compressed_tokens.push(token_index)
					compressed_sizes.push(compressed.size())
					decoded_sizes.push(value.size())
					output.runtime_flags[2] = 1
				else
					qbe_output_line(
						output,
						"data $g4s" + gate4_integer_string(token_index) +
						" = align 8 { l 0, l " + gate4_integer_string(value.size()) + ",",
					)
					mut line := "\tb"
					mut line_bytes := 0
					mut character_index := 0
					while character_index < value.size()
						mut code := 0
						if has_static_bytes
							code = bytes[character_index]
						else
							code = gate4_ascii_code(value[character_index])
						end
						if code < 0
							gate4_diagnostic(
								state,
								"TRBN4005",
								gate4_load_integer(state.token_lines, token_index),
								"Gate 4 QBE emission supports ASCII String literals only",
							)
						else
							line += " " + gate4_integer_string(code)
							line_bytes += 1
							if line_bytes == 16
								qbe_output_line(output, line + ",")
								line = "\tb"
								line_bytes = 0
							end
						end
						character_index += 1
					end
					if line_bytes > 0
						qbe_output_line(output, line + ",")
					end
					qbe_output_line(output, "\tb 0 }")
				end
			end
			gate4_store_integer(state.token_lines, token_index, canonical)
		end
		token_index += 1
	end
	if compressed_tokens.size() > 0
		gate4_emit_static_string_decoder(output, compressed_tokens, compressed_sizes, decoded_sizes)
	end
	qbe_output_line(output, "")
	return !gate4_has_diagnostic(state)
end

def gate4_emit_record_descriptors(state: Gate4Compiler, mut output: QbeOutput)
	if state.ranges.size() > 0
		qbe_output_line(output, "data $g4_desc_range = align 8 { l 1, l 0, l 24 }")
	end
	mut record_index := 0
	while record_index < state.record_count[0]
		field_start := gate4_load_integer(state.record_field_starts, record_index)
		field_count := gate4_load_integer(state.record_field_counts, record_index)
		mut managed_count := 0
		mut entries := ""
		mut field_offset := 0
		while field_offset < field_count
			if native_managed_type(gate4_load_string(state.field_types, field_start + field_offset))
				entries += ", l " + gate4_integer_string(8 + field_offset * 8)
				managed_count += 1
			end
			field_offset += 1
		end
		qbe_output_line(
			output,
			"data $g4_desc_record" + gate4_integer_string(record_index) +
			" = align 8 { l 1, l " + gate4_integer_string(managed_count) + ", l " +
			gate4_integer_string(field_count * 8) + entries + " }",
		)
		record_index += 1
	end
	qbe_output_line(output, "")
	return
end

def gate4_emitted_value(
		operand: String,
		type_name: String,
		category: Integer,
		name: String,
		slot: String,
	): Gate4EmittedValue
	return Gate4EmittedValue.new(
		operand: operand,
		type_name: type_name,
		category: category,
		name: name,
		slot: slot,
		owner: "",
	)
end

def gate4_qbe_type(type_name: String): String
	if type_name == "Float"
		return "d"
	end
	return "l"
end

def gate4_emit_typed_load(
		mut output: QbeOutput,
		result: String,
		type_name: String,
		address: String,
	)
	qbe_type := gate4_qbe_type(type_name)
	qbe_output_line(output, "\t" + result + " =" + qbe_type + " load" + qbe_type + " " + address)
end

def gate4_emit_typed_store(
		mut output: QbeOutput,
		type_name: String,
		value: String,
		address: String,
	)
	qbe_output_line(output, "\tstore" + gate4_qbe_type(type_name) + " " + value + ", " + address)
end

def gate4_note_gc_state(mut context: Gate4EmitContext, safe_point: Boolean)
	mut roots := context.temporary_roots_used
	if safe_point
		roots[1] = roots[1] + 1
		if roots[0] == 1
			roots[0] = 2
		end
	else
		if roots[0] == 0
			roots[0] = 1
		end
	end
	return
end

def gate4_emit_array_push(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		array: String,
		element_type: String,
		operand: String,
	)
	# Growing an Array may collect before its backing storage is reallocated.
	gate4_note_gc_state(context, true)
	gate4_invalidate_array_header_cache(context)
	if element_type == "Float"
		output.runtime_flags[0] = 1
		qbe_output_line(
			output,
			"\tcall $g4_array_push_d(l " + array + ", d " + operand + ")",
		)
		return
	end
	qbe_output_line(
		output,
		"\tcall $g4_array_push_paced(l " + array + ", l " + operand + ")",
	)
end

def gate4_emit_temporary(mut context: Gate4EmitContext): String
	index := context.temporary_count[0]
	context.temporary_count[0] = index + 1
	return "%t" + gate4_integer_string(index)
end

def gate4_owned_managed_local_count(context: Gate4EmitContext): Integer
	mut count := 0
	mut local_index := 0
	while local_index < context.local_count[0]
		if native_managed_type(gate4_load_string(context.local_types, local_index))
			if gate4_load_integer(context.local_inherited, local_index) == 0
				count += 1
			end
		end
		local_index += 1
	end
	return count
end

def gate4_emit_loop_root_compaction(mut context: Gate4EmitContext, mut output: QbeOutput)
	# Replace this function's temporary-root segment with its currently live
	# managed locals. The prologue reserves the maximum segment first, so loop
	# headers never reallocate while rewriting roots.
	managed_count := gate4_owned_managed_local_count(context)
	if managed_count == 0
		qbe_output_line(output, "\tcall $g4_gc_temp_reset(l %temporary_roots)")
		return
	end
	qbe_output_line(output, "{")
	data := gate4_emit_temporary(context)
	base_offset := gate4_emit_temporary(context)
	base := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + data + " =l loadl $g4_gc_temp_data")
	qbe_output_line(output, "\t" + base_offset + " =l mul %temporary_roots, 8")
	qbe_output_line(output, "\t" + base + " =l add " + data + ", " + base_offset)
	mut local_index := 0
	mut managed_index := 0
	while local_index < context.local_count[0]
		if native_managed_type(gate4_load_string(context.local_types, local_index))
			if gate4_load_integer(context.local_inherited, local_index) == 0
				gate4_note_gc_state(context, false)
				value := gate4_emit_temporary(context)
				mut slot := base
				if managed_index > 0
					slot = gate4_emit_temporary(context)
					qbe_output_line(
						output,
						"\t" + slot + " =l add " + base + ", " + gate4_integer_string(managed_index * 8),
					)
				end
				qbe_output_line(
					output,
					"\t" + value + " =l loadl " + gate4_load_string(context.local_slots, local_index),
				)
				qbe_output_line(output, "\tstorel " + value + ", " + slot)
				managed_index += 1
			end
		end
		local_index += 1
	end
	root_count := gate4_emit_temporary(context)
	qbe_output_line(
		output,
		"\t" + root_count + " =l add %temporary_roots, " + gate4_integer_string(managed_count),
	)
	qbe_output_line(output, "\tstorel " + root_count + ", $g4_gc_temp_count")
	qbe_output_line(output, "}")
	return
end

def gate4_function_reassigns_parameter(state: Gate4Compiler, function_index: Integer, name: String): Boolean
	mut index := gate4_load_integer(state.function_body_starts, function_index)
	finish := gate4_load_integer(state.function_body_ends, function_index)
	while index < finish
		if gate4_load_integer(state.token_kinds, index) == 1 && gate4_load_string(state.token_texts, index) == name
			next_token := gate4_load_string(state.token_texts, index + 1)
			if next_token == "=" || gate4_binary_operator_id(next_token) >= 17
				return true
			end
		end
		index += 1
	end
	return false
end

def gate4_emit_root_value(
		mut context: Gate4EmitContext,
		type_name: String,
	)
	if native_managed_type(type_name)
		# Managed results are produced by allocation or by calls whose allocation
		# behavior is intentionally opaque at this boundary.
		gate4_note_gc_state(context, true)
		context.temporary_roots_used[0] = 2
	end
	return
end

def gate4_note_managed_alias(
		mut context: Gate4EmitContext,
		type_name: String,
	)
	if native_managed_type(type_name)
		# The owner remains reachable through its caller, allocation, or managed
		# local root until the alias is consumed. Loop compaction transfers an
		# alias retained as a local, so a duplicate temporary root is unnecessary.
		gate4_note_gc_state(context, false)
	end
	return
end

def gate4_emit_label(mut context: Gate4EmitContext): String
	index := context.label_count[0]
	context.label_count[0] = index + 1
	return "@l" + gate4_integer_string(index)
end

def gate4_take_inline_budget(mut context: Gate4EmitContext): Boolean
	# Keep lexical-loop capacity independent from the bounded numeric-helper reserve.
	mut budget_index := 0
	if context.loop_depth[0] <= 0
		budget_index = 1
	end
	if context.inline_budget[budget_index] <= 0
		return false
	end
	context.inline_budget[budget_index] = context.inline_budget[budget_index] - 1
	return true
end

def gate4_integer_range_failure_label(mut context: Gate4EmitContext): String
	if context.scalar_inline_depth[0] > 0
		context.scalar_inline_range_failure_used[0] = true
		return "@scalar_inline_integer_range_failure"
	end
	return gate4_emit_label(context)
end

def gate4_emit_integer_range_failure(mut output: QbeOutput, failure: String)
	if failure == "@scalar_inline_integer_range_failure"
		return
	end
	qbe_output_line(output, failure)
	qbe_output_line(output, "\tcall $g4_fail(l $g4_integer_range_error, l 45)")
	qbe_output_line(output, "\thlt")
	return
end

def gate4_emit_checked_integer_operation(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		result: String,
		left: String,
		right: String,
		operation: String,
		right_nonnegative: Boolean,
	): String
	too_high := gate4_emit_temporary(context)
	failure := gate4_integer_range_failure_label(context)
	complete := gate4_emit_label(context)
	qbe_output_line(output, "\t" + result + " =l " + operation + " " + left + ", " + right)
	qbe_output_line(output, "\t" + too_high + " =w csgtl " + result + ", 9007199254740991")
	if right_nonnegative
		qbe_output_branch(output, too_high, failure, complete)
	else
		too_low := gate4_emit_temporary(context)
		check_low := gate4_emit_label(context)
		qbe_output_branch(output, too_high, failure, check_low)
		qbe_output_line(output, check_low)
		qbe_output_line(output, "\t" + too_low + " =w csltl " + result + ", -9007199254740991")
		qbe_output_branch(output, too_low, failure, complete)
	end
	gate4_emit_integer_range_failure(output, failure)
	qbe_output_line(output, complete)
	return complete
end

def gate4_emit_guarded_integer_operation(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		result: String,
		left: String,
		right: String,
		operation: String,
		limit: String,
		right_nonnegative: Boolean,
		guarded: Integer,
	)
	if right_nonnegative
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_operation(context, output, result, left, right, "mul", false)
			return
		end
	end
	if guarded == 0
		gate4_emit_integer_call(output, result, operation, left, right)
		return
	end
	combined := gate4_emit_temporary(context)
	small := gate4_emit_temporary(context)
	slow := gate4_emit_label(context)
	fast := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	if guarded == 13
		qbe_output_line(output, "\t" + combined + " =l add " + left + ", " + right)
	else
		qbe_output_line(output, "\t" + combined + " =l or " + left + ", " + right)
	end
	qbe_output_line(output, "\t" + small + " =w cultl " + combined + ", " + limit)
	qbe_output_branch(output, small, fast, slow)
	qbe_output_line(output, slow)
	gate4_emit_integer_call(output, result, operation, left, right)
	qbe_output_line(output, "\tjmp " + complete)
	qbe_output_line(output, fast)
	if guarded == 13
		qbe_output_line(output, "\t" + result + " =l copy " + combined)
	else
		qbe_output_line(output, "\t" + result + " =l " + operation + " " + left + ", " + right)
	end
	qbe_output_line(output, complete)
	return
end

def gate4_emit_checked_integer_division(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		result: String,
		left: String,
		right: String,
		operation: String,
	)
	zero := gate4_emit_temporary(context)
	failure := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	qbe_output_line(output, "\t" + zero + " =w ceql " + right + ", 0")
	qbe_output_branch(output, zero, failure, complete)
	qbe_output_line(output, failure)
	qbe_output_line(output, "\tcall $g4_fail(l $g4_division_error, l 24)")
	qbe_output_line(output, "\thlt")
	qbe_output_line(output, complete)
	qbe_output_line(output, "\t" + result + " =l " + operation + " " + left + ", " + right)
	return
end

def gate4_array_header_new(): Array<String>
	return ["@none", "", ""]
end

def gate4_invalidate_array_header_cache(mut context: Gate4EmitContext)
	context.array_header_fallback[0][0] = "@none"
	context.array_header_fallback[1][0] = "@none"
end

def gate4_emit_array_header(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		array: String,
		key: String,
		cache_index: Integer,
		offset: String,
	): String
	mut stable_index := 0
	while stable_index < context.array_header_count[0]
		stable := context.array_headers[stable_index]
		if key == stable[0]
			return stable[cache_index]
		end
		stable_index += 1
	end
	mut caches := context.array_header_fallback
	mut cache := caches[0]
	if key != ""
		if cache[0] != key
			previous_cache := cache
			cache = caches[1]
			if cache[0] != key
				cache[0] = key
				cache[1] = ""
				cache[2] = ""
			end
			caches[1] = previous_cache
			caches[0] = cache
		end
		cached := cache[cache_index]
		if cached != ""
			return cached
		end
	end
	address := gate4_emit_temporary(context)
	value := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + address + " =l add " + array + ", " + offset)
	qbe_output_line(output, "\t" + value + " =l loadl " + address)
	if key != ""
		cache[cache_index] = value
	end
	return value
end

def gate4_header_binding_selected(bindings: Array<Integer>, binding: Integer): Boolean
	mut index := 0
	while index < bindings.size()
		if bindings[index] == binding
			return true
		end
		index += 1
	end
	return false
end

# The adapter installs only bindings selected and verified by MIR.
def gate4_install_stable_array_header(mut context: Gate4EmitContext, mut output: QbeOutput, array: String, slot: String)
	length := gate4_emit_array_header(context, output, array, slot, 1, "8")
	data := gate4_emit_array_header(context, output, array, slot, 2, "24")
	index := context.array_header_count[0]
	if index == context.array_headers.size()
		context.array_headers.push([slot, length, data])
	else
		context.array_headers[index] = [slot, length, data]
	end
	context.array_header_count[0] = index + 1
end

# Placements and lexical slots have already been selected and verified by MIR.
def emit_loop_array_headers(mut context: Gate4EmitContext, mut output: QbeOutput, origin: Integer)
	mut index := 0
	while index < context.array_loop_headers.size()
		placement := context.array_loop_headers[index]
		if placement[0] == origin
			slot := gate4_load_string(context.local_slots, placement[2])
			array := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + array + " =l loadl " + slot)
			gate4_install_stable_array_header(context, output, array, slot)
		end
		index += 1
	end
end

def gate4_emit_array_data_address(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		data: String,
		index: String,
	): String
	offset := gate4_emit_temporary(context)
	address := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + offset + " =l mul " + index + ", 8")
	qbe_output_line(output, "\t" + address + " =l add " + data + ", " + offset)
	return address
end

def gate4_emit_array_address(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		array: String,
		array_key: String,
		requested: String,
		requested_nonnegative: Integer,
	): String
	length := gate4_emit_array_header(context, output, array, array_key, 1, "8")
	known_nonnegative := requested_nonnegative == 2
	mut index := requested
	valid := gate4_emit_temporary(context)
	load_label := gate4_emit_label(context)
	if !known_nonnegative
		negative_mask := gate4_emit_temporary(context)
		adjustment := gate4_emit_temporary(context)
		index = gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + negative_mask + " =l sar " + requested + ", 63")
		qbe_output_line(output, "\t" + adjustment + " =l and " + length + ", " + negative_mask)
		qbe_output_line(output, "\t" + index + " =l add " + requested + ", " + adjustment)
	end
	qbe_output_line(output, "\t" + valid + " =w cultl " + index + ", " + length)
	qbe_output_branch(output, valid, load_label, "@array_bounds_failure")
	context.array_bounds_failure_used[0] = true
	qbe_output_line(output, load_label)
	data := gate4_emit_array_header(context, output, array, array_key, 2, "24")
	return gate4_emit_array_data_address(context, output, data, index)
end

def gate4_emit_add_local(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		name: String,
		type_name: String,
		initial: String,
		inherited_root: Boolean,
	): String
	index := context.local_count[0]
	slot_index := context.slot_count[0]
	slot := "%v" + gate4_integer_string(slot_index)
	context.slot_count[0] = slot_index + 1
	gate4_store_string(context.local_names, index, name)
	gate4_store_string(context.local_types, index, type_name)
	gate4_store_string(context.local_slots, index, slot)
	gate4_store_integer(context.local_direct, index, 0)
	mut inherited := 0
	if inherited_root
		inherited = 1
	end
	gate4_store_integer(context.local_inherited, index, inherited)
	context.local_count[0] = index + 1
	if native_managed_type(type_name)
		if inherited == 0
			# Lexical blocks restore local_count, so retain the maximum active
			# managed-local count separately for the function prologue.
			managed_count := gate4_owned_managed_local_count(context)
			if managed_count > context.managed_local_high_water[0]
				context.managed_local_high_water[0] = managed_count
			end
		end
	end
	gate4_emit_typed_store(output, type_name, initial, slot)
	return slot
end

def gate4_emit_loaded_local(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		index: Integer,
	): Gate4EmittedValue
	type_name := gate4_load_string(context.local_types, index)
	if gate4_load_integer(context.local_direct, index) == 1
		return gate4_emitted_value(
			gate4_load_string(context.local_slots, index),
			type_name,
			0,
			"",
			"",
		)
	end
	operand := gate4_emit_temporary(context)
	gate4_emit_typed_load(
		output,
		operand,
		type_name,
		gate4_load_string(context.local_slots, index),
	)
	return gate4_emitted_value(
		operand,
		type_name,
		0,
		"",
		gate4_load_string(context.local_slots, index),
	)
end

def gate4_emit_address(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		base: String,
		offset: Integer,
	): String
	if offset == 0
		return base
	end
	address := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + address + " =l add " + base + ", " + gate4_integer_string(offset))
	return address
end

def emit_hash_root(mut context: Gate4EmitContext, mut output: QbeOutput, operand: String)
	qbe_output_line(output, "\tcall $g4_gc_temp_push(l " + operand + ")")
	context.temporary_roots_used[0] = 2
end

def emit_hash_bits(mut context: Gate4EmitContext, mut output: QbeOutput, operand: String, type_name: String): String
	if type_name != "Float"
		return operand
	end
	bits := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + bits + " =l cast " + operand)
	return bits
end

def emit_hash_value(mut context: Gate4EmitContext, mut output: QbeOutput, operand: String, type_name: String): Gate4EmittedValue
	if type_name == "Float"
		value := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + value + " =d cast " + operand)
		return gate4_emitted_value(value, type_name, 0, "", "")
	end
	if native_managed_type(type_name)
		emit_hash_root(context, output, operand)
	end
	return gate4_emitted_value(operand, type_name, 0, "", "")
end

def emit_hash_set(mut context: Gate4EmitContext, mut output: QbeOutput, owner: String, key: String, value: String, type_name: String)
	if native_managed_type(type_name)
		emit_hash_root(context, output, value)
	end
	bits := emit_hash_bits(context, output, value, type_name)
	qbe_output_line(output, "\tcall $g4_hash_set(l " + owner + ", l " + key + ", l " + bits + ")")
	gate4_note_gc_state(context, true)
end

def emit_hash_literal(mut state: Gate4Compiler, mut position: Array<Integer>, mut context: Gate4EmitContext, mut output: QbeOutput): Gate4EmittedValue
	origin := position[0]
	plan := checked_hash_plan(state, origin)
	checked_hash_require(state, origin, plan.type_name)
	if gate4_has_diagnostic(state)
		return gate4_emitted_value("0", "Invalid", 0, "", "")
	end
	output.runtime_flags[5] = 1
	mut flags := 0
	if mir_hash_key_managed(plan)
		flags = 1
	end
	if mir_hash_value_managed(plan)
		flags += 2
	end
	table := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + table + " =l call $g4_hash_new(l " + gate4_integer_string(plan.capacity) + ", l " + gate4_integer_string(flags) + ")")
	gate4_emit_root_value(context, plan.type_name)
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	mut entries := 0
	while !gate4_token_is(state, position[0], "}")
		key := gate4_emit_expression(state, position, context, output, 1, plan.key_type)
		if mir_hash_key_managed(plan)
			emit_hash_root(context, output, key.operand)
		end
		gate4_expect(state, position, "=>")
		value := gate4_emit_expression(state, position, context, output, 1, plan.value_type)
		emit_hash_set(context, output, table, key.operand, value.operand, plan.value_type)
		entries += 1
		gate4_skip_newlines(state, position)
		if !gate4_token_is(state, position[0], ",")
			break
		end
		gate4_advance(position)
		gate4_skip_newlines(state, position)
	end
	if entries != plan.entries || position[0] != plan.finish
		gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, origin), "invalid checked Hash literal extent")
	end
	gate4_expect(state, position, "}")
	return gate4_emitted_value(table, plan.type_name, 0, "", "")
end

def emit_hash_index(mut state: Gate4Compiler, mut position: Array<Integer>, mut context: Gate4EmitContext, mut output: QbeOutput, receiver: Gate4EmittedValue): Gate4EmittedValue
	plan := checked_hash_require(state, position[0], receiver.type_name)
	if gate4_has_diagnostic(state)
		return receiver
	end
	output.runtime_flags[5] = 1
	emit_hash_root(context, output, receiver.operand)
	gate4_advance(position)
	key := gate4_emit_expression(state, position, context, output, 1, plan.key_type)
	if mir_hash_key_managed(plan)
		emit_hash_root(context, output, key.operand)
	end
	gate4_expect(state, position, "]")
	if plan.kind == 3
		return Gate4EmittedValue.new(operand: "0", type_name: plan.value_type, category: 4, name: "", slot: key.operand, owner: receiver.operand)
	end
	result := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + result + " =l call $g4_hash_get(l " + receiver.operand + ", l " + key.operand + ")")
	return emit_hash_value(context, output, result, plan.value_type)
end

def emit_hash_method(mut state: Gate4Compiler, mut position: Array<Integer>, mut context: Gate4EmitContext, mut output: QbeOutput, receiver: Gate4EmittedValue): Gate4EmittedValue
	plan := checked_hash_require(state, position[0], receiver.type_name)
	if gate4_has_diagnostic(state)
		return receiver
	end
	output.runtime_flags[5] = 1
	emit_hash_root(context, output, receiver.operand)
	gate4_advance(position)
	mut argument := ""
	if plan.kind == 5 || plan.kind == 6 || plan.kind == 13
		key := gate4_emit_expression(state, position, context, output, 1, plan.key_type)
		argument = key.operand
		if mir_hash_key_managed(plan)
			emit_hash_root(context, output, argument)
		end
	end
	if plan.kind == 8 || plan.kind == 9
		other := gate4_emit_expression(state, position, context, output, 1, plan.type_name)
		argument = other.operand
		emit_hash_root(context, output, argument)
	end
	gate4_skip_newlines(state, position)
	gate4_expect(state, position, ")")
	result := gate4_emit_temporary(context)
	if plan.kind == 4 || plan.kind == 12
		address := gate4_emit_address(context, output, receiver.operand, 8)
		qbe_output_line(output, "\t" + result + " =l loadl " + address)
		if plan.kind == 12
			empty := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + empty + " =l ceql " + result + ", 0")
			return gate4_emitted_value(empty, "Boolean", 0, "", "")
		end
		return gate4_emitted_value(result, "Integer", 0, "", "")
	end
	if plan.kind == 5 || plan.kind == 6 || plan.kind == 13
		mut operation := "contains"
		mut type_name := "Boolean"
		if plan.kind == 13
			operation = "get"
			type_name = plan.value_type
		end
		if plan.kind == 6
			operation = "delete"
			type_name = plan.value_type
			gate4_note_gc_state(context, true)
		end
		qbe_output_line(output, "\t" + result + " =l call $g4_hash_" + operation + "(l " + receiver.operand + ", l " + argument + ")")
		return emit_hash_value(context, output, result, type_name)
	end
	if plan.kind == 10 || plan.kind == 11
		mut selection := "0"
		mut element := plan.key_type
		if plan.kind == 11
			selection = "1"
			element = plan.value_type
		end
		qbe_output_line(output, "\t" + result + " =l call $g4_hash_entries(l " + receiver.operand + ", l " + selection + ")")
		gate4_emit_root_value(context, gate4_array_type(element))
		return gate4_emitted_value(result, gate4_array_type(element), 0, "", "")
	end
	mut target := receiver.operand
	if plan.kind == 7 || plan.kind == 8
		address := gate4_emit_address(context, output, receiver.operand, 16)
		capacity := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + capacity + " =l loadl " + address)
		qbe_output_line(output, "\t" + result + " =l call $g4_hash_copy(l " + receiver.operand + ", l " + capacity + ")")
		gate4_emit_root_value(context, receiver.type_name)
		target = result
	end
	if plan.kind == 8 || plan.kind == 9
		qbe_output_line(output, "\tcall $g4_hash_update(l " + target + ", l " + argument + ")")
		gate4_note_gc_state(context, true)
	end
	if plan.kind == 9
		return gate4_emitted_value("", "Void", 0, "", "")
	end
	return gate4_emitted_value(target, receiver.type_name, 0, "", "")
end

def gate4_emit_array_literal(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		expected: String,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	contextual_element_type := gate4_array_element_type(expected)
	mut element_type := contextual_element_type
	mut operands: Array<String> := []
	mut value_types: Array<String> := []
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], "]")
			finished = true
		else
			value := gate4_emit_expression(state, position, context, output, 1, contextual_element_type)
			operands.push(value.operand)
			value_types.push(value.type_name)
			if contextual_element_type == ""
				element_type = gate4_common_array_element_type(element_type, value.type_name)
			end
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, "]")
	array := gate4_emit_temporary(context)
	mut descriptor := "$g4_desc_array_scalar"
	if native_managed_type(element_type)
		descriptor = "$g4_desc_array_managed"
	end
	qbe_output_line(
		output,
		"\t" + array + " =l call $g4_array_new(l " + descriptor + ")",
	)
	gate4_emit_root_value(context, gate4_array_type(element_type))
	mut index := 0
	while index < operands.size()
		mut operand := operands[index]
		if element_type == "Float"
			if value_types[index] == "Integer"
				converted := gate4_emit_temporary(context)
				qbe_output_line(output, "\t" + converted + " =d sltof " + operand)
				operand = converted
			end
		end
		gate4_emit_array_push(context, output, array, element_type, operand)
		index += 1
	end
	return gate4_emitted_value(array, gate4_array_type(element_type), 0, "", "")
end

def gate4_scalar_type_name(type_id: Integer): String
	if type_id == 1
		return "Integer"
	end
	if type_id == 2
		return "Boolean"
	end
	if type_id == 5
		return "Float"
	end
	if type_id == 3
		return "Array<Integer>"
	end
	if type_id == 4
		return "Address"
	end
	return "Invalid"
end

def gate4_emit_scalar_mir_body(
		state: Gate4Compiler,
		function_index: Integer,
		argument_operands: Array<String>,
		argument_types: Array<String>,
		argument_facts: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		inline: Boolean,
		safe: Boolean,
	): Gate4EmittedValue
	saved_inline_depth := context.scalar_inline_depth[0]
	if inline
		context.scalar_inline_depth[0] = saved_inline_depth + 1
	end
	mut operands: Array<String> := []
	mut types: Array<String> := []
	mut facts: Array<Integer> := []
	mut index := 0
	while index < argument_operands.size()
		operands.push(argument_operands[index])
		types.push(argument_types[index])
		facts.push(argument_facts[index])
		index += 1
	end
	function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, function_index)]
	block := state.scalar_mir.blocks[gate4_mir_block_index(state.scalar_mir, function, function.entry_block)]
	index = block.instruction_start
	finish := index + block.instruction_count
	while index < finish
		instruction := state.scalar_mir.instructions[index]
		result_type := gate4_scalar_type_name(
			gate4_mir_value_type(state.scalar_mir, function_index, instruction.result),
		)
		mut result := gate4_emitted_value("", result_type, 0, "", "")
		mut result_fact := 0
		if instruction.kind == 6
			literal := gate4_number_without_underscores(state.scalar_mir.literal_texts[instruction.payload])
			mut operand := literal
			if result_type == "Boolean"
				operand = "0"
				if literal == "true"
					operand = "1"
				end
			end
			if result_type == "Float"
				operand = "d_" + literal
			end
			result = gate4_emitted_value(operand, result_type, 0, "", "")
			result_fact = instruction.first
		else
			if instruction.kind == 7
				left_id := instruction.first
				right_id := instruction.second
				mut operator_id := instruction.payload
				mut guarded_operator := instruction.payload
				if operator_id == 12
					operator_id = 3
				end
				if operator_id == 13
					operator_id = 1
				end
				if !inline
					guarded_operator = 0
				end
				mut operand := ""
				if safe && result_type == "Integer"
					operand = gate4_emit_temporary(context)
					mut operation := "add"
					if operator_id == 3
						operation = "mul"
					elsif operator_id == 4
						operation = "udiv"
					end
					qbe_output_line(output, "\t" + operand + " =l " + operation + " " + operands[left_id] + ", " + operands[right_id])
				else
					operand = lower_binary_operand(
						context,
						output,
						operator_id,
						gate4_emitted_value(operands[left_id], types[left_id], 0, "", ""),
						gate4_emitted_value(operands[right_id], types[right_id], 0, "", ""),
						result_type,
						facts[left_id] == 1,
						facts[right_id] == 1,
						guarded_operator,
					)
				end
				result = gate4_emitted_value(operand, result_type, 0, "", "")
			else
				if instruction.kind == 8
					value_id := instruction.first
					if instruction.payload == 1
						operand := gate4_emit_temporary(context)
						qbe_output_line(output, "\t" + operand + " =l ceql " + operands[value_id] + ", 0")
						result = gate4_emitted_value(operand, "Boolean", 0, "", "")
					else
						if instruction.payload == 2
							operand := gate4_emit_temporary(context)
							if result_type == "Float"
								qbe_output_line(output, "\t" + operand + " =d sub d_-0.0, " + operands[value_id])
							else
								qbe_output_line(output, "\t" + operand + " =l call $g4_integer_subtract(l 0, l " + operands[value_id] + ")")
							end
							result = gate4_emitted_value(operand, result_type, 0, "", "")
						else
							result = gate4_emitted_value(operands[value_id], result_type, 0, "", "")
							result_fact = facts[value_id]
						end
					end
				else
					value_id := instruction.first
					operand := gate4_emit_temporary(context)
					qbe_output_line(output, "\t" + operand + " =d sltof " + operands[value_id])
					result = gate4_emitted_value(operand, "Float", 0, "", "")
				end
			end
		end
		operands.push(result.operand)
		types.push(result.type_name)
		facts.push(result_fact)
		index += 1
	end
	context.scalar_inline_depth[0] = saved_inline_depth
	return gate4_emitted_value(operands[block.return_value], types[block.return_value], 0, "", "")
end

def gate4_emit_scalar_mir(
		state: Gate4Compiler,
		function_index: Integer,
		argument_operands: Array<String>,
		argument_types: Array<String>,
		argument_facts: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		inline: Boolean,
	): Gate4EmittedValue
	function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, function_index)]
	if !inline || function.integer_guard == 0
		return gate4_emit_scalar_mir_body(state, function_index, argument_operands, argument_types, argument_facts, context, output, inline, false)
	end
	mut combined := argument_operands[0]
	mut index := 1
	while index < argument_operands.size()
		merged := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + merged + " =l or " + combined + ", " + argument_operands[index])
		combined = merged
		index += 1
	end
	valid := gate4_emit_temporary(context)
	fast := gate4_emit_label(context)
	slow := gate4_emit_label(context)
	complete := gate4_emit_label(context)
	result := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + valid + " =w cultl " + combined + ", " + gate4_integer_string(function.integer_guard))
	qbe_output_branch(output, valid, fast, slow)
	qbe_output_line(output, slow)
	checked := gate4_emit_scalar_mir_body(state, function_index, argument_operands, argument_types, argument_facts, context, output, inline, false)
	mut width := "l"
	if checked.type_name == "Float"
		width = "d"
	end
	qbe_output_line(output, "\t" + result + " =" + width + " copy " + checked.operand)
	qbe_output_line(output, "\tjmp " + complete)
	qbe_output_line(output, fast)
	unchecked := gate4_emit_scalar_mir_body(state, function_index, argument_operands, argument_types, argument_facts, context, output, inline, true)
	qbe_output_line(output, "\t" + result + " =" + width + " copy " + unchecked.operand)
	qbe_output_line(output, complete)
	return gate4_emitted_value(result, checked.type_name, 0, "", "")
end

def gate4_emit_scalar_mir_direct_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		function_index: Integer,
		parameter_start: Integer,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
	): Gate4EmittedValue
	mut argument_operands: Array<String> := []
	mut argument_types: Array<String> := []
	mut argument_facts: Array<Integer> := []
	mut argument_count := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			argument_origin := position[0]
			expected := gate4_load_string(state.parameter_types, parameter_start + argument_count)
			value := gate4_emit_expression(state, position, context, output, 1, expected)
			argument_operands.push(value.operand)
			argument_types.push(value.type_name)
			argument_facts.push(gate4_load_integer(state.mir_nonnegative_facts, argument_origin))
			argument_count += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	return gate4_emit_scalar_mir(
		state,
		function_index,
		argument_operands,
		argument_types,
		argument_facts,
		context,
		output,
		true,
	)
end

def gate4_emit_induction_mir(
		state: Gate4Compiler,
		function_index: Integer,
		element_type: String,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
	)
	function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, function_index)]
	header := state.scalar_mir.blocks[function.block_start + 1]
	body := state.scalar_mir.blocks[function.block_start + 2]
	address_instruction := state.scalar_mir.instructions[body.instruction_start]
	if address_instruction.payload != 2
		return
	end
	float_elements := element_type == "Float"
	reduction := header.parameter_count == 2
	header_label := gate4_emit_label(context)
	body_label := gate4_emit_label(context)
	exit_label := gate4_emit_label(context)
	index := gate4_emit_temporary(context)
	advanced := gate4_emit_temporary(context)
	mut accumulator := ""
	mut accumulated := ""
	if reduction
		accumulator = gate4_emit_temporary(context)
		accumulated = gate4_emit_temporary(context)
	end
	length := gate4_emit_array_header(context, output, "%p0", "", 1, "8")
	data := gate4_emit_array_header(context, output, "%p0", "", 2, "24")
	qbe_output_line(output, "\tjmp " + header_label)
	qbe_output_line(output, header_label)
	phi_line := output.count[0]
	qbe_output_line(output, "")
	mut accumulator_phi_line :=- 1
	if reduction
		accumulator_phi_line = output.count[0]
		qbe_output_line(output, "")
	end
	condition := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + condition + " =w csltl " + index + ", " + length)
	qbe_output_branch(output, condition, body_label, exit_label)
	qbe_output_line(output, body_label)
	address := gate4_emit_array_data_address(context, output, data, index)
	loaded := gate4_emit_temporary(context)
	gate4_emit_typed_load(output, loaded, element_type, address)
	mut increment_predecessor := body_label
	if reduction
		if float_elements
			qbe_output_line(output, "\t" + accumulated + " =d add " + accumulator + ", " + loaded)
		else
			increment_predecessor = gate4_emit_checked_integer_operation(
				context,
				output,
				accumulated,
				accumulator,
				loaded,
				"add",
				false,
			)
		end
	end
	qbe_output_line(output, "\t" + advanced + " =l add " + index + ", 1")
	gate4_store_string(
		output.lines,
		phi_line,
		"\t" + index + " =l phi @start 0, " + increment_predecessor + " " + advanced,
	)
	if reduction
		mut phi_operation := " =l phi @start 0, "
		if float_elements
			phi_operation = " =d phi @start d_0.0, "
		end
		gate4_store_string(
			output.lines,
			accumulator_phi_line,
			"\t" + accumulator + phi_operation +
			increment_predecessor + " " + accumulated,
		)
	end
	qbe_output_line(output, "\tjmp " + header_label)
	qbe_output_line(output, exit_label)
	if reduction
		gate4_emit_typed_store(output, element_type, accumulator, "%return_value")
	end
	qbe_output_line(output, "\tjmp @return")
end

def gate4_emit_direct_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		callee: Gate4EmittedValue,
	): Gate4EmittedValue
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	function_index := gate4_find_visible_function(state, state.active_module[0], callee.name)
	mut parameter_start := 0
	mut result_type := "Void"
	if callee.category == 4
		result_type = "Array<String>"
	else
		if callee.category == 5
			result_type = "Float"
		end
	end
	if function_index >= 0
		parameter_start = gate4_load_integer(state.function_parameter_starts, function_index)
		result_type = gate4_load_string(state.function_result_types, function_index)
	end
	if function_index >= 0
		if state.function_count[0] <= 32
			if gate4_scalar_leaf_inline_eligible(state, function_index)
				if context.loop_depth[0] > 0
					if context.inline_budget[2] > 0
						context.inline_budget[2] = context.inline_budget[2] - 1
						return gate4_emit_scalar_mir_direct_call(
							state,
							position,
							function_index,
							parameter_start,
							context,
							output,
						)
					end
				end
			end
		end
	end
	mut arguments := ""
	mut puts_runtime := "$g4_puts"
	mut argument_count := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			mut expected := "String"
			if callee.category == 5
				expected = "Float"
			end
			if function_index >= 0
				expected = gate4_load_string(state.parameter_types, parameter_start + argument_count)
			end
			if callee.name == "puts"
				expected = ""
			end
			value := gate4_emit_expression(state, position, context, output, 1, expected)
			mut operand := value.operand
			if callee.name == "puts"
				if value.type_name == "Integer"
					output.runtime_flags[1] = 1
					operand = gate4_emit_temporary(context)
					qbe_output_line(output, "\t" + operand + " =l call $g4_integer_to_string(l " + value.operand + ")")
					gate4_emit_root_value(context, "String")
				end
				if value.type_name == "Boolean"
					puts_runtime = "$g4_puts_boolean"
					output.runtime_flags[4] = 1
				end
			end
			if arguments != ""
				arguments += ", "
			end
			arguments += gate4_qbe_type(value.type_name) + " " + operand
			argument_count += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	if callee.category == 5
		result := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + result + " =d call $sqrt(" + arguments + ")")
		return gate4_emitted_value(result, result_type, 0, "", "")
	end
	gate4_invalidate_array_header_cache(context)
	if callee.category == 4
		output.runtime_flags[1] = 1
		result := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + result + " =l call $g4_process_argv()")
		gate4_emit_root_value(context, result_type)
		return gate4_emitted_value(result, result_type, 0, "", "")
	end
	if gate4_compiler_entry_function(state) >= 0
		if function_index >= 0
			if gate4_load_string(state.module_names, gate4_load_integer(state.function_modules, function_index)) == "host"
				if gate4_find_function_in_module(state, state.entry_module[0], "native_cli_main") >= 0
					result := gate4_emit_temporary(context)
					qbe_output_line(output, "\t" + result + " =" + gate4_qbe_type(result_type) + " call $" + callee.name + "(" + arguments + ")")
					gate4_emit_root_value(context, result_type)
					return gate4_emitted_value(result, result_type, 0, "", "")
				end
			end
		end
		if callee.name == "gate4_file_exists"
			result := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $g4_file_exists(" + arguments + ")")
			return gate4_emitted_value(result, "Boolean", 0, "", "")
		end
		if callee.name == "gate4_read_source"
			result := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $g4_read_source(" + arguments + ")")
			gate4_emit_root_value(context, "String")
			return gate4_emitted_value(result, "String", 0, "", "")
		end
		if callee.name == "gate4_source_slice"
			result := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $g4_source_slice(" + arguments + ")")
			gate4_emit_root_value(context, "String")
			return gate4_emitted_value(result, "String", 0, "", "")
		end
		if callee.name == "gate4_collect_project_sources"
			result := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $g4_collect_project_sources(" + arguments + ")")
			gate4_emit_root_value(context, result_type)
			return gate4_emitted_value(result, result_type, 0, "", "")
		end
	end
	if callee.name == "puts"
		qbe_output_line(output, "\tcall " + puts_runtime + "(" + arguments + ")")
		return gate4_emitted_value("", "Void", 0, "", "")
	end
	if callee.name == "gate4_eputs"
		qbe_output_line(output, "\tcall $g4_eputs(" + arguments + ")")
		return gate4_emitted_value("", "Void", 0, "", "")
	end
	if callee.name == "gate4_reset_temporary_storage"
		qbe_output_line(output, "\tcall $g4_temp_reset()")
		return gate4_emitted_value("", "Void", 0, "", "")
	end
	if context.inline_budget[2] >= 0
		if gate4_scalar_leaf_inline_eligible(state, function_index)
			context.inline_budget[2] =- 1
		end
	end
	# Until interprocedural no-allocation summaries exist, every ordinary
	# TypeRB call remains a conservative GC safe point.
	gate4_note_gc_state(context, true)
	if result_type == "Void"
		qbe_output_line(
			output,
			"\tcall $g4f" + gate4_integer_string(function_index) + "(" + arguments + ")",
		)
		return gate4_emitted_value("", "Void", 0, "", "")
	end
	result := gate4_emit_temporary(context)
	qbe_output_line(
		output,
		"\t" + result + " =" + gate4_qbe_type(result_type) + " call $g4f" +
		gate4_integer_string(function_index) + "(" + arguments + ")",
	)
	gate4_emit_root_value(context, result_type)
	return gate4_emitted_value(result, result_type, 0, "", "")
end

def gate4_emit_record_new(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		record_name: String,
	): Gate4EmittedValue
	record_index := gate4_find_visible_record(state, state.active_module[0], record_name)
	field_start := gate4_load_integer(state.record_field_starts, record_index)
	field_count := gate4_load_integer(state.record_field_counts, record_index)
	record_value := gate4_emit_temporary(context)
	qbe_output_line(
		output,
		"\t" + record_value + " =l call $g4_gc_alloc(l $g4_desc_record" +
		gate4_integer_string(record_index) + ", l " + gate4_integer_string(field_count * 8) + ", l 0)",
	)
	gate4_emit_root_value(context, gate4_record_type(record_index))
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	mut field_offset := 0
	mut finished := false
	while !finished
		if gate4_token_is(state, position[0], ")")
			finished = true
		else
			gate4_expect_identifier(state, position)
			gate4_expect(state, position, ":")
			value := gate4_emit_expression(
				state,
				position,
				context,
				output,
				1,
				gate4_load_string(state.field_types, field_start + field_offset),
			)
			address := gate4_emit_address(context, output, record_value, 8 + field_offset * 8)
			gate4_emit_typed_store(
				output,
				gate4_load_string(state.field_types, field_start + field_offset),
				value.operand,
				address,
			)
			field_offset += 1
			if gate4_token_is(state, position[0], ",")
				gate4_advance(position)
				gate4_skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	gate4_expect(state, position, ")")
	return gate4_emitted_value(record_value, gate4_record_type(record_index), 0, "", "")
end

def gate4_emit_method_call(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		receiver: Gate4EmittedValue,
		method: String,
	): Gate4EmittedValue
	if hash_key_type(receiver.type_name) != ""
		return emit_hash_method(state, position, context, output, receiver)
	end
	gate4_advance(position)
	gate4_skip_newlines(state, position)
	if method == "size"
		gate4_expect(state, position, ")")
		mut key := receiver.slot
		mut stable := false
		mut header_index := 0
		while header_index < context.array_header_count[0]
			if context.array_headers[header_index][0] == key
				stable = true
			end
			header_index += 1
		end
		if !stable
			key = ""
		end
		result := gate4_emit_array_header(
			context, output, receiver.operand, key, 1, "8",
		)
		return gate4_emitted_value(result, "Integer", 0, "", "")
	end
	if method == "push"
		element_type := gate4_array_element_type(receiver.type_name)
		value := gate4_emit_expression(state, position, context, output, 1, element_type)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		gate4_emit_array_push(context, output, receiver.operand, element_type, value.operand)
		return gate4_emitted_value("", "Void", 0, "", "")
	end
	if method == "to_i"
		gate4_expect(state, position, ")")
		result := gate4_emit_temporary(context)
		output.runtime_flags[1] = 1
		mut conversion := "$g4_float_to_integer(d "
		if receiver.type_name == "String"
			conversion = "$g4_string_to_integer(l "
		end
		qbe_output_line(output, "\t" + result + " =l call " + conversion + receiver.operand + ")")
		return gate4_emitted_value(result, "Integer", 0, "", "")
	end
	if method == "to_s"
		gate4_expect(state, position, ")")
		output.runtime_flags[1] = 1
		result := gate4_emit_temporary(context)
		qbe_output_line(
			output,
			"\t" + result + " =l call $g4_integer_to_string(l " + receiver.operand + ")",
		)
		gate4_emit_root_value(context, "String")
		return gate4_emitted_value(result, "String", 0, "", "")
	end
	return gate4_emitted_value("", "Invalid", 0, "", "")
end

def gate4_emit_postfix(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		initial: Gate4EmittedValue,
	): Gate4EmittedValue
	mut value := Gate4EmittedValue.new(
		operand: initial.operand,
		type_name: initial.type_name,
		category: initial.category,
		name: initial.name,
		slot: initial.slot,
		owner: initial.owner,
	)
	mut scanning := true
	while scanning
		if gate4_token_is(state, position[0], "[") && hash_key_type(value.type_name) != ""
			value = emit_hash_index(state, position, context, output, value)
			if gate4_has_diagnostic(state)
				return value
			end
			next
		end
		if gate4_token_is(state, position[0], "(")
			value = gate4_emit_direct_call(state, position, context, output, value)
		else
			if gate4_token_is(state, position[0], ".")
				gate4_advance(position)
				member := gate4_expect_identifier(state, position)
				if member == "each" && syntax_iteration_suffix(state, position[0] - 2) >= 0
					position[0] -= 2
					break
				end
				if gate4_token_is(state, position[0], "(")
					if value.category < 4
						if value.category == 2
							value = gate4_emit_record_new(state, position, context, output, value.name)
						else
							value = gate4_emit_method_call(state, position, context, output, value, member)
						end
					end
				else
					record_index := gate4_find_record_type(state, value.type_name)
					field_index := gate4_find_field(state, record_index, member)
					offset := 8 + (field_index - gate4_load_integer(state.record_field_starts, record_index)) * 8
					address := gate4_emit_address(context, output, value.operand, offset)
					operand := gate4_emit_temporary(context)
					field_type := gate4_load_string(state.field_types, field_index)
					gate4_emit_typed_load(output, operand, field_type, address)
					gate4_note_managed_alias(context, field_type)
					value = gate4_emitted_value(
						operand,
						field_type,
						0,
						member,
						address,
					)
				end
			else
				if gate4_token_is(state, position[0], "[")
					index_origin := position[0]
					store_origin := checked_array_assignment_store(state, index_origin)
					if store_origin == - 2
						gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, index_origin), "invalid checked Array assignment target")
						return value
					end
					mut assignment_plan := 0
					if store_origin >= 0
						assignment_plan = checked_array_assignment_plan(state, index_origin)
						if assignment_plan < 0
							gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, index_origin), "invalid checked Array assignment region")
							return value
						end
					end
					if store_origin >= 0
						if assignment_plan < 2
							# Retain the selected owner even if index/RHS calls replace its
							# last other reference and collect before the final store.
							qbe_output_line(output, "\tcall $g4_gc_temp_push(l " + value.operand + ")")
							context.temporary_roots_used[0] = 2
						end
					end
					gate4_advance(position)
					index := gate4_emit_expression(state, position, context, output, 1, "Integer")
					if value.type_name == "String"
						result := gate4_emit_temporary(context)
						qbe_output_line(
							output,
							"\t" + result + " =l call $g4_string_index(l " + value.operand + ", l " + index.operand + ")",
						)
						gate4_emit_root_value(context, "String")
						value = gate4_emitted_value(result, "String", 0, "", "")
					else
						mut address := ""
						mut inline_address := false
						if context.loop_depth[0] > 0
							if gate4_take_inline_budget(context)
								inline_address = true
							end
						end
						if inline_address
							address = gate4_emit_array_address(
								context,
								output,
								value.operand,
								value.slot,
								index.operand,
								gate4_mir_nonnegative_fact(state, position[0]),
							)
						else
							output.runtime_flags[3] = 1
							address = gate4_emit_temporary(context)
							qbe_output_line(
								output,
								"\t" + address + " =l call $g4_array_address(l " + value.operand + ", l " + index.operand + ")",
							)
						end
						element_type := gate4_array_element_type(value.type_name)
						operand := gate4_emit_temporary(context)
						gate4_emit_typed_load(output, operand, element_type, address)
						gate4_note_managed_alias(context, element_type)
						mut owner := ""
						mut retained_position := ""
						if store_origin >= 0
							owner = value.operand
							retained_position = address
							if assignment_plan == 0
								if checked_array_assignment_reads_old(state, index_origin)
									if native_managed_type(element_type)
										qbe_output_line(output, "\tcall $g4_gc_temp_push(l " + operand + ")")
									end
								end
								# The checked address and current data share the same ABI
								# allocation here. Retain only the logical slot across RHS.
								data_slot := gate4_emit_address(context, output, owner, 24)
								data := gate4_emit_temporary(context)
								offset := gate4_emit_temporary(context)
								retained_position = gate4_emit_temporary(context)
								qbe_output_line(output, "\t" + data + " =l loadl " + data_slot)
								qbe_output_line(output, "\t" + offset + " =l sub " + address + ", " + data)
								qbe_output_line(output, "\t" + retained_position + " =l shr " + offset + ", 3")
							end
						end
						value = Gate4EmittedValue.new(
							operand: operand,
							type_name: element_type,
							category: 3,
							name: "",
							slot: retained_position,
							owner: owner,
						)
					end
					gate4_expect(state, position, "]")
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def gate4_emit_primary(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		expected: String,
	): Gate4EmittedValue
	token_index := position[0]
	kind := gate4_load_integer(state.token_kinds, token_index)
	if kind == 2
		value := gate4_number_without_underscores(gate4_load_string(state.token_texts, token_index))
		gate4_advance(position)
		if gate4_number_is_float(value)
			return gate4_emitted_value("d_" + value, "Float", 0, "", "")
		end
		return gate4_emitted_value(value, "Integer", 0, "", "")
	end
	if kind == 3
		gate4_advance(position)
		return gate4_emitted_value("$g4s" + gate4_integer_string(gate4_load_integer(state.token_lines, token_index)), "String", 0, "", "")
	end
	if gate4_token_is(state, token_index, "{")
		return emit_hash_literal(state, position, context, output)
	end
	if gate4_token_is(state, token_index, "[")
		return gate4_emit_array_literal(state, position, context, output, expected)
	end
	if gate4_token_is(state, token_index, "(")
		gate4_advance(position)
		gate4_skip_newlines(state, position)
		value := gate4_emit_expression_value(state, position, context, output, 1, expected)
		gate4_skip_newlines(state, position)
		gate4_expect(state, position, ")")
		return value
	end
	if gate4_token_is(state, token_index, "!")
		gate4_advance(position)
		value := gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, "Boolean"),
		)
		result := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + result + " =l ceql " + value.operand + ", 0")
		return gate4_emitted_value(result, "Boolean", 0, "", "")
	end
	if gate4_token_is(state, token_index, "-")
		gate4_advance(position)
		value := gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, ""),
		)
		result := gate4_emit_temporary(context)
		if value.type_name == "Float"
			qbe_output_line(output, "\t" + result + " =d sub d_-0.0, " + value.operand)
			return gate4_emitted_value(result, "Float", 0, "", "")
		end
		qbe_output_line(output, "\t" + result + " =l call $g4_integer_subtract(l 0, l " + value.operand + ")")
		return gate4_emitted_value(result, "Integer", 0, "", "")
	end
	if gate4_token_is(state, token_index, "+")
		gate4_advance(position)
		return gate4_emit_postfix(
			state,
			position,
			context,
			output,
			gate4_emit_primary(state, position, context, output, ""),
		)
	end
	if kind == 1
		name := gate4_load_string(state.token_texts, token_index)
		gate4_advance(position)
		if name == "true"
			return gate4_emitted_value("1", "Boolean", 0, "", "")
		end
		if name == "false"
			return gate4_emitted_value("0", "Boolean", 0, "", "")
		end
		mut local_index := context.local_count[0] - 1
		mut found_local :=- 1
		while local_index >= 0
			if gate4_load_string(context.local_names, local_index) == name
				found_local = local_index
				local_index =- 1
			else
				local_index -= 1
			end
		end
		if found_local >= 0
			return gate4_emit_loaded_local(context, output, found_local)
		end
		standard_package := gate4_standard_package_import(state, state.active_module[0], name)
		if standard_package < - 1
			return gate4_emitted_value("", gate4_standard_package_root(standard_package), 2 - standard_package, name, "")
		end
		if name == "puts"
			return gate4_emitted_value("", "", 1, name, "")
		end
		if gate4_find_visible_function(state, state.active_module[0], name) >= 0
			return gate4_emitted_value("", "", 1, name, "")
		end
		if gate4_find_visible_record(state, state.active_module[0], name) >= 0
			return gate4_emitted_value("", "", 2, name, "")
		end
	end
	return gate4_emitted_value("", "Invalid", 0, "", "")
end

def gate4_emit_integer_call(
		mut output: QbeOutput,
		result: String,
		operation: String,
		left: String,
		right: String,
	)
	qbe_output_line(
		output,
		"\t" + result + " =l call $g4_integer_" + operation + "(l " + left + ", l " + right + ")",
	)
	return
end

# The checked-program or verified-MIR caller owns result metadata. This
# adapter returns only the backend operand, including for comparisons.
def lower_binary_operand(
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		operator_id: Integer,
		left: Gate4EmittedValue,
		right: Gate4EmittedValue,
		result_type: String,
		left_nonnegative: Boolean,
		right_nonnegative: Boolean,
		guarded_operator: Integer,
	): String
	left_float := left.type_name == "Float"
	right_float := right.type_name == "Float"
	mut float_operands := left_float
	if right_float
		float_operands = true
	end
	result := gate4_emit_temporary(context)
	mut left_operand := left.operand
	mut right_operand := right.operand
	if float_operands
		if !left_float
			converted_left := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + converted_left + " =d sltof " + left_operand)
			left_operand = converted_left
		end
		if !right_float
			converted_right := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + converted_right + " =d sltof " + right_operand)
			right_operand = converted_right
		end
	end
	if result_type == "Float"
		mut operation := "add"
		if operator_id == 2
			operation = "sub"
		end
		if operator_id == 3
			operation = "mul"
		end
		if operator_id == 4
			operation = "div"
		end
		qbe_output_line(output, "\t" + result + " =d " + operation + " " + left_operand + ", " + right_operand)
		return result
	end
	if operator_id == 1
		if left.type_name == "String"
			qbe_output_line(
				output,
				"\t" + result + " =l call $g4_string_concat(l " + left.operand + ", l " + right.operand + ")",
			)
			gate4_emit_root_value(context, "String")
		else
			mut use_guarded_add := guarded_operator == 13
			if left_nonnegative
				use_guarded_add = false
			end
			if right_nonnegative
				use_guarded_add = false
			end
			if use_guarded_add
				gate4_emit_guarded_integer_operation(
					context,
					output,
					result,
					left_operand,
					right_operand,
					"add",
					"9007199254740992",
					false,
					13,
				)
			else
				if gate4_take_inline_budget(context)
					mut known_nonnegative := right_nonnegative
					if left_nonnegative
						left_operand = right.operand
						right_operand = left.operand
						known_nonnegative = true
					end
					gate4_emit_checked_integer_operation(
						context,
						output,
						result,
						left_operand,
						right_operand,
						"add",
						known_nonnegative,
					)
				else
					gate4_emit_integer_call(output, result, "add", left.operand, right.operand)
				end
			end
		end
		return result
	end
	if operator_id == 2
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_operation(
				context,
				output,
				result,
				left.operand,
				right.operand,
				"sub",
				false,
			)
		else
			gate4_emit_integer_call(output, result, "subtract", left.operand, right.operand)
		end
		return result
	end
	if operator_id == 3
		gate4_emit_guarded_integer_operation(
			context,
			output,
			result,
			left.operand,
			right.operand,
			"mul",
			"67108864",
			right_nonnegative,
			guarded_operator,
		)
		return result
	end
	if operator_id <= 5
		mut operation := "div"
		mut helper := "divide"
		if operator_id == 5
			operation = "rem"
			helper = "remainder"
		end
		if gate4_take_inline_budget(context)
			gate4_emit_checked_integer_division(
				context,
				output,
				result,
				left.operand,
				right.operand,
				operation,
			)
		else
			gate4_emit_integer_call(output, result, helper, left.operand, right.operand)
		end
		return result
	end
	different := operator_id == 7
	if left.type_name == "String"
		mut compare_strings := operator_id == 6
		if different
			compare_strings = true
		end
		if compare_strings
			mut equality := result
			if different
				equality = gate4_emit_temporary(context)
			end
			qbe_output_line(
				output,
				"\t" + equality + " =l call $g4_string_equal(l " + left.operand + ", l " + right.operand + ")",
			)
			if different
				qbe_output_line(output, "\t" + result + " =l ceql " + equality + ", 0")
			end
			return result
		end
	end
	mut comparison := "eq"
	if different
		comparison = "ne"
	end
	if operator_id == 8
		comparison = "lt"
	end
	if operator_id == 9
		comparison = "le"
	end
	if operator_id == 10
		comparison = "gt"
	end
	if operator_id == 11
		comparison = "ge"
	end
	if float_operands
		comparison = "c" + comparison + "d"
	else
		if operator_id >= 8
			comparison = "s" + comparison
		end
		comparison = "c" + comparison + "l"
	end
	qbe_output_line(
		output,
		"\t" + result + " =l " + comparison + " " + left_operand + ", " + right_operand,
	)
	return result
end

def lower_checked_binary(
		mut state: Gate4Compiler,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		origin: Integer,
		left: Gate4EmittedValue,
		right: Gate4EmittedValue,
	): Gate4EmittedValue
	plan := gate4_load_integer(state.mir_nonnegative_facts, origin)
	result_type := checked_binary_plan_type(plan)
	# Verify the checked-origin binding before lowering, without rechecking
	# operand types or reconstructing the result from emitted values.
	operator := gate4_load_string(state.token_texts, origin)
	mut valid := result_type != "Invalid"
	if valid
		valid = plan % 16 == gate4_binary_operator_id(operator) % 16
	end
	if !valid
		gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, origin), "invalid checked binary plan")
		return gate4_emitted_value("0", "Invalid", 0, "", "")
	end
	# Literal spelling remains transitional until selected inline-call results
	# are represented above the adapter; the operator and result type do not.
	operand := lower_binary_operand(
		context,
		output,
		plan % 16,
		left,
		right,
		result_type,
		gate4_small_nonnegative_integer_operand(left.operand),
		gate4_small_nonnegative_integer_operand(right.operand),
		0,
	)
	return gate4_emitted_value(operand, result_type, 0, "", "")
end

def lower_checked_logical(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		origin: Integer,
		minimum_precedence: Integer,
		left: Gate4EmittedValue,
	): Gate4EmittedValue
	plan := gate4_load_integer(state.mir_nonnegative_facts, origin)
	short_value := mir_logical_short_value(plan)
	mut valid := short_value >= 0
	if valid
		valid = plan - 64 == gate4_binary_operator_id(gate4_load_string(state.token_texts, origin))
	end
	if !valid
		gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, origin), "invalid checked logical plan")
		return gate4_emitted_value("0", "Invalid", 0, "", "")
	end
	rhs := gate4_emit_label(context)
	short := gate4_emit_label(context)
	rhs_done := gate4_emit_label(context)
	merge := gate4_emit_label(context)
	if short_value == 1
		qbe_output_branch(output, left.operand, short, rhs)
	else
		qbe_output_branch(output, left.operand, rhs, short)
	end
	qbe_output_line(output, short)
	qbe_output_line(output, "\tjmp " + merge)
	qbe_output_line(output, rhs)
	# Header temporaries created on either conditional path do not dominate
	# the merge. The shared managed-root stack remains runtime path-sensitive.
	gate4_invalidate_array_header_cache(context)
	right := gate4_emit_expression(state, position, context, output, minimum_precedence, "Boolean")
	qbe_output_line(output, "\tjmp " + rhs_done)
	qbe_output_line(output, rhs_done)
	qbe_output_line(output, "\tjmp " + merge)
	qbe_output_line(output, merge)
	result := gate4_emit_temporary(context)
	# Explicit incoming blocks keep nested RHS regions valid SSA. A stack slot
	# allocated here would accumulate on every visit inside a loop.
	qbe_output_line(output, "\t" + result + " =l phi " + short + " " + gate4_integer_string(short_value) + ", " + rhs_done + " " + right.operand)
	gate4_invalidate_array_header_cache(context)
	return gate4_emitted_value(result, "Boolean", 0, "", "")
end

def gate4_emit_expression_value(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		minimum_precedence: Integer,
		expected: String,
	): Gate4EmittedValue
	expression_origin := position[0]
	mut value := gate4_emit_postfix(
		state,
		position,
		context,
		output,
		gate4_emit_primary(state, position, context, output, expected),
	)
	mut scanning := true
	while scanning
		operator_origin := position[0]
		operator := gate4_load_string(state.token_texts, position[0])
		precedence := syntax_expression_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			gate4_advance(position)
			gate4_skip_newlines(state, position)
			if precedence <= 2
				value = lower_checked_logical(state, position, context, output, operator_origin, precedence + 1, value)
				if gate4_has_diagnostic(state)
					return value
				end
			else
				end_origin := position[0]
				right := gate4_emit_expression(
					state,
					position,
					context,
					output,
					precedence + 1,
					"",
				)
				if precedence == 3
					plan := checked_range_require(state, expression_origin, operator_origin, end_origin, position[0])
					if plan.origin < 0 || value.type_name != plan.start_type || right.type_name != plan.end_type
						gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, operator_origin), "Range operands disagree with checked MIR")
						return gate4_emitted_value("0", "Invalid", 0, "", "")
					end
					result := gate4_emit_temporary(context)
					qbe_output_line(output, "\t" + result + " =l call $g4_gc_alloc(l $g4_desc_range, l 24, l 0)")
					gate4_emit_root_value(context, "Range<Integer>")
					start_slot := gate4_emit_address(context, output, result, 8)
					end_slot := gate4_emit_address(context, output, result, 16)
					exclusive_slot := gate4_emit_address(context, output, result, 24)
					gate4_emit_typed_store(output, "Integer", value.operand, start_slot)
					gate4_emit_typed_store(output, "Integer", right.operand, end_slot)
					gate4_emit_typed_store(output, "Integer", gate4_integer_string(plan.exclusive), exclusive_slot)
					value = gate4_emitted_value(result, "Range<Integer>", 0, "", "")
				else
					value = lower_checked_binary(state, context, output, operator_origin, value, right)
				end
			end
		end
	end
	return value
end

def gate4_emit_expression(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		minimum_precedence: Integer,
		expected: String,
	): Gate4EmittedValue
	# Grouping preserves inference hints; only the completed expression widens.
	value := gate4_emit_expression_value(state, position, context, output, minimum_precedence, expected)
	if expected == "Float"
		if value.type_name == "Integer"
			converted := gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + converted + " =d sltof " + value.operand)
			return gate4_emitted_value(converted, "Float", 0, "", "")
		end
	end
	return value
end

def gate4_emit_declaration(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
	): Boolean
	if gate4_token_is(state, position[0], "mut")
		gate4_advance(position)
	end
	declaration_origin := position[0]
	name := gate4_expect_identifier(state, position)
	mut declared_type := ""
	if gate4_token_is(state, position[0], ":")
		gate4_advance(position)
		declared_type = gate4_parse_type(state, position)
		declared_type = gate4_resolve_type_name(state, state.active_module[0], declared_type, false)
	end
	gate4_expect(state, position, ":=")
	value := gate4_emit_expression(state, position, context, output, 1, declared_type)
	mut local_type := declared_type
	if local_type == ""
		local_type = value.type_name
	end
	slot := gate4_emit_add_local(context, output, name, local_type, value.operand, false)
	if gate4_header_binding_selected(context.array_header_local_origins, declaration_origin)
		gate4_install_stable_array_header(context, output, value.operand, slot)
	end
	return finish_statement(state, position)
end

def emit_checked_assignment_store(
		mut state: Gate4Compiler,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		origin: Integer,
		left: Gate4EmittedValue,
		operand: String,
	)
	if left.category == 4
		plan := checked_hash_plan(state, origin - 1)
		if plan.kind != 3 || plan.finish + 1 != origin || !checked_hash_valid(state, plan, false) || plan.value_type != left.type_name
			gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, origin), "invalid checked Hash assignment")
			return
		end
		emit_hash_set(context, output, left.owner, left.slot, operand, plan.value_type)
		return
	end
	mut address := left.slot
	if left.category == 3
		index_origin := checked_array_assignment_target(state, origin) - 1
		mut valid := index_origin >= 0
		if left.owner == ""
			valid = false
		end
		if left.slot == ""
			valid = false
		end
		if !valid
			gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, origin), "invalid checked Array assignment target")
			return
		end
		if checked_array_assignment_store(state, index_origin) != origin
			gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, origin), "invalid checked Array assignment target")
			return
		end
		assignment_plan := checked_array_assignment_plan(state, index_origin)
		if assignment_plan < 0
			gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, origin), "invalid checked Array assignment region")
			return
		end
		if assignment_plan == 0
			output.runtime_flags[3] = 1
			address = gate4_emit_temporary(context)
			qbe_output_line(output, "\t" + address + " =l call $g4_array_address(l " + left.owner + ", l " + left.slot + ")")
		end
	end
	gate4_emit_typed_store(output, left.type_name, operand, address)
end

def gate4_emit_simple_statement(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
	): Boolean
	left := gate4_emit_expression(state, position, context, output, 1, "")
	operator_origin := position[0]
	operator := gate4_load_string(state.token_texts, position[0])
	if operator == "="
		gate4_advance(position)
		right := gate4_emit_expression(state, position, context, output, 1, left.type_name)
		emit_checked_assignment_store(state, context, output, operator_origin, left, right.operand)
	else
		if gate4_binary_operator_id(operator) >= 17
			gate4_advance(position)
			right := gate4_emit_expression(state, position, context, output, 1, left.type_name)
			result := lower_checked_binary(state, context, output, operator_origin, left, right)
			emit_checked_assignment_store(state, context, output, operator_origin, left, result.operand)
		end
	end
	if gate4_array_element_type(left.type_name) != ""
		gate4_invalidate_array_header_cache(context)
	end
	return finish_statement(state, position)
end

def emit_iteration(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		result_type: String,
		parent_loop: Integer,
	): Boolean
	plan := checked_iteration_require(state, position[0], parent_loop)
	if gate4_has_diagnostic(state)
		return false
	end
	gate4_invalidate_array_header_cache(context)
	receiver := gate4_emit_expression(state, position, context, output, 1, plan.type_name)
	if receiver.type_name != plan.type_name || position[0] != plan.receiver_finish
		gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, plan.origin), "iteration receiver disagrees with checked MIR")
		return false
	end
	saved_count := context.local_count[0]
	header_count := context.array_header_count[0]
	# Hidden locals keep the receiver and cursor independent of user bindings.
	receiver_slot := gate4_emit_add_local(context, output, "$iteration.receiver", plan.type_name, receiver.operand, false)
	mut start := "0"
	mut bound := "0"
	mut exclusive := "0"
	if plan.source_kind == 2
		start = gate4_emit_temporary(context)
		bound = gate4_emit_temporary(context)
		exclusive = gate4_emit_temporary(context)
		start_address := gate4_emit_address(context, output, receiver.operand, 8)
		end_address := gate4_emit_address(context, output, receiver.operand, 16)
		exclusive_address := gate4_emit_address(context, output, receiver.operand, 24)
		gate4_emit_typed_load(output, start, "Integer", start_address)
		gate4_emit_typed_load(output, bound, "Integer", end_address)
		gate4_emit_typed_load(output, exclusive, "Integer", exclusive_address)
	end
	cursor_slot := gate4_emit_add_local(context, output, "$iteration.cursor", "Integer", start, false)
	mut ordinal_slot := ""
	if plan.source_kind == 2 && plan.index_origin >= 0
		ordinal_slot = gate4_emit_add_local(context, output, "$iteration.ordinal", "Integer", "0", false)
	end
	mut zero := "0"
	if plan.element_type == "Float"
		zero = "d_0"
	end
	element_slot := gate4_emit_add_local(context, output, gate4_load_string(state.token_texts, plan.element_origin), plan.element_type, zero, false)
	mut index_slot := ""
	if plan.index_origin >= 0
		index_slot = gate4_emit_add_local(context, output, gate4_load_string(state.token_texts, plan.index_origin), "Integer", "0", false)
	end
	header := gate4_emit_label(context)
	body := gate4_emit_label(context)
	advance := gate4_emit_label(context)
	done := gate4_emit_label(context)
	qbe_output_line(output, "\tjmp " + header)
	qbe_output_line(output, header)
	array := gate4_emit_temporary(context)
	cursor := gate4_emit_temporary(context)
	length_slot := gate4_emit_temporary(context)
	length := gate4_emit_temporary(context)
	available := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + array + " =l loadl " + receiver_slot)
	qbe_output_line(output, "\t" + cursor + " =l loadl " + cursor_slot)
	if plan.source_kind == 1
		qbe_output_line(output, "\t" + length_slot + " =l add " + array + ", 8")
		qbe_output_line(output, "\t" + length + " =l loadl " + length_slot)
		qbe_output_line(output, "\t" + available + " =w csltl " + cursor + ", " + length)
	else
		before := gate4_emit_temporary(context)
		at_end := gate4_emit_temporary(context)
		inclusive := gate4_emit_temporary(context)
		last := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + before + " =w csltl " + cursor + ", " + bound)
		qbe_output_line(output, "\t" + at_end + " =w ceql " + cursor + ", " + bound)
		qbe_output_line(output, "\t" + inclusive + " =w ceql " + exclusive + ", 0")
		qbe_output_line(output, "\t" + last + " =w and " + at_end + ", " + inclusive)
		qbe_output_line(output, "\t" + available + " =w or " + before + ", " + last)
	end
	qbe_output_branch(output, available, body, done)
	qbe_output_line(output, body)
	mut element := cursor
	if plan.source_kind == 1
		element = gate4_emit_temporary(context)
		data_slot := gate4_emit_temporary(context)
		data := gate4_emit_temporary(context)
		offset := gate4_emit_temporary(context)
		address := gate4_emit_temporary(context)
		qbe_output_line(output, "\t" + data_slot + " =l add " + array + ", 24")
		qbe_output_line(output, "\t" + data + " =l loadl " + data_slot)
		qbe_output_line(output, "\t" + offset + " =l mul " + cursor + ", 8")
		qbe_output_line(output, "\t" + address + " =l add " + data + ", " + offset)
		gate4_emit_typed_load(output, element, plan.element_type, address)
	end
	gate4_emit_typed_store(output, plan.element_type, element, element_slot)
	if index_slot != ""
		mut ordinal := cursor
		if ordinal_slot != ""
			ordinal = gate4_emit_temporary(context)
			gate4_emit_typed_load(output, ordinal, "Integer", ordinal_slot)
		end
		gate4_emit_typed_store(output, "Integer", ordinal, index_slot)
	end
	# The Array may lose its current element during the body. Root the binding
	# as well as the retained receiver before any body allocation can collect.
	gate4_emit_loop_root_compaction(context, output)
	context.loop_depth[0] = context.loop_depth[0] + 1
	position[0] = plan.body_start
	body_terminated := gate4_emit_block(state, position, context, output, result_type, plan.origin, advance, done)
	if position[0] != plan.body_finish
		gate4_diagnostic(state, "TRBN4004", gate4_load_integer(state.token_lines, plan.origin), "iteration body disagrees with checked MIR")
		return false
	end
	if body_terminated == 0
		qbe_output_line(output, "\tjmp " + advance)
	end
	qbe_output_line(output, advance)
	current := gate4_emit_temporary(context)
	incremented := gate4_emit_temporary(context)
	qbe_output_line(output, "\t" + current + " =l loadl " + cursor_slot)
	if plan.source_kind == 2
		# Stop at the captured endpoint before adding to portable MAX.
		last := gate4_emit_temporary(context)
		step := gate4_emit_label(context)
		qbe_output_line(output, "\t" + last + " =w ceql " + current + ", " + bound)
		qbe_output_branch(output, last, done, step)
		qbe_output_line(output, step)
		if ordinal_slot != ""
			# The endpoint guard proves this addition remains portable. Do not
			# increment an ordinal after the final exclusive element.
			following := gate4_emit_temporary(context)
			at_end := gate4_emit_temporary(context)
			excluded := gate4_emit_temporary(context)
			next_index := gate4_emit_label(context)
			qbe_output_line(output, "\t" + following + " =l add " + current + ", 1")
			qbe_output_line(output, "\t" + at_end + " =w ceql " + following + ", " + bound)
			qbe_output_line(output, "\t" + excluded + " =w and " + at_end + ", " + exclusive)
			qbe_output_branch(output, excluded, done, next_index)
			qbe_output_line(output, next_index)
			ordinal := gate4_emit_temporary(context)
			next_ordinal := gate4_emit_temporary(context)
			gate4_emit_typed_load(output, ordinal, "Integer", ordinal_slot)
			gate4_emit_integer_call(output, next_ordinal, "add", ordinal, "1")
			gate4_emit_typed_store(output, "Integer", next_ordinal, ordinal_slot)
		end
	end
	qbe_output_line(output, "\t" + incremented + " =l add " + current + ", 1")
	qbe_output_line(output, "\tstorel " + incremented + ", " + cursor_slot)
	qbe_output_line(output, "\tjmp " + header)
	qbe_output_line(output, done)
	context.local_count[0] = saved_count
	context.loop_depth[0] = context.loop_depth[0] - 1
	context.array_header_count[0] = header_count
	gate4_invalidate_array_header_cache(context)
	gate4_emit_loop_root_compaction(context, output)
	position[0] = plan.finish
	return finish_statement(state, position)
end

def gate4_emit_block(
		mut state: Gate4Compiler,
		mut position: Array<Integer>,
		mut context: Gate4EmitContext,
		mut output: QbeOutput,
		result_type: String,
		loop_origin: Integer,
		loop_header: String,
		loop_done: String,
	): Integer
	gate4_skip_newlines(state, position)
	mut complete := false
	mut terminated := 0
	while !complete
		if gate4_has_diagnostic(state)
			return terminated
		end
		if syntax_loop_transfer_kind(state, position[0]) > 0
			kind := checked_loop_transfer_kind(state, position[0], loop_origin)
			if kind == 0
				return terminated
			end
			mut target := loop_header
			if kind == 1
				target = loop_done
			end
			qbe_output_line(output, "\tjmp " + target)
			gate4_advance(position)
			finish_statement(state, position)
			terminated = 1
		elsif sparse_integer_at(state.iteration_origins, position[0]) > 0
			emit_iteration(state, position, context, output, result_type, loop_origin)
		elsif syntax_block_end(state, position[0])
			complete = true
		else
			if syntax_conditional_tail(state, position[0])
				complete = true
			else
				if gate4_token_is(state, position[0], "if")
					gate4_advance(position)
					condition_value := gate4_emit_expression(state, position, context, output, 1, "Boolean")
					finish_statement(state, position)
					when_true := gate4_emit_label(context)
					when_false := gate4_emit_label(context)
					join := gate4_emit_label(context)
					# Checked Booleans are canonical 0/1 long values. QBE jnz may
					# consume their low word without another comparison.
					qbe_output_branch(output, condition_value.operand, when_true, when_false)
					qbe_output_line(output, when_true)
					saved_count := context.local_count[0]
					mut true_terminated := gate4_emit_block(state, position, context, output, result_type, loop_origin, loop_header, loop_done)
					context.local_count[0] = saved_count
					if true_terminated == 0
						qbe_output_line(output, "\tjmp " + join)
					end
					gate4_invalidate_array_header_cache(context)
					qbe_output_line(output, when_false)
					while gate4_token_is(state, position[0], "elsif")
						gate4_advance(position)
						branch_condition := gate4_emit_expression(state, position, context, output, 1, "Boolean")
						finish_statement(state, position)
						branch_true := gate4_emit_label(context)
						branch_false := gate4_emit_label(context)
						qbe_output_branch(output, branch_condition.operand, branch_true, branch_false)
						qbe_output_line(output, branch_true)
						branch_terminated := gate4_emit_block(state, position, context, output, result_type, loop_origin, loop_header, loop_done)
						context.local_count[0] = saved_count
						if branch_terminated == 0
							true_terminated = 0
							qbe_output_line(output, "\tjmp " + join)
						end
						gate4_invalidate_array_header_cache(context)
						qbe_output_line(output, branch_false)
					end
					mut false_terminated := 0
					if gate4_token_is(state, position[0], "else")
						gate4_advance(position)
						finish_statement(state, position)
						false_terminated = gate4_emit_block(state, position, context, output, result_type, loop_origin, loop_header, loop_done)
						context.local_count[0] = saved_count
					end
					if false_terminated == 0
						qbe_output_line(output, "\tjmp " + join)
					end
					gate4_expect(state, position, "end")
					finish_statement(state, position)
					if true_terminated == 1
						if false_terminated == 1
							terminated = 1
						else
							qbe_output_line(output, join)
						end
					else
						qbe_output_line(output, join)
					end
					gate4_invalidate_array_header_cache(context)
				else
					if gate4_token_is(state, position[0], "while")
						while_origin := position[0]
						header_count := context.array_header_count[0]
						gate4_invalidate_array_header_cache(context)
						emit_loop_array_headers(context, output, while_origin)
						header := gate4_emit_label(context)
						body := gate4_emit_label(context)
						done := gate4_emit_label(context)
						# Fallback values from an enclosing loop are not invariant on
						# this backedge. Only verified headers survive.
						gate4_invalidate_array_header_cache(context)
						qbe_output_line(output, "\tjmp " + header)
						qbe_output_line(output, header)
						mut loop_output := qbe_output_new(
							state.token_count[0] * 8 + 1024,
							output.runtime_flags,
						)
						safe_points_before := context.temporary_roots_used[1]
						gate4_advance(position)
						context.loop_depth[0] = context.loop_depth[0] + 1
						condition_value := gate4_emit_expression(state, position, context, loop_output, 1, "Boolean")
						finish_statement(state, position)
						qbe_output_branch(loop_output, condition_value.operand, body, done)
						qbe_output_line(loop_output, body)
						saved_count := context.local_count[0]
						body_terminated := gate4_emit_block(state, position, context, loop_output, result_type, while_origin, header, done)
						context.local_count[0] = saved_count
						if body_terminated == 0
							qbe_output_line(loop_output, "\tjmp " + header)
						end
						gate4_expect(state, position, "end")
						finish_statement(state, position)
						qbe_output_line(loop_output, done)
						if context.temporary_roots_used[1] == safe_points_before
							qbe_output_append(output, loop_output)
							gate4_emit_loop_root_compaction(context, output)
						else
							gate4_emit_loop_root_compaction(context, output)
							qbe_output_append(output, loop_output)
						end
						gate4_invalidate_array_header_cache(context)
						context.array_header_count[0] = header_count
						context.loop_depth[0] = context.loop_depth[0] - 1
					else
						if gate4_token_is(state, position[0], "return")
							gate4_advance(position)
							if syntax_statement_boundary(state, position[0])
								qbe_output_line(output, "\tjmp @return")
							else
								value := gate4_emit_expression(state, position, context, output, 1, result_type)
								gate4_emit_typed_store(output, result_type, value.operand, "%return_value")
								qbe_output_line(output, "\tjmp @return")
							end
							finish_statement(state, position)
							terminated = 1
						else
							if gate4_declaration_start(state, position[0])
								gate4_emit_declaration(state, position, context, output)
							else
								gate4_emit_simple_statement(state, position, context, output)
							end
						end
					end
				end
			end
		end
		if terminated == 1
			parse_statement_block(state, position)
			complete = true
		end
	end
	return terminated
end

def gate4_emit_function(
		mut state: Gate4Compiler,
		function_index: Integer,
		mut output: QbeOutput,
		inline_budget: Array<Integer>,
	)
	state.active_module[0] = gate4_load_integer(state.function_modules, function_index)
	mut context := gate4_emit_context_new(
		state.token_count[0] + 1,
		inline_budget,
	)
	mut body := qbe_output_new(state.token_count[0] * 8 + 1024, output.runtime_flags)
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_count := gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameters := ""
	mut parameter_index := 0
	while parameter_index < parameter_count
		if parameters != ""
			parameters += ", "
		end
		parameters += gate4_qbe_type(
			gate4_load_string(state.parameter_types, parameter_start + parameter_index),
		) + " %p" + gate4_integer_string(parameter_index)
		parameter_index += 1
	end
	mut result_prefix := ""
	result_type := gate4_load_string(state.function_result_types, function_index)
	if result_type != "Void"
		result_prefix = gate4_qbe_type(result_type) + " "
	end
	mir_index := mir_function_index(state.scalar_mir, function_index)
	mir_function := mir_index >= 0
	mut control_mir_function := false
	if mir_function
		mir_row := state.scalar_mir.functions[mir_index]
		control_mir_function = mir_row.block_count > 2
	end
	if !mir_function
		parameter_index = 0
		while parameter_index < parameter_count
			declaration_index := parameter_start + parameter_index
			parameter_name := gate4_load_string(state.parameter_names, declaration_index)
			initial := "%p" + gate4_integer_string(parameter_index)
			slot := gate4_emit_add_local(
				context,
				body,
				parameter_name,
				gate4_load_string(state.parameter_types, declaration_index),
				initial,
				!gate4_function_reassigns_parameter(state, function_index, parameter_name),
			)
			if gate4_header_binding_selected(state.scalar_mir.array_headers[function_index], parameter_index)
				gate4_install_stable_array_header(context, body, initial, slot)
			end
			parameter_index += 1
		end
	end
	header_plan := state.scalar_mir.array_headers[function_index]
	mut header_index := 0
	while header_index < header_plan.size()
		binding := state.scalar_mir.array_regions[function_index][header_plan[header_index]]
		if binding.kind == 2
			context.array_header_local_origins.push(binding.origin)
		end
		header_index += 1
	end
	loop_plan := state.scalar_mir.array_loop_headers[function_index]
	header_index = 0
	while header_index < loop_plan.size()
		region := state.scalar_mir.array_regions[function_index]
		binding := region[loop_plan[header_index + 2]]
		mut slot := binding.operand
		if binding.kind == 1
			slot = loop_plan[header_index + 2]
		end
		context.array_loop_headers.push([region[loop_plan[header_index]].origin, region[loop_plan[header_index + 1]].origin, slot])
		header_index += 3
	end
	mut terminated := 0
	if control_mir_function
		gate4_emit_induction_mir(state, function_index, result_type, context, body)
		terminated = 1
	else
		if mir_function
			mut argument_operands: Array<String> := []
			mut argument_types: Array<String> := []
			mut argument_facts: Array<Integer> := []
			parameter_index = 0
			while parameter_index < parameter_count
				argument_operands.push("%p" + gate4_integer_string(parameter_index))
				argument_types.push(gate4_load_string(state.parameter_types, parameter_start + parameter_index))
				argument_facts.push(0)
				parameter_index += 1
			end
			value := gate4_emit_scalar_mir(
				state,
				function_index,
				argument_operands,
				argument_types,
				argument_facts,
				context,
				body,
				false,
			)
			gate4_emit_typed_store(body, result_type, value.operand, "%return_value")
			qbe_output_line(body, "\tjmp @return")
			terminated = 1
		else
			mut position := [gate4_load_integer(state.function_body_starts, function_index)]
			terminated = gate4_emit_block(
				state,
				position,
				context,
				body,
				result_type,
				- 1,
				"",
				"",
			)
		end
	end
	if terminated == 0
		if result_type == "Void"
			qbe_output_line(body, "\tjmp @return")
		else
			qbe_output_line(body, "\tcall $g4_fail(l $g4_integer_error, l 32)")
			qbe_output_line(body, "\thlt")
		end
	end
	qbe_output_line(
		output,
		"function " + result_prefix + "$g4f" + gate4_integer_string(function_index) + "(" + parameters + ") {",
	)
	qbe_output_line(output, "@start")
	# State 2 combines a managed temporary with a following collection safe
	# point. Either condition alone does not require publishing the frame.
	uses_temporary_roots := context.temporary_roots_used[0] == 2
	managed_local_count := context.managed_local_high_water[0]
	if uses_temporary_roots
		qbe_output_line(output, "\t%temporary_roots =l loadl $g4_gc_temp_count")
	end
	if result_type != "Void"
		qbe_output_line(output, "\t%return_value =l alloc8 8")
	end
	# QBE allocates dynamically when an alloc instruction executes, so lexical
	# local slots must precede every branch and loop in the function body.
	mut slot_index := 0
	while slot_index < context.slot_count[0]
		qbe_output_line(
			output,
			"\t%v" + gate4_integer_string(slot_index) + " =l alloc8 8",
		)
		slot_index += 1
	end
	if uses_temporary_roots
		if managed_local_count > 0
			qbe_output_line(
				output,
				"\t%root_capacity =l add %temporary_roots, " + gate4_integer_string(managed_local_count),
			)
			qbe_output_line(output, "\tcall $g4_gc_temp_reserve(l %root_capacity)")
		end
	end
	mut body_index := 0
	mut inside_root_publication := false
	while body_index < body.count[0]
		line := gate4_load_string(body.lines, body_index)
		if line == "{"
			inside_root_publication = true
		else
			if line == "}"
				inside_root_publication = false
			else
				if uses_temporary_roots
					if line == "\tcall $g4_gc_temp_reset(l %temporary_roots)"
						qbe_output_line(output, "\tstorel %temporary_roots, $g4_gc_temp_count")
					else
						qbe_output_line(output, line)
					end
				else
					if !inside_root_publication
						if line != "\tcall $g4_gc_temp_reset(l %temporary_roots)"
							qbe_output_line(output, line)
						end
					end
				end
			end
		end
		body_index += 1
	end
	if context.array_bounds_failure_used[0]
		qbe_output_line(output, "@array_bounds_failure")
		qbe_output_line(output, "\tcall $g4_fail(l $g4_bounds_error, l 30)")
		qbe_output_line(output, "\thlt")
	end
	if context.scalar_inline_range_failure_used[0]
		qbe_output_line(output, "@scalar_inline_integer_range_failure")
		qbe_output_line(output, "\tcall $g4_fail(l $g4_integer_range_error, l 45)")
		qbe_output_line(output, "\thlt")
	end
	qbe_output_line(output, "@return")
	if uses_temporary_roots
		qbe_output_line(output, "\tstorel %temporary_roots, $g4_gc_temp_count")
	end
	if result_type == "Void"
		qbe_output_line(output, "\tret")
	else
		gate4_emit_typed_load(output, "%return_result", result_type, "%return_value")
		if native_managed_type(result_type)
			qbe_output_line(output, "\tcall $g4_gc_temp_push(l %return_result)")
		end
		qbe_output_line(output, "\tret %return_result")
	end
	qbe_output_line(output, "}\n")
	gate4_reset_temporary_storage()
	return
end

def gate4_compiler_entry_function(state: Gate4Compiler): Integer
	index := gate4_find_function_in_module(state, state.entry_module[0], "compiler_main")
	if index < 0
		return - 1
	end
	if gate4_load_integer(state.function_parameter_counts, index) != 3
		return - 1
	end
	start := gate4_load_integer(state.function_parameter_starts, index)
	if gate4_load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 2) != "Boolean"
		return - 1
	end
	if gate4_load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def gate4_compiler_file_entry_function(state: Gate4Compiler): Integer
	index := gate4_find_function_in_module(state, state.entry_module[0], "compiler_file_main")
	if index < 0
		return - 1
	end
	if gate4_load_integer(state.function_parameter_counts, index) != 4
		return - 1
	end
	start := gate4_load_integer(state.function_parameter_starts, index)
	if gate4_load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 2) != "String"
		return - 1
	end
	if gate4_load_string(state.parameter_types, start + 3) != "Boolean"
		return - 1
	end
	if gate4_load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def gate4_emit_process_arguments(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\t%process_argc =l extsw %argc\n\tstorel %process_argc, $g4_process_argc\n\tstorel %argv, $g4_process_argv_pointer",
	)
	return
end

def gate4_emit_target_entry(mut output: QbeOutput)
	qbe_output_line(output, "\nexport function w $main(w %argc, l %argv) {")
	qbe_output_line(output, "@start")
	qbe_output_line(output, "\tcall $g4_gc_trace_initialize()")
	if output.runtime_flags[2] == 1
		qbe_output_line(output, "\tcall $g4_static_strings_initialize()")
	end
	if output.runtime_flags[1] == 1
		gate4_emit_process_arguments(output)
	end
	qbe_output_line(output, "\tstorel $g4_qbe_darwin_arm64, $g4_selected_qbe_target")
	qbe_output_line(output, "\tstorel $g4_dead_strip_darwin, $g4_selected_dead_strip")
	qbe_output_line(output, "\tstorel 0, $g4_project_selected_linker")
	qbe_output_line(output, "\t%a11 =w ceqw %argc, 11")
	qbe_output_line(output, "\tjnz %a11, @target_shape, @dispatch")
	qbe_output_line(output, "@target_shape")
	qbe_output_line(output, "\t%target_flag_pointer =l add %argv, 72")
	qbe_output_line(output, "\t%target_flag =l loadl %target_flag_pointer")
	qbe_output_line(output, "\t%target_flag_comparison =w call $strcmp(l %target_flag, l $g4_target_option)")
	qbe_output_line(output, "\t%target_flag_ok =w ceqw %target_flag_comparison, 0")
	qbe_output_line(output, "\tjnz %target_flag_ok, @target_profile, @dispatch")
	qbe_output_line(output, "@target_profile")
	qbe_output_line(output, "\t%profile_pointer =l add %argv, 80")
	qbe_output_line(output, "\t%profile =l loadl %profile_pointer")
	qbe_output_line(output, "\t%darwin_comparison =w call $strcmp(l %profile, l $g4_profile_darwin_arm64)")
	qbe_output_line(output, "\t%darwin =w ceqw %darwin_comparison, 0")
	qbe_output_line(output, "\tjnz %darwin, @target_darwin, @target_linux_check")
	qbe_output_line(output, "@target_darwin")
	qbe_output_line(output, "\tjmp @invoke_target")
	qbe_output_line(output, "@target_linux_check")
	qbe_output_line(output, "\t%linux_comparison =w call $strcmp(l %profile, l $g4_profile_linux_arm64)")
	qbe_output_line(output, "\t%linux =w ceqw %linux_comparison, 0")
	qbe_output_line(output, "\tjnz %linux, @target_linux_arm64, @target_linux_amd64_check")
	qbe_output_line(output, "@target_linux_arm64")
	qbe_output_line(output, "\tstorel $g4_qbe_linux_arm64, $g4_selected_qbe_target")
	qbe_output_line(output, "\tjmp @target_linux_common")
	qbe_output_line(output, "@target_linux_amd64_check")
	qbe_output_line(output, "\t%linux_amd64_comparison =w call $strcmp(l %profile, l $g4_profile_linux_amd64)")
	qbe_output_line(output, "\t%linux_amd64 =w ceqw %linux_amd64_comparison, 0")
	qbe_output_line(output, "\tjnz %linux_amd64, @target_linux_amd64, @target_error")
	qbe_output_line(output, "@target_linux_amd64")
	qbe_output_line(output, "\tstorel $g4_qbe_linux_amd64, $g4_selected_qbe_target")
	qbe_output_line(output, "\tjmp @target_linux_common")
	qbe_output_line(output, "@target_linux_common")
	qbe_output_line(output, "\tstorel $g4_dead_strip_linux, $g4_selected_dead_strip")
	qbe_output_line(output, "\tstorel $g4_project_linker_lld, $g4_project_selected_linker")
	qbe_output_line(output, "\tjmp @invoke_target")
	qbe_output_line(output, "@target_error")
	qbe_output_line(output, "\tcall $write(w 2, l $g4_target_error, l 37)")
	qbe_output_line(output, "\tcall $g4_gc_finish()")
	qbe_output_line(output, "\tret 64")
	qbe_output_line(output, "@invoke_target")
	qbe_output_line(output, "\t%target_status =w call $g4_compiler_dispatch(w 9, l %argv)")
	qbe_output_line(output, "\tcall $g4_gc_finish()")
	qbe_output_line(output, "\tret %target_status")
	qbe_output_line(output, "@dispatch")
	qbe_output_line(output, "\t%dispatch_status =w call $g4_compiler_dispatch(w %argc, l %argv)")
	qbe_output_line(output, "\tcall $g4_gc_finish()")
	qbe_output_line(output, "\tret %dispatch_status")
	qbe_output_line(output, "}")
	return
end

def gate4_emit_entry(mut state: Gate4Compiler, mut output: QbeOutput)
	compiler_entry := gate4_compiler_entry_function(state)
	if compiler_entry >= 0
		compiler_file_entry := gate4_compiler_file_entry_function(state)
		qbe_output_line(output, "function w $g4_compiler_dispatch(w %argc, l %argv) {")
		qbe_output_line(output, "@start")
		qbe_output_line(
			output,
			"\t%a9 =w ceqw %argc, 9\n\tjnz %a9, @bshape, @other\n@bshape\n\t%bcmdp =l add %argv, 8\n\t%bcmd =l loadl %bcmdp\n\t%boc =w call $strcmp(l %bcmd, l $g4_build)\n\t%bok =w ceqw %boc, 0\n\t%bofp =l add %argv, 24\n\t%bof =l loadl %bofp\n\t%bofc =w call $strcmp(l %bof, l $g4_output_flag)\n\t%bofo =w ceqw %bofc, 0\n\t%bqfp =l add %argv, 40\n\t%bqf =l loadl %bqfp\n\t%bqfc =w call $strcmp(l %bqf, l $g4_qbe_flag)\n\t%bqfo =w ceqw %bqfc, 0\n\t%bcfp =l add %argv, 56\n\t%bcf =l loadl %bcfp\n\t%bcfc =w call $strcmp(l %bcf, l $g4_cc_flag)\n\t%bcfo =w ceqw %bcfc, 0\n\t%bv0 =w and %bok, %bofo\n\t%bv1 =w and %bqfo, %bcfo\n\t%bv =w and %bv0, %bv1\n\tjnz %bv, @build, @usage\n@build\n\t%bspp =l add %argv, 16\n\t%bsp =l loadl %bspp\n\t%bsrc =l call $g4_read_file(l %bsp)\n\t%bsm =w ceql %bsrc, 0\n\tjnz %bsm, @bread_error, @bpaths\n@bread_error\n\tcall $write(w 2, l $g4_file_error, l 35)\n\t%bspl =l call $strlen(l %bsp)\n\tcall $write(w 2, l %bsp, l %bspl)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret 66\n@bpaths\n\t%bop =l add %argv, 32\n\t%bo =l loadl %bop\n\t%bqp =l add %argv, 48\n\t%bqbe =l loadl %bqp\n\t%bcp =l add %argv, 64\n\t%bcc =l loadl %bcp\n\t%bssa =l call $g4_c_concat(l %bo, l $g4_ssa_suffix)\n\t%basm =l call $g4_c_concat(l %bo, l $g4_asm_suffix)\n\t%bf =l call $fopen(l %bssa, l $g4_wb)\n\t%bfm =w ceql %bf, 0\n\tjnz %bfm, @bfile_error, @bredirect\n@bfile_error\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bredirect\n\t%bfd =w call $fileno(l %bf)\n\t%bsaved =w call $dup(w 1)\n\t%bfdb =w csltw %bfd, 0\n\t%bsavedb =w csltw %bsaved, 0\n\t%brb =w or %bfdb, %bsavedb\n\tjnz %brb, @bredirect_error, @bset_stdout\n@bset_stdout\n\t%bset =w call $dup2(w %bfd, w 1)\n\t%bsetb =w csltw %bset, 0\n\tjnz %bsetb, @bredirect_error, @bcompile\n@bredirect_error\n\t%bci =w call $close(w %bsaved)\n\t%bfci =w call $fclose(l %bf)\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bcompile\n\t%bm =l call $g4_string_from_c(l $g4_emit)",
		)
		qbe_output_line(
			output,
			"\t%bpath =l call $g4_string_from_c(l %bsp)",
		)
		qbe_output_line(
			output,
			"\t%bst =l call $g4f" + gate4_integer_string(compiler_file_entry) +
			"(l %bsrc, l %bpath, l %bm, l 1)",
		)
		qbe_output_line(
			output,
			"\t%brestore =w call $dup2(w %bsaved, w 1)\n\t%bclosed =w call $close(w %bsaved)\n\t%bfclosed =w call $fclose(l %bf)\n\t%brb0 =w csltw %brestore, 0\n\t%brb1 =w csltw %bclosed, 0\n\t%brb2 =w cnew %bfclosed, 0\n\t%brb3 =w or %brb0, %brb1\n\t%brbad =w or %brb3, %brb2\n\tjnz %brbad, @bpost_error, @bcompiled\n@bpost_error\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@bcompiled\n\t%bcfail =w cnel %bst, 0\n\tjnz %bcfail, @bcompiler_failed, @bqbe\n@bcompiler_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tret 1\n@bqbe\n\t%bqs =w call $g4_run_qbe(l %bqbe, l %bssa, l %basm)\n\t%bqfail =w cnew %bqs, 0\n\tjnz %bqfail, @bqbe_failed, @btemp\n@bqbe_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_qbe_error, l 21)\n\tret 70\n@btemp\n\t%btmpl =l call $g4_c_concat(l %bo, l $g4_temp_suffix)\n\t%bdir =l call $mkdtemp(l %btmpl)\n\t%bdfail =w ceql %bdir, 0\n\tjnz %bdfail, @btemp_failed, @btemp_path\n@btemp_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $g4_intermediate_error, l 42)\n\tret 73\n@btemp_path\n\t%bbase =l call $g4_c_basename(l %bo)\n\t%bdp =l call $g4_c_concat(l %bdir, l $g4_slash)\n\t%bexe =l call $g4_c_concat(l %bdp, l %bbase)\n\t%bcs =w call $g4_project_run_cc(l %bcc, l %basm, l %bexe)\n\t%bccfail =w cnew %bcs, 0\n\tjnz %bccfail, @bcc_failed, @bpublish\n@bcc_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $g4_cc_error, l 20)\n\tret 70\n@bpublish\n\t%bpr =w call $rename(l %bexe, l %bo)\n\t%bpf =w cnew %bpr, 0\n\tjnz %bpf, @bpublish_failed, @bsuccess\n@bpublish_failed\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $g4_publish_error, l 32)\n\tret 73\n@bsuccess\n\tcall $g4_cleanup(l %bssa, l %basm)\n\tcall $g4_cleanup_output(l %bexe, l %bdir)\n\tret 0\n@other\n\t%a3 =w ceqw %argc, 3\n\tjnz %a3, @fargs, @hargc\n@hargc\n\t%a4 =w ceqw %argc, 4\n\tjnz %a4, @hargs, @usage\n@hargs\n\t%hfp =l add %argv, 8\n\t%hf =l loadl %hfp\n\t%hfc =w call $strcmp(l %hf, l $g4_source_arg)\n\t%valid_hf =w ceqw %hfc, 0\n\tjnz %valid_hf, @hidden, @usage\n@usage\n\tcall $write(w 2, l $g4_usage_error, l 103)\n\tret 64\n@hidden\n\t%hmp =l add %argv, 16\n\t%hmc =l loadl %hmp\n\t%hm =l call $g4_string_from_c(l %hmc)\n\t%hsp =l add %argv, 24\n\t%hsc =l loadl %hsp\n\t%hs =l call $g4_string_from_c(l %hsc)",
		)
		qbe_output_line(
			output,
			"\t%hst =l call $g4f" + gate4_integer_string(compiler_entry) +
			"(l %hs, l %hm, l 0)",
		)
		qbe_output_line(
			output,
			"\tret 0\n@fargs\n\t%fmp =l add %argv, 8\n\t%fmc =l loadl %fmp\n\t%cc =w call $strcmp(l %fmc, l $g4_check)\n\t%cm =w ceqw %cc, 0\n\t%ec =w call $strcmp(l %fmc, l $g4_emit)\n\t%em =w ceqw %ec, 0\n\t%valid_fm =w or %cm, %em\n\tjnz %valid_fm, @file, @usage\n@file\n\t%pp =l add %argv, 16\n\t%path =l loadl %pp\n\t%src =l call $g4_read_file(l %path)\n\t%rf =w ceql %src, 0\n\tjnz %rf, @read_error, @compile\n@read_error\n\tcall $write(w 2, l $g4_file_error, l 35)\n\t%pl =l call $strlen(l %path)\n\tcall $write(w 2, l %path, l %pl)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret 66\n@compile\n\t%fm =l call $g4_string_from_c(l %fmc)",
		)
		qbe_output_line(
			output,
			"\t%fpath =l call $g4_string_from_c(l %path)",
		)
		qbe_output_line(
			output,
			"\t%fst =l call $g4f" + gate4_integer_string(compiler_file_entry) +
			"(l %src, l %fpath, l %fm, l 1)",
		)
		qbe_output_line(output, "\t%failed =w cnel %fst, 0\n\tret %failed")
	else
		qbe_output_line(output, "export function w $main(w %argc, l %argv) {")
		qbe_output_line(output, "@start")
		qbe_output_line(output, "\tcall $g4_gc_trace_initialize()")
		if output.runtime_flags[2] == 1
			qbe_output_line(output, "\tcall $g4_static_strings_initialize()")
		end
		if output.runtime_flags[1] == 1
			gate4_emit_process_arguments(output)
		end
		main_index := gate4_find_function_in_module(state, state.entry_module[0], "main")
		qbe_output_line(output, "\tcall $g4f" + gate4_integer_string(main_index) + "()")
		qbe_output_line(output, "\tcall $g4_gc_finish()")
		qbe_output_line(output, "\tret 0")
	end
	qbe_output_line(output, "}")
	if compiler_entry >= 0
		cli_entry := gate4_find_function_in_module(state, state.entry_module[0], "native_cli_main")
		if cli_entry >= 0
			output.runtime_flags[1] = 1
			runtime_module := gate4_find_module(state, "host")
			runtime_function := gate4_find_function_in_module(state, runtime_module, "native_cli_runtime_qbe")
			if runtime_function < 0
				gate4_diagnostic(state, "TRBN4005", 1, "Native CLI runtime template is missing")
				return
			end
			runtime_token := gate4_load_integer(state.function_body_starts, runtime_function) + 1
			if gate4_load_integer(state.token_kinds, runtime_token) != 3
				gate4_diagnostic(state, "TRBN4005", 1, "Native CLI runtime template must be a literal String")
				return
			end
			qbe_output_line(output, gate4_load_string(state.token_texts, runtime_token))
			qbe_output_line(output, "export function w $main(w %argc, l %argv) {\n@start\n\tcall $g4_gc_trace_initialize()")
			if output.runtime_flags[2] == 1
				qbe_output_line(output, "\tcall $g4_static_strings_initialize()")
			end
			gate4_emit_process_arguments(output)
			qbe_output_line(output, "\t%status =l call $g4f" + gate4_integer_string(cli_entry) + "()\n\tcall $g4_gc_finish()\n\tret %status\n}")
		else
			gate4_emit_target_entry(output)
		end
	end
	return
end

def gate4_emit_qbe(mut state: Gate4Compiler): QbeOutput
	mut output := qbe_output_new(state.token_count[0] * 24 + 4096, [0, 0, 0, 0, 0, 0])
	gate4_emit_static_strings(state, output)
	if gate4_has_diagnostic(state)
		return output
	end
	gate4_emit_record_descriptors(state, output)
	compiler_runtime := gate4_compiler_entry_function(state) >= 0
	emit_qbe_runtime(output, compiler_runtime)
	function_count := state.function_count[0]
	mut inline_budget := [0, 0, - 2]
	if function_count <= 32
		inline_budget[0] = 64
		inline_budget[1] = 6
		inline_budget[2] = 2
	else
		if function_count <= 96
			inline_budget[0] = 32
			inline_budget[1] = 3
		end
	end
	mut function_index := 0
	# Flat recovery input still needs the source fallbacks during its first bootstrap.
	# Canonical multi-module compiler input uses the runtime intrinsics directly.
	if compiler_runtime
		if state.module_count[0] > 1
			if gate4_find_function_in_module(state, state.entry_module[0], "native_cli_main") < 0
				function_index = 5
			end
		end
	end
	mut deferred_function :=- 1
	while function_index < function_count
		mut deferred := false
		if function_count <= 32
			if deferred_function < 0
				if gate4_scalar_leaf_inline_eligible(state, function_index)
					deferred_function = function_index
					deferred = true
				end
			end
		end
		if !deferred
			gate4_emit_function(state, function_index, output, inline_budget)
		end
		function_index += 1
	end
	if deferred_function >= 0
		if inline_budget[2] == - 1
			gate4_emit_function(state, deferred_function, output, inline_budget)
		end
	end
	gate4_emit_entry(state, output)
	if output.runtime_flags[3] == 1
		qbe_output_line(
			output,
			"\nfunction l $g4_array_address(l %array, l %requested) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%negative =w csltl %requested, 0\n\tjnz %negative, @negative, @check\n@negative\n\t%adjusted_negative =l add %length, %requested\n\tjmp @bounds\n@check\n\t%adjusted_positive =l copy %requested\n\tjmp @bounds\n@bounds\n\t%index =l phi @negative %adjusted_negative, @check %adjusted_positive\n\t%valid =w cultl %index, %length\n\tjnz %valid, @load, @fail\n@fail\n\tcall $g4_fail(l $g4_bounds_error, l 30)\n\thlt\n@load\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%offset =l mul %index, 8\n\t%address =l add %data, %offset\n\tret %address\n}",
		)
	end
	if output.runtime_flags[4] == 1
		emit_boolean_puts_runtime(output)
	end
	if output.runtime_flags[5] == 1
		emit_hash_runtime(output)
	end
	if output.runtime_flags[0] == 1
		emit_float_array_runtime(output)
	end
	if output.runtime_flags[1] == 1
		emit_process_runtime(output)
		emit_string_to_integer_runtime(output)
		emit_integer_to_string_runtime(output)
		emit_float_to_integer_runtime(output)
	end
	return output
end

def gate4_eputs(_value: String)
	return
end

def gate4_print_diagnostic(state: Gate4Compiler, file_mode: Boolean)
	mut message := ""
	module_index := gate4_load_integer(state.diagnostic_modules, 0)
	if module_index > 0
		message += gate4_load_string(state.module_files, module_index) + ":"
	end
	message += gate4_load_string(state.diagnostic_codes, 0) + ":"
	message += gate4_integer_string(gate4_load_integer(state.diagnostic_lines, 0))
	message += ":"
	message += gate4_load_string(state.diagnostic_messages, 0)
	if file_mode
		gate4_eputs(message)
	else
		puts(message)
	end
	return
end

def gate4_compile_state(mut state: Gate4Compiler, mode: String, file_mode: Boolean): Integer
	if !gate4_has_diagnostic(state)
		gate4_resolve(state)
	end
	if !gate4_has_diagnostic(state)
		gate4_check(state)
	end
	if gate4_has_diagnostic(state)
		gate4_print_diagnostic(state, file_mode)
		return 1
	end
	if mode == "check"
		puts("ok")
		return 0
	end
	if mode == "emit-qbe"
		output := gate4_emit_qbe(state)
		if gate4_has_diagnostic(state)
			gate4_print_diagnostic(state, file_mode)
			return 1
		end
		mut index := 0
		while index < output.count[0]
			puts(gate4_load_string(output.lines, index))
			index += 1
		end
		return 0
	end
	message := "TRBN4006:1:unsupported compiler mode " + mode
	if file_mode
		gate4_eputs(message)
	else
		puts(message)
	end
	return 64
end

def compiler_main(source: String, mode: String, file_mode: Boolean): Integer
	mut state := gate4_compiler_new(source.size() * 3 + 16)
	gate4_lex(state, source)
	if !gate4_has_diagnostic(state)
		gate4_parse_module(state, 0, state.entry_module[0])
	end
	return gate4_compile_state(state, mode, file_mode)
end

def compiler_file_main(source: String, path: String, mode: String, file_mode: Boolean): Integer
	mut state := gate4_compiler_new(1)
	if gate4_path_basename(path) == "trbconfig.jsonc"
		state = gate4_load_configured_project(source, path)
	else
		state = gate4_load_file_root(source, path)
	end
	return gate4_compile_state(state, mode, file_mode)
end

def gate4_character_in(character: String, characters: String): Boolean
	mut index := 0
	while index < characters.size()
		if characters[index] == character
			return true
		end
		index += 1
	end
	return false
end

def gate4_number_character(character: String): Boolean
	if gate4_character_in(character, "0123456789")
		return true
	end
	return character == "_"
end

def gate4_push_token(mut state: Gate4Compiler, kind: Integer, text: String, line: Integer)
	mut index := state.token_count[0]
	# The following token distinguishes a complete right literal from a postfix.
	if index >= 3
		if gate4_load_integer(state.token_kinds, index - 3) == 3
			if gate4_load_integer(state.token_kinds, index - 2) == 5
				if gate4_load_string(state.token_texts, index - 2) == "+"
					if gate4_load_integer(state.token_kinds, index - 1) == 3
						if text != "."
							if text != "["
								combined := gate4_load_string(state.token_texts, index - 3) + gate4_load_string(state.token_texts, index - 1)
								gate4_store_string(state.token_texts, index - 3, combined)
								index -= 2
							end
						end
					end
				end
			end
		end
	end
	gate4_store_integer(state.token_kinds, index, kind)
	gate4_store_string(state.token_texts, index, text)
	gate4_store_integer(state.token_lines, index, line)
	state.token_count[0] = index + 1
	return
end

def gate4_scan_identifier(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if gate4_character_in(
					source[position[0]],
					"0123456789fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
				)
				gate4_advance(position)
			else
				scanning = false
			end
		end
	end
	if position[0] < source.size()
		if source[position[0]] == "?"
			gate4_advance(position)
		end
	end
	gate4_push_token(state, 1, gate4_source_slice(source, start, position[0]), line)
	return
end

def gate4_scan_number(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if gate4_number_character(source[position[0]])
				gate4_advance(position)
			else
				scanning = false
			end
		end
	end
	if position[0] + 1 < source.size()
		if source[position[0]] == "."
			if gate4_character_in(source[position[0] + 1], "0123456789")
				gate4_advance(position)
				scanning = true
				while scanning
					if position[0] >= source.size()
						scanning = false
					else
						if gate4_number_character(source[position[0]])
							gate4_advance(position)
						else
							scanning = false
						end
					end
				end
			end
		end
	end
	gate4_push_token(state, 2, gate4_source_slice(source, start, position[0]), line)
	return
end

def gate4_decode_escape(mut state: Gate4Compiler, escaped: String, line: Integer): String
	mut value := ""
	if escaped == "n"
		value = "\n"
	else
		if escaped == "t"
			value = "\t"
		else
			if escaped == "r"
				value = "\r"
			else
				if escaped == "\""
					value = "\""
				else
					if escaped == "\\"
						value = "\\"
					else
						gate4_diagnostic(state, "TRBN4001", line, "unsupported String escape")
					end
				end
			end
		end
	end
	return value
end

# Locate embedded expressions without treating quoted braces as delimiters.
def gate4_interpolation_end(source: String, mut index: Integer): Integer
	mut depth := 1
	while index < source.size()
		character := source[index]
		if character == "\""
			index = gate4_interpolation_quote_end(source, index + 1)
			if index < 0
				return - 1
			end
		else
			if character == "{"
				depth += 1
			end
			if character == "}"
				depth -= 1
				if depth == 0
					return index
				end
			end
			if character == "#"
				mut comment := true
				while comment
					if index >= source.size()
						comment = false
					else
						if source[index] == "\n"
							comment = false
						else
							index += 1
						end
					end
				end
			end
		end
		index += 1
	end
	return - 1
end

def gate4_interpolation_quote_end(source: String, mut index: Integer): Integer
	while index < source.size()
		character := source[index]
		if character == "\\"
			index += 1
		else
			if character == "\""
				return index
			end
			if character == "#"
				if index + 1 < source.size()
					if source[index + 1] == "{"
						index = gate4_interpolation_end(source, index + 2)
						if index < 0
							return - 1
						end
					end
				end
			end
		end
		index += 1
	end
	return - 1
end

# Normalize interpolation to grouped String concatenation before checking.
# Each embedded expression is evaluated once by the shared ordinary pipeline.
def gate4_scan_string(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		mut line: Integer,
		interpolation: Boolean,
	): Integer
	start_line := line
	gate4_advance(position)
	mut interpolated := false
	mut text := ""
	mut chunk_start := position[0]
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			current := source[position[0]]
			if current == "\""
				text += gate4_source_slice(source, chunk_start, position[0])
				closed = true
				scanning = false
				gate4_advance(position)
			else
				if current == "\n"
					gate4_diagnostic(state, "TRBN4001", line, "unterminated String literal")
					scanning = false
				else
					if current == "\\"
						text += gate4_source_slice(source, chunk_start, position[0])
						gate4_advance(position)
						if position[0] >= source.size()
							gate4_diagnostic(state, "TRBN4001", line, "unterminated String escape")
							scanning = false
						else
							mut escaped_hash := source[position[0]] == "#"
							if escaped_hash
								escaped_hash = interpolation
							end
							if escaped_hash
								text += "#"
							else
								text += gate4_decode_escape(state, source[position[0]], line)
							end
							gate4_advance(position)
							chunk_start = position[0]
						end
					else
						if current == "#"
							if position[0] + 1 < source.size()
								mut opening := source[position[0] + 1] == "{"
								if opening
									opening = interpolation
								end
								if opening
									finish := gate4_interpolation_end(source, position[0] + 2)
									if finish < 0
										gate4_diagnostic(state, "TRBN4001", line, "unterminated String interpolation")
										scanning = false
									else
										if finish == position[0] + 2
											position[0] = finish + 1
										else
											if !interpolated
												gate4_push_token(state, 5, "(", start_line)
												interpolated = true
											end
											text += gate4_source_slice(source, chunk_start, position[0])
											gate4_push_token(state, 3, text, line)
											gate4_push_token(state, 5, "+", line)
											gate4_push_token(state, 5, "(", line)
											first_token := state.token_count[0]
											inner := gate4_source_slice(source, position[0] + 2, finish)
											mut first := 0
											mut last := inner.size()
											mut inner_line := line
											mut trim := true
											while trim
												if first >= last
													trim = false
												else
													if gate4_character_in(inner[first], " \t\r\n")
														if inner[first] == "\n"
															inner_line += 1
														end
														first += 1
													else
														trim = false
													end
												end
											end
											trim = true
											while trim
												if last <= first
													trim = false
												else
													if gate4_character_in(inner[last - 1], " \t\r\n")
														last -= 1
													else
														trim = false
													end
												end
											end
											gate4_lex_source(state, gate4_source_slice(inner, first, last), 0)
											state.token_count[0] = state.token_count[0] - 1
											mut token := first_token
											while token < state.token_count[0]
												gate4_store_integer(state.token_lines, token, gate4_load_integer(state.token_lines, token) + inner_line - 1)
												token += 1
											end
											if gate4_has_diagnostic(state)
												gate4_store_integer(state.diagnostic_lines, 0, gate4_load_integer(state.diagnostic_lines, 0) + inner_line - 1)
												return line - start_line
											end
											mut character_index := 0
											while character_index < inner.size()
												if inner[character_index] == "\n"
													line += 1
												end
												character_index += 1
											end
											gate4_push_token(state, 5, ")", line)
											gate4_push_token(state, 5, "+", line)
											position[0] = finish + 1
											chunk_start = position[0]
											text = ""
										end
									end
								else
									gate4_advance(position)
								end
							else
								gate4_advance(position)
							end
						else
							gate4_advance(position)
						end
					end
				end
			end
		end
	end
	if closed
		gate4_push_token(state, 3, text, line)
		if interpolated
			gate4_push_token(state, 5, ")", line)
		end
	else
		if !gate4_has_diagnostic(state)
			gate4_diagnostic(state, "TRBN4001", line, "unterminated String literal")
		end
	end
	return line - start_line
end

def gate4_two_character_symbol(pair: String): Boolean
	mut supported := false
	if pair == "||"
		supported = true
	end
	if pair == "&&"
		supported = true
	end
	if pair == ":="
		supported = true
	end
	if pair == "=="
		supported = true
	end
	if pair == "!="
		supported = true
	end
	if pair == "<="
		supported = true
	end
	if pair == ">="
		supported = true
	end
	if pair == "+="
		supported = true
	end
	if pair == "-="
		supported = true
	end
	if pair == "*="
		supported = true
	end
	if pair == "/="
		supported = true
	end
	if pair == "=>"
		supported = true
	end
	if pair == "->"
		supported = true
	end
	return supported
end

def gate4_scan_symbol(
		mut state: Gate4Compiler,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	character := source[position[0]]
	mut symbol := character
	if position[0] + 1 < source.size()
		pair := character + source[position[0] + 1]
		if pair == ".."
			symbol = pair
			gate4_advance(position)
			if position[0] + 1 < source.size() && source[position[0] + 1] == "."
				symbol = "..."
				gate4_advance(position)
			end
		elsif gate4_two_character_symbol(pair)
			symbol = pair
			gate4_advance(position)
		end
	end
	mut supported := symbol.size() >= 2
	if !supported
		supported = gate4_character_in(character, "()[]{}:,.+-*/%<>=!|")
	end
	if supported
		gate4_push_token(state, 5, symbol, line)
	else
		gate4_diagnostic(state, "TRBN4001", line, "unsupported source character " + character)
	end
	gate4_advance(position)
	return
end

def gate4_skip_comment(source: String, mut position: Array<Integer>)
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if source[position[0]] == "\n"
				scanning = false
			else
				gate4_advance(position)
			end
		end
	end
	return
end

def gate4_lex_source(mut state: Gate4Compiler, source: String, terminal_kind: Integer): Boolean
	mut position := [0]
	mut line := 1
	mut character := ""
	while position[0] < source.size()
		character = source[position[0]]
		if character == " "
			gate4_advance(position)
		else
			if character == "\t"
				gate4_advance(position)
			else
				if character == "\r"
					gate4_advance(position)
				else
					if character == "\n" || character == ";"
						gate4_push_token(state, 4, character, line)
						if character == "\n"
							line += 1
						end
						gate4_advance(position)
					else
						if character == "#"
							gate4_skip_comment(source, position)
						else
							if gate4_character_in(
									character,
									"fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
								)
								gate4_scan_identifier(state, source, position, line)
							else
								if gate4_character_in(character, "0123456789")
									gate4_scan_number(state, source, position, line)
								else
									if character == "\""
										line += gate4_scan_string(state, source, position, line, true)
									else
										gate4_scan_symbol(state, source, position, line)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	gate4_push_token(state, terminal_kind, "", line)
	return !gate4_has_diagnostic(state)
end

def gate4_lex_module(mut state: Gate4Compiler, source: String, module_index: Integer): Boolean
	state.active_module[0] = module_index
	return gate4_lex_source(state, source, 6)
end

def gate4_lex(mut state: Gate4Compiler, source: String): Boolean
	if state.module_count[0] == 0
		gate4_add_module(state, "entry", "")
	end
	state.entry_module[0] = 0
	state.active_module[0] = 0
	return gate4_lex_source(state, source, 0)
end

def gate4_project_error_state(path: String, line: Integer, message: String): Gate4Compiler
	mut state := gate4_compiler_new(1024)
	module_index := gate4_add_module(state, "trbconfig", path)
	state.entry_module[0] = module_index
	state.active_module[0] = module_index
	gate4_diagnostic(state, "TRBN4010", line, message)
	return state
end

def gate4_project_join(root: String, relative: String): String
	if relative == "."
		return root
	end
	return gate4_path_join(root, relative)
end

def gate4_project_module_name(
		mut state: Gate4Compiler,
		source_root: String,
		path: String,
	): String
	mut prefix := source_root
	if prefix != "/"
		prefix += "/"
	end
	if !gate4_string_starts_with(path, prefix)
		gate4_diagnostic(state, "TRBN4010", 1, "project source is outside configured sourceDir")
	else
		if !gate4_string_ends_with(path, ".trb")
			gate4_diagnostic(state, "TRBN4010", 1, "project source does not end in .trb")
		else
			name := gate4_source_slice(path, prefix.size(), path.size() - 4)
			if name != ""
				return name
			end
			gate4_diagnostic(
				state,
				"TRBN4010",
				1,
				"project source has an empty module name",
			)
		end
	end
	return ""
end

def gate4_string_starts_at(value: String, start: Integer, prefix: String): Boolean
	mut index := 0
	while index < prefix.size()
		if value[start + index] != prefix[index]
			return false
		end
		index += 1
	end
	return true
end

def gate4_project_source_declares_main(source: String): Boolean
	mut index := 0
	while index + 9 <= source.size()
		if gate4_string_starts_at(source, index, "def main(")
			if index == 0
				return true
			end
			if source[index - 1] == "\n"
				return true
			end
		end
		index += 1
	end
	return false
end

def gate4_project_append_import_target(
		module_lookup: Hash<String, Integer>,
		normalized: String,
		mut order: Array<Integer>,
		mut included: Array<Integer>,
	): Array<Integer>
	mut target := find_name_index(module_lookup, normalized)
	if target < 0
		target = find_name_index(module_lookup, normalized + "/index")
	end
	if target >= 0
		if included[target] == 0
			order.push(target)
			included[target] = 1
		end
	end
	return order
end

def gate4_project_bare_import_path(raw: String): String
	mut finish := raw.size()
	mut index := 0
	while index < raw.size()
		if raw[index] == " "
			finish = index
			index = raw.size()
		else
			if raw[index] == "\t"
				finish = index
				index = raw.size()
			else
				index += 1
			end
		end
	end
	return gate4_source_slice(raw, 0, finish)
end

def gate4_project_append_imports(
		module_lookup: Hash<String, Integer>,
		source: String,
		mut order: Array<Integer>,
		mut included: Array<Integer>,
	): Array<Integer>
	mut index := 0
	while index + 6 <= source.size()
		if gate4_string_starts_at(source, index, " from ")
			mut cursor := index + 6
			mut collecting := true
			while collecting
				if cursor >= source.size()
					collecting = false
				else
					if source[cursor] == "\n"
						collecting = false
					else
						cursor += 1
					end
				end
			end
			raw := gate4_source_slice(source, index + 6, cursor)
			normalized := gate4_import_path_value(raw)
			order = gate4_project_append_import_target(
				module_lookup,
				normalized,
				order,
				included,
			)
			index = cursor
		end
		index += 1
	end
	index = 0
	while index + 7 <= source.size()
		mut line_start := index == 0
		if index > 0
			if source[index - 1] == "\n"
				line_start = true
			end
		end
		if line_start
			if gate4_string_starts_at(source, index, "import ")
				cursor := index + 7
				if cursor < source.size()
					if source[cursor] != "{"
						mut line_finish := cursor
						mut scanning := true
						while scanning
							if line_finish >= source.size()
								scanning = false
							else
								if source[line_finish] == "\n"
									scanning = false
								else
									line_finish += 1
								end
							end
						end
						raw := gate4_source_slice(source, cursor, line_finish)
						path := gate4_project_bare_import_path(raw)
						normalized := gate4_import_path_value(path)
						order = gate4_project_append_import_target(
							module_lookup,
							normalized,
							order,
							included,
						)
					end
				end
			end
		end
		index += 1
	end
	return order
end

def gate4_order_project_sources(source_root: String, bundle: Gate4ProjectSources): Gate4ProjectSources
	mut entry :=- 1
	mut included: Array<Integer> := []
	mut module_lookup: Hash<String, Integer> := {}
	mut prefix_size := source_root.size()
	if source_root != "/"
		prefix_size += 1
	end
	mut index := 0
	while index < bundle.paths.size()
		included.push(0)
		name := gate4_source_slice(
			bundle.paths[index],
			prefix_size,
			bundle.paths[index].size() - 4,
		)
		module_lookup[name] = index
		if gate4_project_source_declares_main(bundle.sources[index])
			entry = index
		end
		index += 1
	end
	if entry < 0
		return bundle
	end

	mut order := [entry]
	included[entry] = 1
	mut cursor := 0
	while cursor < order.size()
		order = gate4_project_append_imports(
			module_lookup,
			bundle.sources[order[cursor]],
			order,
			included,
		)
		cursor += 1
	end
	index = 0
	while index < bundle.paths.size()
		if included[index] == 0
			order.push(index)
		end
		index += 1
	end

	mut paths: Array<String> := []
	mut sources: Array<String> := []
	index = 0
	while index < order.size()
		paths.push(bundle.paths[order[index]])
		sources.push(bundle.sources[order[index]])
		index += 1
	end
	return Gate4ProjectSources.new(paths: paths, sources: sources, error: "")
end

def gate4_project_select_entry(mut state: Gate4Compiler): Boolean
	mut entry :=- 1
	mut function_index := 0
	while function_index < state.function_count[0]
		if gate4_load_string(state.function_names, function_index) == "main"
			module_index := gate4_load_integer(state.function_modules, function_index)
			if entry >= 0
				state.active_module[0] = module_index
				gate4_diagnostic(
					state,
					"TRBN4010",
					gate4_load_integer(state.function_lines, function_index),
					"project has more than one top-level main function",
				)
				return false
			end
			entry = module_index
		end
		function_index += 1
	end
	if entry < 0
		state.active_module[0] = 0
		gate4_diagnostic(state, "TRBN4010", 1, "project must declare exactly one top-level main function")
		return false
	end
	state.entry_module[0] = entry
	state.active_module[0] = entry
	return true
end

def project_module_acyclic(state: Gate4Compiler, module_index: Integer, mut colors: Array<Integer>): Boolean
	color := colors[module_index]
	if color > 0
		return color == 2
	end
	colors[module_index] = 1
	mut import_index := gate4_load_integer(state.module_import_starts, module_index)
	import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
	while import_index < import_end
		target := gate4_load_integer(state.import_targets, import_index)
		if target >= 0
			if !project_module_acyclic(state, target, colors)
				return false
			end
		end
		import_index += 1
	end
	colors[module_index] = 2
	return true
end

def project_import_graph_acyclic(state: Gate4Compiler): Boolean
	mut colors: Array<Integer> := []
	mut module_index := 0
	while module_index < state.module_count[0]
		colors.push(0)
		module_index += 1
	end
	module_index = 0
	while module_index < state.module_count[0]
		if !project_module_acyclic(state, module_index, colors)
			return false
		end
		module_index += 1
	end
	return true
end

def gate4_module_root_peer(name: String): String
	if gate4_string_ends_with(name, "/index")
		return gate4_string_without_suffix(name, "/index")
	end
	return name + "/index"
end

def gate4_validate_project_module_roots(mut state: Gate4Compiler): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		name := gate4_load_string(state.module_names, module_index)
		peer_name := gate4_module_root_peer(name)
		peer := gate4_find_module(state, peer_name)
		if peer >= 0
			if peer < module_index
				state.active_module[0] = module_index
				gate4_diagnostic(
					state,
					"TRBN4003",
					1,
					"module paths " + name + " and " + peer_name + " define the same import root",
				)
				return false
			end
		end
		module_index += 1
	end
	return true
end

def gate4_validate_new_module_root(mut state: Gate4Compiler, name: String, line: Integer): Boolean
	peer_name := gate4_module_root_peer(name)
	if gate4_find_module(state, peer_name) >= 0
		gate4_diagnostic(
			state,
			"TRBN4003",
			line,
			"module paths " + name + " and " + peer_name + " define the same import root",
		)
		return false
	end
	return true
end

def gate4_resolve_project_imports(mut state: Gate4Compiler): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := gate4_load_string(state.import_paths, import_index)
			line := gate4_load_integer(state.import_lines, import_index)
			normalized := gate4_normalize_import_path(state, raw_path, line)
			if gate4_has_diagnostic(state)
				return false
			end
			mut target := gate4_standard_package_target(normalized)
			if target < - 1
				if gate4_load_integer(state.import_kinds, import_index) != 1
					gate4_diagnostic(state, "TRBN4003", line, "supported standard packages require a bare import")
					return false
				end
			else
				if normalized == "trb"
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return false
				end
				if gate4_string_starts_with(normalized, "trb/")
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return false
				end
				target = gate4_find_module(state, normalized)
				if target < 0
					target = gate4_find_module(state, normalized + "/index")
				end
				if target < 0
					gate4_diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
					return false
				end
			end
			gate4_store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	if !project_import_graph_acyclic(state)
		module_index = 0
		while module_index < state.module_count[0]
			mut import_index := gate4_load_integer(state.module_import_starts, module_index)
			import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
			while import_index < import_end
				state.active_module[0] = module_index
				target := gate4_load_integer(state.import_targets, import_index)
				if target >= 0
					if gate4_module_reaches(state, target, module_index)
						raw_path := gate4_load_string(state.import_paths, import_index)
						line := gate4_load_integer(state.import_lines, import_index)
						gate4_diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
						return false
					end
				end
				import_index += 1
			end
			module_index += 1
		end
	end
	state.active_module[0] = state.entry_module[0]
	return true
end

def gate4_load_configured_project(config_source: String, config_path: String): Gate4Compiler
	config := parse_project_config(config_source)
	if config.error != ""
		return gate4_project_error_state(config_path, config.error_line, config.error)
	end
	root := gate4_path_directory(config_path)
	source_root := gate4_project_join(root, config.source_dir)
	out_root := gate4_project_join(root, config.out_dir)
	bundle := gate4_collect_project_sources(source_root, out_root)
	if bundle.error != ""
		return gate4_project_error_state(config_path, 1, "cannot collect project source " + bundle.error)
	end
	return gate4_load_project_sources(config_path, source_root, bundle)
end

def gate4_load_project_sources(
		config_path: String,
		source_root: String,
		bundle: Gate4ProjectSources,
	): Gate4Compiler
	if bundle.paths.size() == 0
		return gate4_project_error_state(config_path, 1, "no production .trb files found")
	end
	if bundle.paths.size() != bundle.sources.size()
		return gate4_project_error_state(config_path, 1, "project source adapter returned mismatched paths and sources")
	end
	ordered := gate4_order_project_sources(source_root, bundle)
	mut state := gate4_compiler_new(4194304)
	mut module_index := 0
	while module_index < ordered.paths.size()
		state.active_module[0] = module_index
		name := gate4_project_module_name(state, source_root, ordered.paths[module_index])
		if gate4_has_diagnostic(state)
			return state
		end
		gate4_add_module(state, name, ordered.paths[module_index])
		module_index += 1
	end
	if !gate4_validate_project_module_roots(state)
		return state
	end
	module_index = 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		gate4_lex_module(state, ordered.sources[module_index], module_index)
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, start, module_index)
		end
		if gate4_has_diagnostic(state)
			return state
		end
		module_index += 1
	end
	if !gate4_project_select_entry(state)
		return state
	end
	gate4_resolve_project_imports(state)
	return state
end

def gate4_module_reaches(state: Gate4Compiler, start: Integer, goal: Integer): Boolean
	if start == goal
		return true
	end
	mut visited: Array<Integer> := []
	mut index := 0
	while index < state.module_count[0]
		visited.push(0)
		index += 1
	end
	mut queue := [start]
	visited[start] = 1
	mut cursor := 0
	while cursor < queue.size()
		module_index := queue[cursor]
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			target := gate4_load_integer(state.import_targets, import_index)
			if target == goal
				return true
			end
			if target >= 0
				if visited[target] == 0
					visited[target] = 1
					queue.push(target)
				end
			end
			import_index += 1
		end
		cursor += 1
	end
	return false
end

def gate4_load_file_root(entry_source: String, entry_path: String): Gate4Compiler
	mut state := gate4_compiler_new(4194304)
	root := gate4_path_directory(entry_path)
	entry_name := gate4_string_without_suffix(gate4_path_basename(entry_path), ".trb")
	entry_module := gate4_add_module(state, entry_name, entry_path)
	state.entry_module[0] = entry_module
	mut sources := [entry_source]
	mut module_index := 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		gate4_lex_module(state, sources[module_index], module_index)
		if !gate4_has_diagnostic(state)
			gate4_parse_module(state, start, module_index)
		end
		if gate4_has_diagnostic(state)
			return state
		end
		mut import_index := gate4_load_integer(state.module_import_starts, module_index)
		import_end := import_index + gate4_load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := gate4_load_string(state.import_paths, import_index)
			line := gate4_load_integer(state.import_lines, import_index)
			normalized := gate4_normalize_import_path(state, raw_path, line)
			if gate4_has_diagnostic(state)
				return state
			end
			mut target := gate4_standard_package_target(normalized)
			mut target_added := false
			if target < - 1
				if gate4_load_integer(state.import_kinds, import_index) != 1
					gate4_diagnostic(state, "TRBN4003", line, "supported standard packages require a bare import")
					return state
				end
			else
				if normalized == "trb"
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return state
				end
				if gate4_string_starts_with(normalized, "trb/")
					gate4_diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return state
				end
				target = gate4_find_module(state, normalized)
			end
			if target == - 1
				direct_path := gate4_path_join(root, normalized + ".trb")
				if gate4_file_exists(direct_path)
					if !gate4_validate_new_module_root(state, normalized, line)
						return state
					end
					target = gate4_add_module(state, normalized, direct_path)
					sources.push(gate4_read_source(direct_path))
					target_added = true
				else
					index_name := normalized + "/index"
					target = gate4_find_module(state, index_name)
					if target < 0
						index_path := gate4_path_join(root, normalized + "/index.trb")
						if !gate4_file_exists(index_path)
							gate4_diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
							return state
						end
						if !gate4_validate_new_module_root(state, index_name, line)
							return state
						end
						target = gate4_add_module(state, index_name, index_path)
						sources.push(gate4_read_source(index_path))
						target_added = true
					end
				end
			end
			if !target_added
				if target >= 0
					if gate4_module_reaches(state, target, module_index)
						gate4_diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
						return state
					end
				end
			end
			gate4_store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	state.active_module[0] = state.entry_module[0]
	return state
end

# Parameter declarations and expressions attach different source tables to the
# same MIR value layout. Keep identifier allocation and row construction shared.
# Keep the checked instruction layout and source attachment in one builder.
# Callers still choose the operation, operands, and explicit failure edge.
# Binary plans use the existing operator-origin cell: result tag * 16 + op.
# Tags 1/2/3/4 denote Integer/Float/Boolean/String. Literal, argument, index,
# and loop origins remain distinct; their existing markers are unchanged.
def gate4_check_function(
		mut state: Gate4Compiler,
		function_index: Integer,
	): Boolean
	state.active_module[0] = gate4_load_integer(state.function_modules, function_index)
	mut locals := gate4_locals_new(state.token_count[0] + 1)
	gate4_scalar_mir_begin(state, function_index, locals)
	parameter_start := gate4_load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + gate4_load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		added := gate4_local_add(
			state,
			locals,
			gate4_load_string(state.parameter_names, parameter_index),
			gate4_load_string(state.parameter_types, parameter_index),
			gate4_load_integer(state.parameter_mutable, parameter_index),
			gate4_load_integer(state.parameter_lines, parameter_index),
		)
		if added
			gate4_mir_add_parameter(state, locals, parameter_index)
		end
		parameter_index += 1
	end
	# The second cursor cell carries one adjacent declaration fact into a loop.
	mut position := [gate4_load_integer(state.function_body_starts, function_index), 0]
	gate4_check_block(state, position, locals, gate4_load_string(state.function_result_types, function_index), - 1)
	if position[0] != gate4_load_integer(state.function_body_ends, function_index)
		gate4_diagnostic(
			state,
			"TRBN4004",
			gate4_load_integer(state.function_lines, function_index),
			"checker did not consume the complete function body",
		)
	end
	state.scalar_mir.array_regions.push(locals.mir_array)
	if !gate4_has_diagnostic(state)
		mir_error := gate4_scalar_mir_commit(state, function_index, locals)
		if mir_error != ""
			gate4_diagnostic(
				state,
				"TRBN4004",
				gate4_load_integer(state.function_lines, function_index),
				mir_error,
			)
		end
	end
	gate4_reset_temporary_storage()
	return !gate4_has_diagnostic(state)
end

def gate4_check(mut state: Gate4Compiler): Boolean
	mut function_index := 0
	while function_index < state.function_count[0]
		gate4_check_function(state, function_index)
		function_index += 1
	end
	if !gate4_has_diagnostic(state)
		mut mir_error := gate4_verify_mir(state.scalar_mir, false)
		if mir_error == ""
			gate4_optimize_verified_mir(state.scalar_mir)
			mir_error = gate4_verify_mir(state.scalar_mir, true)
		end
		if mir_error != ""
			gate4_diagnostic(state, "TRBN4004", 1, mir_error)
		end
	end
	if !gate4_has_diagnostic(state)
		checked_hash_verify(state)
	end
	if !gate4_has_diagnostic(state)
		gate4_validate_import_usage(state)
	end
	return !gate4_has_diagnostic(state)
end

def main()
	return
end
