record CompilerProjectSources
	paths: Array<String>
	sources: Array<String>
	error: String
end

def compiler_reset_temporary_storage()
	return
end

# These declarations are typed compiler-runtime intrinsics. Their source bodies
# keep recovery compilation valid; the self-hosted emitter replaces calls from
# the compiler executable with the matching QBE runtime operations.
def compiler_file_exists(_path: String): Boolean
	return false
end

def compiler_read_source(_path: String): String
	return ""
end

def compiler_source_slice(source: String, start: Integer, finish: Integer): String
	mut value := ""
	mut index := start
	while index < finish
		value += source[index]
		index += 1
	end
	return value
end

def compiler_collect_project_sources(_source_root: String, _out_root: String): CompilerProjectSources
	return CompilerProjectSources.new(paths: [], sources: [], error: "")
end

def function_reassigns_parameter(state: CompilerState, function_index: Integer, name: String): Boolean
	mut index := load_integer(state.function_body_starts, function_index)
	finish := load_integer(state.function_body_ends, function_index)
	while index < finish
		if load_integer(state.token_kinds, index) == 1 && load_string(state.token_texts, index) == name
			next_token := load_string(state.token_texts, index + 1)
			if next_token == "=" || binary_operator_id(next_token) >= 17
				return true
			end
		end
		index += 1
	end
	return false
end

def emit_hash_literal(mut state: CompilerState, mut position: Array<Integer>, mut context: QbeEmitContext, mut output: QbeOutput): QbeValue
	origin := position[0]
	plan := checked_hash_plan(state, origin)
	checked_hash_require(state, origin, plan.type_name)
	if has_diagnostic(state)
		return emitted_value("0", "Invalid", 0, "", "")
	end
	output.runtime_flags[5] = 1
	mut flags := 0
	if mir_hash_key_managed(plan)
		flags = 1
	end
	if mir_hash_value_managed(plan)
		flags += 2
	end
	table := emit_temporary(context)
	qbe_output_line(output, "\t" + table + " =l call $trbn_hash_new(l " + integer_string(plan.capacity) + ", l " + integer_string(flags) + ")")
	emit_root_value(context, plan.type_name)
	advance(position)
	skip_newlines(state, position)
	mut entries := 0
	while !token_is(state, position[0], "}")
		key := emit_expression(state, position, context, output, 1, plan.key_type)
		if mir_hash_key_managed(plan)
			emit_hash_root(context, output, key.operand)
		end
		expect(state, position, "=>")
		value := emit_expression(state, position, context, output, 1, plan.value_type)
		emit_hash_set(context, output, table, key.operand, value.operand, plan.value_type)
		entries += 1
		skip_newlines(state, position)
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	if entries != plan.entries || position[0] != plan.finish
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked Hash literal extent")
	end
	expect(state, position, "}")
	return emitted_value(table, plan.type_name, 0, "", "")
end

def emit_hash_index(mut state: CompilerState, mut position: Array<Integer>, mut context: QbeEmitContext, mut output: QbeOutput, receiver: QbeValue): QbeValue
	plan := checked_hash_require(state, position[0], receiver.type_name)
	if has_diagnostic(state)
		return receiver
	end
	output.runtime_flags[5] = 1
	emit_hash_root(context, output, receiver.operand)
	advance(position)
	key := emit_expression(state, position, context, output, 1, plan.key_type)
	if mir_hash_key_managed(plan)
		emit_hash_root(context, output, key.operand)
	end
	expect(state, position, "]")
	if plan.kind == 3
		return QbeValue.new(operand: "0", type_name: plan.value_type, category: 4, name: "", slot: key.operand, owner: receiver.operand)
	end
	result := emit_temporary(context)
	qbe_output_line(output, "\t" + result + " =l call $trbn_hash_get(l " + receiver.operand + ", l " + key.operand + ")")
	return emit_hash_value(context, output, result, plan.value_type)
end

def emit_hash_method(mut state: CompilerState, mut position: Array<Integer>, mut context: QbeEmitContext, mut output: QbeOutput, receiver: QbeValue): QbeValue
	plan := checked_hash_require(state, position[0], receiver.type_name)
	if has_diagnostic(state)
		return receiver
	end
	output.runtime_flags[5] = 1
	emit_hash_root(context, output, receiver.operand)
	advance(position)
	mut argument := ""
	if plan.kind == 5 || plan.kind == 6 || plan.kind == 13
		key := emit_expression(state, position, context, output, 1, plan.key_type)
		argument = key.operand
		if mir_hash_key_managed(plan)
			emit_hash_root(context, output, argument)
		end
	end
	if plan.kind == 8 || plan.kind == 9
		other := emit_expression(state, position, context, output, 1, plan.type_name)
		argument = other.operand
		emit_hash_root(context, output, argument)
	end
	skip_newlines(state, position)
	expect(state, position, ")")
	result := emit_temporary(context)
	if plan.kind == 4 || plan.kind == 12
		address := emit_address(context, output, receiver.operand, 8)
		qbe_output_line(output, "\t" + result + " =l loadl " + address)
		if plan.kind == 12
			empty := emit_temporary(context)
			qbe_output_line(output, "\t" + empty + " =l ceql " + result + ", 0")
			return emitted_value(empty, "Boolean", 0, "", "")
		end
		return emitted_value(result, "Integer", 0, "", "")
	end
	if plan.kind == 5 || plan.kind == 6 || plan.kind == 13
		mut operation := "contains"
		mut type_name := "Boolean"
		if plan.kind == 13
			operation = "get"
			type_name = plan.value_type
		end
		if plan.kind == 6
			operation = "delete"
			type_name = plan.value_type
			note_gc_state(context, true)
		end
		qbe_output_line(output, "\t" + result + " =l call $trbn_hash_" + operation + "(l " + receiver.operand + ", l " + argument + ")")
		return emit_hash_value(context, output, result, type_name)
	end
	if plan.kind == 10 || plan.kind == 11
		mut selection := "0"
		mut element := plan.key_type
		if plan.kind == 11
			selection = "1"
			element = plan.value_type
		end
		qbe_output_line(output, "\t" + result + " =l call $trbn_hash_entries(l " + receiver.operand + ", l " + selection + ")")
		emit_root_value(context, array_type(element))
		return emitted_value(result, array_type(element), 0, "", "")
	end
	mut target := receiver.operand
	if plan.kind == 7 || plan.kind == 8
		address := emit_address(context, output, receiver.operand, 16)
		capacity := emit_temporary(context)
		qbe_output_line(output, "\t" + capacity + " =l loadl " + address)
		qbe_output_line(output, "\t" + result + " =l call $trbn_hash_copy(l " + receiver.operand + ", l " + capacity + ")")
		emit_root_value(context, receiver.type_name)
		target = result
	end
	if plan.kind == 8 || plan.kind == 9
		qbe_output_line(output, "\tcall $trbn_hash_update(l " + target + ", l " + argument + ")")
		note_gc_state(context, true)
	end
	if plan.kind == 9
		return emitted_value("", "Void", 0, "", "")
	end
	return emitted_value(target, receiver.type_name, 0, "", "")
end

def emit_array_literal(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		expected: String,
	): QbeValue
	advance(position)
	skip_newlines(state, position)
	contextual_element_type := array_element_type(expected)
	mut element_type := contextual_element_type
	mut operands: Array<String> := []
	mut value_types: Array<String> := []
	mut finished := false
	while !finished
		if token_is(state, position[0], "]")
			finished = true
		else
			value := emit_expression(state, position, context, output, 1, contextual_element_type)
			operands.push(value.operand)
			value_types.push(value.type_name)
			if contextual_element_type == ""
				element_type = common_array_element_type(element_type, value.type_name)
			end
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, "]")
	array := emit_temporary(context)
	mut descriptor := "$trbn_desc_array_scalar"
	if native_managed_type(element_type)
		descriptor = "$trbn_desc_array_managed"
	end
	qbe_output_line(
		output,
		"\t" + array + " =l call $trbn_array_new(l " + descriptor + ")",
	)
	emit_root_value(context, array_type(element_type))
	mut index := 0
	while index < operands.size()
		mut operand := operands[index]
		if element_type == "Float"
			if value_types[index] == "Integer"
				converted := emit_temporary(context)
				qbe_output_line(output, "\t" + converted + " =d sltof " + operand)
				operand = converted
			end
		end
		emit_array_push(context, output, array, element_type, operand)
		index += 1
	end
	return emitted_value(array, array_type(element_type), 0, "", "")
end

def emit_scalar_mir_direct_call(
		mut state: CompilerState,
		mut position: Array<Integer>,
		function_index: Integer,
		parameter_start: Integer,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
	): QbeValue
	mut argument_operands: Array<String> := []
	mut argument_types: Array<String> := []
	mut argument_facts: Array<Integer> := []
	mut argument_count := 0
	mut finished := false
	while !finished
		if token_is(state, position[0], ")")
			finished = true
		else
			argument_origin := position[0]
			expected := load_string(state.parameter_types, parameter_start + argument_count)
			value := emit_expression(state, position, context, output, 1, expected)
			argument_operands.push(value.operand)
			argument_types.push(value.type_name)
			argument_facts.push(load_integer(state.mir_nonnegative_facts, argument_origin))
			argument_count += 1
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, ")")
	return emit_scalar_mir(
		state,
		function_index,
		argument_operands,
		argument_types,
		argument_facts,
		context,
		output,
		true,
	)
end

def emit_direct_call(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		callee: QbeValue,
	): QbeValue
	advance(position)
	skip_newlines(state, position)
	function_index := find_visible_function(state, state.active_module[0], callee.name)
	mut parameter_start := 0
	mut result_type := "Void"
	if callee.category == 4
		result_type = "Array<String>"
	else
		if callee.category == 5
			result_type = "Float"
		end
	end
	if function_index >= 0
		parameter_start = load_integer(state.function_parameter_starts, function_index)
		result_type = load_string(state.function_result_types, function_index)
	end
	if function_index >= 0
		if state.function_count[0] <= 32
			if scalar_leaf_inline_eligible(state, function_index)
				if context.loop_depth[0] > 0
					if context.inline_budget[2] > 0
						context.inline_budget[2] = context.inline_budget[2] - 1
						return emit_scalar_mir_direct_call(
							state,
							position,
							function_index,
							parameter_start,
							context,
							output,
						)
					end
				end
			end
		end
	end
	mut arguments := ""
	mut puts_runtime := "$trbn_puts"
	mut argument_count := 0
	mut finished := false
	while !finished
		if token_is(state, position[0], ")")
			finished = true
		else
			mut expected := "String"
			if callee.category == 5
				expected = "Float"
			end
			if function_index >= 0
				expected = load_string(state.parameter_types, parameter_start + argument_count)
			end
			if callee.name == "puts"
				expected = ""
			end
			value := emit_expression(state, position, context, output, 1, expected)
			mut operand := value.operand
			if callee.name == "puts"
				if value.type_name == "Integer"
					output.runtime_flags[1] = 1
					operand = emit_temporary(context)
					qbe_output_line(output, "\t" + operand + " =l call $trbn_integer_to_string(l " + value.operand + ")")
					emit_root_value(context, "String")
				end
				if value.type_name == "Boolean"
					puts_runtime = "$trbn_puts_boolean"
					output.runtime_flags[4] = 1
				end
			end
			if arguments != ""
				arguments += ", "
			end
			arguments += qbe_type(value.type_name) + " " + operand
			argument_count += 1
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, ")")
	if callee.category == 5
		result := emit_temporary(context)
		qbe_output_line(output, "\t" + result + " =d call $sqrt(" + arguments + ")")
		return emitted_value(result, result_type, 0, "", "")
	end
	invalidate_array_header_cache(context)
	if callee.category == 4
		output.runtime_flags[1] = 1
		result := emit_temporary(context)
		qbe_output_line(output, "\t" + result + " =l call $trbn_process_argv()")
		emit_root_value(context, result_type)
		return emitted_value(result, result_type, 0, "", "")
	end
	if compiler_entry_function(state) >= 0
		if function_index >= 0
			if load_string(state.module_names, load_integer(state.function_modules, function_index)) == "host"
				if find_function_in_module(state, state.entry_module[0], "native_cli_main") >= 0
					result := emit_temporary(context)
					qbe_output_line(output, "\t" + result + " =" + qbe_type(result_type) + " call $" + callee.name + "(" + arguments + ")")
					emit_root_value(context, result_type)
					return emitted_value(result, result_type, 0, "", "")
				end
			end
		end
		if callee.name == "compiler_file_exists"
			result := emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $trbn_file_exists(" + arguments + ")")
			return emitted_value(result, "Boolean", 0, "", "")
		end
		if callee.name == "compiler_read_source"
			result := emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $trbn_read_source(" + arguments + ")")
			emit_root_value(context, "String")
			return emitted_value(result, "String", 0, "", "")
		end
		if callee.name == "compiler_source_slice"
			result := emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $trbn_source_slice(" + arguments + ")")
			emit_root_value(context, "String")
			return emitted_value(result, "String", 0, "", "")
		end
		if callee.name == "compiler_collect_project_sources"
			result := emit_temporary(context)
			qbe_output_line(output, "\t" + result + " =l call $trbn_collect_project_sources(" + arguments + ")")
			emit_root_value(context, result_type)
			return emitted_value(result, result_type, 0, "", "")
		end
	end
	if callee.name == "puts"
		qbe_output_line(output, "\tcall " + puts_runtime + "(" + arguments + ")")
		return emitted_value("", "Void", 0, "", "")
	end
	if callee.name == "compiler_eputs"
		qbe_output_line(output, "\tcall $trbn_eputs(" + arguments + ")")
		return emitted_value("", "Void", 0, "", "")
	end
	if callee.name == "compiler_reset_temporary_storage"
		qbe_output_line(output, "\tcall $trbn_temp_reset()")
		return emitted_value("", "Void", 0, "", "")
	end
	if context.inline_budget[2] >= 0
		if scalar_leaf_inline_eligible(state, function_index)
			context.inline_budget[2] =- 1
		end
	end
	# Until interprocedural no-allocation summaries exist, every ordinary
	# TypeRB call remains a conservative GC safe point.
	note_gc_state(context, true)
	if result_type == "Void"
		qbe_output_line(
			output,
			"\tcall $trbnf" + integer_string(function_index) + "(" + arguments + ")",
		)
		return emitted_value("", "Void", 0, "", "")
	end
	result := emit_temporary(context)
	qbe_output_line(
		output,
		"\t" + result + " =" + qbe_type(result_type) + " call $trbnf" +
		integer_string(function_index) + "(" + arguments + ")",
	)
	emit_root_value(context, result_type)
	return emitted_value(result, result_type, 0, "", "")
end

def emit_record_new(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		record_name: String,
	): QbeValue
	record_index := find_visible_record(state, state.active_module[0], record_name)
	field_start := load_integer(state.record_field_starts, record_index)
	field_count := load_integer(state.record_field_counts, record_index)
	record_value := emit_temporary(context)
	qbe_output_line(
		output,
		"\t" + record_value + " =l call $trbn_gc_alloc(l $trbn_desc_record" +
		integer_string(record_index) + ", l " + integer_string(field_count * 8) + ", l 0)",
	)
	emit_root_value(context, record_type(record_index))
	advance(position)
	skip_newlines(state, position)
	mut field_offset := 0
	mut finished := false
	while !finished
		if token_is(state, position[0], ")")
			finished = true
		else
			expect_identifier(state, position)
			expect(state, position, ":")
			value := emit_expression(
				state,
				position,
				context,
				output,
				1,
				load_string(state.field_types, field_start + field_offset),
			)
			address := emit_address(context, output, record_value, 8 + field_offset * 8)
			emit_typed_store(
				output,
				load_string(state.field_types, field_start + field_offset),
				value.operand,
				address,
			)
			field_offset += 1
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, ")")
	return emitted_value(record_value, record_type(record_index), 0, "", "")
end

def emit_method_call(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		receiver: QbeValue,
		method: String,
	): QbeValue
	if hash_key_type(receiver.type_name) != ""
		return emit_hash_method(state, position, context, output, receiver)
	end
	advance(position)
	skip_newlines(state, position)
	if method == "size"
		expect(state, position, ")")
		mut key := receiver.slot
		mut stable := false
		mut header_index := 0
		while header_index < context.array_header_count[0]
			if context.array_headers[header_index][0] == key
				stable = true
			end
			header_index += 1
		end
		if !stable
			key = ""
		end
		result := emit_array_header(
			context, output, receiver.operand, key, 1, "8",
		)
		return emitted_value(result, "Integer", 0, "", "")
	end
	if method == "push"
		element_type := array_element_type(receiver.type_name)
		value := emit_expression(state, position, context, output, 1, element_type)
		skip_newlines(state, position)
		expect(state, position, ")")
		emit_array_push(context, output, receiver.operand, element_type, value.operand)
		return emitted_value("", "Void", 0, "", "")
	end
	if method == "to_i"
		expect(state, position, ")")
		result := emit_temporary(context)
		output.runtime_flags[1] = 1
		mut conversion := "$trbn_float_to_integer(d "
		if receiver.type_name == "String"
			conversion = "$trbn_string_to_integer(l "
		end
		qbe_output_line(output, "\t" + result + " =l call " + conversion + receiver.operand + ")")
		return emitted_value(result, "Integer", 0, "", "")
	end
	if method == "to_s"
		expect(state, position, ")")
		output.runtime_flags[1] = 1
		result := emit_temporary(context)
		qbe_output_line(
			output,
			"\t" + result + " =l call $trbn_integer_to_string(l " + receiver.operand + ")",
		)
		emit_root_value(context, "String")
		return emitted_value(result, "String", 0, "", "")
	end
	return emitted_value("", "Invalid", 0, "", "")
end

def emit_postfix(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		initial: QbeValue,
	): QbeValue
	mut value := QbeValue.new(
		operand: initial.operand,
		type_name: initial.type_name,
		category: initial.category,
		name: initial.name,
		slot: initial.slot,
		owner: initial.owner,
	)
	mut scanning := true
	while scanning
		if token_is(state, position[0], "[") && hash_key_type(value.type_name) != ""
			value = emit_hash_index(state, position, context, output, value)
			if has_diagnostic(state)
				return value
			end
			next
		end
		if token_is(state, position[0], "(")
			value = emit_direct_call(state, position, context, output, value)
		else
			if token_is(state, position[0], ".")
				advance(position)
				member := expect_identifier(state, position)
				if member == "each" && syntax_iteration_suffix(state, position[0] - 2) >= 0
					position[0] -= 2
					break
				end
				if token_is(state, position[0], "(")
					if value.category < 4
						if value.category == 2
							value = emit_record_new(state, position, context, output, value.name)
						else
							value = emit_method_call(state, position, context, output, value, member)
						end
					end
				else
					record_index := find_record_type(state, value.type_name)
					field_index := find_field(state, record_index, member)
					offset := 8 + (field_index - load_integer(state.record_field_starts, record_index)) * 8
					address := emit_address(context, output, value.operand, offset)
					operand := emit_temporary(context)
					field_type := load_string(state.field_types, field_index)
					emit_typed_load(output, operand, field_type, address)
					note_managed_alias(context, field_type)
					value = emitted_value(
						operand,
						field_type,
						0,
						member,
						address,
					)
				end
			else
				if token_is(state, position[0], "[")
					index_origin := position[0]
					store_origin := checked_array_assignment_store(state, index_origin)
					if store_origin == - 2
						diagnostic(state, "TRBN4004", load_integer(state.token_lines, index_origin), "invalid checked Array assignment target")
						return value
					end
					mut assignment_plan := 0
					if store_origin >= 0
						assignment_plan = checked_array_assignment_plan(state, index_origin)
						if assignment_plan < 0
							diagnostic(state, "TRBN4004", load_integer(state.token_lines, index_origin), "invalid checked Array assignment region")
							return value
						end
					end
					if store_origin >= 0
						if assignment_plan < 2
							# Retain the selected owner even if index/RHS calls replace its
							# last other reference and collect before the final store.
							qbe_output_line(output, "\tcall $trbn_gc_temp_push(l " + value.operand + ")")
							context.temporary_roots_used[0] = 2
						end
					end
					advance(position)
					index := emit_expression(state, position, context, output, 1, "Integer")
					if value.type_name == "String"
						result := emit_temporary(context)
						qbe_output_line(
							output,
							"\t" + result + " =l call $trbn_string_index(l " + value.operand + ", l " + index.operand + ")",
						)
						emit_root_value(context, "String")
						value = emitted_value(result, "String", 0, "", "")
					else
						mut address := ""
						mut inline_address := false
						if context.loop_depth[0] > 0
							if take_inline_budget(context)
								inline_address = true
							end
						end
						if inline_address
							address = emit_array_address(
								context,
								output,
								value.operand,
								value.slot,
								index.operand,
								mir_nonnegative_fact(state, position[0]),
							)
						else
							output.runtime_flags[3] = 1
							address = emit_temporary(context)
							qbe_output_line(
								output,
								"\t" + address + " =l call $trbn_array_address(l " + value.operand + ", l " + index.operand + ")",
							)
						end
						element_type := array_element_type(value.type_name)
						operand := emit_temporary(context)
						emit_typed_load(output, operand, element_type, address)
						note_managed_alias(context, element_type)
						mut owner := ""
						mut retained_position := ""
						if store_origin >= 0
							owner = value.operand
							retained_position = address
							if assignment_plan == 0
								if checked_array_assignment_reads_old(state, index_origin)
									if native_managed_type(element_type)
										qbe_output_line(output, "\tcall $trbn_gc_temp_push(l " + operand + ")")
									end
								end
								# The checked address and current data share the same ABI
								# allocation here. Retain only the logical slot across RHS.
								data_slot := emit_address(context, output, owner, 24)
								data := emit_temporary(context)
								offset := emit_temporary(context)
								retained_position = emit_temporary(context)
								qbe_output_line(output, "\t" + data + " =l loadl " + data_slot)
								qbe_output_line(output, "\t" + offset + " =l sub " + address + ", " + data)
								qbe_output_line(output, "\t" + retained_position + " =l shr " + offset + ", 3")
							end
						end
						value = QbeValue.new(
							operand: operand,
							type_name: element_type,
							category: 3,
							name: "",
							slot: retained_position,
							owner: owner,
						)
					end
					expect(state, position, "]")
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def emit_primary(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		expected: String,
	): QbeValue
	token_index := position[0]
	kind := load_integer(state.token_kinds, token_index)
	if kind == 2
		value := number_without_underscores(load_string(state.token_texts, token_index))
		advance(position)
		if number_is_float(value)
			return emitted_value("d_" + value, "Float", 0, "", "")
		end
		return emitted_value(value, "Integer", 0, "", "")
	end
	if kind == 3
		advance(position)
		return emitted_value("$trbns" + integer_string(load_integer(state.token_lines, token_index)), "String", 0, "", "")
	end
	if token_is(state, token_index, "{")
		return emit_hash_literal(state, position, context, output)
	end
	if token_is(state, token_index, "[")
		return emit_array_literal(state, position, context, output, expected)
	end
	if token_is(state, token_index, "(")
		advance(position)
		skip_newlines(state, position)
		value := emit_expression_value(state, position, context, output, 1, expected)
		skip_newlines(state, position)
		expect(state, position, ")")
		return value
	end
	if token_is(state, token_index, "!")
		advance(position)
		value := emit_postfix(
			state,
			position,
			context,
			output,
			emit_primary(state, position, context, output, "Boolean"),
		)
		result := emit_temporary(context)
		qbe_output_line(output, "\t" + result + " =l ceql " + value.operand + ", 0")
		return emitted_value(result, "Boolean", 0, "", "")
	end
	if token_is(state, token_index, "-")
		advance(position)
		value := emit_postfix(
			state,
			position,
			context,
			output,
			emit_primary(state, position, context, output, ""),
		)
		result := emit_temporary(context)
		if value.type_name == "Float"
			qbe_output_line(output, "\t" + result + " =d sub d_-0.0, " + value.operand)
			return emitted_value(result, "Float", 0, "", "")
		end
		qbe_output_line(output, "\t" + result + " =l call $trbn_integer_subtract(l 0, l " + value.operand + ")")
		return emitted_value(result, "Integer", 0, "", "")
	end
	if token_is(state, token_index, "+")
		advance(position)
		return emit_postfix(
			state,
			position,
			context,
			output,
			emit_primary(state, position, context, output, ""),
		)
	end
	if kind == 1
		name := load_string(state.token_texts, token_index)
		advance(position)
		if name == "true"
			return emitted_value("1", "Boolean", 0, "", "")
		end
		if name == "false"
			return emitted_value("0", "Boolean", 0, "", "")
		end
		mut local_index := context.local_count[0] - 1
		mut found_local :=- 1
		while local_index >= 0
			if load_string(context.local_names, local_index) == name
				found_local = local_index
				local_index =- 1
			else
				local_index -= 1
			end
		end
		if found_local >= 0
			return emit_loaded_local(context, output, found_local)
		end
		standard_package := standard_package_import(state, state.active_module[0], name)
		if standard_package < - 1
			return emitted_value("", standard_package_root(standard_package), 2 - standard_package, name, "")
		end
		if name == "puts"
			return emitted_value("", "", 1, name, "")
		end
		if find_visible_function(state, state.active_module[0], name) >= 0
			return emitted_value("", "", 1, name, "")
		end
		if find_visible_record(state, state.active_module[0], name) >= 0
			return emitted_value("", "", 2, name, "")
		end
	end
	return emitted_value("", "Invalid", 0, "", "")
end

def lower_checked_binary(
		mut state: CompilerState,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		origin: Integer,
		left: QbeValue,
		right: QbeValue,
	): QbeValue
	plan := load_integer(state.mir_nonnegative_facts, origin)
	result_type := checked_binary_plan_type(plan)
	# Verify the checked-origin binding before lowering, without rechecking
	# operand types or reconstructing the result from emitted values.
	operator := load_string(state.token_texts, origin)
	mut valid := result_type != "Invalid"
	if valid
		valid = plan % 16 == binary_operator_id(operator) % 16
	end
	if !valid
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked binary plan")
		return emitted_value("0", "Invalid", 0, "", "")
	end
	# Literal spelling remains transitional until selected inline-call results
	# are represented above the adapter; the operator and result type do not.
	operand := lower_binary_operand(
		context,
		output,
		plan % 16,
		left,
		right,
		result_type,
		small_nonnegative_integer_operand(left.operand),
		small_nonnegative_integer_operand(right.operand),
		0,
	)
	return emitted_value(operand, result_type, 0, "", "")
end

def lower_checked_logical(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		origin: Integer,
		minimum_precedence: Integer,
		left: QbeValue,
	): QbeValue
	plan := load_integer(state.mir_nonnegative_facts, origin)
	short_value := mir_logical_short_value(plan)
	mut valid := short_value >= 0
	if valid
		valid = plan - 64 == binary_operator_id(load_string(state.token_texts, origin))
	end
	if !valid
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked logical plan")
		return emitted_value("0", "Invalid", 0, "", "")
	end
	rhs := emit_label(context)
	short := emit_label(context)
	rhs_done := emit_label(context)
	merge := emit_label(context)
	if short_value == 1
		qbe_output_branch(output, left.operand, short, rhs)
	else
		qbe_output_branch(output, left.operand, rhs, short)
	end
	qbe_output_line(output, short)
	qbe_output_line(output, "\tjmp " + merge)
	qbe_output_line(output, rhs)
	# Header temporaries created on either conditional path do not dominate
	# the merge. The shared managed-root stack remains runtime path-sensitive.
	invalidate_array_header_cache(context)
	right := emit_expression(state, position, context, output, minimum_precedence, "Boolean")
	qbe_output_line(output, "\tjmp " + rhs_done)
	qbe_output_line(output, rhs_done)
	qbe_output_line(output, "\tjmp " + merge)
	qbe_output_line(output, merge)
	result := emit_temporary(context)
	# Explicit incoming blocks keep nested RHS regions valid SSA. A stack slot
	# allocated here would accumulate on every visit inside a loop.
	qbe_output_line(output, "\t" + result + " =l phi " + short + " " + integer_string(short_value) + ", " + rhs_done + " " + right.operand)
	invalidate_array_header_cache(context)
	return emitted_value(result, "Boolean", 0, "", "")
end

def emit_expression_value(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		minimum_precedence: Integer,
		expected: String,
	): QbeValue
	expression_origin := position[0]
	mut value := emit_postfix(
		state,
		position,
		context,
		output,
		emit_primary(state, position, context, output, expected),
	)
	mut scanning := true
	while scanning
		operator_origin := position[0]
		operator := load_string(state.token_texts, position[0])
		precedence := syntax_expression_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			advance(position)
			skip_newlines(state, position)
			if precedence <= 2
				value = lower_checked_logical(state, position, context, output, operator_origin, precedence + 1, value)
				if has_diagnostic(state)
					return value
				end
			else
				end_origin := position[0]
				right := emit_expression(
					state,
					position,
					context,
					output,
					precedence + 1,
					"",
				)
				if precedence == 3
					plan := checked_range_require(state, expression_origin, operator_origin, end_origin, position[0])
					if plan.origin < 0 || value.type_name != plan.start_type || right.type_name != plan.end_type
						diagnostic(state, "TRBN4004", load_integer(state.token_lines, operator_origin), "Range operands disagree with checked MIR")
						return emitted_value("0", "Invalid", 0, "", "")
					end
					result := emit_temporary(context)
					qbe_output_line(output, "\t" + result + " =l call $trbn_gc_alloc(l $trbn_desc_range, l 24, l 0)")
					emit_root_value(context, "Range<Integer>")
					start_slot := emit_address(context, output, result, 8)
					end_slot := emit_address(context, output, result, 16)
					exclusive_slot := emit_address(context, output, result, 24)
					emit_typed_store(output, "Integer", value.operand, start_slot)
					emit_typed_store(output, "Integer", right.operand, end_slot)
					emit_typed_store(output, "Integer", integer_string(plan.exclusive), exclusive_slot)
					value = emitted_value(result, "Range<Integer>", 0, "", "")
				else
					value = lower_checked_binary(state, context, output, operator_origin, value, right)
				end
			end
		end
	end
	return value
end

def emit_expression(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		minimum_precedence: Integer,
		expected: String,
	): QbeValue
	# Grouping preserves inference hints; only the completed expression widens.
	value := emit_expression_value(state, position, context, output, minimum_precedence, expected)
	if expected == "Float"
		if value.type_name == "Integer"
			converted := emit_temporary(context)
			qbe_output_line(output, "\t" + converted + " =d sltof " + value.operand)
			return emitted_value(converted, "Float", 0, "", "")
		end
	end
	return value
end

def emit_declaration(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
	): Boolean
	if token_is(state, position[0], "mut")
		advance(position)
	end
	declaration_origin := position[0]
	name := expect_identifier(state, position)
	mut declared_type := ""
	if token_is(state, position[0], ":")
		advance(position)
		declared_type = parse_type(state, position)
		declared_type = resolve_type_name(state, state.active_module[0], declared_type, false)
	end
	expect(state, position, ":=")
	value := emit_expression(state, position, context, output, 1, declared_type)
	mut local_type := declared_type
	if local_type == ""
		local_type = value.type_name
	end
	slot := emit_add_local(context, output, name, local_type, value.operand, false)
	if header_binding_selected(context.array_header_local_origins, declaration_origin)
		install_stable_array_header(context, output, value.operand, slot)
	end
	return finish_statement(state, position)
end

def emit_checked_assignment_store(
		mut state: CompilerState,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		origin: Integer,
		left: QbeValue,
		operand: String,
	)
	if left.category == 4
		plan := checked_hash_plan(state, origin - 1)
		if plan.kind != 3 || plan.finish + 1 != origin || !checked_hash_valid(state, plan, false) || plan.value_type != left.type_name
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked Hash assignment")
			return
		end
		emit_hash_set(context, output, left.owner, left.slot, operand, plan.value_type)
		return
	end
	mut address := left.slot
	if left.category == 3
		index_origin := checked_array_assignment_target(state, origin) - 1
		mut valid := index_origin >= 0
		if left.owner == ""
			valid = false
		end
		if left.slot == ""
			valid = false
		end
		if !valid
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked Array assignment target")
			return
		end
		if checked_array_assignment_store(state, index_origin) != origin
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked Array assignment target")
			return
		end
		assignment_plan := checked_array_assignment_plan(state, index_origin)
		if assignment_plan < 0
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked Array assignment region")
			return
		end
		if assignment_plan == 0
			output.runtime_flags[3] = 1
			address = emit_temporary(context)
			qbe_output_line(output, "\t" + address + " =l call $trbn_array_address(l " + left.owner + ", l " + left.slot + ")")
		end
	end
	emit_typed_store(output, left.type_name, operand, address)
end

def emit_simple_statement(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
	): Boolean
	left := emit_expression(state, position, context, output, 1, "")
	operator_origin := position[0]
	operator := load_string(state.token_texts, position[0])
	if operator == "="
		advance(position)
		right := emit_expression(state, position, context, output, 1, left.type_name)
		emit_checked_assignment_store(state, context, output, operator_origin, left, right.operand)
	else
		if binary_operator_id(operator) >= 17
			advance(position)
			right := emit_expression(state, position, context, output, 1, left.type_name)
			result := lower_checked_binary(state, context, output, operator_origin, left, right)
			emit_checked_assignment_store(state, context, output, operator_origin, left, result.operand)
		end
	end
	if array_element_type(left.type_name) != ""
		invalidate_array_header_cache(context)
	end
	return finish_statement(state, position)
end

def emit_iteration(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		result_type: String,
		parent_loop: Integer,
	): Boolean
	plan := checked_iteration_require(state, position[0], parent_loop)
	if has_diagnostic(state)
		return false
	end
	invalidate_array_header_cache(context)
	receiver := emit_expression(state, position, context, output, 1, plan.type_name)
	if receiver.type_name != plan.type_name || position[0] != plan.receiver_finish
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, plan.origin), "iteration receiver disagrees with checked MIR")
		return false
	end
	saved_count := context.local_count[0]
	header_count := context.array_header_count[0]
	# Hidden locals keep the receiver and cursor independent of user bindings.
	receiver_slot := emit_add_local(context, output, "$iteration.receiver", plan.type_name, receiver.operand, false)
	mut start := "0"
	mut bound := "0"
	mut exclusive := "0"
	if plan.source_kind == 2
		start = emit_temporary(context)
		bound = emit_temporary(context)
		exclusive = emit_temporary(context)
		start_address := emit_address(context, output, receiver.operand, 8)
		end_address := emit_address(context, output, receiver.operand, 16)
		exclusive_address := emit_address(context, output, receiver.operand, 24)
		emit_typed_load(output, start, "Integer", start_address)
		emit_typed_load(output, bound, "Integer", end_address)
		emit_typed_load(output, exclusive, "Integer", exclusive_address)
	end
	cursor_slot := emit_add_local(context, output, "$iteration.cursor", "Integer", start, false)
	mut ordinal_slot := ""
	if plan.source_kind == 2 && plan.index_origin >= 0
		ordinal_slot = emit_add_local(context, output, "$iteration.ordinal", "Integer", "0", false)
	end
	mut zero := "0"
	if plan.element_type == "Float"
		zero = "d_0"
	end
	element_slot := emit_add_local(context, output, load_string(state.token_texts, plan.element_origin), plan.element_type, zero, false)
	mut index_slot := ""
	if plan.index_origin >= 0
		index_slot = emit_add_local(context, output, load_string(state.token_texts, plan.index_origin), "Integer", "0", false)
	end
	header := emit_label(context)
	body := emit_label(context)
	advance := emit_label(context)
	done := emit_label(context)
	qbe_output_line(output, "\tjmp " + header)
	qbe_output_line(output, header)
	array := emit_temporary(context)
	cursor := emit_temporary(context)
	length_slot := emit_temporary(context)
	length := emit_temporary(context)
	available := emit_temporary(context)
	qbe_output_line(output, "\t" + array + " =l loadl " + receiver_slot)
	qbe_output_line(output, "\t" + cursor + " =l loadl " + cursor_slot)
	if plan.source_kind == 1
		qbe_output_line(output, "\t" + length_slot + " =l add " + array + ", 8")
		qbe_output_line(output, "\t" + length + " =l loadl " + length_slot)
		qbe_output_line(output, "\t" + available + " =w csltl " + cursor + ", " + length)
	else
		before := emit_temporary(context)
		at_end := emit_temporary(context)
		inclusive := emit_temporary(context)
		last := emit_temporary(context)
		qbe_output_line(output, "\t" + before + " =w csltl " + cursor + ", " + bound)
		qbe_output_line(output, "\t" + at_end + " =w ceql " + cursor + ", " + bound)
		qbe_output_line(output, "\t" + inclusive + " =w ceql " + exclusive + ", 0")
		qbe_output_line(output, "\t" + last + " =w and " + at_end + ", " + inclusive)
		qbe_output_line(output, "\t" + available + " =w or " + before + ", " + last)
	end
	qbe_output_branch(output, available, body, done)
	qbe_output_line(output, body)
	mut element := cursor
	if plan.source_kind == 1
		element = emit_temporary(context)
		data_slot := emit_temporary(context)
		data := emit_temporary(context)
		offset := emit_temporary(context)
		address := emit_temporary(context)
		qbe_output_line(output, "\t" + data_slot + " =l add " + array + ", 24")
		qbe_output_line(output, "\t" + data + " =l loadl " + data_slot)
		qbe_output_line(output, "\t" + offset + " =l mul " + cursor + ", 8")
		qbe_output_line(output, "\t" + address + " =l add " + data + ", " + offset)
		emit_typed_load(output, element, plan.element_type, address)
	end
	emit_typed_store(output, plan.element_type, element, element_slot)
	if index_slot != ""
		mut ordinal := cursor
		if ordinal_slot != ""
			ordinal = emit_temporary(context)
			emit_typed_load(output, ordinal, "Integer", ordinal_slot)
		end
		emit_typed_store(output, "Integer", ordinal, index_slot)
	end
	# The Array may lose its current element during the body. Root the binding
	# as well as the retained receiver before any body allocation can collect.
	emit_loop_root_compaction(context, output)
	context.loop_depth[0] = context.loop_depth[0] + 1
	position[0] = plan.body_start
	body_terminated := emit_block(state, position, context, output, result_type, plan.origin, advance, done)
	if position[0] != plan.body_finish
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, plan.origin), "iteration body disagrees with checked MIR")
		return false
	end
	if body_terminated == 0
		qbe_output_line(output, "\tjmp " + advance)
	end
	qbe_output_line(output, advance)
	current := emit_temporary(context)
	incremented := emit_temporary(context)
	qbe_output_line(output, "\t" + current + " =l loadl " + cursor_slot)
	if plan.source_kind == 2
		# Stop at the captured endpoint before adding to portable MAX.
		last := emit_temporary(context)
		step := emit_label(context)
		qbe_output_line(output, "\t" + last + " =w ceql " + current + ", " + bound)
		qbe_output_branch(output, last, done, step)
		qbe_output_line(output, step)
		if ordinal_slot != ""
			# The endpoint guard proves this addition remains portable. Do not
			# increment an ordinal after the final exclusive element.
			following := emit_temporary(context)
			at_end := emit_temporary(context)
			excluded := emit_temporary(context)
			next_index := emit_label(context)
			qbe_output_line(output, "\t" + following + " =l add " + current + ", 1")
			qbe_output_line(output, "\t" + at_end + " =w ceql " + following + ", " + bound)
			qbe_output_line(output, "\t" + excluded + " =w and " + at_end + ", " + exclusive)
			qbe_output_branch(output, excluded, done, next_index)
			qbe_output_line(output, next_index)
			ordinal := emit_temporary(context)
			next_ordinal := emit_temporary(context)
			emit_typed_load(output, ordinal, "Integer", ordinal_slot)
			emit_integer_call(output, next_ordinal, "add", ordinal, "1")
			emit_typed_store(output, "Integer", next_ordinal, ordinal_slot)
		end
	end
	qbe_output_line(output, "\t" + incremented + " =l add " + current + ", 1")
	qbe_output_line(output, "\tstorel " + incremented + ", " + cursor_slot)
	qbe_output_line(output, "\tjmp " + header)
	qbe_output_line(output, done)
	context.local_count[0] = saved_count
	context.loop_depth[0] = context.loop_depth[0] - 1
	context.array_header_count[0] = header_count
	invalidate_array_header_cache(context)
	emit_loop_root_compaction(context, output)
	position[0] = plan.finish
	return finish_statement(state, position)
end

def emit_block(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		result_type: String,
		loop_origin: Integer,
		loop_header: String,
		loop_done: String,
	): Integer
	skip_newlines(state, position)
	mut complete := false
	mut terminated := 0
	while !complete
		if has_diagnostic(state)
			return terminated
		end
		if syntax_loop_transfer_kind(state, position[0]) > 0
			kind := checked_loop_transfer_kind(state, position[0], loop_origin)
			if kind == 0
				return terminated
			end
			mut target := loop_header
			if kind == 1
				target = loop_done
			end
			qbe_output_line(output, "\tjmp " + target)
			advance(position)
			finish_statement(state, position)
			terminated = 1
		elsif sparse_integer_at(state.iteration_origins, position[0]) > 0
			emit_iteration(state, position, context, output, result_type, loop_origin)
		elsif syntax_block_end(state, position[0])
			complete = true
		else
			if syntax_conditional_tail(state, position[0])
				complete = true
			else
				if token_is(state, position[0], "if")
					advance(position)
					condition_value := emit_expression(state, position, context, output, 1, "Boolean")
					finish_statement(state, position)
					when_true := emit_label(context)
					when_false := emit_label(context)
					join := emit_label(context)
					# Checked Booleans are canonical 0/1 long values. QBE jnz may
					# consume their low word without another comparison.
					qbe_output_branch(output, condition_value.operand, when_true, when_false)
					qbe_output_line(output, when_true)
					saved_count := context.local_count[0]
					mut true_terminated := emit_block(state, position, context, output, result_type, loop_origin, loop_header, loop_done)
					context.local_count[0] = saved_count
					if true_terminated == 0
						qbe_output_line(output, "\tjmp " + join)
					end
					invalidate_array_header_cache(context)
					qbe_output_line(output, when_false)
					while token_is(state, position[0], "elsif")
						advance(position)
						branch_condition := emit_expression(state, position, context, output, 1, "Boolean")
						finish_statement(state, position)
						branch_true := emit_label(context)
						branch_false := emit_label(context)
						qbe_output_branch(output, branch_condition.operand, branch_true, branch_false)
						qbe_output_line(output, branch_true)
						branch_terminated := emit_block(state, position, context, output, result_type, loop_origin, loop_header, loop_done)
						context.local_count[0] = saved_count
						if branch_terminated == 0
							true_terminated = 0
							qbe_output_line(output, "\tjmp " + join)
						end
						invalidate_array_header_cache(context)
						qbe_output_line(output, branch_false)
					end
					mut false_terminated := 0
					if token_is(state, position[0], "else")
						advance(position)
						finish_statement(state, position)
						false_terminated = emit_block(state, position, context, output, result_type, loop_origin, loop_header, loop_done)
						context.local_count[0] = saved_count
					end
					if false_terminated == 0
						qbe_output_line(output, "\tjmp " + join)
					end
					expect(state, position, "end")
					finish_statement(state, position)
					if true_terminated == 1
						if false_terminated == 1
							terminated = 1
						else
							qbe_output_line(output, join)
						end
					else
						qbe_output_line(output, join)
					end
					invalidate_array_header_cache(context)
				else
					if token_is(state, position[0], "while")
						while_origin := position[0]
						header_count := context.array_header_count[0]
						invalidate_array_header_cache(context)
						emit_loop_array_headers(context, output, while_origin)
						header := emit_label(context)
						body := emit_label(context)
						done := emit_label(context)
						# Fallback values from an enclosing loop are not invariant on
						# this backedge. Only verified headers survive.
						invalidate_array_header_cache(context)
						qbe_output_line(output, "\tjmp " + header)
						qbe_output_line(output, header)
						mut loop_output := qbe_output_new(
							state.token_count[0] * 8 + 1024,
							output.runtime_flags,
						)
						safe_points_before := context.temporary_roots_used[1]
						advance(position)
						context.loop_depth[0] = context.loop_depth[0] + 1
						condition_value := emit_expression(state, position, context, loop_output, 1, "Boolean")
						finish_statement(state, position)
						qbe_output_branch(loop_output, condition_value.operand, body, done)
						qbe_output_line(loop_output, body)
						saved_count := context.local_count[0]
						body_terminated := emit_block(state, position, context, loop_output, result_type, while_origin, header, done)
						context.local_count[0] = saved_count
						if body_terminated == 0
							qbe_output_line(loop_output, "\tjmp " + header)
						end
						expect(state, position, "end")
						finish_statement(state, position)
						qbe_output_line(loop_output, done)
						if context.temporary_roots_used[1] == safe_points_before
							qbe_output_append(output, loop_output)
							emit_loop_root_compaction(context, output)
						else
							emit_loop_root_compaction(context, output)
							qbe_output_append(output, loop_output)
						end
						invalidate_array_header_cache(context)
						context.array_header_count[0] = header_count
						context.loop_depth[0] = context.loop_depth[0] - 1
					else
						if token_is(state, position[0], "return")
							advance(position)
							if syntax_statement_boundary(state, position[0])
								qbe_output_line(output, "\tjmp @return")
							else
								value := emit_expression(state, position, context, output, 1, result_type)
								emit_typed_store(output, result_type, value.operand, "%return_value")
								qbe_output_line(output, "\tjmp @return")
							end
							finish_statement(state, position)
							terminated = 1
						else
							if declaration_start(state, position[0])
								emit_declaration(state, position, context, output)
							else
								emit_simple_statement(state, position, context, output)
							end
						end
					end
				end
			end
		end
		if terminated == 1
			parse_statement_block(state, position)
			complete = true
		end
	end
	return terminated
end

def emit_function(
		mut state: CompilerState,
		function_index: Integer,
		mut output: QbeOutput,
		inline_budget: Array<Integer>,
	)
	state.active_module[0] = load_integer(state.function_modules, function_index)
	mut context := emit_context_new(
		state.token_count[0] + 1,
		inline_budget,
	)
	mut body := qbe_output_new(state.token_count[0] * 8 + 1024, output.runtime_flags)
	parameter_start := load_integer(state.function_parameter_starts, function_index)
	parameter_count := load_integer(state.function_parameter_counts, function_index)
	mut parameters := ""
	mut parameter_index := 0
	while parameter_index < parameter_count
		if parameters != ""
			parameters += ", "
		end
		parameters += qbe_type(
			load_string(state.parameter_types, parameter_start + parameter_index),
		) + " %p" + integer_string(parameter_index)
		parameter_index += 1
	end
	mut result_prefix := ""
	result_type := load_string(state.function_result_types, function_index)
	if result_type != "Void"
		result_prefix = qbe_type(result_type) + " "
	end
	mir_index := mir_function_index(state.scalar_mir, function_index)
	mir_function := mir_index >= 0
	mut control_mir_function := false
	if mir_function
		mir_row := state.scalar_mir.functions[mir_index]
		control_mir_function = mir_row.kind == 2
	end
	if !mir_function
		parameter_index = 0
		while parameter_index < parameter_count
			declaration_index := parameter_start + parameter_index
			parameter_name := load_string(state.parameter_names, declaration_index)
			initial := "%p" + integer_string(parameter_index)
			slot := emit_add_local(
				context,
				body,
				parameter_name,
				load_string(state.parameter_types, declaration_index),
				initial,
				!function_reassigns_parameter(state, function_index, parameter_name),
			)
			if header_binding_selected(state.scalar_mir.array_headers[function_index], parameter_index)
				install_stable_array_header(context, body, initial, slot)
			end
			parameter_index += 1
		end
	end
	header_plan := state.scalar_mir.array_headers[function_index]
	mut header_index := 0
	while header_index < header_plan.size()
		binding := state.scalar_mir.array_regions[function_index][header_plan[header_index]]
		if binding.kind == 2
			context.array_header_local_origins.push(binding.origin)
		end
		header_index += 1
	end
	loop_plan := state.scalar_mir.array_loop_headers[function_index]
	header_index = 0
	while header_index < loop_plan.size()
		region := state.scalar_mir.array_regions[function_index]
		binding := region[loop_plan[header_index + 2]]
		mut slot := binding.operand
		if binding.kind == 1
			slot = loop_plan[header_index + 2]
		end
		context.array_loop_headers.push([region[loop_plan[header_index]].origin, region[loop_plan[header_index + 1]].origin, slot])
		header_index += 3
	end
	mut terminated := 0
	mut general_mir_function := false
	if mir_function
		general_mir_function = state.scalar_mir.functions[mir_index].kind == 3
	end
	if general_mir_function
		emit_control_mir(state, function_index, result_type, output.mir_literal_symbols, context, body)
		terminated = 1
	elsif control_mir_function
		emit_induction_mir(state, function_index, result_type, context, body)
		terminated = 1
	else
		if mir_function
			mut argument_operands: Array<String> := []
			mut argument_types: Array<String> := []
			mut argument_facts: Array<Integer> := []
			parameter_index = 0
			while parameter_index < parameter_count
				argument_operands.push("%p" + integer_string(parameter_index))
				argument_types.push(load_string(state.parameter_types, parameter_start + parameter_index))
				argument_facts.push(0)
				parameter_index += 1
			end
			value := emit_scalar_mir(
				state,
				function_index,
				argument_operands,
				argument_types,
				argument_facts,
				context,
				body,
				false,
			)
			emit_typed_store(body, result_type, value.operand, "%return_value")
			qbe_output_line(body, "\tjmp @return")
			terminated = 1
		else
			mut position := [load_integer(state.function_body_starts, function_index)]
			terminated = emit_block(
				state,
				position,
				context,
				body,
				result_type,
				- 1,
				"",
				"",
			)
		end
	end
	if terminated == 0
		if result_type == "Void"
			qbe_output_line(body, "\tjmp @return")
		else
			qbe_output_line(body, "\tcall $trbn_fail(l $trbn_integer_error, l 32)")
			qbe_output_line(body, "\thlt")
		end
	end
	qbe_output_line(
		output,
		"function " + result_prefix + "$trbnf" + integer_string(function_index) + "(" + parameters + ") {",
	)
	qbe_output_line(output, "@start")
	# State 2 combines a managed temporary with a following collection safe
	# point. Either condition alone does not require publishing the frame.
	mut uses_temporary_roots := context.temporary_roots_used[0] == 2
	mut managed_local_count := context.managed_local_high_water[0]
	if general_mir_function
		plan := state.scalar_mir.root_plans[mir_index]
		uses_temporary_roots = plan.instructions.size() > 0
		managed_local_count = plan.capacity
	end
	if uses_temporary_roots
		qbe_output_line(output, "\t%temporary_roots =l loadl $trbn_gc_temp_count")
	end
	if result_type != "Void"
		qbe_output_line(output, "\t%return_value =l alloc8 8")
	end
	# QBE allocates dynamically when an alloc instruction executes, so lexical
	# local slots must precede every branch and loop in the function body.
	mut slot_index := 0
	while slot_index < context.slot_count[0]
		qbe_output_line(
			output,
			"\t%v" + integer_string(slot_index) + " =l alloc8 8",
		)
		slot_index += 1
	end
	if uses_temporary_roots
		if managed_local_count > 0
			qbe_output_line(
				output,
				"\t%root_capacity =l add %temporary_roots, " + integer_string(managed_local_count),
			)
			qbe_output_line(output, "\tcall $trbn_gc_temp_reserve(l %root_capacity)")
		end
	end
	mut body_index := 0
	mut inside_root_publication := false
	while body_index < body.count[0]
		line := load_string(body.lines, body_index)
		if line == "{"
			inside_root_publication = true
		else
			if line == "}"
				inside_root_publication = false
			else
				if uses_temporary_roots
					if line == "\tcall $trbn_gc_temp_reset(l %temporary_roots)"
						qbe_output_line(output, "\tstorel %temporary_roots, $trbn_gc_temp_count")
					else
						qbe_output_line(output, line)
					end
				else
					if !inside_root_publication
						if line != "\tcall $trbn_gc_temp_reset(l %temporary_roots)"
							qbe_output_line(output, line)
						end
					end
				end
			end
		end
		body_index += 1
	end
	if context.array_bounds_failure_used[0]
		qbe_output_line(output, "@array_bounds_failure")
		qbe_output_line(output, "\tcall $trbn_fail(l $trbn_bounds_error, l 30)")
		qbe_output_line(output, "\thlt")
	end
	if context.scalar_inline_range_failure_used[0]
		qbe_output_line(output, "@scalar_inline_integer_range_failure")
		qbe_output_line(output, "\tcall $trbn_fail(l $trbn_integer_range_error, l 45)")
		qbe_output_line(output, "\thlt")
	end
	qbe_output_line(output, "@return")
	if uses_temporary_roots
		qbe_output_line(output, "\tstorel %temporary_roots, $trbn_gc_temp_count")
	end
	if result_type == "Void"
		qbe_output_line(output, "\tret")
	else
		emit_typed_load(output, "%return_result", result_type, "%return_value")
		if native_managed_type(result_type)
			qbe_output_line(output, "\tcall $trbn_gc_temp_push(l %return_result)")
		end
		qbe_output_line(output, "\tret %return_result")
	end
	qbe_output_line(output, "}\n")
	compiler_reset_temporary_storage()
	return
end

def compiler_file_entry_function(state: CompilerState): Integer
	index := find_function_in_module(state, state.entry_module[0], "compiler_file_main")
	if index < 0
		return - 1
	end
	if load_integer(state.function_parameter_counts, index) != 4
		return - 1
	end
	start := load_integer(state.function_parameter_starts, index)
	if load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if load_string(state.parameter_types, start + 2) != "String"
		return - 1
	end
	if load_string(state.parameter_types, start + 3) != "Boolean"
		return - 1
	end
	if load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def emit_process_arguments(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\t%process_argc =l extsw %argc\n\tstorel %process_argc, $trbn_process_argc\n\tstorel %argv, $trbn_process_argv_pointer",
	)
	return
end

def emit_target_entry(mut output: QbeOutput)
	qbe_output_line(output, "\nexport function w $main(w %argc, l %argv) {")
	qbe_output_line(output, "@start")
	qbe_output_line(output, "\tcall $trbn_gc_trace_initialize()")
	if output.runtime_flags[2] == 1
		qbe_output_line(output, "\tcall $trbn_static_strings_initialize()")
	end
	if output.runtime_flags[1] == 1
		emit_process_arguments(output)
	end
	qbe_output_line(output, "\tstorel $trbn_qbe_darwin_arm64, $trbn_selected_qbe_target")
	qbe_output_line(output, "\tstorel $trbn_dead_strip_darwin, $trbn_selected_dead_strip")
	qbe_output_line(output, "\tstorel 0, $trbn_project_selected_linker")
	qbe_output_line(output, "\t%a11 =w ceqw %argc, 11")
	qbe_output_line(output, "\tjnz %a11, @target_shape, @dispatch")
	qbe_output_line(output, "@target_shape")
	qbe_output_line(output, "\t%target_flag_pointer =l add %argv, 72")
	qbe_output_line(output, "\t%target_flag =l loadl %target_flag_pointer")
	qbe_output_line(output, "\t%target_flag_comparison =w call $strcmp(l %target_flag, l $trbn_target_option)")
	qbe_output_line(output, "\t%target_flag_ok =w ceqw %target_flag_comparison, 0")
	qbe_output_line(output, "\tjnz %target_flag_ok, @target_profile, @dispatch")
	qbe_output_line(output, "@target_profile")
	qbe_output_line(output, "\t%profile_pointer =l add %argv, 80")
	qbe_output_line(output, "\t%profile =l loadl %profile_pointer")
	qbe_output_line(output, "\t%darwin_comparison =w call $strcmp(l %profile, l $trbn_profile_darwin_arm64)")
	qbe_output_line(output, "\t%darwin =w ceqw %darwin_comparison, 0")
	qbe_output_line(output, "\tjnz %darwin, @target_darwin, @target_linux_check")
	qbe_output_line(output, "@target_darwin")
	qbe_output_line(output, "\tjmp @invoke_target")
	qbe_output_line(output, "@target_linux_check")
	qbe_output_line(output, "\t%linux_comparison =w call $strcmp(l %profile, l $trbn_profile_linux_arm64)")
	qbe_output_line(output, "\t%linux =w ceqw %linux_comparison, 0")
	qbe_output_line(output, "\tjnz %linux, @target_linux_arm64, @target_linux_amd64_check")
	qbe_output_line(output, "@target_linux_arm64")
	qbe_output_line(output, "\tstorel $trbn_qbe_linux_arm64, $trbn_selected_qbe_target")
	qbe_output_line(output, "\tjmp @target_linux_common")
	qbe_output_line(output, "@target_linux_amd64_check")
	qbe_output_line(output, "\t%linux_amd64_comparison =w call $strcmp(l %profile, l $trbn_profile_linux_amd64)")
	qbe_output_line(output, "\t%linux_amd64 =w ceqw %linux_amd64_comparison, 0")
	qbe_output_line(output, "\tjnz %linux_amd64, @target_linux_amd64, @target_error")
	qbe_output_line(output, "@target_linux_amd64")
	qbe_output_line(output, "\tstorel $trbn_qbe_linux_amd64, $trbn_selected_qbe_target")
	qbe_output_line(output, "\tjmp @target_linux_common")
	qbe_output_line(output, "@target_linux_common")
	qbe_output_line(output, "\tstorel $trbn_dead_strip_linux, $trbn_selected_dead_strip")
	qbe_output_line(output, "\tstorel $trbn_project_linker_lld, $trbn_project_selected_linker")
	qbe_output_line(output, "\tjmp @invoke_target")
	qbe_output_line(output, "@target_error")
	qbe_output_line(output, "\tcall $write(w 2, l $trbn_target_error, l 37)")
	qbe_output_line(output, "\tcall $trbn_gc_finish()")
	qbe_output_line(output, "\tret 64")
	qbe_output_line(output, "@invoke_target")
	qbe_output_line(output, "\t%target_status =w call $trbn_compiler_dispatch(w 9, l %argv)")
	qbe_output_line(output, "\tcall $trbn_gc_finish()")
	qbe_output_line(output, "\tret %target_status")
	qbe_output_line(output, "@dispatch")
	qbe_output_line(output, "\t%dispatch_status =w call $trbn_compiler_dispatch(w %argc, l %argv)")
	qbe_output_line(output, "\tcall $trbn_gc_finish()")
	qbe_output_line(output, "\tret %dispatch_status")
	qbe_output_line(output, "}")
	return
end

def emit_entry(mut state: CompilerState, mut output: QbeOutput)
	compiler_entry := compiler_entry_function(state)
	if compiler_entry >= 0
		compiler_file_entry := compiler_file_entry_function(state)
		qbe_output_line(output, "function w $trbn_compiler_dispatch(w %argc, l %argv) {")
		qbe_output_line(output, "@start")
		qbe_output_line(
			output,
			"\t%a9 =w ceqw %argc, 9\n\tjnz %a9, @bshape, @other\n@bshape\n\t%bcmdp =l add %argv, 8\n\t%bcmd =l loadl %bcmdp\n\t%boc =w call $strcmp(l %bcmd, l $trbn_build)\n\t%bok =w ceqw %boc, 0\n\t%bofp =l add %argv, 24\n\t%bof =l loadl %bofp\n\t%bofc =w call $strcmp(l %bof, l $trbn_output_flag)\n\t%bofo =w ceqw %bofc, 0\n\t%bqfp =l add %argv, 40\n\t%bqf =l loadl %bqfp\n\t%bqfc =w call $strcmp(l %bqf, l $trbn_qbe_flag)\n\t%bqfo =w ceqw %bqfc, 0\n\t%bcfp =l add %argv, 56\n\t%bcf =l loadl %bcfp\n\t%bcfc =w call $strcmp(l %bcf, l $trbn_cc_flag)\n\t%bcfo =w ceqw %bcfc, 0\n\t%bv0 =w and %bok, %bofo\n\t%bv1 =w and %bqfo, %bcfo\n\t%bv =w and %bv0, %bv1\n\tjnz %bv, @build, @usage\n@build\n\t%bspp =l add %argv, 16\n\t%bsp =l loadl %bspp\n\t%bsrc =l call $trbn_read_file(l %bsp)\n\t%bsm =w ceql %bsrc, 0\n\tjnz %bsm, @bread_error, @bpaths\n@bread_error\n\tcall $write(w 2, l $trbn_file_error, l 35)\n\t%bspl =l call $strlen(l %bsp)\n\tcall $write(w 2, l %bsp, l %bspl)\n\tcall $write(w 2, l $trbn_newline, l 1)\n\tret 66\n@bpaths\n\t%bop =l add %argv, 32\n\t%bo =l loadl %bop\n\t%bqp =l add %argv, 48\n\t%bqbe =l loadl %bqp\n\t%bcp =l add %argv, 64\n\t%bcc =l loadl %bcp\n\t%bssa =l call $trbn_c_concat(l %bo, l $trbn_ssa_suffix)\n\t%basm =l call $trbn_c_concat(l %bo, l $trbn_asm_suffix)\n\t%bf =l call $fopen(l %bssa, l $trbn_wb)\n\t%bfm =w ceql %bf, 0\n\tjnz %bfm, @bfile_error, @bredirect\n@bfile_error\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $trbn_intermediate_error, l 42)\n\tret 73\n@bredirect\n\t%bfd =w call $fileno(l %bf)\n\t%bsaved =w call $dup(w 1)\n\t%bfdb =w csltw %bfd, 0\n\t%bsavedb =w csltw %bsaved, 0\n\t%brb =w or %bfdb, %bsavedb\n\tjnz %brb, @bredirect_error, @bset_stdout\n@bset_stdout\n\t%bset =w call $dup2(w %bfd, w 1)\n\t%bsetb =w csltw %bset, 0\n\tjnz %bsetb, @bredirect_error, @bcompile\n@bredirect_error\n\t%bci =w call $close(w %bsaved)\n\t%bfci =w call $fclose(l %bf)\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $trbn_intermediate_error, l 42)\n\tret 73\n@bcompile\n\t%bm =l call $trbn_string_from_c(l $trbn_emit)",
		)
		qbe_output_line(
			output,
			"\t%bpath =l call $trbn_string_from_c(l %bsp)",
		)
		qbe_output_line(
			output,
			"\t%bst =l call $trbnf" + integer_string(compiler_file_entry) +
			"(l %bsrc, l %bpath, l %bm, l 1)",
		)
		qbe_output_line(
			output,
			"\t%brestore =w call $dup2(w %bsaved, w 1)\n\t%bclosed =w call $close(w %bsaved)\n\t%bfclosed =w call $fclose(l %bf)\n\t%brb0 =w csltw %brestore, 0\n\t%brb1 =w csltw %bclosed, 0\n\t%brb2 =w cnew %bfclosed, 0\n\t%brb3 =w or %brb0, %brb1\n\t%brbad =w or %brb3, %brb2\n\tjnz %brbad, @bpost_error, @bcompiled\n@bpost_error\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $trbn_intermediate_error, l 42)\n\tret 73\n@bcompiled\n\t%bcfail =w cnel %bst, 0\n\tjnz %bcfail, @bcompiler_failed, @bqbe\n@bcompiler_failed\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tret 1\n@bqbe\n\t%bqs =w call $trbn_run_qbe(l %bqbe, l %bssa, l %basm)\n\t%bqfail =w cnew %bqs, 0\n\tjnz %bqfail, @bqbe_failed, @btemp\n@bqbe_failed\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $trbn_qbe_error, l 21)\n\tret 70\n@btemp\n\t%btmpl =l call $trbn_c_concat(l %bo, l $trbn_temp_suffix)\n\t%bdir =l call $mkdtemp(l %btmpl)\n\t%bdfail =w ceql %bdir, 0\n\tjnz %bdfail, @btemp_failed, @btemp_path\n@btemp_failed\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $write(w 2, l $trbn_intermediate_error, l 42)\n\tret 73\n@btemp_path\n\t%bbase =l call $trbn_c_basename(l %bo)\n\t%bdp =l call $trbn_c_concat(l %bdir, l $trbn_slash)\n\t%bexe =l call $trbn_c_concat(l %bdp, l %bbase)\n\t%bcs =w call $trbn_project_run_cc(l %bcc, l %basm, l %bexe)\n\t%bccfail =w cnew %bcs, 0\n\tjnz %bccfail, @bcc_failed, @bpublish\n@bcc_failed\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $trbn_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $trbn_cc_error, l 20)\n\tret 70\n@bpublish\n\t%bpr =w call $rename(l %bexe, l %bo)\n\t%bpf =w cnew %bpr, 0\n\tjnz %bpf, @bpublish_failed, @bsuccess\n@bpublish_failed\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $trbn_cleanup_output(l %bexe, l %bdir)\n\tcall $write(w 2, l $trbn_publish_error, l 32)\n\tret 73\n@bsuccess\n\tcall $trbn_cleanup(l %bssa, l %basm)\n\tcall $trbn_cleanup_output(l %bexe, l %bdir)\n\tret 0\n@other\n\t%a3 =w ceqw %argc, 3\n\tjnz %a3, @fargs, @hargc\n@hargc\n\t%a4 =w ceqw %argc, 4\n\tjnz %a4, @hargs, @usage\n@hargs\n\t%hfp =l add %argv, 8\n\t%hf =l loadl %hfp\n\t%hfc =w call $strcmp(l %hf, l $trbn_source_arg)\n\t%valid_hf =w ceqw %hfc, 0\n\tjnz %valid_hf, @hidden, @usage\n@usage\n\tcall $write(w 2, l $trbn_usage_error, l 103)\n\tret 64\n@hidden\n\t%hmp =l add %argv, 16\n\t%hmc =l loadl %hmp\n\t%hm =l call $trbn_string_from_c(l %hmc)\n\t%hsp =l add %argv, 24\n\t%hsc =l loadl %hsp\n\t%hs =l call $trbn_string_from_c(l %hsc)",
		)
		qbe_output_line(
			output,
			"\t%hst =l call $trbnf" + integer_string(compiler_entry) +
			"(l %hs, l %hm, l 0)",
		)
		qbe_output_line(
			output,
			"\tret 0\n@fargs\n\t%fmp =l add %argv, 8\n\t%fmc =l loadl %fmp\n\t%cc =w call $strcmp(l %fmc, l $trbn_check)\n\t%cm =w ceqw %cc, 0\n\t%ec =w call $strcmp(l %fmc, l $trbn_emit)\n\t%em =w ceqw %ec, 0\n\t%valid_fm =w or %cm, %em\n\tjnz %valid_fm, @file, @usage\n@file\n\t%pp =l add %argv, 16\n\t%path =l loadl %pp\n\t%src =l call $trbn_read_file(l %path)\n\t%rf =w ceql %src, 0\n\tjnz %rf, @read_error, @compile\n@read_error\n\tcall $write(w 2, l $trbn_file_error, l 35)\n\t%pl =l call $strlen(l %path)\n\tcall $write(w 2, l %path, l %pl)\n\tcall $write(w 2, l $trbn_newline, l 1)\n\tret 66\n@compile\n\t%fm =l call $trbn_string_from_c(l %fmc)",
		)
		qbe_output_line(
			output,
			"\t%fpath =l call $trbn_string_from_c(l %path)",
		)
		qbe_output_line(
			output,
			"\t%fst =l call $trbnf" + integer_string(compiler_file_entry) +
			"(l %src, l %fpath, l %fm, l 1)",
		)
		qbe_output_line(output, "\t%failed =w cnel %fst, 0\n\tret %failed")
	else
		qbe_output_line(output, "export function w $main(w %argc, l %argv) {")
		qbe_output_line(output, "@start")
		qbe_output_line(output, "\tcall $trbn_gc_trace_initialize()")
		if output.runtime_flags[2] == 1
			qbe_output_line(output, "\tcall $trbn_static_strings_initialize()")
		end
		if output.runtime_flags[1] == 1
			emit_process_arguments(output)
		end
		main_index := find_function_in_module(state, state.entry_module[0], "main")
		qbe_output_line(output, "\tcall $trbnf" + integer_string(main_index) + "()")
		qbe_output_line(output, "\tcall $trbn_gc_finish()")
		qbe_output_line(output, "\tret 0")
	end
	qbe_output_line(output, "}")
	if compiler_entry >= 0
		cli_entry := find_function_in_module(state, state.entry_module[0], "native_cli_main")
		if cli_entry >= 0
			output.runtime_flags[1] = 1
			runtime_module := find_module(state, "host")
			runtime_function := find_function_in_module(state, runtime_module, "native_cli_runtime_qbe")
			if runtime_function < 0
				diagnostic(state, "TRBN4005", 1, "Native CLI runtime template is missing")
				return
			end
			runtime_token := load_integer(state.function_body_starts, runtime_function) + 1
			if load_integer(state.token_kinds, runtime_token) != 3
				diagnostic(state, "TRBN4005", 1, "Native CLI runtime template must be a literal String")
				return
			end
			qbe_output_line(output, load_string(state.token_texts, runtime_token))
			qbe_output_line(output, "export function w $main(w %argc, l %argv) {\n@start\n\tcall $trbn_gc_trace_initialize()")
			if output.runtime_flags[2] == 1
				qbe_output_line(output, "\tcall $trbn_static_strings_initialize()")
			end
			emit_process_arguments(output)
			qbe_output_line(output, "\t%status =l call $trbnf" + integer_string(cli_entry) + "()\n\tcall $trbn_gc_finish()\n\tret %status\n}")
		else
			emit_target_entry(output)
		end
	end
	return
end

def emit_qbe(mut state: CompilerState): QbeOutput
	mut output := qbe_output_new(state.token_count[0] * 24 + 4096, [0, 0, 0, 0, 0, 0])
	emit_static_strings(state, output)
	if has_diagnostic(state)
		return output
	end
	emit_record_descriptors(state, output)
	compiler_runtime := compiler_entry_function(state) >= 0
	emit_qbe_runtime(output, compiler_runtime)
	function_count := state.function_count[0]
	mut inline_budget := [0, 0, - 2]
	if function_count <= 32
		inline_budget[0] = 64
		inline_budget[1] = 6
		inline_budget[2] = 2
	else
		if function_count <= 96
			inline_budget[0] = 32
			inline_budget[1] = 3
		end
	end
	mut function_index := 0
	# Flat recovery and CLI input retain their source fallbacks. Ordinary compiler
	# intrinsics are omitted by declaration identity, independent of source order.
	mut omit_intrinsics := false
	if compiler_runtime && state.module_count[0] > 1 && find_function_in_module(state, state.entry_module[0], "native_cli_main") < 0
		omit_intrinsics = true
	end
	mut deferred_function :=- 1
	while function_index < function_count
		mut deferred := false
		if function_count <= 32
			if deferred_function < 0
				if scalar_leaf_inline_eligible(state, function_index)
					deferred_function = function_index
					deferred = true
				end
			end
		end
		mut intrinsic := false
		if omit_intrinsics && load_integer(state.function_modules, function_index) == state.entry_module[0]
			intrinsic = compiler_runtime_intrinsic(load_string(state.function_names, function_index))
		end
		if !deferred && !intrinsic
			emit_function(state, function_index, output, inline_budget)
		end
		function_index += 1
	end
	if deferred_function >= 0
		if inline_budget[2] == - 1
			emit_function(state, deferred_function, output, inline_budget)
		end
	end
	emit_entry(state, output)
	if output.runtime_flags[3] == 1
		qbe_output_line(
			output,
			"\nfunction l $trbn_array_address(l %array, l %requested) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%negative =w csltl %requested, 0\n\tjnz %negative, @negative, @check\n@negative\n\t%adjusted_negative =l add %length, %requested\n\tjmp @bounds\n@check\n\t%adjusted_positive =l copy %requested\n\tjmp @bounds\n@bounds\n\t%index =l phi @negative %adjusted_negative, @check %adjusted_positive\n\t%valid =w cultl %index, %length\n\tjnz %valid, @load, @fail\n@fail\n\tcall $trbn_fail(l $trbn_bounds_error, l 30)\n\thlt\n@load\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%offset =l mul %index, 8\n\t%address =l add %data, %offset\n\tret %address\n}",
		)
	end
	if output.runtime_flags[4] == 1
		emit_boolean_puts_runtime(output)
	end
	if output.runtime_flags[5] == 1
		emit_hash_runtime(output)
	end
	if output.runtime_flags[0] == 1
		emit_float_array_runtime(output)
	end
	if output.runtime_flags[1] == 1
		emit_process_runtime(output)
		emit_string_to_integer_runtime(output)
		emit_integer_to_string_runtime(output)
		emit_float_to_integer_runtime(output)
	end
	return output
end

def compiler_eputs(_value: String)
	return
end

def print_diagnostic(state: CompilerState, file_mode: Boolean)
	mut message := ""
	module_index := load_integer(state.diagnostic_modules, 0)
	if module_index > 0
		message += load_string(state.module_files, module_index) + ":"
	end
	message += load_string(state.diagnostic_codes, 0) + ":"
	message += integer_string(load_integer(state.diagnostic_lines, 0))
	message += ":"
	message += load_string(state.diagnostic_messages, 0)
	if file_mode
		compiler_eputs(message)
	else
		puts(message)
	end
	return
end

def compile_state(mut state: CompilerState, mode: String, file_mode: Boolean): Integer
	if !has_diagnostic(state)
		resolve(state)
	end
	if !has_diagnostic(state)
		check(state)
	end
	if has_diagnostic(state)
		print_diagnostic(state, file_mode)
		return 1
	end
	if mode == "check"
		puts("ok")
		return 0
	end
	if mode == "emit-qbe"
		output := emit_qbe(state)
		if has_diagnostic(state)
			print_diagnostic(state, file_mode)
			return 1
		end
		mut position := [0]
		while position[0] < output.count[0]
			puts(qbe_output_chunk(output, position))
		end
		return 0
	end
	message := "TRBN4006:1:unsupported compiler mode " + mode
	if file_mode
		compiler_eputs(message)
	else
		puts(message)
	end
	return 64
end

def compiler_main(source: String, mode: String, file_mode: Boolean): Integer
	mut state := compiler_new(source.size() * 3 + 16)
	lex(state, source)
	if !has_diagnostic(state)
		parse_module(state, 0, state.entry_module[0])
	end
	return compile_state(state, mode, file_mode)
end

def compiler_file_main(source: String, path: String, mode: String, file_mode: Boolean): Integer
	mut state := compiler_new(1)
	if path_basename(path) == "trbconfig.jsonc"
		state = load_configured_project(source, path)
	else
		state = load_file_root(source, path)
	end
	return compile_state(state, mode, file_mode)
end

def character_in(character: String, characters: String): Boolean
	mut index := 0
	while index < characters.size()
		if characters[index] == character
			return true
		end
		index += 1
	end
	return false
end

def number_character(character: String): Boolean
	if character_in(character, "0123456789")
		return true
	end
	return character == "_"
end

def push_token(mut state: CompilerState, kind: Integer, text: String, line: Integer)
	mut index := state.token_count[0]
	# The following token distinguishes a complete right literal from a postfix.
	if index >= 3
		if load_integer(state.token_kinds, index - 3) == 3
			if load_integer(state.token_kinds, index - 2) == 5
				if load_string(state.token_texts, index - 2) == "+"
					if load_integer(state.token_kinds, index - 1) == 3
						if text != "."
							if text != "["
								combined := load_string(state.token_texts, index - 3) + load_string(state.token_texts, index - 1)
								store_string(state.token_texts, index - 3, combined)
								index -= 2
							end
						end
					end
				end
			end
		end
	end
	store_integer(state.token_kinds, index, kind)
	store_string(state.token_texts, index, text)
	store_integer(state.token_lines, index, line)
	state.token_count[0] = index + 1
	return
end

def scan_identifier(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if character_in(
					source[position[0]],
					"0123456789fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
				)
				advance(position)
			else
				scanning = false
			end
		end
	end
	if position[0] < source.size()
		if source[position[0]] == "?"
			advance(position)
		end
	end
	push_token(state, 1, compiler_source_slice(source, start, position[0]), line)
	return
end

def scan_number(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if number_character(source[position[0]])
				advance(position)
			else
				scanning = false
			end
		end
	end
	if position[0] + 1 < source.size()
		if source[position[0]] == "."
			if character_in(source[position[0] + 1], "0123456789")
				advance(position)
				scanning = true
				while scanning
					if position[0] >= source.size()
						scanning = false
					else
						if number_character(source[position[0]])
							advance(position)
						else
							scanning = false
						end
					end
				end
			end
		end
	end
	push_token(state, 2, compiler_source_slice(source, start, position[0]), line)
	return
end

def decode_escape(mut state: CompilerState, escaped: String, line: Integer): String
	mut value := ""
	if escaped == "n"
		value = "\n"
	else
		if escaped == "t"
			value = "\t"
		else
			if escaped == "r"
				value = "\r"
			else
				if escaped == "\""
					value = "\""
				else
					if escaped == "\\"
						value = "\\"
					else
						diagnostic(state, "TRBN4001", line, "unsupported String escape")
					end
				end
			end
		end
	end
	return value
end

# Locate embedded expressions without treating quoted braces as delimiters.
def interpolation_end(source: String, mut index: Integer): Integer
	mut depth := 1
	while index < source.size()
		character := source[index]
		if character == "\""
			index = interpolation_quote_end(source, index + 1)
			if index < 0
				return - 1
			end
		else
			if character == "{"
				depth += 1
			end
			if character == "}"
				depth -= 1
				if depth == 0
					return index
				end
			end
			if character == "#"
				mut comment := true
				while comment
					if index >= source.size()
						comment = false
					else
						if source[index] == "\n"
							comment = false
						else
							index += 1
						end
					end
				end
			end
		end
		index += 1
	end
	return - 1
end

def interpolation_quote_end(source: String, mut index: Integer): Integer
	while index < source.size()
		character := source[index]
		if character == "\\"
			index += 1
		else
			if character == "\""
				return index
			end
			if character == "#"
				if index + 1 < source.size()
					if source[index + 1] == "{"
						index = interpolation_end(source, index + 2)
						if index < 0
							return - 1
						end
					end
				end
			end
		end
		index += 1
	end
	return - 1
end

# Normalize interpolation to grouped String concatenation before checking.
# Each embedded expression is evaluated once by the shared ordinary pipeline.
def scan_string(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		mut line: Integer,
		interpolation: Boolean,
	): Integer
	start_line := line
	advance(position)
	mut interpolated := false
	mut text := ""
	mut chunk_start := position[0]
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			current := source[position[0]]
			if current == "\""
				text += compiler_source_slice(source, chunk_start, position[0])
				closed = true
				scanning = false
				advance(position)
			else
				if current == "\n"
					diagnostic(state, "TRBN4001", line, "unterminated String literal")
					scanning = false
				else
					if current == "\\"
						text += compiler_source_slice(source, chunk_start, position[0])
						advance(position)
						if position[0] >= source.size()
							diagnostic(state, "TRBN4001", line, "unterminated String escape")
							scanning = false
						else
							mut escaped_hash := source[position[0]] == "#"
							if escaped_hash
								escaped_hash = interpolation
							end
							if escaped_hash
								text += "#"
							else
								text += decode_escape(state, source[position[0]], line)
							end
							advance(position)
							chunk_start = position[0]
						end
					else
						if current == "#"
							if position[0] + 1 < source.size()
								mut opening := source[position[0] + 1] == "{"
								if opening
									opening = interpolation
								end
								if opening
									finish := interpolation_end(source, position[0] + 2)
									if finish < 0
										diagnostic(state, "TRBN4001", line, "unterminated String interpolation")
										scanning = false
									else
										if finish == position[0] + 2
											position[0] = finish + 1
										else
											if !interpolated
												push_token(state, 5, "(", start_line)
												interpolated = true
											end
											text += compiler_source_slice(source, chunk_start, position[0])
											push_token(state, 3, text, line)
											push_token(state, 5, "+", line)
											push_token(state, 5, "(", line)
											first_token := state.token_count[0]
											inner := compiler_source_slice(source, position[0] + 2, finish)
											mut first := 0
											mut last := inner.size()
											mut inner_line := line
											mut trim := true
											while trim
												if first >= last
													trim = false
												else
													if character_in(inner[first], " \t\r\n")
														if inner[first] == "\n"
															inner_line += 1
														end
														first += 1
													else
														trim = false
													end
												end
											end
											trim = true
											while trim
												if last <= first
													trim = false
												else
													if character_in(inner[last - 1], " \t\r\n")
														last -= 1
													else
														trim = false
													end
												end
											end
											lex_source(state, compiler_source_slice(inner, first, last), 0)
											state.token_count[0] = state.token_count[0] - 1
											mut token := first_token
											while token < state.token_count[0]
												store_integer(state.token_lines, token, load_integer(state.token_lines, token) + inner_line - 1)
												token += 1
											end
											if has_diagnostic(state)
												store_integer(state.diagnostic_lines, 0, load_integer(state.diagnostic_lines, 0) + inner_line - 1)
												return line - start_line
											end
											mut character_index := 0
											while character_index < inner.size()
												if inner[character_index] == "\n"
													line += 1
												end
												character_index += 1
											end
											push_token(state, 5, ")", line)
											push_token(state, 5, "+", line)
											position[0] = finish + 1
											chunk_start = position[0]
											text = ""
										end
									end
								else
									advance(position)
								end
							else
								advance(position)
							end
						else
							advance(position)
						end
					end
				end
			end
		end
	end
	if closed
		push_token(state, 3, text, line)
		if interpolated
			push_token(state, 5, ")", line)
		end
	else
		if !has_diagnostic(state)
			diagnostic(state, "TRBN4001", line, "unterminated String literal")
		end
	end
	return line - start_line
end

def two_character_symbol(pair: String): Boolean
	mut supported := false
	if pair == "||"
		supported = true
	end
	if pair == "&&"
		supported = true
	end
	if pair == ":="
		supported = true
	end
	if pair == "=="
		supported = true
	end
	if pair == "!="
		supported = true
	end
	if pair == "<="
		supported = true
	end
	if pair == ">="
		supported = true
	end
	if pair == "+="
		supported = true
	end
	if pair == "-="
		supported = true
	end
	if pair == "*="
		supported = true
	end
	if pair == "/="
		supported = true
	end
	if pair == "=>"
		supported = true
	end
	if pair == "->"
		supported = true
	end
	return supported
end

def scan_symbol(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	character := source[position[0]]
	mut symbol := character
	if position[0] + 1 < source.size()
		pair := character + source[position[0] + 1]
		if pair == ".."
			symbol = pair
			advance(position)
			if position[0] + 1 < source.size() && source[position[0] + 1] == "."
				symbol = "..."
				advance(position)
			end
		elsif two_character_symbol(pair)
			symbol = pair
			advance(position)
		end
	end
	mut supported := symbol.size() >= 2
	if !supported
		supported = character_in(character, "()[]{}:,.+-*/%<>=!|")
	end
	if supported
		push_token(state, 5, symbol, line)
	else
		diagnostic(state, "TRBN4001", line, "unsupported source character " + character)
	end
	advance(position)
	return
end

def skip_comment(source: String, mut position: Array<Integer>)
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if source[position[0]] == "\n"
				scanning = false
			else
				advance(position)
			end
		end
	end
	return
end

def lex_source(mut state: CompilerState, source: String, terminal_kind: Integer): Boolean
	mut position := [0]
	mut line := 1
	mut character := ""
	while position[0] < source.size()
		character = source[position[0]]
		if character == " "
			advance(position)
		else
			if character == "\t"
				advance(position)
			else
				if character == "\r"
					advance(position)
				else
					if character == "\n" || character == ";"
						push_token(state, 4, character, line)
						if character == "\n"
							line += 1
						end
						advance(position)
					else
						if character == "#"
							skip_comment(source, position)
						else
							if character_in(
									character,
									"fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
								)
								scan_identifier(state, source, position, line)
							else
								if character_in(character, "0123456789")
									scan_number(state, source, position, line)
								else
									if character == "\""
										line += scan_string(state, source, position, line, true)
									else
										scan_symbol(state, source, position, line)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	push_token(state, terminal_kind, "", line)
	return !has_diagnostic(state)
end

def lex_module(mut state: CompilerState, source: String, module_index: Integer): Boolean
	state.active_module[0] = module_index
	return lex_source(state, source, 6)
end

def lex(mut state: CompilerState, source: String): Boolean
	if state.module_count[0] == 0
		add_module(state, "entry", "")
	end
	state.entry_module[0] = 0
	state.active_module[0] = 0
	return lex_source(state, source, 0)
end

def project_error_state(path: String, line: Integer, message: String): CompilerState
	mut state := compiler_new(1024)
	module_index := add_module(state, "trbconfig", path)
	state.entry_module[0] = module_index
	state.active_module[0] = module_index
	diagnostic(state, "TRBN4010", line, message)
	return state
end

def project_join(root: String, relative: String): String
	if relative == "."
		return root
	end
	return path_join(root, relative)
end

def project_module_name(
		mut state: CompilerState,
		source_root: String,
		path: String,
	): String
	mut prefix := source_root
	if prefix != "/"
		prefix += "/"
	end
	if !string_starts_with(path, prefix)
		diagnostic(state, "TRBN4010", 1, "project source is outside configured sourceDir")
	else
		if !string_ends_with(path, ".trb")
			diagnostic(state, "TRBN4010", 1, "project source does not end in .trb")
		else
			name := compiler_source_slice(path, prefix.size(), path.size() - 4)
			if name != ""
				return name
			end
			diagnostic(
				state,
				"TRBN4010",
				1,
				"project source has an empty module name",
			)
		end
	end
	return ""
end

def string_starts_at(value: String, start: Integer, prefix: String): Boolean
	mut index := 0
	while index < prefix.size()
		if value[start + index] != prefix[index]
			return false
		end
		index += 1
	end
	return true
end

def project_source_declares_main(source: String): Boolean
	mut index := 0
	while index + 9 <= source.size()
		if string_starts_at(source, index, "def main(")
			if index == 0
				return true
			end
			if source[index - 1] == "\n"
				return true
			end
		end
		index += 1
	end
	return false
end

def project_append_import_target(
		module_lookup: Hash<String, Integer>,
		normalized: String,
		mut order: Array<Integer>,
		mut included: Array<Integer>,
	): Array<Integer>
	mut target := find_name_index(module_lookup, normalized)
	if target < 0
		target = find_name_index(module_lookup, normalized + "/index")
	end
	if target >= 0
		if included[target] == 0
			order.push(target)
			included[target] = 1
		end
	end
	return order
end

def project_bare_import_path(raw: String): String
	mut finish := raw.size()
	mut index := 0
	while index < raw.size()
		if raw[index] == " "
			finish = index
			index = raw.size()
		else
			if raw[index] == "\t"
				finish = index
				index = raw.size()
			else
				index += 1
			end
		end
	end
	return compiler_source_slice(raw, 0, finish)
end

def project_append_imports(
		module_lookup: Hash<String, Integer>,
		source: String,
		mut order: Array<Integer>,
		mut included: Array<Integer>,
	): Array<Integer>
	mut index := 0
	while index + 6 <= source.size()
		if string_starts_at(source, index, " from ")
			mut cursor := index + 6
			mut collecting := true
			while collecting
				if cursor >= source.size()
					collecting = false
				else
					if source[cursor] == "\n"
						collecting = false
					else
						cursor += 1
					end
				end
			end
			raw := compiler_source_slice(source, index + 6, cursor)
			normalized := import_path_value(raw)
			order = project_append_import_target(
				module_lookup,
				normalized,
				order,
				included,
			)
			index = cursor
		end
		index += 1
	end
	index = 0
	while index + 7 <= source.size()
		mut line_start := index == 0
		if index > 0
			if source[index - 1] == "\n"
				line_start = true
			end
		end
		if line_start
			if string_starts_at(source, index, "import ")
				cursor := index + 7
				if cursor < source.size()
					if source[cursor] != "{"
						mut line_finish := cursor
						mut scanning := true
						while scanning
							if line_finish >= source.size()
								scanning = false
							else
								if source[line_finish] == "\n"
									scanning = false
								else
									line_finish += 1
								end
							end
						end
						raw := compiler_source_slice(source, cursor, line_finish)
						path := project_bare_import_path(raw)
						normalized := import_path_value(path)
						order = project_append_import_target(
							module_lookup,
							normalized,
							order,
							included,
						)
					end
				end
			end
		end
		index += 1
	end
	return order
end

def order_project_sources(source_root: String, bundle: CompilerProjectSources): CompilerProjectSources
	mut entry :=- 1
	mut included: Array<Integer> := []
	mut module_lookup: Hash<String, Integer> := {}
	mut prefix_size := source_root.size()
	if source_root != "/"
		prefix_size += 1
	end
	mut index := 0
	while index < bundle.paths.size()
		included.push(0)
		name := compiler_source_slice(
			bundle.paths[index],
			prefix_size,
			bundle.paths[index].size() - 4,
		)
		module_lookup[name] = index
		if project_source_declares_main(bundle.sources[index])
			entry = index
		end
		index += 1
	end
	if entry < 0
		return bundle
	end

	mut order := [entry]
	included[entry] = 1
	mut cursor := 0
	while cursor < order.size()
		order = project_append_imports(
			module_lookup,
			bundle.sources[order[cursor]],
			order,
			included,
		)
		cursor += 1
	end
	index = 0
	while index < bundle.paths.size()
		if included[index] == 0
			order.push(index)
		end
		index += 1
	end

	mut paths: Array<String> := []
	mut sources: Array<String> := []
	index = 0
	while index < order.size()
		paths.push(bundle.paths[order[index]])
		sources.push(bundle.sources[order[index]])
		index += 1
	end
	return CompilerProjectSources.new(paths: paths, sources: sources, error: "")
end

def project_select_entry(mut state: CompilerState): Boolean
	mut entry :=- 1
	mut function_index := 0
	while function_index < state.function_count[0]
		if load_string(state.function_names, function_index) == "main"
			module_index := load_integer(state.function_modules, function_index)
			if entry >= 0
				state.active_module[0] = module_index
				diagnostic(
					state,
					"TRBN4010",
					load_integer(state.function_lines, function_index),
					"project has more than one top-level main function",
				)
				return false
			end
			entry = module_index
		end
		function_index += 1
	end
	if entry < 0
		state.active_module[0] = 0
		diagnostic(state, "TRBN4010", 1, "project must declare exactly one top-level main function")
		return false
	end
	state.entry_module[0] = entry
	state.active_module[0] = entry
	return true
end

def project_module_acyclic(state: CompilerState, module_index: Integer, mut colors: Array<Integer>): Boolean
	color := colors[module_index]
	if color > 0
		return color == 2
	end
	colors[module_index] = 1
	mut import_index := load_integer(state.module_import_starts, module_index)
	import_end := import_index + load_integer(state.module_import_counts, module_index)
	while import_index < import_end
		target := load_integer(state.import_targets, import_index)
		if target >= 0
			if !project_module_acyclic(state, target, colors)
				return false
			end
		end
		import_index += 1
	end
	colors[module_index] = 2
	return true
end

def project_import_graph_acyclic(state: CompilerState): Boolean
	mut colors: Array<Integer> := []
	mut module_index := 0
	while module_index < state.module_count[0]
		colors.push(0)
		module_index += 1
	end
	module_index = 0
	while module_index < state.module_count[0]
		if !project_module_acyclic(state, module_index, colors)
			return false
		end
		module_index += 1
	end
	return true
end

def module_root_peer(name: String): String
	if string_ends_with(name, "/index")
		return string_without_suffix(name, "/index")
	end
	return name + "/index"
end

def validate_project_module_roots(mut state: CompilerState): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		name := load_string(state.module_names, module_index)
		peer_name := module_root_peer(name)
		peer := find_module(state, peer_name)
		if peer >= 0
			if peer < module_index
				state.active_module[0] = module_index
				diagnostic(
					state,
					"TRBN4003",
					1,
					"module paths " + name + " and " + peer_name + " define the same import root",
				)
				return false
			end
		end
		module_index += 1
	end
	return true
end

def validate_new_module_root(mut state: CompilerState, name: String, line: Integer): Boolean
	peer_name := module_root_peer(name)
	if find_module(state, peer_name) >= 0
		diagnostic(
			state,
			"TRBN4003",
			line,
			"module paths " + name + " and " + peer_name + " define the same import root",
		)
		return false
	end
	return true
end

def resolve_project_imports(mut state: CompilerState): Boolean
	mut module_index := 0
	while module_index < state.module_count[0]
		mut import_index := load_integer(state.module_import_starts, module_index)
		import_end := import_index + load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := load_string(state.import_paths, import_index)
			line := load_integer(state.import_lines, import_index)
			normalized := normalize_import_path(state, raw_path, line)
			if has_diagnostic(state)
				return false
			end
			mut target := standard_package_target(normalized)
			if target < - 1
				if load_integer(state.import_kinds, import_index) != 1
					diagnostic(state, "TRBN4003", line, "supported standard packages require a bare import")
					return false
				end
			else
				if normalized == "trb"
					diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return false
				end
				if string_starts_with(normalized, "trb/")
					diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return false
				end
				target = find_module(state, normalized)
				if target < 0
					target = find_module(state, normalized + "/index")
				end
				if target < 0
					diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
					return false
				end
			end
			store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	if !project_import_graph_acyclic(state)
		module_index = 0
		while module_index < state.module_count[0]
			mut import_index := load_integer(state.module_import_starts, module_index)
			import_end := import_index + load_integer(state.module_import_counts, module_index)
			while import_index < import_end
				state.active_module[0] = module_index
				target := load_integer(state.import_targets, import_index)
				if target >= 0
					if module_reaches(state, target, module_index)
						raw_path := load_string(state.import_paths, import_index)
						line := load_integer(state.import_lines, import_index)
						diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
						return false
					end
				end
				import_index += 1
			end
			module_index += 1
		end
	end
	state.active_module[0] = state.entry_module[0]
	return true
end

def load_configured_project(config_source: String, config_path: String): CompilerState
	config := parse_project_config(config_source)
	if config.error != ""
		return project_error_state(config_path, config.error_line, config.error)
	end
	root := path_directory(config_path)
	source_root := project_join(root, config.source_dir)
	out_root := project_join(root, config.out_dir)
	bundle := compiler_collect_project_sources(source_root, out_root)
	if bundle.error != ""
		return project_error_state(config_path, 1, "cannot collect project source " + bundle.error)
	end
	return load_project_sources(config_path, source_root, bundle)
end

def load_project_sources(
		config_path: String,
		source_root: String,
		bundle: CompilerProjectSources,
	): CompilerState
	if bundle.paths.size() == 0
		return project_error_state(config_path, 1, "no production .trb files found")
	end
	if bundle.paths.size() != bundle.sources.size()
		return project_error_state(config_path, 1, "project source adapter returned mismatched paths and sources")
	end
	ordered := order_project_sources(source_root, bundle)
	mut state := compiler_new(4194304)
	mut module_index := 0
	while module_index < ordered.paths.size()
		state.active_module[0] = module_index
		name := project_module_name(state, source_root, ordered.paths[module_index])
		if has_diagnostic(state)
			return state
		end
		add_module(state, name, ordered.paths[module_index])
		module_index += 1
	end
	if !validate_project_module_roots(state)
		return state
	end
	module_index = 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		lex_module(state, ordered.sources[module_index], module_index)
		if !has_diagnostic(state)
			parse_module(state, start, module_index)
		end
		if has_diagnostic(state)
			return state
		end
		module_index += 1
	end
	if !project_select_entry(state)
		return state
	end
	resolve_project_imports(state)
	return state
end

def module_reaches(state: CompilerState, start: Integer, goal: Integer): Boolean
	if start == goal
		return true
	end
	mut visited: Array<Integer> := []
	mut index := 0
	while index < state.module_count[0]
		visited.push(0)
		index += 1
	end
	mut queue := [start]
	visited[start] = 1
	mut cursor := 0
	while cursor < queue.size()
		module_index := queue[cursor]
		mut import_index := load_integer(state.module_import_starts, module_index)
		import_end := import_index + load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			target := load_integer(state.import_targets, import_index)
			if target == goal
				return true
			end
			if target >= 0
				if visited[target] == 0
					visited[target] = 1
					queue.push(target)
				end
			end
			import_index += 1
		end
		cursor += 1
	end
	return false
end

def load_file_root(entry_source: String, entry_path: String): CompilerState
	mut state := compiler_new(4194304)
	root := path_directory(entry_path)
	entry_name := string_without_suffix(path_basename(entry_path), ".trb")
	entry_module := add_module(state, entry_name, entry_path)
	state.entry_module[0] = entry_module
	mut sources := [entry_source]
	mut module_index := 0
	while module_index < state.module_count[0]
		state.active_module[0] = module_index
		start := state.token_count[0]
		lex_module(state, sources[module_index], module_index)
		if !has_diagnostic(state)
			parse_module(state, start, module_index)
		end
		if has_diagnostic(state)
			return state
		end
		mut import_index := load_integer(state.module_import_starts, module_index)
		import_end := import_index + load_integer(state.module_import_counts, module_index)
		while import_index < import_end
			state.active_module[0] = module_index
			raw_path := load_string(state.import_paths, import_index)
			line := load_integer(state.import_lines, import_index)
			normalized := normalize_import_path(state, raw_path, line)
			if has_diagnostic(state)
				return state
			end
			mut target := standard_package_target(normalized)
			mut target_added := false
			if target < - 1
				if load_integer(state.import_kinds, import_index) != 1
					diagnostic(state, "TRBN4003", line, "supported standard packages require a bare import")
					return state
				end
			else
				if normalized == "trb"
					diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return state
				end
				if string_starts_with(normalized, "trb/")
					diagnostic(state, "TRBN4003", line, "package imports are not supported by this compiler subset")
					return state
				end
				target = find_module(state, normalized)
			end
			if target == - 1
				direct_path := path_join(root, normalized + ".trb")
				if compiler_file_exists(direct_path)
					if !validate_new_module_root(state, normalized, line)
						return state
					end
					target = add_module(state, normalized, direct_path)
					sources.push(compiler_read_source(direct_path))
					target_added = true
				else
					index_name := normalized + "/index"
					target = find_module(state, index_name)
					if target < 0
						index_path := path_join(root, normalized + "/index.trb")
						if !compiler_file_exists(index_path)
							diagnostic(state, "TRBN4003", line, "cannot resolve project import " + raw_path)
							return state
						end
						if !validate_new_module_root(state, index_name, line)
							return state
						end
						target = add_module(state, index_name, index_path)
						sources.push(compiler_read_source(index_path))
						target_added = true
					end
				end
			end
			if !target_added
				if target >= 0
					if module_reaches(state, target, module_index)
						diagnostic(state, "TRBN4003", line, "import cycle through " + raw_path)
						return state
					end
				end
			end
			store_integer(state.import_targets, import_index, target)
			import_index += 1
		end
		module_index += 1
	end
	state.active_module[0] = state.entry_module[0]
	return state
end

# Parameter declarations and expressions attach different source tables to the
# same MIR value layout. Keep identifier allocation and row construction shared.
# Keep the checked instruction layout and source attachment in one builder.
# Callers still choose the operation, operands, and explicit failure edge.
# Binary plans use the existing operator-origin cell: result tag * 16 + op.
# Tags 1/2/3/4 denote Integer/Float/Boolean/String. Literal, argument, index,
# and loop origins remain distinct; their existing markers are unchanged.
def check_function(
		mut state: CompilerState,
		function_index: Integer,
	): Boolean
	state.active_module[0] = load_integer(state.function_modules, function_index)
	mut locals := locals_new(state.token_count[0] + 1)
	scalar_mir_begin(state, function_index, locals)
	parameter_start := load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		added := local_add(
			state,
			locals,
			load_string(state.parameter_names, parameter_index),
			load_string(state.parameter_types, parameter_index),
			load_integer(state.parameter_mutable, parameter_index),
			load_integer(state.parameter_lines, parameter_index),
		)
		if added
			mir_add_parameter(state, locals, parameter_index)
		end
		parameter_index += 1
	end
	parameter_index = parameter_start
	while parameter_index < parameter_finish
		if load_string(state.parameter_types, parameter_index) == "String"
			mir_control_prepare(state, locals)
		end
		parameter_index += 1
	end
	result_type := load_string(state.function_result_types, function_index)
	if (result_type == "Void" || result_type == "String") && locals.mir_state[0] == 1
		mir_control_prepare(state, locals)
	end
	# The second cursor cell carries one adjacent declaration fact into a loop.
	mut position := [load_integer(state.function_body_starts, function_index), 0]
	check_block(state, position, locals, load_string(state.function_result_types, function_index), - 1)
	if position[0] != load_integer(state.function_body_ends, function_index)
		diagnostic(
			state,
			"TRBN4004",
			load_integer(state.function_lines, function_index),
			"checker did not consume the complete function body",
		)
	end
	if result_type == "Void" && mir_control_active(locals) && locals.mir_control[6] == 0
		mir_control_return(state, locals, - 1)
	end
	state.scalar_mir.array_regions.push(locals.mir_array)
	if !has_diagnostic(state)
		mir_error := scalar_mir_commit(state, function_index, locals)
		if mir_error != ""
			diagnostic(
				state,
				"TRBN4004",
				load_integer(state.function_lines, function_index),
				mir_error,
			)
		end
	end
	compiler_reset_temporary_storage()
	return !has_diagnostic(state)
end

def check(mut state: CompilerState): Boolean
	mir_declare_signatures(state)
	mut function_index := 0
	while function_index < state.function_count[0]
		check_function(state, function_index)
		function_index += 1
	end
	if !has_diagnostic(state)
		mut mir_error := verify_mir(state.scalar_mir, false)
		if mir_error == ""
			optimize_verified_mir(state.scalar_mir)
			mir_error = verify_mir(state.scalar_mir, true)
		end
		if mir_error != ""
			diagnostic(state, "TRBN4004", 1, mir_error)
		end
	end
	if !has_diagnostic(state)
		checked_hash_verify(state)
	end
	if !has_diagnostic(state)
		validate_import_usage(state)
	end
	return !has_diagnostic(state)
end

def main()
	return
end
