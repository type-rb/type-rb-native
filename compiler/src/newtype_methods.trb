import { find_newtype_type } from newtype_types
import { find_function_in_module } from declaration_lookup
import { CompilerState } from state
import { sparse_string_at } from storage

def newtype_method_function(state: CompilerState, type_name: String, member: String, class_method: Boolean): Integer
	owner := find_newtype_type(state, type_name)
	if owner < 0
		return - 1
	end
	definition := state.newtypes[owner]
	function := find_function_in_module(state, definition.source_id, definition.name + "::" + member)
	if function < 0
		return - 1
	end
	receiver := sparse_string_at(state.function_receivers, function)
	if class_method
		if receiver != ""
			return - 1
		end
	elsif receiver != type_name
		return - 1
	end
	return function
end
