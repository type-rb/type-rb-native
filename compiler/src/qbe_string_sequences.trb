import { QbeOutput, qbe_output_line } from qbe_output

# Sequence transforms decode a forward byte cursor; reverse measures then copies.
# Array results retain their root while temporary character roots are released.
def emit_string_sequence_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction l $trbn_string_sequence(l %source, l %mode) {\n@start\n %characters =w ceql %mode, 1\n jnz %characters, @managed, @scalar\n@managed\n jmp @allocate\n@scalar\n jmp @allocate\n@allocate\n %descriptor =l phi @managed $trbn_desc_array_managed, @scalar $trbn_desc_array_scalar\n %result =l call $trbn_array_new(l %descriptor)\n %retained =l loadl $trbn_gc_temp_count\n %length_address =l add %source, 8\n %length =l loadl %length_address\n %data =l add %source, 24\n jmp @loop\n@loop\n %offset =l phi @allocate 0, @append %next\n %done =w ceql %offset, %length\n jnz %done, @finish, @read\n@read\n %address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %point =l call $trbn_utf8_scalar(l %address, l %remaining)\n jnz %characters, @character, @point\n@character\n %text =l call $trbn_string_from_codepoint(l %point)\n jmp @append\n@point\n jmp @append\n@append\n %value =l phi @character %text, @point %point\n call $trbn_array_push_paced(l %result, l %value)\n call $trbn_gc_temp_reset(l %retained)\n %next =l add %offset, %width\n jmp @loop\n@finish\n ret %result\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_string_reverse(l %source) {\n@start\n %length_address =l add %source, 8\n %length =l loadl %length_address\n %points_address =l add %source, 16\n %points =l loadl %points_address\n %data =l add %source, 24\n jmp @measure\n@measure\n %offset =l phi @start 0, @measured %next\n %size =l phi @start 0, @measured %next_size\n %done =w ceql %offset, %length\n jnz %done, @allocate, @inspect\n@inspect\n %address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %first =w loadub %address\n %nonascii =w cugtw %first, 127\n %single =w ceql %width, 1\n %invalid =w and %nonascii, %single\n jnz %invalid, @expanded, @original\n@expanded\n jmp @measured\n@original\n jmp @measured\n@measured\n %encoded =l phi @expanded 3, @original %width\n %next_size =l add %size, %encoded\n %next =l add %offset, %width\n jmp @measure\n@allocate\n %payload =l add %size, 17\n %result =l call $trbn_string_alloc(l %payload)\n %result_length =l add %result, 8\n storel %size, %result_length\n %result_points =l add %result, 16\n storel %points, %result_points\n %result_data =l add %result, 24\n %terminator =l add %result_data, %size\n storeb 0, %terminator\n jmp @loop\n@loop\n %position =l phi @allocate 0, @advance %next_position\n %output_end =l phi @allocate %size, @advance %target_offset\n %finished =w ceql %position, %length\n jnz %finished, @finish, @decode\n@decode\n %input =l add %data, %position\n %left =l sub %length, %position\n %input_width =l call $trbn_utf8_width(l %input, l %left)\n %lead =w loadub %input\n %lead_high =w cugtw %lead, 127\n %one =w ceql %input_width, 1\n %bad =w and %lead_high, %one\n jnz %bad, @replacement, @copy\n@replacement\n %replacement_offset =l sub %output_end, 3\n %replacement_address =l add %result_data, %replacement_offset\n storeb 239, %replacement_address\n %second =l add %replacement_address, 1\n storeb 191, %second\n %third =l add %replacement_address, 2\n storeb 189, %third\n jmp @advance\n@copy\n %copy_offset =l sub %output_end, %input_width\n %copy_address =l add %result_data, %copy_offset\n call $memcpy(l %copy_address, l %input, l %input_width)\n jmp @advance\n@advance\n %target_offset =l phi @replacement %replacement_offset, @copy %copy_offset\n %next_position =l add %position, %input_width\n jmp @loop\n@finish\n ret %result\n}\n")
end
