import { integer_string } from literals
import { CompilerState } from state

def object_type(owner: Integer, interface_type: Boolean): String
	if interface_type
		return "Interface#" + integer_string(owner)
	end
	return "Class#" + integer_string(owner)
end

def object_instance_type(state: CompilerState, owner: Integer): String
	return object_type(owner, state.objects[state.object_instances[owner].definition].interface_type)
end

def find_object_type(state: CompilerState, type_name: String): Integer
	mut owner := 0
	while owner < state.object_instances.size()
		if object_instance_type(state, owner) == type_name
			return owner
		end
		owner += 1
	end
	return - 1
end

def find_object_in_module(state: CompilerState, source: Integer, name: String): Integer
	mut owner := 0
	while owner < state.objects.size()
		definition := state.objects[owner]
		if definition.source_id == source && definition.name == name
			return owner
		end
		owner += 1
	end
	return - 1
end

# Interface compatibility follows explicit nominal edges, never a structural
# member match. The reference does not allow a child value in a parent-class
# binding; inheritance alone is not a user-visible class conversion.
def object_assignable(state: CompilerState, actual: String, expected: String): Boolean
	target := find_object_type(state, expected)
	mut owner := find_object_type(state, actual)
	if target < 0 || owner < 0
		return false
	end
	if !state.objects[state.object_instances[target].definition].interface_type
		return owner == target
	end
	mut remaining := state.object_instances.size()
	while owner >= 0 && owner < state.object_instances.size() && remaining > 0
		if owner == target
			return true
		end
		instance := state.object_instances[owner]
		instance.interfaces.each do |contract|
			if contract == target
				return true
			end
		end
		owner = instance.superclass
		remaining -= 1
	end
	return false
end

# Object method templates include nongeneric methods and abstract contracts.
# Only concrete class methods may become executable function instances.
def object_method_owner(state: CompilerState, template: Integer): Integer
	mut owner := 0
	while owner < state.objects.size()
		state.objects[owner].methods.each do |method|
			if method.generic_function == template
				return owner
			end
		end
		owner += 1
	end
	return - 1
end

def object_abstract_method(state: CompilerState, template: Integer): Boolean
	owner := object_method_owner(state, template)
	return owner >= 0 && state.objects[owner].interface_type
end
