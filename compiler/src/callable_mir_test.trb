import { checked_mir_value } from checked_values
import { checked_function_locals, finalize_checked_module } from checked_functions
import { check, check_function, emit_qbe } from compiler
import { find_function_in_module } from declaration_lookup
import { lex } from lexer
import { MirCallable, MirInstruction, MirSignature, MirType } from mir
import { mir_declare_signatures } from mir_calls
import { declared_callable_type, mir_checked_callable_call, mir_checked_function_value } from mir_callables
import { scalar_mir_commit } from mir_builder
import { mir_control_return } from mir_control
import { mir_declare_types } from mir_types
import { parse_module } from parser
import { resolve } from resolution
import { CompilerState, compiler_new } from state
import { load_integer, load_string, store_string } from storage
import { control_test_output } from control_mir_test
import { logical_run_qbe } from logical_test
import { intrinsic_mir_erase } from intrinsic_mir_test
import { verify_mir } from mir_verifier
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

# This fixture builds the entry MIR explicitly. Authored named function values
# and fn/capture syntax are not ordinary language support in this checkpoint.
def callable_mir_state(): CompilerState
	source := "alias Callback = (String) -> String\nrecord Holder\ncallback: Callback\nend\ndef transform(value: String): String\nreturn value + \"!\"\nend\ndef keep(callback: Callback): Callback\nreturn callback\nend\ndef report(callback: Callback)\nvalues := [callback]\ntable: Hash<String, Callback> := {\"saved\" => callback}\nitem := Holder.new(callback: callback)\nputs(values[0](\"array\" + \" value\"))\nputs(table[\"saved\"](\"hash\" + \" value\"))\nputs(item.callback(\"field\" + \" value\"))\nend\ndef numeric(value: Float, other: Integer): Float\nreturn value + other\nend\ndef report_numeric(callback: (Float, Integer) -> Float)\nputs(callback(2.5, 3).to_i())\nend\ndef nothing()\nputs(\"void\")\nend\ndef report_void(callback: () -> Void)\ncallback()\nend\ndef main()\nend\n"
	mut state := compiler_new(source.size() * 4 + 64)
	valid := lex(state, source) && parse_module(state, 0, state.entry_module[0]) && resolve(state)
	if !valid
		puts(load_string(state.diagnostic_messages, 0))
	end
	expect(valid).to_be_true()
	if !valid
		return state
	end
	mir_declare_types(state)
	mir_declare_signatures(state)
	main := find_function_in_module(state, state.entry_module[0], "main")
	mut function := 0
	while function < state.function_count[0]
		if function != main
			expect(check_function(state, function)).to_be_true()
		end
		function += 1
	end
	mut locals := checked_function_locals(state, main)
	origin := load_integer(state.function_body_starts, main)
	targets := ["transform", "numeric", "nothing"]
	consumers := ["report", "report_numeric", "report_void"]
	mut index := 0
	while index < targets.size()
		target := find_function_in_module(state, state.entry_module[0], targets[index])
		mut value := mir_checked_function_value(state, locals, target, origin)
		if index == 0
			identity := find_function_in_module(state, state.entry_module[0], "keep")
			callee := mir_checked_function_value(state, locals, identity, origin)
			value = mir_checked_callable_call(state, locals, callee, [checked_mir_value(value)], declared_callable_type(state, target), origin)
		end
		consumer := find_function_in_module(state, state.entry_module[0], consumers[index])
		callee := mir_checked_function_value(state, locals, consumer, origin)
		mir_checked_callable_call(state, locals, callee, [checked_mir_value(value)], "Void", origin)
		index += 1
	end
	mir_control_return(state, locals, - 1)
	expect(scalar_mir_commit(state, main, locals)).to_equal("")
	finished := finalize_checked_module(state)
	if !finished
		puts(load_string(state.diagnostic_messages, 0))
	end
	expect(finished).to_be_true()
	return state
end

describe("MIR callable foundation") do
	test("executes verified indirect calls and containers after frontend erasure under forced collection") do
		mut state := callable_mir_state()
		before := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		mut index := 0
		while index < state.function_count[0]
			store_string(state.function_names, index, "erased")
			store_string(state.function_result_types, index, "Invalid")
			index += 1
		end
		index = 0
		while index < state.parameter_count[0]
			store_string(state.parameter_types, index, "Invalid")
			index += 1
		end
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			mut forced := ""
			mut ordinary := false
			before.split("\n").each do |line|
				if line.start_with?("function ")
					ordinary = line.include?("$trbnf")
				end
				if line == "}"
					ordinary = false
				end
				if ordinary && (line.include?("call %") || line.include?("call $trbnf") || line.include?("call $trbn_gc_alloc(") || line.include?("call $trbn_array_") || line.include?("call $trbn_hash_"))
					forced += "\tcall $trbn_gc_collect(w 0)\n"
				end
				forced += line + "\n"
			end
			case logical_run_qbe(qbe, forced)
			when Result::Ok(actual)
				expect(actual).to_equal("array value!\nhash value!\nfield value!\n5\nvoid\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("rejects malformed callable catalogs, code references and indirect operands") do
		mut mode := 0
		while mode < 16
			mut state := callable_mir_state()
			mut selected := 0
			while state.scalar_mir.instructions[selected].kind != 42
				selected += 1
			end
			if mode < 7
				old := state.scalar_mir.instructions[selected]
				mut first := old.first
				mut second := old.second
				mut payload := old.payload
				mut result := old.result
				mut failure := old.failure
				if mode == 0
					first = 9007199254740991
				elsif mode == 1
					first = state.scalar_mir.arguments[payload]
				elsif mode == 2
					second += 1
				elsif mode == 3
					payload = 9007199254740991
				elsif mode == 4
					state.scalar_mir.arguments[payload] = first
				elsif mode == 5
					result =- 1
				else
					failure = 0
				end
				state.scalar_mir.instructions[selected] = MirInstruction.new(kind: old.kind, result: result, first: first, second: second, payload: payload, failure: failure, source_id: old.source_id, line: old.line)
			elsif mode < 10 || mode == 15
				selected = 0
				while state.scalar_mir.instructions[selected].kind != 41
					selected += 1
				end
				old := state.scalar_mir.instructions[selected]
				mut payload := old.payload
				mut first := old.first
				if mode == 15
					target := state.scalar_mir.signatures[payload]
					payload = state.scalar_mir.signatures.size()
					state.scalar_mir.signatures.push(MirSignature.new(id: payload, kind: 0, name: "missing_body", adapter: 0, source_id: target.source_id, line: target.line, parameter_types: target.parameter_types, parameter_mutable: target.parameter_mutable, result_type: target.result_type))
				elsif mode == 7
					payload = 9007199254740991
				elsif mode == 8
					payload = find_function_in_module(state, state.entry_module[0], "nothing")
				else
					first = 0
				end
				state.scalar_mir.instructions[selected] = MirInstruction.new(kind: old.kind, result: old.result, first: first, second: old.second, payload: payload, failure: old.failure, source_id: old.source_id, line: old.line)
			else
				old := state.scalar_mir.callables[0]
				mut parameters := old.parameters
				mut result := old.result
				mut type_id := old.type_id
				if mode == 10
					parameters = [0]
				elsif mode == 11
					result = 9007199254740991
				elsif mode == 12
					type_id = 1
				elsif mode == 13
					state.scalar_mir.callables.push(old)
				else
					row := state.scalar_mir.types[type_id - 9]
					state.scalar_mir.types[type_id - 9] = MirType.new(kind: row.kind, name: row.name, element: 1, key: row.key, declaration: row.declaration)
				end
				state.scalar_mir.callables[0] = MirCallable.new(type_id: type_id, parameters: parameters, result: result)
			end
			error := verify_mir(state.scalar_mir, true)
			if error == ""
				puts(mode)
			end
			expect(error.empty?()).to_be_false()
			mode += 1
		end
	end
	test("checks callback signatures and rejects invalid calls even in unused functions") do
		sources := ["def invoke(callback: (Integer) -> Integer): Integer\nreturn callback()\nend\n", "def invoke(callback: (Integer) -> Integer): Integer\nreturn callback(1, 2)\nend\n", "def invoke(callback: (Integer) -> Integer): Integer\nreturn callback(\"bad\")\nend\n", "def invoke(callback: (Integer) -> Integer): String\nreturn callback(1)\nend\n", "def invoke(callback: (Integer) -> Integer): Integer\nreturn callback(value: 1)\nend\n", "def invoke(callback: () -> Void): Integer\nreturn callback()\nend\n", "def invoke(callback: (Void) -> Integer): Integer\nreturn 0\nend\n", "def invoke(callback: (Missing) -> Integer): Integer\nreturn 0\nend\n", "def invoke(callback: (Integer) -> Missing): Integer\nreturn 0\nend\n", "alias Callback<T> = (Void) -> T\n", "alias Callback = (Integer) -> Missing\n"]
		sources.each do |declarations|
			source := declarations + "def main()\nend\n"
			mut state := compiler_new(source.size() * 4 + 64)
			valid := lex(state, source) && parse_module(state, 0, state.entry_module[0]) && resolve(state) && check(state)
			if valid
				puts(source)
			end
			expect(valid).to_be_false()
		end
	end

end
