# Authored declarations exercise the same verified closure and call operations
# used by fn values, including higher-order calls and managed containers.
def callable_mir_state(): CompilerState
	source := "alias Callback = (String) -> String\nrecord Holder\ncallback: Callback\nend\ndef transform(value: String): String\nreturn value + \"!\"\nend\ndef keep(callback: Callback): Callback\nreturn callback\nend\ndef report(callback: Callback)\nvalues := [callback]\ntable: Hash<String, Callback> := {\"saved\" => callback}\nitem := Holder.new(callback: callback)\nputs(values[0](\"array\" + \" value\"))\nputs(table[\"saved\"](\"hash\" + \" value\"))\nputs(item.callback(\"field\" + \" value\"))\nend\ndef numeric(value: Float, other: Integer): Float\nreturn value + other\nend\ndef report_numeric(callback: (Float, Integer) -> Float)\nputs(callback(2.5, 3).to_i())\nend\ndef nothing()\nputs(\"void\")\nend\ndef report_void(callback: () -> Void)\ncallback()\nend\ndef main()\ndispatch := report\nidentity := keep\ndispatch(identity(transform))\nreport_numeric(numeric)\nreport_void(nothing)\nend\n"
	mut state := compiler_new(source.size() * 4 + 64)
	valid := lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state) && check(state)
	if !valid
		puts(load_string(state.diagnostics.messages, 0))
	end
	expect(valid).to_be_true()
	return state
end

describe("Anonymous function syntax ownership") do
	test("parses multiline headers and immediate calls without consuming the containing expression") do
		source := "def main()\nvalue := (fn(\nmut input: Integer\n): Integer\nreturn input\nend)(7) + 1\nend\n"
		mut state := compiler_new(source.size() * 4 + 64)
		expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(state.lambdas.size()).to_equal(1)
		expect(state.lambdas[0].parameters.size()).to_equal(1)
		expect(load_string(state.source_tokens.token_texts, state.lambdas[0].finish)).to_equal(")")
		expect(state.declarations.parameter_count[0]).to_equal(0)
		expect(resolve(state)).to_be_true()
	end
	test("keeps nested fn parameters and defaults separate from surrounding declarations") do
		source := "alias Callback = (Integer) -> Integer\nrecord Holder\ncallback: Callback = fn(input: Integer): Integer; return input; end\nend\ndef consume(callback: Callback = fn(mut first: Integer): Integer\nnested := fn(second: Integer): Integer; return second; end\nreturn nested(first)\nend, tail: Integer = 7): Integer\nreturn callback(tail)\nend\ndef main()\nend\n"
		mut state := compiler_new(source.size() * 4 + 64)
		expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(state.declarations.function_count[0]).to_equal(2)
		expect(state.declarations.parameter_count[0]).to_equal(2)
		expect(load_string(state.declarations.parameter_names, 0)).to_equal("callback")
		expect(load_string(state.declarations.parameter_names, 1)).to_equal("tail")
		expect(state.lambdas.size()).to_equal(3)
		expect(state.parsed.default_initializers.size()).to_equal(3)
		expect(state.parsed.default_initializers[1].owner).to_equal(0)
		expect(state.parsed.default_initializers[1].slot).to_equal(0)
		expect(state.parsed.default_initializers[2].slot).to_equal(1)
		outer := state.lambdas[2]
		expect(outer.parameters[0].mutable).to_equal(1)
		expect(outer.body_start < state.lambdas[1].origin).to_be_true()
		expect(outer.body_finish > state.lambdas[1].finish).to_be_true()
		mut position := [outer.origin]
		expect(parse_lambda_syntax(state, position)).to_be_true()
		expect(position[0]).to_equal(outer.finish)
		expect(state.lambdas.size()).to_equal(3)
		expect(state.declarations.parameter_count[0]).to_equal(2)
		expect(resolve(state)).to_be_true()
		state.hash_repl[0] = true
		expect(check(state)).to_be_true()
	end
	test("resolves shared fn syntax separately for each generic body") do
		source := "def probe<T>()\ncallback := fn(value: T): T; return value; end\nend\ndef main()\nprobe<Integer>()\nprobe<String>()\nend\n"
		mut state := compiler_new(source.size() * 4 + 64)
		expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state)).to_be_true()
		expect(state.lambdas.size()).to_equal(1)
		origin := state.lambdas[0].origin
		first := state.type_resolution.generic_function_instances[0].function
		second := state.type_resolution.generic_function_instances[1].function
		select_checked_body(state, first)
		expect(load_string(state.checked[0].lambda_types, origin)).to_equal("$Callable<Integer,Integer>")
		select_checked_body(state, second)
		expect(load_string(state.checked[0].lambda_types, origin)).to_equal("$Callable<String,String>")
		expect(state.lambdas[0].parameters[0].type_name).to_equal("T")
		expect(state.lambdas[0].result_type).to_equal("T")
		expect(sparse_integer_at(state.lambda_origins, origin)).to_equal(1)
	end
	test("does not leak fn parameters locals or iteration names into the enclosing resolver") do
		bodies := ["callback := fn(hidden: Integer)\nend\n", "callback := fn()\nhidden := 1\nend\n", "callback := fn()\n[1].each do |hidden|\nputs(hidden)\nend\nend\n"]
		bodies.each do |body|
			source := "def main()\n" + body + "puts(hidden)\nend\n"
			mut state := compiler_new(source.size() * 4 + 64)
			expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_false()
			expect(load_string(state.diagnostics.messages, 0)).to_equal("unresolved local hidden")
		end
	end
	test("rejects invalid fn headers including unused generic nested annotations") do
		headers := ["fn(value)", "fn(value: Integer = 1)", "fn(*, value: Integer)", "fn(*values: Integer)", "fn<T>(value: T)", "fn(): Void", "fn(value: Integer, value: Integer)"]
		headers.each do |header|
			source := "def main()\ncallback := " + header + "\nend\nend\n"
			mut state := compiler_new(source.size() * 4 + 64)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_false()
		end
		annotations := ["fn(value: Missing)", "fn(value: Void)", "fn(): Missing"]
		annotations.each do |header|
			source := "def unused<T>()\nouter := fn()\ninner := " + header + "\nend\nend\nend\ndef main()\nend\n"
			mut state := compiler_new(source.size() * 4 + 64)
			expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state)).to_be_true()
			expect(check(state)).to_be_false()
			expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4003")
		end
	end
end

# Factories bind captured parameter prefixes explicitly; consumers use ordinary
# checked source. Synthetic environments isolate capture verification from parsing.
def callable_capture_state(): CompilerState
	source := "alias Callback = (Integer) -> Integer\nrecord Envelope\ncallback: Callback\nend\ndef step(mut cell: Array<Integer>, label: String, scale: Float, enabled: Boolean, delta: Integer): Integer\nputs(label)\nif enabled\ncell[0] += delta + scale.to_i()\nend\nreturn cell[0]\nend\ndef make(mut cell: Array<Integer>, label: String, scale: Float, enabled: Boolean): Callback\nend\ndef dispatch(inner: Callback, value: Integer): Integer\nreturn inner(value)\nend\ndef wrap(inner: Callback): Callback\nend\ndef cycle_step(callbacks: Array<Callback>, delta: Integer): Integer\nreturn callbacks.size() + delta\nend\ndef make_cycle(callbacks: Array<Callback>): Callback\nend\ndef invoke(first: Callback, second: Callback)\nvalues := [first, second]\ntable: Hash<String, Callback> := {\"saved\" => values[1]}\nholder := Envelope.new(callback: table[\"saved\"])\nputs(values[0](1))\nputs(holder.callback(2))\nputs(values[0](3))\nend\ndef main()\nmut cell := [10]\nfirst := make(cell, \"one\" + \"!\", 1.5, true)\nsecond := make(cell, \"two\" + \"!\", 2.5, true)\ninvoke(wrap(first), second)\nother := make([100], \"other\" + \"!\", 3.5, true)\nputs(other(4))\nmut callbacks: Array<Callback> := []\ncycle := make_cycle(callbacks)\ncallbacks.push(cycle)\nputs(cycle(8))\nend\n"
	mut state := compiler_new(source.size() * 4 + 64)
	valid := lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state)
	expect(valid).to_be_true()
	if !valid
		puts(load_string(state.diagnostics.messages, 0))
		return state
	end
	mir_declare_types(state)
	mir_declare_signatures(state)
	factory := find_function_in_module(state, state.module_graph.entry_module[0], "make")
	wrapper := find_function_in_module(state, state.module_graph.entry_module[0], "wrap")
	cyclic := find_function_in_module(state, state.module_graph.entry_module[0], "make_cycle")
	mut function := 0
	while function < state.declarations.function_count[0]
		if function == factory || function == wrapper || function == cyclic
			mut locals := checked_function_locals(state, function)
			origin := load_integer(state.declarations.function_body_starts, function)
			mut target := find_function_in_module(state, state.module_graph.entry_module[0], "step")
			mut captures := [0, 1, 2, 3]
			if function == wrapper
				target = find_function_in_module(state, state.module_graph.entry_module[0], "dispatch")
				captures = [0]
			elsif function == cyclic
				target = find_function_in_module(state, state.module_graph.entry_module[0], "cycle_step")
				captures = [0]
			end
			value := mir_checked_closure(state, locals, target, captures, origin)
			mir_control_return(state, locals, checked_mir_value(value))
			expect(scalar_mir_commit(state, function, locals)).to_equal("")
		else
			if !check_function(state, function)
				puts(load_string(state.diagnostics.messages, 0))
				expect(false).to_be_true()
				return state
			end
		end
		function += 1
	end
	finished := finalize_checked_module(state)
	if !finished
		puts(load_string(state.diagnostics.messages, 0))
	end
	expect(finished).to_be_true()
	return state
end

# Collection at every allocating operation/indirect call tests the verified
# root plan. The adapters themselves allocate nothing before entering a body.
def callable_forced_collection(text: String): String
	mut forced := ""
	mut ordinary := false
	text.split("\n").each do |line|
		if line.start_with?("function ")
			ordinary = line.include?("$trbnf")
		end
		if line == "}"
			ordinary = false
		end
		if ordinary && (line.include?("call %") || line.include?("call $trbnf") || line.include?("call $trbn_gc_alloc(") || line.include?("call $trbn_array_") || line.include?("call $trbn_hash_"))
			forced += "\tcall $trbn_gc_collect(w 0)\n"
		end
		forced += line + "\n"
	end
	return forced
end

describe("MIR callable foundation") do
	test("retains authored named and nullable function values without source or block order") do
		managed_mir_test_fixture("named-function-values", 6)
	end
	test("executes verified indirect calls and containers after frontend erasure under forced collection") do
		mut state := callable_mir_state()
		before := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		mut index := 0
		while index < state.declarations.function_count[0]
			store_string(state.declarations.function_names, index, "erased")
			store_string(state.declarations.function_result_types, index, "Invalid")
			index += 1
		end
		index = 0
		while index < state.declarations.parameter_count[0]
			store_string(state.declarations.parameter_types, index, "Invalid")
			index += 1
		end
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			forced := callable_forced_collection(before)
			case logical_run_qbe(qbe, forced)
			when Result::Ok(actual)
				expect(actual).to_equal("array value!\nhash value!\nfield value!\n5\nvoid\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("keeps escaped captures and shared mutable storage alive across nested calls and containers") do
		mut state := callable_capture_state()
		before := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		mut index := 0
		while index < state.declarations.function_count[0]
			store_string(state.declarations.function_names, index, "erased")
			store_string(state.declarations.function_result_types, index, "Invalid")
			index += 1
		end
		index = 0
		while index < state.declarations.parameter_count[0]
			store_string(state.declarations.parameter_types, index, "Invalid")
			index += 1
		end
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe(qbe, callable_forced_collection(before))
			when Result::Ok(actual)
				expect(actual).to_equal("one!\n12\ntwo!\n16\none!\n20\nother!\n107\n9\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("rejects invalid capture counts, spans, types and unavailable captured values") do
		mut mode := 0
		while mode < 7
			mut state := callable_capture_state()
			mut selected := 0
			while state.scalar_mir.instructions[selected].kind != 41
				selected += 1
			end
			old := state.scalar_mir.instructions[selected]
			mut first := old.first
			mut second := old.second
			if mode == 0
				first =- 1
			elsif mode == 1
				first = 9007199254740991
			elsif mode == 2
				second =- 1
			elsif mode == 3
				second = 9007199254740991
			elsif mode == 4
				second -= 1
			elsif mode == 5
				state.scalar_mir.arguments[first] = state.scalar_mir.arguments[first + 1]
			else
				state.scalar_mir.arguments[first] = old.result
			end
			state.scalar_mir.instructions[selected] = MirInstruction.new(kind: old.kind, result: old.result, first: first, second: second, payload: old.payload, failure: old.failure, source_id: old.source_id, line: old.line)
			expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
			mode += 1
		end
	end

	test("requires capture roots at allocation and the environment root at indirect calls") do
		mut mode := 0
		while mode < 2
			mut state := callable_capture_state()
			mut selected :=- 1
			mut value :=- 1
			mut index := 0
			while selected < 0 && index < state.scalar_mir.instructions.size()
				instruction := state.scalar_mir.instructions[index]
				if mode == 0 && instruction.kind == 41
					selected = index
					value = state.scalar_mir.arguments[instruction.first]
				elsif mode == 1 && instruction.kind == 42
					selected = index
					value = instruction.first
				end
				index += 1
			end
			expect(selected >= 0).to_be_true()
			mut removed := false
			index = 0
			while index < state.scalar_mir.root_plans.size()
				plan := state.scalar_mir.root_plans[index]
				mut roots: Array<Array<Integer>> := []
				mut point := 0
				while point < plan.instructions.size()
					mut kept: Array<Integer> := []
					plan.roots[point].each do |root|
						if plan.instructions[point] == selected && root == value
							removed = true
						else
							kept.push(root)
						end
					end
					roots.push(kept)
					point += 1
				end
				state.scalar_mir.root_plans[index] = MirRootPlan.new(function_id: plan.function_id, instructions: plan.instructions, roots: roots, capacity: plan.capacity)
				index += 1
			end
			expect(removed).to_be_true()
			expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
			mode += 1
		end
	end

	test("rejects malformed callable catalogs, code references and indirect operands") do
		mut mode := 0
		while mode < 16
			mut state := callable_mir_state()
			mut selected := 0
			while state.scalar_mir.instructions[selected].kind != 42
				selected += 1
			end
			if mode < 7
				old := state.scalar_mir.instructions[selected]
				mut first := old.first
				mut second := old.second
				mut payload := old.payload
				mut result := old.result
				mut failure := old.failure
				if mode == 0
					first = 9007199254740991
				elsif mode == 1
					first = state.scalar_mir.arguments[payload]
				elsif mode == 2
					second += 1
				elsif mode == 3
					payload = 9007199254740991
				elsif mode == 4
					state.scalar_mir.arguments[payload] = first
				elsif mode == 5
					result =- 1
				else
					failure = 0
				end
				state.scalar_mir.instructions[selected] = MirInstruction.new(kind: old.kind, result: result, first: first, second: second, payload: payload, failure: failure, source_id: old.source_id, line: old.line)
			elsif mode < 10 || mode == 15
				selected = 0
				while state.scalar_mir.instructions[selected].kind != 41
					selected += 1
				end
				old := state.scalar_mir.instructions[selected]
				mut payload := old.payload
				mut first := old.first
				if mode == 15
					target := state.scalar_mir.signatures[payload]
					payload = state.scalar_mir.signatures.size()
					state.scalar_mir.signatures.push(MirSignature.new(id: payload, kind: 0, name: "missing_body", adapter: 0, source_id: target.source_id, line: target.line, parameter_types: target.parameter_types, parameter_mutable: target.parameter_mutable, result_type: target.result_type))
				elsif mode == 7
					payload = 9007199254740991
				elsif mode == 8
					payload = find_function_in_module(state, state.module_graph.entry_module[0], "nothing")
				else
					first = 9007199254740991
				end
				state.scalar_mir.instructions[selected] = MirInstruction.new(kind: old.kind, result: old.result, first: first, second: old.second, payload: payload, failure: old.failure, source_id: old.source_id, line: old.line)
			else
				old := state.scalar_mir.callables[0]
				mut parameters := old.parameters
				mut result := old.result
				mut type_id := old.type_id
				if mode == 10
					parameters = [0]
				elsif mode == 11
					result = 9007199254740991
				elsif mode == 12
					type_id = 1
				elsif mode == 13
					state.scalar_mir.callables.push(old)
				else
					row := state.scalar_mir.types[type_id - 9]
					state.scalar_mir.types[type_id - 9] = MirType.new(kind: row.kind, name: row.name, element: 1, key: row.key, declaration: row.declaration)
				end
				state.scalar_mir.callables[0] = MirCallable.new(type_id: type_id, parameters: parameters, result: result)
			end
			error := verify_mir(state.scalar_mir, true)
			if error == ""
				puts(mode)
			end
			expect(error.empty?()).to_be_false()
			mode += 1
		end
	end
	test("checks callback signatures and rejects invalid calls even in unused functions") do
		sources := ["def invoke(callback: (Integer) -> Integer): Integer\nreturn callback()\nend\n", "def invoke(callback: (Integer) -> Integer): Integer\nreturn callback(1, 2)\nend\n", "def invoke(callback: (Integer) -> Integer): Integer\nreturn callback(\"bad\")\nend\n", "def invoke(callback: (Integer) -> Integer): String\nreturn callback(1)\nend\n", "def invoke(callback: (Integer) -> Integer): Integer\nreturn callback(value: 1)\nend\n", "def invoke(callback: () -> Void): Integer\nreturn callback()\nend\n", "def invoke(callback: (Void) -> Integer): Integer\nreturn 0\nend\n", "def invoke(callback: (Missing) -> Integer): Integer\nreturn 0\nend\n", "def invoke(callback: (Integer) -> Missing): Integer\nreturn 0\nend\n", "alias Callback<T> = (Void) -> T\n", "alias Callback = (Integer) -> Missing\n"]
		sources.each do |declarations|
			source := declarations + "def main()\nend\n"
			mut state := compiler_new(source.size() * 4 + 64)
			valid := lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state) && check(state)
			if valid
				puts(source)
			end
			expect(valid).to_be_false()
		end
	end

end

# Inspect lexical projections produced by the complete interactive checking path.
# Negative cases inspect their diagnostics; positive cases also materialize bodies.
def lambda_analysis_state(source: String): CompilerState
	mut state := compiler_new(source.size() * 4 + 64)
	expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state)).to_be_true()
	state.hash_repl[0] = true
	check(state)
	return state
end

describe("Anonymous lexical body checking") do
	test("captures only referenced parent identities with their declared capabilities") do
		source := "def factory(mut counter: Integer, label: String, other: String)\nputs(other)\n_callback := fn(delta: Integer): Integer\nputs(label)\ncounter += delta\nreturn counter\nend\nend\ndef main()\nfactory(1, \"label\", \"other\")\nend\n"
		mut state := lambda_analysis_state(source)
		expect(has_diagnostic(state)).to_be_false()
		select_checked_body(state, 0)
		parent := state.checked[0]
		expect(parent.shared_bindings).to_equal([0])
		expect(parent.lambdas.size()).to_equal(1)
		lambda := parent.lambdas[0]
		expect(lambda.captures.size()).to_equal(2)
		expect(lambda.captures[0].name).to_equal("counter")
		expect(lambda.captures[0].identity).to_equal(0)
		expect(lambda.captures[0].type_name).to_equal("Integer")
		expect(lambda.captures[0].mutable).to_equal(1)
		expect(lambda.captures[1].name).to_equal("label")
		expect(lambda.captures[1].mutable).to_equal(0)
		expect(state.checked_bodies[lambda.body].function).to_equal(lambda.function[0])
		expect(state.declarations.function_count[0]).to_equal(3)
		expect(state.declarations.parameter_count[0]).to_equal(6)
	end

	test("lets fn parameters and local declarations shadow parent bindings") do
		source := "def factory(value: Integer, text: Integer, kept: String)\nputs(value + text)\n_callback := fn(value: String): String\ntext := value + kept\nreturn text\nend\nend\ndef main()\nend\n"
		mut state := lambda_analysis_state(source)
		expect(has_diagnostic(state)).to_be_false()
		select_checked_body(state, 0)
		captures := state.checked[0].lambdas[0].captures
		expect(captures.size()).to_equal(1)
		expect(captures[0].name).to_equal("kept")
		expect(captures[0].identity).to_equal(2)
	end

	test("propagates transitive captures while keeping nested parameters local") do
		source := "def factory(mut counter: Integer, unused: String)\nputs(unused)\n_outer := fn(seed: Integer): () -> Integer\nreturn fn(): Integer\ncounter += seed\nreturn counter\nend\nend\nend\ndef main()\nend\n"
		mut state := lambda_analysis_state(source)
		expect(has_diagnostic(state)).to_be_false()
		select_checked_body(state, 0)
		outer := state.checked[0].lambdas[0]
		expect(outer.captures.size()).to_equal(1)
		expect(outer.captures[0].name).to_equal("counter")
		expect(state.checked[0].shared_bindings).to_equal([0])
		expect(state.checked_bodies[outer.body].shared_bindings).to_equal([0])
		inner := state.checked_bodies[outer.body].lambdas[0]
		expect(inner.captures.size()).to_equal(2)
		expect(inner.captures[0].name).to_equal("counter")
		expect(inner.captures[1].name).to_equal("seed")
		expect(inner.body != outer.body).to_be_true()
	end

	test("distinguishes reused iteration slots and excludes hidden iteration state") do
		source := "def factory(mut counter: Integer)\n_outer := fn()\n[1].each do |item|\ncallback := fn(): Integer; return item + counter; end\nputs(callback())\nend\n[2].each do |item|\ncallback := fn(): Integer; return item + counter; end\nputs(callback())\nend\nend\nend\ndef main()\nend\n"
		mut state := lambda_analysis_state(source)
		expect(has_diagnostic(state)).to_be_false()
		select_checked_body(state, 0)
		outer := state.checked[0].lambdas[0]
		body := state.checked_bodies[outer.body]
		expect(body.shared_bindings.size()).to_equal(3)
		expect(body.shared_bindings.include?(0)).to_be_true()
		expect(body.shared_bindings.include?(body.lambdas[0].captures[1].identity)).to_be_true()
		expect(body.shared_bindings.include?(body.lambdas[1].captures[1].identity)).to_be_true()
		expect(body.lambdas.size()).to_equal(2)
		expect(body.lambdas[0].captures.size()).to_equal(2)
		expect(body.lambdas[1].captures.size()).to_equal(2)
		expect(body.lambdas[0].captures[1].name).to_equal("item")
		expect(body.lambdas[1].captures[1].name).to_equal("item")
		expect(body.lambdas[0].captures[1].identity != body.lambdas[1].captures[1].identity).to_be_true()
		expect(outer.captures.size()).to_equal(1)
		expect(outer.captures[0].name).to_equal("counter")
	end

	test("checks independent return types paths and immutable captures") do
		bodies := ["fn(): Integer; return \"wrong\"; end", "fn(); return 1; end", "fn(flag: Boolean): Integer; if flag; return 1; end; end", "fn(); value = 2; end", "fn(); value += 2; end", "fn(); puts(missing); end", "fn(); puts(later); later := 1; end"]
		errors := ["expected Integer, found String", "expected Void, found Integer", "fn must return on every completing path", "assignment target is immutable", "assignment target is immutable", "unresolved local missing", "unresolved local later"]
		mut index := 0
		while index < bodies.size()
			source := "def factory(value: Integer)\ncallback := " + bodies[index] + "\nend\ndef main()\nend\n"
			state := lambda_analysis_state(source)
			expect(load_string(state.diagnostics.messages, 0)).to_equal(errors[index])
			index += 1
		end
	end

	test("keeps loop transfers and conditional returns inside the fn boundary") do
		state := lambda_analysis_state("def main()\nwhile true\ncallback := fn(); break; end\nbreak\nend\nend\n")
		expect(load_string(state.diagnostics.messages, 0)).to_equal("break is only valid inside a loop")
		valid := lambda_analysis_state("def main()\ncallback := fn(flag: Boolean): Integer\nif flag\nreturn 1\nelse\nreturn 2\nend\nend\nend\n")
		expect(has_diagnostic(valid)).to_be_false()
	end

	test("checks unused nested bodies and their Result obligations") do
		invalid := lambda_analysis_state("def main()\nouter := fn()\ninner := fn(): Integer; return \"wrong\"; end\nend\nend\n")
		expect(load_string(invalid.diagnostics.messages, 0)).to_equal("expected Integer, found String")
		source := "import trb/std/result\ndef operation(): Result<Integer, String>\nreturn Result<Integer, String>::Ok(1)\nend\ndef main()\ncallback := fn()\nunused := operation()\nend\nend\n"
		result := lambda_analysis_state(source)
		expect(load_string(result.diagnostics.messages, 0)).to_equal("Result binding unused must be used")
	end

	test("resolves generic applications inside an owned anonymous body") do
		source := "def identity<T>(value: T): T; return value; end\ndef main()\ncallback := fn(value: Integer): Integer\nreturn identity<Integer>(value)\nend\nend\n"
		mut state := lambda_analysis_state(source)
		expect(has_diagnostic(state)).to_be_false()
		select_checked_body(state, 0)
		lambda := state.checked[0].lambdas[0]
		body := state.checked_bodies[lambda.body]
		mut origin := state.lambdas[0].body_start
		while load_string(state.source_tokens.token_texts, origin) != "identity"
			origin += 1
		end
		call := sparse_integer_at(body.generic_application_finishes, origin)
		expect(call > origin).to_be_true()
		expect(sparse_integer_at(body.generic_calls, call) > 0).to_be_true()
		expect(sparse_integer_at(state.checked[0].generic_calls, call)).to_equal(0)
	end

	test("owns different typed anonymous bodies for shared generic syntax") do
		source := "def probe<T>(value: T)\ncallback := fn(): T; return value; end\nend\ndef main()\nprobe<Integer>(1)\nprobe<String>(\"text\")\nend\n"
		mut state := compiler_new(source.size() * 4 + 64)
		expect(lex(state, source) && parse_module(state, 0, state.module_graph.entry_module[0]) && resolve(state)).to_be_true()
		mut body_ids: Array<Integer> := []
		mut index := 0
		while index < 2
			function := state.type_resolution.generic_function_instances[index].function
			select_checked_body(state, function)
			mut parent := locals_new(state.source_tokens.token_count[0] + 1)
			type_name := load_string(state.declarations.parameter_types, load_integer(state.declarations.function_parameter_starts, function))
			local_bind(parent, "value", type_name, 0)
			mut position := [state.lambdas[0].origin]
			value := check_lambda_value(state, position, parent)
			expect(value.type_name).to_equal("$Callable<" + type_name + ">")
			expect(state.diagnostics.count[0]).to_equal(0)
			lambda := state.checked[0].lambdas[0]
			expect(lambda.captures[0].type_name).to_equal(type_name)
			body_ids.push(lambda.body)
			index += 1
		end
		expect(body_ids[0] != body_ids[1]).to_be_true()
	end
	test("retains immutable nullable binding proofs without narrowing mutable captures") do
		accepted := lambda_analysis_state("def factory(value: Integer?)\nif value != nil\n_callback := fn(): Integer; return value; end\nend\nend\ndef main()\nend\n")
		expect(has_diagnostic(accepted)).to_be_false()
		rejected := lambda_analysis_state("def factory(mut value: Integer?)\nif value != nil\ncallback := fn(): Integer; return value; end\nend\nend\ndef main()\nend\n")
		expect(load_string(rejected.diagnostics.messages, 0)).to_equal("expected Integer, found Integer?")
	end

end
