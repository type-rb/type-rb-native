import { gate4_string_starts_with } from path
import { QbeOutput, qbe_output_line } from qbe_output

def project_runtime_qbe_line(value: String): Boolean
	if gate4_string_starts_with(value, "data $g4_project_")
		return true
	end
	if gate4_string_starts_with(value, "function l $g4_source_slice")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_c_")
		return true
	end
	if gate4_string_starts_with(value, "function w $g4_project_")
		return true
	end
	return gate4_string_starts_with(value, "function l $g4_collect_project_sources")
end

def emit_qbe_runtime(mut output: QbeOutput, project_runtime: Boolean)
	# The multiply helper's 26-bit fast entry proves the direct product is below
	# the portable limit; every other pair continues through its exact checks.
	lines := [
		"data $g4_newline = { b 10 }\ndata $g4_character_cache = align 8 { z 2048 }\ndata $g4_string_storage = align 8 { l 0, l 0, l 0 }\ndata $g4_temporary_storage = align 8 { l 0, l 0 }\ndata $g4_allocation_error = { b 112 97 110 105 99 58 32 97 108 108 111 99 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $g4_bounds_error = { b 112 97 110 105 99 58 32 105 110 100 101 120 32 105 115 32 111 117 116 32 111 102 32 98 111 117 110 100 115 10 }\ndata $g4_integer_error = { b 112 97 110 105 99 58 32 73 110 116 101 103 101 114 32 111 112 101 114 97 116 105 111 110 32 102 97 105 108 101 100 10 }\ndata $g4_integer_range_error = { b \"panic: Integer is outside the portable range\", b 10 }\ndata $g4_division_error = { b \"panic: division by zero\", b 10 }\ndata $g4_usage_error = { b \"usage: compiler {check|emit-qbe} SOURCE\", b 10, b \"       compiler build SOURCE --output OUTPUT --qbe QBE --cc CC\", b 10 }\ndata $g4_file_error = { b \"compiler: cannot read source file: \" }\ndata $g4_check = { b \"check\", b 0 }\ndata $g4_emit = { b \"emit-qbe\", b 0 }\ndata $g4_build = { b \"build\", b 0 }\ndata $g4_output_flag = { b \"--output\", b 0 }\ndata $g4_qbe_flag = { b \"--qbe\", b 0 }\ndata $g4_cc_flag = { b \"--cc\", b 0 }\ndata $g4_target_option = { b \"--target\", b 0 }\ndata $g4_source_arg = { b \"--source-content\", b 0 }\ndata $g4_rb = { b \"rb\", b 0 }\ndata $g4_wb = { b \"wb\", b 0 }\ndata $g4_ssa_suffix = { b \".trbn.ssa\", b 0 }\ndata $g4_asm_suffix = { b \".trbn.s\", b 0 }\ndata $g4_temp_suffix = { b \".trbn.XXXXXX\", b 0 }\ndata $g4_slash = { b \"/\", b 0 }\ndata $g4_target_flag = { b \"-t\", b 0 }\ndata $g4_profile_darwin_arm64 = { b \"darwin-arm64-v0\", b 0 }\ndata $g4_profile_linux_arm64 = { b \"linux-arm64-v0\", b 0 }\ndata $g4_profile_linux_amd64 = { b \"linux-amd64-v0\", b 0 }\ndata $g4_qbe_darwin_arm64 = { b \"arm64_apple\", b 0 }\ndata $g4_qbe_linux_arm64 = { b \"arm64\", b 0 }\ndata $g4_qbe_linux_amd64 = { b \"amd64_sysv\", b 0 }\ndata $g4_o_flag = { b \"-o\", b 0 }\ndata $g4_math_library = { b \"-lm\", b 0 }",
		"data $g4_project_assembler_input = { b \"-xassembler\", b 0 }",
		"data $g4_project_linker_lld = { b \"-fuse-ld=lld\", b 0 }",
		"data $g4_dead_strip_darwin = { b \"-Wl,-dead_strip,-x\", b 0 }",
		"data $g4_dead_strip_linux = { b \"-Wl,--gc-sections,--strip-all,--no-eh-frame-hdr\", b 0 }",
		"data $g4_selected_qbe_target = align 8 { l $g4_qbe_darwin_arm64 }",
		"data $g4_selected_dead_strip = align 8 { l $g4_dead_strip_darwin }",
		"data $g4_project_selected_linker = align 8 { l 0 }",
		"data $g4_project_paths = align 8 { l 0 }\ndata $g4_project_error = align 8 { l 0 }\ndata $g4_project_source_root = align 8 { l 0 }\ndata $g4_project_out_root = align 8 { l 0 }\ndata $g4_project_empty_string = align 8 { l 0, l 0, b 0 }\ndata $g4_project_trb_suffix = { b \".trb\", b 0 }\ndata $g4_project_test_suffix = { b \"_test.trb\", b 0 }\ndata $g4_project_git_component = { b \"/.git\", b 0 }\ndata $g4_project_trb_component = { b \"/.trb\", b 0 }\ndata $g4_project_node_modules_component = { b \"/node_modules\", b 0 }",
		"data $g4_target_error = { b \"compiler: unsupported target profile\", b 10 }\ndata $g4_intermediate_error = { b \"compiler: cannot create intermediate file\", b 10 }\ndata $g4_qbe_error = { b \"compiler: qbe failed\", b 10 }\ndata $g4_cc_error = { b \"compiler: cc failed\", b 10 }\ndata $g4_publish_error = { b \"compiler: cannot publish output\", b 10 }\n\nfunction $g4_fail(l %message, l %size) {\n@start\n\tcall $write(w 2, l %message, l %size)\n\tcall $exit(w 2)\n\thlt\n}\n\nfunction l $g4_alloc(l %size) {\n@start\n\t%pointer =l call $calloc(l 1, l %size)\n\t%failed =w ceql %pointer, 0\n\tjnz %failed, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ok\n\tret %pointer\n}\n\nfunction l $g4_string_alloc(l %size) {\n@start\n\t%result =l call $g4_gc_alloc(l $g4_desc_string, l %size, l 0)\n\tret %result\n}\n\nfunction l $g4_temp_alloc(l %size) {\n@start\n\t%storage =l loadl $g4_temporary_storage\n\t%missing =w ceql %storage, 0\n\tjnz %missing, @initialize, @allocate\n@initialize\n\t%allocated =l call $calloc(l 1, l 1048576)\n\t%failed =w ceql %allocated, 0\n\tjnz %failed, @allocation_failed, @initialized\n@allocation_failed\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@initialized\n\tstorel %allocated, $g4_temporary_storage\n\tjmp @allocate\n@allocate\n\t%base =l loadl $g4_temporary_storage\n\t%used_address =l add $g4_temporary_storage, 8\n\t%used =l loadl %used_address\n\t%with_padding =l add %size, 7\n\t%aligned =l and %with_padding, -8\n\t%next =l add %used, %aligned\n\t%overflow =w csltl 1048576, %next\n\tjnz %overflow, @capacity_failed, @ready\n@capacity_failed\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ready\n\t%result =l add %base, %used\n\tstorel %next, %used_address\n\tret %result\n}\n\nfunction $g4_temp_reset() {\n@start\n\t%used_address =l add $g4_temporary_storage, 8\n\tstorel 0, %used_address\n\tret\n}\n\nfunction l $g4_string_from_c(l %source) {\n@start\n\t%length =l call $strlen(l %source)\n\t%size =l add %length, 9\n\t%string =l call $g4_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 16\n\tcall $memcpy(l %data, l %source, l %length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %string\n}\n\nfunction l $g4_read_file(l %p) {\n@start\n\t%f =l call $fopen(l %p, l $g4_rb)\n\t%fm =w ceql %f, 0\n\tjnz %fm, @fail, @seek\n@seek\n\t%es =w call $fseek(l %f, l 0, w 2)\n\t%ef =w cnew %es, 0\n\tjnz %ef, @close, @len\n@len\n\t%n =l call $ftell(l %f)\n\t%neg =w csltl %n, 0\n\tjnz %neg, @close, @rewind\n@rewind\n\t%rs =w call $fseek(l %f, l 0, w 0)\n\t%rf =w cnew %rs, 0\n\tjnz %rf, @close, @alloc\n@alloc\n\t%sz =l add %n, 9\n\t%s =l call $g4_string_alloc(l %sz)\n\t%length_address =l add %s, 8\n\tstorel %n, %length_address\n\t%d =l add %s, 16\n\t%got =l call $fread(l %d, l 1, l %n, l %f)\n\t%cs =w call $fclose(l %f)\n\t%rfe =w cnel %got, %n\n\t%cfe =w cnew %cs, 0\n\t%bad =w or %rfe, %cfe\n\tjnz %bad, @fail, @done\n@done\n\t%e =l add %d, %n\n\tstoreb 0, %e\n\t%file_root =l add $g4_gc_global_roots, 8\n\tstorel %s, %file_root\n\tret %s\n@close\n\t%ignored =w call $fclose(l %f)\n\tjmp @fail\n@fail\n\tret 0\n}\n",
		"function l $g4_file_exists(l %path) {\n@start\n\t%data =l add %path, 16\n\t%status =w call $access(l %data, w 0)\n\t%ok =w ceqw %status, 0\n\t%result =l extuw %ok\n\tret %result\n}\n",
		"function l $g4_read_source(l %path) {\n@start\n\t%data =l add %path, 16\n\t%source =l call $g4_read_file(l %data)\n\tret %source\n}\n",
		"function l $g4_source_slice(l %source, l %start, l %finish) {\n@start\n\t%length =l sub %finish, %start\n\t%size =l add %length, 9\n\t%result =l call $g4_string_alloc(l %size)\n\t%length_address =l add %result, 8\n\tstorel %length, %length_address\n\t%source_data =l add %source, 16\n\t%from =l add %source_data, %start\n\t%data =l add %result, 16\n\tcall $memcpy(l %data, l %from, l %length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %result\n}\n\nfunction w $g4_c_ends_with(l %value, l %suffix) {\n@start\n\t%value_length =l call $strlen(l %value)\n\t%suffix_length =l call $strlen(l %suffix)\n\t%short =w csltl %value_length, %suffix_length\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %value_length, %suffix_length\n\t%start =l add %value, %offset\n\t%comparison =w call $memcmp(l %start, l %suffix, l %suffix_length)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $g4_c_is_test_source(l %path) {\n@start\n\t%length =l call $strlen(l %path)\n\t%short =w csltl %length, 9\n\tjnz %short, @no, @compare\n@compare\n\t%offset =l sub %length, 9\n\t%start =l add %path, %offset\n\t%comparison =w call $strncasecmp(l %start, l $g4_project_test_suffix, l 9)\n\t%equal =w ceqw %comparison, 0\n\tret %equal\n@no\n\tret 0\n}\n\nfunction w $g4_c_has_directory_component(l %path, l %component) {\n@start\n\t%component_length =l call $strlen(l %component)\n\tjmp @search\n@search\n\t%cursor =l phi @start %path, @advance %advanced\n\t%match =l call $strstr(l %cursor, l %component)\n\t%missing =w ceql %match, 0\n\tjnz %missing, @no, @boundary\n@boundary\n\t%after =l add %match, %component_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tjnz %matched, @yes, @advance\n@advance\n\t%advanced =l add %match, 1\n\tjmp @search\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $g4_c_path_has_prefix(l %path, l %prefix) {\n@start\n\t%path_length =l call $strlen(l %path)\n\t%prefix_length =l call $strlen(l %prefix)\n\t%short =w csltl %path_length, %prefix_length\n\tjnz %short, @no, @compare\n@compare\n\t%comparison =w call $memcmp(l %path, l %prefix, l %prefix_length)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @no, @boundary\n@boundary\n\t%after =l add %path, %prefix_length\n\t%character =w loadub %after\n\t%end =w ceqw %character, 0\n\t%slash =w ceqw %character, 47\n\t%matched =w or %end, %slash\n\tret %matched\n@no\n\tret 0\n}\n\nfunction w $g4_project_path_excluded(l %path) {\n@start\n\t%source_root =l loadl $g4_project_source_root\n\t%source_comparison =w call $strcmp(l %path, l %source_root)\n\t%source =w ceqw %source_comparison, 0\n\tjnz %source, @no, @out_root\n@out_root\n\t%out_root =l loadl $g4_project_out_root\n\t%roots_comparison =w call $strcmp(l %source_root, l %out_root)\n\t%same_roots =w ceqw %roots_comparison, 0\n\tjnz %same_roots, @components, @out_prefix\n@out_prefix\n\t%inside_out =w call $g4_c_path_has_prefix(l %path, l %out_root)\n\tjnz %inside_out, @yes, @components\n@components\n\t%git =w call $g4_c_has_directory_component(l %path, l $g4_project_git_component)\n\tjnz %git, @yes, @trb\n@trb\n\t%hidden =w call $g4_c_has_directory_component(l %path, l $g4_project_trb_component)\n\tjnz %hidden, @yes, @node_modules\n@node_modules\n\t%node =w call $g4_c_has_directory_component(l %path, l $g4_project_node_modules_component)\n\tjnz %node, @yes, @no\n@yes\n\tret 1\n@no\n\tret 0\n}\n\nfunction w $g4_project_path_compare(l %left_cell, l %right_cell) {\n@start\n\t%left =l loadl %left_cell\n\t%right =l loadl %right_cell\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%left_shorter =w csltl %left_length, %right_length\n\tjnz %left_shorter, @left_minimum, @right_minimum\n@left_minimum\n\t%left_min =l copy %left_length\n\tjmp @compare\n@right_minimum\n\t%right_min =l copy %right_length\n\tjmp @compare\n@compare\n\t%minimum =l phi @left_minimum %left_min, @right_minimum %right_min\n\t%left_data =l add %left, 16\n\t%right_data =l add %right, 16\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %minimum)\n\t%different =w cnew %comparison, 0\n\tjnz %different, @compared, @lengths\n@compared\n\tret %comparison\n@lengths\n\t%shorter =w csltl %left_length, %right_length\n\tjnz %shorter, @less, @longer\n@longer\n\t%greater =w csgtl %left_length, %right_length\n\tjnz %greater, @more, @equal\n@less\n\tret -1\n@more\n\tret 1\n@equal\n\tret 0\n}\n\nfunction w $g4_project_walk_callback(l %path, l %stat, w %type, l %walk) {\n@start\n\t%excluded =w call $g4_project_path_excluded(l %path)\n\tjnz %excluded, @ignore, @classify\n@classify\n\t%regular =w ceqw %type, 0\n\tjnz %regular, @regular, @directory\n@directory\n\t%directory =w ceqw %type, 1\n\tjnz %directory, @ignore, @walk_error\n@walk_error\n\t%denied =w ceqw %type, 2\n\t%unknown =w ceqw %type, 4\n\t%unreadable =w or %denied, %unknown\n\tjnz %unreadable, @error, @special\n@special\n\t%source_kind =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source_kind, @error, @ignore\n@regular\n\t%source =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)\n\tjnz %source, @test, @ignore\n@test\n\t%test_source =w call $g4_c_is_test_source(l %path)\n\tjnz %test_source, @ignore, @collect\n@collect\n\t%owned =l call $g4_string_from_c(l %path)\n\t%paths =l loadl $g4_project_paths\n\tcall $g4_array_push(l %paths, l %owned)\n\tret 0\n@error\n\t%error =l call $g4_string_from_c(l %path)\n\tstorel %error, $g4_project_error\n\t%error_root =l add $g4_gc_global_roots, 88\n\tstorel %error, %error_root\n\tret 1\n@ignore\n\tret 0\n}\n\nfunction l $g4_collect_project_sources(l %source_root, l %out_root) {\n@start\n\t%paths =l call $g4_array_new(l $g4_desc_array_managed)\n\t%paths_root =l add $g4_gc_global_roots, 64\n\tstorel %paths, %paths_root\n\t%sources =l call $g4_array_new(l $g4_desc_array_managed)\n\t%sources_root =l add $g4_gc_global_roots, 72\n\tstorel %sources, %sources_root\n\t%result =l call $g4_gc_alloc(l $g4_desc_project_sources, l 24, l 0)\n\t%result_root =l add $g4_gc_global_roots, 80\n\tstorel %result, %result_root\n\t%paths_slot =l add %result, 8\n\tstorel %paths, %paths_slot\n\t%sources_slot =l add %result, 16\n\tstorel %sources, %sources_slot\n\t%error_slot =l add %result, 24\n\tstorel $g4_project_empty_string, %error_slot\n\tstorel %paths, $g4_project_paths\n\tstorel 0, $g4_project_error\n\t%error_root =l add $g4_gc_global_roots, 88\n\tstorel 0, %error_root\n\t%source_data =l add %source_root, 16\n\t%out_data =l add %out_root, 16\n\tstorel %source_data, $g4_project_source_root\n\tstorel %out_data, $g4_project_out_root\n\t%walk_status =w call $nftw(l %source_data, l $g4_project_walk_callback, w 32, w 1)\n\t%walk_error =l loadl $g4_project_error\n\t%callback_failed =w cnel %walk_error, 0\n\tjnz %callback_failed, @failed, @walk_result\n@walk_result\n\t%walk_failed =w cnew %walk_status, 0\n\tjnz %walk_failed, @root_failed, @sort\n@root_failed\n\tstorel %source_root, %error_slot\n\tret %result\n@failed\n\tstorel %walk_error, %error_slot\n\tret %result\n@sort\n\t%path_count_address =l add %paths, 8\n\t%path_count =l loadl %path_count_address\n\t%multiple =w csltl 1, %path_count\n\tjnz %multiple, @sort_paths, @read_start\n@sort_paths\n\t%paths_data_slot =l add %paths, 24\n\t%paths_data =l loadl %paths_data_slot\n\tcall $qsort(l %paths_data, l %path_count, l 8, l $g4_project_path_compare)\n\tjmp @read_start\n@read_start\n\t%read_data_slot =l add %paths, 24\n\t%read_data =l loadl %read_data_slot\n\tjmp @read_loop\n@read_loop\n\t%index =l phi @read_start 0, @read_next %next_index\n\t%finished =w cslel %path_count, %index\n\tjnz %finished, @success, @read\n@read\n\t%offset =l mul %index, 8\n\t%path_slot =l add %read_data, %offset\n\t%path =l loadl %path_slot\n\t%path_data =l add %path, 16\n\t%source =l call $g4_read_file(l %path_data)\n\t%read_failed =w ceql %source, 0\n\tjnz %read_failed, @source_failed, @source_ready\n@source_failed\n\tstorel %path, %error_slot\n\tret %result\n@source_ready\n\tcall $g4_array_push(l %sources, l %source)\n\tjmp @read_next\n@read_next\n\t%next_index =l add %index, 1\n\tjmp @read_loop\n@success\n\tret %result\n}\n\nfunction l $g4_c_concat(l %a, l %b) {\n@start\n\t%an =l call $strlen(l %a)\n\t%bn =l call $strlen(l %b)\n\t%n =l add %an, %bn\n\t%sz =l add %n, 1\n\t%r =l call $g4_alloc(l %sz)\n\tcall $memcpy(l %r, l %a, l %an)\n\t%p =l add %r, %an\n\tcall $memcpy(l %p, l %b, l %bn)\n\tret %r\n}\n\nfunction l $g4_c_basename(l %path) {\n@start\n\t%slash =l call $strrchr(l %path, w 47)\n\t%missing =w ceql %slash, 0\n\tjnz %missing, @whole, @suffix\n@whole\n\tret %path\n@suffix\n\t%base =l add %slash, 1\n\tret %base\n}\n",
		"function w $g4_run(l %program, l %args) {\n@start\n\t%pid =w call $fork()\n\t%ff =w csltw %pid, 0\n\tjnz %ff, @fail, @child_check\n@child_check\n\t%child =w ceqw %pid, 0\n\tjnz %child, @child, @parent\n@child\n\t%ignored =w call $execv(l %program, l %args)\n\tcall $exit(w 127)\n\thlt\n@parent\n\t%sp =l alloc8 8\n\tstorew 0, %sp\n\t%waited =w call $waitpid(w %pid, l %sp, w 0)\n\t%wf =w csltw %waited, 0\n\tjnz %wf, @fail, @status\n@status\n\t%st =w loadw %sp\n\t%sig =w and %st, 127\n\t%signaled =w cnew %sig, 0\n\tjnz %signaled, @signal, @exited\n@signal\n\t%sr =w add %sig, 128\n\tret %sr\n@exited\n\t%shifted =w shr %st, 8\n\t%code =w and %shifted, 255\n\tret %code\n@fail\n\tret 127\n}\n",
		"function w $g4_run_qbe(l %qbe, l %ssa, l %assembly) {\n@start\n\t%target =l loadl $g4_selected_qbe_target\n\t%a =l alloc8 56\n\tstorel %qbe, %a\n\t%a1 =l add %a, 8\n\tstorel $g4_target_flag, %a1\n\t%a2 =l add %a, 16\n\tstorel %target, %a2\n\t%a3 =l add %a, 24\n\tstorel $g4_o_flag, %a3\n\t%a4 =l add %a, 32\n\tstorel %assembly, %a4\n\t%a5 =l add %a, 40\n\tstorel %ssa, %a5\n\t%a6 =l add %a, 48\n\tstorel 0, %a6\n\t%r =w call $g4_run(l %qbe, l %a)\n\tret %r\n}\n",
		"function w $g4_project_run_cc(l %cc, l %assembly, l %output) {\n@start\n\t%dead_strip =l loadl $g4_selected_dead_strip\n\t%linker =l loadl $g4_project_selected_linker\n\t%a =l alloc8 72\n\tstorel %cc, %a\n\t%a1 =l add %a, 8\n\tstorel $g4_project_assembler_input, %a1\n\t%a2 =l add %a, 16\n\tstorel %assembly, %a2\n\t%has_linker =w cnel %linker, 0\n\tjnz %has_linker, @linker, @default\n@linker\n\t%linker_slot =l add %a, 24\n\tstorel %linker, %linker_slot\n\t%linker_tail =l add %a, 32\n\tjmp @tail\n@default\n\t%default_tail =l add %a, 24\n\tjmp @tail\n@tail\n\t%tail =l phi @linker %linker_tail, @default %default_tail\n\tstorel %dead_strip, %tail\n\t%math_slot =l add %tail, 8\n\tstorel $g4_math_library, %math_slot\n\t%output_flag_slot =l add %tail, 16\n\tstorel $g4_o_flag, %output_flag_slot\n\t%output_slot =l add %tail, 24\n\tstorel %output, %output_slot\n\t%end_slot =l add %tail, 32\n\tstorel 0, %end_slot\n\t%r =w call $g4_run(l %cc, l %a)\n\tret %r\n}\n",
		"function $g4_cleanup(l %ssa, l %assembly) {\n@start\n\t%i0 =w call $unlink(l %ssa)\n\t%i1 =w call $unlink(l %assembly)\n\tret\n}\n\nfunction $g4_cleanup_output(l %output, l %directory) {\n@start\n\t%i0 =w call $unlink(l %output)\n\t%i1 =w call $rmdir(l %directory)\n\tret\n}\n\nfunction l $g4_string_concat(l %left, l %right) {\n@start\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%length =l add %left_length, %right_length\n\t%size =l add %length, 9\n\t%string =l call $g4_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 16\n\t%left_data =l add %left, 16\n\tcall $memcpy(l %data, l %left_data, l %left_length)\n\t%right_target =l add %data, %left_length\n\t%right_data =l add %right, 16\n\tcall $memcpy(l %right_target, l %right_data, l %right_length)\n\t%end =l add %data, %length\n\tstoreb 0, %end\n\tret %string\n}\n\nfunction l $g4_string_equal(l %left, l %right) {\n@start\n\t%left_length_address =l add %left, 8\n\t%right_length_address =l add %right, 8\n\t%left_length =l loadl %left_length_address\n\t%right_length =l loadl %right_length_address\n\t%same_length =w ceql %left_length, %right_length\n\tjnz %same_length, @compare, @different\n@compare\n\t%left_data =l add %left, 16\n\t%right_data =l add %right, 16\n\t%comparison =w call $memcmp(l %left_data, l %right_data, l %left_length)\n\t%equal =w ceqw %comparison, 0\n\t%result =l extuw %equal\n\tret %result\n@different\n\tret 0\n}\n\nfunction l $g4_string_index(l %string, l %requested) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%negative =w csltl %requested, 0\n\tjnz %negative, @negative, @check\n@negative\n\t%adjusted_negative =l add %length, %requested\n\tjmp @bounds\n@check\n\t%adjusted_positive =l copy %requested\n\tjmp @bounds\n@bounds\n\t%index =l phi @negative %adjusted_negative, @check %adjusted_positive\n\t%below =w csltl %index, 0\n\t%above =w cslel %length, %index\n\t%invalid =w or %below, %above\n\tjnz %invalid, @fail, @load\n@fail\n\tcall $g4_fail(l $g4_bounds_error, l 30)\n\thlt\n@load\n\t%data =l add %string, 16\n\t%address =l add %data, %index\n\t%character =w loadub %address\n\t%result =l call $g4_string_alloc(l 10)\n\t%result_length =l add %result, 8\n\tstorel 1, %result_length\n\t%result_data =l add %result, 16\n\tstoreb %character, %result_data\n\t%result_end =l add %result_data, 1\n\tstoreb 0, %result_end\n\tret %result\n}\n\nfunction $g4_puts(l %str) {\n@start\n\t%size_ptr =l add %str, 8\n\t%size =l loadl %size_ptr\n\t%bytes =l add %str, 16\n\t%buf =l alloc8 32\n\t%buf_len =l add %buf, 8\n\t%tail =l add %buf, 16\n\t%tail_len =l add %buf, 24\n\tstorel %bytes, %buf\n\tstorel %size, %buf_len\n\tstorel $g4_newline, %tail\n\tstorel 1, %tail_len\n\tjmp @write\n@write\n\t%iov =l phi @start %buf, @partial %iov, @newline %tail\n\t%cnt =w phi @start 2, @partial %cnt, @newline 1\n\t%wrote =l call $writev(w 1, l %iov, w %cnt)\n\t%stop =w cslel %wrote, 0\n\tjnz %stop, @finish, @progress\n@progress\n\t%len_ptr =l add %iov, 8\n\t%len =l loadl %len_ptr\n\t%full =w csgel %wrote, %len\n\tjnz %full, @full, @partial\n@partial\n\t%ptr =l loadl %iov\n\t%next =l add %ptr, %wrote\n\t%left =l sub %len, %wrote\n\tstorel %next, %iov\n\tstorel %left, %len_ptr\n\tjmp @write\n@full\n\t%last =w ceqw %cnt, 1\n\t%both =w csgtl %wrote, %len\n\t%done =w or %last, %both\n\tjnz %done, @finish, @newline\n@newline\n\tjmp @write\n@finish\n\tret\n}\n\nfunction $g4_eputs(l %string) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%data =l add %string, 16\n\tcall $write(w 2, l %data, l %length)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret\n}\n\nfunction l $g4_array_new(l %descriptor) {\n@start\n\t%array =l call $g4_gc_alloc(l %descriptor, l 24, l 32)\n\t%data =l call $calloc(l 4, l 8)\n\t%failed =w ceql %data, 0\n\tjnz %failed, @fail, @initialize\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@initialize\n\t%heap =l loadl $g4_gc_heap_bytes\n\t%heap_with_data =l add %heap, 32\n\tstorel %heap_with_data, $g4_gc_heap_bytes\n\t%allocated =l loadl $g4_gc_allocated_bytes\n\t%allocated_with_data =l add %allocated, 32\n\tstorel %allocated_with_data, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_with_data)\n\t%length =l add %array, 8\n\tstorel 0, %length\n\t%capacity =l add %array, 16\n\tstorel 4, %capacity\n\t%data_slot =l add %array, 24\n\tstorel %data, %data_slot\n\tret %array\n}\n\nfunction $g4_array_push(l %array, l %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\t%new_capacity =l mul %capacity, 2\n\t%new_bytes =l mul %new_capacity, 8\n\t%old_bytes =l mul %capacity, 8\n\t%growth =l sub %new_bytes, %old_bytes\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $g4_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $g4_gc_heap_bytes\n\t%allocated_before =l loadl $g4_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_after)\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\tjmp @store\n@store\n\t%current_data_slot =l add %array, 24\n\t%current_data =l loadl %current_data_slot\n\t%offset =l mul %length, 8\n\t%target =l add %current_data, %offset\n\tstorel %value, %target\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\tret\n}\n\nfunction l $g4_integer_add(l %left, l %right) {\n@start\n\t%result =l add %left, %right\n\t%too_high =w csgtl %result, 9007199254740991\n\tjnz %too_high, @fail, @check_low\n@check_low\n\t%too_low =w csltl %result, -9007199254740991\n\tjnz %too_low, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n@ok\n\tret %result\n}\n\nfunction l $g4_integer_subtract(l %left, l %right) {\n@start\n\t%result =l sub %left, %right\n\t%too_high =w csgtl %result, 9007199254740991\n\tjnz %too_high, @fail, @check_low\n@check_low\n\t%too_low =w csltl %result, -9007199254740991\n\tjnz %too_low, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n@ok\n\tret %result\n}\n\nfunction l $g4_integer_mul(l %left, l %right) {\n@start\n\t%c =l or %left, %right\n\t%u =l shr %c, 26\n\tjnz %u, @left_sign, @multiply\n@left_sign\n\t%right_zero =w ceql %right, 0\n\tjnz %right_zero, @zero, @left_nonzero\n@left_nonzero\n\t%left_positive =w csgtl %left, 0\n\tjnz %left_positive, @left_positive, @left_negative\n@left_positive\n\t%right_positive =w csgtl %right, 0\n\tjnz %right_positive, @positive_positive, @positive_negative\n@positive_positive\n\t%positive_limit =l div 9007199254740991, %right\n\t%positive_overflow =w csgtl %left, %positive_limit\n\tjnz %positive_overflow, @fail, @multiply\n@positive_negative\n\t%negative_limit =l div -9007199254740991, %left\n\t%negative_overflow =w csltl %right, %negative_limit\n\tjnz %negative_overflow, @fail, @multiply\n@left_negative\n\t%right_positive_two =w csgtl %right, 0\n\tjnz %right_positive_two, @negative_positive, @negative_negative\n@negative_positive\n\t%negative_limit_two =l div -9007199254740991, %right\n\t%negative_overflow_two =w csltl %left, %negative_limit_two\n\tjnz %negative_overflow_two, @fail, @multiply\n@negative_negative\n\t%positive_limit_two =l div 9007199254740991, %right\n\t%positive_overflow_two =w csltl %left, %positive_limit_two\n\tjnz %positive_overflow_two, @fail, @multiply\n@multiply\n\t%result =l mul %left, %right\n\tret %result\n@zero\n\tret 0\n@fail\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n}\n\nfunction l $g4_integer_divide(l %left, l %right) {\n@start\n\t%zero =w ceql %right, 0\n\tjnz %zero, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_division_error, l 24)\n\thlt\n@ok\n\t%result =l div %left, %right\n\tret %result\n}\n\nfunction l $g4_integer_remainder(l %left, l %right) {\n@start\n\t%zero =w ceql %right, 0\n\tjnz %zero, @fail, @ok\n@fail\n\tcall $g4_fail(l $g4_division_error, l 24)\n\thlt\n@ok\n\t%result =l rem %left, %right\n\tret %result\n}\n",
	]
	mut index := 0
	while index < lines.size()
		line := lines[index]
		if project_runtime
			qbe_output_line(output, line)
		else
			if gate4_string_starts_with(line, "function w $g4_project_run_cc")
				qbe_output_line(
					output,
					"function w $g4_run_cc(l %cc, l %assembly, l %output) {\n@start\n\t%dead_strip =l loadl $g4_selected_dead_strip\n\t%a =l alloc8 56\n\tstorel %cc, %a\n\t%a1 =l add %a, 8\n\tstorel %assembly, %a1\n\t%a2 =l add %a, 16\n\tstorel %dead_strip, %a2\n\t%a3 =l add %a, 24\n\tstorel $g4_math_library, %a3\n\t%a4 =l add %a, 32\n\tstorel $g4_o_flag, %a4\n\t%a5 =l add %a, 40\n\tstorel %output, %a5\n\t%a6 =l add %a, 48\n\tstorel 0, %a6\n\t%r =w call $g4_run(l %cc, l %a)\n\tret %r\n}\n",
				)
			else
				if gate4_string_starts_with(line, "function l $g4_read_source")
					qbe_output_line(
						output,
						"function l $g4_read_source(l %path) {\n@start\n\t%data =l add %path, 16\n\t%source =l call $g4_read_file(l %data)\n\tret %source\n}\n",
					)
				else
					if !project_runtime_qbe_line(line)
						qbe_output_line(output, line)
					end
				end
			end
		end
		index += 1
	end
	emit_managed_runtime(output)
	return
end

def emit_managed_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $g4_gc_heap = align 8 { l 0 }\ndata $g4_gc_global_roots = align 8 { z 96 }\ndata $g4_gc_temp_data = align 8 { l 0 }\ndata $g4_gc_temp_count = align 8 { l 0 }\ndata $g4_gc_temp_capacity = align 8 { l 0 }\ndata $g4_gc_heap_bytes = align 8 { l 0 }\ndata $g4_gc_heap_target = align 8 { l 1048576 }\ndata $g4_gc_collection_count = align 8 { l 0 }\ndata $g4_gc_automatic_collection_count = align 8 { l 0 }\ndata $g4_gc_allocated_bytes = align 8 { l 0 }\ndata $g4_gc_reclaimed_bytes = align 8 { l 0 }\ndata $g4_gc_peak_heap_bytes = align 8 { l 0 }\ndata $g4_gc_trace_enabled = align 8 { l 0 }\ndata $g4_desc_string = align 8 { l 0 }\ndata $g4_desc_array_scalar = align 8 { l 2, l 0 }\ndata $g4_desc_array_managed = align 8 { l 2, l 1 }\ndata $g4_desc_project_sources = align 8 { l 1, l 3, l 24, l 8, l 16, l 24 }\ndata $g4_gc_stats_environment = { b \"TYPE_RB_NATIVE_RUNTIME_STATS\", b 0 }\ndata $g4_gc_trace_environment = { b \"TYPE_RB_NATIVE_RUNTIME_TRACE\", b 0 }\ndata $g4_gc_trace_collection = { b \"type-rb-native-gc-trace-v1,collection,\" }\ndata $g4_gc_trace_automatic = { b \"type-rb-native-gc-trace-v1,automatic,\" }\ndata $g4_gc_trace_live = { b \"type-rb-native-gc-trace-v1,live-bytes,\" }\ndata $g4_gc_trace_target = { b \"type-rb-native-gc-trace-v1,next-target-bytes,\" }\ndata $g4_gc_trace_roots = { b \"type-rb-native-gc-trace-v1,root-count,\" }\ndata $g4_gc_trace_capacity = { b \"type-rb-native-gc-trace-v1,root-capacity,\" }\ndata $g4_gc_report_collections = { b \"type-rb-native-gc-stat-v1,collections,\" }\ndata $g4_gc_report_automatic = { b \"type-rb-native-gc-stat-v1,automatic-collections,\" }\ndata $g4_gc_report_allocated = { b \"type-rb-native-gc-stat-v1,allocated-bytes,\" }\ndata $g4_gc_report_reclaimed = { b \"type-rb-native-gc-stat-v1,reclaimed-bytes,\" }\ndata $g4_gc_report_live = { b \"type-rb-native-gc-stat-v1,live-bytes,\" }\ndata $g4_gc_report_peak = { b \"type-rb-native-gc-stat-v1,peak-heap-bytes,\" }\n\nfunction $g4_gc_update_peak(l %candidate) {\n@start\n\t%peak =l loadl $g4_gc_peak_heap_bytes\n\t%greater =w csgtl %candidate, %peak\n\tjnz %greater, @store, @finish\n@store\n\tstorel %candidate, $g4_gc_peak_heap_bytes\n\tret\n@finish\n\tret\n}\n\nfunction $g4_gc_maybe_collect(l %additional) {\n@start\n\t%before =l loadl $g4_gc_heap_bytes\n\t%projected =l add %before, %additional\n\t%target =l loadl $g4_gc_heap_target\n\t%over =w csgtl %projected, %target\n\tjnz %over, @collect, @finish\n@collect\n\tcall $g4_gc_collect(w 1)\n@finish\n\tret\n}\n\nfunction $g4_gc_temp_push(l %value) {\n@start\n\t%nil =w ceql %value, 0\n\tjnz %nil, @finish, @descriptor\n@descriptor\n\t%descriptor_mark =l loadl %value\n\t%static =w ceql %descriptor_mark, 0\n\tjnz %static, @finish, @count\n@count\n\t%count =l loadl $g4_gc_temp_count\n\t%capacity =l loadl $g4_gc_temp_capacity\n\t%full =w ceql %count, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $g4_gc_temp_grow(l %value, l %count, l %capacity)\n\tret\n@store\n\t%current_data =l loadl $g4_gc_temp_data\n\t%offset =l shl %count, 3\n\t%slot =l add %current_data, %offset\n\tstorel %value, %slot\n\t%next_count =l add %count, 1\n\tstorel %next_count, $g4_gc_temp_count\n\tjmp @finish\n@finish\n\tret\n}\n\nfunction $g4_gc_temp_grow(l %value, l %count, l %capacity) {\n@start\n\t%empty =w ceql %capacity, 0\n\tjnz %empty, @minimum, @double\n@minimum\n\t%minimum =l copy 64\n\tjmp @allocate\n@double\n\t%doubled =l mul %capacity, 2\n\tjmp @allocate\n@allocate\n\t%next_capacity =l phi @minimum %minimum, @double %doubled\n\t%bytes =l mul %next_capacity, 8\n\t%data =l loadl $g4_gc_temp_data\n\t%new_data =l call $realloc(l %data, l %bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\tstorel %new_data, $g4_gc_temp_data\n\tstorel %next_capacity, $g4_gc_temp_capacity\n\t%offset =l mul %count, 8\n\t%slot =l add %new_data, %offset\n\tstorel %value, %slot\n\t%next_count =l add %count, 1\n\tstorel %next_count, $g4_gc_temp_count\n\tret\n}\n\nfunction $g4_gc_temp_reset(l %base) {\n@start\n\tstorel %base, $g4_gc_temp_count\n\tret\n}\n\nfunction l $g4_gc_alloc(l %descriptor, l %payload_size, l %reserved_size) {\n@start\n\t%total =l add %payload_size, 16\n\t%projected =l add %total, %reserved_size\n\tcall $g4_gc_maybe_collect(l %projected)\n\t%base =l call $malloc(l %total)\n\t%failed =w ceql %base, 0\n\tjnz %failed, @fail, @initialize\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@initialize\n\t%head =l loadl $g4_gc_heap\n\tstorel %head, %base\n\t%object =l add %base, 8\n\tstorel %descriptor, %object\n\t%payload =l add %object, 8\n\tcall $memset(l %payload, w 0, l %payload_size)\n\t%bytes =l loadl $g4_gc_heap_bytes\n\t%updated =l add %bytes, %total\n\tstorel %updated, $g4_gc_heap_bytes\n\t%allocated =l loadl $g4_gc_allocated_bytes\n\t%new_allocated =l add %allocated, %total\n\tstorel %new_allocated, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %updated)\n\tstorel %base, $g4_gc_heap\n\tcall $g4_gc_temp_push(l %object)\n\tret %object\n}\n\nfunction $g4_gc_scan_fixed(l %object, l %descriptor) {\n@start\n\t%count_address =l add %descriptor, 8\n\t%count =l loadl %count_address\n\tjmp @loop\n@loop\n\t%index =l phi @start 0, @visit %next\n\t%done =w cslel %count, %index\n\tjnz %done, @finish, @visit\n@visit\n\t%scaled =l mul %index, 8\n\t%entries =l add %descriptor, 24\n\t%entry =l add %entries, %scaled\n\t%offset =l loadl %entry\n\t%field =l add %object, %offset\n\t%reference =l loadl %field\n\tcall $g4_gc_mark(l %reference)\n\t%next =l add %index, 1\n\tjmp @loop\n@finish\n\tret\n}\n\nfunction $g4_gc_scan_array(l %object, l %descriptor) {\n@start\n\t%managed_address =l add %descriptor, 8\n\t%managed =l loadl %managed_address\n\t%scalar =w ceql %managed, 0\n\tjnz %scalar, @finish, @prepare\n@prepare\n\t%length_address =l add %object, 8\n\t%length =l loadl %length_address\n\t%data_address =l add %object, 24\n\t%data =l loadl %data_address\n\tjmp @loop\n@loop\n\t%index =l phi @prepare 0, @visit %next\n\t%done =w cslel %length, %index\n\tjnz %done, @finish, @visit\n@visit\n\t%scaled =l mul %index, 8\n\t%entry =l add %data, %scaled\n\t%reference =l loadl %entry\n\tcall $g4_gc_mark(l %reference)\n\t%next =l add %index, 1\n\tjmp @loop\n@finish\n\tret\n}\n\nfunction $g4_gc_mark(l %object) {\n@start\n\t%nil =w ceql %object, 0\n\tjnz %nil, @finish, @descriptor\n@descriptor\n\t%descriptor_mark =l loadl %object\n\t%static =w ceql %descriptor_mark, 0\n\tjnz %static, @finish, @check_mark\n@check_mark\n\t%mark =l and %descriptor_mark, 1\n\t%seen =w cnel %mark, 0\n\tjnz %seen, @finish, @dispatch\n@dispatch\n\t%marked_descriptor =l or %descriptor_mark, 1\n\tstorel %marked_descriptor, %object\n\t%descriptor =l and %descriptor_mark, -2\n\t%kind =l loadl %descriptor\n\t%fixed =w ceql %kind, 1\n\tjnz %fixed, @fixed, @check_array\n@fixed\n\tcall $g4_gc_scan_fixed(l %object, l %descriptor)\n\tret\n@check_array\n\t%array =w ceql %kind, 2\n\tjnz %array, @array, @finish\n@array\n\tcall $g4_gc_scan_array(l %object, l %descriptor)\n@finish\n\tret\n}\n\nfunction $g4_gc_mark_roots() {\n@start\n\t%temp_count =l loadl $g4_gc_temp_count\n\t%temp_data =l loadl $g4_gc_temp_data\n\tjmp @temp_loop\n@temp_loop\n\t%temp_index =l phi @start 0, @temp %next_temp\n\t%temps_done =w cslel %temp_count, %temp_index\n\tjnz %temps_done, @globals, @temp\n@temp\n\t%temp_scaled =l mul %temp_index, 8\n\t%temp_slot =l add %temp_data, %temp_scaled\n\t%temp_reference =l loadl %temp_slot\n\tcall $g4_gc_mark(l %temp_reference)\n\t%next_temp =l add %temp_index, 1\n\tjmp @temp_loop\n@globals\n\tjmp @global_loop\n@global_loop\n\t%global_index =l phi @globals 0, @global %next_global\n\t%globals_done =w cslel 12, %global_index\n\tjnz %globals_done, @finish, @global\n@global\n\t%global_scaled =l mul %global_index, 8\n\t%global_slot =l add $g4_gc_global_roots, %global_scaled\n\t%global_reference =l loadl %global_slot\n\tcall $g4_gc_mark(l %global_reference)\n\t%next_global =l add %global_index, 1\n\tjmp @global_loop\n@finish\n\tret\n}\n\nfunction $g4_gc_sweep() {\n@start\n\t%head =l loadl $g4_gc_heap\n\tjmp @loop\n@loop\n\t%current =l phi @start %head, @advance %next\n\t%previous =l phi @start 0, @advance %next_previous\n\t%done =w ceql %current, 0\n\tjnz %done, @finish, @object\n@object\n\t%next =l loadl %current\n\t%descriptor_address =l add %current, 8\n\t%descriptor_mark =l loadl %descriptor_address\n\t%mark =l and %descriptor_mark, 1\n\t%live =w cnel %mark, 0\n\tjnz %live, @keep, @release\n@keep\n\t%descriptor =l and %descriptor_mark, -2\n\tstorel %descriptor, %descriptor_address\n\tjmp @advance\n@release\n\t%released_descriptor =l and %descriptor_mark, -2\n\t%kind =l loadl %released_descriptor\n\t%array =w ceql %kind, 2\n\tjnz %array, @release_array, @check_fixed\n@release_array\n\t%data_address =l add %current, 32\n\t%data =l loadl %data_address\n\t%capacity_address =l add %current, 24\n\t%capacity =l loadl %capacity_address\n\t%backing_bytes =l mul %capacity, 8\n\t%heap_with_backing =l loadl $g4_gc_heap_bytes\n\t%heap_without_backing =l sub %heap_with_backing, %backing_bytes\n\tstorel %heap_without_backing, $g4_gc_heap_bytes\n\t%reclaimed_before_backing =l loadl $g4_gc_reclaimed_bytes\n\t%reclaimed_with_backing =l add %reclaimed_before_backing, %backing_bytes\n\tstorel %reclaimed_with_backing, $g4_gc_reclaimed_bytes\n\t%has_data =w cnel %data, 0\n\tjnz %has_data, @free_data, @array_ready\n@free_data\n\tcall $free(l %data)\n\tjmp @array_ready\n@array_ready\n\t%array_size =l copy 40\n\tjmp @unlink\n@check_fixed\n\t%fixed =w ceql %kind, 1\n\tjnz %fixed, @fixed_size, @string_size\n@fixed_size\n\t%payload_size_address =l add %released_descriptor, 16\n\t%payload_size =l loadl %payload_size_address\n\t%fixed_size =l add %payload_size, 16\n\tjmp @unlink\n@string_size\n\t%length_address =l add %current, 16\n\t%length =l loadl %length_address\n\t%string_size =l add %length, 25\n\tjmp @unlink\n@unlink\n\t%size =l phi @array_ready %array_size, @fixed_size %fixed_size, @string_size %string_size\n\t%at_head =w ceql %previous, 0\n\tjnz %at_head, @unlink_head, @unlink_after\n@unlink_head\n\tstorel %next, $g4_gc_heap\n\tjmp @account\n@unlink_after\n\tstorel %next, %previous\n@account\n\t%bytes =l loadl $g4_gc_heap_bytes\n\t%remaining =l sub %bytes, %size\n\tstorel %remaining, $g4_gc_heap_bytes\n\t%reclaimed =l loadl $g4_gc_reclaimed_bytes\n\t%new_reclaimed =l add %reclaimed, %size\n\tstorel %new_reclaimed, $g4_gc_reclaimed_bytes\n\tcall $free(l %current)\n\tjmp @advance\n@advance\n\t%next_previous =l phi @keep %current, @account %previous\n\tjmp @loop\n@finish\n\tret\n}\n\nfunction $g4_gc_collect(w %automatic) {\n@start\n\tcall $g4_gc_mark_roots()\n\tcall $g4_gc_sweep()\n\t%count =l loadl $g4_gc_collection_count\n\t%next_count =l add %count, 1\n\tstorel %next_count, $g4_gc_collection_count\n\tjnz %automatic, @automatic, @pace\n@automatic\n\t%automatic_count =l loadl $g4_gc_automatic_collection_count\n\t%next_automatic =l add %automatic_count, 1\n\tstorel %next_automatic, $g4_gc_automatic_collection_count\n\tjmp @pace\n@pace\n\t%live =l loadl $g4_gc_heap_bytes\n\t%doubled =l mul %live, 2\n\t%candidate =l add %doubled, 65536\n\t%small =w csltl %candidate, 1048576\n\tjnz %small, @minimum, @candidate\n@minimum\n\tstorel 1048576, $g4_gc_heap_target\n\tjmp @trace\n@candidate\n\tstorel %candidate, $g4_gc_heap_target\n\tjmp @trace\n@trace\n\tcall $g4_gc_trace(w %automatic, l %next_count)\n\tret\n}\n\nfunction $g4_gc_trace_initialize() {\n@start\n\t%enabled =l call $getenv(l $g4_gc_trace_environment)\n\tstorel %enabled, $g4_gc_trace_enabled\n\tret\n}\n\nfunction $g4_gc_trace(w %automatic, l %collection) {\n@start\n\t%enabled =l loadl $g4_gc_trace_enabled\n\t%disabled =w ceql %enabled, 0\n\tjnz %disabled, @finish, @select\n@select\n\t%manual =w ceqw %automatic, 0\n\tjnz %manual, @emit, @interval\n@interval\n\t%remainder =l rem %collection, 64\n\t%sampled =w ceql %remainder, 0\n\tjnz %sampled, @emit, @finish\n@emit\n\tcall $g4_gc_report(l $g4_gc_trace_collection, l 38, l %collection)\n\t%automatic_value =l extuw %automatic\n\tcall $g4_gc_report(l $g4_gc_trace_automatic, l 37, l %automatic_value)\n\t%live =l loadl $g4_gc_heap_bytes\n\tcall $g4_gc_report(l $g4_gc_trace_live, l 38, l %live)\n\t%target =l loadl $g4_gc_heap_target\n\tcall $g4_gc_report(l $g4_gc_trace_target, l 45, l %target)\n\t%roots =l loadl $g4_gc_temp_count\n\tcall $g4_gc_report(l $g4_gc_trace_roots, l 38, l %roots)\n\t%capacity =l loadl $g4_gc_temp_capacity\n\tcall $g4_gc_report(l $g4_gc_trace_capacity, l 41, l %capacity)\n@finish\n\tret\n}\n\nfunction $g4_gc_report(l %label, l %label_size, l %value) {\n@start\n\tcall $write(w 2, l %label, l %label_size)\n\t%buffer =l alloc8 32\n\t%end =l add %buffer, 32\n\t%cursor_slot =l alloc8 8\n\t%value_slot =l alloc8 8\n\tstorel %end, %cursor_slot\n\tstorel %value, %value_slot\n\t%zero =w ceql %value, 0\n\tjnz %zero, @zero, @loop\n@zero\n\t%zero_cursor =l sub %end, 1\n\tstoreb 48, %zero_cursor\n\tstorel %zero_cursor, %cursor_slot\n\tjmp @write\n@loop\n\t%current =l loadl %value_slot\n\t%done =w ceql %current, 0\n\tjnz %done, @write, @digit\n@digit\n\t%remainder =l rem %current, 10\n\t%digit =l add %remainder, 48\n\t%digit_byte =w copy %digit\n\t%cursor =l loadl %cursor_slot\n\t%next_cursor =l sub %cursor, 1\n\tstoreb %digit_byte, %next_cursor\n\tstorel %next_cursor, %cursor_slot\n\t%remaining =l div %current, 10\n\tstorel %remaining, %value_slot\n\tjmp @loop\n@write\n\t%start =l loadl %cursor_slot\n\t%size =l sub %end, %start\n\tcall $write(w 2, l %start, l %size)\n\tcall $write(w 2, l $g4_newline, l 1)\n\tret\n}\n\nfunction $g4_gc_finish() {\n@start\n\t%stats_enabled =l call $getenv(l $g4_gc_stats_environment)\n\t%trace_enabled =l loadl $g4_gc_trace_enabled\n\t%stats_disabled =w ceql %stats_enabled, 0\n\t%trace_disabled =w ceql %trace_enabled, 0\n\t%disabled =w and %stats_disabled, %trace_disabled\n\tjnz %disabled, @finish, @collect\n@collect\n\tstorel 0, $g4_gc_temp_count\n\tcall $memset(l $g4_gc_global_roots, w 0, l 96)\n\tcall $g4_gc_collect(w 0)\n\tjnz %stats_disabled, @finish, @report\n@report\n\t%collections =l loadl $g4_gc_collection_count\n\tcall $g4_gc_report(l $g4_gc_report_collections, l 38, l %collections)\n\t%automatic =l loadl $g4_gc_automatic_collection_count\n\tcall $g4_gc_report(l $g4_gc_report_automatic, l 48, l %automatic)\n\t%allocated =l loadl $g4_gc_allocated_bytes\n\tcall $g4_gc_report(l $g4_gc_report_allocated, l 42, l %allocated)\n\t%reclaimed =l loadl $g4_gc_reclaimed_bytes\n\tcall $g4_gc_report(l $g4_gc_report_reclaimed, l 42, l %reclaimed)\n\t%live =l loadl $g4_gc_heap_bytes\n\tcall $g4_gc_report(l $g4_gc_report_live, l 37, l %live)\n\t%peak =l loadl $g4_gc_peak_heap_bytes\n\tcall $g4_gc_report(l $g4_gc_report_peak, l 42, l %peak)\n@finish\n\tret\n}\n")
	qbe_output_line(output, "\nfunction $g4_gc_temp_reserve(l %required) {\n@start\n\t%capacity =l loadl $g4_gc_temp_capacity\n\t%enough =w cslel %required, %capacity\n\tjnz %enough, @finish, @initial\n@initial\n\t%empty =w ceql %capacity, 0\n\tjnz %empty, @minimum, @existing\n@minimum\n\t%minimum =l copy 64\n\tjmp @grow\n@existing\n\t%existing =l copy %capacity\n\tjmp @grow\n@grow\n\t%current =l phi @minimum %minimum, @existing %existing, @double %doubled\n\t%large_enough =w cslel %required, %current\n\tjnz %large_enough, @allocate, @double\n@double\n\t%doubled =l mul %current, 2\n\tjmp @grow\n@allocate\n\t%bytes =l mul %current, 8\n\t%data =l loadl $g4_gc_temp_data\n\t%new_data =l call $realloc(l %data, l %bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @ready\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@ready\n\tstorel %new_data, $g4_gc_temp_data\n\tstorel %current, $g4_gc_temp_capacity\n@finish\n\tret\n}\n")
	# Traced non-Float Arrays share paced growth and a compact push ABI.
	qbe_output_line(output, "\nfunction $g4_array_push_paced(l %array, l %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $g4_array_grow_paced(l %array, l %value, l %length, l %capacity)\n\tret\n@store\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%offset =l shl %length, 3\n\t%target =l add %data, %offset\n\tstorel %value, %target\n\tret\n}\n\nfunction $g4_array_grow_paced(l %array, l %value, l %length, l %capacity) {\n@start\n\t%new_capacity =l shl %capacity, 2\n\t%new_bytes =l shl %new_capacity, 3\n\t%old_bytes =l shl %capacity, 3\n\t%growth =l sub %new_bytes, %old_bytes\n\tcall $g4_gc_maybe_collect(l %growth)\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $g4_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $g4_gc_heap_bytes\n\t%allocated_before =l loadl $g4_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_after)\n\t%capacity_slot =l add %array, 16\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\t%offset =l shl %length, 3\n\t%target =l add %new_data, %offset\n\tstorel %value, %target\n\t%new_length =l add %length, 1\n\t%length_slot =l add %array, 8\n\tstorel %new_length, %length_slot\n\tret\n}\n")
	return
end

def emit_float_array_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction $g4_array_push_d(l %array, d %value) {\n@start\n\t%length_slot =l add %array, 8\n\t%length =l loadl %length_slot\n\t%capacity_slot =l add %array, 16\n\t%capacity =l loadl %capacity_slot\n\t%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\t%new_capacity =l mul %capacity, 2\n\t%new_bytes =l mul %new_capacity, 8\n\t%old_bytes =l mul %capacity, 8\n\t%growth =l sub %new_bytes, %old_bytes\n\tcall $g4_gc_maybe_collect(l %growth)\n\t%data_slot =l add %array, 24\n\t%data =l loadl %data_slot\n\t%new_data =l call $realloc(l %data, l %new_bytes)\n\t%failed =w ceql %new_data, 0\n\tjnz %failed, @fail, @grown\n@fail\n\tcall $g4_fail(l $g4_allocation_error, l 26)\n\thlt\n@grown\n\t%heap_before =l loadl $g4_gc_heap_bytes\n\t%heap_after =l add %heap_before, %growth\n\tstorel %heap_after, $g4_gc_heap_bytes\n\t%allocated_before =l loadl $g4_gc_allocated_bytes\n\t%allocated_after =l add %allocated_before, %growth\n\tstorel %allocated_after, $g4_gc_allocated_bytes\n\tcall $g4_gc_update_peak(l %heap_after)\n\tstorel %new_capacity, %capacity_slot\n\tstorel %new_data, %data_slot\n\tjmp @store\n@store\n\t%current_data_slot =l add %array, 24\n\t%current_data =l loadl %current_data_slot\n\t%offset =l mul %length, 8\n\t%target =l add %current_data, %offset\n\tstored %value, %target\n\t%new_length =l add %length, 1\n\tstorel %new_length, %length_slot\n\tret\n}")
	return
end

def emit_process_runtime(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\ndata $g4_process_argc = align 8 { l 0 }\ndata $g4_process_argv_pointer = align 8 { l 0 }\n\nfunction l $g4_process_argv() {\n@start\n\t%array =l call $g4_array_new(l $g4_desc_array_managed)\n\t%argc =l loadl $g4_process_argc\n\t%argv =l loadl $g4_process_argv_pointer\n\tjmp @loop\n@loop\n\t%index =l phi @start 1, @append %next\n\t%done =w cslel %argc, %index\n\tjnz %done, @finish, @load\n@load\n\t%offset =l mul %index, 8\n\t%cell =l add %argv, %offset\n\t%source =l loadl %cell\n\t%string =l call $g4_string_from_c(l %source)\n\tcall $g4_array_push_paced(l %array, l %string)\n\tjmp @append\n@append\n\t%next =l add %index, 1\n\tjmp @loop\n@finish\n\tret %array\n}",
	)
	return
end

def emit_string_to_integer_runtime(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\ndata $g4_invalid_integer_error = { b \"panic: invalid Integer\", b 10 }\n\nfunction l $g4_string_to_integer(l %string) {\n@start\n\t%length_address =l add %string, 8\n\t%length =l loadl %length_address\n\t%empty =w ceql %length, 0\n\tjnz %empty, @invalid, @first\n@first\n\t%parse_start_slot =l alloc8 8\n\t%data =l add %string, 16\n\t%first =w loadub %data\n\t%plus =w ceqw %first, 43\n\t%minus =w ceqw %first, 45\n\t%signed =w or %plus, %minus\n\tjnz %signed, @signed, @unsigned\n@signed\n\t%sign_only =w ceql %length, 1\n\tjnz %sign_only, @invalid, @signed_start\n@signed_start\n\t%signed_index =l copy 1\n\tstorel %signed_index, %parse_start_slot\n\tjmp @validate\n@unsigned\n\t%unsigned_index =l copy 0\n\tstorel %unsigned_index, %parse_start_slot\n\tjmp @validate\n@validate\n\t%validation_index =l phi @signed_start %signed_index, @unsigned %unsigned_index, @validate_next %validation_next\n\t%validation_done =w cslel %length, %validation_index\n\tjnz %validation_done, @parse_start, @validate_digit\n@validate_digit\n\t%validation_address =l add %data, %validation_index\n\t%validation_character =w loadub %validation_address\n\t%validation_below =w csltw %validation_character, 48\n\t%validation_above =w csgtw %validation_character, 57\n\t%validation_invalid =w or %validation_below, %validation_above\n\tjnz %validation_invalid, @invalid, @validate_next\n@validate_next\n\t%validation_next =l add %validation_index, 1\n\tjmp @validate\n@parse_start\n\t%parse_begin =l loadl %parse_start_slot\n\tjmp @parse\n@parse\n\t%parse_index =l phi @parse_start %parse_begin, @parse_next %next_index\n\t%accumulator =l phi @parse_start 0, @parse_next %next_accumulator\n\t%parse_done =w cslel %length, %parse_index\n\tjnz %parse_done, @sign, @parse_digit\n@parse_digit\n\t%parse_address =l add %data, %parse_index\n\t%parse_character =w loadub %parse_address\n\t%digit_word =w sub %parse_character, 48\n\t%digit =l extuw %digit_word\n\t%large_prefix =w csgtl %accumulator, 900719925474099\n\t%limit_prefix =w ceql %accumulator, 900719925474099\n\t%large_digit =w csgtl %digit, 1\n\t%limit_overflow =w and %limit_prefix, %large_digit\n\t%overflow =w or %large_prefix, %limit_overflow\n\tjnz %overflow, @range, @accumulate\n@accumulate\n\t%scaled =l mul %accumulator, 10\n\t%next_accumulator =l add %scaled, %digit\n\tjmp @parse_next\n@parse_next\n\t%next_index =l add %parse_index, 1\n\tjmp @parse\n@sign\n\tjnz %minus, @negative, @positive\n@negative\n\t%negative_result =l sub 0, %accumulator\n\tret %negative_result\n@positive\n\tret %accumulator\n@invalid\n\tcall $g4_fail(l $g4_invalid_integer_error, l 23)\n\thlt\n@range\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n}",
	)
	return
end

def emit_integer_to_string_runtime(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\nfunction l $g4_integer_to_string(l %value) {\n@start\n\t%buffer =l alloc8 32\n\t%end =l add %buffer, 32\n\t%cursor_slot =l alloc8 8\n\tstorel %end, %cursor_slot\n\t%negative =w csltl %value, 0\n\tjnz %negative, @negative_value, @positive_value\n@negative_value\n\t%negative_magnitude =l sub 0, %value\n\tjmp @magnitude\n@positive_value\n\t%positive_magnitude =l copy %value\n\tjmp @magnitude\n@magnitude\n\t%magnitude_value =l phi @negative_value %negative_magnitude, @positive_value %positive_magnitude\n\t%zero =w ceql %magnitude_value, 0\n\tjnz %zero, @zero_digit, @digits\n@zero_digit\n\t%zero_cursor =l sub %end, 1\n\tstoreb 48, %zero_cursor\n\tstorel %zero_cursor, %cursor_slot\n\tjmp @sign\n@digits\n\t%current =l phi @magnitude %magnitude_value, @digit %remaining\n\t%done =w ceql %current, 0\n\tjnz %done, @sign, @digit\n@digit\n\t%remainder =l rem %current, 10\n\t%digit_value =l add %remainder, 48\n\t%digit_byte =w copy %digit_value\n\t%cursor =l loadl %cursor_slot\n\t%next_cursor =l sub %cursor, 1\n\tstoreb %digit_byte, %next_cursor\n\tstorel %next_cursor, %cursor_slot\n\t%remaining =l div %current, 10\n\tjmp @digits\n@sign\n\tjnz %negative, @negative_sign, @finish\n@negative_sign\n\t%sign_cursor =l loadl %cursor_slot\n\t%before_sign =l sub %sign_cursor, 1\n\tstoreb 45, %before_sign\n\tstorel %before_sign, %cursor_slot\n\tjmp @finish\n@finish\n\t%start =l loadl %cursor_slot\n\t%length =l sub %end, %start\n\t%size =l add %length, 9\n\t%string =l call $g4_string_alloc(l %size)\n\t%length_address =l add %string, 8\n\tstorel %length, %length_address\n\t%data =l add %string, 16\n\tcall $memcpy(l %data, l %start, l %length)\n\t%terminator =l add %data, %length\n\tstoreb 0, %terminator\n\tret %string\n}",
	)
	return
end

def emit_float_to_integer_runtime(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\ndata $g4_float_integer_error = { b \"panic: Float cannot be converted to Integer\", b 10 }\n\nfunction l $g4_float_to_integer(d %value) {\n@start\n\t%self_difference =d sub %value, %value\n\t%finite =w ceqd %self_difference, %self_difference\n\tjnz %finite, @range, @nonfinite\n@range\n\t%too_high =w cgtd %value, d_9007199254740991.0\n\t%too_low =w cltd %value, d_-9007199254740991.0\n\t%outside =w or %too_high, %too_low\n\tjnz %outside, @outside, @convert\n@convert\n\t%result =l dtosi %value\n\tret %result\n@nonfinite\n\tcall $g4_fail(l $g4_float_integer_error, l 44)\n\thlt\n@outside\n\tcall $g4_fail(l $g4_integer_range_error, l 45)\n\thlt\n}",
	)
	return
end

# Output conversion is a builtin operation, not user-defined to_s dispatch.
def emit_boolean_puts_runtime(mut output: QbeOutput)
	qbe_output_line(
		output,
		"\ndata $g4_true_text = align 8 { l 0, l 4, b \"true\", b 0 }\ndata $g4_false_text = align 8 { l 0, l 5, b \"false\", b 0 }\nfunction $g4_puts_boolean(l %value) {\n@start\n\tjnz %value, @true, @false\n@true\n\tcall $g4_puts(l $g4_true_text)\n\tret\n@false\n\tcall $g4_puts(l $g4_false_text)\n\tret\n}",
	)
end
