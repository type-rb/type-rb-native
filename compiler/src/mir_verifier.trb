import { mir_function_roots, mir_root_plan_equal } from mir_roots
import { MirFlow, mir_build_flow, mir_flow_blocks, mir_flow_graph_error, mir_value_available } from mir_flow
import { MirBlock, MirFunction, MirModule, mir_block_index, mir_control_value_type, mir_definition_count, mir_function_index, mir_origin_valid, mir_table_span_valid, mir_type_name, mir_value_type } from mir
import { mir_array_headers, mir_array_headers_equal, mir_array_loop_headers, mir_induction_address, mir_scalar_guard } from mir_analysis
import { mir_function_signature_error, mir_signatures_error } from mir_calls
import { mir_instruction_error } from mir_instructions

def mir_target_arguments_error(
		flow: MirFlow,
		native_module: MirModule,
		function: MirFunction,
		block: MirBlock,
		target: Integer,
		start: Integer,
		count: Integer,
	): String
	target_index := mir_block_index(native_module, function, target)
	if target_index < 0
		return "MIR terminator target does not exist"
	end
	target_block := native_module.blocks[target_index]
	if count != target_block.parameter_count
		return "MIR block argument arity differs"
	end
	mut index := 0
	while index < count
		value_id := native_module.arguments[start + index]
		if !mir_value_available(
				flow,
				block,
				block.instruction_start + block.instruction_count,
				value_id,
			)
			return "MIR block argument is undefined"
		end
		target_value := native_module.arguments[target_block.parameter_start + index]
		actual_type := mir_value_type(native_module, function.id, value_id)
		target_type := mir_value_type(native_module, function.id, target_value)
		if actual_type != target_type
			return "MIR block argument type differs"
		end
		index += 1
	end
	return ""
end

def mir_terminator_error(
		flow: MirFlow,
		native_module: MirModule,
		function: MirFunction,
		block: MirBlock,
	): String
	kind := block.terminator
	if kind == 1
		if block.condition == - 1
			if block.second_target == - 1
				if block.second_argument_count == 0
					if block.return_value == - 1
						return mir_target_arguments_error(
							flow,
							native_module,
							function,
							block,
							block.first_target,
							block.first_argument_start,
							block.first_argument_count,
						)
					end
				end
			end
		end
		return "MIR jump shape differs"
	end
	if kind == 2
		condition_type := mir_value_type(native_module, function.id, block.condition)
		condition_available := mir_value_available(
			flow,
			block,
			block.instruction_start + block.instruction_count,
			block.condition,
		)
		if condition_available
			if condition_type == 2
				if block.return_value == - 1
					first := mir_target_arguments_error(
						flow,
						native_module,
						function,
						block,
						block.first_target,
						block.first_argument_start,
						block.first_argument_count,
					)
					if first != ""
						return first
					end
					return mir_target_arguments_error(
						flow,
						native_module,
						function,
						block,
						block.second_target,
						block.second_argument_start,
						block.second_argument_count,
					)
				end
			end
		end
		return "MIR branch shape differs"
	end
	if kind == 3
		if block.return_value < - 1 && (function.kind != 2 || block.return_value != - 2)
			return "MIR return shape differs"
		end
		if block.condition == - 1
			if block.first_target == - 1
				if block.second_target == - 1
					if block.first_argument_count == 0
						if block.second_argument_count == 0
							if block.return_value >= 0
								if !mir_value_available(
										flow,
										block,
										block.instruction_start + block.instruction_count,
										block.return_value,
									)
									return "MIR return value is undefined"
								end
							end
							mut type_name := "Void"
							if block.return_value >= 0
								type_name = mir_type_name(mir_value_type(native_module, function.id, block.return_value))
							end
							if type_name != function.result_type
								return "MIR return type differs from declaration"
							end
							return ""
						end
					end
				end
			end
		end
		return "MIR return shape differs"
	end
	if kind == 4
		if block.condition == - 1
			if block.first_target == - 1
				if block.second_target == - 1
					if block.first_argument_start == 0
						if block.first_argument_count == 0
							if block.second_argument_start == 0
								if block.second_argument_count == 0
									if block.return_value == - 1
										return ""
									end
								end
							end
						end
					end
				end
			end
		end
		return "MIR trap shape differs"
	end
	return "MIR terminator kind is unsupported"
end

# Validate storage before definition counting or cross-block semantic checks.
# Range checks use subtraction so malformed large counts cannot overflow.
def mir_function_structure_error(native_module: MirModule, function: MirFunction): String
	if !mir_table_span_valid(function.parameter_start, function.parameter_count, native_module.arguments.size())
		return "MIR function parameter range is invalid"
	end
	if !mir_table_span_valid(function.block_start, function.block_count, native_module.blocks.size())
		return "MIR function block range is invalid"
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		if !mir_table_span_valid(block.parameter_start, block.parameter_count, native_module.arguments.size())
			return "MIR block parameter range is invalid"
		end
		if !mir_table_span_valid(block.instruction_start, block.instruction_count, native_module.instructions.size())
			return "MIR block instruction range is invalid"
		end
		if !mir_table_span_valid(block.first_argument_start, block.first_argument_count, native_module.arguments.size())
			return "MIR terminator argument range is invalid"
		end
		if !mir_table_span_valid(block.second_argument_start, block.second_argument_count, native_module.arguments.size())
			return "MIR alternate argument range is invalid"
		end
		block_index += 1
	end
	return ""
end

def mir_adapter_error(native_module: MirModule, function: MirFunction): String
	if function.kind == 0
		return ""
	end
	if function.kind == 2
		if function.block_count == 6
			body := native_module.blocks[function.block_start + 2]
			if body.instruction_count > 0
				if mir_induction_address(native_module, function, body, native_module.instructions[body.instruction_start])
					return ""
				end
			end
		end
		return "MIR induction adapter shape differs"
	end
	if function.kind == 1
		if function.block_count != 2
			return "MIR scalar adapter shape differs"
		end
		entry := native_module.blocks[function.block_start]
		if entry.id != function.entry_block || entry.terminator != 3 || entry.parameter_count != 0
			return "MIR scalar adapter shape differs"
		end
	end
	mut returned_type := 0
	mut block_index := function.block_start
	while block_index < function.block_start + function.block_count
		block := native_module.blocks[block_index]
		mut index := block.instruction_start
		while index < block.instruction_start + block.instruction_count
			kind := native_module.instructions[index].kind
			if (kind < 6 || kind > 9) && (function.kind != 3 || kind < 11 || kind > 18)
				return "MIR scalar control operation is unsupported"
			end
			index += 1
		end
		if block.terminator == 3
			type_id := mir_value_type(native_module, function.id, block.return_value)
			if function.kind == 3 && type_id != 0 && !mir_control_value_type(type_id)
				return "MIR scalar return type differs"
			end
			if returned_type != 0 && returned_type != type_id
				return "MIR scalar return type differs"
			end
			returned_type = type_id
		elsif function.kind == 1 && block.terminator != 4
			return "MIR scalar adapter shape differs"
		end
		block_index += 1
	end
	return ""
end

def mir_function_error(native_module: MirModule, function: MirFunction): String
	if function.kind < 0 || function.kind > 3
		return "MIR function adapter kind is invalid"
	end
	if function.kind == 3
		native_module.values.each do |value|
			if value.function_id == function.id
				if !mir_control_value_type(value.type_id)
					return "MIR scalar control value type differs"
				end
			end
		end
	end
	if mir_block_index(native_module, function, function.entry_block) < 0
		return "MIR function entry block does not exist"
	end
	signature_error := mir_function_signature_error(native_module, function)
	if signature_error != ""
		return signature_error
	end
	blocks := mir_flow_blocks(native_module, function)
	graph_error := mir_flow_graph_error(native_module, function, blocks)
	if graph_error != ""
		return graph_error
	end
	flow := mir_build_flow(native_module, function, blocks)
	mut index := function.parameter_start
	mut finish := index + function.parameter_count
	while index < finish
		if mir_value_type(native_module, function.id, native_module.arguments[index]) == 0
			return "MIR function parameter is undefined"
		end
		index += 1
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		if !mir_origin_valid(block.source_id, block.line, native_module.source_count[0])
			return "MIR block origin is invalid"
		end
		index = block.parameter_start
		finish = index + block.parameter_count
		while index < finish
			if mir_value_type(native_module, function.id, native_module.arguments[index]) == 0
				return "MIR block parameter is undefined"
			end
			index += 1
		end
		index = block.instruction_start
		finish = index + block.instruction_count
		while index < finish
			error := mir_instruction_error(flow, native_module, function, block, index)
			if error != ""
				return error
			end
			index += 1
		end
		error := mir_terminator_error(flow, native_module, function, block)
		if error != ""
			return error
		end
		block_index += 1
	end
	return mir_adapter_error(native_module, function)
end

def verify_mir(native_module: MirModule, optimized: Boolean): String
	if native_module.source_count[0] <= 0
		return "MIR module has no sources"
	end
	signature_error := mir_signatures_error(native_module)
	if signature_error != ""
		return signature_error
	end
	mut entry_found := false
	mut index := 0
	if optimized
		if native_module.array_headers.size() != native_module.array_regions.size() || native_module.array_loop_headers.size() != native_module.array_regions.size()
			return "MIR optimized Array-header fact is invalid"
		end
	else
		if native_module.array_headers.size() != 0 || native_module.array_loop_headers.size() != 0
			return "MIR input cannot supply optimization facts"
		end
	end
	while index < native_module.array_regions.size()
		header := mir_array_headers(native_module.array_regions[index])
		if !header.valid
			return "MIR Array region is invalid"
		end
		if optimized
			mut loops: Array<Integer> := []
			if header.declarations.size() == 0
				loops = mir_array_loop_headers(native_module.array_regions[index])
			end
			if !mir_array_headers_equal(native_module.array_loop_headers[index], loops)
				return "MIR optimized Array-header fact is invalid"
			end
			if !mir_array_headers_equal(native_module.array_headers[index], header.declarations)
				return "MIR optimized Array-header fact is invalid"
			end
		end
		index += 1
	end
	if native_module.functions.size() == 0
		return ""
	end
	index = 0
	while index < native_module.functions.size()
		function := native_module.functions[index]
		if function.id < 0
			return "MIR function identifier is invalid"
		end
		if !mir_origin_valid(function.source_id, function.line, native_module.source_count[0])
			return "MIR function origin is invalid"
		end
		mut previous := 0
		while previous < index
			if native_module.functions[previous].id == function.id
				return "MIR function identifier is duplicated"
			end
			previous += 1
		end
		if function.id == native_module.entry_function[0]
			entry_found = true
		end
		error := mir_function_structure_error(native_module, function)
		if error != ""
			return error
		end
		index += 1
	end
	if !entry_found
		return "MIR entry function does not exist"
	end
	index = 0
	while index < native_module.values.size()
		value := native_module.values[index]
		function_index := mir_function_index(native_module, value.function_id)
		if function_index < 0
			return "MIR value identity is invalid"
		end
		if value.id < 0
			return "MIR value identity is invalid"
		end
		if value.type_id < 1
			return "MIR value type is invalid"
		end
		if value.type_id > 8
			return "MIR value type is invalid"
		end
		if !mir_origin_valid(value.source_id, value.line, native_module.source_count[0])
			return "MIR value origin is invalid"
		end
		mut previous := 0
		while previous < index
			other := native_module.values[previous]
			if other.function_id == value.function_id
				if other.id == value.id
					return "MIR value is defined more than once"
				end
			end
			previous += 1
		end
		function := native_module.functions[function_index]
		if mir_definition_count(native_module, function, value.id) != 1
			return "MIR value definition count differs"
		end
		index += 1
	end
	index = 0
	while index < native_module.functions.size()
		error := mir_function_error(native_module, native_module.functions[index])
		if error != ""
			return error
		end
		function := native_module.functions[index]
		mut expected_guard := 0
		if optimized
			expected_guard = mir_scalar_guard(native_module, function)
		end
		if function.integer_guard != expected_guard
			return "MIR scalar Integer guard differs"
		end
		index += 1
	end
	if optimized
		if native_module.root_plans.size() != native_module.functions.size()
			return "MIR root plan count differs"
		end
	elsif native_module.root_plans.size() != 0
		return "MIR input cannot supply root plans"
	end
	if optimized
		index = 0
		while index < native_module.functions.size()
			if !mir_root_plan_equal(native_module.root_plans[index], mir_function_roots(native_module, native_module.functions[index]))
				return "MIR live root plan differs"
			end
			index += 1
		end
	end
	return ""
end
