import { integer_string } from literals
import { mir_operand_type, mir_semantic_type_name } from mir_types
import { MirInstruction } from mir
import { QbeEmitContext, QbeValue, emit_temporary, emitted_value } from qbe_context
import { QbeOutput, qbe_output_line } from qbe_output
import { CompilerState } from state

# Runtime calls implement the verified operation, with no source inspection or
# root/effect inference here. The control adapter publishes the MIR root plan.
def emit_mir_string_instruction(state: CompilerState, value_types: Array<Integer>, instruction: MirInstruction, operands: Array<String>, symbols: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput): QbeValue
	kind := instruction.kind
	result_type := mir_semantic_type_name(state.scalar_mir, mir_operand_type(value_types, instruction.result))
	if kind == 12
		return emitted_value(symbols[instruction.payload], "String")
	end
	first := operands[instruction.first]
	if kind == 18
		mut runtime := "$trbn_puts"
		if mir_operand_type(value_types, instruction.first) == 2
			runtime = "$trbn_puts_boolean"
			output.runtime_flags[4] = 1
		end
		qbe_output_line(output, "\tcall " + runtime + "(l " + first + ")")
		return emitted_value("", "Void")
	end
	result := emit_temporary(context)
	if kind == 49
		qbe_output_line(output, "\t" + result + " =l call $trbn_array_join(l " + first + ", l " + operands[instruction.second] + ")")
	elsif kind == 46
		qbe_output_line(output, "\t" + result + " =l call $trbn_string_slice(l " + first + ", l " + operands[instruction.second] + ")")
	elsif kind == 45
		if instruction.payload == 2
			qbe_output_line(output, "\t" + result + " =l call $trbn_string_reverse(l " + first + ")")
		else
			qbe_output_line(output, "\t" + result + " =l call $trbn_string_sequence(l " + first + ", l " + integer_string(instruction.payload) + ")")
		end
	elsif kind == 44
		qbe_output_line(output, "\t" + result + " =l call $trbn_string_query(l " + first + ", l " + operands[instruction.second] + ", l " + integer_string(instruction.payload) + ")")
	elsif kind == 15
		address := emit_temporary(context)
		qbe_output_line(output, "\t" + address + " =l add " + first + ", 16")
		qbe_output_line(output, "\t" + result + " =l loadl " + address)
	elsif kind == 17
		output.runtime_flags[1] = 1
		mut conversion := "$trbn_integer_to_string(l "
		if instruction.payload == 2
			conversion = "$trbn_string_to_integer(l "
		elsif instruction.payload == 3
			conversion = "$trbn_float_to_integer(d "
		end
		qbe_output_line(output, "\t" + result + " =l call " + conversion + first + ")")
	else
		mut runtime := "$trbn_string_concat"
		if kind == 14
			runtime = "$trbn_string_equal"
		elsif kind == 16
			runtime = "$trbn_string_index"
		end
		qbe_output_line(output, "\t" + result + " =l call " + runtime + "(l " + first + ", l " + operands[instruction.second] + ")")
		if kind == 14 && instruction.payload == 1
			inverted := emit_temporary(context)
			qbe_output_line(output, "\t" + inverted + " =l ceql " + result + ", 0")
			return emitted_value(inverted, result_type)
		end
	end
	return emitted_value(result, result_type)
end

# String headers retain byte length and code-point count separately. UTF-8
# decoding is bounded by byte length; ordinary index bounds are checked by MIR
# lowering/runtime before converting the code-point position to a byte offset.
def emit_utf8_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction l $trbn_utf8_width(l %data, l %remaining) {\n@start\n %first =w loadub %data\n %low =w cultw %first, 194\n %high =w cugtw %first, 244\n %invalid =w or %low, %high\n jnz %invalid, @one, @classify\n@classify\n %two =w cultw %first, 224\n jnz %two, @two, @longer\n@two\n %two_short =w csltl %remaining, 2\n jnz %two_short, @one, @two_tail\n@two_tail\n %two_address =l add %data, 1\n %two_byte =w loadub %two_address\n %two_low =w cultw %two_byte, 128\n %two_high =w cugtw %two_byte, 191\n %two_bad =w or %two_low, %two_high\n jnz %two_bad, @one, @two_valid\n@two_valid\n ret 2\n@longer\n %three =w cultw %first, 240\n jnz %three, @three, @four\n@three\n %three_short =w csltl %remaining, 3\n jnz %three_short, @one, @three_tail\n@three_tail\n %three_a =l add %data, 1\n %three_b =l add %data, 2\n %second3 =w loadub %three_a\n %third3 =w loadub %three_b\n %second3_low =w cultw %second3, 128\n %second3_high =w cugtw %second3, 191\n %third3_low =w cultw %third3, 128\n %third3_high =w cugtw %third3, 191\n %second3_bad =w or %second3_low, %second3_high\n %third3_bad =w or %third3_low, %third3_high\n %tail3_bad =w or %second3_bad, %third3_bad\n %e0 =w ceqw %first, 224\n %overlong3 =w cultw %second3, 160\n %bad_e0 =w and %e0, %overlong3\n %ed =w ceqw %first, 237\n %surrogate =w cugtw %second3, 159\n %bad_ed =w and %ed, %surrogate\n %range3_bad =w or %bad_e0, %bad_ed\n %three_bad =w or %tail3_bad, %range3_bad\n jnz %three_bad, @one, @three_valid\n@three_valid\n ret 3\n@four\n %four_short =w csltl %remaining, 4\n jnz %four_short, @one, @four_tail\n@four_tail\n %four_a =l add %data, 1\n %four_b =l add %data, 2\n %four_c =l add %data, 3\n %second4 =w loadub %four_a\n %third4 =w loadub %four_b\n %fourth4 =w loadub %four_c\n %second4_low =w cultw %second4, 128\n %second4_high =w cugtw %second4, 191\n %third4_low =w cultw %third4, 128\n %third4_high =w cugtw %third4, 191\n %fourth4_low =w cultw %fourth4, 128\n %fourth4_high =w cugtw %fourth4, 191\n %second4_bad =w or %second4_low, %second4_high\n %third4_bad =w or %third4_low, %third4_high\n %fourth4_bad =w or %fourth4_low, %fourth4_high\n %middle4_bad =w or %second4_bad, %third4_bad\n %tail4_bad =w or %middle4_bad, %fourth4_bad\n %f0 =w ceqw %first, 240\n %overlong4 =w cultw %second4, 144\n %bad_f0 =w and %f0, %overlong4\n %f4 =w ceqw %first, 244\n %too_large =w cugtw %second4, 143\n %bad_f4 =w and %f4, %too_large\n %range4_bad =w or %bad_f0, %bad_f4\n %four_bad =w or %tail4_bad, %range4_bad\n jnz %four_bad, @one, @four_valid\n@four_valid\n ret 4\n@one\n ret 1\n}")
	qbe_output_line(output, "\nfunction l $trbn_utf8_count(l %data, l %length) {\n@start\n jmp @loop\n@loop\n %offset =l phi @start 0, @advance %next\n %count =l phi @start 0, @advance %next_count\n %done =w cslel %length, %offset\n jnz %done, @finish, @read\n@read\n %address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %next =l add %offset, %width\n %next_count =l add %count, 1\n jmp @advance\n@advance\n jmp @loop\n@finish\n ret %count\n}")
	qbe_output_line(output, "\nfunction l $trbn_utf8_span(l %data, l %length, l %requested) {\n@start\n jmp @loop\n@loop\n %offset =l phi @start 0, @advance %next\n %count =l phi @start 0, @advance %next_count\n %done =w cslel %requested, %count\n jnz %done, @finish, @read\n@read\n %address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %next =l add %offset, %width\n %next_count =l add %count, 1\n jmp @advance\n@advance\n jmp @loop\n@finish\n ret %offset\n}")
	qbe_output_line(output, "\nfunction l $trbn_string_offset(l %string, l %index) {\n@start\n %length_address =l add %string, 8\n %points_address =l add %string, 16\n %length =l loadl %length_address\n %points =l loadl %points_address\n %ascii =w ceql %length, %points\n jnz %ascii, @ascii, @unicode\n@ascii\n ret %index\n@unicode\n %data =l add %string, 24\n %offset =l call $trbn_utf8_span(l %data, l %length, l %index)\n ret %offset\n}")
	qbe_output_line(output, "\nfunction l $trbn_utf8_scalar(l %data, l %remaining) {\n@start\n %first_word =w loadub %data\n %first =l extuw %first_word\n %ascii =w csltl %first, 128\n jnz %ascii, @ascii, @unicode\n@ascii\n ret %first\n@unicode\n %width =l call $trbn_utf8_width(l %data, l %remaining)\n %invalid =w ceql %width, 1\n jnz %invalid, @invalid, @initialize\n@invalid\n ret 65533\n@initialize\n %shift =l sub 7, %width\n %mask_high =l shl 1, %shift\n %mask =l sub %mask_high, 1\n %initial =l and %first, %mask\n jmp @loop\n@loop\n %index =l phi @initialize 1, @advance %next\n %point =l phi @initialize %initial, @advance %next_point\n %done =w cslel %width, %index\n jnz %done, @finish, @read\n@read\n %address =l add %data, %index\n %byte_word =w loadub %address\n %byte =l extuw %byte_word\n %payload =l and %byte, 63\n %scaled =l shl %point, 6\n %next_point =l or %scaled, %payload\n %next =l add %index, 1\n jmp @advance\n@advance\n jmp @loop\n@finish\n ret %point\n}")
	qbe_output_line(output, "\nfunction l $trbn_string_from_codepoint(l %requested) {\n@start\n %negative =w csltl %requested, 0\n %large =w csgtl %requested, 1114111\n %surrogate_low =w csgel %requested, 55296\n %surrogate_high =w cslel %requested, 57343\n %surrogate =w and %surrogate_low, %surrogate_high\n %out =w or %negative, %large\n %invalid =w or %out, %surrogate\n jnz %invalid, @replacement, @valid\n@replacement\n jmp @classify\n@valid\n jmp @classify\n@classify\n %point =l phi @replacement 65533, @valid %requested\n %ascii =w csltl %point, 128\n jnz %ascii, @one, @multi\n@one\n jmp @allocate\n@multi\n %two =w csltl %point, 2048\n jnz %two, @two, @longer\n@two\n jmp @allocate\n@longer\n %three =w csltl %point, 65536\n jnz %three, @three, @four\n@three\n jmp @allocate\n@four\n jmp @allocate\n@allocate\n %width =l phi @one 1, @two 2, @three 3, @four 4\n %size =l add %width, 17\n %result =l call $trbn_string_alloc(l %size)\n %length_address =l add %result, 8\n storel %width, %length_address\n %points_address =l add %result, 16\n storel 1, %points_address\n %data =l add %result, 24\n %terminator =l add %data, %width\n storeb 0, %terminator\n jnz %ascii, @ascii_byte, @tail\n@ascii_byte\n storeb %point, %data\n ret %result\n@tail\n %last =l sub %width, 1\n jmp @loop\n@loop\n %index =l phi @tail %last, @write %previous\n %remaining_point =l phi @tail %point, @write %next_point\n %done =w ceql %index, 0\n jnz %done, @head, @write\n@write\n %low =l and %remaining_point, 63\n %byte =l or %low, 128\n %address =l add %data, %index\n storeb %byte, %address\n %next_point =l shr %remaining_point, 6\n %previous =l sub %index, 1\n jmp @loop\n@head\n %head_shift =l sub 8, %width\n %head_bits =l shl 255, %head_shift\n %first =l or %head_bits, %remaining_point\n storeb %first, %data\n ret %result\n}")
	qbe_output_line(output, "\nfunction l $trbn_string_bytes(l %string) {\n@start\n %length_address =l add %string, 8\n %length =l loadl %length_address\n %data =l add %string, 24\n %array =l call $trbn_array_new(l $trbn_desc_array_scalar)\n jmp @loop\n@loop\n %index =l phi @start 0, @advance %next\n %done =w cslel %length, %index\n jnz %done, @finish, @read\n@read\n %address =l add %data, %index\n %byte_word =w loadub %address\n %byte =l extuw %byte_word\n call $trbn_array_push(l %array, l %byte)\n %next =l add %index, 1\n jmp @advance\n@advance\n jmp @loop\n@finish\n ret %array\n}")
	qbe_output_line(output, "\nfunction l $trbn_string_is_utf8(l %string) {\n@start\n %length_address =l add %string, 8\n %length =l loadl %length_address\n %data =l add %string, 24\n jmp @loop\n@loop\n %offset =l phi @start 0, @advance %next\n %done =w cslel %length, %offset\n jnz %done, @valid, @read\n@read\n %address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %byte =w loadub %address\n %nonascii =w cugtw %byte, 127\n %single =w ceql %width, 1\n %bad =w and %nonascii, %single\n jnz %bad, @invalid, @advance\n@advance\n %next =l add %offset, %width\n jmp @loop\n@valid\n ret 1\n@invalid\n ret 0\n}")
	return
end
