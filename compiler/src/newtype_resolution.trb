import { NewtypeDefinition } from newtype_model
import { find_newtype_type } from newtype_types
import { namespace_parent } from namespace_model
import { find_declaration_in_module } from declaration_lookup
import { find_enum_type } from enum_types
import { callable_parts } from callable_types
import { hash_key_type, hash_value_type } from hash_types
import { nullable_element } from nullable_types
import { union_parts } from union_types
import { array_element_type, find_record_type, resolve_type_name } from type_resolution
import { CompilerState, diagnostic, has_diagnostic } from state
import { load_integer, load_string } from storage

# Representation expansion may traverse containers, but a record/enum is a
# distinct stored value and permits recursive fields through its identity.
def newtype_representation_cycle(state: CompilerState, type_name: String, visiting: Array<Integer>): Boolean
	owner := find_newtype_type(state, type_name)
	if owner >= 0
		visiting.each do |current|
			if current == owner
				return true
			end
		end
		mut path: Array<Integer> := []
		visiting.each do |current|
			path.push(current)
		end
		path.push(owner)
		return newtype_representation_cycle(state, state.newtypes[owner].representation, path)
	end
	mut parts := union_parts(type_name)
	if nullable_element(type_name) != ""
		parts.push(nullable_element(type_name))
	elsif array_element_type(type_name) != ""
		parts.push(array_element_type(type_name))
	elsif hash_key_type(type_name) != ""
		parts.push(hash_value_type(type_name))
	else
		callable_parts(type_name).each do |part|
			parts.push(part)
		end
	end
	parts.each do |part|
		if newtype_representation_cycle(state, part, visiting)
			return true
		end
	end
	return false
end

def immutable_newtype_representation(state: CompilerState, type_name: String, visiting: Array<String>): Boolean
	if type_name == "Integer" || type_name == "Float" || type_name == "Boolean" || type_name == "String" || type_name == "Nil" || type_name == "Range<Integer>"
		return true
	end
	if nullable_element(type_name) != ""
		return immutable_newtype_representation(state, nullable_element(type_name), visiting)
	end
	parts := union_parts(type_name)
	if parts.size() > 0
		parts.each do |part|
			if !immutable_newtype_representation(state, part, visiting)
				return false
			end
		end
		return true
	end
	visiting.each do |current|
		if current == type_name
			return true
		end
	end
	mut path: Array<String> := []
	visiting.each do |current|
		path.push(current)
	end
	path.push(type_name)
	mut immutable := false
	owner := find_newtype_type(state, type_name)
	record_index := find_record_type(state, type_name)
	enum_index := find_enum_type(state, type_name)
	if owner >= 0
		immutable = immutable_newtype_representation(state, state.newtypes[owner].representation, path)
	elsif record_index >= 0
		immutable = true
		mut field := load_integer(state.record_field_starts, record_index)
		finish := field + load_integer(state.record_field_counts, record_index)
		while field < finish
			if !immutable_newtype_representation(state, load_string(state.field_types, field), path)
				immutable = false
			end
			field += 1
		end
	elsif enum_index >= 0
		immutable = true
		definition := state.enums[enum_index]
		mut variant := definition.variant_start
		while variant < definition.variant_start + definition.variant_count
			row := state.enum_variants[variant]
			mut field := row.field_start
			while field < row.field_start + row.field_count
				if !immutable_newtype_representation(state, state.enum_fields[field].type_name, path)
					immutable = false
				end
				field += 1
			end
			variant += 1
		end
	end
	return immutable
end

def resolve_newtype_declarations(mut state: CompilerState): Boolean
	mut owner := 0
	while owner < state.newtypes.size()
		row := state.newtypes[owner]
		state.active_module[0] = row.source_id
		state.declaration_owner[0] = namespace_parent(row.name)
		mut kind := 0
		while kind < 8
			if find_declaration_in_module(state, row.source_id, row.name, kind) >= 0
				diagnostic(state, "TRBN4003", row.line, "duplicate declaration " + row.name)
			end
			kind += 1
		end
		mut previous := 0
		while previous < owner
			other := state.newtypes[previous]
			if other.source_id == row.source_id && other.name == row.name
				diagnostic(state, "TRBN4003", row.line, "duplicate newtype declaration " + row.name)
			end
			previous += 1
		end
		representation := resolve_type_name(state, row.source_id, row.target, false)
		if representation == "" || representation == "Nil" || representation == "Hash" || nullable_element(representation) != ""
			diagnostic(state, "TRBN4003", row.line, "newtype requires a concrete nonnullable representation")
		end
		state.newtypes[owner] = NewtypeDefinition.new(name: row.name, source_id: row.source_id, line: row.line, target: row.target, representation: representation, closed: row.closed)
		owner += 1
	end
	state.newtypes.each do |row|
		state.active_module[0] = row.source_id
		if newtype_representation_cycle(state, row.representation, [])
			diagnostic(state, "TRBN4003", row.line, "newtype representation cycle involving " + row.name)
		end
	end
	return !has_diagnostic(state)
end

def validate_closed_newtypes(mut state: CompilerState): Boolean
	state.newtypes.each do |row|
		if row.closed && !immutable_newtype_representation(state, row.representation, [])
			state.active_module[0] = row.source_id
			diagnostic(state, "TRBN4003", row.line, "closed newtype requires a recursively immutable representation")
		end
	end
	return !has_diagnostic(state)
end
