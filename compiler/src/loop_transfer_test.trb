import { describe, expect, test } from trb/std/test
import { gate4_check, gate4_emit_qbe, gate4_lex } from compiler
import { gate4_parse_module } from parser
import { gate4_resolve } from resolution
import { gate4_compiler_new, gate4_has_diagnostic } from state
import { gate4_load_integer, gate4_load_string, gate4_store_integer } from storage
import { MirLoopTransfer, mir_loop_transfer_valid } from mir

describe("Checked loop transfers") do
	test("verifies named source and nearest-loop bindings") do
		plan := MirLoopTransfer.new(kind: 1, origin: 8, target: 3)
		expect(mir_loop_transfer_valid(plan, 8, 1, 3, 20)).to_be_true()
		expect(mir_loop_transfer_valid(plan, 9, 1, 3, 20)).to_be_false()
		expect(mir_loop_transfer_valid(plan, 8, 2, 3, 20)).to_be_false()
		expect(mir_loop_transfer_valid(plan, 8, 1, 2, 20)).to_be_false()
		expect(mir_loop_transfer_valid(plan, 8, 1, 3, 8)).to_be_false()
		expect(mir_loop_transfer_valid(MirLoopTransfer.new(kind: 0, origin: 8, target: 3), 8, 0, 3, 20)).to_be_false()
		expect(mir_loop_transfer_valid(MirLoopTransfer.new(kind: 2, origin: 8, target: - 1), 8, 2, - 1, 20)).to_be_false()
		expect(mir_loop_transfer_valid(MirLoopTransfer.new(kind: 2, origin: 8, target: 8), 8, 2, 8, 20)).to_be_false()
	end

	test("rejects missing malformed and cross-loop plans before emission") do
		source := "def main()\nwhile true\nwhile true\nbreak\nend\nbreak\nend\nend\n"
		mut mode := 0
		while mode < 6
			mut state := gate4_compiler_new(source.size() + 1)
			expect(gate4_lex(state, source)).to_be_true()
			expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(gate4_resolve(state)).to_be_true()
			expect(gate4_check(state)).to_be_true()
			mut origin := 0
			mut outer := 0
			while gate4_load_string(state.token_texts, origin) != "while"
				origin += 1
			end
			outer = origin
			while gate4_load_string(state.token_texts, origin) != "break"
				origin += 1
			end
			if mode == 0
				gate4_store_integer(state.loop_transfer_kinds, origin, 0)
			elsif mode == 1
				gate4_store_integer(state.loop_transfer_kinds, origin, 2)
			elsif mode == 2
				gate4_store_integer(state.loop_transfer_targets, origin, 0)
			elsif mode == 3
				gate4_store_integer(state.loop_transfer_targets, origin, outer + 1)
			elsif mode == 4
				gate4_store_integer(state.loop_transfer_targets, origin, state.token_count[0] + 1)
			else
				gate4_store_integer(state.loop_transfer_targets, origin, - 9007199254740991)
			end
			gate4_emit_qbe(state)
			expect(gate4_has_diagnostic(state)).to_be_true()
			expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("invalid checked loop transfer target")
			mode += 1
		end
	end

	test("checks unreachable transfers and resets targets between functions") do
		sources := [
			"def main()\nreturn\nbreak\nend\n",
			"def main()\nif false\nnext\nend\nend\n",
			"def first()\nwhile true\nbreak\nend\nend\ndef main()\nnext\nend\n",
		]
		mut index := 0
		while index < sources.size()
			source := sources[index]
			mut state := gate4_compiler_new(source.size() + 1)
			expect(gate4_lex(state, source)).to_be_true()
			expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(gate4_resolve(state)).to_be_true()
			expect(gate4_check(state)).to_be_false()
			expect(gate4_load_string(state.diagnostic_messages, 0).include?("is only valid inside a loop")).to_be_true()
			index += 1
		end
	end

	test("invalidates induction facts when an update is skipped") do
		source := "def main()\nmut values := [1]\nmut index := 0\nwhile index < values.size()\nputs(values[index])\nnext\nindex += 1\nend\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		mut origin := 0
		while gate4_load_string(state.token_texts, origin) != "while"
			origin += 1
		end
		expect(gate4_load_integer(state.mir_nonnegative_facts, origin)).to_equal(0)
		gate4_emit_qbe(state)
		expect(gate4_has_diagnostic(state)).to_be_false()
	end
end
