import { CheckedLambda, callable_parts } from callable_types
import { CheckedValue, checked_value } from checked_values
import { integer_string } from literals
import { mir_binding_capture } from mir_bindings
import { mir_add_parameter } from mir_builder
import { mir_checked_closure } from mir_callables
import { nullable_fact } from nullable_flow
import { CheckedLocals, CompilerState, diagnostic, local_bind_identity, local_slot } from state
import { load_integer, sparse_integer_at, store_integer, store_string } from storage
import { array_type } from type_resolution

# Only analysis appends declarations. The complete catalog is frozen before
# signatures, standard adapters or any executable body are emitted.
def declare_lambda(mut state: CompilerState, mut lambda: CheckedLambda)
	function := state.function_count[0]
	start := state.parameter_count[0]
	syntax := state.lambdas[sparse_integer_at(state.lambda_origins, lambda.origin) - 1]
	parts := callable_parts(lambda.type_name)
	lambda.function[0] = function
	state.checked_lambdas.push(lambda)
	store_integer(state.function_lambdas, function, state.checked_lambdas.size())
	store_string(state.function_names, function, "$lambda" + integer_string(function))
	store_integer(state.function_modules, function, state.module_graph.active_module[0])
	store_integer(state.function_parameter_starts, function, start)
	store_integer(state.function_parameter_counts, function, lambda.captures.size() + syntax.parameters.size())
	store_string(state.function_result_types, function, parts[0])
	store_integer(state.function_body_starts, function, syntax.body_start)
	store_integer(state.function_body_ends, function, syntax.body_finish)
	store_integer(state.function_lines, function, load_integer(state.token_lines, lambda.origin))
	store_integer(state.function_generic_bindings, function, state.checked_bodies[lambda.body].generic_binding[0])
	store_integer(state.checked_body_indices, function, lambda.body + 1)
	lambda.captures.each do |capture|
		index := state.parameter_count[0]
		mut storage := capture.type_name
		if capture.mutable > 0
			storage = array_type(storage)
		end
		store_string(state.parameter_names, index, capture.name)
		store_string(state.parameter_types, index, storage)
		store_integer(state.parameter_mutable, index, capture.mutable)
		store_integer(state.parameter_lines, index, load_integer(state.token_lines, lambda.origin))
		state.parameter_count[0] += 1
	end
	mut parameter := 0
	while parameter < syntax.parameters.size()
		row := syntax.parameters[parameter]
		index := state.parameter_count[0]
		store_string(state.parameter_names, index, row.name)
		store_string(state.parameter_types, index, parts[parameter + 1])
		store_integer(state.parameter_mutable, index, row.mutable)
		store_integer(state.parameter_lines, index, load_integer(state.token_lines, row.origin))
		state.parameter_count[0] += 1
		parameter += 1
	end
	state.function_count[0] += 1
end

# Adopt captured cells rather than boxing them again. The sparse identity prefix
# preserves nested captures and shared-binding plans independently of ABI slots.
def lambda_bind_captures(mut state: CompilerState, mut locals: CheckedLocals, function: Integer): Integer
	encoded := sparse_integer_at(state.function_lambdas, function)
	if encoded == 0
		return 0
	end
	lambda := state.checked_lambdas[encoded - 1]
	while locals.binding_slots.size() < lambda.inherited_count
		locals.binding_slots.push(- 1)
	end
	locals.lambda_result.push(callable_parts(lambda.type_name)[0])
	start := load_integer(state.function_parameter_starts, function)
	mut parameter := 0
	lambda.captures.each do |capture|
		slot := local_bind_identity(locals, capture.name, capture.type_name, capture.mutable, capture.child_identity)
		locals.capture_parents.push(capture.identity)
		locals.capture_uses.push(0)
		mir_add_parameter(state, locals, start + parameter)
		if capture.mutable > 0
			store_string(locals.mir_cell_types, slot, array_type(capture.type_name))
			store_integer(locals.mir_cell_plans, capture.child_identity, 1)
		elsif capture.flow_type != capture.type_name
			locals.nullable_state[0] = nullable_fact(locals, slot, - 1, capture.flow_type, locals.nullable_state[0])
		end
		parameter += 1
	end
	return parameter
end

def lower_lambda(mut state: CompilerState, mut locals: CheckedLocals, origin: Integer): CheckedValue
	state.checked[0].lambdas.each do |lambda|
		if lambda.origin == origin
			mut captures: Array<Integer> := []
			lambda.captures.each do |capture|
				slot := local_slot(locals, capture.identity)
				if slot >= 0
					store_integer(locals.binding_use_counts, slot, sparse_integer_at(locals.binding_use_counts, slot) + 1)
				end
			end
			if locals.mir_state[0] == 1
				lambda.captures.each do |capture|
					captures.push(mir_binding_capture(state, locals, capture, origin))
				end
			end
			if locals.mir_state[0] != 1
				return checked_value(lambda.type_name, 0, origin, 0)
			end
			return mir_checked_closure(state, locals, lambda.function[0], captures, origin)
		end
	end
	diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "fn has no analyzed body")
	return checked_value("Invalid", 0, origin, 0)
end
