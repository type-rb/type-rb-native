import { integer_string } from literals
import { MirInstruction } from mir
import { QbeEmitContext, QbeValue, emit_temporary, emitted_value } from qbe_context
import { QbeOutput, qbe_output_line } from qbe_output
import { CompilerState } from state

# Allocation identity comes solely from the verified MIR object catalog.
def emit_mir_object_instruction(instruction: MirInstruction, mut context: QbeEmitContext, mut output: QbeOutput): QbeValue
	result := emit_temporary(context)
	qbe_output_line(output, "\t" + result + " =l call $trbn_gc_alloc(l $trbn_desc_object" + integer_string(instruction.payload) + ", l 0, l 0)")
	return emitted_value(result, "Address")
end

def emit_object_descriptors(state: CompilerState, mut output: QbeOutput)
	state.scalar_mir.objects.each do |definition|
		if !definition.interface_type && definition.fields.size() == 0 && definition.superclass == - 1
			qbe_output_line(output, "data $trbn_desc_object" + integer_string(definition.declaration) + " = align 8 { l 1, l 0, l 0 }")
		end
	end
end
