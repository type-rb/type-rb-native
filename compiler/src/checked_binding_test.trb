import { gate4_check, gate4_lex } from compiler
import { gate4_compiler_new } from state
import { gate4_load_string } from storage
import { gate4_parse_module } from parser
import { gate4_resolve } from resolution
import { describe, expect, test } from trb/std/test

describe("Checked readonly reference bindings") do
	test("rejects capability upgrades from direct immutable bindings") do
		sources := [
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: Sample): Integer\n\tmut copy := input\n\treturn copy.value\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: Sample): Integer\n\tmut copy: Sample := ((input))\n\treturn copy.value\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(): Integer\n\tinput := Sample.new(value: 1)\n\tmut copy := input\n\treturn copy.value\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: Array<Integer>): Integer\n\tmut copy := input\n\treturn copy.size()\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(): Integer\n\tinput := [1]\n\tmut copy := (input)\n\treturn copy.size()\nend\n\ndef main()\n\treturn\nend\n",
		]
		mut index := 0
		while index < sources.size()
			source := sources[index]
			mut state := gate4_compiler_new(source.size() + 1)
			expect(gate4_lex(state, source)).to_be_true()
			expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(gate4_resolve(state)).to_be_true()
			expect(gate4_check(state)).to_be_false()
			expect(gate4_load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
			expect(gate4_load_string(state.diagnostic_messages, 0)).to_equal("cannot initialize mutable copy from an immutable value")
			index += 1
		end
	end

	test("preserves mutable, fresh, scalar and shallow nested values") do
		sources := [
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(mut input: Sample): Integer\n\tmut copy := input\n\treturn copy.value\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(): Integer\n\tmut input := Sample.new(value: 1)\n\tmut copy := input\n\treturn copy.value\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(mut input: Array<Integer>): Integer\n\tmut copy := input\n\treturn copy.size()\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: Box): Integer\n\tmut copy := input.item\n\treturn copy.value\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: Box): Integer\n\tmut copy := input.values\n\treturn copy.size()\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: Array<Array<Integer>>): Integer\n\tmut copy := input[0]\n\treturn copy.size()\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: Integer): Integer\n\tmut copy := input\n\treturn copy\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(input: String): String\n\tmut copy := input\n\treturn copy\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(): Integer\n\tmut copy := make_sample()\n\treturn copy.value\nend\n\ndef main()\n\treturn\nend\n",
			"record Sample\n\tvalue: Integer\nend\n\nrecord Box\n\titem: Sample\n\tvalues: Array<Integer>\nend\n\ndef make_sample(): Sample\n\treturn Sample.new(value: 1)\nend\n\ndef make_values(): Array<Integer>\n\treturn [1]\nend\n\ndef probe(): Integer\n\tmut copy := make_values()\n\treturn copy.size()\nend\n\ndef main()\n\treturn\nend\n",
		]
		mut index := 0
		while index < sources.size()
			source := sources[index]
			mut state := gate4_compiler_new(source.size() + 1)
			expect(gate4_lex(state, source)).to_be_true()
			expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(gate4_resolve(state)).to_be_true()
			expect(gate4_check(state)).to_be_true()
			index += 1
		end
	end

end
