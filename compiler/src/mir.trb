import { MirObject, MirObjectMethod, MirObjectWitness } from object_model
import { MirNewtype } from newtype_model
import { EnumDefinition, EnumVariant } from enum_model
record MirLoopTransfer
	kind: Integer
	origin: Integer
	target: Integer
end

# Kinds 1/2 transfer to the nearest while exit/header respectively. Targets
# and origins belong to the checked source projection, not backend labels.
def mir_loop_transfer_valid(plan: MirLoopTransfer, origin: Integer, kind: Integer, target: Integer, token_count: Integer): Boolean
	if plan.kind != 1
		if plan.kind != 2
			return false
		end
	end
	if plan.kind != kind
		return false
	end
	if plan.origin != origin
		return false
	end
	if plan.target != target
		return false
	end
	if target < 0
		return false
	end
	if target >= origin
		return false
	end
	return origin < token_count
end

record MirInstruction
	kind: Integer
	result: Integer
	first: Integer
	second: Integer
	payload: Integer
	failure: Integer
	source_id: Integer
	line: Integer
end

def mir_instruction_with_payload(instruction: MirInstruction, payload: Integer): MirInstruction
	return MirInstruction.new(
		kind: instruction.kind,
		result: instruction.result,
		first: instruction.first,
		second: instruction.second,
		payload: payload,
		failure: instruction.failure,
		source_id: instruction.source_id,
		line: instruction.line,
	)
end

record MirBlock
	id: Integer
	source_id: Integer
	line: Integer
	parameter_start: Integer
	parameter_count: Integer
	instruction_start: Integer
	instruction_count: Integer
	terminator: Integer
	condition: Integer
	first_target: Integer
	second_target: Integer
	first_argument_start: Integer
	first_argument_count: Integer
	second_argument_start: Integer
	second_argument_count: Integer
	return_value: Integer
end

record MirControlLoop
	origin: Integer
	header: Integer
	exit: Integer
	continuation: Integer
	binding_count: Integer
	exit_binding_count: Integer
end

record MirFunction
	# 0: independent MIR fixture; 1: scalar leaf; 3: general typed control flow.
	# The retired positional induction adapter (2) is invalid.
	kind: Integer
	result_type: String
	integer_guard: Integer
	id: Integer
	entry_block: Integer
	source_id: Integer
	line: Integer
	parameter_start: Integer
	parameter_count: Integer
	block_start: Integer
	block_count: Integer
end

record MirValue
	function_id: Integer
	id: Integer
	type_id: Integer
	source_id: Integer
	line: Integer
end

# Header reuse and checked-index elimination for one verified natural loop.
record MirArrayLoop
	header: Integer
	preheader: Integer
	owner: Integer
	length: Integer
	loads: Array<Integer>
end

# Derived safe-point plans contain only values demanded by future operations.
# Each row corresponds to one instruction index; roots are sorted value IDs.
record MirRootPlan
	function_id: Integer
	instructions: Array<Integer>
	roots: Array<Array<Integer>>
	capacity: Integer
end

# Instructions name their opcode, result, operands, opcode-specific payload,
# failure target and origin. Verified rewrites replace whole readonly records.
# Array regions retain parameter, access, and effect operations.
# The verifier derives their plans; input facts remain empty.
# Array loop plans are derived from CFG edges and SSA value identities.
# Verification re-derives them before header reuse or check elimination.
record MirSignature
	id: Integer
	# 0: ordinary declaration; 1: compiler runtime; 2: host; 3: standard API.
	kind: Integer
	name: String
	# 0 ordinary, 1..8 compiler runtime, 9 host, 10 argv, 11 sqrt.
	adapter: Integer
	source_id: Integer
	line: Integer
	parameter_types: Array<String>
	parameter_mutable: Array<Integer>
	result_type: String
end

record MirCall
	callee: Integer
	argument_start: Integer
	argument_count: Integer
	# Conservative ordinary call effects: allocation, mutation, I/O, failure.
	effects: Integer
end

# Target-independent checked arithmetic selection. Mode 1 retains both bounds
# (or the zero-divisor check), 2/3 prove a small right/left addend, and 4/5
# select the guarded add/multiply adapters. A call plan owns its cloned leaf
# operations; ordinary plans have caller and call_instruction equal to -1.
record MirNumericOperation
	instruction: Integer
	mode: Integer
end

record MirNumericPlan
	function_id: Integer
	caller: Integer
	call_instruction: Integer
	operations: Array<MirNumericOperation>
end

# Composite values retain semantic element identity independently of ABI layout.
# Primitive and low-level Array/address types keep IDs 1..8; these rows start at ID 9.
record MirType
	# 1 Array, 2 record, 3 Hash, 4 Range, 5 empty Hash, 6 nullable, 7 Nil,
	# 8 enum, 9 callable, 10 union, 11 newtype, 12 literal, 13 class, 14 interface.
	kind: Integer
	name: String
	element: Integer
	key: Integer
	declaration: Integer
end

record MirRecord
	declaration: Integer
	type_id: Integer
	name: String
	source_id: Integer
	line: Integer
	field_start: Integer
	field_count: Integer
end

record MirField
	owner: Integer
	name: String
	type_id: Integer
	source_id: Integer
	line: Integer
end

record MirIndexedTarget
	origin: Integer
	owner: Integer
	index: Integer
end

record MirCallable
	type_id: Integer
	parameters: Array<Integer>
	result: Integer
end

# A global has one initializer and a checked mutation capability.
# Initialization order and persistent roots are part of the verified module.
record MirGlobal
	mutable: Boolean
	id: Integer
	name: String
	source_id: Integer
	line: Integer
	type_id: Integer
	initializer: Integer
	managed: Boolean
end

record MirUnion
	type_id: Integer
	alternatives: Array<Integer>
end

record MirModule
	object_methods: Array<MirObjectMethod>
	object_witnesses: Array<MirObjectWitness>
	objects: Array<MirObject>
	newtypes: Array<MirNewtype>
	unions: Array<MirUnion>
	globals: Array<MirGlobal>
	global_initialization: Array<Integer>
	callables: Array<MirCallable>
	enums: Array<EnumDefinition>
	enum_variants: Array<EnumVariant>
	enum_fields: Array<MirField>
	numeric_plans: Array<Array<MirNumericPlan>>
	types: Array<MirType>
	records: Array<MirRecord>
	fields: Array<MirField>
	root_plans: Array<MirRootPlan>
	array_loops: Array<Array<MirArrayLoop>>
	signatures: Array<MirSignature>
	calls: Array<MirCall>
	source_count: Array<Integer>
	entry_function: Array<Integer>
	functions: Array<MirFunction>
	blocks: Array<MirBlock>
	values: Array<MirValue>
	instructions: Array<MirInstruction>
	arguments: Array<Integer>
	literal_texts: Array<String>
end

def mir_table_span_valid(start: Integer, count: Integer, size: Integer): Boolean
	if start >= 0
		if count >= 0
			if start <= size
				return count <= size - start
			end
		end
	end
	return false
end

# Bounded structured Boolean plans. These describe a conditional RHS region,
# not an eager binary instruction. The source-indexed checked plan retains its
# origin in the existing projection; adapters must validate that binding.
def mir_logical_plan(operator_id: Integer, left: String, right: String): Integer
	if left == "Boolean"
		if right == "Boolean"
			if operator_id == 12
				return 76
			end
			if operator_id == 13
				return 77
			end
		end
	end
	return 0
end

def mir_logical_short_value(plan: Integer): Integer
	if plan == 76
		return 1
	end
	if plan == 77
		return 0
	end
	return - 1
end

def mir_origin_valid(source: Integer, line: Integer, source_count: Integer): Boolean
	if source >= 0
		if source < source_count
			return line > 0
		end
	end
	return false
end

def mir_function_index(native_module: MirModule, function_id: Integer): Integer
	native_module.functions.each.with_index do |row, index|
		if row.id == function_id
			return index
		end
	end
	return - 1
end

def mir_block_index(
		native_module: MirModule,
		function: MirFunction,
		block_id: Integer,
	): Integer
	mut index := function.block_start
	finish := index + function.block_count
	while index < finish
		if native_module.blocks[index].id == block_id
			return index
		end
		index += 1
	end
	return - 1
end

def mir_value_index(
		native_module: MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	mut index := 0
	while index < native_module.values.size()
		row := native_module.values[index]
		if row.function_id == function_id
			if row.id == value_id
				return index
			end
		end
		index += 1
	end
	return - 1
end

def mir_value_type(
		native_module: MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	index := mir_value_index(native_module, function_id, value_id)
	if index < 0
		return 0
	end
	return native_module.values[index].type_id
end

def mir_array_element_type(type_id: Integer): Integer
	if type_id == 3
		return 1
	end
	if type_id == 6
		return 5
	end
	return 0
end

def mir_argument_contains(
		native_module: MirModule,
		start: Integer,
		count: Integer,
		value_id: Integer,
	): Boolean
	mut index := start
	finish := start + count
	while index < finish
		if native_module.arguments[index] == value_id
			return true
		end
		index += 1
	end
	return false
end

def mir_failure_error(
		native_module: MirModule,
		function: MirFunction,
		failure: Integer,
	): String
	block_index := mir_block_index(native_module, function, failure)
	if block_index < 0
		return "MIR failure target does not exist"
	end
	if native_module.blocks[block_index].terminator != 4
		return "MIR failure target is not a trap block"
	end
	block := native_module.blocks[block_index]
	if block.parameter_count != 0 || block.instruction_count != 0
		return "MIR failure target must be an empty trap"
	end
	return ""
end

def mir_type_id(type_name: String): Integer
	if type_name == "String"
		return 8
	end
	if type_name == "Integer"
		return 1
	end
	if type_name == "Boolean"
		return 2
	end
	if type_name == "Float"
		return 5
	end
	if type_name == "Array<Integer>"
		return 3
	end
	if type_name == "Array<Float>"
		return 6
	end
	if type_name == "Address"
		return 4
	end
	return 0
end

def mir_type_name(type_id: Integer): String
	if type_id == 8
		return "String"
	end
	if type_id == 0
		return "Void"
	end
	if type_id == 1
		return "Integer"
	end
	if type_id == 2
		return "Boolean"
	end
	if type_id == 5
		return "Float"
	end
	if type_id == 3
		return "Array<Integer>"
	end
	if type_id == 6
		return "Array<Float>"
	end
	if type_id == 4
		return "Address"
	end
	return "Invalid"
end

# Portable value kinds admitted by the general control adapter. String retains
# its language identity; pointer width/layout is chosen only by backend lowering.
def mir_control_value_type(type_id: Integer): Boolean
	if type_id == 1 || type_id == 2 || type_id == 5
		return true
	end
	return type_id == 8
end
