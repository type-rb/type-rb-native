import { gate4_float_literal_in_range, gate4_integer_literal_in_range, gate4_number_is_float, gate4_small_nonnegative_integer_operand } from literals

record MirLoopTransfer
	kind: Integer
	origin: Integer
	target: Integer
end

# Kinds 1/2 transfer to the nearest while exit/header respectively. Targets
# and origins belong to the checked source projection, not backend labels.
def mir_loop_transfer_valid(plan: MirLoopTransfer, origin: Integer, kind: Integer, target: Integer, token_count: Integer): Boolean
	if plan.kind != 1
		if plan.kind != 2
			return false
		end
	end
	if plan.kind != kind
		return false
	end
	if plan.origin != origin
		return false
	end
	if plan.target != target
		return false
	end
	if target < 0
		return false
	end
	if target >= origin
		return false
	end
	return origin < token_count
end

record Gate4MirArrayOperation
	kind: Integer
	operand: Integer
	origin: Integer
end

record Gate4MirInstruction
	kind: Integer
	result: Integer
	first: Integer
	second: Integer
	payload: Integer
	failure: Integer
	source_id: Integer
	line: Integer
end

def gate4_mir_instruction_with_payload(instruction: Gate4MirInstruction, payload: Integer): Gate4MirInstruction
	return Gate4MirInstruction.new(
		kind: instruction.kind,
		result: instruction.result,
		first: instruction.first,
		second: instruction.second,
		payload: payload,
		failure: instruction.failure,
		source_id: instruction.source_id,
		line: instruction.line,
	)
end

record Gate4MirBlock
	id: Integer
	source_id: Integer
	line: Integer
	parameter_start: Integer
	parameter_count: Integer
	instruction_start: Integer
	instruction_count: Integer
	terminator: Integer
	condition: Integer
	first_target: Integer
	second_target: Integer
	first_argument_start: Integer
	first_argument_count: Integer
	second_argument_start: Integer
	second_argument_count: Integer
	return_value: Integer
end

record Gate4MirFunction
	id: Integer
	entry_block: Integer
	source_id: Integer
	line: Integer
	parameter_start: Integer
	parameter_count: Integer
	block_start: Integer
	block_count: Integer
end

record Gate4MirValue
	function_id: Integer
	id: Integer
	type_id: Integer
	source_id: Integer
	line: Integer
end

# Instructions name their opcode, result, operands, opcode-specific payload,
# failure target and origin. Verified rewrites replace whole readonly records.
# Array regions retain parameter, access, and effect operations.
# The verifier derives their plans; input facts remain empty.
# A verified pass may mark the complete Array induction plan as optimized
# (kind 5, mode 2). The verifier re-derives the loop proof before a backend may
# consume its invariant header and redundant-check decisions.
record Gate4MirModule
	source_count: Array<Integer>
	entry_function: Array<Integer>
	functions: Array<Gate4MirFunction>
	blocks: Array<Gate4MirBlock>
	values: Array<Gate4MirValue>
	instructions: Array<Gate4MirInstruction>
	arguments: Array<Integer>
	array_regions: Array<Array<Gate4MirArrayOperation>>
	facts: Array<Integer>
	literal_texts: Array<String>
end

def gate4_mir_range_valid(start: Integer, count: Integer, size: Integer): Boolean
	if start >= 0
		if count >= 0
			if start <= size
				return count <= size - start
			end
		end
	end
	return false
end

# Bounded structured Boolean plans. These describe a conditional RHS region,
# not an eager binary instruction. The source-indexed checked plan retains its
# origin in the existing projection; adapters must validate that binding.
def mir_logical_plan(operator_id: Integer, left: String, right: String): Integer
	if left == "Boolean"
		if right == "Boolean"
			if operator_id == 12
				return 76
			end
			if operator_id == 13
				return 77
			end
		end
	end
	return 0
end

def mir_logical_short_value(plan: Integer): Integer
	if plan == 76
		return 1
	end
	if plan == 77
		return 0
	end
	return - 1
end

def gate4_mir_origin_valid(source: Integer, line: Integer, source_count: Integer): Boolean
	if source >= 0
		if source < source_count
			return line > 0
		end
	end
	return false
end

def gate4_mir_function_index(native_module: Gate4MirModule, function_id: Integer): Integer
	mut index := 0
	while index < native_module.functions.size()
		row := native_module.functions[index]
		if row.id == function_id
			return index
		end
		index += 1
	end
	return - 1
end

def gate4_mir_block_index(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		block_id: Integer,
	): Integer
	mut index := function.block_start
	finish := index + function.block_count
	while index < finish
		if native_module.blocks[index].id == block_id
			return index
		end
		index += 1
	end
	return - 1
end

def gate4_mir_value_index(
		native_module: Gate4MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	mut index := 0
	while index < native_module.values.size()
		row := native_module.values[index]
		if row.function_id == function_id
			if row.id == value_id
				return index
			end
		end
		index += 1
	end
	return - 1
end

def gate4_mir_value_type(
		native_module: Gate4MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	index := gate4_mir_value_index(native_module, function_id, value_id)
	if index < 0
		return 0
	end
	return native_module.values[index].type_id
end

def gate4_mir_array_element_type(type_id: Integer): Integer
	if type_id == 3
		return 1
	end
	if type_id == 6
		return 5
	end
	return 0
end

def gate4_mir_argument_contains(
		native_module: Gate4MirModule,
		start: Integer,
		count: Integer,
		value_id: Integer,
	): Boolean
	mut index := start
	finish := start + count
	while index < finish
		if native_module.arguments[index] == value_id
			return true
		end
		index += 1
	end
	return false
end

def gate4_mir_value_available(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		block: Gate4MirBlock,
		instruction_finish: Integer,
		value_id: Integer,
	): Boolean
	if gate4_mir_argument_contains(native_module, function.parameter_start, function.parameter_count, value_id)
		return true
	end
	if gate4_mir_argument_contains(native_module, block.parameter_start, block.parameter_count, value_id)
		return true
	end
	mut index := block.instruction_start
	while index < instruction_finish
		if native_module.instructions[index].result == value_id
			return true
		end
		index += 1
	end
	return false
end

def gate4_mir_definition_count(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		value_id: Integer,
	): Integer
	mut count := 0
	mut index := function.parameter_start
	mut finish := index + function.parameter_count
	while index < finish
		if native_module.arguments[index] == value_id
			count += 1
		end
		index += 1
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		index = block.parameter_start
		finish = index + block.parameter_count
		while index < finish
			if native_module.arguments[index] == value_id
				count += 1
			end
			index += 1
		end
		index = block.instruction_start
		finish = index + block.instruction_count
		while index < finish
			if native_module.instructions[index].result == value_id
				count += 1
			end
			index += 1
		end
		block_index += 1
	end
	return count
end

def gate4_mir_failure_error(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		failure: Integer,
	): String
	block_index := gate4_mir_block_index(native_module, function, failure)
	if block_index < 0
		return "MIR failure target does not exist"
	end
	if native_module.blocks[block_index].terminator != 4
		return "MIR failure target is not a trap block"
	end
	return ""
end

def gate4_mir_exact_integer_literal(
		native_module: Gate4MirModule,
		instruction: Gate4MirInstruction,
		text: String,
	): Boolean
	if instruction.kind != 6
		return false
	end
	literal := instruction.payload
	if literal < 0
		return false
	end
	if literal >= native_module.literal_texts.size()
		return false
	end
	return native_module.literal_texts[literal] == text
end

def gate4_mir_induction_address(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		block: Gate4MirBlock,
		instruction: Gate4MirInstruction,
	): Boolean
	if function.block_count != 6
		return false
	end
	if function.parameter_count != 1
		return false
	end
	array_type := gate4_mir_value_type(native_module, function.id, native_module.arguments[function.parameter_start])
	if gate4_mir_array_element_type(array_type) == 0
		return false
	end
	entry := native_module.blocks[function.block_start]
	header := native_module.blocks[function.block_start + 1]
	body := native_module.blocks[function.block_start + 2]
	exit := native_module.blocks[function.block_start + 3]
	if block.id != body.id
		return false
	end
	if entry.terminator != 1
		return false
	end
	if header.terminator != 2
		return false
	end
	if body.terminator != 1
		return false
	end
	if entry.first_target != header.id
		return false
	end
	if header.first_target != body.id
		return false
	end
	if header.second_target != exit.id
		return false
	end
	if body.first_target != header.id
		return false
	end
	if header.parameter_count < 1
		return false
	end
	if header.parameter_count > 2
		return false
	end
	if body.parameter_count != header.parameter_count
		return false
	end
	header_value := native_module.arguments[header.parameter_start]
	body_value := native_module.arguments[body.parameter_start]
	if instruction.second != body_value
		return false
	end
	if native_module.arguments[header.first_argument_start] != header_value
		return false
	end
	if entry.instruction_count != header.parameter_count
		return false
	end
	if header.instruction_count != 2
		return false
	end
	if body.instruction_count != header.parameter_count + 3
		return false
	end
	zero := native_module.instructions[entry.instruction_start]
	if !gate4_mir_exact_integer_literal(native_module, zero, "0")
		return false
	end
	if native_module.arguments[entry.first_argument_start] != zero.result
		return false
	end
	length := native_module.instructions[header.instruction_start]
	comparison := native_module.instructions[header.instruction_start + 1]
	if length.kind != 4
		return false
	end
	if comparison.kind != 7
		return false
	end
	if comparison.payload != 8
		return false
	end
	if comparison.first != header_value
		return false
	end
	if comparison.second != length.result
		return false
	end
	if header.condition != comparison.result
		return false
	end
	load := native_module.instructions[body.instruction_start + 1]
	if load.kind != 10
		return false
	end
	if load.first != instruction.result
		return false
	end
	one := native_module.instructions[body.instruction_start + body.instruction_count - 2]
	add := native_module.instructions[body.instruction_start + body.instruction_count - 1]
	if !gate4_mir_exact_integer_literal(native_module, one, "1")
		return false
	end
	if add.kind != 7
		return false
	end
	if add.payload != 1
		if add.payload != 13
			return false
		end
	end
	if add.first != body_value
		return false
	end
	if add.second != one.result
		return false
	end
	if native_module.arguments[body.first_argument_start] != add.result
		return false
	end
	if header.parameter_count == 1
		return true
	end
	if entry.first_argument_count != 2
		return false
	end
	if header.first_argument_count != 2
		return false
	end
	if header.second_argument_count != 1
		return false
	end
	if body.first_argument_count != 2
		return false
	end
	if exit.parameter_count != 1
		return false
	end
	if !gate4_mir_range_valid(exit.parameter_start, 1, native_module.arguments.size())
		return false
	end
	accumulator_zero := native_module.instructions[entry.instruction_start + 1]
	mut zero_literal := "0"
	if array_type == 6
		zero_literal = "0.0"
	end
	if !gate4_mir_exact_integer_literal(native_module, accumulator_zero, zero_literal)
		return false
	end
	header_accumulator := native_module.arguments[header.parameter_start + 1]
	body_accumulator := native_module.arguments[body.parameter_start + 1]
	exit_accumulator := native_module.arguments[exit.parameter_start]
	if native_module.arguments[entry.first_argument_start + 1] != accumulator_zero.result
		return false
	end
	if native_module.arguments[header.first_argument_start + 1] != header_accumulator
		return false
	end
	if native_module.arguments[header.second_argument_start] != header_accumulator
		return false
	end
	reduction := native_module.instructions[body.instruction_start + 2]
	if reduction.kind != 7
		return false
	end
	if reduction.payload != 1
		if reduction.payload != 13
			return false
		end
	end
	if reduction.first != body_accumulator
		return false
	end
	if reduction.second != load.result
		return false
	end
	if native_module.arguments[body.first_argument_start + 1] != reduction.result
		return false
	end
	if exit.return_value != exit_accumulator
		return false
	end
	return true
end

# A raw parameter-header region uses named operations:
# 1 parameter (type, origin): type 0 scalar, 1 immutable Array, 2 mutable
# Array. Parameters are an ordered prefix; their operation position is their ordinal.
# Parameter origins are declaration-table indexes; other origins are tokens.
# 4 parameter Array access (ordinal, origin);
# 6 opaque effect/control (0, origin).
# The result is a parameter ordinal, -1 for no reusable header, or -2 for
# malformed MIR. Parameters dominate every use and never leave lexical scope;
# this proof owns neither local aliases nor removal of any access check.
def gate4_mir_array_header(operations: Array<Gate4MirArrayOperation>): Integer
	mut parameter_count := 0
	mut parameter_origin :=- 1
	mut selected :=- 1
	mut blocked := false
	mut index := 0
	while index < operations.size()
		operation := operations[index]
		kind := operation.kind
		slot := operation.operand
		origin := operation.origin
		if origin < 0
			return - 2
		end
		if slot < 0
			return - 2
		end
		if kind == 1
			if index != parameter_count
				return - 2
			end
			if slot > 2
				return - 2
			end
			if origin <= parameter_origin
				return - 2
			end
			parameter_origin = origin
			parameter_count += 1
		else
			if kind == 4
				if slot >= parameter_count
					return - 2
				end
				binding_type := operations[slot].operand
				if binding_type == 0
					return - 2
				end
				if binding_type == 1
					if selected == - 1
						selected = slot
					end
				end
			else
				if kind != 6
					return - 2
				end
				if slot != 0
					return - 2
				end
				blocked = true
			end
		end
		index += 1
	end
	if blocked
		return - 1
	end
	return selected
end

def gate4_optimize_verified_mir(mut native_module: Gate4MirModule)
	mut index := 0
	while index < native_module.instructions.size()
		instruction := native_module.instructions[index]
		mut payload := instruction.payload
		if instruction.kind == 5
			if payload == 1
				payload = 2
			end
		end
		if instruction.kind == 7
			if instruction.failure >= 0
				if payload == 1
					payload = 13
				elsif payload == 3
					payload = 12
				end
			end
		end
		if payload != instruction.payload
			native_module.instructions[index] = gate4_mir_instruction_with_payload(instruction, payload)
		end
		index += 1
	end
	index = 0
	while index < native_module.array_regions.size()
		header := gate4_mir_array_header(native_module.array_regions[index])
		if header < - 1
			return
		end
		if native_module.facts.size() == index
			native_module.facts.push(header)
		else
			native_module.facts[index] = header
		end
		index += 1
	end
	return
end

def gate4_mir_instruction_error(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		block: Gate4MirBlock,
		instruction_index: Integer,
	): String
	instruction := native_module.instructions[instruction_index]
	if !gate4_mir_origin_valid(instruction.source_id, instruction.line, native_module.source_count[0])
		return "MIR instruction origin is invalid"
	end
	function_id := function.id
	result_type := gate4_mir_value_type(native_module, function_id, instruction.result)
	first_type := gate4_mir_value_type(native_module, function_id, instruction.first)
	second_type := gate4_mir_value_type(native_module, function_id, instruction.second)
	first_available := gate4_mir_value_available(
		native_module,
		function,
		block,
		instruction_index,
		instruction.first,
	)
	second_available := gate4_mir_value_available(
		native_module,
		function,
		block,
		instruction_index,
		instruction.second,
	)
	if instruction.kind == 1
		if result_type != 1
			return "MIR Integer constant result type differs"
		end
		if instruction.first == - 1
			if instruction.second == - 1
				if instruction.failure == - 1
					return ""
				end
			end
		end
		return "MIR Integer constant shape differs"
	end
	if instruction.kind == 2
		if instruction.payload != 0
			return "MIR checked Integer add shape differs"
		end
		if result_type == 1
			if first_available
				if first_type == 1
					if second_available
						if second_type == 1
							return gate4_mir_failure_error(native_module, function, instruction.failure)
						end
					end
				end
			end
		end
		return "MIR checked Integer add type differs"
	end
	if instruction.kind == 3
		if instruction.payload == 0
			if instruction.failure == - 1
				if result_type == 2
					if first_available
						if first_type == 1
							if second_available
								if second_type == 1
									return ""
								end
							end
						end
					end
				end
				return "MIR Integer comparison type differs"
			end
		end
		return "MIR Integer comparison shape differs"
	end
	if instruction.kind == 4
		if instruction.second == - 1
			if instruction.payload == 0
				if instruction.failure == - 1
					if result_type == 1
						if first_available
							if gate4_mir_array_element_type(first_type) > 0
								return ""
							end
						end
					end
					return "MIR Array length type differs"
				end
			end
		end
		return "MIR Array length shape differs"
	end
	if instruction.kind == 5
		if instruction.payload < 0
			return "MIR Array address shape differs"
		end
		if instruction.payload > 2
			return "MIR Array address shape differs"
		end
		if result_type == first_type + 1
			if first_available
				if gate4_mir_array_element_type(first_type) > 0
					if second_available
						if second_type == 1
							error := gate4_mir_failure_error(native_module, function, instruction.failure)
							if error != ""
								return error
							end
							if instruction.payload >= 1
								if !gate4_mir_induction_address(native_module, function, block, instruction)
									return "MIR Array induction proof differs"
								end
							end
							return ""
						end
					end
				end
			end
		end
		return "MIR Array address type differs"
	end
	if instruction.kind == 6
		if instruction.first < 0
			return "MIR scalar literal shape differs"
		end
		if instruction.first > 1
			return "MIR scalar literal shape differs"
		end
		if instruction.second != - 1
			return "MIR scalar literal shape differs"
		end
		if instruction.failure != - 1
			return "MIR scalar literal shape differs"
		end
		if instruction.payload < 0
			return "MIR scalar literal index is invalid"
		end
		if instruction.payload >= native_module.literal_texts.size()
			return "MIR scalar literal index is invalid"
		end
		literal := native_module.literal_texts[instruction.payload]
		if result_type == 1
			if !gate4_number_is_float(literal)
				if gate4_integer_literal_in_range(literal)
					mut expected_fact := 0
					if gate4_small_nonnegative_integer_operand(literal)
						expected_fact = 1
					end
					if instruction.first == expected_fact
						return ""
					end
					return "MIR Integer literal fact differs"
				end
			end
			return "MIR Integer literal is invalid"
		end
		if result_type == 2
			if instruction.first != 0
				return "MIR Boolean literal fact differs"
			end
			if literal == "true"
				return ""
			end
			if literal == "false"
				return ""
			end
			return "MIR Boolean literal is invalid"
		end
		if result_type == 5
			if instruction.first != 0
				return "MIR Float literal fact differs"
			end
			if gate4_number_is_float(literal)
				if gate4_float_literal_in_range(literal)
					return ""
				end
			end
			return "MIR Float literal is invalid"
		end
		return "MIR scalar literal result type differs"
	end
	if instruction.kind == 7
		if !first_available
			return "MIR scalar binary operand is undefined"
		end
		if !second_available
			return "MIR scalar binary operand is undefined"
		end
		mut operator := instruction.payload
		if operator == 12
			operator = 3
		end
		if operator == 13
			operator = 1
		end
		mut numeric := false
		if first_type == 1
			if second_type == 1
				numeric = true
			end
			if second_type == 5
				numeric = true
			end
		end
		if first_type == 5
			if second_type == 1
				numeric = true
			end
			if second_type == 5
				numeric = true
			end
		end
		mut valid := false
		mut checked := false
		if operator >= 1
			if operator <= 4
				if numeric
					mut expected := 1
					if first_type == 5
						expected = 5
					end
					if second_type == 5
						expected = 5
					end
					valid = result_type == expected
					checked = expected == 1
				end
			else
				if operator == 5
					valid = first_type == 1
					if valid
						valid = second_type == 1
					end
					if valid
						valid = result_type == 1
					end
					checked = valid
				else
					if operator <= 11
						if result_type == 2
							if operator <= 7
								valid = numeric
								if !valid
									valid = first_type == second_type
								end
							else
								valid = numeric
							end
						end
					end
				end
			end
		end
		if !valid
			return "MIR scalar binary type differs"
		end
		if checked
			return gate4_mir_failure_error(native_module, function, instruction.failure)
		end
		if instruction.failure != - 1
			return "MIR scalar binary failure shape differs"
		end
		return ""
	end
	if instruction.kind == 8
		if instruction.second != - 1
			return "MIR scalar unary shape differs"
		end
		if instruction.failure != - 1
			return "MIR scalar unary shape differs"
		end
		if !first_available
			return "MIR scalar unary operand is undefined"
		end
		if instruction.payload == 1
			if first_type == 2
				if result_type == 2
					return ""
				end
			end
		else
			if instruction.payload == 2
				if first_type == result_type
					if result_type == 1
						return ""
					end
					if result_type == 5
						return ""
					end
				end
			end
			if instruction.payload == 3
				if first_type == result_type
					if result_type == 1
						return ""
					end
					if result_type == 5
						return ""
					end
				end
			end
		end
		return "MIR scalar unary type differs"
	end
	if instruction.kind == 9
		if instruction.second == - 1
			if instruction.payload == 0
				if instruction.failure == - 1
					if first_available
						if first_type == 1
							if result_type == 5
								return ""
							end
						end
					end
				end
			end
		end
		return "MIR Integer-to-Float conversion type differs"
	end
	if instruction.kind == 10
		if instruction.second == - 1
			if instruction.payload == 0
				if instruction.failure == - 1
					if first_available
						if result_type == gate4_mir_array_element_type(first_type - 1)
							return ""
						end
					end
				end
			end
		end
		return "MIR Array load type differs"
	end
	return "MIR instruction kind is unsupported"
end

def gate4_mir_target_arguments_error(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		block: Gate4MirBlock,
		target: Integer,
		start: Integer,
		count: Integer,
	): String
	target_index := gate4_mir_block_index(native_module, function, target)
	if target_index < 0
		return "MIR terminator target does not exist"
	end
	target_block := native_module.blocks[target_index]
	if count != target_block.parameter_count
		return "MIR block argument arity differs"
	end
	mut index := 0
	while index < count
		value_id := native_module.arguments[start + index]
		if !gate4_mir_value_available(
				native_module,
				function,
				block,
				block.instruction_start + block.instruction_count,
				value_id,
			)
			return "MIR block argument is undefined"
		end
		target_value := native_module.arguments[target_block.parameter_start + index]
		actual_type := gate4_mir_value_type(native_module, function.id, value_id)
		target_type := gate4_mir_value_type(native_module, function.id, target_value)
		if actual_type != target_type
			return "MIR block argument type differs"
		end
		index += 1
	end
	return ""
end

def gate4_mir_terminator_error(
		native_module: Gate4MirModule,
		function: Gate4MirFunction,
		block: Gate4MirBlock,
	): String
	kind := block.terminator
	if kind == 1
		if block.condition == - 1
			if block.second_target == - 1
				if block.second_argument_count == 0
					if block.return_value == - 1
						return gate4_mir_target_arguments_error(
							native_module,
							function,
							block,
							block.first_target,
							block.first_argument_start,
							block.first_argument_count,
						)
					end
				end
			end
		end
		return "MIR jump shape differs"
	end
	if kind == 2
		condition_type := gate4_mir_value_type(native_module, function.id, block.condition)
		condition_available := gate4_mir_value_available(
			native_module,
			function,
			block,
			block.instruction_start + block.instruction_count,
			block.condition,
		)
		if condition_available
			if condition_type == 2
				if block.return_value == - 1
					first := gate4_mir_target_arguments_error(
						native_module,
						function,
						block,
						block.first_target,
						block.first_argument_start,
						block.first_argument_count,
					)
					if first != ""
						return first
					end
					return gate4_mir_target_arguments_error(
						native_module,
						function,
						block,
						block.second_target,
						block.second_argument_start,
						block.second_argument_count,
					)
				end
			end
		end
		return "MIR branch shape differs"
	end
	if kind == 3
		if block.condition == - 1
			if block.first_target == - 1
				if block.second_target == - 1
					if block.first_argument_count == 0
						if block.second_argument_count == 0
							if block.return_value >= 0
								if !gate4_mir_value_available(
										native_module,
										function,
										block,
										block.instruction_start + block.instruction_count,
										block.return_value,
									)
									return "MIR return value is undefined"
								end
							end
							return ""
						end
					end
				end
			end
		end
		return "MIR return shape differs"
	end
	if kind == 4
		if block.condition == - 1
			if block.first_target == - 1
				if block.second_target == - 1
					if block.first_argument_start == 0
						if block.first_argument_count == 0
							if block.second_argument_start == 0
								if block.second_argument_count == 0
									if block.return_value == - 1
										return ""
									end
								end
							end
						end
					end
				end
			end
		end
		return "MIR trap shape differs"
	end
	return "MIR terminator kind is unsupported"
end

# Validate storage before definition counting or cross-block semantic checks.
# Range checks use subtraction so malformed large counts cannot overflow.
def gate4_mir_function_structure_error(native_module: Gate4MirModule, function: Gate4MirFunction): String
	if !gate4_mir_range_valid(function.parameter_start, function.parameter_count, native_module.arguments.size())
		return "MIR function parameter range is invalid"
	end
	if !gate4_mir_range_valid(function.block_start, function.block_count, native_module.blocks.size())
		return "MIR function block range is invalid"
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		if !gate4_mir_range_valid(block.parameter_start, block.parameter_count, native_module.arguments.size())
			return "MIR block parameter range is invalid"
		end
		if !gate4_mir_range_valid(block.instruction_start, block.instruction_count, native_module.instructions.size())
			return "MIR block instruction range is invalid"
		end
		if !gate4_mir_range_valid(block.first_argument_start, block.first_argument_count, native_module.arguments.size())
			return "MIR terminator argument range is invalid"
		end
		if !gate4_mir_range_valid(block.second_argument_start, block.second_argument_count, native_module.arguments.size())
			return "MIR alternate argument range is invalid"
		end
		block_index += 1
	end
	return ""
end

def gate4_mir_function_error(native_module: Gate4MirModule, function: Gate4MirFunction): String
	if gate4_mir_block_index(native_module, function, function.entry_block) < 0
		return "MIR function entry block does not exist"
	end
	mut index := function.parameter_start
	mut finish := index + function.parameter_count
	while index < finish
		if gate4_mir_value_type(native_module, function.id, native_module.arguments[index]) == 0
			return "MIR function parameter is undefined"
		end
		index += 1
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		if !gate4_mir_origin_valid(block.source_id, block.line, native_module.source_count[0])
			return "MIR block origin is invalid"
		end
		mut previous := function.block_start
		while previous < block_index
			if native_module.blocks[previous].id == block.id
				return "MIR block identifier is duplicated"
			end
			previous += 1
		end
		index = block.parameter_start
		finish = index + block.parameter_count
		while index < finish
			if gate4_mir_value_type(native_module, function.id, native_module.arguments[index]) == 0
				return "MIR block parameter is undefined"
			end
			index += 1
		end
		index = block.instruction_start
		finish = index + block.instruction_count
		while index < finish
			error := gate4_mir_instruction_error(native_module, function, block, index)
			if error != ""
				return error
			end
			index += 1
		end
		error := gate4_mir_terminator_error(native_module, function, block)
		if error != ""
			return error
		end
		block_index += 1
	end
	return ""
end

def gate4_verify_mir(native_module: Gate4MirModule, optimized: Boolean): String
	if native_module.source_count[0] <= 0
		return "MIR module has no sources"
	end
	mut entry_found := false
	mut index := 0
	if optimized
		if native_module.facts.size() != native_module.array_regions.size()
			return "MIR optimized Array-header fact is invalid"
		end
	else
		if native_module.facts.size() != 0
			return "MIR input cannot supply optimization facts"
		end
	end
	while index < native_module.array_regions.size()
		header := gate4_mir_array_header(native_module.array_regions[index])
		if header < - 1
			return "MIR Array region is invalid"
		end
		if optimized
			if native_module.facts[index] != header
				return "MIR optimized Array-header fact is invalid"
			end
		end
		index += 1
	end
	if native_module.functions.size() == 0
		return ""
	end
	index = 0
	while index < native_module.functions.size()
		function := native_module.functions[index]
		if function.id < 0
			return "MIR function identifier is invalid"
		end
		if !gate4_mir_origin_valid(function.source_id, function.line, native_module.source_count[0])
			return "MIR function origin is invalid"
		end
		mut previous := 0
		while previous < index
			if native_module.functions[previous].id == function.id
				return "MIR function identifier is duplicated"
			end
			previous += 1
		end
		if function.id == native_module.entry_function[0]
			entry_found = true
		end
		error := gate4_mir_function_structure_error(native_module, function)
		if error != ""
			return error
		end
		index += 1
	end
	if !entry_found
		return "MIR entry function does not exist"
	end
	index = 0
	while index < native_module.values.size()
		value := native_module.values[index]
		function_index := gate4_mir_function_index(native_module, value.function_id)
		if function_index < 0
			return "MIR value identity is invalid"
		end
		if value.id < 0
			return "MIR value identity is invalid"
		end
		if value.type_id < 1
			return "MIR value type is invalid"
		end
		if value.type_id > 7
			return "MIR value type is invalid"
		end
		if !gate4_mir_origin_valid(value.source_id, value.line, native_module.source_count[0])
			return "MIR value origin is invalid"
		end
		mut previous := 0
		while previous < index
			other := native_module.values[previous]
			if other.function_id == value.function_id
				if other.id == value.id
					return "MIR value is defined more than once"
				end
			end
			previous += 1
		end
		function := native_module.functions[function_index]
		if gate4_mir_definition_count(native_module, function, value.id) != 1
			return "MIR value definition count differs"
		end
		index += 1
	end
	index = 0
	while index < native_module.functions.size()
		error := gate4_mir_function_error(native_module, native_module.functions[index])
		if error != ""
			return error
		end
		index += 1
	end
	return ""
end

# A checked assignment region retains its Array owner and normalized position.
# The initial check precedes the RHS; the final store checks current storage.
def mir_array_assignment_valid(index_origin: Integer, store_origin: Integer, reverse_origin: Integer, token_count: Integer): Boolean
	if index_origin < 0
		return false
	end
	if index_origin >= store_origin
		return false
	end
	if store_origin >= token_count
		return false
	end
	return reverse_origin == index_origin
end
