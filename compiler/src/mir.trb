import { ascii_code, float_literal_in_range, number_is_float, small_nonnegative_integer_operand } from literals

record MirLoopTransfer
	kind: Integer
	origin: Integer
	target: Integer
end

# Kinds 1/2 transfer to the nearest while exit/header respectively. Targets
# and origins belong to the checked source projection, not backend labels.
def mir_loop_transfer_valid(plan: MirLoopTransfer, origin: Integer, kind: Integer, target: Integer, token_count: Integer): Boolean
	if plan.kind != 1
		if plan.kind != 2
			return false
		end
	end
	if plan.kind != kind
		return false
	end
	if plan.origin != origin
		return false
	end
	if plan.target != target
		return false
	end
	if target < 0
		return false
	end
	if target >= origin
		return false
	end
	return origin < token_count
end

record MirArrayOperation
	kind: Integer
	operand: Integer
	origin: Integer
end

record MirInstruction
	kind: Integer
	result: Integer
	first: Integer
	second: Integer
	payload: Integer
	failure: Integer
	source_id: Integer
	line: Integer
end

def mir_instruction_with_payload(instruction: MirInstruction, payload: Integer): MirInstruction
	return MirInstruction.new(
		kind: instruction.kind,
		result: instruction.result,
		first: instruction.first,
		second: instruction.second,
		payload: payload,
		failure: instruction.failure,
		source_id: instruction.source_id,
		line: instruction.line,
	)
end

record MirBlock
	id: Integer
	source_id: Integer
	line: Integer
	parameter_start: Integer
	parameter_count: Integer
	instruction_start: Integer
	instruction_count: Integer
	terminator: Integer
	condition: Integer
	first_target: Integer
	second_target: Integer
	first_argument_start: Integer
	first_argument_count: Integer
	second_argument_start: Integer
	second_argument_count: Integer
	return_value: Integer
end

record MirFunction
	integer_guard: Integer
	id: Integer
	entry_block: Integer
	source_id: Integer
	line: Integer
	parameter_start: Integer
	parameter_count: Integer
	block_start: Integer
	block_count: Integer
end

record MirValue
	function_id: Integer
	id: Integer
	type_id: Integer
	source_id: Integer
	line: Integer
end

# Instructions name their opcode, result, operands, opcode-specific payload,
# failure target and origin. Verified rewrites replace whole readonly records.
# Array regions retain parameter, access, and effect operations.
# The verifier derives their plans; input facts remain empty.
# A verified pass may mark the complete Array induction plan as optimized
# (kind 5, mode 2). The verifier re-derives the loop proof before a backend may
# consume its invariant header and redundant-check decisions.
record MirModule
	source_count: Array<Integer>
	entry_function: Array<Integer>
	functions: Array<MirFunction>
	blocks: Array<MirBlock>
	values: Array<MirValue>
	instructions: Array<MirInstruction>
	arguments: Array<Integer>
	array_regions: Array<Array<MirArrayOperation>>
	array_headers: Array<Array<Integer>>
	array_loop_headers: Array<Array<Integer>>
	literal_texts: Array<String>
end

def mir_table_span_valid(start: Integer, count: Integer, size: Integer): Boolean
	if start >= 0
		if count >= 0
			if start <= size
				return count <= size - start
			end
		end
	end
	return false
end

# Bounded structured Boolean plans. These describe a conditional RHS region,
# not an eager binary instruction. The source-indexed checked plan retains its
# origin in the existing projection; adapters must validate that binding.
def mir_logical_plan(operator_id: Integer, left: String, right: String): Integer
	if left == "Boolean"
		if right == "Boolean"
			if operator_id == 12
				return 76
			end
			if operator_id == 13
				return 77
			end
		end
	end
	return 0
end

def mir_logical_short_value(plan: Integer): Integer
	if plan == 76
		return 1
	end
	if plan == 77
		return 0
	end
	return - 1
end

def mir_origin_valid(source: Integer, line: Integer, source_count: Integer): Boolean
	if source >= 0
		if source < source_count
			return line > 0
		end
	end
	return false
end

def mir_function_index(native_module: MirModule, function_id: Integer): Integer
	native_module.functions.each.with_index do |row, index|
		if row.id == function_id
			return index
		end
	end
	return - 1
end

def mir_block_index(
		native_module: MirModule,
		function: MirFunction,
		block_id: Integer,
	): Integer
	mut index := function.block_start
	finish := index + function.block_count
	while index < finish
		if native_module.blocks[index].id == block_id
			return index
		end
		index += 1
	end
	return - 1
end

def mir_value_index(
		native_module: MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	mut index := 0
	while index < native_module.values.size()
		row := native_module.values[index]
		if row.function_id == function_id
			if row.id == value_id
				return index
			end
		end
		index += 1
	end
	return - 1
end

def mir_value_type(
		native_module: MirModule,
		function_id: Integer,
		value_id: Integer,
	): Integer
	index := mir_value_index(native_module, function_id, value_id)
	if index < 0
		return 0
	end
	return native_module.values[index].type_id
end

def mir_array_element_type(type_id: Integer): Integer
	if type_id == 3
		return 1
	end
	if type_id == 6
		return 5
	end
	return 0
end

def mir_argument_contains(
		native_module: MirModule,
		start: Integer,
		count: Integer,
		value_id: Integer,
	): Boolean
	mut index := start
	finish := start + count
	while index < finish
		if native_module.arguments[index] == value_id
			return true
		end
		index += 1
	end
	return false
end

def mir_value_available(
		native_module: MirModule,
		function: MirFunction,
		block: MirBlock,
		instruction_finish: Integer,
		value_id: Integer,
	): Boolean
	if mir_argument_contains(native_module, function.parameter_start, function.parameter_count, value_id)
		return true
	end
	if mir_argument_contains(native_module, block.parameter_start, block.parameter_count, value_id)
		return true
	end
	mut index := block.instruction_start
	while index < instruction_finish
		if native_module.instructions[index].result == value_id
			return true
		end
		index += 1
	end
	return false
end

def mir_definition_count(
		native_module: MirModule,
		function: MirFunction,
		value_id: Integer,
	): Integer
	mut count := 0
	mut index := function.parameter_start
	mut finish := index + function.parameter_count
	while index < finish
		if native_module.arguments[index] == value_id
			count += 1
		end
		index += 1
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		index = block.parameter_start
		finish = index + block.parameter_count
		while index < finish
			if native_module.arguments[index] == value_id
				count += 1
			end
			index += 1
		end
		index = block.instruction_start
		finish = index + block.instruction_count
		while index < finish
			if native_module.instructions[index].result == value_id
				count += 1
			end
			index += 1
		end
		block_index += 1
	end
	return count
end

def mir_failure_error(
		native_module: MirModule,
		function: MirFunction,
		failure: Integer,
	): String
	block_index := mir_block_index(native_module, function, failure)
	if block_index < 0
		return "MIR failure target does not exist"
	end
	if native_module.blocks[block_index].terminator != 4
		return "MIR failure target is not a trap block"
	end
	return ""
end

def mir_exact_integer_literal(
		native_module: MirModule,
		instruction: MirInstruction,
		text: String,
	): Boolean
	if instruction.kind != 6
		return false
	end
	literal := instruction.payload
	if literal < 0
		return false
	end
	if literal >= native_module.literal_texts.size()
		return false
	end
	return native_module.literal_texts[literal] == text
end

def mir_induction_address(
		native_module: MirModule,
		function: MirFunction,
		block: MirBlock,
		instruction: MirInstruction,
	): Boolean
	if function.block_count != 6
		return false
	end
	if function.parameter_count != 1
		return false
	end
	array_type := mir_value_type(native_module, function.id, native_module.arguments[function.parameter_start])
	if mir_array_element_type(array_type) == 0
		return false
	end
	entry := native_module.blocks[function.block_start]
	header := native_module.blocks[function.block_start + 1]
	body := native_module.blocks[function.block_start + 2]
	exit := native_module.blocks[function.block_start + 3]
	if block.id != body.id
		return false
	end
	if entry.terminator != 1
		return false
	end
	if header.terminator != 2
		return false
	end
	if body.terminator != 1
		return false
	end
	if entry.first_target != header.id
		return false
	end
	if header.first_target != body.id
		return false
	end
	if header.second_target != exit.id
		return false
	end
	if body.first_target != header.id
		return false
	end
	if header.parameter_count < 1
		return false
	end
	if header.parameter_count > 2
		return false
	end
	if body.parameter_count != header.parameter_count
		return false
	end
	header_value := native_module.arguments[header.parameter_start]
	body_value := native_module.arguments[body.parameter_start]
	if instruction.second != body_value
		return false
	end
	if native_module.arguments[header.first_argument_start] != header_value
		return false
	end
	if entry.instruction_count != header.parameter_count
		return false
	end
	if header.instruction_count != 2
		return false
	end
	if body.instruction_count != header.parameter_count + 3
		return false
	end
	zero := native_module.instructions[entry.instruction_start]
	if !mir_exact_integer_literal(native_module, zero, "0")
		return false
	end
	if native_module.arguments[entry.first_argument_start] != zero.result
		return false
	end
	length := native_module.instructions[header.instruction_start]
	comparison := native_module.instructions[header.instruction_start + 1]
	if length.kind != 4
		return false
	end
	if comparison.kind != 7
		return false
	end
	if comparison.payload != 8
		return false
	end
	if comparison.first != header_value
		return false
	end
	if comparison.second != length.result
		return false
	end
	if header.condition != comparison.result
		return false
	end
	load := native_module.instructions[body.instruction_start + 1]
	if load.kind != 10
		return false
	end
	if load.first != instruction.result
		return false
	end
	one := native_module.instructions[body.instruction_start + body.instruction_count - 2]
	add := native_module.instructions[body.instruction_start + body.instruction_count - 1]
	if !mir_exact_integer_literal(native_module, one, "1")
		return false
	end
	if add.kind != 7
		return false
	end
	if add.payload != 1
		if add.payload != 13
			return false
		end
	end
	if add.first != body_value
		return false
	end
	if add.second != one.result
		return false
	end
	if native_module.arguments[body.first_argument_start] != add.result
		return false
	end
	if header.parameter_count == 1
		return true
	end
	if entry.first_argument_count != 2
		return false
	end
	if header.first_argument_count != 2
		return false
	end
	if header.second_argument_count != 1
		return false
	end
	if body.first_argument_count != 2
		return false
	end
	if exit.parameter_count != 1
		return false
	end
	if !mir_table_span_valid(exit.parameter_start, 1, native_module.arguments.size())
		return false
	end
	accumulator_zero := native_module.instructions[entry.instruction_start + 1]
	mut zero_literal := "0"
	if array_type == 6
		zero_literal = "0.0"
	end
	if !mir_exact_integer_literal(native_module, accumulator_zero, zero_literal)
		return false
	end
	header_accumulator := native_module.arguments[header.parameter_start + 1]
	body_accumulator := native_module.arguments[body.parameter_start + 1]
	exit_accumulator := native_module.arguments[exit.parameter_start]
	if native_module.arguments[entry.first_argument_start + 1] != accumulator_zero.result
		return false
	end
	if native_module.arguments[header.first_argument_start + 1] != header_accumulator
		return false
	end
	if native_module.arguments[header.second_argument_start] != header_accumulator
		return false
	end
	reduction := native_module.instructions[body.instruction_start + 2]
	if reduction.kind != 7
		return false
	end
	if reduction.payload != 1
		if reduction.payload != 13
			return false
		end
	end
	if reduction.first != body_accumulator
		return false
	end
	if reduction.second != load.result
		return false
	end
	if native_module.arguments[body.first_argument_start + 1] != reduction.result
		return false
	end
	if exit.return_value != exit_accumulator
		return false
	end
	return true
end

record MirArrayHeaderPlan
	declarations: Array<Integer>
	valid: Boolean
end

def mir_array_header_select(mut selected: Array<Integer>, declaration: Integer)
	mut index := 0
	while index < selected.size()
		if selected[index] == declaration
			return
		end
		index += 1
	end
	selected.push(declaration)
end

def mir_array_headers_equal(left: Array<Integer>, right: Array<Integer>): Boolean
	if left.size() != right.size()
		return false
	end
	mut index := 0
	while index < left.size()
		if left[index] != right[index]
			return false
		end
		index += 1
	end
	return true
end

def mir_invalid_array_header(): MirArrayHeaderPlan
	return MirArrayHeaderPlan.new(declarations: [], valid: false)
end

# Resolve the live lexical declaration once for both header lifetime analyses.
def mir_array_local_declaration(operations: Array<MirArrayOperation>, index: Integer): Integer
	access := operations[index]
	mut declaration := index - 1
	while declaration >= 0
		binding := operations[declaration]
		if binding.kind == 3 && access.operand >= binding.operand
			return - 1
		end
		if binding.kind == 2 && binding.operand == access.operand
			if binding.origin >= access.origin
				return - 1
			end
			return declaration
		end
		declaration -= 1
	end
	return - 1
end

# Header regions retain parameter declarations (kind 1: type 0 scalar,
# 1 immutable Array, 2 mutable Array), local Array declarations
# (2: local ordinal), scope exits (3: restored local count), parameter accesses
# (4: ordinal), local accesses (5: ordinal), and opaque barriers (6: zero).
# Conditional starts (7), elsif (8), else (9), and joins (10) carry the
# entry local count. Each arm restores that scope before its next marker.
# Loop starts (11) and exits (12) use the same stack and scope restoration.
# Parameter origins use declaration indexes; other operations use token origins.
# Selected declarations are unique operation indexes. Malformed regions
# return an invalid plan. A local's header is loaded at its declaration,
# never before its initializer. Every element access still checks bounds.
def mir_array_headers(operations: Array<MirArrayOperation>): MirArrayHeaderPlan
	mut parameter_count := 0
	mut parameter_origin :=- 1
	mut selected: Array<Integer> := []
	mut blocked := false
	mut controls: Array<MirArrayOperation> := []
	mut depth := 0
	mut control_origin :=- 1
	mut index := 0
	while index < operations.size()
		operation := operations[index]
		kind := operation.kind
		slot := operation.operand
		origin := operation.origin
		if origin < 0
			return mir_invalid_array_header()
		end
		if slot < 0
			return mir_invalid_array_header()
		end
		if kind == 1
			if index != parameter_count
				return mir_invalid_array_header()
			end
			if slot > 2
				return mir_invalid_array_header()
			end
			if origin <= parameter_origin
				return mir_invalid_array_header()
			end
			parameter_origin = origin
			parameter_count += 1
		elsif kind == 2
			if slot < parameter_count
				return mir_invalid_array_header()
			end
			if depth > 0
				if slot < controls[depth - 1].operand
					return mir_invalid_array_header()
				end
			end
		elsif kind == 3
			if slot < parameter_count
				return mir_invalid_array_header()
			end
			if depth > 0
				if slot < controls[depth - 1].operand
					return mir_invalid_array_header()
				end
			end
			mut selected_index := 0
			while selected_index < selected.size()
				binding := operations[selected[selected_index]]
				if binding.kind == 2
					if binding.operand >= slot
						blocked = true
					end
				end
				selected_index += 1
			end
		elsif kind == 4
			if slot >= parameter_count
				return mir_invalid_array_header()
			end
			binding_type := operations[slot].operand
			if binding_type == 0
				return mir_invalid_array_header()
			end
			mir_array_header_select(selected, slot)
		elsif kind == 5
			declaration := mir_array_local_declaration(operations, index)
			if declaration < parameter_count
				return mir_invalid_array_header()
			end
			mir_array_header_select(selected, declaration)
		elsif kind >= 7 && kind <= 12
			if origin <= control_origin || slot < parameter_count
				return mir_invalid_array_header()
			end
			control_origin = origin
			if kind == 7 || kind == 11
				if depth > 0
					if slot < controls[depth - 1].operand
						return mir_invalid_array_header()
					end
				end
				if depth == controls.size()
					controls.push(operation)
				else
					controls[depth] = operation
				end
				depth += 1
			else
				if depth == 0 || index == 0
					return mir_invalid_array_header()
				end
				frame := controls[depth - 1]
				exit_operation := operations[index - 1]
				if slot != frame.operand || exit_operation.kind != 3
					return mir_invalid_array_header()
				end
				if exit_operation.operand != slot || exit_operation.origin != origin
					return mir_invalid_array_header()
				end
				if (frame.kind == 11 && kind != 12) || (frame.kind != 11 && kind == 12)
					return mir_invalid_array_header()
				end
				if kind == 10 || kind == 12
					depth -= 1
				else
					if frame.kind == 9
						return mir_invalid_array_header()
					end
					controls[depth - 1] = operation
				end
			end
		else
			if kind != 6
				return mir_invalid_array_header()
			end
			if slot != 0
				return mir_invalid_array_header()
			end
			blocked = true
		end
		index += 1
	end
	if depth != 0
		return mir_invalid_array_header()
	end
	if blocked
		return MirArrayHeaderPlan.new(declarations: [], valid: true)
	end
	return MirArrayHeaderPlan.new(declarations: selected, valid: true)
end

# Consume an already verified region. Each triple names its loop start/end
# operation and one binding declaration. Prefer the outermost effect-free loop;
# all selected bindings must exist before its condition is first evaluated.
def mir_array_loop_headers(operations: Array<MirArrayOperation>): Array<Integer>
	mut plan: Array<Integer> := []
	mut start := 0
	while start < operations.size()
		if operations[start].kind == 11
			mut depth := 1
			mut finish := start + 1
			mut blocked := false
			mut selected: Array<Integer> := []
			while finish < operations.size() && depth > 0
				operation := operations[finish]
				if operation.kind == 11
					depth += 1
				elsif operation.kind == 12
					depth -= 1
				elsif operation.kind == 6
					blocked = true
				elsif operation.kind == 4 || operation.kind == 5
					mut declaration := operation.operand
					if operation.kind == 5
						declaration = mir_array_local_declaration(operations, finish)
					end
					if declaration >= 0 && declaration < start && operation.operand < operations[start].operand
						mir_array_header_select(selected, declaration)
					end
				end
				finish += 1
			end
			if !blocked
				mut index := 0
				while index < selected.size()
					plan.push(start)
					plan.push(finish - 1)
					plan.push(selected[index])
					index += 1
				end
				start = finish - 1
			end
		end
		start += 1
	end
	return plan
end

record MirScalarRange
	low: Integer
	high: Integer
end

# Parse only a nonnegative portable decimal; malformed MIR must not make
# range analysis itself fail or overflow. Underscores carry no value.
def mir_scalar_literal(text: String): Integer
	mut digits := 0
	mut value := 0
	mut index := 0
	while index < text.size()
		character := text[index]
		if character != "_"
			digit := ascii_code(character) - 48
			if digit < 0 || digit > 9
				return - 1
			end
			if value > (9007199254740991 - digit) / 10
				return - 1
			end
			digits += 1
			value = value * 10 + digit
		end
		index += 1
	end
	if digits == 0
		return - 1
	end
	return value
end

# A nonzero guard is an exclusive power-of-two bound on every Integer
# parameter. All intermediate Integer ranges must fit the portable domain.
# This bounded proof accepts only a complete straight-line scalar entry.
def mir_scalar_guard_proves(native_module: MirModule, function: MirFunction, limit: Integer): Integer
	if function.block_count != 2 || function.parameter_count < 1 || function.parameter_count > 4
		return - 1
	end
	block := native_module.blocks[function.block_start]
	if block.id != function.entry_block || block.terminator != 3 || block.instruction_count > 32
		return - 1
	end
	mut ranges: Array<MirScalarRange> := []
	mut index := 0
	while index < function.parameter_count
		value := native_module.arguments[function.parameter_start + index]
		if value != index || mir_value_type(native_module, function.id, value) != 1
			return - 1
		end
		ranges.push(MirScalarRange.new(low: 0, high: limit - 1))
		index += 1
	end
	mut checked := 0
	index = block.instruction_start
	finish := index + block.instruction_count
	while index < finish
		instruction := native_module.instructions[index]
		if instruction.result != ranges.size()
			return - 1
		end
		mut low := 0
		mut high := 0
		result_type := mir_value_type(native_module, function.id, instruction.result)
		if instruction.kind == 6
			if result_type == 1
				low = mir_scalar_literal(native_module.literal_texts[instruction.payload])
				if low < 0
					return - 1
				end
				high = low
			end
		elsif instruction.kind == 7
			if result_type == 1
				left := instruction.first
				right := instruction.second
				if left < 0 || right < 0 || left >= ranges.size() || right >= ranges.size()
					return - 1
				end
				left_range := ranges[left]
				right_range := ranges[right]
				operator := instruction.payload
				if operator == 1 || operator == 13
					if left_range.high > 9007199254740991 - right_range.high
						return 0
					end
					low = left_range.low + right_range.low
					high = left_range.high + right_range.high
				elsif operator == 3 || operator == 12
					if right_range.high > 0
						if left_range.high > 9007199254740991 / right_range.high
							return 0
						end
					end
					low = left_range.low * right_range.low
					high = left_range.high * right_range.high
				elsif operator == 4
					if right_range.low == 0
						return - 1
					end
					low = left_range.low / right_range.high
					high = left_range.high / right_range.low
				else
					return - 1
				end
				checked += 1
			end
		elsif instruction.kind != 9
			return - 1
		end
		ranges.push(MirScalarRange.new(low: low, high: high))
		index += 1
	end
	if checked < 3
		return - 1
	end
	return 1
end

def mir_scalar_guard(native_module: MirModule, function: MirFunction): Integer
	if native_module.array_regions.size() > 32
		return 0
	end
	if function.block_count != 2 || function.parameter_count < 1 || function.parameter_count > 4
		return 0
	end
	# Begin with the existing multiplication fast-path operand domain and
	# shrink the common input domain until the entire region is safe.
	mut limit := 67108864
	while limit >= 2
		proof := mir_scalar_guard_proves(native_module, function, limit)
		if proof < 0
			return 0
		elsif proof > 0
			return limit
		end
		limit = limit / 2
	end
	return 0
end

def mir_function_with_guard(function: MirFunction, guard: Integer): MirFunction
	return MirFunction.new(integer_guard: guard, id: function.id, entry_block: function.entry_block, source_id: function.source_id, line: function.line, parameter_start: function.parameter_start, parameter_count: function.parameter_count, block_start: function.block_start, block_count: function.block_count)
end

def optimize_verified_mir(mut native_module: MirModule)
	mut index := 0
	while index < native_module.instructions.size()
		instruction := native_module.instructions[index]
		mut payload := instruction.payload
		if instruction.kind == 5
			if payload == 1
				payload = 2
			end
		end
		if instruction.kind == 7
			if instruction.failure >= 0
				if payload == 1
					payload = 13
				elsif payload == 3
					payload = 12
				end
			end
		end
		if payload != instruction.payload
			native_module.instructions[index] = mir_instruction_with_payload(instruction, payload)
		end
		index += 1
	end
	index = 0
	while index < native_module.functions.size()
		function := native_module.functions[index]
		native_module.functions[index] = mir_function_with_guard(function, mir_scalar_guard(native_module, function))
		index += 1
	end
	index = 0
	while index < native_module.array_regions.size()
		header := mir_array_headers(native_module.array_regions[index])
		if !header.valid
			return
		end
		mut loops: Array<Integer> := []
		if header.declarations.size() == 0
			loops = mir_array_loop_headers(native_module.array_regions[index])
		end
		if native_module.array_loop_headers.size() == index
			native_module.array_loop_headers.push(loops)
		else
			native_module.array_loop_headers[index] = loops
		end
		if native_module.array_headers.size() == index
			native_module.array_headers.push(header.declarations)
		else
			native_module.array_headers[index] = header.declarations
		end
		index += 1
	end
	return
end

def mir_instruction_error(
		native_module: MirModule,
		function: MirFunction,
		block: MirBlock,
		instruction_index: Integer,
	): String
	instruction := native_module.instructions[instruction_index]
	if !mir_origin_valid(instruction.source_id, instruction.line, native_module.source_count[0])
		return "MIR instruction origin is invalid"
	end
	function_id := function.id
	result_type := mir_value_type(native_module, function_id, instruction.result)
	first_type := mir_value_type(native_module, function_id, instruction.first)
	second_type := mir_value_type(native_module, function_id, instruction.second)
	first_available := mir_value_available(
		native_module,
		function,
		block,
		instruction_index,
		instruction.first,
	)
	second_available := mir_value_available(
		native_module,
		function,
		block,
		instruction_index,
		instruction.second,
	)
	if instruction.kind == 1
		if result_type != 1
			return "MIR Integer constant result type differs"
		end
		if instruction.first == - 1
			if instruction.second == - 1
				if instruction.failure == - 1
					return ""
				end
			end
		end
		return "MIR Integer constant shape differs"
	end
	if instruction.kind == 2
		if instruction.payload != 0
			return "MIR checked Integer add shape differs"
		end
		if result_type == 1
			if first_available
				if first_type == 1
					if second_available
						if second_type == 1
							return mir_failure_error(native_module, function, instruction.failure)
						end
					end
				end
			end
		end
		return "MIR checked Integer add type differs"
	end
	if instruction.kind == 3
		if instruction.payload == 0
			if instruction.failure == - 1
				if result_type == 2
					if first_available
						if first_type == 1
							if second_available
								if second_type == 1
									return ""
								end
							end
						end
					end
				end
				return "MIR Integer comparison type differs"
			end
		end
		return "MIR Integer comparison shape differs"
	end
	if instruction.kind == 4
		if instruction.second == - 1
			if instruction.payload == 0
				if instruction.failure == - 1
					if result_type == 1
						if first_available
							if mir_array_element_type(first_type) > 0
								return ""
							end
						end
					end
					return "MIR Array length type differs"
				end
			end
		end
		return "MIR Array length shape differs"
	end
	if instruction.kind == 5
		if instruction.payload < 0
			return "MIR Array address shape differs"
		end
		if instruction.payload > 2
			return "MIR Array address shape differs"
		end
		if result_type == first_type + 1
			if first_available
				if mir_array_element_type(first_type) > 0
					if second_available
						if second_type == 1
							error := mir_failure_error(native_module, function, instruction.failure)
							if error != ""
								return error
							end
							if instruction.payload >= 1
								if !mir_induction_address(native_module, function, block, instruction)
									return "MIR Array induction proof differs"
								end
							end
							return ""
						end
					end
				end
			end
		end
		return "MIR Array address type differs"
	end
	if instruction.kind == 6
		if instruction.first < 0
			return "MIR scalar literal shape differs"
		end
		if instruction.first > 1
			return "MIR scalar literal shape differs"
		end
		if instruction.second != - 1
			return "MIR scalar literal shape differs"
		end
		if instruction.failure != - 1
			return "MIR scalar literal shape differs"
		end
		if instruction.payload < 0
			return "MIR scalar literal index is invalid"
		end
		if instruction.payload >= native_module.literal_texts.size()
			return "MIR scalar literal index is invalid"
		end
		literal := native_module.literal_texts[instruction.payload]
		if result_type == 1
			if !number_is_float(literal)
				if mir_scalar_literal(literal) >= 0
					mut expected_fact := 0
					if small_nonnegative_integer_operand(literal)
						expected_fact = 1
					end
					if instruction.first == expected_fact
						return ""
					end
					return "MIR Integer literal fact differs"
				end
			end
			return "MIR Integer literal is invalid"
		end
		if result_type == 2
			if instruction.first != 0
				return "MIR Boolean literal fact differs"
			end
			if literal == "true"
				return ""
			end
			if literal == "false"
				return ""
			end
			return "MIR Boolean literal is invalid"
		end
		if result_type == 5
			if instruction.first != 0
				return "MIR Float literal fact differs"
			end
			if number_is_float(literal)
				if float_literal_in_range(literal)
					return ""
				end
			end
			return "MIR Float literal is invalid"
		end
		return "MIR scalar literal result type differs"
	end
	if instruction.kind == 7
		if !first_available
			return "MIR scalar binary operand is undefined"
		end
		if !second_available
			return "MIR scalar binary operand is undefined"
		end
		mut operator := instruction.payload
		if operator == 12
			operator = 3
		end
		if operator == 13
			operator = 1
		end
		mut numeric := false
		if first_type == 1
			if second_type == 1
				numeric = true
			end
			if second_type == 5
				numeric = true
			end
		end
		if first_type == 5
			if second_type == 1
				numeric = true
			end
			if second_type == 5
				numeric = true
			end
		end
		mut valid := false
		mut checked := false
		if operator >= 1
			if operator <= 4
				if numeric
					mut expected := 1
					if first_type == 5
						expected = 5
					end
					if second_type == 5
						expected = 5
					end
					valid = result_type == expected
					checked = expected == 1
				end
			else
				if operator == 5
					valid = first_type == 1
					if valid
						valid = second_type == 1
					end
					if valid
						valid = result_type == 1
					end
					checked = valid
				else
					if operator <= 11
						if result_type == 2
							if operator <= 7
								valid = numeric
								if !valid
									valid = first_type == second_type
								end
							else
								valid = numeric
							end
						end
					end
				end
			end
		end
		if !valid
			return "MIR scalar binary type differs"
		end
		if checked
			return mir_failure_error(native_module, function, instruction.failure)
		end
		if instruction.failure != - 1
			return "MIR scalar binary failure shape differs"
		end
		return ""
	end
	if instruction.kind == 8
		if instruction.second != - 1
			return "MIR scalar unary shape differs"
		end
		if instruction.failure != - 1
			return "MIR scalar unary shape differs"
		end
		if !first_available
			return "MIR scalar unary operand is undefined"
		end
		if instruction.payload == 1
			if first_type == 2
				if result_type == 2
					return ""
				end
			end
		else
			if instruction.payload == 2
				if first_type == result_type
					if result_type == 1
						return ""
					end
					if result_type == 5
						return ""
					end
				end
			end
			if instruction.payload == 3
				if first_type == result_type
					if result_type == 1
						return ""
					end
					if result_type == 5
						return ""
					end
				end
			end
		end
		return "MIR scalar unary type differs"
	end
	if instruction.kind == 9
		if instruction.second == - 1
			if instruction.payload == 0
				if instruction.failure == - 1
					if first_available
						if first_type == 1
							if result_type == 5
								return ""
							end
						end
					end
				end
			end
		end
		return "MIR Integer-to-Float conversion type differs"
	end
	if instruction.kind == 10
		if instruction.second == - 1
			if instruction.payload == 0
				if instruction.failure == - 1
					if first_available
						if result_type == mir_array_element_type(first_type - 1)
							return ""
						end
					end
				end
			end
		end
		return "MIR Array load type differs"
	end
	return "MIR instruction kind is unsupported"
end

def mir_target_arguments_error(
		native_module: MirModule,
		function: MirFunction,
		block: MirBlock,
		target: Integer,
		start: Integer,
		count: Integer,
	): String
	target_index := mir_block_index(native_module, function, target)
	if target_index < 0
		return "MIR terminator target does not exist"
	end
	target_block := native_module.blocks[target_index]
	if count != target_block.parameter_count
		return "MIR block argument arity differs"
	end
	mut index := 0
	while index < count
		value_id := native_module.arguments[start + index]
		if !mir_value_available(
				native_module,
				function,
				block,
				block.instruction_start + block.instruction_count,
				value_id,
			)
			return "MIR block argument is undefined"
		end
		target_value := native_module.arguments[target_block.parameter_start + index]
		actual_type := mir_value_type(native_module, function.id, value_id)
		target_type := mir_value_type(native_module, function.id, target_value)
		if actual_type != target_type
			return "MIR block argument type differs"
		end
		index += 1
	end
	return ""
end

def mir_terminator_error(
		native_module: MirModule,
		function: MirFunction,
		block: MirBlock,
	): String
	kind := block.terminator
	if kind == 1
		if block.condition == - 1
			if block.second_target == - 1
				if block.second_argument_count == 0
					if block.return_value == - 1
						return mir_target_arguments_error(
							native_module,
							function,
							block,
							block.first_target,
							block.first_argument_start,
							block.first_argument_count,
						)
					end
				end
			end
		end
		return "MIR jump shape differs"
	end
	if kind == 2
		condition_type := mir_value_type(native_module, function.id, block.condition)
		condition_available := mir_value_available(
			native_module,
			function,
			block,
			block.instruction_start + block.instruction_count,
			block.condition,
		)
		if condition_available
			if condition_type == 2
				if block.return_value == - 1
					first := mir_target_arguments_error(
						native_module,
						function,
						block,
						block.first_target,
						block.first_argument_start,
						block.first_argument_count,
					)
					if first != ""
						return first
					end
					return mir_target_arguments_error(
						native_module,
						function,
						block,
						block.second_target,
						block.second_argument_start,
						block.second_argument_count,
					)
				end
			end
		end
		return "MIR branch shape differs"
	end
	if kind == 3
		if block.condition == - 1
			if block.first_target == - 1
				if block.second_target == - 1
					if block.first_argument_count == 0
						if block.second_argument_count == 0
							if block.return_value >= 0
								if !mir_value_available(
										native_module,
										function,
										block,
										block.instruction_start + block.instruction_count,
										block.return_value,
									)
									return "MIR return value is undefined"
								end
							end
							return ""
						end
					end
				end
			end
		end
		return "MIR return shape differs"
	end
	if kind == 4
		if block.condition == - 1
			if block.first_target == - 1
				if block.second_target == - 1
					if block.first_argument_start == 0
						if block.first_argument_count == 0
							if block.second_argument_start == 0
								if block.second_argument_count == 0
									if block.return_value == - 1
										return ""
									end
								end
							end
						end
					end
				end
			end
		end
		return "MIR trap shape differs"
	end
	return "MIR terminator kind is unsupported"
end

# Validate storage before definition counting or cross-block semantic checks.
# Range checks use subtraction so malformed large counts cannot overflow.
def mir_function_structure_error(native_module: MirModule, function: MirFunction): String
	if !mir_table_span_valid(function.parameter_start, function.parameter_count, native_module.arguments.size())
		return "MIR function parameter range is invalid"
	end
	if !mir_table_span_valid(function.block_start, function.block_count, native_module.blocks.size())
		return "MIR function block range is invalid"
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		if !mir_table_span_valid(block.parameter_start, block.parameter_count, native_module.arguments.size())
			return "MIR block parameter range is invalid"
		end
		if !mir_table_span_valid(block.instruction_start, block.instruction_count, native_module.instructions.size())
			return "MIR block instruction range is invalid"
		end
		if !mir_table_span_valid(block.first_argument_start, block.first_argument_count, native_module.arguments.size())
			return "MIR terminator argument range is invalid"
		end
		if !mir_table_span_valid(block.second_argument_start, block.second_argument_count, native_module.arguments.size())
			return "MIR alternate argument range is invalid"
		end
		block_index += 1
	end
	return ""
end

def mir_function_error(native_module: MirModule, function: MirFunction): String
	if mir_block_index(native_module, function, function.entry_block) < 0
		return "MIR function entry block does not exist"
	end
	mut index := function.parameter_start
	mut finish := index + function.parameter_count
	while index < finish
		if mir_value_type(native_module, function.id, native_module.arguments[index]) == 0
			return "MIR function parameter is undefined"
		end
		index += 1
	end
	mut block_index := function.block_start
	block_finish := block_index + function.block_count
	while block_index < block_finish
		block := native_module.blocks[block_index]
		if !mir_origin_valid(block.source_id, block.line, native_module.source_count[0])
			return "MIR block origin is invalid"
		end
		mut previous := function.block_start
		while previous < block_index
			if native_module.blocks[previous].id == block.id
				return "MIR block identifier is duplicated"
			end
			previous += 1
		end
		index = block.parameter_start
		finish = index + block.parameter_count
		while index < finish
			if mir_value_type(native_module, function.id, native_module.arguments[index]) == 0
				return "MIR block parameter is undefined"
			end
			index += 1
		end
		index = block.instruction_start
		finish = index + block.instruction_count
		while index < finish
			error := mir_instruction_error(native_module, function, block, index)
			if error != ""
				return error
			end
			index += 1
		end
		error := mir_terminator_error(native_module, function, block)
		if error != ""
			return error
		end
		block_index += 1
	end
	return ""
end

def verify_mir(native_module: MirModule, optimized: Boolean): String
	if native_module.source_count[0] <= 0
		return "MIR module has no sources"
	end
	mut entry_found := false
	mut index := 0
	if optimized
		if native_module.array_headers.size() != native_module.array_regions.size() || native_module.array_loop_headers.size() != native_module.array_regions.size()
			return "MIR optimized Array-header fact is invalid"
		end
	else
		if native_module.array_headers.size() != 0 || native_module.array_loop_headers.size() != 0
			return "MIR input cannot supply optimization facts"
		end
	end
	while index < native_module.array_regions.size()
		header := mir_array_headers(native_module.array_regions[index])
		if !header.valid
			return "MIR Array region is invalid"
		end
		if optimized
			mut loops: Array<Integer> := []
			if header.declarations.size() == 0
				loops = mir_array_loop_headers(native_module.array_regions[index])
			end
			if !mir_array_headers_equal(native_module.array_loop_headers[index], loops)
				return "MIR optimized Array-header fact is invalid"
			end
			if !mir_array_headers_equal(native_module.array_headers[index], header.declarations)
				return "MIR optimized Array-header fact is invalid"
			end
		end
		index += 1
	end
	if native_module.functions.size() == 0
		return ""
	end
	index = 0
	while index < native_module.functions.size()
		function := native_module.functions[index]
		if function.id < 0
			return "MIR function identifier is invalid"
		end
		if !mir_origin_valid(function.source_id, function.line, native_module.source_count[0])
			return "MIR function origin is invalid"
		end
		mut previous := 0
		while previous < index
			if native_module.functions[previous].id == function.id
				return "MIR function identifier is duplicated"
			end
			previous += 1
		end
		if function.id == native_module.entry_function[0]
			entry_found = true
		end
		error := mir_function_structure_error(native_module, function)
		if error != ""
			return error
		end
		index += 1
	end
	if !entry_found
		return "MIR entry function does not exist"
	end
	index = 0
	while index < native_module.values.size()
		value := native_module.values[index]
		function_index := mir_function_index(native_module, value.function_id)
		if function_index < 0
			return "MIR value identity is invalid"
		end
		if value.id < 0
			return "MIR value identity is invalid"
		end
		if value.type_id < 1
			return "MIR value type is invalid"
		end
		if value.type_id > 7
			return "MIR value type is invalid"
		end
		if !mir_origin_valid(value.source_id, value.line, native_module.source_count[0])
			return "MIR value origin is invalid"
		end
		mut previous := 0
		while previous < index
			other := native_module.values[previous]
			if other.function_id == value.function_id
				if other.id == value.id
					return "MIR value is defined more than once"
				end
			end
			previous += 1
		end
		function := native_module.functions[function_index]
		if mir_definition_count(native_module, function, value.id) != 1
			return "MIR value definition count differs"
		end
		index += 1
	end
	index = 0
	while index < native_module.functions.size()
		error := mir_function_error(native_module, native_module.functions[index])
		if error != ""
			return error
		end
		function := native_module.functions[index]
		mut expected_guard := 0
		if optimized
			expected_guard = mir_scalar_guard(native_module, function)
		end
		if function.integer_guard != expected_guard
			return "MIR scalar Integer guard differs"
		end
		index += 1
	end
	return ""
end

# A checked assignment region retains its Array owner and normalized position.
# The initial check precedes the RHS; the final store checks current storage.
def mir_array_assignment_valid(index_origin: Integer, store_origin: Integer, reverse_origin: Integer, token_count: Integer): Boolean
	if index_origin < 0
		return false
	end
	if index_origin >= store_origin
		return false
	end
	if store_origin >= token_count
		return false
	end
	return reverse_origin == index_origin
end

# Assignment regions retain source-indexed capture (1), checked index (2),
# conservative effect barriers (6), and final store (5). Plans are recomputed:
# 0 reloads current storage, 1 reuses the checked address with a rooted owner,
# and 2 also proves that no owner root is needed across the index and RHS.
# Unknown/malformed operations never authorize removing either safeguard.
def mir_array_assignment_plan(operations: Array<MirArrayOperation>, index_origin: Integer, store_origin: Integer, token_count: Integer): Integer
	if !mir_array_assignment_valid(index_origin, store_origin, index_origin, token_count)
		return - 1
	end
	mut phase := 0
	mut plan := 2
	mut cursor := 0
	while cursor < operations.size()
		operation := operations[cursor]
		if operation.origin < 0
			return - 1
		end
		if operation.origin >= token_count
			return - 1
		end
		if operation.kind == 1
			if operation.operand != 0
				return - 1
			end
			if operation.origin == index_origin
				if phase != 0
					return - 1
				end
				phase = 1
			end
		elsif operation.kind == 2
			if operation.operand < 0
				return - 1
			end
			if operation.operand >= operation.origin
				return - 1
			end
			if operation.operand == index_origin
				if phase != 1
					return - 1
				end
				if operation.origin >= store_origin
					return - 1
				end
				phase = 2
			end
		elsif operation.kind == 6
			if operation.operand != 0
				return - 1
			end
			if phase == 1
				plan = 1
			elsif phase == 2
				plan = 0
			end
		elsif operation.kind == 5
			if cursor != operations.size() - 1
				return - 1
			end
			if phase != 2
				return - 1
			end
			if operation.origin != store_origin
				return - 1
			end
			if operation.operand != index_origin
				return - 1
			end
			phase = 3
		else
			return - 1
		end
		cursor += 1
	end
	if phase != 3
		return - 1
	end
	return plan
end
