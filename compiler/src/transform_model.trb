import { IterationSyntax, iteration_syntax_valid } from iteration_syntax
import { MirIteration, mir_iteration_valid } from iteration_mir
import { nullable_type } from nullable_types

# A value-producing block is keyed by its suffix, so chained transforms have
# distinct regions while retaining their already-evaluated receivers.
record TransformSyntax
	iteration: IterationSyntax
	kind: Integer
	initial_start: Integer
	initial_finish: Integer
	accumulator_origin: Integer
end

record MirTransform
	syntax: TransformSyntax
	iteration: MirIteration
	type_name: String
	key_type: String
end

def transform_kind(name: String): Integer
	if name == "map"
		return 1
	elsif name == "select"
		return 2
	elsif name == "reduce"
		return 3
	elsif name == "any?"
		return 4
	elsif name == "all?"
		return 5
	elsif name == "none?"
		return 6
	elsif name == "find"
		return 7
	elsif name == "find_index"
		return 8
	elsif name == "sort_by"
		return 9
	elsif name == "sort_by_descending"
		return 10
	end
	return 0
end

def transform_syntax_valid(plan: TransformSyntax, origin: Integer, token_count: Integer): Boolean
	shape := plan.iteration
	if !iteration_syntax_valid(shape, origin, token_count) || shape.receiver_finish != origin
		return false
	end
	if plan.kind == 3
		if plan.initial_start <= origin || plan.initial_finish <= plan.initial_start || plan.initial_finish >= plan.accumulator_origin || plan.accumulator_origin >= shape.element_origin
			return false
		end
		return shape.second_origin == - 1
	end
	if plan.kind < 1 || plan.kind > 10 || plan.initial_start != - 1 || plan.initial_finish != - 1
		return false
	end
	if plan.kind >= 4 && shape.second_origin != - 1
		return false
	end
	return plan.accumulator_origin == - 1
end

def mir_transform_valid(plan: MirTransform, origin: Integer, token_count: Integer, element_type: String): Boolean
	if !transform_syntax_valid(plan.syntax, origin, token_count)
		return false
	end
	if plan.iteration.source_kind < 1 || plan.iteration.source_kind > 2
		return false
	end
	if !mir_iteration_valid(plan.iteration, origin, token_count, plan.iteration.type_name, element_type)
		return false
	end
	shape := plan.syntax.iteration
	loop := plan.iteration.syntax
	if loop.origin != shape.origin || loop.receiver_finish != shape.receiver_finish || loop.element_origin != shape.element_origin || loop.second_origin != shape.second_origin || loop.body_start != shape.body_start || loop.body_finish != shape.body_finish || loop.finish != shape.finish
		return false
	end
	if plan.type_name == "" || plan.type_name == "Void"
		return false
	end
	if plan.syntax.kind >= 9
		if plan.iteration.source_kind != 1 || plan.type_name != plan.iteration.type_name
			return false
		end
		if plan.key_type == "Integer" || plan.key_type == "Float" || plan.key_type == "String"
			return true
		end
		return false
	elsif plan.key_type != ""
		return false
	end
	if plan.syntax.kind >= 4 && plan.syntax.kind <= 6 && plan.type_name != "Boolean"
		return false
	end
	if plan.syntax.kind == 7 && plan.type_name != nullable_type(element_type)
		return false
	end
	if plan.syntax.kind == 8 && plan.type_name != "Integer?"
		return false
	end
	return plan.type_name != "Never"
end
