import { describe, expect, test } from trb/std/test
import { gate4_check, gate4_emit_qbe, gate4_lex } from compiler
import { gate4_parse_module } from parser
import { gate4_resolve } from resolution
import { gate4_compiler_new, gate4_has_diagnostic } from state
import { gate4_verify_mir } from mir

describe("Checked readonly record fields") do
	test("preserves mutable Array values and whole-record rebinding") do
		source := "record Box\nvalue: Integer\nvalues: Array<Integer>\nend\nrecord Outer\nbox: Box\nend\ndef extend(mut values: Array<Integer>)\nvalues.push(4)\nend\ndef main()\nmut box := Box.new(value: 1, values: [2])\nbox.values[0] += 1\nextend(box.values)\nmut shared := box.values\nshared.push(5)\nputs(box.value.to_s())\nputs(box.values[0])\nputs(box.values.size())\nmut outer := Outer.new(box: box)\nouter.box.values[1] = 6\nputs(box.values[1])\noriginal := box\nbox = Box.new(value: 9, values: [8])\nputs(original.value)\nputs(box.value)\nputs(box.values[0])\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		expect(gate4_verify_mir(state.scalar_mir, true)).to_equal("")
		gate4_emit_qbe(state)
		expect(gate4_has_diagnostic(state)).to_be_false()
	end
end
