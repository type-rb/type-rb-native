import { IterationSyntax, iteration_syntax_valid } from iteration_syntax

# Checked traversal binds immutable syntax to receiver/element types and the
# lexical loop owner. Executable control flow is lowered to ordinary MIR edges.
record MirIteration
	syntax: IterationSyntax
	parent_loop: Integer
	source_kind: Integer
	type_name: String
	element_type: String
end

def mir_iteration_valid(plan: MirIteration, origin: Integer, token_count: Integer, array_type: String, element_type: String): Boolean
	if !iteration_syntax_valid(plan.syntax, origin, token_count)
		return false
	end
	if plan.parent_loop < - 1 || plan.parent_loop >= origin
		return false
	end
	if element_type == "" || plan.type_name != array_type
		return false
	end
	if plan.source_kind == 2
		if plan.type_name != "Range<Integer>" || element_type != "Integer"
			return false
		end
		return plan.element_type == "Integer"
	end
	if plan.source_kind != 1 || plan.type_name == "Range<Integer>"
		return false
	end
	return plan.element_type == element_type
end

# Construction preserves two evaluated Integer endpoints and one exclusion bit.
record MirRangeConstruction
	origin: Integer
	operator_origin: Integer
	end_origin: Integer
	finish: Integer
	exclusive: Integer
	start_type: String
	end_type: String
end

def mir_range_valid(plan: MirRangeConstruction, origin: Integer, operator_origin: Integer, end_origin: Integer, finish: Integer, token_count: Integer): Boolean
	if origin < 0 || origin >= operator_origin || operator_origin >= end_origin || end_origin >= finish || finish >= token_count
		return false
	end
	if plan.origin != origin || plan.operator_origin != operator_origin || plan.end_origin != end_origin || plan.finish != finish
		return false
	end
	if plan.exclusive != 0 && plan.exclusive != 1
		return false
	end
	if plan.start_type != "Integer"
		return false
	end
	return plan.end_type == "Integer"
end
