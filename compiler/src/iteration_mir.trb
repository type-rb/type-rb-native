# A structured Array traversal retains its receiver once and observes the live
# header before every element. Cursor advancement is separate from its binding.
record MirIteration
	origin: Integer
	receiver_finish: Integer
	element_origin: Integer
	index_origin: Integer
	body_start: Integer
	body_finish: Integer
	finish: Integer
	parent_loop: Integer
	type_name: String
	element_type: String
end

def mir_iteration_shape_valid(plan: MirIteration, origin: Integer, token_count: Integer): Boolean
	if token_count <= 0 || plan.origin != origin || origin < 0 || plan.receiver_finish <= origin
		return false
	end
	if plan.element_origin <= plan.receiver_finish || plan.body_start <= plan.element_origin
		return false
	end
	if plan.index_origin >= 0
		if plan.index_origin <= plan.element_origin || plan.index_origin >= plan.body_start
			return false
		end
	elsif plan.index_origin != - 1
		return false
	end
	if plan.body_finish < plan.body_start || plan.body_finish >= token_count - 1
		return false
	end
	return plan.finish == plan.body_finish + 1
end

def mir_iteration_valid(plan: MirIteration, origin: Integer, token_count: Integer, array_type: String, element_type: String): Boolean
	if !mir_iteration_shape_valid(plan, origin, token_count)
		return false
	end
	if plan.parent_loop < - 1 || plan.parent_loop >= origin
		return false
	end
	if element_type == "" || plan.type_name != array_type
		return false
	end
	return plan.element_type == element_type
end
