import { QbeOutput, qbe_output_line } from qbe_output

# Compiler-private byte construction preserves even an incomplete UTF-8 sequence.
def emit_string_literal_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\ndata $trbn_literal_byte_error = { b \"compiler: invalid literal byte\", b 10 }\nfunction l $trbn_literal_byte(l %byte) {\n@start\n %negative =w csltl %byte, 0\n %large =w csgtl %byte, 255\n %invalid =w or %negative, %large\n jnz %invalid, @failure, @allocate\n@failure\n call $trbn_fail(l $trbn_literal_byte_error, l 31)\n hlt\n@allocate\n %result =l call $trbn_string_alloc(l 18)\n %length =l add %result, 8\n storel 1, %length\n %points =l add %result, 16\n storel 1, %points\n %data =l add %result, 24\n storeb %byte, %data\n %end =l add %data, 1\n storeb 0, %end\n ret %result\n}\n")
end
