import { string_starts_with } from path
import { MirModule, MirType, mir_array_element_type, mir_control_value_type, mir_type_id, mir_type_name } from mir

# Identity lookup never collapses a managed value to an address/word type.
def mir_semantic_type_name(native_module: MirModule, type_id: Integer): String
	if type_id < 9
		return mir_type_name(type_id)
	end
	if type_id - 9 >= native_module.types.size()
		return "Invalid"
	end
	return native_module.types[type_id - 9].name
end

def mir_semantic_value_type(native_module: MirModule, type_id: Integer): Boolean
	if mir_control_value_type(type_id) || type_id == 3 || type_id == 6
		return true
	end
	if type_id >= 9
		return type_id - 9 < native_module.types.size()
	end
	return false
end

def mir_managed_type(native_module: MirModule, type_id: Integer): Boolean
	if type_id == 8 || type_id == 3 || type_id == 6
		return true
	end
	if type_id >= 9
		return type_id - 9 < native_module.types.size()
	end
	return false
end

def mir_element_type(native_module: MirModule, type_id: Integer): Integer
	if type_id < 9
		return mir_array_element_type(type_id)
	end
	if type_id - 9 >= native_module.types.size()
		return 0
	end
	return native_module.types[type_id - 9].element
end

def mir_semantic_type_id(mut native_module: MirModule, name: String): Integer
	primitive := mir_type_id(name)
	if primitive != 0
		return primitive
	end
	mut index := 0
	while index < native_module.types.size()
		if native_module.types[index].name == name
			return index + 9
		end
		index += 1
	end
	if !string_starts_with(name, "Array<") || name.size() < 8 || name[name.size() - 1] != ">"
		return 0
	end
	mut inner := ""
	index = 6
	while index < name.size() - 1
		inner += name[index]
		index += 1
	end
	element := mir_semantic_type_id(native_module, inner)
	if !mir_semantic_value_type(native_module, element)
		return 0
	end
	id := native_module.types.size() + 9
	native_module.types.push(MirType.new(name: name, element: element))
	return id
end

# Element references point backwards: invalid or cyclic graphs are rejected
# before any consumer reads a type row. Names must encode that exact identity.
def mir_types_error(native_module: MirModule): String
	mut index := 0
	while index < native_module.types.size()
		row := native_module.types[index]
		if row.element >= index + 9 || !mir_semantic_value_type(native_module, row.element)
			return "MIR composite element type is invalid"
		end
		if row.name != "Array<" + mir_semantic_type_name(native_module, row.element) + ">" || mir_type_id(row.name) != 0
			return "MIR composite type identity differs"
		end
		mut previous := 0
		while previous < index
			if native_module.types[previous].name == row.name
				return "MIR composite type is duplicated"
			end
			previous += 1
		end
		index += 1
	end
	return ""
end
