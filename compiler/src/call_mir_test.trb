import { intrinsic_mir_erase } from intrinsic_mir_test
import { logical_checked_source, logical_run_qbe_arguments } from logical_test
import trb/std/process
import trb/std/result
import { check, emit_qbe } from compiler
import { lex } from lexer
import { control_test_output } from control_mir_test
import { MirCall, MirFunction, MirSignature, MirValue, mir_function_index } from mir
import { verify_mir } from mir_verifier
import { parse_module } from parser
import { resolve } from resolution
import { CompilerState, compiler_new } from state
import { load_integer, store_string } from storage
import { describe, expect, test } from trb/std/test

def call_test_state(): CompilerState
	source := "def walk(value: Integer): Integer\n\tmut result := value\n\tmut index := 0\n\twhile index < value\n\t\tindex += 1\n\t\tif index == 2\n\t\t\tannounce(index)\n\t\t\tnext\n\t\tend\n\t\tresult = step(result)\n\tend\n\treturn sum_to(result)\nend\ndef step(value: Integer): Integer\n\treturn value + 1\nend\ndef announce(value: Integer)\n\tputs(value)\n\treturn\nend\ndef sum_to(value: Integer): Integer\n\tif value < 1\n\t\treturn 0\n\tend\n\treturn value + sum_to(value - 1)\nend\ndef empty()\nend\ndef notify()\n\tempty()\n\tannounce(9)\n\treturn\nend\ndef main()\n\tputs(walk(3))\n\treturn\nend\n"
	mut state := compiler_new(source.size() * 3 + 16)
	lex(state, source)
	parse_module(state, 0, state.entry_module[0])
	resolve(state)
	check(state)
	return state
end

describe("MIR declaration-bound calls") do
	test("connects forward recursive and Void calls across mutable control flow") do
		state := call_test_state()
		expect(state.diagnostic_count[0]).to_equal(0)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(state.scalar_mir.signatures.size()).to_equal(7)
		[0, 3, 4, 5].each do |id|
			index := mir_function_index(state.scalar_mir, id)
			expect(index >= 0).to_be_true()
			if index >= 0
				expect(state.scalar_mir.functions[index].kind).to_equal(3)
			end
		end
		# Scalar output conversion and I/O now share the managed MIR route.
		expect(mir_function_index(state.scalar_mir, 2) >= 0).to_be_true()
		expect(state.scalar_mir.calls.size()).to_equal(7)
		state.scalar_mir.calls.each do |call|
			expect(call.effects).to_equal(15)
		end
	end

	test("emits calls loops and transfers after their checked bodies are unavailable") do
		mut state := call_test_state()
		expect(state.diagnostic_count[0]).to_equal(0)
		before := control_test_output(emit_qbe(state))
		state.scalar_mir.functions.each do |function|
			mut index := load_integer(state.function_body_starts, function.id)
			while index < load_integer(state.function_body_ends, function.id)
				store_string(state.token_texts, index, "unavailable")
				index += 1
			end
		end
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		expect(before.include?("call $trbnf1(")).to_be_false()
		expect(before.include?("call $trbnf2(")).to_be_true()
		expect(before.include?("call $trbnf3(")).to_be_true()
		# Leaf expansion does not implicitly control function definition emission.
		expect(before.include?("function l $trbnf1(")).to_be_true()
	end

	test("rejects missing callees effects argument arity and invalid argument spans") do
		mut index := 0
		while index < 5
			mut state := call_test_state()
			call := state.scalar_mir.calls[0]
			mut callee := call.callee
			mut effects := call.effects
			mut start := call.argument_start
			mut count := call.argument_count
			if index == 0
				callee = 99
			elsif index == 1
				effects = 0
			elsif index == 2
				count = 0
			elsif index == 3
				start = 9007199254740991
			else
				state.scalar_mir.arguments[start] = 9007199254740991
			end
			state.scalar_mir.calls[0] = MirCall.new(callee: callee, effects: effects, argument_start: start, argument_count: count)
			expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
			index += 1
		end
	end

	test("rejects a callee declaration with mismatched argument or return types") do
		["Boolean", "Float"].each do |type_name|
			mut state := call_test_state()
			signature := state.scalar_mir.signatures[2]
			state.scalar_mir.signatures[2] = MirSignature.new(id: signature.id, kind: signature.kind, name: signature.name, adapter: signature.adapter, source_id: signature.source_id, line: signature.line, parameter_types: [type_name], parameter_mutable: [0], result_type: signature.result_type)
			expect(verify_mir(state.scalar_mir, true)).to_equal("MIR call argument type differs")
		end
		mut state := call_test_state()
		function := state.scalar_mir.functions[0]
		state.scalar_mir.functions[0] = MirFunction.new(kind: function.kind, result_type: "Boolean", integer_guard: function.integer_guard, id: function.id, entry_block: function.entry_block, source_id: function.source_id, line: function.line, parameter_start: function.parameter_start, parameter_count: function.parameter_count, block_start: function.block_start, block_count: function.block_count)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR function declaration differs")
	end
	test("rejects an Array value substituted for a scalar declaration parameter") do
		mut state := call_test_state()
		value := state.scalar_mir.values[0]
		state.scalar_mir.values[0] = MirValue.new(function_id: value.function_id, id: value.id, type_id: 3, source_id: value.source_id, line: value.line)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR function parameter type differs")
	end

end

# Standard package identities are separate from same-spelled user declarations.
def standard_call_test_state(): CompilerState
	source := "import trb/std/process as Args\nimport trb/std/math as Numeric\ndef main()\nmut first := Args.argv()\nfirst.push(\"local\")\nsecond := Args.argv()\nroot := Numeric.sqrt(second[0].to_i())\nputs(root.to_i())\nputs(first.size())\nputs(first[1])\nputs(second.size())\nputs(sqrt(5))\nputs(argv())\nputs(leaf())\nnan := Numeric.sqrt(- 1)\nputs(nan != nan)\nreturn\nputs(\"unreachable main\")\nend\ndef sqrt(value: Integer): Integer\nreturn value + 1\nend\ndef argv(): Integer\nreturn 7\nend\ndef leaf(): Integer\nreturn 42\nputs(\"unreachable leaf\")\nreturn 99\nend\n"
	mut state := logical_checked_source(source)
	expect(check(state)).to_be_true()
	return state
end

describe("MIR standard package calls") do
	test("binds aliases and widening with managed results without capturing user names") do
		state := standard_call_test_state()
		expect(state.scalar_mir.functions.size()).to_equal(state.function_count[0])
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(state.scalar_mir.signatures.size()).to_equal(6)
		expect(state.scalar_mir.signatures[1].kind).to_equal(0)
		expect(state.scalar_mir.signatures[2].kind).to_equal(0)
		expect(state.scalar_mir.signatures[4].adapter).to_equal(10)
		expect(state.scalar_mir.signatures[5].adapter).to_equal(11)
		expect(state.scalar_mir.functions[mir_function_index(state.scalar_mir, 3)].kind).to_equal(1)
		expect(state.scalar_mir.root_plans[0].capacity >= 2).to_be_true()
		mut math_calls := 0
		mut process_calls := 0
		state.scalar_mir.calls.each do |call|
			signature := state.scalar_mir.signatures[call.callee]
			if signature.kind == 3 && signature.adapter == 11
				expect(call.effects).to_equal(0)
				math_calls += 1
			elsif signature.kind == 3 && signature.adapter == 10
				expect(call.effects).to_equal(15)
				process_calls += 1
			end
		end
		expect(math_calls).to_equal(2)
		expect(process_calls).to_equal(2)
		mut instruction_index := 0
		while instruction_index < state.scalar_mir.instructions.size()
			instruction := state.scalar_mir.instructions[instruction_index]
			if instruction.kind == 11
				call := state.scalar_mir.calls[instruction.payload]
				signature := state.scalar_mir.signatures[call.callee]
				if signature.kind == 3 && signature.adapter == 11
					expect(state.scalar_mir.root_plans[0].instructions.include?(instruction_index)).to_be_false()
				end
			end
			instruction_index += 1
		end
	end

	test("executes erased reordered standard calls and retains live argv results at collection") do
		mut state := standard_call_test_state()
		before := control_test_output(emit_qbe(state))
		intrinsic_mir_erase(state)
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		state.scalar_mir.functions.each do |function|
			if function.kind != 3
				next
			end
			mut left := function.block_start
			mut right := left + function.block_count - 1
			while left < right
				saved := state.scalar_mir.blocks[left]
				state.scalar_mir.blocks[left] = state.scalar_mir.blocks[right]
				state.scalar_mir.blocks[right] = saved
				left += 1
				right -= 1
			end
		end
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		mut forced := ""
		mut caller := false
		mut hooks := 0
		control_test_output(emit_qbe(state)).split("\n").each do |line|
			if line.start_with?("function ")
				caller = line.include?("$trbnf0(")
			end
			if line == "}"
				caller = false
			end
			if caller && line.include?("call $trbn_process_argv(")
				forced += "\tcall $trbn_gc_collect(w 0)\n"
				hooks += 1
			end
			forced += line + "\n"
		end
		expect(hooks).to_equal(2)
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			case logical_run_qbe_arguments(qbe, forced, ["81"])
			when Result::Ok(actual)
				expect(actual).to_equal("9\n2\nlocal\n1\n6\n7\n42\ntrue\n")
			when Result::Err(error)
				puts(error)
				expect(false).to_be_true()
			end
		end
	end

	test("rejects forged standard names signatures and compiler privileges") do
		mut mode := 0
		while mode < 8
			mut state := standard_call_test_state()
			old := state.scalar_mir.signatures[5]
			mut kind := old.kind
			mut adapter := old.adapter
			mut name := old.name
			mut parameters := old.parameter_types
			mut mutable := old.parameter_mutable
			mut result := old.result_type
			if mode == 0
				adapter = 99
			elsif mode == 1
				name = "sqrt"
			elsif mode == 2
				parameters = ["Integer"]
			elsif mode == 3
				mutable = [1]
			elsif mode == 4
				result = "Array<String>"
			elsif mode == 5
				kind = 1
			elsif mode == 6
				kind = 2
				adapter = 9
			else
				parameters = []
				mutable = []
			end
			state.scalar_mir.signatures[5] = MirSignature.new(id: old.id, kind: kind, name: name, adapter: adapter, source_id: old.source_id, line: old.line, parameter_types: parameters, parameter_mutable: mutable, result_type: result)
			expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
			mode += 1
		end
	end

	test("rejects forged standard math call effects") do
		mut state := standard_call_test_state()
		mut index := 0
		mut found := false
		while index < state.scalar_mir.calls.size()
			call := state.scalar_mir.calls[index]
			if state.scalar_mir.signatures[call.callee].adapter == 11
				state.scalar_mir.calls[index] = MirCall.new(callee: call.callee, argument_start: call.argument_start, argument_count: call.argument_count, effects: 15)
				found = true
				break
			end
			index += 1
		end
		expect(found).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR call effects or adapter differ")
	end

	test("preserves package and unreachable-tail diagnostics") do
		sources := ["import trb/std/math\ndef main()\nMath.sqrt()\nend\n", "import trb/std/process\ndef main()\nProcess.argv(1)\nend\n", "import trb/std/math\ndef main()\nMath.sqrt(true)\nend\n", "import trb/std/math\ndef main()\nMath.argv()\nend\n", "def leaf(): Integer\nreturn 42\nreturn true\nend\ndef main()\nputs(leaf())\nend\n", "def leaf(): Integer\nreturn 42\nputs(missing)\nend\ndef main()\nputs(leaf())\nend\n"]
		sources.each do |source|
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			if resolve(state)
				expect(check(state)).to_be_false()
			end
			expect(state.diagnostic_count[0] > 0).to_be_true()
		end
	end
end
