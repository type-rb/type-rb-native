import { integer_string } from literals
import { MirArrayLoop, MirInstruction } from mir
import { mir_element_type, mir_managed_type, mir_operand_type, mir_storage_type_name } from mir_types
import { QbeEmitContext, QbeValue, emit_label, emit_temporary, emit_typed_load, emit_typed_store, emitted_value } from qbe_context
import { QbeOutput, qbe_output_branch, qbe_output_line } from qbe_output
import { CompilerState } from state

# Keep the full runtime check for negative and invalid indexes. The ordinary
# nonnegative case can use the Array's current length directly. A captured
# assignment target needs only its checked logical index before the RHS.
def emit_checked_array_access(owner: String, requested: String, capture_index: Boolean, mut context: QbeEmitContext, mut output: QbeOutput): String
	length_slot := emit_temporary(context)
	length := emit_temporary(context)
	valid := emit_temporary(context)
	fast := emit_label(context)
	slow := emit_label(context)
	complete := emit_label(context)
	qbe_output_line(output, "\t" + length_slot + " =l add " + owner + ", 8")
	qbe_output_line(output, "\t" + length + " =l loadl " + length_slot)
	qbe_output_line(output, "\t" + valid + " =w cultl " + requested + ", " + length)
	qbe_output_branch(output, valid, fast, slow)
	qbe_output_line(output, fast)
	mut fast_value := requested
	if capture_index
		# Block arguments may have multiple incoming QBE definitions. Give the
		# phi a fresh predecessor-local operand instead of using one directly.
		fast_value = emit_temporary(context)
		qbe_output_line(output, "\t" + fast_value + " =l copy " + requested)
	else
		data_slot := emit_temporary(context)
		data := emit_temporary(context)
		offset := emit_temporary(context)
		fast_value = emit_temporary(context)
		qbe_output_line(output, "\t" + data_slot + " =l add " + owner + ", 24")
		qbe_output_line(output, "\t" + data + " =l loadl " + data_slot)
		qbe_output_line(output, "\t" + offset + " =l mul " + requested + ", 8")
		qbe_output_line(output, "\t" + fast_value + " =l add " + data + ", " + offset)
	end
	qbe_output_line(output, "\tjmp " + complete)
	qbe_output_line(output, slow)
	mut slow_value := emit_temporary(context)
	qbe_output_line(output, "\t" + slow_value + " =l call $trbn_array_address(l " + owner + ", l " + requested + ")")
	if capture_index
		data_slot := emit_temporary(context)
		data := emit_temporary(context)
		offset := emit_temporary(context)
		index := emit_temporary(context)
		qbe_output_line(output, "\t" + data_slot + " =l add " + owner + ", 24")
		qbe_output_line(output, "\t" + data + " =l loadl " + data_slot)
		qbe_output_line(output, "\t" + offset + " =l sub " + slow_value + ", " + data)
		qbe_output_line(output, "\t" + index + " =l shr " + offset + ", 3")
		slow_value = index
	end
	qbe_output_line(output, complete)
	result := emit_temporary(context)
	qbe_output_line(output, "\t" + result + " =l phi " + fast + " " + fast_value + ", " + slow + " " + slow_value)
	return result
end

# No source analysis or implicit roots: each allocation/push has its own MIR
# safe point. Only verified non-allocating loop plans retain storage addresses
# across operations; other accesses obtain an address for that operation.
def emit_mir_array_instruction(state: CompilerState, value_types: Array<Integer>, instruction: MirInstruction, instruction_index: Integer, plans: Array<MirArrayLoop>, operands: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput): QbeValue
	kind := instruction.kind
	type_id := mir_operand_type(value_types, instruction.result)
	type_name := mir_storage_type_name(state.scalar_mir, type_id)
	result := emit_temporary(context)
	if kind == 19
		mut descriptor := "$trbn_desc_array_scalar"
		if mir_managed_type(state.scalar_mir, mir_element_type(state.scalar_mir, type_id))
			descriptor = "$trbn_desc_array_managed"
		end
		qbe_output_line(output, "\t" + result + " =l call $trbn_array_new(l " + descriptor + ")")
		return emitted_value(result, type_name)
	end
	owner := operands[instruction.first]
	if kind == 48
		if instruction.payload == 0
			mut value := operands[instruction.second]
			if mir_storage_type_name(state.scalar_mir, mir_operand_type(value_types, instruction.second)) == "Float"
				value = emit_temporary(context)
				qbe_output_line(output, "\t" + value + " =l cast " + operands[instruction.second])
			end
			qbe_output_line(output, "\tcall $trbn_array_unshift(l " + owner + ", l " + value + ")")
			return emitted_value("", "Void")
		else
			mut raw := result
			if type_name == "Float"
				raw = emit_temporary(context)
			end
			qbe_output_line(output, "\t" + raw + " =l call $trbn_array_remove(l " + owner + ", w " + integer_string(instruction.payload) + ")")
			if type_name == "Float"
				qbe_output_line(output, "\t" + result + " =d cast " + raw)
			end
		end
		return emitted_value(result, type_name)
	end
	if kind == 47
		mut descriptor := "$trbn_desc_array_scalar"
		if mir_managed_type(state.scalar_mir, mir_element_type(state.scalar_mir, type_id))
			descriptor = "$trbn_desc_array_managed"
		end
		mut bounds := "0"
		if instruction.payload == 2
			bounds = operands[instruction.second]
		end
		qbe_output_line(output, "\t" + result + " =l call $trbn_array_copy(l " + owner + ", l " + bounds + ", w " + integer_string(instruction.payload) + ", l " + descriptor + ")")
		return emitted_value(result, type_name)
	end
	mut selected :=- 1
	plans.each do |plan|
		if kind == 20 && plan.length == instruction_index
			selected = plan.header
		end
		plan.loads.each do |load|
			if kind == 22 && load == instruction_index
				selected = plan.header
			end
		end
	end
	if kind == 20 && selected >= 0
		return emitted_value("%mir_array_length" + integer_string(selected), "Integer")
	end
	if kind == 20
		address := emit_temporary(context)
		qbe_output_line(output, "\t" + address + " =l add " + owner + ", 8")
		qbe_output_line(output, "\t" + result + " =l loadl " + address)
		return emitted_value(result, "Integer")
	end
	second := operands[instruction.second]
	if kind == 24
		element := mir_element_type(state.scalar_mir, mir_operand_type(value_types, instruction.first))
		if mir_storage_type_name(state.scalar_mir, element) == "Float"
			output.runtime_flags[0] = 1
			qbe_output_line(output, "\tcall $trbn_array_push_d(l " + owner + ", d " + second + ")")
		else
			qbe_output_line(output, "\tcall $trbn_array_push_paced(l " + owner + ", l " + second + ")")
		end
		return emitted_value("", "Void")
	end
	if kind == 22 && selected >= 0
		offset := emit_temporary(context)
		address := emit_temporary(context)
		qbe_output_line(output, "\t" + offset + " =l mul " + second + ", 8")
		qbe_output_line(output, "\t" + address + " =l add %mir_array_data" + integer_string(selected) + ", " + offset)
		emit_typed_load(output, result, type_name, address)
		return emitted_value(result, type_name)
	end
	output.runtime_flags[3] = 1
	address := emit_checked_array_access(owner, second, kind == 21, context, output)
	if kind == 21
		return emitted_value(address, type_name)
	elsif kind == 22
		emit_typed_load(output, result, type_name, address)
	else
		element := mir_element_type(state.scalar_mir, mir_operand_type(value_types, instruction.first))
		emit_typed_store(output, mir_storage_type_name(state.scalar_mir, element), operands[instruction.payload], address)
		return emitted_value("", "Void")
	end
	return emitted_value(result, type_name)
end

def emit_mir_array_headers(plans: Array<MirArrayLoop>, block: Integer, operands: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput)
	plans.each do |plan|
		if plan.preheader == block
			owner := operands[plan.owner]
			length := emit_temporary(context)
			data := emit_temporary(context)
			qbe_output_line(output, "\t" + length + " =l add " + owner + ", 8")
			qbe_output_line(output, "\t%mir_array_length" + integer_string(plan.header) + " =l loadl " + length)
			qbe_output_line(output, "\t" + data + " =l add " + owner + ", 24")
			qbe_output_line(output, "\t%mir_array_data" + integer_string(plan.header) + " =l loadl " + data)
		end
	end
end
