import { scan_string } from lexer
import { CompilerState, diagnostic, has_diagnostic } from state
import { load_integer, load_string, sparse_integer_at, store_integer, store_string } from storage

# Expansion occurs only at the forward syntax cursor. Earlier declaration and
# control origins remain stable; future tokens have no published syntax yet.
def expand_quoted_token(mut state: CompilerState, origin: Integer, interpolation: Boolean): Boolean
	if load_integer(state.source_tokens.token_kinds, origin) != 7
		return true
	end
	raw := load_string(state.source_tokens.token_texts, origin)
	line := load_integer(state.source_tokens.token_lines, origin)
	previous := state.source_tokens.token_count[0]
	mut cursor := [0]
	scan_string(state, raw, cursor, line, interpolation)
	if has_diagnostic(state)
		return false
	end
	if cursor[0] != raw.size()
		diagnostic(state, "TRBN4001", line, "invalid quoted Symbol literal")
		return false
	end
	mut fused: Array<Integer> := []
	mut kinds: Array<Integer> := []
	mut texts: Array<String> := []
	mut lines: Array<Integer> := []
	mut index := previous
	while index < state.source_tokens.token_count[0]
		fused.push(sparse_integer_at(state.source_tokens.token_fused_literals, index))
		kinds.push(load_integer(state.source_tokens.token_kinds, index))
		texts.push(load_string(state.source_tokens.token_texts, index))
		lines.push(load_integer(state.source_tokens.token_lines, index))
		index += 1
	end
	index = origin + 1
	while index < previous
		fused.push(sparse_integer_at(state.source_tokens.token_fused_literals, index))
		kinds.push(load_integer(state.source_tokens.token_kinds, index))
		texts.push(load_string(state.source_tokens.token_texts, index))
		lines.push(load_integer(state.source_tokens.token_lines, index))
		index += 1
	end
	index = 0
	while index < kinds.size()
		store_integer(state.source_tokens.token_fused_literals, origin + index, fused[index])
		store_integer(state.source_tokens.token_kinds, origin + index, kinds[index])
		store_string(state.source_tokens.token_texts, origin + index, texts[index])
		store_integer(state.source_tokens.token_lines, origin + index, lines[index])
		index += 1
	end
	state.source_tokens.token_count[0] = origin + kinds.size()
	return true
end
