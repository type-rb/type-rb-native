import { integer_string } from literals
import { MirInstruction } from mir
import { mir_operand_type, mir_semantic_type_name } from mir_types
import { QbeEmitContext, QbeValue, emit_temporary, emit_typed_store, emitted_value } from qbe_context
import { emit_address } from qbe_memory
import { QbeOutput, qbe_output_line } from qbe_output
import { CompilerState } from state

def emit_mir_range_instruction(state: CompilerState, value_types: Array<Integer>, instruction: MirInstruction, operands: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput): QbeValue
	type_name := mir_semantic_type_name(state.scalar_mir, mir_operand_type(value_types, instruction.result))
	result := emit_temporary(context)
	if instruction.kind == 31
		qbe_output_line(output, "\t" + result + " =l call $trbn_gc_alloc(l $trbn_desc_range, l 24, l 0)")
		first := emit_address(context, output, result, 8)
		last := emit_address(context, output, result, 16)
		exclusive := emit_address(context, output, result, 24)
		emit_typed_store(output, "Integer", operands[instruction.first], first)
		emit_typed_store(output, "Integer", operands[instruction.second], last)
		emit_typed_store(output, "Integer", integer_string(instruction.payload), exclusive)
	else
		address := emit_address(context, output, operands[instruction.first], 8 + instruction.payload * 8)
		qbe_output_line(output, "\t" + result + " =l loadl " + address)
	end
	return emitted_value(result, type_name, 0, "", "")
end
