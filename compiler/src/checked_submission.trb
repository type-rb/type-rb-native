import { token_is } from syntax_tokens
import { nullable_fact, nullable_lookup } from nullable_flow
import { nullable_element } from nullable_types
import { find_field, find_record_type } from type_resolution
import { CheckedFlowFact, CheckedLocals, CompilerState, diagnostic, local_find } from state
import { load_integer, load_string, store_integer, store_string } from storage

# These facts come from a successfully checked and completed submission. They
# describe binding identity and optional presence, never an observed payload.
def checked_submission_boundary(mut state: CompilerState, mut locals: CheckedLocals, origin: Integer)
	if state.submissions.size() == 0
		return
	end
	submission := state.submissions[0]
	submission.resets.each do |reset|
		if origin == reset
			locals.nullable_state[0] =- 1
		end
	end
	if origin >= submission.start && origin < submission.finish && token_is(state, origin, "return")
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "return is only valid inside a function or method")
	end
	if origin == submission.start
		submission.before.each do |fact|
			binding := local_find(locals, fact.name)
			mut field :=- 1
			mut declared := ""
			if binding >= 0
				declared = load_string(locals.types, binding)
				if fact.field != ""
					mut record_type := declared
					if nullable_element(record_type) != ""
						record_type = nullable_element(record_type)
					end
					record_index := find_record_type(state, record_type)
					if record_index >= 0
						field = find_field(state, record_index, fact.field)
					end
					if field >= 0
						declared = load_string(state.field_types, field)
					else
						declared = ""
					end
				end
			end
			element := nullable_element(declared)
			if element == "" || (fact.presence != 1 && fact.presence != 2)
				diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked submission fact")
			else
				mut flow := element
				if fact.presence == 1
					flow = "Nil"
				end
				locals.nullable_state[0] = nullable_fact(locals, binding, field, flow, locals.nullable_state[0])
			end
		end
	end
	if origin == submission.finish
		mut binding := 0
		while binding < locals.count[0]
			declared := load_string(locals.types, binding)
			checked_submission_fact(state, locals, binding, - 1, declared)
			mut record_type := declared
			if nullable_element(record_type) != ""
				record_type = nullable_element(record_type)
			end
			record_index := find_record_type(state, record_type)
			if record_index >= 0
				start := load_integer(state.record_field_starts, record_index)
				mut field := start
				while field < start + load_integer(state.record_field_counts, record_index)
					checked_submission_fact(state, locals, binding, field, load_string(state.field_types, field))
					field += 1
				end
			end
			binding += 1
		end
	end
	return
end

def checked_submission_fact(mut state: CompilerState, locals: CheckedLocals, binding: Integer, field: Integer, declared: String)
	if nullable_element(declared) == ""
		return
	end
	flow := nullable_lookup(locals, binding, field, declared)
	if flow == declared
		return
	end
	mut presence := 2
	if flow == "Nil"
		presence = 1
	end
	mut name := ""
	if field >= 0
		name = load_string(state.field_names, field)
	end
	state.submissions[0].after.push(CheckedFlowFact.new(name: load_string(locals.names, binding), field: name, presence: presence))
	return
end

# Display and :type consume the same checked expression/assignment result.
# Backend emission has no dependency on this optional frontend projection.
def checked_submission_result(mut state: CompilerState, origin: Integer, type_name: String, mutable: Integer)
	if state.submissions.size() > 0
		store_string(state.submissions[0].types, origin, type_name)
		store_integer(state.submissions[0].mutable, origin, mutable)
	end
	return
end
