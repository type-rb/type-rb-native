import { declare_object_witnesses, prepare_object_dispatch } from object_dispatch
import { object_abstract_function, object_initializer_owner } from object_types
import { mir_initialize_object_field } from object_fields
import { builtin_result_source } from builtin_results
import { binding_scope_check } from result_checked
import { checked_body_lowering } from checked_body
import { declare_default_functions } from default_arguments
import { lambda_bind_captures } from lambda_lowering
import { mir_binding_initialize, mir_binding_read } from mir_bindings
import { check_block, check_block_value, check_expression } from checked_program
import { checked_mir_value, scalar_mir_disable } from checked_values
import { checked_hash_verify } from hash_checked
import { mir_add_parameter, scalar_mir_begin, scalar_mir_commit } from mir_builder
import { mir_control_active, mir_control_prepare, mir_control_return } from mir_control
import { mir_refine_scalar_call_effects } from mir_calls
import { optimize_verified_mir } from mir_passes
import { mir_managed_type, mir_semantic_type_id } from mir_types
import { verify_mir } from mir_verifier
import { resolve_function_body, validate_import_usage } from resolution
import { CheckedLocals, CompilerState, diagnostic, has_diagnostic, local_add, local_identity, locals_new, select_checked_body } from state
import { load_integer, load_string, sparse_integer_at, sparse_string_at, store_integer } from storage

# Parameter binding and body checking are separate semantic stages. All
# concrete functions start MIR here and require an owned body before finalization.
def checked_function_locals(mut state: CompilerState, function_index: Integer): CheckedLocals
	select_checked_body(state, function_index)
	state.module_graph.active_module[0] = load_integer(state.function_modules, function_index)
	state.declaration_owner[0] = sparse_string_at(state.token_namespaces, load_integer(state.function_body_starts, function_index))
	mut locals := locals_new(state.token_count[0] + 1)
	if state.type_resolution.generic_template_mode[0] || state.lambda_phase[0] == 1
		locals.mir_state[1] = function_index
	else
		scalar_mir_begin(state, function_index, locals)
	end
	state.checked[0].shared_bindings.each do |identity|
		store_integer(locals.mir_cell_plans, identity, 1)
	end
	parameter_start := load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + load_integer(state.function_parameter_counts, function_index)
	captures := lambda_bind_captures(state, locals, function_index)
	mut parameter_index := parameter_start + captures
	while parameter_index < parameter_finish
		added := local_add(
			state,
			locals,
			load_string(state.parameter_names, parameter_index),
			load_string(state.parameter_types, parameter_index),
			load_integer(state.parameter_mutable, parameter_index),
			load_integer(state.parameter_lines, parameter_index),
		)
		if added
			store_integer(locals.mir_values, locals.count[0] - 1, 0)
			mir_add_parameter(state, locals, parameter_index)
		end
		parameter_index += 1
	end
	# ABI parameter values occupy the first N SSA identities before allocation.
	mut slot := captures
	while slot < locals.count[0]
		if sparse_integer_at(locals.mir_cell_plans, local_identity(locals, slot)) > 0
			origin := load_integer(state.function_body_starts, function_index)
			value := mir_binding_read(state, locals, slot, origin)
			mir_binding_initialize(state, locals, slot, value, origin)
		end
		slot += 1
	end
	return locals
end

def check_function_body(mut state: CompilerState, function_index: Integer, mut locals: CheckedLocals): Boolean
	previous_body := select_checked_body(state, function_index)
	parameter_start := load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		if locals.mir_state[0] == 1 && mir_managed_type(state.scalar_mir, mir_semantic_type_id(state.scalar_mir, load_string(state.parameter_types, parameter_index)))
			mir_control_prepare(state, locals)
		end
		parameter_index += 1
	end
	result_type := load_string(state.function_result_types, function_index)
	if (result_type == "Void" || mir_managed_type(state.scalar_mir, mir_semantic_type_id(state.scalar_mir, result_type))) && locals.mir_state[0] == 1
		mir_control_prepare(state, locals)
	end
	owner := object_initializer_owner(state, function_index)
	if owner >= 0
		state.object_instances[owner].fields.each do |field|
			if field.default_start >= 0
				mut default_position := [field.default_start]
				value := check_expression(state, default_position, locals, 1, field.type_name)
				mir_initialize_object_field(state, locals, owner, field.name, value, field.origin)
			end
		end
	end
	mut position := [load_integer(state.function_body_starts, function_index)]
	if sparse_integer_at(state.function_expression_bodies, function_index) > 0
		value := check_expression(state, position, locals, 1, result_type)
		returned := checked_mir_value(value)
		if returned >= 0
			locals.mir_state[4] = returned
			mir_control_return(state, locals, returned)
		else
			scalar_mir_disable(locals)
		end
	else
		if state.type_resolution.generic_template_mode[0] || state.lambda_phase[0] == 1
			completion := check_block_value(state, position, locals, result_type, - 1, false, "")
			if result_type != "Void" && completion.type_name != "Never"
				mut message := "function must return on every completing path"
				if state.type_resolution.generic_template_mode[0]
					message = "generic " + message
				end
				diagnostic(state, "TRBN4004", load_integer(state.function_lines, function_index), message)
			end
		else
			check_block(state, position, locals, result_type, - 1)
		end
	end
	binding_scope_check(state, locals, 0)
	if position[0] != load_integer(state.function_body_ends, function_index)
		diagnostic(
			state,
			"TRBN4004",
			load_integer(state.function_lines, function_index),
			"checker did not consume the complete function body",
		)
	end
	if result_type == "Void" && mir_control_active(locals) && locals.mir_control[6] == 0
		mir_control_return(state, locals, - 1)
	end
	if !has_diagnostic(state) && !state.type_resolution.generic_template_mode[0] && state.lambda_phase[0] != 1
		mir_error := scalar_mir_commit(state, function_index, locals)
		if mir_error != ""
			diagnostic(
				state,
				"TRBN4004",
				load_integer(state.function_lines, function_index),
				mir_error,
			)
		end
	end
	state.checked[0] = previous_body
	return !has_diagnostic(state)
end

# Finish closure/generic/default discovery before freezing the MIR catalog.
# File programs without closures or inferred transform results retain one pass.
# REPL witnesses also analyze retained shared bindings before MIR lowering.
def analyze_callable_bodies(mut state: CompilerState): Boolean
	mut generic_methods := false
	state.type_resolution.generic_functions.each do |definition|
		if definition.receiver_type != ""
			generic_methods = true
		end
	end
	if state.lambdas.size() == 0 && state.transforms.size() == 0 && !state.hash_repl[0] && !generic_methods && state.objects.size() == 0 && !builtin_result_source(state)
		return true
	end
	state.lambda_phase[0] = 1
	resolved := state.function_count[0]
	mut objects := prepare_object_dispatch(state, 0)
	mut function := 0
	while function < state.function_count[0] && !has_diagnostic(state)
		if sparse_integer_at(state.function_lambdas, function) == 0 && !object_abstract_function(state, function)
			if function >= resolved
				mut names := locals_new(state.token_count[0] + 1)
				resolve_function_body(state, function, names)
				declare_default_functions(state)
			end
			if !has_diagnostic(state)
				mut locals := checked_function_locals(state, function)
				check_function_body(state, function, locals)
				declare_default_functions(state)
			end
		end
		objects = prepare_object_dispatch(state, objects)
		function += 1
	end
	if !declare_object_witnesses(state)
		return false
	end
	if has_diagnostic(state)
		return false
	end
	function = 0
	while function < state.function_count[0]
		encoded := sparse_integer_at(state.checked_body_indices, function)
		if encoded > 0
			previous := state.checked_bodies[encoded - 1]
			state.checked_bodies[encoded - 1] = checked_body_lowering(previous, function, previous.resolved_names.origin, previous.resolved_names.limit[0])
		end
		function += 1
	end
	state.lambda_phase[0] = 2
	return true
end

def finalize_checked_module(mut state: CompilerState): Boolean
	if !has_diagnostic(state)
		mir_refine_scalar_call_effects(state.scalar_mir)
		mut mir_error := verify_mir(state.scalar_mir, false)
		if mir_error == ""
			optimize_verified_mir(state.scalar_mir)
			mir_error = verify_mir(state.scalar_mir, true)
		end
		if mir_error != ""
			diagnostic(state, "TRBN4004", 1, mir_error)
		end
	end
	if !has_diagnostic(state)
		checked_hash_verify(state)
	end
	if !has_diagnostic(state)
		validate_import_usage(state)
	end
	return !has_diagnostic(state)
end
