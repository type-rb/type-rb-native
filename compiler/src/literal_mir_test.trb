import { check } from compiler
import { compiler_test_instruction_with_cell } from compiler_test
import { managed_mir_test_fixture } from hash_value_mir_test
import { logical_checked_source } from logical_test
import { literal_integer_type, literal_string_type } from literal_types
import { union_type } from union_types
import { mir_managed_type, mir_storage_type_name } from mir_types
import { mir_instruction_effects } from mir_roots
import { verify_mir } from mir_verifier
import { MirType } from mir
import { CompilerState } from state
import { describe, expect, test } from trb/std/test

def literal_mir_state(): CompilerState
	mut state := logical_checked_source("def read(value: \"held\"): String\nreturn value\nend\ndef main()\nvalue: 201 := 201\nputs(value + 1)\nputs(read(\"held\"))\nend\n")
	expect(check(state)).to_be_true()
	expect(verify_mir(state.scalar_mir, true)).to_equal("")
	return state
end

describe("Literal constraints and discriminant MIR") do
	test("canonicalizes constraints and subsumes literals without delimiter ambiguity") do
		expect(literal_integer_type("-0")).to_equal(literal_integer_type("0"))
		expect(literal_integer_type("2_01")).to_equal(literal_integer_type("201"))
		expect(literal_integer_type("9007199254740992")).to_equal("")
		text := literal_string_type("a,?>")
		expect(union_type([text, "String"])).to_equal("String")
		expect(union_type([literal_integer_type("201"), "Integer"])).to_equal("Integer")
		expect(union_type([literal_integer_type("201"), "Float"])).to_equal("Float")
	end
	test("executes literal signatures containers and nominal values from erased MIR") do
		managed_mir_test_fixture("literal-values-mir", 4)
	end
	test("preserves overlapping discriminants closures and else narrowing after collection") do
		managed_mir_test_fixture("literal-discriminants-mir", 6)
	end
	test("preserves literal keys ordered collections and mixed exhaustive cases after source erasure") do
		managed_mir_test_fixture("literal-collections-mir", 2)
	end
	test("retains semantic identities with scalar storage and no extra allocation") do
		state := literal_mir_state()
		mut constraints := 0
		state.scalar_mir.types.each.with_index do |row, index|
			if row.kind == 12
				constraints += 1
				expect(mir_storage_type_name(state.scalar_mir, index + 9) == "String" || mir_storage_type_name(state.scalar_mir, index + 9) == "Integer").to_be_true()
				expect(mir_managed_type(state.scalar_mir, index + 9)).to_equal(row.element == 8)
			end
		end
		expect(constraints).to_equal(2)
		mut operations := 0
		state.scalar_mir.instructions.each do |instruction|
			if instruction.kind == 57 || instruction.kind == 58
				operations += 1
				expect(mir_instruction_effects(state.scalar_mir, instruction)).to_equal(0)
			end
		end
		expect(operations >= 4).to_be_true()
	end
	test("rejects forged constants widening operands tags and payload identities") do
		mut state := literal_mir_state()
		state.scalar_mir.instructions.each.with_index do |instruction, index|
			if instruction.kind == 57 || instruction.kind == 58
				[1, 2, 3, 4, 5].each do |cell|
					state.scalar_mir.instructions[index] = compiler_test_instruction_with_cell(instruction, cell, 999999)
					expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
				end
				state.scalar_mir.instructions[index] = instruction
			end
		end
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
	end
	test("rejects malformed literal constraints and physical type tables") do
		mut state := literal_mir_state()
		state.scalar_mir.types.each.with_index do |row, index|
			if row.kind == 12
				state.scalar_mir.types[index] = MirType.new(kind: row.kind, name: row.name, element: 5, key: row.key, declaration: row.declaration)
				expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
				state.scalar_mir.types[index] = MirType.new(kind: row.kind, name: "LiteralInteger#9007199254740992", element: row.element, key: row.key, declaration: row.declaration)
				expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
				state.scalar_mir.types[index] = row
			end
		end
	end
	test("rejects a valid String payload that differs from its singleton identity") do
		mut state := literal_mir_state()
		mut tested := false
		state.scalar_mir.instructions.each do |instruction|
			if instruction.kind == 57 && instruction.first == 8
				original := state.scalar_mir.literal_texts[instruction.payload]
				state.scalar_mir.literal_texts[instruction.payload] = "different"
				expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
				state.scalar_mir.literal_texts[instruction.payload] = original
				tested = true
			end
		end
		expect(tested).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
	end
	test("rejects a Hash key whose storage type erases its singleton constraint") do
		mut state := logical_checked_source("def main()\nkey: \"held\" := \"held\"\nvalues := {key => 2}\nputs(values[key])\nend\n")
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		mut tested := false
		state.scalar_mir.types.each.with_index do |row, index|
			if row.kind == 3
				expect(row.key >= 9).to_be_true()
				state.scalar_mir.types[index] = MirType.new(kind: row.kind, name: row.name, element: row.element, key: 8, declaration: row.declaration)
				expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
				state.scalar_mir.types[index] = row
				tested = true
			end
		end
		expect(tested).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
	end
end
