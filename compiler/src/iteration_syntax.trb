# Immutable source regions recorded before receiver types or loop owners exist.
record IterationSyntax
	origin: Integer
	receiver_finish: Integer
	slice_start: Integer
	slice_finish: Integer
	element_origin: Integer
	second_origin: Integer
	body_start: Integer
	body_finish: Integer
	finish: Integer
end

def iteration_syntax_valid(plan: IterationSyntax, origin: Integer, token_count: Integer): Boolean
	if token_count <= 0 || plan.origin != origin || origin < 0 || plan.receiver_finish < origin
		return false
	end
	if plan.element_origin <= plan.receiver_finish || plan.body_start <= plan.element_origin
		return false
	end
	if plan.slice_start >= 0
		if plan.slice_start <= plan.receiver_finish + 2 || plan.slice_finish <= plan.slice_start || plan.slice_finish >= plan.element_origin
			return false
		end
	elsif plan.slice_start != - 1 || plan.slice_finish != - 1
		return false
	end
	if plan.second_origin >= 0
		if plan.second_origin <= plan.element_origin || plan.second_origin >= plan.body_start
			return false
		end
	elsif plan.second_origin != - 1
		return false
	end
	if plan.body_finish < plan.body_start || plan.body_finish >= token_count - 1
		return false
	end
	return plan.finish == plan.body_finish + 1
end
