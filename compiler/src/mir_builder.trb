import { array_region_operation, mir_add_value } from checked_values
import { MirFunction, mir_control_value_type, mir_instruction_with_payload, mir_type_id } from mir
import { mir_block } from mir_construction
import { mir_control_active, mir_control_commit } from mir_control
import { array_element_type } from resolution
import { CheckedLocals, CompilerState } from state
import { load_integer, load_string, store_integer } from storage

def scalar_mir_begin(
		mut state: CompilerState,
		function_index: Integer,
		mut locals: CheckedLocals,
	)
	locals.mir_state[1] = function_index
	result_type := load_string(state.function_result_types, function_index)
	mut mode := 1
	if mir_type_id(result_type) == 0
		if result_type != "Void"
			return
		end
	end
	parameter_start := load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + load_integer(state.function_parameter_counts, function_index)
	if parameter_finish - parameter_start == 1
		parameter_type := load_string(state.parameter_types, parameter_start)
		if result_type == "Void" && array_element_type(parameter_type) != ""
			mode = 2
		end
		if array_element_type(parameter_type) == result_type
			mode = 3
		end
	end
	if mode >= 2
		if parameter_finish - parameter_start != 1
			return
		end
		if array_element_type(load_string(state.parameter_types, parameter_start)) == ""
			return
		end
	end
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		if load_integer(state.parameter_mutable, parameter_index) != 0
			type_id := mir_type_id(load_string(state.parameter_types, parameter_index))
			if !mir_control_value_type(type_id)
				return
			end
		end
		if mir_type_id(load_string(state.parameter_types, parameter_index)) == 0
			return
		end
		parameter_index += 1
	end
	locals.mir_state[0] = mode
	locals.mir_state[2] = 0
	locals.mir_state[3] = function_index * 2 + 1
	if mode >= 2
		locals.mir_state[3] = function_index * 6 + 4
		locals.mir_state[11] = function_index * 6 + 5
	end
	locals.mir_state[4] =- 1
	return
end

def mir_add_parameter(
		mut state: CompilerState,
		mut locals: CheckedLocals,
		parameter_index: Integer,
	)
	type_name := load_string(state.parameter_types, parameter_index)
	mut tag := 0
	if array_element_type(type_name) != ""
		tag = 1 + load_integer(state.parameter_mutable, parameter_index)
	end
	array_region_operation(locals, 1, tag, parameter_index)
	if locals.mir_state[0] == 0
		return
	end
	value_id := mir_add_value(
		state, locals, mir_type_id(type_name), load_integer(state.parameter_lines, parameter_index),
	)
	store_integer(locals.mir_values, locals.count[0] - 1, value_id + 1)
	return
end

def scalar_mir_commit(
		mut state: CompilerState,
		function_index: Integer,
		mut locals: CheckedLocals,
	): String
	if locals.mir_state[0] == 0
		return ""
	end
	if mir_control_active(locals)
		return mir_control_commit(state, function_index, locals)
	end
	mut native_module := state.scalar_mir
	mode := locals.mir_state[0]
	return_value := locals.mir_state[4]
	if mode == 1
		if return_value < 0
			return "scalar MIR function has no return value"
		end
	else
		if mode == 2
			if return_value != - 2
				return "control-flow MIR function is incomplete"
			end
		else
			if return_value != locals.mir_state[16]
				return "control-flow MIR reduction is incomplete"
			end
		end
	end
	source := state.active_module[0]
	line := load_integer(state.function_lines, function_index)
	parameter_count := load_integer(state.function_parameter_counts, function_index)
	mut entry_block := function_index * 2
	mut block_count := 2
	if mode >= 2
		entry_block = function_index * 6
		block_count = 6
	end
	argument_base := native_module.arguments.size()
	block_base := native_module.blocks.size()
	instruction_base := native_module.instructions.size()
	literal_base := native_module.literal_texts.size()
	if native_module.functions.size() == 0
		mut source_count := state.module_count[0]
		if source_count == 0
			source_count = 1
		end
		native_module.source_count[0] = source_count
		native_module.entry_function[0] = function_index
	end
	mut kind := 1
	if mode >= 2
		kind = 2
	end
	native_module.functions.push(MirFunction.new(kind: kind, result_type: load_string(state.function_result_types, function_index), integer_guard: 0, id: function_index, entry_block: entry_block, source_id: source, line: line, parameter_start: argument_base, parameter_count: parameter_count, block_start: block_base, block_count: block_count))
	mut index := 0
	while index < parameter_count
		native_module.arguments.push(index)
		index += 1
	end
	index = 0
	while index < locals.mir_value_rows.size()
		native_module.values.push(locals.mir_value_rows[index])
		index += 1
	end
	index = 0
	while index < locals.mir_literal_texts.size()
		native_module.literal_texts.push(locals.mir_literal_texts[index])
		index += 1
	end
	instruction_count := locals.mir_instructions.size()
	index = 0
	while index < instruction_count
		# Checking is complete: transfer the function-owned instruction.
		# Relocate a literal payload without mutating the function-local record.
		mut instruction := locals.mir_instructions[index]
		if instruction.kind == 6
			instruction = mir_instruction_with_payload(instruction, instruction.payload + literal_base)
		end
		native_module.instructions.push(instruction)
		index += 1
	end
	if mode >= 2
		header_block := entry_block + 1
		body_block := entry_block + 2
		exit_block := entry_block + 3
		header_parameters := native_module.arguments.size()
		native_module.arguments.push(locals.mir_state[12] - 1)
		mut block_parameter_count := 1
		if mode == 3
			native_module.arguments.push(locals.mir_state[14])
			block_parameter_count = 2
		end
		body_parameters := native_module.arguments.size()
		native_module.arguments.push(locals.mir_state[12])
		if mode == 3
			native_module.arguments.push(locals.mir_state[15])
		end
		exit_parameters := native_module.arguments.size()
		mut exit_parameter_count := 0
		if mode == 3
			native_module.arguments.push(locals.mir_state[16])
			exit_parameter_count = 1
		end
		entry_argument := native_module.arguments.size()
		native_module.arguments.push(locals.mir_instructions[0].result)
		if mode == 3
			native_module.arguments.push(locals.mir_instructions[1].result)
		end
		body_argument := native_module.arguments.size()
		native_module.arguments.push(locals.mir_state[12] - 1)
		if mode == 3
			native_module.arguments.push(locals.mir_state[14])
		end
		exit_argument := native_module.arguments.size()
		if mode == 3
			native_module.arguments.push(locals.mir_state[14])
		end
		backedge_argument := native_module.arguments.size()
		native_module.arguments.push(locals.mir_state[10])
		if mode == 3
			native_module.arguments.push(locals.mir_state[17])
		end
		native_module.blocks.push(mir_block(
				entry_block, source, line, entry_argument, 0,
				instruction_base, locals.mir_state[6],
				1, - 1, header_block, - 1, entry_argument, block_parameter_count, 0, 0, - 1,
			))
		native_module.blocks.push(mir_block(
				header_block, source, line, header_parameters, block_parameter_count,
				instruction_base + locals.mir_state[6], locals.mir_state[8],
				2, locals.mir_state[7], body_block, exit_block,
				body_argument, block_parameter_count, exit_argument, exit_parameter_count, - 1,
			))
		native_module.blocks.push(mir_block(
				body_block, source, line, body_parameters, block_parameter_count,
				instruction_base + locals.mir_state[9], instruction_count - locals.mir_state[9],
				1, - 1, header_block, - 1, backedge_argument, block_parameter_count, 0, 0, - 1,
			))
		native_module.blocks.push(mir_block(
				exit_block, source, line, exit_parameters, exit_parameter_count,
				instruction_base + instruction_count, 0,
				3, - 1, - 1, - 1, 0, 0, 0, 0, return_value,
			))
		native_module.blocks.push(mir_block(
				locals.mir_state[3], source, line, 0, 0,
				instruction_base + instruction_count, 0,
				4, - 1, - 1, - 1, 0, 0, 0, 0, - 1,
			))
		native_module.blocks.push(mir_block(
				locals.mir_state[11], source, line, 0, 0,
				instruction_base + instruction_count, 0,
				4, - 1, - 1, - 1, 0, 0, 0, 0, - 1,
			))
		return ""
	end
	native_module.blocks.push(mir_block(
			entry_block,
			source,
			line,
			argument_base + parameter_count,
			0,
			instruction_base,
			instruction_count,
			3,
			- 1,
			- 1,
			- 1,
			0,
			0,
			0,
			0,
			return_value,
		))
	native_module.blocks.push(mir_block(
			locals.mir_state[3],
			source,
			line,
			argument_base + parameter_count,
			0,
			instruction_base + instruction_count,
			0,
			4,
			- 1,
			- 1,
			- 1,
			0,
			0,
			0,
			0,
			- 1,
		))
	return ""
end
