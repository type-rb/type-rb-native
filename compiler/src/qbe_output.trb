import { StringStorage, load_string, store_string, string_storage } from storage

record QbeOutput
	mir_literal_symbols: Array<String>
	# Zero-origin append-only lines own the single alias-visible length.
	lines: StringStorage
	runtime_flags: Array<Integer>
end

def qbe_output_new(capacity: Integer, runtime_flags: Array<Integer>): QbeOutput
	return QbeOutput.new(mir_literal_symbols: [], lines: string_storage(capacity), runtime_flags: runtime_flags)
end

def qbe_output_line(mut output: QbeOutput, line: String)
	index := output.lines.used[0]
	# Emission size follows MIR expansion, not a guessed source-token multiple.
	if index >= output.lines.limit[0]
		output.lines.limit[0] = index + 1024
	end
	store_string(output.lines, index, line)
	return
end

def qbe_output_branch(
		mut output: QbeOutput,
		condition: String,
		when_true: String,
		when_false: String,
	)
	qbe_output_line(output, "\tjnz " + condition + ", " + when_true + ", " + when_false)
	return
end

# Preserve complete lines, including embedded newlines, while bounding copying
# between stdout writes. A single oversized line is emitted without splitting.
# Balance concatenation so each line is copied at most once per tree level.
def qbe_output_join(parts: Array<String>, start: Integer, finish: Integer): String
	if finish - start == 1
		return parts[start]
	end
	middle := start + (finish - start) / 2
	return qbe_output_join(parts, start, middle) + qbe_output_join(parts, middle, finish)
end

def qbe_output_chunk(output: QbeOutput, mut position: Array<Integer>): String
	first := load_string(output.lines, position[0])
	mut parts: Array<String> := [first]
	mut length := first.size()
	# Indexed writes must also fit the snapshot v4 recovery subset.
	position[0] = position[0] + 1
	while position[0] < output.lines.used[0]
		following := load_string(output.lines, position[0])
		if length + following.size() + 1 > 4096
			return qbe_output_join(parts, 0, parts.size())
		end
		parts.push("\n" + following)
		length += following.size() + 1
		position[0] = position[0] + 1
	end
	return qbe_output_join(parts, 0, parts.size())
end

def qbe_output_append(mut output: QbeOutput, appended: QbeOutput)
	mut index := 0
	while index < appended.lines.used[0]
		qbe_output_line(output, load_string(appended.lines, index))
		index += 1
	end
	return
end
