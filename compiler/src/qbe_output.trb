import { Gate4StringStorage, gate4_load_string, gate4_store_string, gate4_string_storage } from storage

record QbeOutput
	lines: Gate4StringStorage
	count: Array<Integer>
	runtime_flags: Array<Integer>
end

def qbe_output_new(capacity: Integer, runtime_flags: Array<Integer>): QbeOutput
	return QbeOutput.new(lines: gate4_string_storage(capacity), count: [0], runtime_flags: runtime_flags)
end

def qbe_output_line(mut output: QbeOutput, line: String)
	index := output.count[0]
	gate4_store_string(output.lines, index, line)
	output.count[0] = index + 1
	return
end

def qbe_output_branch(
		mut output: QbeOutput,
		condition: String,
		when_true: String,
		when_false: String,
	)
	qbe_output_line(output, "\tjnz " + condition + ", " + when_true + ", " + when_false)
	return
end

def qbe_output_append(mut output: QbeOutput, appended: QbeOutput)
	mut index := 0
	while index < appended.count[0]
		qbe_output_line(output, gate4_load_string(appended.lines, index))
		index += 1
	end
	return
end
