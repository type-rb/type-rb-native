import { QbeOutput, qbe_output_line } from qbe_output

# Query operations use bounded byte spans and allocate no temporary Strings.
# Indexed search visits decoded code points, including replacement characters
# in external byte input. Literal predicates preserve exact byte matching.
def emit_string_query_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction l $trbn_string_before(l %left, l %right) {\n@start\n %left_length_address =l add %left, 8\n %right_length_address =l add %right, 8\n %left_length =l loadl %left_length_address\n %right_length =l loadl %right_length_address\n %left_shorter =w csltl %left_length, %right_length\n jnz %left_shorter, @left_shorter, @right_shorter\n@left_shorter\n jmp @compare\n@right_shorter\n jmp @compare\n@compare\n %length =l phi @left_shorter %left_length, @right_shorter %right_length\n %left_data =l add %left, 24\n %right_data =l add %right, 24\n %comparison =w call $memcmp(l %left_data, l %right_data, l %length)\n %equal =w ceqw %comparison, 0\n jnz %equal, @prefix, @different\n@prefix\n %prefix_before =l extuw %left_shorter\n ret %prefix_before\n@different\n %before =w csltw %comparison, 0\n %result =l extuw %before\n ret %result\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_string_codepoint_query(l %value, l %part, l %mode) {\n@start\n %length_address =l add %value, 8\n %part_length_address =l add %part, 8\n %points_address =l add %value, 16\n %part_points_address =l add %part, 16\n %length =l loadl %length_address\n %part_length =l loadl %part_length_address\n %points =l loadl %points_address\n %part_points =l loadl %part_points_address\n %data =l add %value, 24\n %part_data =l add %part, 24\n %short =w csltl %points, %part_points\n jnz %short, @missing, @empty_check\n@empty_check\n %empty =w ceql %part_points, 0\n jnz %empty, @empty, @initialize\n@empty\n %last =w ceql %mode, 1\n jnz %last, @empty_last, @empty_first\n@empty_first\n ret 0\n@empty_last\n ret %points\n@initialize\n %limit =l sub %points, %part_points\n jmp @search\n@search\n %offset =l phi @initialize 0, @advance %next\n %point =l phi @initialize 0, @advance %next_point\n %best =l phi @initialize -1, @advance %next_best\n %done =w csgtl %point, %limit\n jnz %done, @finish, @candidate\n@candidate\n jmp @compare\n@compare\n %value_offset =l phi @candidate %offset, @matched_point %next_value\n %part_offset =l phi @candidate 0, @matched_point %next_part\n %matched =w ceql %part_offset, %part_length\n jnz %matched, @found, @read\n@read\n %value_address =l add %data, %value_offset\n %part_address =l add %part_data, %part_offset\n %value_remaining =l sub %length, %value_offset\n %part_remaining =l sub %part_length, %part_offset\n %value_scalar =l call $trbn_utf8_scalar(l %value_address, l %value_remaining)\n %part_scalar =l call $trbn_utf8_scalar(l %part_address, l %part_remaining)\n %equal =w ceql %value_scalar, %part_scalar\n jnz %equal, @matched_point, @unmatched\n@matched_point\n %value_width =l call $trbn_utf8_width(l %value_address, l %value_remaining)\n %part_width =l call $trbn_utf8_width(l %part_address, l %part_remaining)\n %next_value =l add %value_offset, %value_width\n %next_part =l add %part_offset, %part_width\n jmp @compare\n@found\n %first =w ceql %mode, 0\n jnz %first, @first_found, @remember\n@first_found\n ret %point\n@remember\n jmp @advance\n@unmatched\n jmp @advance\n@advance\n %next_best =l phi @remember %point, @unmatched %best\n %candidate_address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %candidate_address, l %remaining)\n %next =l add %offset, %width\n %next_point =l add %point, 1\n jmp @search\n@finish\n ret %best\n@missing\n ret -1\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_string_query(l %value, l %part, l %mode) {\n@start\n %length_address =l add %value, 8\n %part_length_address =l add %part, 8\n %points_address =l add %value, 16\n %part_points_address =l add %part, 16\n %length =l loadl %length_address\n %part_length =l loadl %part_length_address\n %points =l loadl %points_address\n %part_points =l loadl %part_points_address\n %data =l add %value, 24\n %part_data =l add %part, 24\n %indexed =w csltl %mode, 2\n jnz %indexed, @validate, @raw\n@validate\n %value_valid =l call $trbn_string_is_utf8(l %value)\n %part_valid =l call $trbn_string_is_utf8(l %part)\n %valid =l and %value_valid, %part_valid\n jnz %valid, @raw, @decoded\n@decoded\n %decoded_offset =l call $trbn_string_codepoint_query(l %value, l %part, l %mode)\n ret %decoded_offset\n@raw\n %short =w csltl %length, %part_length\n jnz %short, @missing, @empty_check\n@empty_check\n %empty =w ceql %part_length, 0\n jnz %empty, @empty, @nonempty\n@empty\n %last_empty =w ceql %mode, 1\n jnz %last_empty, @empty_last, @empty_first\n@empty_first\n ret 0\n@empty_last\n ret %points\n@nonempty\n %limit =l sub %length, %part_length\n %prefix_mode =w ceql %mode, 2\n %suffix_mode =w ceql %mode, 3\n %anchored =w or %prefix_mode, %suffix_mode\n jnz %anchored, @anchor, @initialize\n@anchor\n %suffix =w ceql %mode, 3\n jnz %suffix, @suffix, @prefix\n@prefix\n jmp @compare_anchor\n@suffix\n jmp @compare_anchor\n@compare_anchor\n %anchor_offset =l phi @prefix 0, @suffix %limit\n %anchor_data =l add %data, %anchor_offset\n %comparison =w call $memcmp(l %anchor_data, l %part_data, l %part_length)\n %equal =w ceqw %comparison, 0\n jnz %equal, @empty_first, @missing\n@initialize\n jmp @search\n@search\n %offset =l phi @initialize 0, @step %next\n %point =l phi @initialize 0, @step %next_point\n %best =l phi @initialize -1, @step %next_best\n %done =w csgtl %offset, %limit\n jnz %done, @finish, @compare\n@compare\n %candidate =l add %data, %offset\n %match =w call $memcmp(l %candidate, l %part_data, l %part_length)\n %matched =w ceqw %match, 0\n jnz %matched, @found, @unmatched\n@found\n %first =w cnel %mode, 1\n jnz %first, @first_found, @remember\n@first_found\n %contains =w ceql %mode, 4\n jnz %contains, @empty_first, @index_found\n@index_found\n ret %point\n@remember\n jmp @advance\n@unmatched\n jmp @advance\n@advance\n %next_best =l phi @remember %point, @unmatched %best\n %bytewise =w ceql %mode, 4\n jnz %bytewise, @byte_width, @point_width\n@byte_width\n jmp @step\n@point_width\n %remaining =l sub %length, %offset\n %decoded_width =l call $trbn_utf8_width(l %candidate, l %remaining)\n jmp @step\n@step\n %width =l phi @byte_width 1, @point_width %decoded_width\n %next =l add %offset, %width\n %next_point =l add %point, 1\n jmp @search\n@finish\n ret %best\n@missing\n ret -1\n}\n")
end
