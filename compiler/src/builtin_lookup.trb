import { builtin_lookup_result, builtin_result_variant } from builtin_results
import { CheckedValue, checked_mir_value, checked_value, scalar_mir_binary, scalar_mir_literal } from checked_values
import { mir_enum_construct } from enum_mir
import { hash_value_type } from hash_types
import { mir_checked_array_operation } from mir_arrays
import { mir_control_active, mir_control_branch, mir_control_enter, mir_control_prepare } from mir_control
import { mir_checked_hash_method, mir_checked_hash_operation } from mir_hashes
import { mir_checked_range_field } from mir_ranges
import { mir_checked_record_new } from mir_records
import { mir_checked_string_operation } from mir_strings
import { mir_value_complete, mir_value_exit, mir_value_join, mir_value_select } from mir_value_control
import { mir_nullable_coerce } from nullable_mir
import { raw_enum_literal } from raw_enum_checked
import { array_element_type, find_record_type } from type_resolution
import { CompilerState } from state
import { CheckedLocals } from local_state
import { load_integer, load_string, store_string } from storage

def mir_builtin_error(mut state: CompilerState, mut locals: CheckedLocals, result_type: String, fields: Array<CheckedValue>, origin: Integer): CheckedValue
	err := builtin_result_variant(state, result_type, false)
	error_type := state.nominal.enum_fields[state.nominal.enum_variants[err].field_start].type_name
	record_index := find_record_type(state, error_type)
	start := load_integer(state.declarations.record_field_starts, record_index)
	mut values: Array<Integer> := []
	fields.each.with_index do |field, index|
		converted := mir_nullable_coerce(state, locals, field, load_string(state.declarations.field_types, start + index), origin)
		values.push(checked_mir_value(converted))
	end
	error := mir_checked_record_new(state, locals, record_index, error_type, values, origin)
	return mir_enum_construct(state, locals, err, [checked_mir_value(error)], origin)
end

# Negative normalization is conditional: adding a large positive index to size
# eagerly would overflow even though the safe operation should return Err.
def mir_safe_lookup_index(mut state: CompilerState, mut locals: CheckedLocals, index: CheckedValue, size: CheckedValue, origin: Integer): CheckedValue
	line := load_integer(state.source_tokens.token_lines, origin)
	zero := scalar_mir_literal(state, locals, "Integer", origin, "0")
	negative := scalar_mir_binary(state, locals, "<", index, zero, "Boolean", origin)
	mut join := mir_value_join(locals, line)
	alternate := mir_control_branch(state, locals, negative, line)
	normalized := scalar_mir_binary(state, locals, "+", index, size, "Integer", origin)
	mir_value_exit(state, locals, join, normalized)
	mir_control_enter(state, locals, alternate, line)
	mir_value_exit(state, locals, join, index)
	return mir_value_complete(state, locals, join, "Integer", origin)
end

# Safe lookup and slicing are ordinary typed comparisons, branches, reads and
# Result/record construction. QBE receives no method names or source decisions.
def mir_builtin_lookup(mut state: CompilerState, mut locals: CheckedLocals, kind: Integer, receiver: CheckedValue, argument: CheckedValue, origin: Integer): CheckedValue
	result_type := builtin_lookup_result(state, receiver.type_name, kind)
	store_string(state.callables.checked[0].builtin_result_types, origin, result_type)
	mir_control_prepare(state, locals)
	if !mir_control_active(locals)
		return checked_value(result_type, 0, origin, 0)
	end
	line := load_integer(state.source_tokens.token_lines, origin)
	mut fields: Array<CheckedValue> := []
	mut size := checked_value("Integer", 0, origin, 0)
	mut present := checked_value("Boolean", 0, origin, 0)
	mut position := checked_value("Integer", 0, origin, 0)
	mut label := "Array"
	if receiver.type_name == "String"
		label = "String"
		size = mir_checked_string_operation(state, locals, 15, checked_mir_value(receiver), - 1, 0, "Integer", origin)
	elsif kind != 3
		size = mir_checked_array_operation(state, locals, 20, checked_mir_value(receiver), - 1, 0, "Integer", origin)
	end
	if kind == 3
		present = mir_checked_hash_method(state, locals, receiver, checked_mir_value(argument), 5, "Boolean", origin)
		fields.push(argument)
		fields.push(raw_enum_literal(state, locals, "String", "Hash key is missing", origin))
	elsif kind == 1
		position = mir_safe_lookup_index(state, locals, argument, size, origin)
		zero := scalar_mir_literal(state, locals, "Integer", origin, "0")
		low := scalar_mir_binary(state, locals, ">=", position, zero, "Boolean", origin)
		high := scalar_mir_binary(state, locals, "<", position, size, "Boolean", origin)
		no := scalar_mir_literal(state, locals, "Boolean", origin, "false")
		present = mir_value_select(state, locals, low, high, no, origin)
		fields.push(argument)
		fields.push(size)
		fields.push(raw_enum_literal(state, locals, "String", label + " index is out of bounds", origin))
	else
		first := mir_checked_range_field(state, locals, checked_mir_value(argument), 0, origin)
		finish := mir_checked_range_field(state, locals, checked_mir_value(argument), 1, origin)
		exclusive := mir_checked_range_field(state, locals, checked_mir_value(argument), 2, origin)
		zero := scalar_mir_literal(state, locals, "Integer", origin, "0")
		low := scalar_mir_binary(state, locals, ">=", first, zero, "Boolean", origin)
		ordered := scalar_mir_binary(state, locals, "<=", first, finish, "Boolean", origin)
		inclusive_end := scalar_mir_binary(state, locals, "<", finish, size, "Boolean", origin)
		exclusive_end := scalar_mir_binary(state, locals, "<=", finish, size, "Boolean", origin)
		last := mir_value_select(state, locals, exclusive, exclusive_end, inclusive_end, origin)
		no := scalar_mir_literal(state, locals, "Boolean", origin, "false")
		upper := mir_value_select(state, locals, ordered, last, no, origin)
		present = mir_value_select(state, locals, low, upper, no, origin)
		fields.push(first)
		fields.push(finish)
		fields.push(exclusive)
		fields.push(size)
		fields.push(raw_enum_literal(state, locals, "String", label + " slice range is out of bounds", origin))
	end
	mut join := mir_value_join(locals, line)
	alternate := mir_control_branch(state, locals, present, line)
	mut value := checked_value("Invalid", 0, origin, 0)
	if kind == 3
		value = mir_checked_hash_operation(state, locals, 28, checked_mir_value(receiver), checked_mir_value(argument), 0, hash_value_type(receiver.type_name), origin)
	elsif kind == 2
		if receiver.type_name == "String"
			value = mir_checked_string_operation(state, locals, 46, checked_mir_value(receiver), checked_mir_value(argument), 0, "String", origin)
		else
			value = mir_checked_array_operation(state, locals, 47, checked_mir_value(receiver), checked_mir_value(argument), 2, receiver.type_name, origin)
		end
	elsif receiver.type_name == "String"
		value = mir_checked_string_operation(state, locals, 16, checked_mir_value(receiver), checked_mir_value(position), 0, "String", origin)
	else
		value = mir_checked_array_operation(state, locals, 22, checked_mir_value(receiver), checked_mir_value(position), 0, array_element_type(receiver.type_name), origin)
	end
	ok := builtin_result_variant(state, result_type, true)
	success := mir_enum_construct(state, locals, ok, [checked_mir_value(value)], origin)
	mir_value_exit(state, locals, join, success)
	mir_control_enter(state, locals, alternate, line)
	error := mir_builtin_error(state, locals, result_type, fields, origin)
	mir_value_exit(state, locals, join, error)
	return mir_value_complete(state, locals, join, result_type, origin)
end
