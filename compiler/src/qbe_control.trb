import { emit_mir_callable } from qbe_callables
import { emit_mir_enum_instruction } from qbe_enums
import { emit_mir_nullable_instruction } from qbe_nullable
import { emit_mir_range_instruction } from qbe_ranges
import { emit_mir_hash_instruction } from qbe_hashes
import { emit_mir_record_instruction } from qbe_records
import { emit_mir_array_headers, emit_mir_array_instruction } from qbe_arrays
import { mir_semantic_type_name } from mir_types
import { integer_string } from literals
import { MirFunction, mir_block_index, mir_function_index } from mir
import { mir_numeric_find, mir_numeric_operation } from mir_numeric
import { QbeEmitContext, emit_label, emit_temporary, emit_typed_store, emitted_value, qbe_type } from qbe_context
import { emit_mir_scalar_instruction, emit_scalar_mir } from qbe_mir
import { QbeOutput, qbe_output_branch, qbe_output_line } from qbe_output
import { emit_mir_roots, qbe_root_plan_start } from qbe_roots
import { emit_mir_string_instruction } from qbe_strings
import { CompilerState } from state

# The adapter consumes block parameters and typed operands. Edge copies are
# parallel assignments: capture every source before changing a destination.
def emit_control_mir_edge(state: CompilerState, function: MirFunction, target: Integer, start: Integer, count: Integer, operands: Array<String>, types: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput)
	block := state.scalar_mir.blocks[mir_block_index(state.scalar_mir, function, target)]
	mut captured: Array<String> := []
	mut index := 0
	while index < count
		value := state.scalar_mir.arguments[start + index]
		temporary := emit_temporary(context)
		qbe_output_line(output, "\t" + temporary + " =" + qbe_type(types[value]) + " copy " + operands[value])
		captured.push(temporary)
		index += 1
	end
	index = 0
	while index < count
		value := state.scalar_mir.arguments[block.parameter_start + index]
		qbe_output_line(output, "\t" + operands[value] + " =" + qbe_type(types[value]) + " copy " + captured[index])
		index += 1
	end
	qbe_output_line(output, "\tjmp @mir_" + integer_string(target))
end

def emit_control_mir(state: CompilerState, function_index: Integer, result_type: String, symbols: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput)
	function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, function_index)]
	roots := state.scalar_mir.root_plans[mir_function_index(state.scalar_mir, function_index)]
	numeric := mir_numeric_find(state.scalar_mir.numeric_plans[0], function_index, - 1, - 1)
	array_loops := state.scalar_mir.array_loops[mir_function_index(state.scalar_mir, function_index)]
	mut operands: Array<String> := []
	mut types: Array<String> := []
	mut value_types: Array<Integer> := []
	state.scalar_mir.values.each do |value|
		if value.function_id == function_index
			while operands.size() <= value.id
				operands.push("")
				types.push("")
				value_types.push(0)
			end
			operands[value.id] = "%mir_value" + integer_string(value.id)
			value_types[value.id] = value.type_id
			types[value.id] = mir_semantic_type_name(state.scalar_mir, value.type_id)
		end
	end
	mut index := 0
	while index < function.parameter_count
		value := state.scalar_mir.arguments[function.parameter_start + index]
		operands[value] = "%p" + integer_string(index)
		index += 1
	end
	qbe_output_line(output, "\tjmp @mir_" + integer_string(function.entry_block))
	mut block_index := function.block_start
	while block_index < function.block_start + function.block_count
		block := state.scalar_mir.blocks[block_index]
		qbe_output_line(output, "@mir_" + integer_string(block.id))
		index = block.instruction_start
		mut point := qbe_root_plan_start(roots.instructions, index)
		while index < block.instruction_start + block.instruction_count
			instruction := state.scalar_mir.instructions[index]
			while point < roots.instructions.size()
				if roots.instructions[point] != index
					break
				end
				emit_mir_roots(roots.roots[point], operands, context, output)
				point += 1
			end
			mut value := emitted_value("", "Void")
			if instruction.kind == 43
				valid := emit_label(context)
				failed := emit_label(context)
				qbe_output_branch(output, operands[instruction.first], valid, failed)
				qbe_output_line(output, failed)
				qbe_output_line(output, "\tcall $trbn_fail(l $trbn_clamp_error, l 37)")
				qbe_output_line(output, "\tjmp @mir_" + integer_string(instruction.failure))
				qbe_output_line(output, valid)
			elsif instruction.kind == 41 || instruction.kind == 42
				value = emit_mir_callable(state, value_types, instruction, operands, context, output)
			elsif instruction.kind >= 37 && instruction.kind <= 40
				value = emit_mir_enum_instruction(state, value_types, instruction, operands, context, output)
			elsif instruction.kind >= 33 && instruction.kind <= 36
				value = emit_mir_nullable_instruction(state, value_types, instruction, operands, context, output)
			elsif instruction.kind == 31 || instruction.kind == 32
				value = emit_mir_range_instruction(state, value_types, instruction, operands, context, output)
			elsif instruction.kind >= 27 && instruction.kind <= 30
				value = emit_mir_hash_instruction(state, value_types, instruction, operands, context, output)
			elsif instruction.kind == 25 || instruction.kind == 26
				value = emit_mir_record_instruction(state, value_types, instruction, operands, context, output)
			elsif instruction.kind >= 19 && instruction.kind <= 24
				value = emit_mir_array_instruction(state, value_types, instruction, index, array_loops, operands, context, output)
			elsif(instruction.kind >= 12 && instruction.kind <= 18) || instruction.kind == 44 || instruction.kind == 45
				value = emit_mir_string_instruction(state, value_types, instruction, operands, symbols, context, output)
			elsif instruction.kind == 11
				call_plan := mir_numeric_find(state.scalar_mir.numeric_plans[0], - 1, function.id, index)
				if call_plan.function_id >= 0
					call := state.scalar_mir.calls[instruction.payload]
					mut arguments: Array<String> := []
					mut argument_types: Array<String> := []
					mut argument := 0
					while argument < call.argument_count
						id := state.scalar_mir.arguments[call.argument_start + argument]
						arguments.push(operands[id])
						argument_types.push(types[id])
						argument += 1
					end
					value = emit_scalar_mir(state, call_plan.function_id, arguments, argument_types, call_plan, context, output, true)
				else
					value = emit_mir_scalar_instruction(state, function_index, instruction, operands, types, mir_numeric_operation(numeric, index), context, output, false)
				end
			else
				value = emit_mir_scalar_instruction(state, function_index, instruction, operands, types, mir_numeric_operation(numeric, index), context, output, false)
			end
			if instruction.result >= 0
				# Stable MIR names allow a dominating definition in any storage order.
				qbe_output_line(output, "\t" + operands[instruction.result] + " =" + qbe_type(types[instruction.result]) + " copy " + value.operand)
			end
			index += 1
		end
		emit_mir_array_headers(array_loops, block.id, operands, context, output)
		if block.terminator == 1
			emit_control_mir_edge(state, function, block.first_target, block.first_argument_start, block.first_argument_count, operands, types, context, output)
		elsif block.terminator == 2
			first := emit_label(context)
			second := emit_label(context)
			qbe_output_branch(output, operands[block.condition], first, second)
			qbe_output_line(output, first)
			emit_control_mir_edge(state, function, block.first_target, block.first_argument_start, block.first_argument_count, operands, types, context, output)
			qbe_output_line(output, second)
			emit_control_mir_edge(state, function, block.second_target, block.second_argument_start, block.second_argument_count, operands, types, context, output)
		elsif block.terminator == 3
			if result_type != "Void"
				emit_typed_store(output, result_type, operands[block.return_value], "%return_value")
			end
			qbe_output_line(output, "\tjmp @return")
		else
			qbe_output_line(output, "\tcall $trbn_fail(l $trbn_integer_range_error, l 45)")
			qbe_output_line(output, "\thlt")
		end
		block_index += 1
	end
end
