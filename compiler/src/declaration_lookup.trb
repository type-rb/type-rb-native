	if local >= 0
		return local
	end
	binding := find_import_binding(state, source, name)
	if binding < 0
		return - 1
	end
	resolved := find_alias_in_module(state, load_integer(state.import_targets, binding), load_string(state.import_declarations, binding))
	if resolved >= 0
		store_integer(state.import_used, binding, 1)
	end
	return resolved
end
