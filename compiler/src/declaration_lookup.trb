def find_generic_function_in_module(state: CompilerState, source: Integer, name: String): Integer
	mut index := state.generic_functions.size() - 1
	while index >= 0
		row := state.generic_functions[index]
		if row.source_id == source && row.name == name
			return index
		end
		index -= 1
	end
	return - 1
end

def find_visible_generic_function(mut state: CompilerState, source: Integer, name: String): Integer
	local := find_generic_function_in_module(state, source, name)
	if local >= 0
		return local
	end
	binding := find_import_binding(state, source, name)
	if binding < 0
		return - 1
	end
	resolved := find_generic_function_in_module(state, load_integer(state.import_targets, binding), load_string(state.import_declarations, binding))
	if resolved >= 0
		store_integer(state.import_used, binding, 1)
	end
	return resolved
