def find_alias_in_module(state: CompilerState, source: Integer, name: String): Integer
	mut index := state.type_aliases.size() - 1
	while index >= 0
		row := state.type_aliases[index]
		if row.source_id == source && row.name == name
			return index
		end
		index -= 1
	end
	return - 1
end

def find_visible_alias(mut state: CompilerState, source: Integer, name: String): Integer
