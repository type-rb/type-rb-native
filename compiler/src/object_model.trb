# Authored object declarations retain nominal identity and source spans before
# concrete layouts, initialization proofs and dispatch tables are resolved.
record ObjectField
	name: String
	type_name: String
	line: Integer
	origin: Integer
	readonly: Boolean
	default_start: Integer
	default_finish: Integer
end

record ObjectMethod
	name: String
	class_member: Boolean
	origin: Integer
	function: Integer
	generic_function: Integer
end

record ObjectDefinition
	name: String
	source_id: Integer
	line: Integer
	origin: Integer
	interface_type: Boolean
	parameters: Array<String>
	superclass: String
	interfaces: Array<String>
	fields: Array<ObjectField>
	methods: Array<ObjectMethod>
end

# Concrete instances own resolved edges while authored declarations stay immutable.
# Publish a shell before resolving fields so recursive storage reuses one identity.
record ObjectInstance
	definition: Integer
	arguments: Array<String>
	superclass: Integer
	interfaces: Array<Integer>
	fields: Array<ObjectField>
end

# MIR owns the resolved nominal graph independently of parsed declarations.
# Fields are local to their declaring type; inherited storage retains that owner.
record MirObjectField
	name: String
	type_id: Integer
	line: Integer
	readonly: Boolean
end

record MirObject
	declaration: Integer
	type_id: Integer
	name: String
	source_id: Integer
	line: Integer
	interface_type: Boolean
	superclass: Integer
	interfaces: Array<Integer>
	fields: Array<MirObjectField>
end
