import { QbeOutput, qbe_output_line } from backend/qbe/output

# Raw storage only: no managed allocation, collection, or callbacks. The visible
# object starts after an eight-byte owner prefix. Its GC layout stays unchanged.
# Each 4 KiB page has eight header words: next/previous available page, free cell,
# virgin cursor, capacity, live count, cell stride, and the class head address.
# Full pages leave the available list; empty pages are immediately freed.
def emit_managed_storage_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\ndata $trbn_storage_available = align 8 { z 56 }\n")
	qbe_output_line(output, "\nfunction $trbn_storage_unlink(l %page) {\n@start\n\t%next =l loadl %page\n\t%previous_slot =l add %page, 8\n\t%previous =l loadl %previous_slot\n\t%first =w ceql %previous, 0\n\tjnz %first, @head, @interior\n@head\n\t%head_slot_address =l add %page, 56\n\t%head_slot =l loadl %head_slot_address\n\tstorel %next, %head_slot\n\tjmp @successor\n@interior\n\tstorel %next, %previous\n@successor\n\t%last =w ceql %next, 0\n\tjnz %last, @finish, @link\n@link\n\t%next_previous =l add %next, 8\n\tstorel %previous, %next_previous\n@finish\n\tret\n}\n")
	qbe_output_line(output, "\nfunction $trbn_storage_insert(l %page) {\n@start\n\t%head_slot_address =l add %page, 56\n\t%head_slot =l loadl %head_slot_address\n\t%head =l loadl %head_slot\n\tstorel %head, %page\n\t%previous_slot =l add %page, 8\n\tstorel 0, %previous_slot\n\t%empty =w ceql %head, 0\n\tjnz %empty, @publish, @link\n@link\n\t%head_previous =l add %head, 8\n\tstorel %page, %head_previous\n@publish\n\tstorel %page, %head_slot\n\tret\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_storage_alloc(l %size) {\n@start\n\t%span =l sub %size, 16\n\t%small =w culel %span, 48\n\tjnz %small, @class, @direct\n@direct\n\t%direct =l call $malloc(l %size)\n\tret %direct\n@class\n\t%padded =l add %span, 7\n\t%offset =l and %padded, -8\n\t%head_slot =l add $trbn_storage_available, %offset\n\t%head =l loadl %head_slot\n\t%empty =w ceql %head, 0\n\tjnz %empty, @new_page, @existing\n@new_page\n\t%new_page =l call $malloc(l 4096)\n\t%failed =w ceql %new_page, 0\n\tjnz %failed, @fail, @initialize\n@fail\n\tret 0\n@initialize\n\t%stride =l add %offset, 24\n\t%capacity =l udiv 4032, %stride\n\t%previous_slot =l add %new_page, 8\n\t%free_slot =l add %new_page, 16\n\t%cursor_slot =l add %new_page, 24\n\t%capacity_slot =l add %new_page, 32\n\t%live_slot =l add %new_page, 40\n\t%stride_slot =l add %new_page, 48\n\t%head_slot_address =l add %new_page, 56\n\t%first_cell =l add %new_page, 64\n\tstorel 0, %new_page\n\tstorel 0, %previous_slot\n\tstorel 0, %free_slot\n\tstorel %first_cell, %cursor_slot\n\tstorel %capacity, %capacity_slot\n\tstorel 0, %live_slot\n\tstorel %stride, %stride_slot\n\tstorel %head_slot, %head_slot_address\n\tstorel %new_page, %head_slot\n\tjmp @allocate\n@existing\n\tjmp @allocate\n@allocate\n\t%page =l phi @initialize %new_page, @existing %head\n\t%page_free_slot =l add %page, 16\n\t%free_cell =l loadl %page_free_slot\n\t%has_free =w cnel %free_cell, 0\n\tjnz %has_free, @reuse, @virgin\n@reuse\n\t%free_next_slot =l add %free_cell, 8\n\t%free_next =l loadl %free_next_slot\n\tstorel %free_next, %page_free_slot\n\tjmp @allocated\n@virgin\n\t%page_cursor_slot =l add %page, 24\n\t%virgin_cell =l loadl %page_cursor_slot\n\t%page_stride_slot =l add %page, 48\n\t%page_stride =l loadl %page_stride_slot\n\t%next_cursor =l add %virgin_cell, %page_stride\n\tstorel %next_cursor, %page_cursor_slot\n\tjmp @allocated\n@allocated\n\t%cell =l phi @reuse %free_cell, @virgin %virgin_cell\n\tstorel %page, %cell\n\t%page_live_slot =l add %page, 40\n\t%live =l loadl %page_live_slot\n\t%new_live =l add %live, 1\n\tstorel %new_live, %page_live_slot\n\t%page_capacity_slot =l add %page, 32\n\t%page_capacity =l loadl %page_capacity_slot\n\t%full =w ceql %new_live, %page_capacity\n\tjnz %full, @full, @finish\n@full\n\tcall $trbn_storage_unlink(l %page)\n@finish\n\t%base =l add %cell, 8\n\tret %base\n}\n")
	qbe_output_line(output, "\nfunction $trbn_storage_free(l %base, l %size) {\n@start\n\t%span =l sub %size, 16\n\t%small =w culel %span, 48\n\tjnz %small, @pooled, @direct\n@direct\n\tcall $free(l %base)\n\tret\n@pooled\n\t%cell =l sub %base, 8\n\t%page =l loadl %cell\n\t%live_slot =l add %page, 40\n\t%live =l loadl %live_slot\n\t%remaining =l sub %live, 1\n\tstorel %remaining, %live_slot\n\t%capacity_slot =l add %page, 32\n\t%capacity =l loadl %capacity_slot\n\t%was_full =w ceql %live, %capacity\n\t%empty =w ceql %remaining, 0\n\tjnz %empty, @empty, @retain\n@empty\n\tjnz %was_full, @release, @unlink\n@unlink\n\tcall $trbn_storage_unlink(l %page)\n@release\n\tcall $free(l %page)\n\tret\n@retain\n\t%free_slot =l add %page, 16\n\t%free_head =l loadl %free_slot\n\tstorel %free_head, %base\n\tstorel %cell, %free_slot\n\tjnz %was_full, @available, @finish\n@available\n\tcall $trbn_storage_insert(l %page)\n@finish\n\tret\n}\n\n")
	return
end
