import { QbeOutput, qbe_output_line } from backend/qbe/output

# Foreign trust loading does not enter managed code or allocate GC objects.
# The platform/file selection follows the pinned Go trust adapter policy.
def emit_oidc_trust(mut output: QbeOutput)
	qbe_output_line(output, "data $oidc_root_files = { b \"/etc/ssl/certs/ca-certificates.crt:/etc/pki/tls/certs/ca-bundle.crt:/etc/ssl/ca-bundle.pem:/etc/pki/tls/cacert.pem:/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem:/etc/ssl/cert.pem\", b 0 }\ndata $oidc_root_dirs = { b \"/etc/ssl/certs:/etc/pki/tls/certs\", b 0 }\ndata $oidc_read_mode = { b \"rb\", b 0 }\ndata $oidc_certificate_name = { b \"CERTIFICATE\", b 0 }\nfunction l $oidc_environment(l %name) {\n@start\n %value =l call $getenv(l %name)\n %value_nonzero =w cnel %value, 0\n jnz %value_nonzero, @nonempty, @empty\n@nonempty\n %first =w loadub %value\n jnz %first, @present, @empty\n@present\n ret %value\n@empty\n ret 0\n}\n# PEM decoding and X.509 parsing remain OpenSSL operations. Ignore unrelated\n# blocks, headers and invalid certificates, as AppendCertsFromPEM does.\nfunction w $oidc_ca_file(l %store, l %path) {\n@start\n %bio =l call $BIO_new_file(l %path, l $oidc_read_mode)\n %bio_nonzero =w cnel %bio, 0\n jnz %bio_nonzero, @slots, @missing\n@missing\n call $ERR_clear_error()\n ret 0\n@slots\n %slots =l alloc8 32\n %hp =l add %slots, 8\n %dp =l add %slots, 16\n %lp =l add %slots, 24\n jmp @read\n@read\n call $memset(l %slots, w 0, l 32)\n %parsed =w call $PEM_read_bio(l %bio, l %slots, l %hp, l %dp, l %lp)\n %name =l loadl %slots\n %headers =l loadl %hp\n %bytes =l loadl %dp\n %length =l loadl %lp\n jnz %parsed, @kind, @release\n@kind\n %comparison =w call $strcmp(l %name, l $oidc_certificate_name)\n %right_kind =w ceqw %comparison, 0\n %header =w loadub %headers\n %no_header =w ceqw %header, 0\n %wanted =w and %right_kind, %no_header\n jnz %wanted, @certificate, @release\n@certificate\n %cursor =l alloc8 8\n storel %bytes, %cursor\n %cert =l call $d2i_X509(l 0, l %cursor, l %length)\n %cert_nonzero =w cnel %cert, 0\n jnz %cert_nonzero, @consumed, @release\n@consumed\n %finish =l loadl %cursor\n %expected =l add %bytes, %length\n %complete =w ceql %finish, %expected\n jnz %complete, @add, @free_cert\n@add\n %added =w call $X509_STORE_add_cert(l %store, l %cert)\n jmp @free_cert\n@free_cert\n call $X509_free(l %cert)\n jmp @release\n@release\n call $CRYPTO_free(l %name, l 0, w 0)\n call $CRYPTO_free(l %headers, l 0, w 0)\n call $CRYPTO_free(l %bytes, l 0, w 0)\n call $ERR_clear_error()\n jnz %parsed, @read, @done\n@done\n %closed =w call $BIO_free(l %bio)\n ret 1\n}\nfunction $oidc_ca_directory(l %store, l %path) {\n@start\n %directory =l call $opendir(l %path)\n %directory_nonzero =w cnel %directory, 0\n jnz %directory_nonzero, @prepare, @done\n@prepare\n %darwin =l loadl $trbn_oidc_darwin\n %offset =l add 19, %darwin\n %name_offset =l add %offset, %darwin\n %path_length =l call $strlen(l %path)\n jmp @read\n@read\n %entry =l call $readdir(l %directory)\n %entry_nonzero =w cnel %entry, 0\n jnz %entry_nonzero, @name, @close\n@name\n %name =l add %entry, %name_offset\n %first =w loadub %name\n %dot =w ceqw %first, 46\n jnz %dot, @dot, @join\n@dot\n %secondp =l add %name, 1\n %second =w loadub %secondp\n %single =w ceqw %second, 0\n jnz %single, @read, @double\n@double\n %dot_again =w ceqw %second, 46\n %thirdp =l add %name, 2\n %third =w loadub %thirdp\n %end =w ceqw %third, 0\n %double =w and %dot_again, %end\n jnz %double, @read, @join\n@join\n %name_length =l call $strlen(l %name)\n %combined =l add %path_length, %name_length\n %size =l add %combined, 2\n %file =l call $malloc(l %size)\n %file_nonzero =w cnel %file, 0\n jnz %file_nonzero, @copy, @close\n@copy\n call $memcpy(l %file, l %path, l %path_length)\n %slash =l add %file, %path_length\n storeb 47, %slash\n %leaf =l add %slash, 1\n %leaf_size =l add %name_length, 1\n call $memcpy(l %leaf, l %name, l %leaf_size)\n %read =w call $oidc_ca_file(l %store, l %file)\n call $free(l %file)\n jmp @read\n@close\n %closed =w call $closedir(l %directory)\n jmp @done\n@done\n ret\n}\n# The file list stops at its first readable bundle; every directory is visited.\nfunction $oidc_ca_list(l %store, l %list, w %directories) {\n@start\n %list_nonzero =w cnel %list, 0\n jnz %list_nonzero, @copy, @done\n@copy\n %buffer =l call $strdup(l %list)\n %buffer_nonzero =w cnel %buffer, 0\n jnz %buffer_nonzero, @next, @done\n@next\n %path =l phi @copy %buffer, @advance %next\n %colon =l call $strchr(l %path, w 58)\n %colon_nonzero =w cnel %colon, 0\n jnz %colon_nonzero, @split, @load\n@split\n storeb 0, %colon\n jmp @load\n@load\n %first =w loadub %path\n jnz %first, @kind, @advance\n@kind\n jnz %directories, @directory, @file\n@directory\n call $oidc_ca_directory(l %store, l %path)\n jmp @advance\n@file\n %loaded =w call $oidc_ca_file(l %store, l %path)\n jnz %loaded, @release, @advance\n@advance\n %next =l add %colon, 1\n %colon_nonzero2 =w cnel %colon, 0\n jnz %colon_nonzero2, @next, @release\n@release\n call $free(l %buffer)\n jmp @done\n@done\n ret\n}\nfunction w $oidc_ssl_context(l %curl, l %ssl, l %userdata) {\n@start\n %store =l call $SSL_CTX_get_cert_store(l %ssl)\n %store_nonzero =w cnel %store, 0\n jnz %store_nonzero, @files, @failure\n@files\n %darwin =l loadl $trbn_oidc_darwin\n %file =l call $oidc_environment(l $trbn_oidc_cert_file)\n %file_nonzero =w cnel %file, 0\n jnz %file_nonzero, @explicit, @default_files\n@explicit\n %loaded =w call $oidc_ca_file(l %store, l %file)\n jmp @directories\n@default_files\n %darwin_nonzero =w cnel %darwin, 0\n jnz %darwin_nonzero, @directories, @linux_files\n@linux_files\n call $oidc_ca_list(l %store, l $oidc_root_files, w 0)\n jmp @directories\n@directories\n %dirs =l call $oidc_environment(l $trbn_oidc_cert_dir)\n %dirs_nonzero =w cnel %dirs, 0\n jnz %dirs_nonzero, @explicit_dirs, @default_dirs\n@explicit_dirs\n call $oidc_ca_list(l %store, l %dirs, w 1)\n jmp @done\n@default_dirs\n %darwin_nonzero2 =w cnel %darwin, 0\n jnz %darwin_nonzero2, @done, @linux_dirs\n@linux_dirs\n call $oidc_ca_list(l %store, l $oidc_root_dirs, w 1)\n jmp @done\n@done\n call $ERR_clear_error()\n ret 0\n@failure\n ret 27\n}\nfunction w $oidc_set_trust(l %handle) {\n@start\n %darwin =l loadl $trbn_oidc_darwin\n %file =l call $oidc_environment(l $trbn_oidc_cert_file)\n %directory =l call $oidc_environment(l $trbn_oidc_cert_dir)\n %custom =l or %file, %directory\n %disk =w ceql %darwin, 0\n %has_custom =w cnel %custom, 0\n %on_disk =w or %disk, %has_custom\n jnz %on_disk, @disk, @platform\n@platform\n %native =w call $oidc_setopt(l %handle, w 216, l 16)\n ret %native\n@disk\n %native =w call $oidc_setopt(l %handle, w 216, l 0)\n %callback =w call $oidc_setopt(l %handle, w 20108, l $oidc_ssl_context)\n %result =w or %native, %callback\n ret %result\n}\n")
end
