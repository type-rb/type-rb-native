import { array_backing_offset } from backend/qbe/runtime/array_layout
import { QbeOutput, qbe_output_line } from backend/qbe/output
import { integer_string } from support/literals

# Compact only after at least as many elements were removed as remain. A
# nearly full FIFO therefore grows once instead of copying on every push.
# Realloc receives the owned base; its returned address supplies the source
# after a moving realloc. Only the vacated live range needs clearing.
def emit_array_growth_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function l $trbn_array_make_room(l %array, l %length, l %capacity, l %growth_shift, w %paced) {\n@start\n %data_slot =l add %array, 24\n %data =l loadl %data_slot\n %backing_slot =l add %array, " + integer_string(array_backing_offset()) + "\n %base =l loadl %backing_slot\n %prefix_bytes =l sub %data, %base\n %prefix =l shr %prefix_bytes, 3\n %total_capacity =l add %capacity, %prefix\n %can_compact =w cugel %prefix, %length\n jnz %can_compact, @compact, @grow\n@compact\n jmp @ready\n@grow\n %maximum =l shr 1152921504606846975, %growth_shift\n %overflow =w cugtl %total_capacity, %maximum\n jnz %overflow, @fail, @allocate\n@allocate\n %new_capacity =l shl %total_capacity, %growth_shift\n %new_bytes =l shl %new_capacity, 3\n %old_bytes =l shl %total_capacity, 3\n %growth =l sub %new_bytes, %old_bytes\n jnz %paced, @collect, @resize\n@collect\n call $trbn_gc_maybe_collect(l %growth)\n jmp @resize\n@resize\n %new_base =l call $realloc(l %base, l %new_bytes)\n %failed =w ceql %new_base, 0\n jnz %failed, @fail, @grown\n@fail\n call $trbn_fatal(l $trbn_allocation_error, l 26)\n hlt\n@grown\n %heap_before =l loadl $trbn_gc_heap_bytes\n %heap_after =l add %heap_before, %growth\n storel %heap_after, $trbn_gc_heap_bytes\n %allocated_before =l loadl $trbn_gc_allocated_bytes\n %allocated_after =l add %allocated_before, %growth\n storel %allocated_after, $trbn_gc_allocated_bytes\n call $trbn_gc_update_peak(l %heap_after)\n jmp @ready\n@ready\n %result =l phi @compact %base, @grown %new_base\n %result_capacity =l phi @compact %total_capacity, @grown %new_capacity\n %shifted =w cnel %prefix_bytes, 0\n jnz %shifted, @move, @finish\n@move\n %source =l add %result, %prefix_bytes\n %live_bytes =l shl %length, 3\n call $memmove(l %result, l %source, l %live_bytes)\n %vacated =l add %result, %live_bytes\n call $memset(l %vacated, w 0, l %prefix_bytes)\n jmp @finish\n@finish\n %capacity_slot =l add %array, 16\n storel %result_capacity, %capacity_slot\n storel %result, %data_slot\n storel %result, %backing_slot\n ret %result\n}\n")
end
