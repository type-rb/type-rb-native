import { QbeOutput, qbe_output_line } from backend/qbe/output

# Canonical ambient directory values above the qualified platform filesystem ABI.
def emit_directory_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function l $trbn_directory_path(l %path) {\n@start\n %sizep =l add %path, 8\n %size =l loadl %sizep\n %empty =w ceql %size, 0\n jnz %empty, @invalid, @length\n@length\n %data =l add %path, 24\n %actual =l call $strlen(l %data)\n %same =w ceql %size, %actual\n jnz %same, @host, @invalid\n@invalid\n ret -1\n@host\n %profile =l call $trbn_fs_initialize()\n %supported =w cnel %profile, 0\n jnz %supported, @valid, @unsupported\n@unsupported\n ret -3\n@valid\n ret 0\n}\nfunction l $trbn_directory_stat(l %path, l %follow, l %output) {\n@start\n %status =l call $trbn_directory_path(l %path)\n %failed =w cnel %status, 0\n jnz %failed, @failed, @flags\n@failed\n ret %status\n@flags\n %flags_valid =w culel %follow, 1\n jnz %flags_valid, @prepare, @invalid\n@invalid\n ret -4\n@prepare\n %buffer =l alloc8 144\n %data =l add %path, 24\n %links =w ceql %follow, 1\n jmp @inspect\n@inspect\n jnz %links, @stat, @lstat\n@stat\n %stat_function =l loadl $trbn_fs_stat_function\n %followed =w call %stat_function(l %data, l %buffer)\n jmp @checked\n@lstat\n %lstat_function =l loadl $trbn_fs_lstat_function\n %unfollowed =w call %lstat_function(l %data, l %buffer)\n jmp @checked\n@checked\n %result =w phi @stat %followed, @lstat %unfollowed\n jnz %result, @errno, @layout\n@errno\n %error =w call $trbn_fs_errno()\n %interrupted =w ceqw %error, 4\n jnz %interrupted, @inspect, @error\n@error\n %wide =l extuw %error\n ret %wide\n@layout\n %profile =l loadl $trbn_fs_profile\n %apple =w ceql %profile, 1\n jnz %apple, @apple, @linux\n@apple\n %applep =l add %buffer, 4\n %applemode =w loaduh %applep\n jmp @mode\n@linux\n %arm =w ceql %profile, 3\n jnz %arm, @arm, @intel\n@arm\n %armp =l add %buffer, 16\n jmp @linuxmode\n@intel\n %intelp =l add %buffer, 24\n jmp @linuxmode\n@linuxmode\n %linuxp =l phi @arm %armp, @intel %intelp\n %linuxmode =w loadw %linuxp\n jmp @mode\n@mode\n %raw =w phi @apple %applemode, @linuxmode %linuxmode\n %kind =w and %raw, 61440\n %file =w ceqw %kind, 32768\n jnz %file, @file, @directory\n@file\n storel 0, %output\n ret 0\n@directory\n %directory =w ceqw %kind, 16384\n jnz %directory, @dir, @other\n@dir\n storel 1, %output\n ret 0\n@other\n storel 2, %output\n ret 0\n}\nfunction l $trbn_filesystem_stat_kind(l %path, l %follow, l %output) {\n@start\n %sizep =l add %output, 8\n %size =l loadl %sizep\n %valid =w ceql %size, 1\n jnz %valid, @stat, @invalid\n@invalid\n ret -4\n@stat\n %storagep =l add %output, 24\n %storage =l loadl %storagep\n %status =l call $trbn_directory_stat(l %path, l %follow, l %storage)\n ret %status\n}\nfunction l $trbn_filesystem_mkdir(l %path) {\n@start\n %status =l call $trbn_directory_path(l %path)\n %failed =w cnel %status, 0\n jnz %failed, @failed, @prepare\n@failed\n ret %status\n@prepare\n %data =l add %path, 24\n jmp @create\n@create\n %result =w call $mkdir(l %data, w 511)\n jnz %result, @errno, @done\n@errno\n %error =w call $trbn_fs_errno()\n %interrupted =w ceqw %error, 4\n jnz %interrupted, @create, @error\n@error\n %wide =l extuw %error\n ret %wide\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $trbn_directory_compare(l %a, l %b) {\n@start\n %left =l loadl %a\n %right =l loadl %b\n %left_bytes =l add %left, 24\n %right_bytes =l add %right, 24\n %order =w call $strcmp(l %left_bytes, l %right_bytes)\n ret %order\n}\ndata $trbn_directory_dot = { b \".\", b 0 }\ndata $trbn_directory_parent = { b \"..\", b 0 }\n")
	qbe_output_line(output, "# The pinned compiled path inspects names/metadata after each bounded batch;\n# the pinned REPL checks the full bounded name set before sorted metadata.\n# Keep that path-specific error order explicit until the source contract settles it.\nfunction l $trbn_filesystem_children(l %path, l %prefix, l %maximum, l %names, l %kinds, l %error_path) {\n@start\n %status =l call $trbn_directory_children(l %path, l %prefix, l %maximum, l %names, l %kinds, l %error_path, w 0)\n ret %status\n}\nfunction l $trbn_directory_validate_names(l %names) {\n@start\n %sizep =l add %names, 8\n %size =l loadl %sizep\n %storagep =l add %names, 24\n %storage =l loadl %storagep\n jmp @next\n@next\n %index =l phi @start 0, @advance %following\n %done =w ceql %index, %size\n jnz %done, @done, @name\n@name\n %offset =l mul %index, 8\n %address =l add %storage, %offset\n %name =l loadl %address\n %valid =l call $trbn_bytes_valid_utf8(l %name)\n %valid_name =w cnel %valid, 0\n jnz %valid_name, @advance, @invalid\n@invalid\n ret -8\n@advance\n %following =l add %index, 1\n jmp @next\n@done\n ret 0\n}\nfunction l $trbn_directory_metadata(l %prefix, l %names, l %kinds, l %error_path, l %start, l %finish, w %validate) {\n@entry\n %saved =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %prefix)\n call $trbn_gc_temp_push(l %names)\n call $trbn_gc_temp_push(l %kinds)\n call $trbn_gc_temp_push(l %error_path)\n %retained =l loadl $trbn_gc_temp_count\n %kind_out =l alloc8 8\n %storagep =l add %names, 24\n %storage =l loadl %storagep\n jmp @next\n@next\n %index =l phi @entry %start, @advance %following\n %done =w ceql %index, %finish\n jnz %done, @complete, @name\n@name\n %offset =l mul %index, 8\n %address =l add %storage, %offset\n %item =l loadl %address\n jnz %validate, @validate, @child\n@validate\n %valid =l call $trbn_bytes_valid_utf8(l %item)\n %valid_name =w cnel %valid, 0\n jnz %valid_name, @child, @invalid\n@invalid\n jmp @finish\n@child\n %child =l call $trbn_string_concat(l %prefix, l %item)\n call $trbn_gc_temp_push(l %child)\n %status =l call $trbn_directory_stat(l %child, l 0, l %kind_out)\n %failed =w cnel %status, 0\n jnz %failed, @error, @kind\n@error\n %error_storagep =l add %error_path, 24\n %error_storage =l loadl %error_storagep\n storel %child, %error_storage\n jmp @finish\n@kind\n %kind =l loadl %kind_out\n call $trbn_array_push(l %kinds, l %kind)\n storel %retained, $trbn_gc_temp_count\n jmp @advance\n@advance\n %following =l add %index, 1\n jmp @next\n@complete\n jmp @finish\n@finish\n %result =l phi @invalid -8, @error %status, @complete 0\n storel %saved, $trbn_gc_temp_count\n ret %result\n}\n# Sort names and already inspected kinds together, without repeating host metadata\n# operations. No managed allocation or callback occurs while this raw table lives.\nfunction $trbn_directory_sort_pairs(l %names, l %kinds) {\n@start\n %sizep =l add %names, 8\n %size =l loadl %sizep\n %small =w cultl %size, 2\n jnz %small, @done, @allocate\n@allocate\n %pairs =l call $calloc(l %size, l 16)\n %allocated =w cnel %pairs, 0\n jnz %allocated, @prepare, @allocation_failed\n@allocation_failed\n call $trbn_fatal(l $trbn_allocation_error, l 26)\n hlt\n@prepare\n %namesp =l add %names, 24\n %name_data =l loadl %namesp\n %kindsp =l add %kinds, 24\n %kind_data =l loadl %kindsp\n jmp @copy\n@copy\n %index =l phi @prepare 0, @copied %following\n %complete =w ceql %index, %size\n jnz %complete, @sort, @pair\n@pair\n %offset =l mul %index, 8\n %pair_offset =l mul %index, 16\n %namep =l add %name_data, %offset\n %kindp =l add %kind_data, %offset\n %name =l loadl %namep\n %kind =l loadl %kindp\n %pair =l add %pairs, %pair_offset\n %pair_kind =l add %pair, 8\n storel %name, %pair\n storel %kind, %pair_kind\n jmp @copied\n@copied\n %following =l add %index, 1\n jmp @copy\n@sort\n call $qsort(l %pairs, l %size, l 16, l $trbn_directory_compare)\n jmp @restore\n@restore\n %output =l phi @sort 0, @restored %next\n %finished =w ceql %output, %size\n jnz %finished, @free, @item\n@item\n %out_offset =l mul %output, 8\n %in_offset =l mul %output, 16\n %input =l add %pairs, %in_offset\n %input_kind =l add %input, 8\n %output_name =l loadl %input\n %output_kind =l loadl %input_kind\n %target_name =l add %name_data, %out_offset\n %target_kind =l add %kind_data, %out_offset\n storel %output_name, %target_name\n storel %output_kind, %target_kind\n jmp @restored\n@restored\n %next =l add %output, 1\n jmp @restore\n@free\n call $free(l %pairs)\n jmp @done\n@done\n ret\n}\n")
	qbe_output_line(output, "function l $trbn_directory_children(l %path, l %prefix, l %maximum, l %names, l %kinds, l %error_path, w %repl) {\n@start\n %negative =w csltl %maximum, 0\n jnz %negative, @invalid_limit, @path\n@invalid_limit\n ret -9\n@path\n %path_status =l call $trbn_directory_path(l %path)\n %bad_path =w cnel %path_status, 0\n jnz %bad_path, @path_error, @shape\n@path_error\n ret %path_status\n@shape\n %names_sizep =l add %names, 8\n %names_size =l loadl %names_sizep\n %kinds_sizep =l add %kinds, 8\n %kinds_size =l loadl %kinds_sizep\n %error_sizep =l add %error_path, 8\n %error_size =l loadl %error_sizep\n %names_empty =w ceql %names_size, 0\n %kinds_empty =w ceql %kinds_size, 0\n %error_one =w ceql %error_size, 1\n %both_empty =w and %names_empty, %kinds_empty\n %valid =w and %both_empty, %error_one\n jnz %valid, @prepare, @invalid\n@invalid\n ret -4\n@prepare\n %scope =l alloc8 24\n %batch_start =l alloc8 8\n storel 0, %batch_start\n %data =l add %path, 24\n jmp @open\n@open\n %directory =l call $opendir(l %data)\n %opened =w cnel %directory, 0\n jnz %opened, @roots, @open_error\n@open_error\n %open_errno =w call $trbn_fs_errno()\n %open_interrupted =w ceqw %open_errno, 4\n jnz %open_interrupted, @open, @open_failed\n@open_failed\n %open_wide =l extuw %open_errno\n ret %open_wide\n@roots\n call $trbn_resource_push_directory(l %scope, l %directory)\n %saved_roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %path)\n call $trbn_gc_temp_push(l %prefix)\n call $trbn_gc_temp_push(l %names)\n call $trbn_gc_temp_push(l %kinds)\n call $trbn_gc_temp_push(l %error_path)\n %permanent_roots =l loadl $trbn_gc_temp_count\n %profile =l loadl $trbn_fs_profile\n %darwin =w ceql %profile, 1\n jnz %darwin, @apple, @linux\n@apple\n jmp @layout\n@linux\n jmp @layout\n@layout\n %name_offset =l phi @apple 21, @linux 19\n jmp @next\n@next\n %errno_function =l loadl $trbn_fs_errno_function\n %errno_pointer =l call %errno_function()\n storew 0, %errno_pointer\n %readdir_function =l loadl $trbn_fs_readdir_function\n %entry =l call %readdir_function(l %directory)\n %present =w cnel %entry, 0\n jnz %present, @name, @end\n@end\n %read_errno =w call $trbn_fs_errno()\n %read_interrupted =w ceqw %read_errno, 4\n jnz %read_interrupted, @next, @read_result\n@read_result\n jnz %read_errno, @read_failed, @exhausted\n@read_failed\n %read_failure =l extuw %read_errno\n jmp @close\n@name\n %name =l add %entry, %name_offset\n %dot =w call $strcmp(l %name, l $trbn_directory_dot)\n %parent =w call $strcmp(l %name, l $trbn_directory_parent)\n %dot_same =w ceqw %dot, 0\n %parent_same =w ceqw %parent, 0\n %special =w or %dot_same, %parent_same\n jnz %special, @next, @bound\n@bound\n %count =l loadl %names_sizep\n %full =w cugel %count, %maximum\n jnz %full, @too_large, @copy\n@too_large\n jmp @close\n@copy\n %owned =l call $trbn_string_from_c(l %name)\n call $trbn_gc_temp_push(l %owned)\n call $trbn_array_push(l %names, l %owned)\n storel %permanent_roots, $trbn_gc_temp_count\n %current =l loadl %names_sizep\n %from =l loadl %batch_start\n %batch_size =l sub %current, %from\n %full_batch =w ceql %batch_size, 128\n jnz %full_batch, @batch, @next\n@batch\n jnz %repl, @retained, @inspect_batch\n@retained\n storel %current, %batch_start\n jmp @next\n@inspect_batch\n %batch_status =l call $trbn_directory_metadata(l %prefix, l %names, l %kinds, l %error_path, l %from, l %current, w 1)\n %batch_failed =w cnel %batch_status, 0\n jnz %batch_failed, @batch_error, @retained\n@batch_error\n jmp @close\n@exhausted\n %length =l loadl %names_sizep\n jnz %repl, @repl_names, @last_batch\n@last_batch\n %last_start =l loadl %batch_start\n %last_status =l call $trbn_directory_metadata(l %prefix, l %names, l %kinds, l %error_path, l %last_start, l %length, w 1)\n %last_failed =w cnel %last_status, 0\n jnz %last_failed, @last_error, @sort_pairs\n@last_error\n jmp @close\n@sort_pairs\n call $trbn_directory_sort_pairs(l %names, l %kinds)\n jmp @complete\n@repl_names\n %valid_names =l call $trbn_directory_validate_names(l %names)\n %invalid_names =w cnel %valid_names, 0\n jnz %invalid_names, @invalid_name, @repl_sort\n@invalid_name\n jmp @close\n@repl_sort\n %storagep =l add %names, 24\n %storage =l loadl %storagep\n call $qsort(l %storage, l %length, l 8, l $trbn_directory_compare)\n %repl_status =l call $trbn_directory_metadata(l %prefix, l %names, l %kinds, l %error_path, l 0, l %length, w 0)\n %repl_failed =w cnel %repl_status, 0\n jnz %repl_failed, @repl_error, @complete\n@repl_error\n jmp @close\n@complete\n jmp @close\n@close\n %result =l phi @read_failed %read_failure, @too_large -10, @batch_error %batch_status, @last_error %last_status, @invalid_name -8, @repl_error %repl_status, @complete 0\n %closed =w call $trbn_resource_close(l %scope)\n %prior_error =w cnel %result, 0\n jnz %prior_error, @return, @close_result\n@close_result\n jnz %closed, @close_error, @return\n@close_error\n %close_errno =w call $trbn_fs_errno()\n %close_failure =l extuw %close_errno\n jmp @finish\n@return\n jmp @finish\n@finish\n %status =l phi @return %result, @close_error %close_failure\n storel %saved_roots, $trbn_gc_temp_count\n ret %status\n}\n")
end
