import { QbeOutput, qbe_output_line } from backend/qbe/output

# Uses the compiler source result layout, but collects every regular file,
# rejects symlinks and excludes only the root .git entry and its descendants.
def emit_package_files_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function l $trbn_collect_package_files(l %source_root) {\n@start\n\t%paths =l call $trbn_array_new(l $trbn_desc_array_managed)\n\t%paths_root =l add $trbn_gc_global_roots, 64\n\tstorel %paths, %paths_root\n\t%sources =l call $trbn_array_new(l $trbn_desc_array_managed)\n\t%sources_root =l add $trbn_gc_global_roots, 72\n\tstorel %sources, %sources_root\n\t%result =l call $trbn_gc_alloc(l $trbn_desc_project_sources, l 24, l 0)\n\t%result_root =l add $trbn_gc_global_roots, 80\n\tstorel %result, %result_root\n\t%paths_slot =l add %result, 8\n\tstorel %paths, %paths_slot\n\t%sources_slot =l add %result, 16\n\tstorel %sources, %sources_slot\n\t%error_slot =l add %result, 24\n\tstorel $trbn_project_empty_string, %error_slot\n\tstorel %paths, $trbn_project_paths\n\tstorel 0, $trbn_project_error\n\t%error_root =l add $trbn_gc_global_roots, 88\n\tstorel 0, %error_root\n\t%source_data =l add %source_root, 24\n\t%out_data =l add %source_root, 24\n\tstorel %source_data, $trbn_project_source_root\n\tstorel %out_data, $trbn_project_out_root\n\t%walk_status =w call $nftw(l %source_data, l $trbn_package_walk_callback, w 32, w 1)\n\t%walk_error =l loadl $trbn_project_error\n\t%callback_failed =w cnel %walk_error, 0\n\tjnz %callback_failed, @failed, @walk_result\n@walk_result\n\t%walk_failed =w cnew %walk_status, 0\n\tjnz %walk_failed, @root_failed, @sort\n@root_failed\n\tstorel %source_root, %error_slot\n\tret %result\n@failed\n\tstorel %walk_error, %error_slot\n\tret %result\n@sort\n\t%path_count_address =l add %paths, 8\n\t%path_count =l loadl %path_count_address\n\t%multiple =w csltl 1, %path_count\n\tjnz %multiple, @sort_paths, @read_start\n@sort_paths\n\t%paths_data_slot =l add %paths, 24\n\t%paths_data =l loadl %paths_data_slot\n\tcall $qsort(l %paths_data, l %path_count, l 8, l $trbn_project_path_compare)\n\tjmp @read_start\n@read_start\n\t%read_data_slot =l add %paths, 24\n\t%read_data =l loadl %read_data_slot\n\tjmp @read_loop\n@read_loop\n\t%index =l phi @read_start 0, @read_next %next_index\n\t%finished =w cslel %path_count, %index\n\tjnz %finished, @success, @read\n@read\n\t%offset =l mul %index, 8\n\t%path_slot =l add %read_data, %offset\n\t%path =l loadl %path_slot\n\t%path_data =l add %path, 24\n\t%source =l call $trbn_read_file(l %path_data)\n\t%read_failed =w ceql %source, 0\n\tjnz %read_failed, @source_failed, @source_ready\n@source_failed\n\tstorel %path, %error_slot\n\tret %result\n@source_ready\n\tcall $trbn_array_push(l %sources, l %source)\n\tjmp @read_next\n@read_next\n\t%next_index =l add %index, 1\n\tjmp @read_loop\n@success\n\tret %result\n}\n\n\nfunction w $trbn_package_walk_callback(l %path, l %stat, w %type, l %walk) {\n@start\n %root =l loadl $trbn_project_source_root\n %root_size =l call $strlen(l %root)\n %path_size =l call $strlen(l %path)\n %same =w ceql %root_size, %path_size\n jnz %same, @classify, @relative\n@relative\n %offset =l add %root_size, 1\n %relative =l add %path, %offset\n %match =w call $strncmp(l %relative, l $trbn_package_git_name, l 4)\n %equal =w ceqw %match, 0\n jnz %equal, @git, @classify\n@git\n %end =l add %relative, 4\n %suffix =w loadub %end\n %ancestor =w ceqw %suffix, 47\n %last =w ceqw %suffix, 0\n %skip =w or %ancestor, %last\n jnz %skip, @ignore, @classify\n@classify\n %regular =w ceqw %type, 0\n jnz %regular, @collect, @directory\n@directory\n %is_directory =w ceqw %type, 1\n jnz %is_directory, @ignore, @error\n@collect\n %owned =l call $trbn_string_from_c(l %path)\n %paths =l loadl $trbn_project_paths\n call $trbn_array_push(l %paths, l %owned)\n ret 0\n@error\n %error =l call $trbn_string_from_c(l %path)\n storel %error, $trbn_project_error\n %error_root =l add $trbn_gc_global_roots, 88\n storel %error, %error_root\n ret 1\n@ignore\n ret 0\n}\ndata $trbn_package_git_name = { b \".git\", b 0 }\n")
end
