import { builder_adapter_start, builder_names } from mir/model/string_builder_contract
import { mir_signature_standard } from mir/model/call_kinds
import { MirModule } from mir/model/module
import { QbeOutput, qbe_output_line } from backend/qbe/output

# A builder owns a traced backing allocation and an exact used-byte length.
# Backing storage uses the existing variable byte-allocation descriptor with
# capacity in its length slot. It never escapes as a typed immutable String.
# Snapshots copy only initialized bytes and compute Unicode size after joining
# all fragments, including a UTF-8 sequence split across appends.
def emit_string_builder_runtime(native_module: MirModule, mut output: QbeOutput)
	mut needed := false
	native_module.signatures.each do |signature|
		if signature.kind == mir_signature_standard() && signature.adapter >= builder_adapter_start() && signature.adapter < builder_adapter_start() + builder_names().size()
			needed = true
		end
	end
	if !needed
		return
	end
	qbe_output_line(output, "data $trbn_desc_builder = align 8 { l 1, l 1, l 16, l 8 }\n")
	qbe_output_line(output, "data $trbn_builder_codepoint_error = { b \"panic: invalid Unicode code point\", b 10 }\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function l $trbn_builder_new() {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %builder =l call $trbn_gc_alloc(l $trbn_desc_builder, l 16, l 0)\n")
	qbe_output_line(output, " ret %builder\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function $trbn_builder_append_span(l %builder, l %value, l %offset, l %value_length) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %roots =l loadl $trbn_gc_temp_count\n")
	qbe_output_line(output, " %lengthp =l add %builder, 16\n")
	qbe_output_line(output, " %length =l loadl %lengthp\n")
	qbe_output_line(output, " %empty =w ceql %value_length, 0\n")
	qbe_output_line(output, " jnz %empty, @finish, @check\n")
	qbe_output_line(output, "@check\n")
	qbe_output_line(output, " %required =l add %length, %value_length\n")
	qbe_output_line(output, " %too_large =w cugtl %required, 9007199254740991\n")
	qbe_output_line(output, " jnz %too_large, @fail, @storage\n")
	qbe_output_line(output, "@fail\n")
	qbe_output_line(output, " call $trbn_fatal(l $trbn_allocation_error, l 26)\n")
	qbe_output_line(output, " hlt\n")
	qbe_output_line(output, "@storage\n")
	qbe_output_line(output, " %storagep =l add %builder, 8\n")
	qbe_output_line(output, " %old =l loadl %storagep\n")
	qbe_output_line(output, " %missing =w ceql %old, 0\n")
	qbe_output_line(output, " jnz %missing, @initial, @capacity\n")
	qbe_output_line(output, "@initial\n")
	qbe_output_line(output, " jmp @reserve\n")
	qbe_output_line(output, "@capacity\n")
	qbe_output_line(output, " %capacityp =l add %old, 8\n")
	qbe_output_line(output, " %capacity =l loadl %capacityp\n")
	qbe_output_line(output, " %enough =w cugel %capacity, %required\n")
	qbe_output_line(output, " jnz %enough, @reuse, @grow\n")
	qbe_output_line(output, "@grow\n")
	qbe_output_line(output, " %double =l mul %capacity, 2\n")
	qbe_output_line(output, " %over =w cugtl %double, 9007199254740991\n")
	qbe_output_line(output, " jnz %over, @maximum, @doubled\n")
	qbe_output_line(output, "@maximum\n")
	qbe_output_line(output, " jmp @reserve\n")
	qbe_output_line(output, "@doubled\n")
	qbe_output_line(output, " jmp @reserve\n")
	qbe_output_line(output, "@reserve\n")
	qbe_output_line(output, " %proposed =l phi @initial 64, @maximum 9007199254740991, @doubled %double\n")
	qbe_output_line(output, " %small =w cultl %proposed, %required\n")
	qbe_output_line(output, " jnz %small, @exact, @geometric\n")
	qbe_output_line(output, "@exact\n")
	qbe_output_line(output, " jmp @allocate\n")
	qbe_output_line(output, "@geometric\n")
	qbe_output_line(output, " jmp @allocate\n")
	qbe_output_line(output, "@allocate\n")
	# Round up using the initial capacity quantum, so a large appended span
	# leaves room for a small suffix without immediately copying the buffer.
	qbe_output_line(output, " %minimum =l phi @exact %required, @geometric %proposed\n")
	qbe_output_line(output, " %rounding =l add %minimum, 63\n")
	qbe_output_line(output, " %rounded =l and %rounding, -64\n")
	qbe_output_line(output, " %rounded_over =w cugtl %rounded, 9007199254740991\n")
	qbe_output_line(output, " jnz %rounded_over, @limit, @rounded_capacity\n")
	qbe_output_line(output, "@limit\n")
	qbe_output_line(output, " jmp @reserve_bytes\n")
	qbe_output_line(output, "@rounded_capacity\n")
	qbe_output_line(output, " jmp @reserve_bytes\n")
	qbe_output_line(output, "@reserve_bytes\n")
	qbe_output_line(output, " %reserved =l phi @limit 9007199254740991, @rounded_capacity %rounded\n")
	qbe_output_line(output, " %payload =l add %reserved, 17\n")
	# Reusing capacity cannot collect; roots are needed only for allocation.
	qbe_output_line(output, " call $trbn_gc_temp_push(l %builder)\n")
	qbe_output_line(output, " call $trbn_gc_temp_push(l %value)\n")
	qbe_output_line(output, " %new =l call $trbn_string_alloc(l %payload)\n")
	qbe_output_line(output, " %new_capacityp =l add %new, 8\n")
	qbe_output_line(output, " storel %reserved, %new_capacityp\n")
	qbe_output_line(output, " %new_data =l add %new, 24\n")
	qbe_output_line(output, " %has_old =w cnel %length, 0\n")
	qbe_output_line(output, " jnz %has_old, @copy_old, @replace\n")
	qbe_output_line(output, "@copy_old\n")
	qbe_output_line(output, " %old_data =l add %old, 24\n")
	qbe_output_line(output, " call $memcpy(l %new_data, l %old_data, l %length)\n")
	qbe_output_line(output, " jmp @replace\n")
	qbe_output_line(output, "@replace\n")
	qbe_output_line(output, " storel %new, %storagep\n")
	qbe_output_line(output, " jmp @write\n")
	qbe_output_line(output, "@reuse\n")
	qbe_output_line(output, " jmp @write\n")
	qbe_output_line(output, "@write\n")
	qbe_output_line(output, " %storage =l phi @replace %new, @reuse %old\n")
	qbe_output_line(output, " %data =l add %storage, 24\n")
	qbe_output_line(output, " %target =l add %data, %length\n")
	qbe_output_line(output, " %source =l add %value, 24\n")
	qbe_output_line(output, " %input =l add %source, %offset\n")
	qbe_output_line(output, " call $memcpy(l %target, l %input, l %value_length)\n")
	qbe_output_line(output, " storel %required, %lengthp\n")
	qbe_output_line(output, " jmp @finish\n")
	qbe_output_line(output, "@finish\n")
	qbe_output_line(output, " storel %roots, $trbn_gc_temp_count\n")
	qbe_output_line(output, " ret\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function $trbn_builder_append(l %builder, l %value) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %lengthp =l add %value, 8\n")
	qbe_output_line(output, " %length =l loadl %lengthp\n")
	qbe_output_line(output, " call $trbn_builder_append_span(l %builder, l %value, l 0, l %length)\n")
	qbe_output_line(output, " ret\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "data $trbn_builder_range_error = { b \"panic: StringBuilder byte range is out of bounds\", b 10 }\n")
	qbe_output_line(output, "function $trbn_builder_append_bytes(l %builder, l %bytes, l %start, l %finish) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %lengthp =l add %bytes, 8\n")
	qbe_output_line(output, " %length =l loadl %lengthp\n")
	qbe_output_line(output, " %ordered =w culel %start, %finish\n")
	qbe_output_line(output, " %within =w culel %finish, %length\n")
	qbe_output_line(output, " %valid =w and %ordered, %within\n")
	qbe_output_line(output, " jnz %valid, @append, @fail\n")
	qbe_output_line(output, "@fail\n")
	qbe_output_line(output, " call $trbn_fail(l $trbn_builder_range_error, l 49)\n")
	qbe_output_line(output, " hlt\n")
	qbe_output_line(output, "@append\n")
	qbe_output_line(output, " %count =l sub %finish, %start\n")
	qbe_output_line(output, " call $trbn_builder_append_span(l %builder, l %bytes, l %start, l %count)\n")
	qbe_output_line(output, " ret\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function l $trbn_builder_from_string(l %value) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %roots =l loadl $trbn_gc_temp_count\n")
	qbe_output_line(output, " call $trbn_gc_temp_push(l %value)\n")
	qbe_output_line(output, " %builder =l call $trbn_builder_new()\n")
	qbe_output_line(output, " call $trbn_builder_append(l %builder, l %value)\n")
	qbe_output_line(output, " storel %roots, $trbn_gc_temp_count\n")
	qbe_output_line(output, " ret %builder\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function $trbn_builder_append_codepoint(l %builder, l %point) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %outside =w cugtl %point, 1114111\n")
	qbe_output_line(output, " %above =w cugel %point, 55296\n")
	qbe_output_line(output, " %below =w culel %point, 57343\n")
	qbe_output_line(output, " %surrogate =w and %above, %below\n")
	qbe_output_line(output, " %bad =w or %outside, %surrogate\n")
	qbe_output_line(output, " jnz %bad, @fail, @encode\n")
	qbe_output_line(output, "@fail\n")
	qbe_output_line(output, " call $trbn_fail(l $trbn_builder_codepoint_error, l 34)\n")
	qbe_output_line(output, " hlt\n")
	qbe_output_line(output, "@encode\n")
	qbe_output_line(output, " %roots =l loadl $trbn_gc_temp_count\n")
	qbe_output_line(output, " call $trbn_gc_temp_push(l %builder)\n")
	qbe_output_line(output, " %value =l call $trbn_string_from_codepoint(l %point)\n")
	qbe_output_line(output, " call $trbn_builder_append(l %builder, l %value)\n")
	qbe_output_line(output, " storel %roots, $trbn_gc_temp_count\n")
	qbe_output_line(output, " ret\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function l $trbn_builder_length(l %builder) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %lengthp =l add %builder, 16\n")
	qbe_output_line(output, " %length =l loadl %lengthp\n")
	qbe_output_line(output, " %empty =w ceql %length, 0\n")
	qbe_output_line(output, " jnz %empty, @empty, @count\n")
	qbe_output_line(output, "@empty\n")
	qbe_output_line(output, " ret 0\n")
	qbe_output_line(output, "@count\n")
	qbe_output_line(output, " %storagep =l add %builder, 8\n")
	qbe_output_line(output, " %storage =l loadl %storagep\n")
	qbe_output_line(output, " %data =l add %storage, 24\n")
	qbe_output_line(output, " %points =l call $trbn_utf8_count(l %data, l %length)\n")
	qbe_output_line(output, " ret %points\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function l $trbn_builder_empty(l %builder) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %lengthp =l add %builder, 16\n")
	qbe_output_line(output, " %length =l loadl %lengthp\n")
	qbe_output_line(output, " %empty =w ceql %length, 0\n")
	qbe_output_line(output, " %result =l extuw %empty\n")
	qbe_output_line(output, " ret %result\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function l $trbn_builder_to_string(l %builder) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %roots =l loadl $trbn_gc_temp_count\n")
	qbe_output_line(output, " call $trbn_gc_temp_push(l %builder)\n")
	qbe_output_line(output, " %lengthp =l add %builder, 16\n")
	qbe_output_line(output, " %length =l loadl %lengthp\n")
	qbe_output_line(output, " %empty =w ceql %length, 0\n")
	qbe_output_line(output, " jnz %empty, @empty, @copy\n")
	qbe_output_line(output, "@empty\n")
	qbe_output_line(output, " %blank =l call $trbn_string_alloc(l 17)\n")
	qbe_output_line(output, " %end =l add %blank, 24\n")
	qbe_output_line(output, " storeb 0, %end\n")
	qbe_output_line(output, " jmp @finish\n")
	qbe_output_line(output, "@copy\n")
	qbe_output_line(output, " %storagep =l add %builder, 8\n")
	qbe_output_line(output, " %storage =l loadl %storagep\n")
	qbe_output_line(output, " %data =l add %storage, 24\n")
	qbe_output_line(output, " %snapshot =l call $trbn_string_from_bytes(l %data, l %length)\n")
	qbe_output_line(output, " jmp @finish\n")
	qbe_output_line(output, "@finish\n")
	qbe_output_line(output, " %result =l phi @empty %blank, @copy %snapshot\n")
	qbe_output_line(output, " storel %roots, $trbn_gc_temp_count\n")
	qbe_output_line(output, " ret %result\n")
	qbe_output_line(output, "}\n")
	qbe_output_line(output, "\n")
	qbe_output_line(output, "function $trbn_builder_clear(l %builder) {\n")
	qbe_output_line(output, "@start\n")
	qbe_output_line(output, " %storagep =l add %builder, 8\n")
	qbe_output_line(output, " storel 0, %storagep\n")
	qbe_output_line(output, " %lengthp =l add %builder, 16\n")
	qbe_output_line(output, " storel 0, %lengthp\n")
	qbe_output_line(output, " ret\n")
	qbe_output_line(output, "}\n")
end
