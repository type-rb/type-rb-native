import { QbeOutput, qbe_output_line } from backend/qbe/output

# Parse status is 0 for success, 1 for syntax, and 2 for portable range.
# Accumulate only while the magnitude fits. After overflow, validate the remaining
# bytes without arithmetic: an invalid suffix still takes priority over range.
# The output slot is written only on success; every read respects String length.
def emit_integer_parse_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\ndata $trbn_invalid_integer_error = { b \"panic: invalid Integer\", b 10 }\n\nfunction l $trbn_parse_integer(l %string, l %output) {\n@start\n %length_address =l add %string, 8\n %length =l loadl %length_address\n %empty =w ceql %length, 0\n jnz %empty, @invalid, @first")
	qbe_output_line(output, "\n@first\n %data =l add %string, 24\n %first =w loadub %data\n %plus =w ceqw %first, 43\n %minus =w ceqw %first, 45\n %signed =w or %plus, %minus\n %begin =l extuw %signed\n %sign_only =w ceql %begin, %length\n jnz %sign_only, @invalid, @parse")
	qbe_output_line(output, "\n@parse\n %index =l phi @first %begin, @next %next_index\n %accumulator =l phi @first 0, @next %next_accumulator\n %done =w ceql %index, %length\n jnz %done, @sign, @digit")
	qbe_output_line(output, "\n@digit\n %address =l add %data, %index\n %character =w loadub %address\n %digit_word =w sub %character, 48\n %valid =w cultw %digit_word, 10\n jnz %valid, @accumulate, @invalid")
	# The entering magnitude is at most 2^53-1, so multiplying by ten
	# and adding one digit fits int64. One comparison detects portable overflow.
	qbe_output_line(output, "\n@accumulate\n %digit =l extuw %digit_word\n %scaled =l mul %accumulator, 10\n %next_accumulator =l add %scaled, %digit\n %overflow =w csgtl %next_accumulator, 9007199254740991\n jnz %overflow, @overflow, @next\n@next\n %next_index =l add %index, 1\n jmp @parse")
	qbe_output_line(output, "\n@overflow\n %remainder_begin =l add %index, 1\n jmp @validate_remainder")
	qbe_output_line(output, "\n@validate_remainder\n %remainder_index =l phi @overflow %remainder_begin, @remainder_next %remainder_advance\n %remainder_done =w ceql %remainder_index, %length\n jnz %remainder_done, @range, @remainder_digit")
	qbe_output_line(output, "\n@remainder_digit\n %remainder_address =l add %data, %remainder_index\n %remainder_character =w loadub %remainder_address\n %remainder_digit =w sub %remainder_character, 48\n %remainder_valid =w cultw %remainder_digit, 10\n jnz %remainder_valid, @remainder_next, @invalid")
	qbe_output_line(output, "\n@remainder_next\n %remainder_advance =l add %remainder_index, 1\n jmp @validate_remainder")
	qbe_output_line(output, "\n@sign\n jnz %minus, @negative, @positive\n@negative\n %negative_result =l sub 0, %accumulator\n storel %negative_result, %output\n ret 0\n@positive\n storel %accumulator, %output\n ret 0\n@invalid\n ret 1\n@range\n ret 2\n}\n")
end

def emit_number_parsing_runtime(mut output: QbeOutput)
	emit_integer_parse_runtime(output)
	qbe_output_line(output, "\ndata $trbn_invalid_float_error = { b \"panic: invalid Float\", b 10 }\ndata $trbn_float_range_error = { b \"panic: Float is outside the portable range\", b 10 }\nfunction l $trbn_parse_float(l %string, l %output) {\n@start\n %length_address =l add %string, 8\n %length =l loadl %length_address\n %empty =w ceql %length, 0\n jnz %empty, @invalid, @first\n@first\n %data =l add %string, 24\n %first =w loadub %data\n %plus =w ceqw %first, 43\n %minus =w ceqw %first, 45\n %signed =w or %plus, %minus\n %begin =l extuw %signed\n jmp @integer\n@integer\n %integer_index =l phi @first %begin, @integer_next %integer_advance\n %integer_end =w ceql %integer_index, %length\n jnz %integer_end, @integer_finish, @integer_read\n@integer_read\n %integer_address =l add %data, %integer_index\n %integer_byte =w loadub %integer_address\n %integer_digit =w sub %integer_byte, 48\n %integer_valid =w cultw %integer_digit, 10\n jnz %integer_valid, @integer_next, @integer_finish\n@integer_next\n %integer_advance =l add %integer_index, 1\n jmp @integer\n@integer_finish\n %integer_count =l sub %integer_index, %begin\n jnz %integer_end, @without_fraction, @dot\n@dot\n %dot_address =l add %data, %integer_index\n %dot_byte =w loadub %dot_address\n %is_dot =w ceqw %dot_byte, 46\n jnz %is_dot, @fraction_start, @without_fraction\n@without_fraction\n jmp @mantissa\n@fraction_start\n %fraction_begin =l add %integer_index, 1\n jmp @fraction\n@fraction\n %fraction_index =l phi @fraction_start %fraction_begin, @fraction_next %fraction_advance\n %fraction_end =w ceql %fraction_index, %length\n jnz %fraction_end, @fraction_finish, @fraction_read\n@fraction_read\n %fraction_address =l add %data, %fraction_index\n %fraction_byte =w loadub %fraction_address\n %fraction_digit =w sub %fraction_byte, 48\n %fraction_valid =w cultw %fraction_digit, 10\n jnz %fraction_valid, @fraction_next, @fraction_finish\n@fraction_next\n %fraction_advance =l add %fraction_index, 1\n jmp @fraction\n@fraction_finish\n %fraction_count =l sub %fraction_index, %fraction_begin\n %total_count =l add %integer_count, %fraction_count\n jmp @mantissa\n@mantissa\n %digits =l phi @without_fraction %integer_count, @fraction_finish %total_count\n %mantissa_finish =l phi @without_fraction %integer_index, @fraction_finish %fraction_index\n %no_digits =w ceql %digits, 0\n jnz %no_digits, @invalid, @after_mantissa\n@after_mantissa\n %done =w ceql %mantissa_finish, %length\n jnz %done, @parse, @exponent_marker\n@exponent_marker\n %marker_address =l add %data, %mantissa_finish\n %marker =w loadub %marker_address\n %lower_e =w ceqw %marker, 101\n %upper_e =w ceqw %marker, 69\n %is_e =w or %lower_e, %upper_e\n jnz %is_e, @exponent_start, @invalid\n@exponent_start\n %exponent_begin =l add %mantissa_finish, 1\n %exponent_empty =w ceql %exponent_begin, %length\n jnz %exponent_empty, @invalid, @exponent_sign\n@exponent_sign\n %sign_address =l add %data, %exponent_begin\n %sign =w loadub %sign_address\n %exponent_plus =w ceqw %sign, 43\n %exponent_minus =w ceqw %sign, 45\n %exponent_signed =w or %exponent_plus, %exponent_minus\n %sign_length =l extuw %exponent_signed\n %exponent_digits =l add %exponent_begin, %sign_length\n %sign_only =w ceql %exponent_digits, %length\n jnz %sign_only, @invalid, @exponent\n@exponent\n %exponent_index =l phi @exponent_sign %exponent_digits, @exponent_next %exponent_advance\n %exponent_end =w ceql %exponent_index, %length\n jnz %exponent_end, @parse, @exponent_read\n@exponent_read\n %exponent_address =l add %data, %exponent_index\n %exponent_byte =w loadub %exponent_address\n %exponent_digit =w sub %exponent_byte, 48\n %exponent_valid =w cultw %exponent_digit, 10\n jnz %exponent_valid, @exponent_next, @invalid\n@exponent_next\n %exponent_advance =l add %exponent_index, 1\n jmp @exponent\n@parse\n %value =d call $strtod(l %data, l 0)\n %difference =d sub %value, %value\n %finite =w ceqd %difference, %difference\n jnz %finite, @success, @range\n@success\n stored %value, %output\n ret 0\n@invalid\n ret 1\n@range\n ret 2\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_string_integer_status(l %string) {\n@start\n %output =l alloc8 8\n %status =l call $trbn_parse_integer(l %string, l %output)\n ret %status\n}\nfunction l $trbn_string_to_integer(l %string) {\n@start\n %output =l alloc8 8\n %status =l call $trbn_parse_integer(l %string, l %output)\n %status_nonzero =w cnel %status, 0\n jnz %status_nonzero, @failure, @success\n@success\n %result =l loadl %output\n ret %result\n@failure\n %invalid =w ceql %status, 1\n jnz %invalid, @invalid, @range\n@invalid\n call $trbn_fail(l $trbn_invalid_integer_error, l 23)\n hlt\n@range\n call $trbn_fail(l $trbn_integer_range_error, l 45)\n hlt\n}\n\nfunction l $trbn_string_float_status(l %string) {\n@start\n %output =l alloc8 8\n %status =l call $trbn_parse_float(l %string, l %output)\n ret %status\n}\nfunction d $trbn_string_to_float(l %string) {\n@start\n %output =l alloc8 8\n %status =l call $trbn_parse_float(l %string, l %output)\n %status_nonzero =w cnel %status, 0\n jnz %status_nonzero, @failure, @success\n@success\n %result =d loadd %output\n ret %result\n@failure\n %invalid =w ceql %status, 1\n jnz %invalid, @invalid, @range\n@invalid\n call $trbn_fail(l $trbn_invalid_float_error, l 21)\n hlt\n@range\n call $trbn_fail(l $trbn_float_range_error, l 43)\n hlt\n}\n")
end
