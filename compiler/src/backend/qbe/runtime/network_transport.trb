import { QbeOutput, qbe_output_line } from backend/qbe/output

# Raw connection slots (byte offsets): next 0, TCP 8, parser 16, state 24,
# close-after-write 32, protocol status 40, keepalive 48; 24-byte buffers for
# target 64, method 88, headers 112, body 136 and pipelined input 160;
# method phase 184, checked token 192, headers-finished 208. The allocation is
# 224 bytes. State is receiving 0, ready 1, managed handler 2, writing 3,
# closing 4. Close callbacks own final unlink/free; write callbacks finish first.
# A write packet contains the connection followed by an owned uv_buf_t. No slot
# retains a managed address. libuv handles/requests use public sizing/accessors.
def emit_network_transport(mut output: QbeOutput)
	qbe_output_line(output, "data $net_loop = align 8 { l 0 }\ndata $net_listener = align 8 { l 0 }\ndata $net_signal_int = align 8 { l 0 }\ndata $net_signal_term = align 8 { l 0 }\ndata $net_timer = align 8 { l 0 }\ndata $net_connections = align 8 { l 0 }\ndata $net_connection_count = align 8 { l 0 }\ndata $net_next_id = align 8 { l 1 }\ndata $net_shutdown = align 8 { l 0 }\ndata $net_body_limit = align 8 { l 1048576 }\ndata $net_shutdown_timeout = align 8 { l 10000 }\ndata $net_resolve_status = align 8 { l -1 }\ndata $net_port = align 8 { l 0 }\ndata $net_version_10 = align 8 { l 0, l 3, l 3, b \"1.0\", b 0 }\ndata $net_version_11 = align 8 { l 0, l 3, l 3, b \"1.1\", b 0 }\ndata $net_empty = align 8 { l 0, l 0, l 0, b 0 }\ndata $net_dependency_error = align 8 { l 0, l 76, l 76, b \"Web.serve requires pinned libuv and llhttp libraries in TRBN_NETWORK_LIB_DIR\", b 0 }\ndata $net_start_error = align 8 { l 0, l 45, l 45, b \"Web.serve could not initialize or bind server\", b 0 }\ndata $net_active_error = align 8 { l 0, l 40, l 40, b \"Web.serve already has an active listener\", b 0 }\n")
	qbe_output_line(output, "function l $net_find(l %id) {\n@start\n %head =l loadl $net_connections\n jmp @loop\n@loop\n %connection =l phi @start %head, @advance %next\n %none =w ceql %connection, 0\n jnz %none, @missing, @check\n@check\n %idp =l add %connection, 192\n %current =l loadl %idp\n %same =w ceql %current, %id\n jnz %same, @found, @advance\n@advance\n %next =l loadl %connection\n jmp @loop\n@found\n ret %connection\n@missing\n ret 0\n}\n")
	qbe_output_line(output, "function $net_free_handle(l %handle) {\n@start\n call $free(l %handle)\n ret\n}\n")
	qbe_output_line(output, "function $net_close_handle(l %handle) {\n@start\n %null =w ceql %handle, 0\n jnz %null, @done, @check\n@check\n %closing =w call $net_uv_is_closing(l %handle)\n jnz %closing, @done, @close\n@close\n call $net_uv_close(l %handle, l $net_free_handle)\n@done\n ret\n}\n")
	qbe_output_line(output, "function $net_free_connection(l %tcp) {\n@start\n %connection =l call $net_uv_handle_get_data(l %tcp)\n %head =l loadl $net_connections\n jmp @search\n@search\n %link =l phi @start $net_connections, @advance %current\n %current =l loadl %link\n %same =w ceql %current, %connection\n jnz %same, @unlink, @advance\n@advance\n jmp @search\n@unlink\n %next =l loadl %connection\n storel %next, %link\n %count =l loadl $net_connection_count\n %less =l sub %count, 1\n storel %less, $net_connection_count\n %parserp =l add %connection, 16\n %parser =l loadl %parserp\n call $free(l %parser)\n jmp @buffers\n@buffers\n %offset =l phi @unlink 64, @more %following\n %buffer =l add %connection, %offset\n call $net_clear(l %buffer)\n %following =l add %offset, 24\n %finished =w ceql %following, 184\n jnz %finished, @free, @more\n@more\n jmp @buffers\n@free\n call $free(l %connection)\n call $free(l %tcp)\n ret\n}\n")
	qbe_output_line(output, "function $net_close_connection(l %connection) {\n@start\n %statep =l add %connection, 24\n %state =l loadl %statep\n %closing =w ceql %state, 4\n jnz %closing, @done, @close\n@close\n storel 4, %statep\n %tcpp =l add %connection, 8\n %tcp =l loadl %tcpp\n %ignored =w call $net_uv_read_stop(l %tcp)\n call $net_uv_close(l %tcp, l $net_free_connection)\n@done\n ret\n}\n")
	qbe_output_line(output, "function $net_alloc_read(l %handle, l %suggested, l %buffer) {\n@start\n %data =l call $malloc(l 16384)\n storel %data, %buffer\n %lenp =l add %buffer, 8\n %oom =w ceql %data, 0\n jnz %oom, @empty, @allocated\n@empty\n storel 0, %lenp\n ret\n@allocated\n storel 16384, %lenp\n ret\n}\n")
	qbe_output_line(output, "function $net_read(l %tcp, l %count, l %buffer) {\n@start\n %data =l loadl %buffer\n %connection =l call $net_uv_handle_get_data(l %tcp)\n %error =w csltl %count, 0\n jnz %error, @close, @input\n@input\n %positive =w csgtl %count, 0\n jnz %positive, @parse, @free\n@parse\n call $net_parse(l %connection, l %data, l %count)\n jmp @free\n@close\n call $net_close_connection(l %connection)\n@free\n call $free(l %data)\n ret\n}\n")
	qbe_output_line(output, "function $net_accept(l %listener, w %status) {\n@start\n %failed =w cnew %status, 0\n jnz %failed, @done, @allocate\n@allocate\n %size =l call $net_uv_handle_size(w 12)\n %tcp =l call $calloc(l 1, l %size)\n %connection =l call $calloc(l 1, l 224)\n %parser =l call $calloc(l 1, l 96)\n %no_tcp =w ceql %tcp, 0\n %no_connection =w ceql %connection, 0\n %no_parser =w ceql %parser, 0\n %bad1 =w or %no_tcp, %no_connection\n %bad =w or %bad1, %no_parser\n jnz %bad, @free_raw, @initialize\n@initialize\n %loop =l loadl $net_loop\n %initialized =w call $net_uv_tcp_init(l %loop, l %tcp)\n %init_error =w cnew %initialized, 0\n jnz %init_error, @free_raw, @accept\n@accept\n %accepted =w call $net_uv_accept(l %listener, l %tcp)\n %accept_error =w cnew %accepted, 0\n jnz %accept_error, @close_unowned, @own\n@own\n %head =l loadl $net_connections\n storel %head, %connection\n storel %connection, $net_connections\n %count =l loadl $net_connection_count\n %more =l add %count, 1\n storel %more, $net_connection_count\n %tcpp =l add %connection, 8\n storel %tcp, %tcpp\n %parserp =l add %connection, 16\n storel %parser, %parserp\n %idp =l add %connection, 192\n %id =l loadl $net_next_id\n storel %id, %idp\n %next_id =l add %id, 1\n storel %next_id, $net_next_id\n call $net_uv_handle_set_data(l %tcp, l %connection)\n call $net_llhttp_init(l %parser, w 1, l $net_settings)\n %cp =l add %parser, 48\n storel %connection, %cp\n %excess =w cugtl %more, 1024\n %shutdown =l loadl $net_shutdown\n %stopping =w cnel %shutdown, 0\n %reject =w or %excess, %stopping\n jnz %reject, @close_owned, @read\n@read\n %reading =w call $net_uv_read_start(l %tcp, l $net_alloc_read, l $net_read)\n %read_error =w cnew %reading, 0\n jnz %read_error, @close_owned, @done\n@close_owned\n call $net_close_connection(l %connection)\n ret\n@close_unowned\n call $net_close_handle(l %tcp)\n call $free(l %connection)\n call $free(l %parser)\n ret\n@free_raw\n call $free(l %tcp)\n call $free(l %connection)\n call $free(l %parser)\n@done\n ret\n}\n")
	qbe_output_line(output, "function $net_close_all() {\n@start\n %head =l loadl $net_connections\n jmp @loop\n@loop\n %connection =l phi @start %head, @close %next\n %done =w ceql %connection, 0\n jnz %done, @done, @close\n@close\n %next =l loadl %connection\n call $net_close_connection(l %connection)\n jmp @loop\n@done\n ret\n}\n")
	qbe_output_line(output, "function $net_deadline(l %timer) {\n@start\n call $net_close_all()\n ret\n}\n")
	qbe_output_line(output, "function $net_shutdown_signal(l %handle, w %signal) {\n@start\n %already =l loadl $net_shutdown\n %stopping =w cnel %already, 0\n jnz %stopping, @done, @begin\n@begin\n storel 1, $net_shutdown\n %listener =l loadl $net_listener\n storel 0, $net_listener\n call $net_close_handle(l %listener)\n %timer =l loadl $net_timer\n %timeout =l loadl $net_shutdown_timeout\n %started =w call $net_uv_timer_start(l %timer, l $net_deadline, l %timeout, l 0)\n %head =l loadl $net_connections\n jmp @loop\n@loop\n %connection =l phi @begin %head, @next %following\n %empty =w ceql %connection, 0\n jnz %empty, @done, @state\n@state\n %statep =l add %connection, 24\n %state =l loadl %statep\n %idle =w ceql %state, 0\n jnz %idle, @activity, @next\n@activity\n %method_lenp =l add %connection, 96\n %method_len =l loadl %method_lenp\n %active_request =w cnel %method_len, 0\n jnz %active_request, @next, @close\n@close\n call $net_close_connection(l %connection)\n jmp @next\n@next\n %following =l loadl %connection\n jmp @loop\n@done\n ret\n}\n")
	qbe_output_line(output, "function l $net_new_handle(w %kind) {\n@start\n %size =l call $net_uv_handle_size(w %kind)\n %handle =l call $calloc(l 1, l %size)\n ret %handle\n}\n")
	qbe_output_line(output, "function l $trbn_network_start(l %host, l %port, l %limit, l %timeout) {\n@start\n %current =l loadl $net_loop\n %active =w cnel %current, 0\n jnz %active, @active, @load\n@active\n ret $net_active_error\n@load\n %loaded =w call $net_load()\n jnz %loaded, @allocate, @dependency\n@dependency\n ret $net_dependency_error\n@allocate\n %size =l call $net_uv_loop_size()\n %loop =l call $calloc(l 1, l %size)\n %oom =w ceql %loop, 0\n jnz %oom, @failure, @initialize\n@initialize\n %initialized =w call $net_uv_loop_init(l %loop)\n %init_error =w cnew %initialized, 0\n jnz %init_error, @free_loop, @own\n@own\n storel %loop, $net_loop\n storel 0, $net_shutdown\n storel %limit, $net_body_limit\n storel %timeout, $net_shutdown_timeout\n %listener =l call $net_new_handle(w 12)\n %no_listener =w ceql %listener, 0\n jnz %no_listener, @cleanup, @tcp\n@tcp\n %tcp_status =w call $net_uv_tcp_init(l %loop, l %listener)\n %tcp_error =w cnew %tcp_status, 0\n jnz %tcp_error, @free_listener, @address\n@address\n storel %listener, $net_listener\n %sockaddr =l alloc8 128\n storel %port, $net_port\n %host_data =l add %host, 24\n %v4 =w call $net_uv_ip4_addr(l %host_data, w %port, l %sockaddr)\n %is_v4 =w ceqw %v4, 0\n jnz %is_v4, @bind, @ipv6\n@ipv6\n %v6 =w call $net_uv_ip6_addr(l %host_data, w %port, l %sockaddr)\n %is_v6 =w ceqw %v6, 0\n jnz %is_v6, @bind, @resolve\n@resolve\n %resolve_size =l call $net_uv_req_size(w 8)\n %resolve_request =l call $calloc(l 1, l %resolve_size)\n %no_resolver =w ceql %resolve_request, 0\n jnz %no_resolver, @cleanup, @resolve_begin\n@resolve_begin\n storel -1, $net_resolve_status\n %resolve_start =w call $net_uv_getaddrinfo(l %loop, l %resolve_request, l $net_resolved, l %host_data, l 0, l 0)\n %resolve_error =w cnew %resolve_start, 0\n jnz %resolve_error, @resolve_free, @resolve_run\n@resolve_free\n call $free(l %resolve_request)\n jmp @cleanup\n@resolve_run\n %resolve_alive =w call $net_uv_run(l %loop, w 1)\n %resolve_status =l loadl $net_resolve_status\n %resolve_pending =w ceql %resolve_status, -1\n jnz %resolve_pending, @resolve_run, @resolve_done\n@resolve_done\n %resolve_failed =w cnel %resolve_status, 0\n jnz %resolve_failed, @cleanup, @listen\n@bind\n %bound =w call $net_uv_tcp_bind(l %listener, l %sockaddr, w 0)\n %bind_error =w cnew %bound, 0\n jnz %bind_error, @cleanup, @listen\n@listen\n %listening =w call $net_uv_listen(l %listener, w 511, l $net_accept)\n %listen_error =w cnew %listening, 0\n jnz %listen_error, @cleanup, @signals\n@signals\n %sigint =l call $net_new_handle(w 16)\n %sigterm =l call $net_new_handle(w 16)\n %timer =l call $net_new_handle(w 13)\n %no_int =w ceql %sigint, 0\n %no_term =w ceql %sigterm, 0\n %no_timer =w ceql %timer, 0\n %no_signals =w or %no_int, %no_term\n %no_handles =w or %no_signals, %no_timer\n jnz %no_handles, @free_signals, @init_int\n@init_int\n %int_init =w call $net_uv_signal_init(l %loop, l %sigint)\n %int_bad =w cnew %int_init, 0\n jnz %int_bad, @free_signals, @init_term\n@init_term\n storel %sigint, $net_signal_int\n %term_init =w call $net_uv_signal_init(l %loop, l %sigterm)\n %term_bad =w cnew %term_init, 0\n jnz %term_bad, @free_term_timer, @init_timer\n@init_timer\n storel %sigterm, $net_signal_term\n %timer_init =w call $net_uv_timer_init(l %loop, l %timer)\n %timer_bad =w cnew %timer_init, 0\n jnz %timer_bad, @free_timer, @watch\n@watch\n storel %timer, $net_timer\n %int_start =w call $net_uv_signal_start(l %sigint, l $net_shutdown_signal, w 2)\n %term_start =w call $net_uv_signal_start(l %sigterm, l $net_shutdown_signal, w 15)\n %int_fail =w cnew %int_start, 0\n %term_fail =w cnew %term_start, 0\n %watch_error =w or %int_fail, %term_fail\n jnz %watch_error, @cleanup, @success\n@success\n ret $net_empty\n@free_signals\n call $free(l %sigint)\n@free_term_timer\n call $free(l %sigterm)\n@free_timer\n call $free(l %timer)\n jmp @cleanup\n@free_listener\n call $free(l %listener)\n@cleanup\n call $trbn_network_stop()\n jmp @failure\n@free_loop\n call $free(l %loop)\n@failure\n ret $net_start_error\n}\n")
	qbe_output_line(output, "function l $trbn_network_next_request() {\n@start\n %loop =l loadl $net_loop\n %absent =w ceql %loop, 0\n jnz %absent, @done, @scan\n@scan\n %head =l loadl $net_connections\n jmp @search\n@search\n %connection =l phi @scan %head, @advance %next\n %empty =w ceql %connection, 0\n jnz %empty, @pump, @check\n@check\n %statep =l add %connection, 24\n %state =l loadl %statep\n %ready =w ceql %state, 1\n jnz %ready, @take, @advance\n@advance\n %next =l loadl %connection\n jmp @search\n@take\n storel 2, %statep\n %idp =l add %connection, 192\n %id =l loadl %idp\n ret %id\n@pump\n %shutdown =l loadl $net_shutdown\n %count =l loadl $net_connection_count\n %stopping =w cnel %shutdown, 0\n %drained =w ceql %count, 0\n %finished =w and %stopping, %drained\n jnz %finished, @done, @run\n@run\n %alive =w call $net_uv_run(l %loop, w 1)\n jmp @scan\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function l $trbn_network_read(l %id, l %field) {\n@start\n %connection =l call $net_find(l %id)\n %none =w ceql %connection, 0\n %invalid =w cugtl %field, 4\n %bad =w or %none, %invalid\n jnz %bad, @empty, @version_test\n@version_test\n %version =w ceql %field, 4\n jnz %version, @version, @copy\n@version\n %parserp =l add %connection, 16\n %parser =l loadl %parserp\n %minor =w call $net_llhttp_get_http_minor(l %parser)\n %ten =w ceqw %minor, 0\n jnz %ten, @ten, @eleven\n@ten\n ret $net_version_10\n@eleven\n ret $net_version_11\n@copy\n %offset =l mul %field, 24\n %base =l add %connection, 64\n %buffer =l add %base, %offset\n %value =l call $net_copy_managed(l %buffer)\n ret %value\n@empty\n ret $net_empty\n}\n")
	qbe_output_line(output, "function l $trbn_network_status(l %id) {\n@start\n %connection =l call $net_find(l %id)\n %none =w ceql %connection, 0\n jnz %none, @missing, @read\n@read\n %pointer =l add %connection, 40\n %status =l loadl %pointer\n ret %status\n@missing\n ret 400\n}\n")
	qbe_output_line(output, "function $net_written(l %request, w %status) {\n@start\n %packet =l call $net_uv_req_get_data(l %request)\n %connection =l loadl %packet\n %datap =l add %packet, 8\n %data =l loadl %datap\n call $free(l %data)\n call $free(l %packet)\n call $free(l %request)\n %statep =l add %connection, 24\n %state =l loadl %statep\n %closing =w ceql %state, 4\n jnz %closing, @done, @check\n@check\n %statusp0 =l add %connection, 40\n %protocol_status =l loadl %statusp0\n %interim =w ceql %protocol_status, 100\n %closep0 =l add %connection, 32\n %close0 =l loadl %closep0\n %closing0 =w cnel %close0, 0\n jnz %closing0, @close, @interim\n@interim\n jnz %interim, @resume, @final\n@resume\n call $net_resume_request(l %connection)\n ret\n@final\n %keep_ptr =l add %connection, 48\n %keep =l loadl %keep_ptr\n %close_ptr =l add %connection, 32\n %close =l loadl %close_ptr\n %shutdown =l loadl $net_shutdown\n %bad_write =w cnew %status, 0\n %no_keep =w ceql %keep, 0\n %must_close =l or %close, %shutdown\n %close_flag =w cnel %must_close, 0\n %bad1 =w or %bad_write, %no_keep\n %bad =w or %bad1, %close_flag\n jnz %bad, @close, @reset\n@reset\n %parserp =l add %connection, 16\n %parser =l loadl %parserp\n call $net_llhttp_reset(l %parser)\n %method_phase =l add %connection, 184\n storel 0, %method_phase\n %headers_finished =l add %connection, 208\n storel 0, %headers_finished\n storel 0, %statep\n %statusp =l add %connection, 40\n storel 0, %statusp\n jmp @clear\n@clear\n %offset =l phi @reset 64, @more %following\n %buffer =l add %connection, %offset\n call $net_clear(l %buffer)\n %following =l add %offset, 24\n %complete =w ceql %following, 160\n jnz %complete, @pending, @more\n@more\n jmp @clear\n@pending\n call $net_continue_read(l %connection)\n ret\n@close\n call $net_close_connection(l %connection)\n@done\n ret\n}\n")
	qbe_output_line(output, "function $net_continue_read(l %connection) {\n@start\n %statep =l add %connection, 24\n %pending =l add %connection, 160\n %pending_lenp =l add %pending, 8\n %pending_len =l loadl %pending_lenp\n %pending_data =l loadl %pending\n %pending_zero =l call $memset(l %pending, w 0, l 24)\n %has_pending =w cnel %pending_len, 0\n jnz %has_pending, @parse, @empty_parse\n@empty_parse\n call $net_parse(l %connection, l $net_colon, l 0)\n jmp @free_pending\n@parse\n call $net_parse(l %connection, l %pending_data, l %pending_len)\n jmp @free_pending\n@free_pending\n call $free(l %pending_data)\n %new_state =l loadl %statep\n %needs_read =w ceql %new_state, 0\n jnz %needs_read, @read, @done\n@read\n %tcpp =l add %connection, 8\n %tcp =l loadl %tcpp\n %reading =w call $net_uv_read_start(l %tcp, l $net_alloc_read, l $net_read)\n %read_error =w cnew %reading, 0\n jnz %read_error, @close, @done\n@close\n call $net_close_connection(l %connection)\n@done\n ret\n}\n")
	qbe_output_line(output, "function l $trbn_network_write(l %id, l %response, l %close) {\n@start\n %connection =l call $net_find(l %id)\n %missing =w ceql %connection, 0\n jnz %missing, @fail, @state\n@state\n %statep =l add %connection, 24\n %state =l loadl %statep\n %invalid =w cnel %state, 2\n jnz %invalid, @fail, @interim\n@interim\n %statusp =l add %connection, 40\n %protocol_status =l loadl %statusp\n %is_interim =w ceql %protocol_status, 100\n %response_lenp =l add %response, 8\n %response_len =l loadl %response_lenp\n %empty =w ceql %response_len, 0\n %no_close =w ceql %close, 0\n %interim_empty =w and %is_interim, %empty\n %continue =w and %interim_empty, %no_close\n jnz %continue, @resume, @allocate\n@resume\n call $net_resume_request(l %connection)\n ret 1\n@allocate\n %size =l call $net_uv_req_size(w 3)\n %request =l call $calloc(l 1, l %size)\n %packet =l call $calloc(l 1, l 32)\n %lenp =l add %response, 8\n %length =l loadl %lenp\n %data =l call $malloc(l %length)\n %no_request =w ceql %request, 0\n %no_packet =w ceql %packet, 0\n %no_data =w ceql %data, 0\n %bad1 =w or %no_request, %no_packet\n %bad =w or %bad1, %no_data\n jnz %bad, @free, @copy\n@copy\n %source =l add %response, 24\n %copied =l call $memcpy(l %data, l %source, l %length)\n storel %connection, %packet\n %buffer =l add %packet, 8\n storel %data, %buffer\n %buffer_len =l add %packet, 16\n storel %length, %buffer_len\n call $net_uv_req_set_data(l %request, l %packet)\n %closep =l add %connection, 32\n %previous_close =l loadl %closep\n %should_close =l or %previous_close, %close\n storel %should_close, %closep\n %tcpp =l add %connection, 8\n %tcp =l loadl %tcpp\n storel 3, %statep\n %status =w call $net_uv_write(l %request, l %tcp, l %buffer, w 1, l $net_written)\n %write_error =w cnew %status, 0\n jnz %write_error, @free, @success\n@free\n call $free(l %request)\n call $free(l %packet)\n call $free(l %data)\n call $net_close_connection(l %connection)\n@fail\n ret 0\n@success\n ret 1\n}\n")
	qbe_output_line(output, "function $trbn_network_stop() {\n@start\n %loop =l loadl $net_loop\n %none =w ceql %loop, 0\n jnz %none, @done, @close\n@close\n %listener =l loadl $net_listener\n %sigint =l loadl $net_signal_int\n %sigterm =l loadl $net_signal_term\n %timer =l loadl $net_timer\n storel 0, $net_listener\n storel 0, $net_signal_int\n storel 0, $net_signal_term\n storel 0, $net_timer\n call $net_close_handle(l %listener)\n call $net_close_handle(l %sigint)\n call $net_close_handle(l %sigterm)\n call $net_close_handle(l %timer)\n call $net_close_all()\n %drained =w call $net_uv_run(l %loop, w 0)\n %closed =w call $net_uv_loop_close(l %loop)\n call $free(l %loop)\n storel 0, $net_loop\n@done\n ret\n}\n\n# getaddrinfo's result is borrowed until uv_freeaddrinfo. The two supported\n# LP64 addrinfo layouts are asserted by the dependency builder.\n")
	qbe_output_line(output, "function $net_resolved(l %request, w %status, l %addresses) {\n@start\n call $free(l %request)\n storel 1, $net_resolve_status\n %failed =w cnew %status, 0\n jnz %failed, @done, @select\n@select\n %darwin =l loadl $net_darwin\n %is_darwin =w cnel %darwin, 0\n jnz %is_darwin, @darwin, @linux\n@darwin\n jmp @loop\n@linux\n jmp @loop\n@loop\n %offset =l phi @darwin 32, @linux 24, @advance %offset\n %row =l phi @darwin %addresses, @linux %addresses, @advance %next\n %none =w ceql %row, 0\n jnz %none, @free, @kind\n@kind\n %typep =l add %row, 8\n %type =w loadw %typep\n %stream =w ceqw %type, 1\n jnz %stream, @bind, @advance\n@advance\n %nextp =l add %row, 40\n %next =l loadl %nextp\n jmp @loop\n@bind\n %addressp =l add %row, %offset\n %address =l loadl %addressp\n %port =l loadl $net_port\n %network_port =w call $htons(w %port)\n %portp =l add %address, 2\n storeh %network_port, %portp\n %listener =l loadl $net_listener\n %bound =w call $net_uv_tcp_bind(l %listener, l %address, w 0)\n %bind_failed =w cnew %bound, 0\n jnz %bind_failed, @advance, @success\n@success\n storel 0, $net_resolve_status\n@free\n call $net_uv_freeaddrinfo(l %addresses)\n@done\n ret\n}\n\n")
	qbe_output_line(output, "function $net_resume_request(l %connection) {\n@start\n %parserp =l add %connection, 16\n %parser =l loadl %parserp\n call $net_llhttp_resume(l %parser)\n %statep =l add %connection, 24\n %statusp =l add %connection, 40\n storel 0, %statep\n storel 0, %statusp\n call $net_continue_read(l %connection)\n ret\n}\n\n# The public HttpMethod is an arbitrary HTTP token; llhttp's request method enum\n# is narrower. Preserve and validate the actual token, then use GET only for\n# request framing. Routing and HEAD semantics always use the original token.\n# CL/TE, URL, version, header and body parsing remain strict llhttp operations.\ndata $net_framing_method = { b \"GET \" }\ndata $net_method_punctuation = { b \"!#$%&'*+-.^_`|~\", b 0 }\n")
	qbe_output_line(output, "function $net_parse(l %connection, l %bytes, l %length) {\n@start\n %phasep =l add %connection, 184\n %phase =l loadl %phasep\n %started =w cnel %phase, 0\n jnz %started, @parse, @scan\n@parse\n call $net_parse_input(l %connection, l %bytes, l %length)\n ret\n@scan\n jmp @byte\n@byte\n %offset =l phi @scan 0, @next %following\n %end =w ceql %offset, %length\n jnz %end, @partial, @read\n@read\n %address =l add %bytes, %offset\n %byte =w loadub %address\n %space =w ceqw %byte, 32\n jnz %space, @method, @validate\n@validate\n %upper1 =w cugew %byte, 65\n %upper2 =w culew %byte, 90\n %upper =w and %upper1, %upper2\n %lower1 =w cugew %byte, 97\n %lower2 =w culew %byte, 122\n %lower =w and %lower1, %lower2\n %digit1 =w cugew %byte, 48\n %digit2 =w culew %byte, 57\n %digit =w and %digit1, %digit2\n %alpha =w or %upper, %lower\n %alphanumeric =w or %alpha, %digit\n jnz %alphanumeric, @next, @punctuation\n@punctuation\n %zero =w ceqw %byte, 0\n jnz %zero, @bad, @lookup\n@lookup\n %found =l call $strchr(l $net_method_punctuation, w %byte)\n %valid =w cnel %found, 0\n jnz %valid, @next, @bad\n@next\n %following =l add %offset, 1\n jmp @byte\n@partial\n %partial_buffer =l add %connection, 88\n %partial_result =w call $net_append(l %partial_buffer, l %bytes, l %length, l 1048576)\n %partial_bad =w cnew %partial_result, 0\n jnz %partial_bad, @bad, @done\n@method\n %buffer =l add %connection, 88\n %result =w call $net_append(l %buffer, l %bytes, l %offset, l 1048576)\n %lenp =l add %buffer, 8\n %method_length =l loadl %lenp\n %empty =w ceql %method_length, 0\n %failed =w cnew %result, 0\n %invalid =w or %empty, %failed\n jnz %invalid, @bad, @frame\n@frame\n storel 1, %phasep\n %parserp =l add %connection, 16\n %parser =l loadl %parserp\n %framing =w call $net_llhttp_execute(l %parser, l $net_framing_method, l 4)\n %framing_bad =w cnew %framing, 0\n jnz %framing_bad, @bad, @rest\n@rest\n %used =l add %offset, 1\n %remaining =l sub %length, %used\n %rest =l add %bytes, %used\n call $net_parse_input(l %connection, l %rest, l %remaining)\n ret\n@bad\n %statusp =l add %connection, 40\n %statep =l add %connection, 24\n %closep =l add %connection, 32\n storel -400, %statusp\n storel 1, %statep\n storel 1, %closep\n %tcpp =l add %connection, 8\n %tcp =l loadl %tcpp\n %stopped =w call $net_uv_read_stop(l %tcp)\n@done\n ret\n}\n")
end
