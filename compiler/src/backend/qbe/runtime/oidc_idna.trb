import { QbeOutput, qbe_output_line } from backend/qbe/output

# Foreign state is released before allocating the managed ASCII result.
def emit_oidc_idna(mut output: QbeOutput)
	qbe_output_line(output, "# Pinned ICU C ABI; URL policy stays in the TypeRB OIDC provider.\ndata $trbn_oidc_idna_initialized = align 8 { l 0 }\nfunction l $trbn_oidc_ascii_hostname(l %name) {\n@start\n %error =l alloc8 8\n storew 0, %error\n %buffer =l alloc8 256\n storeb 0, %buffer\n %info =l alloc8 16\n call $memset(l %info, w 0, l 16)\n storeh 16, %info\n %handlep =l alloc8 8\n storel 0, %handlep\n %resultp =l alloc8 8\n storel 0, %resultp\n %lengthp =l add %name, 8\n %length =l loadl %lengthp\n %bounded =w culel %length, 2147483647\n jnz %bounded, @initialize, @done\n@initialize\n %initialized =l loadl $trbn_oidc_idna_initialized\n %ready =w cnel %initialized, 0\n jnz %ready, @open, @data_policy\n@data_policy\n call $udata_setFileAccess_78(w 3, l %error)\n %data_error =w loadw %error\n %data_failed =w csgtw %data_error, 0\n jnz %data_failed, @done, @mark\n@mark\n storel 1, $trbn_oidc_idna_initialized\n jmp @open\n@open\n %handle =l call $uidna_openUTS46_78(w 30, l %error)\n storel %handle, %handlep\n %opened =w cnel %handle, 0\n jnz %opened, @convert, @done\n@convert\n %source =l add %name, 24\n %count =w call $uidna_nameToASCII_UTF8_78(l %handle, l %source, w %length, l %buffer, w 256, l %info, l %error)\n %status =w loadw %error\n %failed =w csgtw %status, 0\n %errorsp =l add %info, 4\n %errors =w loadw %errorsp\n %invalid =w cnew %errors, 0\n %bad =w or %failed, %invalid\n %empty =w cslew %count, 0\n %failure =w or %bad, %empty\n jnz %failure, @close, @root\n@root\n %used =l extsw %count\n %last_offset =l sub %used, 1\n %lastp =l add %buffer, %last_offset\n %last =w loadub %lastp\n %root_dot =w ceqw %last, 46\n jnz %root_dot, @close, @valid\n@valid\n storel %used, %resultp\n jmp @close\n@close\n call $uidna_close_78(l %handle)\n jmp @done\n@done\n %result_length =l loadl %resultp\n %result =l call $trbn_string_from_bytes(l %buffer, l %result_length)\n ret %result\n}\n")
end
