import { QbeOutput, qbe_output_line } from backend/qbe/output

def emit_network_buffers(mut output: QbeOutput)
	qbe_output_line(output, "# Raw buffers are never traced or retained as managed values.\n# Metadata is (pointer, length, capacity); zero initialization is empty.\n")
	qbe_output_line(output, "function w $net_append(l %buffer, l %data, l %length, l %limit) {\n@start\n %lenp =l add %buffer, 8\n %capp =l add %buffer, 16\n %old =l loadl %lenp\n %room =l sub %limit, %old\n %over =w cugtl %length, %room\n jnz %over, @fail, @size\n@size\n %size =l add %old, %length\n %capacity =l loadl %capp\n %enough =w cugel %capacity, %size\n jnz %enough, @copy, @grow\n@grow\n %twice =l mul %capacity, 2\n %small =w cultl %twice, 4096\n jnz %small, @minimum, @doubled\n@minimum\n jmp @choose\n@doubled\n jmp @choose\n@choose\n %candidate =l phi @minimum 4096, @doubled %twice\n %fits =w cugel %candidate, %size\n jnz %fits, @candidate, @exact\n@candidate\n jmp @allocate\n@exact\n jmp @allocate\n@allocate\n %new_capacity =l phi @candidate %candidate, @exact %size\n %previous =l loadl %buffer\n %memory =l call $realloc(l %previous, l %new_capacity)\n %oom =w ceql %memory, 0\n jnz %oom, @fail, @store\n@store\n storel %memory, %buffer\n storel %new_capacity, %capp\n jmp @copy\n@copy\n %empty =w ceql %length, 0\n jnz %empty, @done, @bytes\n@bytes\n %base =l loadl %buffer\n %target =l add %base, %old\n %copied =l call $memcpy(l %target, l %data, l %length)\n jmp @done\n@done\n storel %size, %lenp\n ret 0\n@fail\n ret -1\n}\n")
	qbe_output_line(output, "function $net_clear(l %buffer) {\n@start\n %pointer =l loadl %buffer\n call $free(l %pointer)\n %zero =l call $memset(l %buffer, w 0, l 24)\n ret\n}\n")
	qbe_output_line(output, "function l $net_copy_managed(l %buffer) {\n@start\n %lenp =l add %buffer, 8\n %length =l loadl %lenp\n %size =l add %length, 17\n %result =l call $trbn_string_alloc(l %size)\n %result_len =l add %result, 8\n %result_count =l add %result, 16\n storel %length, %result_len\n storel %length, %result_count\n %target =l add %result, 24\n %empty =w ceql %length, 0\n jnz %empty, @done, @copy\n@copy\n %source =l loadl %buffer\n %copied =l call $memcpy(l %target, l %source, l %length)\n jmp @done\n@done\n %end =l add %target, %length\n storeb 0, %end\n ret %result\n}\n")
end
