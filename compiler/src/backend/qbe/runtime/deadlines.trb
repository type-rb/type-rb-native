import { QbeOutput, qbe_output_line } from backend/qbe/output

# The qualified POSIX LP64 boundary uses a 16-byte timespec and bounded utsname.
# Monotonic time is independent of the optional OIDC/crypto runtime.
def emit_deadline_clock_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_deadline_clock_id = align 8 { l 0 }\ndata $trbn_deadline_darwin = { b \"Darwin\", b 0 }\ndata $trbn_deadline_linux = { b \"Linux\", b 0 }\ndata $trbn_deadline_clock_error = { b \"panic: monotonic clock unavailable\", b 10 }\nfunction l $trbn_deadline_now() {\n@start\n %cached =l loadl $trbn_deadline_clock_id\n %clock_ready =w cnel %cached, 0\n jnz %clock_ready, @read, @initialize\n@initialize\n %system =l alloc16 2048\n %status =w call $uname(l %system)\n jnz %status, @failed, @darwin\n@darwin\n %apple =w call $memcmp(l %system, l $trbn_deadline_darwin, l 7)\n jnz %apple, @linux, @apple\n@apple\n storel 6, $trbn_deadline_clock_id\n jmp @read\n@linux\n %linux =w call $memcmp(l %system, l $trbn_deadline_linux, l 6)\n jnz %linux, @failed, @unix\n@unix\n storel 1, $trbn_deadline_clock_id\n jmp @read\n@read\n %clock =l loadl $trbn_deadline_clock_id\n %parts =l alloc8 16\n %result =w call $clock_gettime(w %clock, l %parts)\n jnz %result, @failed, @value\n@value\n %seconds =l loadl %parts\n %offset =l add %parts, 8\n %nanos =l loadl %offset\n %scaled =l mul %seconds, 1000000000\n %now =l add %scaled, %nanos\n ret %now\n@failed\n ret -1\n}\nfunction l $trbn_deadline_checked_now() {\n@start\n %now =l call $trbn_deadline_now()\n %available =w csgel %now, 0\n jnz %available, @value, @failed\n@value\n ret %now\n@failed\n call $trbn_fail(l $trbn_deadline_clock_error, l 35)\n hlt\n}\n")
end

# Deadline frames use the same qualified 1024-byte, 16-byte-aligned jump
# environment as ordinary recovery. Only these callback trampolines return
# twice. Saved fields remain immutable across every callback and unwind.
# An ordinary error pops exactly the deadline frames crossed on its way to the
# nearest recovery frame; it does not become a timeout response.
def emit_deadline_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_deadline_scope = align 8 { l 0 }\n# Frames retain their parent, selected owner and absolute monotonic deadline.\n# A child never extends an enclosing scope's remaining budget.\nfunction $trbn_deadline_leave_recovery(l %recovery) {\n@start\n jmp @next\n@next\n %scope =l loadl $trbn_deadline_scope\n %scope_present =w cnel %scope, 0\n jnz %scope_present, @inspect, @done\n@inspect\n %saved =l add %scope, 32\n %boundary =l loadl %saved\n %crossed =w ceql %boundary, %recovery\n jnz %crossed, @pop, @done\n@pop\n %parent =l loadl %scope\n storel %parent, $trbn_deadline_scope\n jmp @next\n@done\n ret\n}\n\n# This query never transfers control. Foreign code can use the budget without\n# allowing a managed unwind through its stack or callbacks.\nfunction l $trbn_deadline_remaining_millis() {\n@start\n %scope =l loadl $trbn_deadline_scope\n %scope_present =w cnel %scope, 0\n jnz %scope_present, @active, @none\n@none\n ret -1\n@active\n %deadline_slot =l add %scope, 16\n %deadline =l loadl %deadline_slot\n %now =l call $trbn_deadline_now()\n %available =w csgel %now, 0\n jnz %available, @remaining, @zero\n@remaining\n %remaining =l sub %deadline, %now\n %expired =w cslel %remaining, 0\n jnz %expired, @zero, @positive\n@zero\n ret 0\n@positive\n %whole =l div %remaining, 1000000\n %fraction =l rem %remaining, 1000000\n %partial =w cnel %fraction, 0\n %extra =l extuw %partial\n %millis =l add %whole, %extra\n ret %millis\n}\n\n# Call only from managed checkpoints or after foreign cleanup. The selected\n# deadline owner can bypass younger ordinary-recovery and deadline frames.\nfunction $trbn_deadline_checkpoint() {\n@start\n %scope =l loadl $trbn_deadline_scope\n %scope_present =w cnel %scope, 0\n jnz %scope_present, @active, @done\n@active\n %deadline_slot =l add %scope, 16\n %deadline =l loadl %deadline_slot\n %now =l call $trbn_deadline_checked_now()\n %remaining =l sub %deadline, %now\n %expired =w cslel %remaining, 0\n jnz %expired, @cancel, @done\n@cancel\n %owner_slot =l add %scope, 8\n %owner =l loadl %owner_slot\n %cleanup_slot =l add %owner, 40\n %cleanup =l loadl %cleanup_slot\n call $trbn_resource_unwind(l %cleanup)\n %recovery_slot =l add %owner, 32\n %recovery =l loadl %recovery_slot\n storel %recovery, $trbn_recovery_scope\n storel %owner, $trbn_deadline_scope\n %environment =l add %owner, 64\n call $longjmp(l %environment, w 1)\n hlt\n@done\n ret\n}\n")
	qbe_output_line(output, "function l $trbn_runtime_deadline_l(l %action, l %milliseconds, l %fallback) {\n@start\n %scope =l alloc16 1088\n %parent =l loadl $trbn_deadline_scope\n storel %parent, %scope\n %owner_slot =l add %scope, 8\n storel %scope, %owner_slot\n %now =l call $trbn_deadline_checked_now()\n %duration =l mul %milliseconds, 1000000\n %positive =w csgtl %duration, 0\n jnz %positive, @future, @expired\n@future\n %future =l add %now, %duration\n jmp @select\n@expired\n jmp @select\n@select\n %own_deadline =l phi @future %future, @expired %now\n %deadline_slot =l add %scope, 16\n storel %own_deadline, %deadline_slot\n %parent_present =w cnel %parent, 0\n jnz %parent_present, @compare, @save\n@compare\n %parent_slot =l add %parent, 16\n %parent_deadline =l loadl %parent_slot\n %parent_remaining =l sub %parent_deadline, %now\n %own_remaining =l sub %own_deadline, %now\n %earlier =w cslel %parent_remaining, %own_remaining\n jnz %earlier, @inherit, @save\n@inherit\n storel %parent_deadline, %deadline_slot\n %parent_owner_slot =l add %parent, 8\n %parent_owner =l loadl %parent_owner_slot\n storel %parent_owner, %owner_slot\n jmp @save\n@save\n %roots =l loadl $trbn_gc_temp_count\n %roots_slot =l add %scope, 24\n storel %roots, %roots_slot\n %recovery =l loadl $trbn_recovery_scope\n %recovery_slot =l add %scope, 32\n storel %recovery, %recovery_slot\n %cleanup =l loadl $trbn_resource_scope\n %cleanup_slot =l add %scope, 40\n storel %cleanup, %cleanup_slot\n %action_slot =l add %scope, 48\n storel %action, %action_slot\n %fallback_slot =l add %scope, 56\n storel %fallback, %fallback_slot\n %environment =l add %scope, 64\n %caught =w call $setjmp(l %environment)\n jnz %caught, @caught, @invoke\n@invoke\n storel %scope, $trbn_deadline_scope\n call $trbn_deadline_checkpoint()\n %saved_action =l add %scope, 48\n %closure =l loadl %saved_action\n %code_slot =l add %closure, 8\n %code =l loadl %code_slot\n %result =l call %code(l %closure)\n call $trbn_deadline_checkpoint()\n jmp @complete\n@caught\n %saved_fallback =l add %scope, 56\n %fallback_result =l loadl %saved_fallback\n jmp @complete\n@complete\n %value =l phi @invoke %result, @caught %fallback_result\n %parent_after =l loadl %scope\n storel %parent_after, $trbn_deadline_scope\n %saved_recovery =l add %scope, 32\n %recovery_after =l loadl %saved_recovery\n storel %recovery_after, $trbn_recovery_scope\n %saved_roots =l add %scope, 24\n %root_count =l loadl %saved_roots\n storel %root_count, $trbn_gc_temp_count\n call $trbn_deadline_checkpoint()\n ret %value\n}\n")
	qbe_output_line(output, "function d $trbn_runtime_deadline_d(l %action, l %milliseconds, d %fallback) {\n@start\n %scope =l alloc16 1088\n %parent =l loadl $trbn_deadline_scope\n storel %parent, %scope\n %owner_slot =l add %scope, 8\n storel %scope, %owner_slot\n %now =l call $trbn_deadline_checked_now()\n %duration =l mul %milliseconds, 1000000\n %positive =w csgtl %duration, 0\n jnz %positive, @future, @expired\n@future\n %future =l add %now, %duration\n jmp @select\n@expired\n jmp @select\n@select\n %own_deadline =l phi @future %future, @expired %now\n %deadline_slot =l add %scope, 16\n storel %own_deadline, %deadline_slot\n %parent_present =w cnel %parent, 0\n jnz %parent_present, @compare, @save\n@compare\n %parent_slot =l add %parent, 16\n %parent_deadline =l loadl %parent_slot\n %parent_remaining =l sub %parent_deadline, %now\n %own_remaining =l sub %own_deadline, %now\n %earlier =w cslel %parent_remaining, %own_remaining\n jnz %earlier, @inherit, @save\n@inherit\n storel %parent_deadline, %deadline_slot\n %parent_owner_slot =l add %parent, 8\n %parent_owner =l loadl %parent_owner_slot\n storel %parent_owner, %owner_slot\n jmp @save\n@save\n %roots =l loadl $trbn_gc_temp_count\n %roots_slot =l add %scope, 24\n storel %roots, %roots_slot\n %recovery =l loadl $trbn_recovery_scope\n %recovery_slot =l add %scope, 32\n storel %recovery, %recovery_slot\n %cleanup =l loadl $trbn_resource_scope\n %cleanup_slot =l add %scope, 40\n storel %cleanup, %cleanup_slot\n %action_slot =l add %scope, 48\n storel %action, %action_slot\n %fallback_slot =l add %scope, 56\n stored %fallback, %fallback_slot\n %environment =l add %scope, 64\n %caught =w call $setjmp(l %environment)\n jnz %caught, @caught, @invoke\n@invoke\n storel %scope, $trbn_deadline_scope\n call $trbn_deadline_checkpoint()\n %saved_action =l add %scope, 48\n %closure =l loadl %saved_action\n %code_slot =l add %closure, 8\n %code =l loadl %code_slot\n %result =d call %code(l %closure)\n call $trbn_deadline_checkpoint()\n jmp @complete\n@caught\n %saved_fallback =l add %scope, 56\n %fallback_result =d loadd %saved_fallback\n jmp @complete\n@complete\n %value =d phi @invoke %result, @caught %fallback_result\n %parent_after =l loadl %scope\n storel %parent_after, $trbn_deadline_scope\n %saved_recovery =l add %scope, 32\n %recovery_after =l loadl %saved_recovery\n storel %recovery_after, $trbn_recovery_scope\n %saved_roots =l add %scope, 24\n %root_count =l loadl %saved_roots\n storel %root_count, $trbn_gc_temp_count\n call $trbn_deadline_checkpoint()\n ret %value\n}\n")
end
