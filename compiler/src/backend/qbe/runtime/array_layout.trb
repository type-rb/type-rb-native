# Internal Array layout, relative to the managed object descriptor.
# Capacity counts slots from the logical data pointer to the allocation end.
# Total capacity also includes the cleared prefix before the logical window.
def array_backing_offset(): Integer
	return 32
end

def array_payload_bytes(): Integer
	return 32
end

# Allocation includes the GC link and descriptor before the Array payload.
def array_allocation_bytes(): Integer
	return 48
end
