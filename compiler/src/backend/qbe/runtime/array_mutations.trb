import { array_backing_offset } from backend/qbe/runtime/array_layout
import { QbeOutput, qbe_output_line } from backend/qbe/output
import { integer_string } from support/literals

# Keep object identity and contiguous logical data, clearing removed references.
# Draining resets the window, so a later push can reuse the whole allocation.
def emit_array_mutation_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function $trbn_array_unshift(l %array, l %value) {\n@start\n %length_slot =l add %array, 8\n %length =l loadl %length_slot\n %data_slot =l add %array, 24\n %data =l loadl %data_slot\n %backing_slot =l add %array, " + integer_string(array_backing_offset()) + "\n %base =l loadl %backing_slot\n %prefix =w cnel %data, %base\n jnz %prefix, @reuse, @append\n@reuse\n %previous =l sub %data, 8\n storel %value, %previous\n storel %previous, %data_slot\n %capacity_slot =l add %array, 16\n %capacity =l loadl %capacity_slot\n %expanded =l add %capacity, 1\n storel %expanded, %capacity_slot\n %new_length =l add %length, 1\n storel %new_length, %length_slot\n ret\n@append\n call $trbn_array_push_paced(l %array, l %value)\n %current =l loadl %data_slot\n %next =l add %current, 8\n %bytes =l mul %length, 8\n call $memmove(l %next, l %current, l %bytes)\n storel %value, %current\n ret\n}\n\nfunction l $trbn_array_remove(l %array, w %mode) {\n@start\n %length_slot =l add %array, 8\n %length =l loadl %length_slot\n %empty =w ceql %length, 0\n jnz %empty, @failure, @ready\n@failure\n call $trbn_fail(l $trbn_array_empty_error, l 22)\n hlt\n@ready\n %remaining =l sub %length, 1\n %data_slot =l add %array, 24\n %data =l loadl %data_slot\n %capacity_slot =l add %array, 16\n %capacity =l loadl %capacity_slot\n %shifting =w ceqw %mode, 2\n jnz %shifting, @shift, @pop\n@pop\n %last_offset =l shl %remaining, 3\n %last =l add %data, %last_offset\n %last_value =l loadl %last\n storel 0, %last\n jmp @finish\n@shift\n %first_value =l loadl %data\n storel 0, %data\n %next =l add %data, 8\n %reduced =l sub %capacity, 1\n jmp @finish\n@finish\n %value =l phi @pop %last_value, @shift %first_value\n %window =l phi @pop %data, @shift %next\n %window_capacity =l phi @pop %capacity, @shift %reduced\n storel %remaining, %length_slot\n %drained =w ceql %remaining, 0\n jnz %drained, @reset, @retain\n@reset\n %backing_slot =l add %array, " + integer_string(array_backing_offset()) + "\n %base =l loadl %backing_slot\n %prefix_bytes =l sub %window, %base\n %prefix =l shr %prefix_bytes, 3\n %total_capacity =l add %window_capacity, %prefix\n storel %base, %data_slot\n storel %total_capacity, %capacity_slot\n ret %value\n@retain\n storel %window, %data_slot\n storel %window_capacity, %capacity_slot\n ret %value\n}\n")
end
