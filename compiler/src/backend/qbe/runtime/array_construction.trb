# Both constructors share object initialization and backing-byte accounting.
# The hint is a valid Array length, not a promised final length or stable bound.
def array_construction_qbe(reserved: Boolean): String
	function_start := "function l "
	mut prefix := function_start + "$trbn_array_new(l %descriptor) {\n@start\n"
	mut bytes := "32"
	mut capacity := "4"
	mut backing := "call $trbn_array_backing_new()"
	if reserved
		prefix = function_start + "$trbn_array_new_reserved(l %descriptor, l %requested) {\n@start\n\t%small =w csltl %requested, 4\n\tjnz %small, @minimum, @requested\n@minimum\n\tjmp @allocate\n@requested\n\tjmp @allocate\n@allocate\n\t%reserved_capacity =l phi @minimum 4, @requested %requested\n\t%reserved_bytes =l shl %reserved_capacity, 3\n"
		bytes = "%reserved_bytes"
		capacity = "%reserved_capacity"
		backing = "call $calloc(l %reserved_capacity, l 8)"
	end
	return prefix + "\t%array =l call $trbn_gc_alloc(l %descriptor, l 24, l " + bytes + ")\n\t%data =l " + backing + "\n\t%failed =w ceql %data, 0\n\tjnz %failed, @fail, @initialize\n@fail\n\tcall $trbn_fail(l $trbn_allocation_error, l 26)\n\thlt\n@initialize\n\t%heap =l loadl $trbn_gc_heap_bytes\n\t%heap_with_data =l add %heap, " + bytes + "\n\tstorel %heap_with_data, $trbn_gc_heap_bytes\n\t%allocated =l loadl $trbn_gc_allocated_bytes\n\t%allocated_with_data =l add %allocated, " + bytes + "\n\tstorel %allocated_with_data, $trbn_gc_allocated_bytes\n\tcall $trbn_gc_update_peak(l %heap_with_data)\n\t%length =l add %array, 8\n\tstorel 0, %length\n\t%capacity =l add %array, 16\n\tstorel " + capacity + ", %capacity\n\t%data_slot =l add %array, 24\n\tstorel %data, %data_slot\n\tret %array\n}\n"
end
