import { QbeOutput, qbe_output_line } from backend/qbe/output

# Target-neutral IL selects only the registered POSIX LP64 ABI profiles. The
# header probe qualifies constants/layouts; libc owns all host operations.
# Structured scope verification and public Result construction stay above this
# raw layer. No pointer or descriptor is exposed as an authored Integer value.
def emit_filesystem_io_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_fs_inode64 = align 4 { w 0 }\ndata $trbn_fs_fstat_function = align 8 { l 0 }\ndata $trbn_fs_fstat_name = { b \"fstat\", b 0 }\ndata $trbn_fs_fstat_inode64 = { b \"fstat$INODE64\", b 0 }\ndata $trbn_fs_stat_function = align 8 { l 0 }\ndata $trbn_fs_stat_name = { b \"stat\", b 0 }\ndata $trbn_fs_stat_inode64 = { b \"stat$INODE64\", b 0 }\ndata $trbn_fs_lstat_function = align 8 { l 0 }\ndata $trbn_fs_lstat_name = { b \"lstat\", b 0 }\ndata $trbn_fs_lstat_inode64 = { b \"lstat$INODE64\", b 0 }\ndata $trbn_fs_readdir_function = align 8 { l 0 }\ndata $trbn_fs_readdir_name = { b \"readdir\", b 0 }\ndata $trbn_fs_readdir_inode64 = { b \"readdir$INODE64\", b 0 }\ndata $trbn_fs_profile = align 8 { l 0 }\ndata $trbn_fs_errno_function = align 8 { l 0 }\ndata $trbn_fs_darwin = { b \"Darwin\", b 0 }\ndata $trbn_fs_linux = { b \"Linux\", b 0 }\ndata $trbn_fs_arm64 = { b \"arm64\", b 0 }\ndata $trbn_fs_aarch64 = { b \"aarch64\", b 0 }\ndata $trbn_fs_amd64 = { b \"x86_64\", b 0 }\ndata $trbn_fs_errno_darwin = { b \"__error\", b 0 }\ndata $trbn_fs_errno_linux = { b \"__errno_location\", b 0 }\nfunction l $trbn_fs_initialize() {\n@start\n %cached =l loadl $trbn_fs_profile\n %cached_nonzero =w cnel %cached, 0\n jnz %cached_nonzero, @cached, @detect\n@cached\n ret %cached\n@detect\n %buffer =l alloc8 2048\n %status =w call $uname(l %buffer)\n jnz %status, @unsupported, @system\n@system\n %apple =w call $strcmp(l %buffer, l $trbn_fs_darwin)\n jnz %apple, @linux, @darwin\n@darwin\n %apple_machine =l add %buffer, 1024\n %apple_arm =w call $strcmp(l %apple_machine, l $trbn_fs_arm64)\n %apple_intel =w call $strcmp(l %apple_machine, l $trbn_fs_amd64)\n %apple_is_arm =w ceqw %apple_arm, 0\n %apple_is_intel =w ceqw %apple_intel, 0\n %apple_valid =w or %apple_is_arm, %apple_is_intel\n jnz %apple_valid, @apple_errno, @unsupported\n@apple_errno\n %apple_function =l call $dlsym(l -2, l $trbn_fs_errno_darwin)\n jmp @configured\n@linux\n %linux =w call $strcmp(l %buffer, l $trbn_fs_linux)\n jnz %linux, @unsupported, @linux_machine\n@linux_machine\n %machine =l add %buffer, 260\n %arm =w call $strcmp(l %machine, l $trbn_fs_aarch64)\n jnz %arm, @intel, @linux_arm\n@intel\n %intel =w call $strcmp(l %machine, l $trbn_fs_amd64)\n jnz %intel, @unsupported, @linux_intel\n@linux_arm\n jmp @linux_errno\n@linux_intel\n jmp @linux_errno\n@linux_errno\n %linux_profile =l phi @linux_arm 3, @linux_intel 2\n %linux_function =l call $dlsym(l 0, l $trbn_fs_errno_linux)\n jmp @configured\n@configured\n %profile =l phi @apple_errno 1, @linux_errno %linux_profile\n %function =l phi @apple_errno %apple_function, @linux_errno %linux_function\n %inode64 =w phi @apple_errno %apple_is_intel, @linux_errno 0\n %function_nonzero =w cnel %function, 0\n jnz %function_nonzero, @ready, @unsupported\n@ready\n storel %function, $trbn_fs_errno_function\n storel %profile, $trbn_fs_profile\n storew %inode64, $trbn_fs_inode64\n %fstat =l call $trbn_fs_resolve(l $trbn_fs_fstat_name, l $trbn_fs_fstat_inode64)\n storel %fstat, $trbn_fs_fstat_function\n %fstat_valid =w cnel %fstat, 0\n %stat =l call $trbn_fs_resolve(l $trbn_fs_stat_name, l $trbn_fs_stat_inode64)\n storel %stat, $trbn_fs_stat_function\n %stat_valid =w cnel %stat, 0\n %lstat =l call $trbn_fs_resolve(l $trbn_fs_lstat_name, l $trbn_fs_lstat_inode64)\n storel %lstat, $trbn_fs_lstat_function\n %lstat_valid =w cnel %lstat, 0\n %readdir =l call $trbn_fs_resolve(l $trbn_fs_readdir_name, l $trbn_fs_readdir_inode64)\n storel %readdir, $trbn_fs_readdir_function\n %readdir_valid =w cnel %readdir, 0\n %first =w and %fstat_valid, %stat_valid\n %second =w and %lstat_valid, %readdir_valid\n %all =w and %first, %second\n jnz %all, @done, @unsupported\n@done\n ret %profile\n@unsupported\n storel 0, $trbn_fs_profile\n ret 0\n}\nfunction w $trbn_fs_errno() {\n@start\n %function =l loadl $trbn_fs_errno_function\n %address =l call %function()\n %error =w loadw %address\n ret %error\n}\nfunction l $trbn_fs_resolve(l %normal, l %versioned) {\n@start\n %profile =l loadl $trbn_fs_profile\n %apple =w ceql %profile, 1\n jnz %apple, @apple, @linux\n@apple\n %version =w loadw $trbn_fs_inode64\n jnz %version, @versioned, @normal\n@normal\n jmp @darwin\n@versioned\n jmp @darwin\n@darwin\n %symbol =l phi @normal %normal, @versioned %versioned\n %apple_function =l call $dlsym(l -2, l %symbol)\n ret %apple_function\n@linux\n %linux_function =l call $dlsym(l 0, l %normal)\n ret %linux_function\n}\n")
	qbe_output_line(output, "# Zero is success, positive values preserve errno. Negative statuses are\n# InvalidPath (-1), nonregular (-2), unsupported host (-3), invalid mode (-4).\n# This raw boundary allocates no managed objects and registers only a validated\n# regular descriptor. The caller owns the frame for the entire lexical region.\nfunction l $trbn_file_acquire(l %scope, l %path, l %length, l %mode) {\n@start\n %empty =w cslel %length, 0\n jnz %empty, @invalid_path, @path\n@path\n %actual =l call $strlen(l %path)\n %valid_path =w ceql %actual, %length\n jnz %valid_path, @mode, @invalid_path\n@invalid_path\n ret -1\n@mode\n %valid_mode =w culel %mode, 2\n jnz %valid_mode, @initialize, @invalid_mode\n@invalid_mode\n ret -4\n@initialize\n %profile =l call $trbn_fs_initialize()\n %profile_nonzero =w cnel %profile, 0\n jnz %profile_nonzero, @platform, @unsupported\n@unsupported\n ret -3\n@platform\n %darwin =w ceql %profile, 1\n jnz %darwin, @apple_flags, @linux_flags\n@apple_flags\n jmp @flags\n@linux_flags\n jmp @flags\n@flags\n %base =w phi @apple_flags 16908292, @linux_flags 526592\n %create =w phi @apple_flags 512, @linux_flags 64\n %exclusive =w phi @apple_flags 2048, @linux_flags 128\n %reading =w ceql %mode, 0\n jnz %reading, @read_flags, @write_flags\n@read_flags\n jmp @open\n@write_flags\n %created =w or %base, %create\n %write_flags =w or %created, 1\n %new =w ceql %mode, 2\n jnz %new, @exclusive_flags, @ordinary_flags\n@exclusive_flags\n %exclusive_flags =w or %write_flags, %exclusive\n jmp @open\n@ordinary_flags\n jmp @open\n@open\n %flags =w phi @read_flags %base, @ordinary_flags %write_flags, @exclusive_flags %exclusive_flags\n jmp @retry_open\n@retry_open\n %fd =w call $open(l %path, w %flags, ..., w 420)\n %opened =w csgew %fd, 0\n jnz %opened, @buffer, @open_error\n@open_error\n %open_error =w call $trbn_fs_errno()\n %interrupted =w ceqw %open_error, 4\n jnz %interrupted, @retry_open, @open_failed\n@open_failed\n %open_result =l extuw %open_error\n ret %open_result\n@buffer\n %stat =l alloc8 144\n jmp @stat\n@stat\n %stat_function =l loadl $trbn_fs_fstat_function\n %stat_status =w call %stat_function(w %fd, l %stat)\n jnz %stat_status, @stat_error, @layout\n@stat_error\n %stat_error =w call $trbn_fs_errno()\n %stat_interrupted =w ceqw %stat_error, 4\n jnz %stat_interrupted, @stat, @stat_failed\n@stat_failed\n %stat_result =l extuw %stat_error\n jmp @close_failed\n@layout\n jnz %darwin, @apple_mode, @linux_mode\n@apple_mode\n %apple_modep =l add %stat, 4\n %apple_mode =w loaduh %apple_modep\n jmp @kind\n@linux_mode\n %arm =w ceql %profile, 3\n jnz %arm, @arm_mode, @intel_mode\n@arm_mode\n %arm_modep =l add %stat, 16\n jmp @linux_kind\n@intel_mode\n %intel_modep =l add %stat, 24\n jmp @linux_kind\n@linux_kind\n %linux_modep =l phi @arm_mode %arm_modep, @intel_mode %intel_modep\n %linux_mode =w loadw %linux_modep\n jmp @kind\n@kind\n %raw_mode =w phi @apple_mode %apple_mode, @linux_kind %linux_mode\n %kind =w and %raw_mode, 61440\n %regular =w ceqw %kind, 32768\n jnz %regular, @truncation, @nonregular\n@nonregular\n jmp @close_failed\n@truncation\n %truncate =w ceql %mode, 1\n jnz %truncate, @truncate, @register\n@truncate\n %truncated =w call $ftruncate(w %fd, l 0)\n jnz %truncated, @truncate_error, @register\n@truncate_error\n %truncate_error =w call $trbn_fs_errno()\n %truncate_interrupted =w ceqw %truncate_error, 4\n jnz %truncate_interrupted, @truncate, @truncate_failed\n@truncate_failed\n %truncate_result =l extuw %truncate_error\n jmp @close_failed\n@close_failed\n %result =l phi @stat_failed %stat_result, @nonregular -2, @truncate_failed %truncate_result\n %closed =w call $close(w %fd)\n ret %result\n@register\n call $trbn_resource_push(l %scope, w %fd)\n ret 0\n}\n")
	qbe_output_line(output, "# Counts and buffers are supplied by the verified, bounded managed wrapper.\n# No allocation occurs here; EINTR never loses progress. Negative read results\n# encode errno, while write returns zero or a positive errno. A zero-byte write\n# with pending data is EIO, so a faulty host cannot create an infinite loop.\nfunction l $trbn_file_read_into(w %fd, l %buffer, l %count) {\n@start\n %negative =w csltl %count, 0\n jnz %negative, @invalid, @read\n@invalid\n ret -22\n@read\n %read =l call $read(w %fd, l %buffer, l %count)\n %valid =w cslel 0, %read\n jnz %valid, @done, @error\n@error\n %error =w call $trbn_fs_errno()\n %interrupted =w ceqw %error, 4\n jnz %interrupted, @read, @failed\n@failed\n %wide =l extuw %error\n %failure =l sub 0, %wide\n ret %failure\n@done\n ret %read\n}\nfunction l $trbn_file_write_all(w %fd, l %buffer, l %count) {\n@start\n %negative =w csltl %count, 0\n jnz %negative, @invalid, @begin\n@invalid\n ret 22\n@begin\n %empty =w ceql %count, 0\n jnz %empty, @empty_write, @nonempty\n@empty_write\n %empty_status =l call $write(w %fd, l %buffer, l 0)\n %empty_failed =w csltl %empty_status, 0\n jnz %empty_failed, @empty_error, @done\n@empty_error\n %empty_errno =w call $trbn_fs_errno()\n %empty_interrupted =w ceqw %empty_errno, 4\n jnz %empty_interrupted, @empty_write, @empty_failed\n@empty_failed\n %empty_failure =l extuw %empty_errno\n ret %empty_failure\n@nonempty\n jmp @next\n@next\n %offset =l phi @nonempty 0, @advance %next\n %done =w ceql %offset, %count\n jnz %done, @done, @pending\n@pending\n %remaining =l sub %count, %offset\n %data =l add %buffer, %offset\n jmp @write\n@write\n %written =l call $write(w %fd, l %data, l %remaining)\n %positive =w csgtl %written, 0\n jnz %positive, @advance, @error\n@error\n %zero =w ceql %written, 0\n jnz %zero, @stalled, @errno\n@stalled\n ret 5\n@errno\n %error =w call $trbn_fs_errno()\n %interrupted =w ceqw %error, 4\n jnz %interrupted, @write, @failed\n@failed\n %failure =l extuw %error\n ret %failure\n@advance\n %next =l add %offset, %written\n jmp @next\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function l $trbn_file_release(l %scope) {\n@start\n %status =w call $trbn_resource_close(l %scope)\n jnz %status, @failed, @done\n@failed\n %error =w call $trbn_fs_errno()\n %result =l extuw %error\n ret %result\n@done\n ret 0\n}\n")
end
