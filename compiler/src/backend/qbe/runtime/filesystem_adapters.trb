import { QbeOutput, qbe_output_line } from backend/qbe/output

# Foreign file buffers and descriptors stay inside the managed File boundary.
def emit_filesystem_adapter_runtime(mut output: QbeOutput)
	qbe_output_line(output, "function l $trbn_filesystem_read_bytes(l %file, l %maximum, l %output) {\n@start\n %sizep =l add %output, 8\n %size =l loadl %sizep\n %valid =w ceql %size, 1\n jnz %valid, @read, @invalid\n@invalid\n ret -4\n@read\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %file)\n call $trbn_gc_temp_push(l %output)\n %out =l alloc8 8\n %status =l call $trbn_file_read_value(l %file, l %maximum, l 0, l %out)\n %failed =w cnel %status, 0\n jnz %failed, @done, @store\n@store\n %value =l loadl %out\n %storagep =l add %output, 24\n %storage =l loadl %storagep\n storel %value, %storage\n jmp @done\n@done\n storel %roots, $trbn_gc_temp_count\n ret %status\n}\n")
	qbe_output_line(output, "function l $trbn_filesystem_read_text(l %file, l %maximum, l %output) {\n@start\n %sizep =l add %output, 8\n %size =l loadl %sizep\n %valid =w ceql %size, 1\n jnz %valid, @read, @invalid\n@invalid\n ret -4\n@read\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %file)\n call $trbn_gc_temp_push(l %output)\n %out =l alloc8 8\n %status =l call $trbn_file_read_value(l %file, l %maximum, l 1, l %out)\n %failed =w cnel %status, 0\n jnz %failed, @done, @store\n@store\n %value =l loadl %out\n %storagep =l add %output, 24\n %storage =l loadl %storagep\n storel %value, %storage\n jmp @done\n@done\n storel %roots, $trbn_gc_temp_count\n ret %status\n}\n")
	qbe_output_line(output, "function l $trbn_filesystem_write_bytes(l %file, l %value) {\n@start\n %status =l call $trbn_file_write_value(l %file, l %value)\n ret %status\n}\n")
	qbe_output_line(output, "function l $trbn_filesystem_write_text(l %file, l %value) {\n@start\n %status =l call $trbn_file_write_value(l %file, l %value)\n ret %status\n}\n")
	qbe_output_line(output, "function l $trbn_filesystem_path(l %file) {\n@start\n %slot =l add %file, 8\n %path =l loadl %slot\n ret %path\n}\nfunction l $trbn_filesystem_error_kind(l %status) {\n@start\n %positive =w csgtl %status, 0\n jnz %positive, @host, @domain\n@host\n %missing =w ceql %status, 2\n jnz %missing, @not_found, @exists\n@not_found\n ret 2\n@exists\n %exists =w ceql %status, 17\n jnz %exists, @already_exists, @permission\n@already_exists\n ret 1\n@permission\n %access =w ceql %status, 13\n %operation =w ceql %status, 1\n %denied =w or %access, %operation\n jnz %denied, @permission_denied, @other\n@permission_denied\n ret 3\n@domain\n %path =w ceql %status, -1\n jnz %path, @invalid_path, @limit\n@invalid_path\n ret 4\n@limit\n %limit_file =w ceql %status, -5\n %limit_dir =w ceql %status, -9\n %limit =w or %limit_file, %limit_dir\n jnz %limit, @invalid_limit, @large\n@invalid_limit\n ret 5\n@large\n %large_file =w ceql %status, -6\n %large_dir =w ceql %status, -10\n %large =w or %large_file, %large_dir\n jnz %large, @too_large, @encoding\n@too_large\n ret 6\n@encoding\n %encoding =w ceql %status, -7\n jnz %encoding, @invalid_encoding, @name\n@name\n %name =w ceql %status, -8\n jnz %name, @unsupported_name, @unsupported\n@unsupported_name\n ret 9\n@invalid_encoding\n ret 7\n@unsupported\n %unsupported =w ceql %status, -3\n jnz %unsupported, @not_supported, @other\n@not_supported\n ret 8\n@other\n ret 0\n}\n")
	qbe_output_line(output, "data $trbn_filesystem_error0 = { b \"filesystem operation failed\", b 0 }\ndata $trbn_filesystem_error1 = { b \"path must be nonempty and contain no NUL\", b 0 }\ndata $trbn_filesystem_error2 = { b \"opened handle is not a regular file\", b 0 }\ndata $trbn_filesystem_error3 = { b \"filesystem platform is unavailable\", b 0 }\ndata $trbn_filesystem_error4 = { b \"invalid filesystem operation\", b 0 }\ndata $trbn_filesystem_error5 = { b \"max_bytes must be non-negative\", b 0 }\ndata $trbn_filesystem_error6 = { b \"file exceeds max_bytes\", b 0 }\ndata $trbn_filesystem_error7 = { b \"file is not valid UTF-8\", b 0 }\ndata $trbn_filesystem_error8 = { b \"directory entry name is not valid UTF-8\", b 0 }\ndata $trbn_filesystem_error9 = { b \"max_entries must be non-negative\", b 0 }\ndata $trbn_filesystem_error10 = { b \"directory exceeds max_entries\", b 0 }\ndata $trbn_filesystem_errors = align 8 { l $trbn_filesystem_error0, l $trbn_filesystem_error1, l $trbn_filesystem_error2, l $trbn_filesystem_error3, l $trbn_filesystem_error4, l $trbn_filesystem_error5, l $trbn_filesystem_error6, l $trbn_filesystem_error7, l $trbn_filesystem_error8, l $trbn_filesystem_error9, l $trbn_filesystem_error10 }\nfunction l $trbn_filesystem_error_message(l %status) {\n@start\n %positive =w csgtl %status, 0\n jnz %positive, @host, @domain\n@host\n %raw =l call $strerror(w %status)\n %result =l call $trbn_string_from_c(l %raw)\n ret %result\n@domain\n %index =l sub 0, %status\n %valid =w culel %index, 10\n jnz %valid, @known, @unknown\n@known\n %offset =l mul %index, 8\n %slot =l add $trbn_filesystem_errors, %offset\n %text =l loadl %slot\n jmp @copy\n@unknown\n jmp @copy\n@copy\n %chosen =l phi @known %text, @unknown $trbn_filesystem_error0\n %copy =l call $trbn_string_from_c(l %chosen)\n ret %copy\n}\n")
end
