import { QbeOutput, qbe_output_line } from backend/qbe/output

def emit_network_parser(mut output: QbeOutput)
	qbe_output_line(output, "data $net_colon = { b \":\" }\ndata $net_newline = { b 10 }\ndata $net_settings = align 8 { l 0, l 0, l $net_url, l 0, l 0, l 0, l $net_header_field, l $net_header_value, l 0, l 0, l $net_headers_complete, l $net_body, l $net_message_complete, l 0, l 0, l 0, l 0, l 0, l $net_header_field_complete, l $net_header_value_complete, l 0, l 0, l 0, l 0, l 0 }\n")
	qbe_output_line(output, "function w $net_url(l %parser, l %data, l %length) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %buffer =l add %connection, 64\n %limit =l copy 1048576\n %result =w call $net_append(l %buffer, l %data, l %length, l %limit)\n %bad =w cnew %result, 0\n jnz %bad, @error, @done\n@error\n %status =l add %connection, 40\n storel 431, %status\n ret -1\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $net_method(l %parser, l %data, l %length) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %buffer =l add %connection, 88\n %limit =l copy 1048576\n %result =w call $net_append(l %buffer, l %data, l %length, l %limit)\n %bad =w cnew %result, 0\n jnz %bad, @error, @done\n@error\n %status =l add %connection, 40\n storel 431, %status\n ret -1\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $net_header_field(l %parser, l %data, l %length) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %finishedp =l add %connection, 208\n %finished =l loadl %finishedp\n %trailer =w cnel %finished, 0\n jnz %trailer, @done, @append\n@append\n %buffer =l add %connection, 112\n %limit =l copy 1048576\n %result =w call $net_append(l %buffer, l %data, l %length, l %limit)\n %bad =w cnew %result, 0\n jnz %bad, @error, @done\n@error\n %status =l add %connection, 40\n storel 431, %status\n ret -1\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $net_header_value(l %parser, l %data, l %length) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %finishedp =l add %connection, 208\n %finished =l loadl %finishedp\n %trailer =w cnel %finished, 0\n jnz %trailer, @done, @append\n@append\n %buffer =l add %connection, 112\n %limit =l copy 1048576\n %result =w call $net_append(l %buffer, l %data, l %length, l %limit)\n %bad =w cnew %result, 0\n jnz %bad, @error, @done\n@error\n %status =l add %connection, 40\n storel 431, %status\n ret -1\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $net_body(l %parser, l %data, l %length) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %buffer =l add %connection, 136\n %limit =l loadl $net_body_limit\n %lenp =l add %buffer, 8\n %old =l loadl %lenp\n %room =l sub %limit, %old\n %over =w cugtl %length, %room\n jnz %over, @prefix, @all\n@prefix\n jmp @append\n@all\n jmp @append\n@append\n %accepted =l phi @prefix %room, @all %length\n %result =w call $net_append(l %buffer, l %data, l %accepted, l %limit)\n %failed =w cnew %result, 0\n %bad =w or %failed, %over\n jnz %bad, @error, @done\n@error\n %status =l add %connection, 40\n storel 413, %status\n ret -1\n@done\n ret 0\n}\n")
	qbe_output_line(output, "function w $net_header_field_complete(l %parser) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %finishedp =l add %connection, 208\n %finished =l loadl %finishedp\n %trailer =w cnel %finished, 0\n jnz %trailer, @ignored, @append\n@ignored\n ret 0\n@append\n %buffer =l add %connection, 112\n %result =w call $net_append(l %buffer, l $net_colon, l 1, l 1048576)\n ret %result\n}\n")
	qbe_output_line(output, "function w $net_header_value_complete(l %parser) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %finishedp =l add %connection, 208\n %finished =l loadl %finishedp\n %trailer =w cnel %finished, 0\n jnz %trailer, @ignored, @append\n@ignored\n ret 0\n@append\n %buffer =l add %connection, 112\n %result =w call $net_append(l %buffer, l $net_newline, l 1, l 1048576)\n ret %result\n}\n")
	qbe_output_line(output, "function w $net_headers_complete(l %parser) {\n@start\n %major =w call $net_llhttp_get_http_major(l %parser)\n %minor =w call $net_llhttp_get_http_minor(l %parser)\n %upgradep =l add %parser, 80\n storeb 0, %upgradep\n %bad_major =w cnew %major, 1\n %bad_minor =w cugtw %minor, 1\n %bad_version =w or %bad_major, %bad_minor\n jnz %bad_version, @fail, @done\n@fail\n ret -1\n@done\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %state =l add %connection, 24\n %status =l add %connection, 40\n storel 1, %state\n storel 100, %status\n %finishedp =l add %connection, 208\n storel 1, %finishedp\n ret 21\n}\n")
	qbe_output_line(output, "function w $net_message_complete(l %parser) {\n@start\n %cp =l add %parser, 48\n %connection =l loadl %cp\n %keepalive =w call $net_llhttp_should_keep_alive(l %parser)\n %keep =l extuw %keepalive\n %keep_ptr =l add %connection, 48\n storel %keep, %keep_ptr\n %state =l add %connection, 24\n storel 1, %state\n ret 21\n}\n")
	qbe_output_line(output, "function $net_parse_input(l %connection, l %bytes, l %length) {\n@start\n %parserp =l add %connection, 16\n %parser =l loadl %parserp\n %result =w call $net_llhttp_execute(l %parser, l %bytes, l %length)\n %ok =w ceqw %result, 0\n jnz %ok, @done, @paused\n@paused\n %paused =w ceqw %result, 21\n jnz %paused, @pending, @error\n@pending\n %end =l call $net_llhttp_get_error_pos(l %parser)\n %used =l sub %end, %bytes\n %remaining =l sub %length, %used\n %pending =l add %connection, 160\n %saved =w call $net_append(l %pending, l %end, l %remaining, l 65536)\n %failed =w cnew %saved, 0\n jnz %failed, @error, @stop_read\n@error\n %statusp =l add %connection, 40\n %status =l loadl %statusp\n %unset =w ceql %status, 0\n jnz %unset, @bad_request, @mark\n@bad_request\n storel 400, %statusp\n jmp @mark\n@mark\n %finishedp =l add %connection, 208\n %finished =l loadl %finishedp\n %early =w ceql %finished, 0\n jnz %early, @header_error, @ready_error\n@header_error\n %saved_status =l loadl %statusp\n %early_status =l sub 0, %saved_status\n storel %early_status, %statusp\n jmp @ready_error\n@ready_error\n %state =l add %connection, 24\n storel 1, %state\n %closep =l add %connection, 32\n storel 1, %closep\n jmp @stop_read\n@stop_read\n %tcpp =l add %connection, 8\n %tcp =l loadl %tcpp\n %stopped =w call $net_uv_read_stop(l %tcp)\n@done\n ret\n}\n")
end
