import { QbeOutput, qbe_output_line } from backend/qbe/output

# Verified lexical regions supply stack-owned frames. They contain an intrusive
# parent pointer and a tagged descriptor/stream, never a retaining callback.
# Detach before close: even a failed close consumes this cleanup obligation and
# must not be retried after the descriptor might have been reused by the host.
# An existing body failure wins over any close error during failure unwinding.
def emit_resource_cleanup_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_resource_scope = align 8 { l 0 }\ndata $trbn_resource_error = { b \"panic: invalid resource cleanup\", b 10 }\n\nfunction $trbn_resource_push(l %scope, w %descriptor) {\n@start\n %previous =l loadl $trbn_resource_scope\n storel %previous, %scope\n %fd =l add %scope, 8\n storew %descriptor, %fd\n %kind =l add %scope, 12\n storew 0, %kind\n storel %scope, $trbn_resource_scope\n ret\n}\n\nfunction w $trbn_resource_close(l %scope) {\n@start\n %current =l loadl $trbn_resource_scope\n %top =w ceql %scope, %current\n %present =w cnel %scope, 0\n %valid =w and %top, %present\n jnz %valid, @close, @invalid\n@close\n %previous =l loadl %scope\n storel %previous, $trbn_resource_scope\n %kind_address =l add %scope, 12\n %kind =w loadw %kind_address\n jnz %kind, @directory, @file\n@file\n %fd_address =l add %scope, 8\n %fd =w loadw %fd_address\n storew -1, %fd_address\n %result =w call $close(w %fd)\n ret %result\n@directory\n %pointer =l add %scope, 16\n %directory =l loadl %pointer\n storel 0, %pointer\n %closed =w call $closedir(l %directory)\n ret %closed\n@invalid\n call $trbn_fatal(l $trbn_resource_error, l 32)\n hlt\n}\n\nfunction $trbn_resource_unwind(l %boundary) {\n@start\n jmp @next\n@next\n %current =l loadl $trbn_resource_scope\n %finished =w ceql %current, %boundary\n jnz %finished, @done, @close\n@close\n %ignored =w call $trbn_resource_close(l %current)\n jmp @next\n@done\n ret\n}\nfunction $trbn_resource_push_directory(l %scope, l %directory) {\n@start\n %previous =l loadl $trbn_resource_scope\n storel %previous, %scope\n %fd =l add %scope, 8\n storew -1, %fd\n %kind =l add %scope, 12\n storew 1, %kind\n %pointer =l add %scope, 16\n storel %directory, %pointer\n storel %scope, $trbn_resource_scope\n ret\n}\n")
end
