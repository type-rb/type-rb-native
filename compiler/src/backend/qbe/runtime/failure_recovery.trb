import { QbeOutput, qbe_output_line } from backend/qbe/output

# Only this callback trampoline contains a returns-twice libc call. Saved scope
# fields are immutable across the callback and read after either return path.
# Target validation checks the bounded environment against the system ABI.
def emit_failure_recovery_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_recovery_scope = align 8 { l 0 }\n\nfunction $trbn_unwind() {\n@start\n %scope =l loadl $trbn_recovery_scope\n jnz %scope, @recover, @terminal\n@recover\n %environment =l add %scope, 32\n call $longjmp(l %environment, w 1)\n hlt\n@terminal\n ret\n}\n\nfunction $trbn_fail(l %message, l %size) {\n@start\n call $trbn_unwind()\n call $trbn_fatal(l %message, l %size)\n hlt\n}\n")
	qbe_output_line(output, "function l $trbn_runtime_recover_l(l %action, l %fallback) {\n@start\n %scope =l alloc16 1056\n %previous =l loadl $trbn_recovery_scope\n storel %previous, %scope\n %saved_roots =l add %scope, 8\n %roots =l loadl $trbn_gc_temp_count\n storel %roots, %saved_roots\n %saved_fallback =l add %scope, 16\n storel %fallback, %saved_fallback\n %saved_action =l add %scope, 24\n storel %action, %saved_action\n %environment =l add %scope, 32\n %caught =w call $setjmp(l %environment)\n jnz %caught, @caught, @invoke\n@invoke\n storel %scope, $trbn_recovery_scope\n %action_slot =l add %scope, 24\n %closure =l loadl %action_slot\n %code_slot =l add %closure, 8\n %code =l loadl %code_slot\n %result =l call %code(l %closure)\n jmp @complete\n@caught\n %fallback_slot =l add %scope, 16\n %fallback_result =l loadl %fallback_slot\n jmp @complete\n@complete\n %value =l phi @invoke %result, @caught %fallback_result\n %parent =l loadl %scope\n storel %parent, $trbn_recovery_scope\n %root_slot =l add %scope, 8\n %root_count =l loadl %root_slot\n storel %root_count, $trbn_gc_temp_count\n ret %value\n}\n")
	qbe_output_line(output, "function d $trbn_runtime_recover_d(l %action, d %fallback) {\n@start\n %scope =l alloc16 1056\n %previous =l loadl $trbn_recovery_scope\n storel %previous, %scope\n %saved_roots =l add %scope, 8\n %roots =l loadl $trbn_gc_temp_count\n storel %roots, %saved_roots\n %saved_fallback =l add %scope, 16\n stored %fallback, %saved_fallback\n %saved_action =l add %scope, 24\n storel %action, %saved_action\n %environment =l add %scope, 32\n %caught =w call $setjmp(l %environment)\n jnz %caught, @caught, @invoke\n@invoke\n storel %scope, $trbn_recovery_scope\n %action_slot =l add %scope, 24\n %closure =l loadl %action_slot\n %code_slot =l add %closure, 8\n %code =l loadl %code_slot\n %result =d call %code(l %closure)\n jmp @complete\n@caught\n %fallback_slot =l add %scope, 16\n %fallback_result =d loadd %fallback_slot\n jmp @complete\n@complete\n %value =d phi @invoke %result, @caught %fallback_result\n %parent =l loadl %scope\n storel %parent, $trbn_recovery_scope\n %root_slot =l add %scope, 8\n %root_count =l loadl %root_slot\n storel %root_count, $trbn_gc_temp_count\n ret %value\n}\n")
end
