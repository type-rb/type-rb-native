import { QbeOutput, qbe_output_line } from backend/qbe/output

def emit_oidc_link_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_oidc_link_required = align 8 { l 0 }\ndata $trbn_oidc_link_directory = { b \"TRBN_OIDC_LIB_DIR\", b 0 }\ndata $trbn_oidc_link_relative = { b \"/oidc\", b 0 }\ndata $trbn_oidc_link_curl = { b \"/libcurl.a\", b 0 }\ndata $trbn_oidc_link_ssl = { b \"/libssl.a\", b 0 }\ndata $trbn_oidc_link_zlib = { b \"/libz.a\", b 0 }\ndata $trbn_oidc_link_identity = { b \"/oidc-identity.o\", b 0 }\ndata $trbn_oidc_link_names = align 8 { l $trbn_oidc_link_curl, l $trbn_oidc_link_ssl, l $trbn_oidc_link_zlib, l $trbn_oidc_link_identity }\ndata $trbn_oidc_link_framework = { b \"-framework\", b 0 }\ndata $trbn_oidc_link_security = { b \"Security\", b 0 }\ndata $trbn_oidc_link_foundation = { b \"CoreFoundation\", b 0 }\ndata $trbn_oidc_link_systemconfiguration = { b \"SystemConfiguration\", b 0 }\ndata $trbn_oidc_link_error = { b \"compiler: pinned static OIDC libraries are missing; install oidc beside QBE or set TRBN_OIDC_LIB_DIR\", b 10, b 0 }\nfunction $trbn_set_oidc_link(l %needed) {\n@start\n storel %needed, $trbn_oidc_link_required\n ret\n}\nfunction l $trbn_oidc_link_arguments(l %tail, l %qbe) {\n@start\n %needed =l loadl $trbn_oidc_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @directory, @unchanged\n@unchanged\n ret %tail\n@directory\n %first_slot =l add %tail, 8\n call $memset(l %first_slot, w 0, l 32)\n %root =l call $trbn_link_directory(l $trbn_oidc_link_directory, l %qbe, l $trbn_oidc_link_relative)\n jmp @resolved\n@resolved\n %root_nonzero =w cnel %root, 0\n jnz %root_nonzero, @paths, @failed\n@paths\n %index =l phi @resolved 0, @next %next\n %offset =l mul %index, 8\n %namep =l add $trbn_oidc_link_names, %offset\n %name =l loadl %namep\n %path =l call $trbn_link_path(l %root, l %name)\n %slot =l add %first_slot, %offset\n storel %path, %slot\n %path_nonzero =w cnel %path, 0\n jnz %path_nonzero, @readable, @root_failed\n@readable\n %readable =w call $trbn_link_access(l %path)\n jnz %readable, @root_failed, @next\n@next\n %next =l add %index, 1\n %more =w csltl %next, 4\n jnz %more, @paths, @arguments\n@root_failed\n call $free(l %root)\n jmp @failed\n@arguments\n call $free(l %root)\n storel $trbn_network_link_input, %tail\n %linux =l loadl $trbn_project_selected_linker\n %linux_nonzero =w cnel %linux, 0\n jnz %linux_nonzero, @linux, @darwin\n@linux\n %linux_tail =l add %tail, 40\n ret %linux_tail\n@darwin\n %f1 =l add %tail, 40\n storel $trbn_oidc_link_framework, %f1\n %f2 =l add %tail, 48\n storel $trbn_oidc_link_security, %f2\n %f3 =l add %tail, 56\n storel $trbn_oidc_link_framework, %f3\n %f4 =l add %tail, 64\n storel $trbn_oidc_link_foundation, %f4\n %f5 =l add %tail, 72\n storel $trbn_oidc_link_framework, %f5\n %f6 =l add %tail, 80\n storel $trbn_oidc_link_systemconfiguration, %f6\n %darwin_tail =l add %tail, 88\n ret %darwin_tail\n@failed\n call $trbn_oidc_link_cleanup(l %tail)\n %length =l call $strlen(l $trbn_oidc_link_error)\n call $write(w 2, l $trbn_oidc_link_error, l %length)\n ret 0\n}\nfunction $trbn_oidc_link_cleanup(l %tail) {\n@start\n %needed =l loadl $trbn_oidc_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @release, @done\n@release\n %index =l phi @start 1, @release %next\n %offset =l mul %index, 8\n %slot =l add %tail, %offset\n %path =l loadl %slot\n call $free(l %path)\n %next =l add %index, 1\n %more =w csltl %next, 5\n jnz %more, @release, @done\n@done\n ret\n}\n")
end
