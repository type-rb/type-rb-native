import { emit_filesystem_io_runtime } from backend/qbe/runtime/filesystem_io
import { emit_resource_cleanup_runtime } from backend/qbe/runtime/resource_cleanup
import { qbe_output_new } from backend/qbe/output
import { output_source } from testing/compiler
import { logical_run_qbe_arguments } from testing/qbe_runner
import { describe, expect, test } from trb/std/test
import trb/std/process
import trb/std/result

def filesystem_test_qbe(fixture: String, injected: Boolean)
	qbe := Process.environment("TYPE_RB_NATIVE_QBE")
	if qbe == nil
		return
	end
	allocated := case Process.run("/usr/bin/mktemp", ["-d", "/tmp/type-rb-native-filesystem.XXXXXX"])
	when Result::Ok(value)
		value
	when Result::Err(error)
		puts(error.message)
		expect(false).to_be_true()
		return
	end
	expect(allocated.success).to_be_true()
	workspace := allocated.stdout.strip()
	mut output := qbe_output_new(16, [])
	emit_filesystem_io_runtime(output)
	emit_resource_cleanup_runtime(output)
	mut runtime := output_source(output)
	if injected
		runtime = runtime.split("call $open(").join("call $test_open(").split("call %stat_function(").join("call $test_stat(").split("call $ftruncate(").join("call $test_truncate(").split("call $close(").join("call $test_close(").split("call $read(").join("call $test_read(").split("call $write(").join("call $test_write(")
	end
	result := logical_run_qbe_arguments(qbe, runtime + fixture, [workspace + "/file"])
	case Process.run("/bin/rm", ["-r", workspace])
	when Result::Ok(value)
		expect(value.success).to_be_true()
	when Result::Err(error)
		puts(error.message)
		expect(false).to_be_true()
	end
	case result
	when Result::Ok(actual)
		expect(actual).to_equal("file I/O\n")
	when Result::Err(error)
		puts(error)
		expect(false).to_be_true()
	end
end

describe("Scoped filesystem raw operations") do
	test("acquires reads writes and closes real regular descriptors") do
		filesystem_test_qbe("data $test_text = { b \"hello\", b 0 }\ndata $test_done = { b \"file I/O\", b 0 }\ndata $test_stage = align 8 { l 0 }\ndata $test_failed = { b \"failed stage %lld\", b 10, b 0 }\nfunction $trbn_fatal(l %message, l %size) {\n@start\n call $abort()\n hlt\n}\nexport function w $main(w %argc, l %argv) {\n@start\n %deadline =w call $alarm(w 5)\n %pathp =l add %argv, 8\n %path =l loadl %pathp\n %length =l call $strlen(l %path)\n %scope =l alloc8 16\n %fdp =l add %scope, 8\n %buffer =l alloc8 16\n storel 1, $test_stage\n %created =l call $trbn_file_acquire(l %scope, l %path, l %length, l 2)\n %c =w ceql %created, 0\n jnz %c, @step1, @bad\n@step1\n storel 2, $test_stage\n %fd =w loadw %fdp\n %written =l call $trbn_file_write_all(w %fd, l $test_text, l 5)\n %w =w ceql %written, 0\n jnz %w, @step2, @bad\n@step2\n storel 3, $test_stage\n %closed =w call $trbn_resource_close(l %scope)\n %flags =w call $fcntl(w %fd, w 1, ..., w 0)\n %cl =w ceqw %closed, 0\n %gone =w ceqw %flags, -1\n %cl_ok =w and %cl, %gone\n jnz %cl_ok, @step3, @bad\n@step3\n storel 4, $test_stage\n %opened =l call $trbn_file_acquire(l %scope, l %path, l %length, l 0)\n %o =w ceql %opened, 0\n jnz %o, @step4, @bad\n@step4\n storel 5, $test_stage\n %reader =w loadw %fdp\n %first =l call $trbn_file_read_into(w %reader, l %buffer, l 2)\n %compare =w call $memcmp(l %buffer, l $test_text, l 2)\n %size_ok =w ceql %first, 2\n %data_ok =w ceqw %compare, 0\n %r =w and %size_ok, %data_ok\n jnz %r, @step5, @bad\n@step5\n storel 6, $test_stage\n %second =l call $trbn_file_read_into(w %reader, l %buffer, l 16)\n %tail =l add $test_text, 2\n %tail_compare =w call $memcmp(l %buffer, l %tail, l 3)\n %tail_size =w ceql %second, 3\n %tail_data =w ceqw %tail_compare, 0\n %r2 =w and %tail_size, %tail_data\n %closed_read =w call $trbn_resource_close(l %scope)\n jnz %r2, @step6, @bad\n@step6\n storel 7, $test_stage\n %duplicate =l call $trbn_file_acquire(l %scope, l %path, l %length, l 2)\n %dup =w ceql %duplicate, 17\n jnz %dup, @step7, @bad\n@step7\n storel 8, $test_stage\n %truncate =l call $trbn_file_acquire(l %scope, l %path, l %length, l 1)\n %t =w ceql %truncate, 0\n jnz %t, @step8, @bad\n@step8\n storel 9, $test_stage\n %closed_write =w call $trbn_resource_close(l %scope)\n %empty_open =l call $trbn_file_acquire(l %scope, l %path, l %length, l 0)\n %e =w ceql %empty_open, 0\n jnz %e, @step9, @bad\n@step9\n storel 10, $test_stage\n %empty_fd =w loadw %fdp\n %empty_read =l call $trbn_file_read_into(w %empty_fd, l %buffer, l 16)\n %empty_close =w call $trbn_resource_close(l %scope)\n %unlinked =w call $unlink(l %path)\n %head =l loadl $trbn_resource_scope\n %empty_ok =w ceql %empty_read, 0\n %head_ok =w ceql %head, 0\n %last =w and %empty_ok, %head_ok\n jnz %last, @step10, @bad\n@step10\n %done =w call $puts(l $test_done)\n ret 0\n@bad\n %stage =l loadl $test_stage\n %error =w call $printf(l $test_failed, ..., l %stage)\n ret 1\n}\n", false)
	end

	test("rejects nonregular and embedded NUL paths without FIFO peer waiting") do
		filesystem_test_qbe("data $test_text = { b \"hello\", b 0 }\ndata $test_done = { b \"file I/O\", b 0 }\ndata $test_stage = align 8 { l 0 }\ndata $test_failed = { b \"failed stage %lld\", b 10, b 0 }\nfunction $trbn_fatal(l %message, l %size) {\n@start\n call $abort()\n hlt\n}\ndata $test_directory = { b \"/tmp\", b 0 }\ndata $test_device = { b \"/dev/null\", b 0 }\ndata $test_nul = { b 97, b 0, b 98, b 0 }\nexport function w $main(w %argc, l %argv) {\n@start\n %deadline =w call $alarm(w 5)\n %pathp =l add %argv, 8\n %path =l loadl %pathp\n %length =l call $strlen(l %path)\n %scope =l alloc8 16\n %fdp =l add %scope, 8\n %buffer =l alloc8 16\n storel 1, $test_stage\n %nul =l call $trbn_file_acquire(l %scope, l $test_nul, l 3, l 0)\n %n =w ceql %nul, -1\n jnz %n, @step1, @bad\n@step1\n storel 2, $test_stage\n %dir =l call $trbn_file_acquire(l %scope, l $test_directory, l 4, l 0)\n %d =w ceql %dir, -2\n jnz %d, @step2, @bad\n@step2\n storel 3, $test_stage\n %device =l call $trbn_file_acquire(l %scope, l $test_device, l 9, l 0)\n %v =w ceql %device, -2\n jnz %v, @step3, @bad\n@step3\n storel 4, $test_stage\n %made =w call $mkfifo(l %path, w 384)\n %m =w ceqw %made, 0\n jnz %m, @step4, @bad\n@step4\n storel 5, $test_stage\n %fifo =l call $trbn_file_acquire(l %scope, l %path, l %length, l 0)\n %f =w ceql %fifo, -2\n jnz %f, @step5, @bad\n@step5\n storel 6, $test_stage\n %fifo_write =l call $trbn_file_acquire(l %scope, l %path, l %length, l 1)\n %fw =w ceql %fifo_write, 6\n %unlinked =w call $unlink(l %path)\n jnz %fw, @step6, @bad\n@step6\n storel 7, $test_stage\n %head =l loadl $trbn_resource_scope\n %h =w ceql %head, 0\n jnz %h, @step7, @bad\n@step7\n %done =w call $puts(l $test_done)\n ret 0\n@bad\n %stage =l loadl $test_stage\n %error =w call $printf(l $test_failed, ..., l %stage)\n ret 1\n}\n", false)
	end

	test("preserves errno and progress through interruption short writes and cleanup failure") do
		filesystem_test_qbe("data $test_text = { b \"hello\", b 0 }\ndata $test_done = { b \"file I/O\", b 0 }\ndata $test_stage = align 8 { l 0 }\ndata $test_failed = { b \"failed stage %lld\", b 10, b 0 }\nfunction $trbn_fatal(l %message, l %size) {\n@start\n call $abort()\n hlt\n}\ndata $test_opens = align 8 { l 0 }\ndata $test_stats = align 8 { l 0 }\ndata $test_truncates = align 8 { l 0 }\ndata $test_closes = align 8 { l 0 }\ndata $test_reads = align 8 { l 0 }\ndata $test_writes = align 8 { l 0 }\nfunction $test_errno(w %error) {\n@start\n %function =l loadl $trbn_fs_errno_function\n %address =l call %function()\n storew %error, %address\n ret\n}\nfunction w $test_open(l %path, w %flags, ...) {\n@start\n %count =l loadl $test_opens\n %next =l add %count, 1\n storel %next, $test_opens\n jnz %count, @opened, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@opened\n ret 41\n}\nfunction w $test_stat(w %fd, l %stat) {\n@start\n %count =l loadl $test_stats\n %next =l add %count, 1\n storel %next, $test_stats\n jnz %count, @regular, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@regular\n call $memset(l %stat, w 0, l 144)\n %apple =l add %stat, 4\n %arm =l add %stat, 16\n %intel =l add %stat, 24\n storew 32768, %apple\n storew 32768, %arm\n storew 32768, %intel\n ret 0\n}\nfunction w $test_truncate(w %fd, l %length) {\n@start\n %count =l loadl $test_truncates\n %next =l add %count, 1\n storel %next, $test_truncates\n jnz %count, @failed, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@failed\n call $test_errno(w 13)\n ret -1\n}\nfunction w $test_close(w %fd) {\n@start\n %count =l loadl $test_closes\n %next =l add %count, 1\n storel %next, $test_closes\n call $test_errno(w 5)\n ret -1\n}\nfunction l $test_read(w %fd, l %buffer, l %length) {\n@start\n %count =l loadl $test_reads\n %next =l add %count, 1\n storel %next, $test_reads\n jnz %count, @read, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@read\n ret 2\n}\nfunction l $test_write(w %fd, l %buffer, l %length) {\n@start\n %count =l loadl $test_writes\n %next =l add %count, 1\n storel %next, $test_writes\n jnz %count, @after_short, @short\n@short\n ret 2\n@after_short\n %remaining =w ceql %length, 3\n %expected =l add $test_text, 2\n %pointer =w ceql %buffer, %expected\n %progress =w and %remaining, %pointer\n jnz %progress, @valid, @bad\n@bad\n call $abort()\n hlt\n@valid\n %first =w ceql %count, 1\n jnz %first, @interrupted, @stalled\n@interrupted\n call $test_errno(w 4)\n ret -1\n@stalled\n ret 0\n}\nexport function w $main(w %argc, l %argv) {\n@start\n %deadline =w call $alarm(w 5)\n %pathp =l add %argv, 8\n %path =l loadl %pathp\n %length =l call $strlen(l %path)\n %scope =l alloc8 16\n %fdp =l add %scope, 8\n %buffer =l alloc8 16\n storel 1, $test_stage\n %opened =l call $trbn_file_acquire(l %scope, l %path, l %length, l 1)\n %error =w ceql %opened, 13\n jnz %error, @step1, @bad\n@step1\n storel 2, $test_stage\n %opens =l loadl $test_opens\n %truncates =l loadl $test_truncates\n %closes =l loadl $test_closes\n %head =l loadl $trbn_resource_scope\n %o =w ceql %opens, 2\n %t =w ceql %truncates, 2\n %c =w ceql %closes, 1\n %h =w ceql %head, 0\n %ot =w and %o, %t\n %ch =w and %c, %h\n %lifecycle =w and %ot, %ch\n jnz %lifecycle, @step2, @bad\n@step2\n storel 3, $test_stage\n %read =l call $trbn_file_read_into(w 41, l %buffer, l 5)\n %read_ok =w ceql %read, 2\n jnz %read_ok, @step3, @bad\n@step3\n storel 4, $test_stage\n %write =l call $trbn_file_write_all(w 41, l $test_text, l 5)\n %writes =l loadl $test_writes\n %write_failed =w ceql %write, 5\n %write_count =w ceql %writes, 3\n %write_ok =w and %write_failed, %write_count\n jnz %write_ok, @step4, @bad\n@step4\n storel 5, $test_stage\n call $trbn_resource_push(l %scope, w 41)\n %release =l call $trbn_file_release(l %scope)\n %release_ok =w ceql %release, 5\n %after =l loadl $trbn_resource_scope\n %empty =w ceql %after, 0\n %closed_count =l loadl $test_closes\n %once =w ceql %closed_count, 2\n %release_head =w and %release_ok, %empty\n %released =w and %release_head, %once\n jnz %released, @step5, @bad\n@step5\n %done =w call $puts(l $test_done)\n ret 0\n@bad\n %stage =l loadl $test_stage\n %error =w call $printf(l $test_failed, ..., l %stage)\n ret 1\n}\n", true)
	end

	test("validates the opened handle before truncating and consumes failed close once") do
		filesystem_test_qbe("data $test_text = { b \"hello\", b 0 }\ndata $test_done = { b \"file I/O\", b 0 }\ndata $test_stage = align 8 { l 0 }\ndata $test_failed = { b \"failed stage %lld\", b 10, b 0 }\nfunction $trbn_fatal(l %message, l %size) {\n@start\n call $abort()\n hlt\n}\ndata $test_opens = align 8 { l 0 }\ndata $test_stats = align 8 { l 0 }\ndata $test_truncates = align 8 { l 0 }\ndata $test_closes = align 8 { l 0 }\ndata $test_reads = align 8 { l 0 }\ndata $test_writes = align 8 { l 0 }\nfunction $test_errno(w %error) {\n@start\n %function =l loadl $trbn_fs_errno_function\n %address =l call %function()\n storew %error, %address\n ret\n}\nfunction w $test_open(l %path, w %flags, ...) {\n@start\n %count =l loadl $test_opens\n %next =l add %count, 1\n storel %next, $test_opens\n jnz %count, @opened, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@opened\n ret 41\n}\nfunction w $test_stat(w %fd, l %stat) {\n@start\n %count =l loadl $test_stats\n %next =l add %count, 1\n storel %next, $test_stats\n jnz %count, @regular, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@regular\n call $memset(l %stat, w 0, l 144)\n %apple =l add %stat, 4\n %arm =l add %stat, 16\n %intel =l add %stat, 24\n storew 4096, %apple\n storew 4096, %arm\n storew 4096, %intel\n ret 0\n}\nfunction w $test_truncate(w %fd, l %length) {\n@start\n %count =l loadl $test_truncates\n %next =l add %count, 1\n storel %next, $test_truncates\n jnz %count, @failed, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@failed\n call $test_errno(w 13)\n ret -1\n}\nfunction w $test_close(w %fd) {\n@start\n %count =l loadl $test_closes\n %next =l add %count, 1\n storel %next, $test_closes\n call $test_errno(w 5)\n ret -1\n}\nfunction l $test_read(w %fd, l %buffer, l %length) {\n@start\n %count =l loadl $test_reads\n %next =l add %count, 1\n storel %next, $test_reads\n jnz %count, @read, @interrupted\n@interrupted\n call $test_errno(w 4)\n ret -1\n@read\n ret 2\n}\nfunction l $test_write(w %fd, l %buffer, l %length) {\n@start\n %count =l loadl $test_writes\n %next =l add %count, 1\n storel %next, $test_writes\n jnz %count, @after_short, @short\n@short\n ret 2\n@after_short\n %remaining =w ceql %length, 3\n %expected =l add $test_text, 2\n %pointer =w ceql %buffer, %expected\n %progress =w and %remaining, %pointer\n jnz %progress, @valid, @bad\n@bad\n call $abort()\n hlt\n@valid\n %first =w ceql %count, 1\n jnz %first, @interrupted, @stalled\n@interrupted\n call $test_errno(w 4)\n ret -1\n@stalled\n ret 0\n}\nexport function w $main(w %argc, l %argv) {\n@start\n %deadline =w call $alarm(w 5)\n %pathp =l add %argv, 8\n %path =l loadl %pathp\n %length =l call $strlen(l %path)\n %scope =l alloc8 16\n %fdp =l add %scope, 8\n %buffer =l alloc8 16\n storel 1, $test_stage\n %opened =l call $trbn_file_acquire(l %scope, l %path, l %length, l 1)\n %error =w ceql %opened, -2\n jnz %error, @step1, @bad\n@step1\n storel 2, $test_stage\n %opens =l loadl $test_opens\n %truncates =l loadl $test_truncates\n %closes =l loadl $test_closes\n %head =l loadl $trbn_resource_scope\n %o =w ceql %opens, 2\n %t =w ceql %truncates, 0\n %c =w ceql %closes, 1\n %h =w ceql %head, 0\n %ot =w and %o, %t\n %ch =w and %c, %h\n %lifecycle =w and %ot, %ch\n jnz %lifecycle, @step2, @bad\n@step2\n storel 3, $test_stage\n %read =l call $trbn_file_read_into(w 41, l %buffer, l 5)\n %read_ok =w ceql %read, 2\n jnz %read_ok, @step3, @bad\n@step3\n storel 4, $test_stage\n %write =l call $trbn_file_write_all(w 41, l $test_text, l 5)\n %writes =l loadl $test_writes\n %write_failed =w ceql %write, 5\n %write_count =w ceql %writes, 3\n %write_ok =w and %write_failed, %write_count\n jnz %write_ok, @step4, @bad\n@step4\n storel 5, $test_stage\n call $trbn_resource_push(l %scope, w 41)\n %release =l call $trbn_file_release(l %scope)\n %release_ok =w ceql %release, 5\n %after =l loadl $trbn_resource_scope\n %empty =w ceql %after, 0\n %closed_count =l loadl $test_closes\n %once =w ceql %closed_count, 2\n %release_head =w and %release_ok, %empty\n %released =w and %release_head, %once\n jnz %released, @step5, @bad\n@step5\n %done =w call $puts(l $test_done)\n ret 0\n@bad\n %stage =l loadl $test_stage\n %error =w call $printf(l $test_failed, ..., l %stage)\n ret 1\n}\n", true)
	end

	test("checks empty writes and retries interruption without skipping descriptor errors") do
		filesystem_test_qbe("data $test_done = { b \"file I/O\", b 0 }\ndata $test_calls = align 8 { l 0 }\nfunction $trbn_fatal(l %message, l %size) {\n@start\n call $abort()\n hlt\n}\nfunction w $test_open(l %path, w %flags, ...) {\n@start\n ret -1\n}\nfunction w $test_stat(w %fd, l %stat) {\n@start\n ret -1\n}\nfunction w $test_truncate(w %fd, l %length) {\n@start\n ret -1\n}\nfunction w $test_close(w %fd) {\n@start\n ret 0\n}\nfunction l $test_read(w %fd, l %buffer, l %length) {\n@start\n ret 0\n}\nfunction $test_errno(w %error) {\n@start\n %function =l loadl $trbn_fs_errno_function\n %address =l call %function()\n storew %error, %address\n ret\n}\nfunction l $test_write(w %fd, l %buffer, l %length) {\n@start\n %empty =w ceql %length, 0\n jnz %empty, @call, @bad\n@bad\n call $abort()\n hlt\n@call\n %calls =l loadl $test_calls\n %next =l add %calls, 1\n storel %next, $test_calls\n %first =w ceql %calls, 0\n jnz %first, @interrupt, @second\n@interrupt\n call $test_errno(w 4)\n ret -1\n@second\n %second =w ceql %calls, 1\n jnz %second, @success, @denied\n@success\n ret 0\n@denied\n call $test_errno(w 9)\n ret -1\n}\nexport function w $main() {\n@start\n %profile =l call $trbn_fs_initialize()\n %initialized =w cnel %profile, 0\n jnz %initialized, @write, @bad\n@write\n %success =l call $trbn_file_write_all(w 41, l $test_done, l 0)\n %denied =l call $trbn_file_write_all(w 41, l $test_done, l 0)\n %calls =l loadl $test_calls\n %a =w ceql %success, 0\n %b =w ceql %denied, 9\n %c =w ceql %calls, 3\n %ab =w and %a, %b\n %abc =w and %ab, %c\n jnz %abc, @done, @bad\n@done\n call $puts(l $test_done)\n ret 0\n@bad\n ret 1\n}\n", true)
	end

end
