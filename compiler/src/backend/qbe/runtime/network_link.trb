import { QbeOutput, qbe_output_line } from backend/qbe/output

# Compiler-only link state is set by the verified MIR network requirement.
# No application source spelling or generated assembly scan grants a dependency.
def emit_network_link_runtime(mut output: QbeOutput)
	# The four library families share directory selection and path ownership.
	# Report each failure before cleanup can replace its original errno.
	# Keep the failing result and the family-specific installation diagnostic.
	qbe_output_line(output, "function l $trbn_link_realpath(l %path) {\n@start\n %resolved =l call $realpath(l %path, l 0)\n %resolved_nonzero =w cnel %resolved, 0\n jnz %resolved_nonzero, @done, @failed\n@failed\n call $perror(l %path)\n@done\n ret %resolved\n}\nfunction w $trbn_link_access(l %path) {\n@start\n %status =w call $access(l %path, w 4)\n jnz %status, @failed, @done\n@failed\n call $perror(l %path)\n@done\n ret %status\n}\ndata $trbn_link_copy_error = { b \"compiler: copy QBE path\", b 0 }\ndata $trbn_link_allocate_error = { b \"compiler: allocate static-library path\", b 0 }\ndata $trbn_link_parent_error = { b \"compiler: QBE path has no parent directory: \", b 0 }\ndata $trbn_link_path_newline = { b 10 }\nfunction l $trbn_link_directory(l %variable, l %qbe, l %suffix) {\n@start\n %environment =l call $getenv(l %variable)\n %environment_nonzero =w cnel %environment, 0\n jnz %environment_nonzero, @environment, @adjacent\n@environment\n %first =w loadub %environment\n jnz %first, @explicit, @adjacent\n@explicit\n %explicit =l call $trbn_link_realpath(l %environment)\n ret %explicit\n@adjacent\n %copy =l call $strdup(l %qbe)\n %copy_nonzero =w cnel %copy, 0\n jnz %copy_nonzero, @parent, @copy_failed\n@copy_failed\n call $perror(l $trbn_link_copy_error)\n ret 0\n@parent\n %slash =l call $strrchr(l %copy, w 47)\n %slash_nonzero =w cnel %slash, 0\n jnz %slash_nonzero, @truncate, @no_parent\n@no_parent\n %prefix_length =l call $strlen(l $trbn_link_parent_error)\n call $write(w 2, l $trbn_link_parent_error, l %prefix_length)\n %path_length =l call $strlen(l %copy)\n call $write(w 2, l %copy, l %path_length)\n call $write(w 2, l $trbn_link_path_newline, l 1)\n call $free(l %copy)\n ret 0\n@truncate\n storeb 0, %slash\n %relative =l call $trbn_link_path(l %copy, l %suffix)\n call $free(l %copy)\n %relative_nonzero =w cnel %relative, 0\n jnz %relative_nonzero, @canonical, @failed\n@canonical\n %root =l call $trbn_link_realpath(l %relative)\n call $free(l %relative)\n ret %root\n@failed\n ret 0\n}\n\n")
	qbe_output_line(output, "data $trbn_network_link_required = align 8 { l 0 }\ndata $trbn_network_link_directory = { b \"TRBN_NETWORK_LIB_DIR\", b 0 }\ndata $trbn_network_link_relative = { b \"/network\", b 0 }\ndata $trbn_network_link_uv = { b \"/libuv.a\", b 0 }\ndata $trbn_network_link_http = { b \"/libllhttp.a\", b 0 }\ndata $trbn_network_link_identity = { b \"/network-identity.o\", b 0 }\ndata $trbn_network_link_input = { b \"-xnone\", b 0 }\ndata $trbn_network_link_pthread = { b \"-pthread\", b 0 }\ndata $trbn_network_link_dl = { b \"-ldl\", b 0 }\ndata $trbn_network_link_rt = { b \"-lrt\", b 0 }\ndata $trbn_network_link_error = { b \"compiler: pinned static HTTP libraries are missing; install network beside QBE or set TRBN_NETWORK_LIB_DIR\", b 10, b 0 }\n\n")
	qbe_output_line(output, "function $trbn_set_network_link(l %needed) {\n@start\n storel %needed, $trbn_network_link_required\n ret\n}\n\n")
	qbe_output_line(output, "function l $trbn_link_path(l %root, l %suffix) {\n@start\n %a =l call $strlen(l %root)\n %b =l call $strlen(l %suffix)\n %n =l add %a, %b\n %size =l add %n, 1\n %path =l call $malloc(l %size)\n %path_nonzero =w cnel %path, 0\n jnz %path_nonzero, @copy, @failed\n@copy\n call $memcpy(l %path, l %root, l %a)\n %tail =l add %path, %a\n %rest =l add %b, 1\n call $memcpy(l %tail, l %suffix, l %rest)\n ret %path\n@failed\n call $perror(l $trbn_link_allocate_error)\n ret 0\n}\n\n")
	qbe_output_line(output, "function l $trbn_network_link_arguments(l %tail, l %qbe) {\n@start\n %needed =l loadl $trbn_network_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @directory, @unchanged\n@unchanged\n ret %tail\n@directory\n %uv_slot =l add %tail, 8\n %http_slot =l add %tail, 16\n %identity_slot =l add %tail, 24\n storel 0, %uv_slot\n storel 0, %http_slot\n storel 0, %identity_slot\n %root =l call $trbn_link_directory(l $trbn_network_link_directory, l %qbe, l $trbn_network_link_relative)\n jmp @resolved\n@resolved\n %root_nonzero =w cnel %root, 0\n jnz %root_nonzero, @paths, @failed\n@paths\n %uv =l call $trbn_link_path(l %root, l $trbn_network_link_uv)\n %http =l call $trbn_link_path(l %root, l $trbn_network_link_http)\n %identity =l call $trbn_link_path(l %root, l $trbn_network_link_identity)\n call $free(l %root)\n storel %uv, %uv_slot\n storel %http, %http_slot\n storel %identity, %identity_slot\n %no_uv =w ceql %uv, 0\n %no_http =w ceql %http, 0\n %no_identity =w ceql %identity, 0\n %no_library =w or %no_uv, %no_http\n %missing =w or %no_library, %no_identity\n jnz %missing, @failed, @readable\n@readable\n %uv_status =w call $trbn_link_access(l %uv)\n %http_status =w call $trbn_link_access(l %http)\n %identity_status =w call $trbn_link_access(l %identity)\n %library_status =w or %uv_status, %http_status\n %status =w or %library_status, %identity_status\n jnz %status, @failed, @arguments\n@arguments\n storel $trbn_network_link_input, %tail\n %linux =l loadl $trbn_project_selected_linker\n %linux_nonzero =w cnel %linux, 0\n jnz %linux_nonzero, @linux, @darwin\n@linux\n %pthread_slot =l add %tail, 32\n storel $trbn_network_link_pthread, %pthread_slot\n %dl_slot =l add %tail, 40\n storel $trbn_network_link_dl, %dl_slot\n %rt_slot =l add %tail, 48\n storel $trbn_network_link_rt, %rt_slot\n %linux_tail =l add %tail, 56\n ret %linux_tail\n@darwin\n %darwin_tail =l add %tail, 32\n ret %darwin_tail\n@failed\n call $trbn_network_link_cleanup(l %tail)\n %length =l call $strlen(l $trbn_network_link_error)\n call $write(w 2, l $trbn_network_link_error, l %length)\n ret 0\n}\n\n")
	qbe_output_line(output, "function $trbn_network_link_cleanup(l %tail) {\n@start\n %needed =l loadl $trbn_network_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @release, @done\n@release\n %uv_slot =l add %tail, 8\n %uv =l loadl %uv_slot\n call $free(l %uv)\n %http_slot =l add %tail, 16\n %http =l loadl %http_slot\n call $free(l %http)\n %identity_slot =l add %tail, 24\n %identity =l loadl %identity_slot\n call $free(l %identity)\n@done\n ret\n}\n")
end
