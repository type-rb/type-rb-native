import { QbeOutput, qbe_output_line } from backend/qbe/output

# Internal managed values for the verified scoped File operation. Public
# declaration ownership, Result construction and call effects are separate
# compiler obligations; this layer never exposes a descriptor or raw pointer.
def emit_filesystem_values_runtime(mut output: QbeOutput)
	qbe_output_line(output, "# The handle is managed and traces only its immutable path. The cleanup frame\n# is separate, stack-owned storage and never dereferences a managed object.\ndata $trbn_desc_file = align 8 { l 1, l 1, l 16, l 8 }\n\nfunction l $trbn_file_begin(l %scope, l %path, l %mode, l %out) {\n@start\n storel 0, %out\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %path)\n %handle =l call $trbn_gc_alloc(l $trbn_desc_file, l 16, l 0)\n %path_slot =l add %handle, 8\n storel %path, %path_slot\n %fd_slot =l add %handle, 16\n storel -1, %fd_slot\n %length_slot =l add %path, 8\n %length =l loadl %length_slot\n %data =l add %path, 24\n %status =l call $trbn_file_acquire(l %scope, l %data, l %length, l %mode)\n jnz %status, @failed, @opened\n@opened\n %scope_fd =l add %scope, 8\n %fd =w loadw %scope_fd\n %wide =l extsw %fd\n storel %wide, %fd_slot\n storel %handle, %out\n storel %roots, $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %handle)\n ret 0\n@failed\n storel %roots, $trbn_gc_temp_count\n ret %status\n}\n\nfunction l $trbn_file_end(l %scope, l %handle) {\n@start\n %fd_slot =l add %handle, 16\n storel -1, %fd_slot\n %status =l call $trbn_file_release(l %scope)\n ret %status\n}\n")
	qbe_output_line(output, "# Buffers keep their allocation capacity as their length until discarded.\n# The collector sizes String/Bytes storage from that length; shrinking a header\n# in place would corrupt accounting and possibly select the wrong free list.\nfunction l $trbn_file_buffer(l %capacity) {\n@start\n %allocation =l add %capacity, 17\n %buffer =l call $trbn_string_alloc(l %allocation)\n %length =l add %buffer, 8\n storel %capacity, %length\n %points =l add %buffer, 16\n storel 0, %points\n %data =l add %buffer, 24\n %end =l add %data, %capacity\n storeb 0, %end\n ret %buffer\n}\n\n# Zero means success and publishes exactly one rooted, immutable Bytes value.\n# Positive statuses are errno; -5 is InvalidLimit, -6 is TooLarge. Neither a\n# negative bound nor a failed read publishes a partial value. The extra byte\n# is consumed once, never a whole extra buffer beyond the requested maximum.\nfunction l $trbn_file_read_bounded(w %fd, l %maximum, l %out) {\n@start\n storel 0, %out\n %roots =l loadl $trbn_gc_temp_count\n %negative =w csltl %maximum, 0\n jnz %negative, @invalid, @bound\n@invalid\n ret -5\n@bound\n %ceiling =l add %maximum, 1\n %small =w culel %ceiling, 4096\n jnz %small, @small, @large\n@small\n jmp @allocate\n@large\n jmp @allocate\n@allocate\n %initial_capacity =l phi @small %ceiling, @large 4096\n %initial =l call $trbn_file_buffer(l %initial_capacity)\n jmp @read\n@read\n %buffer =l phi @allocate %initial, @advance %buffer, @grown %replacement\n %capacity =l phi @allocate %initial_capacity, @advance %capacity, @grown %next_capacity\n %written =l phi @allocate 0, @advance %total, @grown %total\n %data =l add %buffer, 24\n %target =l add %data, %written\n %remaining =l sub %capacity, %written\n %count =l call $trbn_file_read_into(w %fd, l %target, l %remaining)\n %failure =w csltl %count, 0\n jnz %failure, @read_failed, @count\n@count\n %total =l add %written, %count\n %over =w cugtl %total, %maximum\n jnz %over, @too_large, @eof\n@eof\n %finished =w ceql %count, 0\n jnz %finished, @complete, @space\n@space\n %full =w ceql %total, %capacity\n jnz %full, @grow, @advance\n@advance\n jmp @read\n@grow\n %doubled =l mul %capacity, 2\n %clamp =w cugtl %doubled, %ceiling\n jnz %clamp, @ceiling, @double\n@ceiling\n jmp @replace\n@double\n jmp @replace\n@replace\n %next_capacity =l phi @ceiling %ceiling, @double %doubled\n %replacement =l call $trbn_file_buffer(l %next_capacity)\n %replacement_data =l add %replacement, 24\n call $memcpy(l %replacement_data, l %data, l %total)\n storel %roots, $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %replacement)\n jmp @grown\n@grown\n jmp @read\n@complete\n %result =l call $trbn_string_from_bytes(l %data, l %written)\n storel %result, %out\n storel %roots, $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %result)\n ret 0\n@read_failed\n %error =l sub 0, %count\n storel %roots, $trbn_gc_temp_count\n ret %error\n@too_large\n storel %roots, $trbn_gc_temp_count\n ret -6\n}\n")
	qbe_output_line(output, "# Strict text decoding never replacement-decodes or strips a leading BOM.\n# The Bytes storage already has the exact original bytes and point count.\nfunction l $trbn_file_read_value(l %file, l %maximum, l %text, l %out) {\n@start\n %roots =l loadl $trbn_gc_temp_count\n %fd_slot =l add %file, 16\n %fd =w loadw %fd_slot\n %status =l call $trbn_file_read_bounded(w %fd, l %maximum, l %out)\n jnz %status, @failed, @mode\n@failed\n ret %status\n@mode\n jnz %text, @validate, @done\n@validate\n %value =l loadl %out\n %valid =l call $trbn_bytes_valid_utf8(l %value)\n jnz %valid, @done, @invalid\n@invalid\n storel 0, %out\n storel %roots, $trbn_gc_temp_count\n ret -7\n@done\n ret 0\n}\n\nfunction l $trbn_file_write_value(l %file, l %value) {\n@start\n %fd_slot =l add %file, 16\n %fd =w loadw %fd_slot\n %length_slot =l add %value, 8\n %length =l loadl %length_slot\n %data =l add %value, 24\n %status =l call $trbn_file_write_all(w %fd, l %data, l %length)\n ret %status\n}\n")
	qbe_output_line(output, "# Internal ABI for one checked structured operation. The compiler must supply\n# a known synchronous body thunk and error constructor, never an authored\n# first-class callback. Captured operands remain rooted by the calling frame.\n# The body returns Result<T, FileSystemError>; this owner performs exactly one\n# close before exposing that value. Unwinding uses the same registered frame.\nfunction l $trbn_file_scope(l %path, l %mode, l %body, l %captures, l %error, l %error_tag) {\n@start\n %roots =l loadl $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %path)\n %frame =l alloc8 16\n %out =l alloc8 8\n %opened =l call $trbn_file_begin(l %frame, l %path, l %mode, l %out)\n jnz %opened, @open_error, @body\n@open_error\n %open_result =l call %error(l %path, l 0, l %opened)\n jmp @finish\n@body\n %file =l loadl %out\n %body_result =l call %body(l %file, l %captures)\n %closed =l call $trbn_file_end(l %frame, l %file)\n jnz %closed, @close_error, @body_result\n@close_error\n %tag_slot =l add %body_result, 8\n %tag =l loadl %tag_slot\n %failed_body =w ceql %tag, %error_tag\n jnz %failed_body, @body_result, @replace\n@replace\n %close_result =l call %error(l %path, l 1, l %closed)\n jmp @finish\n@body_result\n jmp @finish\n@finish\n %result =l phi @open_error %open_result, @replace %close_result, @body_result %body_result\n storel %roots, $trbn_gc_temp_count\n call $trbn_gc_temp_push(l %result)\n ret %result\n}\n")
end
