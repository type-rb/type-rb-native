import { QbeOutput, qbe_output_line } from backend/qbe/output
import { emit_float_decimal_runtime } from backend/qbe/runtime/float_decimal

# Direct shortest binary64 conversion returns integer digits and a decimal power.
# Expand those digits without converting the binary Float a second time.
# The 32-byte digit buffer and 384-byte fixed-output buffer cover all finite
# binary64 values, including the smallest subnormal and its sign.
def emit_float_string_runtime(mut output: QbeOutput)
	emit_float_decimal_runtime(output)
	qbe_output_line(output, "data $trbn_float_zero = align 8 { l 0, l 3, l 3, b \"0.0\", b 0 }\ndata $trbn_float_nan = align 8 { l 0, l 3, l 3, b \"NaN\", b 0 }\ndata $trbn_float_infinity = align 8 { l 0, l 8, l 8, b \"Infinity\", b 0 }\ndata $trbn_float_negative_infinity = align 8 { l 0, l 9, l 9, b \"-Infinity\", b 0 }\ndata $trbn_float_format_error = { b \"panic: Float formatting failed\", b 10 }\nfunction l $trbn_float_to_string(d %value) {\n")
	qbe_output_line(output, "@start\n %nan =w cned %value, %value\n jnz %nan, @nan, @zero_check\n")
	qbe_output_line(output, "@nan\n ret $trbn_float_nan\n")
	qbe_output_line(output, "@zero_check\n %zero =w ceqd %value, d_0.0\n jnz %zero, @zero, @sign\n")
	qbe_output_line(output, "@zero\n ret $trbn_float_zero\n")
	qbe_output_line(output, "@sign\n %negative =w cltd %value, d_0.0\n jnz %negative, @negative, @positive\n")
	qbe_output_line(output, "@negative\n %absolute =d sub d_0.0, %value\n jmp @finite\n")
	qbe_output_line(output, "@positive\n jmp @finite\n")
	qbe_output_line(output, "@finite\n %magnitude =d phi @negative %absolute, @positive %value\n %difference =d sub %magnitude, %magnitude\n %infinite =w cned %difference, %difference\n jnz %infinite, @infinite, @prepare\n")
	qbe_output_line(output, "@infinite\n jnz %negative, @negative_infinity, @positive_infinity\n")
	qbe_output_line(output, "@negative_infinity\n ret $trbn_float_negative_infinity\n")
	qbe_output_line(output, "@positive_infinity\n ret $trbn_float_infinity\n")
	qbe_output_line(output, "@prepare\n %digits =l alloc8 32\n %power_slot =l alloc8 8\n %coefficient =l call $trbn_float_decimal(d %magnitude, l %power_slot)\n %decimal_power =l loadl %power_slot\n %invalid =w ceql %coefficient, 0\n jnz %invalid, @fail, @trim\n")
	qbe_output_line(output, "@trim\n %remaining =l phi @prepare %coefficient, @trim_more %trimmed\n %power =l phi @prepare %decimal_power, @trim_more %next_power\n %tail =l urem %remaining, 10\n %trailing_zero =w ceql %tail, 0\n jnz %trailing_zero, @trim_more, @digits_start\n")
	qbe_output_line(output, "@trim_more\n %trimmed =l udiv %remaining, 10\n %next_power =l add %power, 1\n jmp @trim\n")
	qbe_output_line(output, "@digits_start\n %end =l add %digits, 32\n jmp @write_digit\n")
	qbe_output_line(output, "@write_digit\n %coefficient_part =l phi @digits_start %remaining, @again %quotient\n %cursor =l phi @digits_start %end, @again %slot\n %slot =l sub %cursor, 1\n %digit =l urem %coefficient_part, 10\n %character =l add %digit, 48\n storeb %character, %slot\n %quotient =l udiv %coefficient_part, 10\n %more =w cnel %quotient, 0\n jnz %more, @again, @digits_done\n")
	qbe_output_line(output, "@again\n jmp @write_digit\n")
	qbe_output_line(output, "@digits_done\n %count =l sub %end, %slot\n %point =l add %count, %power\n %sign =l extuw %negative\n %result =l call $trbn_decimal_fixed(l %slot, l %count, l %point, l %sign)\n ret %result\n")
	qbe_output_line(output, "@fail\n call $trbn_fail(l $trbn_float_format_error, l 31)\n hlt\n}\nfunction l $trbn_decimal_fixed(l %digits, l %count, l %point, l %negative) {\n")
	qbe_output_line(output, "@start\n %buffer =l alloc8 384\n storeb 45, %buffer\n %fraction =w cslel %point, 0\n jnz %fraction, @fraction, @integer\n")
	qbe_output_line(output, "@fraction\n %zero_address =l add %buffer, %negative\n storeb 48, %zero_address\n %dot_address =l add %zero_address, 1\n storeb 46, %dot_address\n %fraction_cursor =l add %negative, 2\n jmp @loop_start\n")
	qbe_output_line(output, "@integer\n %extended =w csgtl %point, %count\n jnz %extended, @extended, @short\n")
	qbe_output_line(output, "@extended\n jmp @integer_ready\n")
	qbe_output_line(output, "@short\n jmp @integer_ready\n")
	qbe_output_line(output, "@integer_ready\n %integer_end =l phi @extended %point, @short %count\n jmp @loop_start\n")
	qbe_output_line(output, "@loop_start\n %initial =l phi @fraction %point, @integer_ready 0\n %end =l phi @fraction %count, @integer_ready %integer_end\n %initial_cursor =l phi @fraction %fraction_cursor, @integer_ready %negative\n jmp @loop\n")
	qbe_output_line(output, "@loop\n %index =l phi @loop_start %initial, @next %next_index\n %cursor =l phi @loop_start %initial_cursor, @next %next_cursor\n %done =w csgel %index, %end\n jnz %done, @done, @dot_check\n")
	qbe_output_line(output, "@dot_check\n %at_point =w ceql %index, %point\n %positive_point =w csgtl %point, 0\n %needs_dot =w and %at_point, %positive_point\n jnz %needs_dot, @dot, @no_dot\n")
	qbe_output_line(output, "@dot\n %dot_slot =l add %buffer, %cursor\n storeb 46, %dot_slot\n %after_dot =l add %cursor, 1\n jmp @digit\n")
	qbe_output_line(output, "@no_dot\n jmp @digit\n")
	qbe_output_line(output, "@digit\n %position =l phi @dot %after_dot, @no_dot %cursor\n %below =w csltl %index, 0\n %above =w csgel %index, %count\n %padding =w or %below, %above\n jnz %padding, @padding, @copy\n")
	qbe_output_line(output, "@padding\n jmp @store\n")
	qbe_output_line(output, "@copy\n %source =l add %digits, %index\n %value =w loadub %source\n jmp @store\n")
	qbe_output_line(output, "@store\n %character =w phi @padding 48, @copy %value\n %target =l add %buffer, %position\n storeb %character, %target\n jmp @next\n")
	qbe_output_line(output, "@next\n %next_cursor =l add %position, 1\n %next_index =l add %index, 1\n jmp @loop\n")
	qbe_output_line(output, "@done\n %whole =w csgel %point, %count\n jnz %whole, @whole, @fraction_done\n")
	qbe_output_line(output, "@whole\n %decimal =l add %buffer, %cursor\n storeb 46, %decimal\n %zero =l add %decimal, 1\n storeb 48, %zero\n %whole_length =l add %cursor, 2\n jmp @finish\n")
	qbe_output_line(output, "@fraction_done\n jmp @finish\n")
	qbe_output_line(output, "@finish\n %length =l phi @whole %whole_length, @fraction_done %cursor\n %result =l call $trbn_string_from_bytes(l %buffer, l %length)\n ret %result\n}\n\n")
end
