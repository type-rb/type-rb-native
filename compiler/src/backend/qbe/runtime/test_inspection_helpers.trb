import { QbeOutput, qbe_output_line } from backend/qbe/output

# The output buffer is raw owned storage. The public adapter roots the entire
# input graph; leaf conversions are copied before any further GC allocation.
# Stack-only visits and Hash selection are bounded by the diagnostic contract.
def emit_test_inspection_helpers(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_inspect_nil = { b 110, b 105, b 108, b 0 }\ndata $trbn_inspect_ellipsis = { b 46, b 46, b 46, b 0 }\ndata $trbn_inspect_cycle = { b 60, b 99, b 121, b 99, b 108, b 101, b 62, b 0 }\ndata $trbn_inspect_true = { b 116, b 114, b 117, b 101, b 0 }\ndata $trbn_inspect_false = { b 102, b 97, b 108, b 115, b 101, b 0 }\ndata $trbn_inspect_open = { b 40, b 0 }\ndata $trbn_inspect_close = { b 41, b 0 }\ndata $trbn_inspect_array = { b 91, b 0 }\ndata $trbn_inspect_array_end = { b 93, b 0 }\ndata $trbn_inspect_bytes = { b 66, b 121, b 116, b 101, b 115, b 91, b 0 }\ndata $trbn_inspect_hash = { b 123, b 0 }\ndata $trbn_inspect_hash_end = { b 125, b 0 }\ndata $trbn_inspect_comma = { b 44, b 32, b 0 }\ndata $trbn_inspect_arrow = { b 32, b 61, b 62, b 32, b 0 }\ndata $trbn_inspect_function = { b 60, b 102, b 117, b 110, b 99, b 116, b 105, b 111, b 110, b 62, b 0 }\ndata $trbn_inspect_opaque = { b 60, b 118, b 97, b 108, b 117, b 101, b 62, b 0 }\ndata $trbn_inspect_range = { b 46, b 46, b 0 }\ndata $trbn_inspect_range_exclusive = { b 46, b 46, b 46, b 0 }\ndata $trbn_inspect_negative_zero = { b 45, b 48, b 0 }\ndata $trbn_inspect_quote = { b 34, b 0 }\ndata $trbn_inspect_hex_prefix = { b 92, b 117, b 48, b 48, b 0 }\ndata $trbn_inspect_hex = { b 48, b 49, b 50, b 51, b 52, b 53, b 54, b 55, b 56, b 57, b 97, b 98, b 99, b 100, b 101, b 102, b 0 }\ndata $trbn_inspect_replacement = { b 239, b 191, b 189, b 0 }\n")
	qbe_output_line(output, "function $trbn_inspect_append(l %context, l %source, l %count) {\n@start\n %lp =l add %context, 8\n %cp =l add %context, 16\n %length =l loadl %lp\n %capacity =l loadl %cp\n %required =l add %length, %count\n %too_large =w cugtl %required, 9007199254740991\n jnz %too_large, @fail, @capacity\n@capacity\n %grow =w cugtl %required, %capacity\n jnz %grow, @grow, @write\n@grow\n %double =l mul %capacity, 2\n %small =w cultl %double, %required\n jnz %small, @exact, @double\n@exact\n jmp @allocate\n@double\n jmp @allocate\n@allocate\n %reserved =l phi @exact %required, @double %double\n %previous =l loadl %context\n %new =l call $realloc(l %previous, l %reserved)\n %missing =w ceql %new, 0\n jnz %missing, @fail, @replace\n@replace\n storel %new, %context\n storel %reserved, %cp\n jmp @write\n@write\n %buffer =l loadl %context\n %target =l add %buffer, %length\n call $memcpy(l %target, l %source, l %count)\n storel %required, %lp\n ret\n@fail\n call $trbn_fatal(l $trbn_allocation_error, l 26)\n hlt\n}\nfunction $trbn_inspect_text(l %context, l %text) {\n@start\n %length =l call $strlen(l %text)\n call $trbn_inspect_append(l %context, l %text, l %length)\n ret\n}\nfunction $trbn_inspect_string(l %context, l %string) {\n@start\n %lp =l add %string, 8\n %length =l loadl %lp\n %data =l add %string, 24\n call $trbn_inspect_append(l %context, l %data, l %length)\n ret\n}\nfunction $trbn_inspect_integer(l %context, l %number) {\n@start\n %string =l call $trbn_integer_to_string(l %number)\n call $trbn_inspect_string(l %context, l %string)\n ret\n}\nfunction $trbn_inspect_float(l %context, l %bits) {\n@start\n %negative_zero =w ceql %bits, -9223372036854775808\n jnz %negative_zero, @negative_zero, @format\n@negative_zero\n call $trbn_inspect_text(l %context, l $trbn_inspect_negative_zero)\n ret\n@format\n %value =d cast %bits\n %string =l call $trbn_float_to_string(d %value)\n %lp =l add %string, 8\n %length =l loadl %lp\n %data =l add %string, 24\n %long =w cugel %length, 2\n jnz %long, @suffix, @whole\n@suffix\n %position =l sub %length, 2\n %address =l add %data, %position\n %dot =w loadub %address\n %lastp =l add %address, 1\n %last =w loadub %lastp\n %is_dot =w ceqw %dot, 46\n %is_zero =w ceqw %last, 48\n %trim =w and %is_dot, %is_zero\n jnz %trim, @trimmed, @whole\n@trimmed\n call $trbn_inspect_append(l %context, l %data, l %position)\n ret\n@whole\n call $trbn_inspect_append(l %context, l %data, l %length)\n ret\n}\n")
	qbe_output_line(output, "function $trbn_inspect_quote_span(l %context, l %data, l %length) {\n@start\n call $trbn_inspect_text(l %context, l $trbn_inspect_quote)\n %escape =l alloc8 8\n jmp @loop\n@loop\n %offset =l phi @start 0, @next %next\n %points =l phi @start 0, @next %next_points\n %end =w ceql %offset, %length\n jnz %end, @complete, @limit\n@limit\n %limit =w ceql %points, 128\n jnz %limit, @truncated, @read\n@read\n %address =l add %data, %offset\n %first =w loadub %address\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %quoted =w ceqw %first, 34\n %slash =w ceqw %first, 92\n %escaped =w or %quoted, %slash\n jnz %escaped, @escaped, @control\n@escaped\n storeb 92, %escape\n %tail =l add %escape, 1\n storeb %first, %tail\n call $trbn_inspect_append(l %context, l %escape, l 2)\n jmp @next\n@control\n %control =w cultw %first, 32\n jnz %control, @control8, @unicode\n@control8\n %b =w ceqw %first, 8\n jnz %b, @b, @control9\n@b\n jmp @short\n@control9\n %t =w ceqw %first, 9\n jnz %t, @t, @control10\n@t\n jmp @short\n@control10\n %n =w ceqw %first, 10\n jnz %n, @n, @control12\n@n\n jmp @short\n@control12\n %f =w ceqw %first, 12\n jnz %f, @f, @control13\n@f\n jmp @short\n@control13\n %r =w ceqw %first, 13\n jnz %r, @r, @hex\n@r\n jmp @short\n@short\n %letter =w phi @b 98, @t 116, @n 110, @f 102, @r 114\n storeb 92, %escape\n %short_tail =l add %escape, 1\n storeb %letter, %short_tail\n call $trbn_inspect_append(l %context, l %escape, l 2)\n jmp @next\n@hex\n call $memcpy(l %escape, l $trbn_inspect_hex_prefix, l 4)\n %wide =l extuw %first\n %upper =l shr %wide, 4\n %lower =l and %wide, 15\n %hp =l add $trbn_inspect_hex, %upper\n %lp =l add $trbn_inspect_hex, %lower\n %high =w loadub %hp\n %low =w loadub %lp\n %e4 =l add %escape, 4\n %e5 =l add %escape, 5\n storeb %high, %e4\n storeb %low, %e5\n call $trbn_inspect_append(l %context, l %escape, l 6)\n jmp @next\n@unicode\n %nonascii =w cugtw %first, 127\n %single =w ceql %width, 1\n %invalid =w and %nonascii, %single\n jnz %invalid, @replacement, @copy\n@replacement\n call $trbn_inspect_append(l %context, l $trbn_inspect_replacement, l 3)\n jmp @next\n@copy\n call $trbn_inspect_append(l %context, l %address, l %width)\n jmp @next\n@next\n %next =l add %offset, %width\n %next_points =l add %points, 1\n jmp @loop\n@truncated\n call $trbn_inspect_text(l %context, l $trbn_inspect_quote)\n call $trbn_inspect_text(l %context, l $trbn_inspect_ellipsis)\n ret\n@complete\n call $trbn_inspect_text(l %context, l $trbn_inspect_quote)\n ret\n}\nfunction $trbn_inspect_quoted(l %context, l %string) {\n@start\n %lp =l add %string, 8\n %length =l loadl %lp\n %data =l add %string, 24\n call $trbn_inspect_quote_span(l %context, l %data, l %length)\n ret\n}\nfunction l $trbn_inspect_seen(l %head, l %kind, l %value) {\n@start\n jmp @loop\n@loop\n %pair =l phi @start %head, @next %parent\n %present =w cnel %pair, 0\n jnz %present, @check, @absent\n@check\n %kp =l add %pair, 8\n %vp =l add %pair, 16\n %key =l loadl %kp\n %old =l loadl %vp\n %same_key =w ceql %key, %kind\n %same_value =w ceql %old, %value\n %same =w and %same_key, %same_value\n jnz %same, @found, @next\n@next\n %parent =l loadl %pair\n jmp @loop\n@absent\n ret 0\n@found\n ret 1\n}\n")
	qbe_output_line(output, "function l $trbn_inspect_hash_key(l %table, l %key) {\n@start\n %fp =l add %table, 40\n %flags =l loadl %fp\n %boxed_bits =l and %flags, 4\n %boxed =w cnel %boxed_bits, 0\n jnz %boxed, @boxed, @unboxed\n@boxed\n %payload =l add %key, 16\n %value =l loadl %payload\n ret %value\n@unboxed\n %strings_bits =l and %flags, 1\n %strings =w cnel %strings_bits, 0\n jnz %strings, @string, @integer\n@string\n ret %key\n@integer\n %integer =l sub %key, 9007199254740992\n ret %integer\n}\nfunction w $trbn_inspect_key_less(l %table, l %left, l %right) {\n@start\n %a =l call $trbn_inspect_hash_key(l %table, l %left)\n %b =l call $trbn_inspect_hash_key(l %table, l %right)\n %fp =l add %table, 40\n %flags =l loadl %fp\n %bits =l and %flags, 1\n %strings =w cnel %bits, 0\n jnz %strings, @strings, @integers\n@integers\n %less =w csltl %a, %b\n ret %less\n@strings\n %alp =l add %a, 8\n %blp =l add %b, 8\n %al =l loadl %alp\n %bl =l loadl %blp\n %shorter =w cultl %al, %bl\n jnz %shorter, @left, @right\n@left\n jmp @compare\n@right\n jmp @compare\n@compare\n %length =l phi @left %al, @right %bl\n %ad =l add %a, 24\n %bd =l add %b, 24\n %order =w call $memcmp(l %ad, l %bd, l %length)\n %different =w cnew %order, 0\n jnz %different, @content, @length\n@content\n %content_less =w csltw %order, 0\n ret %content_less\n@length\n ret %shorter\n}\nfunction l $trbn_inspect_hash_order(l %table, l %indexes) {\n@start\n %sp =l add %table, 8\n %size =l loadl %sp\n %empty =w ceql %size, 0\n jnz %empty, @empty, @prepare\n@empty\n ret 0\n@prepare\n %cp =l add %table, 16\n %capacity =l loadl %cp\n %kp =l add %table, 24\n %keys =l loadl %kp\n %dp =l add %keys, 24\n %data =l loadl %dp\n %countp =l alloc8 8\n storel 0, %countp\n jmp @loop\n@loop\n %index =l phi @prepare 0, @next %next\n %done =w ceql %index, %capacity\n jnz %done, @done, @key\n@key\n %offset =l mul %index, 8\n %slot =l add %data, %offset\n %key =l loadl %slot\n %zero =w ceql %key, 0\n %integer_tomb =w ceql %key, -1\n %managed_tomb =w ceql %key, $trbn_hash_tombstone\n %unused =w or %zero, %integer_tomb\n %skip =w or %unused, %managed_tomb\n jnz %skip, @next, @position\n@position\n %count =l loadl %countp\n %full =w ceql %count, 16\n jnz %full, @last, @available\n@last\n jmp @insert\n@available\n %more =l add %count, 1\n storel %more, %countp\n jmp @insert\n@insert\n %end =l phi @last 15, @available %count\n jmp @scan\n@scan\n %position =l phi @insert 0, @compare_next %following\n %past =w cugtl %position, %end\n jnz %past, @next, @compare\n@compare\n %at_end =w ceql %position, %count\n jnz %at_end, @shift_start, @existing\n@existing\n %po =l mul %position, 8\n %ip =l add %indexes, %po\n %old_index =l loadl %ip\n %old_offset =l mul %old_index, 8\n %old_slot =l add %data, %old_offset\n %old_key =l loadl %old_slot\n %before =w call $trbn_inspect_key_less(l %table, l %key, l %old_key)\n jnz %before, @shift_start, @compare_next\n@compare_next\n %following =l add %position, 1\n jmp @scan\n@shift_start\n jmp @shift\n@shift\n %destination =l phi @shift_start %end, @move %previous\n %finished =w ceql %destination, %position\n jnz %finished, @store, @move\n@move\n %previous =l sub %destination, 1\n %from_offset =l mul %previous, 8\n %to_offset =l mul %destination, 8\n %from =l add %indexes, %from_offset\n %to =l add %indexes, %to_offset\n %old_value =l loadl %from\n storel %old_value, %to\n jmp @shift\n@store\n %write_offset =l mul %position, 8\n %write_slot =l add %indexes, %write_offset\n storel %index, %write_slot\n jmp @next\n@next\n %next =l add %index, 1\n jmp @loop\n@done\n %result =l loadl %countp\n ret %result\n}\n")
end
