import { QbeOutput, qbe_output_line } from backend/qbe/output

def emit_network_libraries(mut output: QbeOutput)
	qbe_output_line(output, "data $net_fn_uv_version = align 8 { l 0 }\ndata $net_name_uv_version = { b \"uv_version\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_version() {\n@start\n %fn =l loadl $net_fn_uv_version\n %value =w call %fn()\n ret %value\n}\ndata $net_fn_uv_loop_size = align 8 { l 0 }\ndata $net_name_uv_loop_size = { b \"uv_loop_size\", b 0 }\n")
	qbe_output_line(output, "function l $net_uv_loop_size() {\n@start\n %fn =l loadl $net_fn_uv_loop_size\n %value =l call %fn()\n ret %value\n}\ndata $net_fn_uv_loop_init = align 8 { l 0 }\ndata $net_name_uv_loop_init = { b \"uv_loop_init\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_loop_init(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_loop_init\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_fn_uv_loop_close = align 8 { l 0 }\ndata $net_name_uv_loop_close = { b \"uv_loop_close\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_loop_close(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_loop_close\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_fn_uv_run = align 8 { l 0 }\ndata $net_name_uv_run = { b \"uv_run\", b 0 }\n")
