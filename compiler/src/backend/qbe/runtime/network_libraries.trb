import { QbeOutput, qbe_output_line } from backend/qbe/output

# The build driver links the pinned archives only for verified network MIR.
# Referencing the build identity retains its source and archive hashes in the app.
def emit_network_libraries(mut output: QbeOutput)
	qbe_output_line(output, "function w $net_uv_version() {\n@start\n  %value =w call $uv_version()\n ret %value\n}\n")
	qbe_output_line(output, "function l $net_uv_loop_size() {\n@start\n  %value =l call $uv_loop_size()\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_loop_init(l %a0) {\n@start\n  %value =w call $uv_loop_init(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_loop_close(l %a0) {\n@start\n  %value =w call $uv_loop_close(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_run(l %a0, w %a1) {\n@start\n  %value =w call $uv_run(l %a0, w %a1)\n ret %value\n}\n")
	qbe_output_line(output, "function $net_uv_stop(l %a0) {\n@start\n  call $uv_stop(l %a0)\n ret\n}\n")
	qbe_output_line(output, "function l $net_uv_handle_size(w %a0) {\n@start\n  %value =l call $uv_handle_size(w %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function l $net_uv_req_size(w %a0) {\n@start\n  %value =l call $uv_req_size(w %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function l $net_uv_handle_get_data(l %a0) {\n@start\n  %value =l call $uv_handle_get_data(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function $net_uv_handle_set_data(l %a0, l %a1) {\n@start\n  call $uv_handle_set_data(l %a0, l %a1)\n ret\n}\n")
	qbe_output_line(output, "function l $net_uv_req_get_data(l %a0) {\n@start\n  %value =l call $uv_req_get_data(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function $net_uv_req_set_data(l %a0, l %a1) {\n@start\n  call $uv_req_set_data(l %a0, l %a1)\n ret\n}\n")
	qbe_output_line(output, "function w $net_uv_tcp_init(l %a0, l %a1) {\n@start\n  %value =w call $uv_tcp_init(l %a0, l %a1)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_tcp_bind(l %a0, l %a1, w %a2) {\n@start\n  %value =w call $uv_tcp_bind(l %a0, l %a1, w %a2)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_ip4_addr(l %a0, w %a1, l %a2) {\n@start\n  %value =w call $uv_ip4_addr(l %a0, w %a1, l %a2)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_ip6_addr(l %a0, w %a1, l %a2) {\n@start\n  %value =w call $uv_ip6_addr(l %a0, w %a1, l %a2)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_listen(l %a0, w %a1, l %a2) {\n@start\n  %value =w call $uv_listen(l %a0, w %a1, l %a2)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_accept(l %a0, l %a1) {\n@start\n  %value =w call $uv_accept(l %a0, l %a1)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_read_start(l %a0, l %a1, l %a2) {\n@start\n  %value =w call $uv_read_start(l %a0, l %a1, l %a2)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_read_stop(l %a0) {\n@start\n  %value =w call $uv_read_stop(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_write(l %a0, l %a1, l %a2, w %a3, l %a4) {\n@start\n  %value =w call $uv_write(l %a0, l %a1, l %a2, w %a3, l %a4)\n ret %value\n}\n")
	qbe_output_line(output, "function $net_uv_close(l %a0, l %a1) {\n@start\n  call $uv_close(l %a0, l %a1)\n ret\n}\n")
	qbe_output_line(output, "function w $net_uv_is_closing(l %a0) {\n@start\n  %value =w call $uv_is_closing(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_signal_init(l %a0, l %a1) {\n@start\n  %value =w call $uv_signal_init(l %a0, l %a1)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_signal_start(l %a0, l %a1, w %a2) {\n@start\n  %value =w call $uv_signal_start(l %a0, l %a1, w %a2)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_timer_init(l %a0, l %a1) {\n@start\n  %value =w call $uv_timer_init(l %a0, l %a1)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_timer_start(l %a0, l %a1, l %a2, l %a3) {\n@start\n  %value =w call $uv_timer_start(l %a0, l %a1, l %a2, l %a3)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_uv_getaddrinfo(l %a0, l %a1, l %a2, l %a3, l %a4, l %a5) {\n@start\n  %value =w call $uv_getaddrinfo(l %a0, l %a1, l %a2, l %a3, l %a4, l %a5)\n ret %value\n}\n")
	qbe_output_line(output, "function $net_uv_freeaddrinfo(l %a0) {\n@start\n  call $uv_freeaddrinfo(l %a0)\n ret\n}\n")
	qbe_output_line(output, "function $net_llhttp_resume(l %a0) {\n@start\n  call $llhttp_resume(l %a0)\n ret\n}\n")
	qbe_output_line(output, "function $net_llhttp_init(l %a0, w %a1, l %a2) {\n@start\n  call $llhttp_init(l %a0, w %a1, l %a2)\n ret\n}\n")
	qbe_output_line(output, "function w $net_llhttp_execute(l %a0, l %a1, l %a2) {\n@start\n  %value =w call $llhttp_execute(l %a0, l %a1, l %a2)\n ret %value\n}\n")
	qbe_output_line(output, "function $net_llhttp_reset(l %a0) {\n@start\n  call $llhttp_reset(l %a0)\n ret\n}\n")
	qbe_output_line(output, "function l $net_llhttp_get_error_pos(l %a0) {\n@start\n  %value =l call $llhttp_get_error_pos(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_llhttp_should_keep_alive(l %a0) {\n@start\n  %value =w call $llhttp_should_keep_alive(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_llhttp_get_http_major(l %a0) {\n@start\n  %value =w call $llhttp_get_http_major(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_llhttp_get_http_minor(l %a0) {\n@start\n  %value =w call $llhttp_get_http_minor(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function w $net_llhttp_get_upgrade(l %a0) {\n@start\n  %value =w call $llhttp_get_upgrade(l %a0)\n ret %value\n}\n")
	qbe_output_line(output, "function $net_llhttp_set_lenient_chunked_length(l %parser, w %enabled) {\n@start\n  call $llhttp_set_lenient_chunked_length(l %parser, w %enabled)\n ret\n}\n")
	qbe_output_line(output, "function w $net_load() {\n@start\n %identity =w loadub $trbn_network_build_identity\n %marked =w ceqw %identity, 84\n %version =w call $net_uv_version()\n %pinned =w ceqw %version, 79104\n %valid =w and %marked, %pinned\n ret %valid\n}\n")
end
