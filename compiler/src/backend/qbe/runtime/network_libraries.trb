	qbe_output_line(output, "function w $net_uv_accept(l %a0, l %a1) {\n@start\n %fn =l loadl $net_fn_uv_accept\n %value =w call %fn(l %a0, l %a1)\n ret %value\n}\ndata $net_fn_uv_read_start = align 8 { l 0 }\ndata $net_name_uv_read_start = { b \"uv_read_start\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_read_start(l %a0, l %a1, l %a2) {\n@start\n %fn =l loadl $net_fn_uv_read_start\n %value =w call %fn(l %a0, l %a1, l %a2)\n ret %value\n}\ndata $net_fn_uv_read_stop = align 8 { l 0 }\ndata $net_name_uv_read_stop = { b \"uv_read_stop\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_read_stop(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_read_stop\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_fn_uv_write = align 8 { l 0 }\ndata $net_name_uv_write = { b \"uv_write\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_write(l %a0, l %a1, l %a2, w %a3, l %a4) {\n@start\n %fn =l loadl $net_fn_uv_write\n %value =w call %fn(l %a0, l %a1, l %a2, w %a3, l %a4)\n ret %value\n}\ndata $net_fn_uv_close = align 8 { l 0 }\ndata $net_name_uv_close = { b \"uv_close\", b 0 }\n")
	qbe_output_line(output, "function $net_uv_close(l %a0, l %a1) {\n@start\n %fn =l loadl $net_fn_uv_close\n call %fn(l %a0, l %a1)\n ret\n}\ndata $net_fn_uv_is_closing = align 8 { l 0 }\ndata $net_name_uv_is_closing = { b \"uv_is_closing\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_is_closing(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_is_closing\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_fn_uv_signal_init = align 8 { l 0 }\ndata $net_name_uv_signal_init = { b \"uv_signal_init\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_signal_init(l %a0, l %a1) {\n@start\n %fn =l loadl $net_fn_uv_signal_init\n %value =w call %fn(l %a0, l %a1)\n ret %value\n}\ndata $net_fn_uv_signal_start = align 8 { l 0 }\ndata $net_name_uv_signal_start = { b \"uv_signal_start\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_signal_start(l %a0, l %a1, w %a2) {\n@start\n %fn =l loadl $net_fn_uv_signal_start\n %value =w call %fn(l %a0, l %a1, w %a2)\n ret %value\n}\ndata $net_fn_uv_timer_init = align 8 { l 0 }\ndata $net_name_uv_timer_init = { b \"uv_timer_init\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_timer_init(l %a0, l %a1) {\n@start\n %fn =l loadl $net_fn_uv_timer_init\n %value =w call %fn(l %a0, l %a1)\n ret %value\n}\ndata $net_fn_uv_timer_start = align 8 { l 0 }\ndata $net_name_uv_timer_start = { b \"uv_timer_start\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_timer_start(l %a0, l %a1, l %a2, l %a3) {\n@start\n %fn =l loadl $net_fn_uv_timer_start\n %value =w call %fn(l %a0, l %a1, l %a2, l %a3)\n ret %value\n}\ndata $net_fn_uv_getaddrinfo = align 8 { l 0 }\ndata $net_name_uv_getaddrinfo = { b \"uv_getaddrinfo\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_getaddrinfo(l %a0, l %a1, l %a2, l %a3, l %a4, l %a5) {\n@start\n %fn =l loadl $net_fn_uv_getaddrinfo\n %value =w call %fn(l %a0, l %a1, l %a2, l %a3, l %a4, l %a5)\n ret %value\n}\ndata $net_fn_uv_freeaddrinfo = align 8 { l 0 }\ndata $net_name_uv_freeaddrinfo = { b \"uv_freeaddrinfo\", b 0 }\n")
	qbe_output_line(output, "function $net_uv_freeaddrinfo(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_freeaddrinfo\n call %fn(l %a0)\n ret\n}\ndata $net_fn_llhttp_resume = align 8 { l 0 }\ndata $net_name_llhttp_resume = { b \"llhttp_resume\", b 0 }\n")
	qbe_output_line(output, "function $net_llhttp_resume(l %a0) {\n@start\n %fn =l loadl $net_fn_llhttp_resume\n call %fn(l %a0)\n ret\n}\ndata $net_fn_llhttp_init = align 8 { l 0 }\ndata $net_name_llhttp_init = { b \"llhttp_init\", b 0 }\n")
	qbe_output_line(output, "function $net_llhttp_init(l %a0, w %a1, l %a2) {\n@start\n %fn =l loadl $net_fn_llhttp_init\n call %fn(l %a0, w %a1, l %a2)\n ret\n}\ndata $net_fn_llhttp_execute = align 8 { l 0 }\ndata $net_name_llhttp_execute = { b \"llhttp_execute\", b 0 }\n")
	qbe_output_line(output, "function w $net_llhttp_execute(l %a0, l %a1, l %a2) {\n@start\n %fn =l loadl $net_fn_llhttp_execute\n %value =w call %fn(l %a0, l %a1, l %a2)\n ret %value\n}\ndata $net_fn_llhttp_reset = align 8 { l 0 }\ndata $net_name_llhttp_reset = { b \"llhttp_reset\", b 0 }\n")
	qbe_output_line(output, "function $net_llhttp_reset(l %a0) {\n@start\n %fn =l loadl $net_fn_llhttp_reset\n call %fn(l %a0)\n ret\n}\ndata $net_fn_llhttp_get_error_pos = align 8 { l 0 }\ndata $net_name_llhttp_get_error_pos = { b \"llhttp_get_error_pos\", b 0 }\n")
	qbe_output_line(output, "function l $net_llhttp_get_error_pos(l %a0) {\n@start\n %fn =l loadl $net_fn_llhttp_get_error_pos\n %value =l call %fn(l %a0)\n ret %value\n}\ndata $net_fn_llhttp_should_keep_alive = align 8 { l 0 }\ndata $net_name_llhttp_should_keep_alive = { b \"llhttp_should_keep_alive\", b 0 }\n")
	qbe_output_line(output, "function w $net_llhttp_should_keep_alive(l %a0) {\n@start\n %fn =l loadl $net_fn_llhttp_should_keep_alive\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_fn_llhttp_get_http_major = align 8 { l 0 }\ndata $net_name_llhttp_get_http_major = { b \"llhttp_get_http_major\", b 0 }\n")
	qbe_output_line(output, "function w $net_llhttp_get_http_major(l %a0) {\n@start\n %fn =l loadl $net_fn_llhttp_get_http_major\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_fn_llhttp_get_http_minor = align 8 { l 0 }\ndata $net_name_llhttp_get_http_minor = { b \"llhttp_get_http_minor\", b 0 }\n")
	qbe_output_line(output, "function w $net_llhttp_get_http_minor(l %a0) {\n@start\n %fn =l loadl $net_fn_llhttp_get_http_minor\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_fn_llhttp_get_upgrade = align 8 { l 0 }\ndata $net_name_llhttp_get_upgrade = { b \"llhttp_get_upgrade\", b 0 }\n")
	qbe_output_line(output, "function w $net_llhttp_get_upgrade(l %a0) {\n@start\n %fn =l loadl $net_fn_llhttp_get_upgrade\n %value =w call %fn(l %a0)\n ret %value\n}\ndata $net_uv_library = align 8 { l 0 }\ndata $net_http_library = align 8 { l 0 }\ndata $net_darwin = align 8 { l 0 }\ndata $net_dir = { b \"TRBN_NETWORK_LIB_DIR\", b 0 }\ndata $net_uv_darwin = { b \"/libuv.dylib\", b 0 }\ndata $net_uv_linux = { b \"/libuv.so\", b 0 }\ndata $net_http_darwin = { b \"/libllhttp.dylib\", b 0 }\ndata $net_http_linux = { b \"/libllhttp.so\", b 0 }\n")
	qbe_output_line(output, "function l $net_open(l %dir, l %suffix) {\n@start\n %length =l call $strlen(l %dir)\n %size =l add %length, 32\n %path =l call $malloc(l %size)\n %bad =w ceql %path, 0\n jnz %bad, @fail, @copy\n@copy\n %copied =l call $memcpy(l %path, l %dir, l %length)\n %tail =l add %path, %length\n %joined =l call $strcpy(l %tail, l %suffix)\n %library =l call $dlopen(l %path, w 2)\n call $free(l %path)\n ret %library\n@fail\n ret 0\n}\n")
	qbe_output_line(output, "function w $net_load() {\n@start\n %loaded =l loadl $net_uv_library\n %ready =w cnel %loaded, 0\n jnz %ready, @success, @directory\n@directory\n %dir =l call $getenv(l $net_dir)\n %missing =w ceql %dir, 0\n jnz %missing, @fail, @darwin\n@darwin\n %darwin =l call $net_open(l %dir, l $net_uv_darwin)\n %has_darwin =w cnel %darwin, 0\n jnz %has_darwin, @darwin_http, @linux\n@darwin_http\n storel 1, $net_darwin\n %darwin_http =l call $net_open(l %dir, l $net_http_darwin)\n jmp @libraries\n@linux\n storel 0, $net_darwin\n %linux =l call $net_open(l %dir, l $net_uv_linux)\n %linux_http =l call $net_open(l %dir, l $net_http_linux)\n jmp @libraries\n@libraries\n %uv =l phi @darwin_http %darwin, @linux %linux\n %http =l phi @darwin_http %darwin_http, @linux %linux_http\n %no_uv =w ceql %uv, 0\n %no_http =w ceql %http, 0\n %incomplete =w or %no_uv, %no_http\n jnz %incomplete, @unload, @symbol0\n@symbol0\n %fn0 =l call $dlsym(l %uv, l $net_name_uv_version)\n storel %fn0, $net_fn_uv_version\n %missing0 =w ceql %fn0, 0\n jnz %missing0, @unload, @symbol1\n@symbol1\n %fn1 =l call $dlsym(l %uv, l $net_name_uv_loop_size)\n storel %fn1, $net_fn_uv_loop_size\n %missing1 =w ceql %fn1, 0\n jnz %missing1, @unload, @symbol2\n@symbol2\n %fn2 =l call $dlsym(l %uv, l $net_name_uv_loop_init)\n storel %fn2, $net_fn_uv_loop_init\n %missing2 =w ceql %fn2, 0\n jnz %missing2, @unload, @symbol3\n@symbol3\n %fn3 =l call $dlsym(l %uv, l $net_name_uv_loop_close)\n storel %fn3, $net_fn_uv_loop_close\n %missing3 =w ceql %fn3, 0\n jnz %missing3, @unload, @symbol4\n@symbol4\n %fn4 =l call $dlsym(l %uv, l $net_name_uv_run)\n storel %fn4, $net_fn_uv_run\n %missing4 =w ceql %fn4, 0\n jnz %missing4, @unload, @symbol5\n@symbol5\n %fn5 =l call $dlsym(l %uv, l $net_name_uv_stop)\n storel %fn5, $net_fn_uv_stop\n %missing5 =w ceql %fn5, 0\n jnz %missing5, @unload, @symbol6\n@symbol6\n %fn6 =l call $dlsym(l %uv, l $net_name_uv_handle_size)\n storel %fn6, $net_fn_uv_handle_size\n %missing6 =