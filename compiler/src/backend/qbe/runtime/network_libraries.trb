	qbe_output_line(output, "function w $net_uv_ip4_addr(l %a0, w %a1, l %a2) {\n@start\n %fn =l loadl $net_fn_uv_ip4_addr\n %value =w call %fn(l %a0, w %a1, l %a2)\n ret %value\n}\ndata $net_fn_uv_ip6_addr = align 8 { l 0 }\ndata $net_name_uv_ip6_addr = { b \"uv_ip6_addr\", b 0 }\n")
