	qbe_output_line(output, "function $net_uv_stop(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_stop\n call %fn(l %a0)\n ret\n}\ndata $net_fn_uv_handle_size = align 8 { l 0 }\ndata $net_name_uv_handle_size = { b \"uv_handle_size\", b 0 }\n")
	qbe_output_line(output, "function l $net_uv_handle_size(w %a0) {\n@start\n %fn =l loadl $net_fn_uv_handle_size\n %value =l call %fn(w %a0)\n ret %value\n}\ndata $net_fn_uv_req_size = align 8 { l 0 }\ndata $net_name_uv_req_size = { b \"uv_req_size\", b 0 }\n")
	qbe_output_line(output, "function l $net_uv_req_size(w %a0) {\n@start\n %fn =l loadl $net_fn_uv_req_size\n %value =l call %fn(w %a0)\n ret %value\n}\ndata $net_fn_uv_handle_get_data = align 8 { l 0 }\ndata $net_name_uv_handle_get_data = { b \"uv_handle_get_data\", b 0 }\n")
	qbe_output_line(output, "function l $net_uv_handle_get_data(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_handle_get_data\n %value =l call %fn(l %a0)\n ret %value\n}\ndata $net_fn_uv_handle_set_data = align 8 { l 0 }\ndata $net_name_uv_handle_set_data = { b \"uv_handle_set_data\", b 0 }\n")
	qbe_output_line(output, "function $net_uv_handle_set_data(l %a0, l %a1) {\n@start\n %fn =l loadl $net_fn_uv_handle_set_data\n call %fn(l %a0, l %a1)\n ret\n}\ndata $net_fn_uv_req_get_data = align 8 { l 0 }\ndata $net_name_uv_req_get_data = { b \"uv_req_get_data\", b 0 }\n")
	qbe_output_line(output, "function l $net_uv_req_get_data(l %a0) {\n@start\n %fn =l loadl $net_fn_uv_req_get_data\n %value =l call %fn(l %a0)\n ret %value\n}\ndata $net_fn_uv_req_set_data = align 8 { l 0 }\ndata $net_name_uv_req_set_data = { b \"uv_req_set_data\", b 0 }\n")
	qbe_output_line(output, "function $net_uv_req_set_data(l %a0, l %a1) {\n@start\n %fn =l loadl $net_fn_uv_req_set_data\n call %fn(l %a0, l %a1)\n ret\n}\ndata $net_fn_uv_tcp_init = align 8 { l 0 }\ndata $net_name_uv_tcp_init = { b \"uv_tcp_init\", b 0 }\n")
	qbe_output_line(output, "function w $net_uv_tcp_init(l %a0, l %a1) {\n@start\n %fn =l loadl $net_fn_uv_tcp_init\n %value =w call %fn(l %a0, l %a1)\n ret %value\n}\ndata $net_fn_uv_tcp_bind = align 8 { l 0 }\ndata $net_name_uv_tcp_bind = { b \"uv_tcp_bind\", b 0 }\n")
