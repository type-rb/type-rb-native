import { QbeOutput, qbe_output_line } from backend/qbe/output

# Bounded streaming adapter to pinned zlib. No managed allocation in callbacks.
def emit_oidc_gzip(mut output: QbeOutput)
	qbe_output_line(output, "function w $oidc_headers_done(l %data, l %size, l %context) {\n@start\n %one =w ceql %size, 1\n %two =w ceql %size, 2\n %short =w or %one, %two\n jnz %short, @blank, @continue\n@blank\n %first =w loadub %data\n %cr =w ceqw %first, 13\n %lf =w ceqw %first, 10\n %blank =w or %cr, %lf\n jnz %blank, @status, @continue\n@status\n %statusp =l add %context, 24\n %status =l loadl %statusp\n %interim =w csltl %status, 200\n %ok =w ceql %status, 200\n %a =w or %interim, %ok\n %r1 =w ceql %status, 301\n %r2 =w ceql %status, 302\n %r3 =w ceql %status, 303\n %r4 =w ceql %status, 307\n %r5 =w ceql %status, 308\n %b =w or %r1, %r2\n %c =w or %r3, %r4\n %d =w or %a, %b\n %e =w or %c, %r5\n %wait =w or %d, %e\n jnz %wait, @continue, @stop\n@stop\n %stopp =l add %context, 56\n storel 1, %stopp\n ret 1\n@continue\n ret 0\n}\nfunction w $oidc_gzip_header(l %stream, l %header) {\n@start\n call $memset(l %header, w 0, l 1104)\n %name =l add %header, 80\n %comment =l add %header, 592\n %namep =l add %header, 40\n %namesizep =l add %header, 48\n %commentp =l add %header, 56\n %commentsizep =l add %header, 64\n storel %name, %namep\n storew 512, %namesizep\n storel %comment, %commentp\n storew 512, %commentsizep\n %result =w call $inflateGetHeader(l %stream, l %header)\n ret %result\n}\nfunction w $oidc_gzip_header_valid(l %header) {\n@start\n %namep =l add %header, 40\n %name =l loadl %namep\n jnz %name, @name, @comment\n@name\n %end =l call $memchr(l %name, w 0, l 512)\n jnz %end, @comment, @invalid\n@comment\n %commentp =l add %header, 56\n %comment =l loadl %commentp\n jnz %comment, @comment_end, @valid\n@comment_end\n %end2 =l call $memchr(l %comment, w 0, l 512)\n jnz %end2, @valid, @invalid\n@valid\n ret 1\n@invalid\n ret 0\n}\ndata $oidc_content_encoding = { b \"Content-Encoding:\", b 0 }\ndata $oidc_zlib_version = { b \"1.3.2\", b 0 }\n# Preserve the first Content-Encoding value and recognize only gzip. Other\n# encodings stay opaque, as in the reference HTTP client's automatic decoding.\nfunction $oidc_encoding(l %data, l %length, l %context) {\n@start\n %flagp =l add %context, 32\n %flag =l loadl %flagp\n %enough =w cugel %length, 18\n %unseen =w ceql %flag, 0\n %inspect =w and %enough, %unseen\n jnz %inspect, @name, @done\n@name\n %name =w call $strncasecmp(l %data, l $oidc_content_encoding, l 17)\n %match =w ceqw %name, 0\n jnz %match, @prepare, @done\n@prepare\n storel 2, %flagp\n %begin =l add %data, 17\n %finish =l add %data, %length\n jmp @leading\n@leading\n %cursor =l phi @prepare %begin, @skip %next\n %within =w cultl %cursor, %finish\n jnz %within, @space, @done\n@space\n %character =w loadub %cursor\n %sp =w ceqw %character, 32\n %tab =w ceqw %character, 9\n %blank =w or %sp, %tab\n jnz %blank, @skip, @trailing\n@skip\n %next =l add %cursor, 1\n jmp @leading\n@trailing\n %end =l phi @space %finish, @trim %previous\n %nonempty =w cugtl %end, %cursor\n jnz %nonempty, @last, @done\n@last\n %previous =l sub %end, 1\n %last =w loadub %previous\n %space =w ceqw %last, 32\n %tab =w ceqw %last, 9\n %cr =w ceqw %last, 13\n %lf =w ceqw %last, 10\n %a =w or %space, %tab\n %b =w or %cr, %lf\n %trim =w or %a, %b\n jnz %trim, @trim, @value\n@trim\n jmp @trailing\n@value\n %size =l sub %end, %cursor\n %four =w ceql %size, 4\n jnz %four, @gzip, @done\n@gzip\n %gzip =w call $strncasecmp(l %cursor, l $trbn_oidc_gzip, l 4)\n %yes =w ceqw %gzip, 0\n jnz %yes, @mark, @done\n@mark\n storel 1, %flagp\n jmp @done\n@done\n ret\n}\nfunction l $oidc_inflate(l %data, l %length, l %context) {\n@start\n %small =w culel %length, 4294967295\n jnz %small, @prepare, @failed\n@failed\n ret 0\n@prepare\n %statep =l add %context, 40\n %streamp =l add %context, 48\n %stream =l loadl %streamp\n %headerp =l add %context, 64\n %header =l loadl %headerp\n %state =l loadl %statep\n %active =w cnel %state, 0\n jnz %active, @input, @initialize\n@initialize\n %init =w call $inflateInit2_(l %stream, w 31, l $oidc_zlib_version, w 112)\n jnz %init, @failed, @ready\n@ready\n storel 1, %statep\n %header_init =w call $oidc_gzip_header(l %stream, l %header)\n jnz %header_init, @failed, @input\n@input\n storel %data, %stream\n %availablep =l add %stream, 8\n storew %length, %availablep\n %outp =l add %stream, 24\n %outsizep =l add %stream, 32\n %lengthp =l add %context, 8\n jmp @loop\n@loop\n %current_state =l loadl %statep\n %ended =w ceql %current_state, 2\n jnz %ended, @reset, @output\n@reset\n %reset =w call $inflateReset(l %stream)\n jnz %reset, @failed, @reset_done\n@reset_done\n storel 1, %statep\n %header_reset =w call $oidc_gzip_header(l %stream, l %header)\n jnz %header_reset, @failed, @output\n@output\n %before_input =l loaduw %availablep\n %used =l loadl %lengthp\n %remaining =l sub 1048577, %used\n %buffer =l loadl %context\n %output =l add %buffer, %used\n storel %output, %outp\n storew %remaining, %outsizep\n %result =w call $inflate(l %stream, w 0)\n %valid_header =w call $oidc_gzip_header_valid(l %header)\n jnz %valid_header, @bounded, @failed\n@bounded\n %left =l loaduw %outsizep\n %written =l sub %remaining, %left\n %total =l add %used, %written\n storel %total, %lengthp\n %large =w cugtl %total, 1048576\n jnz %large, @large, @status\n@large\n %overflowp =l add %context, 16\n storel 1, %overflowp\n ret 0\n@status\n %finished =w ceqw %result, 1\n jnz %finished, @mark_finished, @more\n@mark_finished\n storel 2, %statep\n jmp @pending\n@more\n %ok =w ceqw %result, 0\n %needs_data =w ceqw %result, -5\n %continue =w or %ok, %needs_data\n jnz %continue, @pending, @failed\n@pending\n %available =l loaduw %availablep\n jnz %available, @progress, @done\n@progress\n %consumed =w cnel %available, %before_input\n %produced =w cnel %written, 0\n %progress =w or %consumed, %produced\n %finished_progress =w or %progress, %finished\n jnz %finished_progress, @loop, @failed\n@done\n ret %length\n}\nfunction $oidc_inflate_cleanup(l %context) {\n@start\n %statep =l add %context, 40\n %state =l loadl %statep\n jnz %state, @release, @done\n@release\n %streamp =l add %context, 48\n %stream =l loadl %streamp\n %freed =w call $inflateEnd(l %stream)\n jmp @done\n@done\n ret\n}\n")
end
