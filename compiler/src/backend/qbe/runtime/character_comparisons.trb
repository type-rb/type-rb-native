import { QbeOutput, qbe_output_line } from backend/qbe/output

# Index failure stays at the producer. The result is a Boolean, never an
# interior pointer or a temporary String; this adapter cannot collect.
def emit_character_comparison_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_character_replacement = { b 239, b 191, b 189 }")
	qbe_output_line(output, "function l $trbn_string_index_equal(l %string, l %requested, l %pattern) {\n@start\n %points_address =l add %string, 16\n %points =l loadl %points_address\n %negative =w csltl %requested, 0\n jnz %negative, @negative, @check\n@negative\n %adjusted =l add %points, %requested\n jmp @bounds\n@check\n jmp @bounds\n@bounds\n %index =l phi @negative %adjusted, @check %requested\n %below =w csltl %index, 0\n %above =w cslel %points, %index\n %invalid =w or %below, %above\n jnz %invalid, @fail, @load\n@fail\n call $trbn_fail(l $trbn_bounds_error, l 30)\n hlt\n@load\n %offset =l call $trbn_string_offset(l %string, l %index)\n %data =l add %string, 24\n %address =l add %data, %offset\n %character =w loadub %address\n %pattern_length_address =l add %pattern, 8\n %pattern_length =l loadl %pattern_length_address\n %pattern_data =l add %pattern, 24\n %ascii =w cultw %character, 128\n jnz %ascii, @ascii, @unicode\n@ascii\n %single =w ceql %pattern_length, 1\n jnz %single, @ascii_compare, @different\n@ascii_compare\n %pattern_character =w loadub %pattern_data\n %ascii_equal =w ceqw %character, %pattern_character\n %ascii_result =l extuw %ascii_equal\n ret %ascii_result\n@unicode\n %length_address =l add %string, 8\n %length =l loadl %length_address\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %valid =w csgtl %width, 1\n jnz %valid, @valid, @replacement\n@valid\n jmp @compare_length\n@replacement\n jmp @compare_length\n@compare_length\n %expected_length =l phi @valid %width, @replacement 3\n %expected_data =l phi @valid %address, @replacement $trbn_character_replacement\n %same_length =w ceql %expected_length, %pattern_length\n jnz %same_length, @compare, @different\n@compare\n %comparison =w call $memcmp(l %expected_data, l %pattern_data, l %expected_length)\n %equal =w ceqw %comparison, 0\n %result =l extuw %equal\n ret %result\n@different\n ret 0\n}")
end
