import { QbeOutput, qbe_output_line } from backend/qbe/output

def emit_oidc_uri(mut output: QbeOutput)
	qbe_output_line(output, "# URL and numeric-address parsing is mechanical; policy stays in TypeRB.\nfunction l $trbn_oidc_describe_uri(l %uri, l %output) {\n@start\n %lenp =l add %output, 8\n %len =l loadl %lenp\n %valid =w ceql %len, 3\n jnz %valid, @allocate, @invalid\n@invalid\n ret 0\n@allocate\n %handle =l call $curl_url()\n jnz %handle, @prepare, @invalid\n@prepare\n %slots =l alloc8 24\n call $memset(l %slots, w 0, l 24)\n %hostp =l add %slots, 8\n %portp =l add %slots, 16\n %data =l add %uri, 24\n %sizep =l add %uri, 8\n %size =l loadl %sizep\n %clength =l call $strlen(l %data)\n %no_nul =w ceql %size, %clength\n jnz %no_nul, @parse, @failed\n@parse\n %set =w call $curl_url_set(l %handle, w 0, l %data, w 8)\n jnz %set, @failed, @parts\n@parts\n %scheme =w call $curl_url_get(l %handle, w 1, l %slots, w 0)\n %host =w call $curl_url_get(l %handle, w 5, l %hostp, w 0)\n %port =w call $curl_url_get(l %handle, w 6, l %portp, w 1)\n %bad =w or %scheme, %host\n jnz %bad, @failed, @release\n@failed\n call $curl_url_cleanup(l %handle)\n jmp @cleanup\n@release\n call $curl_url_cleanup(l %handle)\n jmp @copy\n@copy\n %index =l phi @release 0, @stored %next\n %offset =l mul %index, 8\n %slot =l add %slots, %offset\n %value =l loadl %slot\n jnz %value, @text, @empty\n@text\n %length =l call $strlen(l %value)\n %copied =l call $trbn_string_from_bytes(l %value, l %length)\n jmp @store\n@empty\n %empty =l call $trbn_string_from_bytes(l $trbn_oidc_empty, l 0)\n jmp @store\n@store\n %string =l phi @text %copied, @empty %empty\n %valuesp =l add %output, 24\n %values =l loadl %valuesp\n %target =l add %values, %offset\n storel %string, %target\n jmp @stored\n@stored\n %next =l add %index, 1\n %more =w csltl %next, 3\n jnz %more, @copy, @cleanup\n@cleanup\n %success =l phi @failed 0, @stored 1\n %s0 =l loadl %slots\n %s1 =l loadl %hostp\n %s2 =l loadl %portp\n call $curl_free(l %s0)\n call $curl_free(l %s1)\n call $curl_free(l %s2)\n ret %success\n}\nfunction d $trbn_oidc_monotonic_millis() {\n@start\n %darwin =l loadl $trbn_oidc_darwin\n %scaled =l mul %darwin, 5\n %clock =l add %scaled, 1\n %parts =l alloc8 16\n %result =w call $clock_gettime(w %clock, l %parts)\n jnz %result, @failed, @read\n@failed\n ret d_-1\n@read\n %seconds =l loadl %parts\n %nsp =l add %parts, 8\n %nanos =l loadl %nsp\n %sec =d sltof %seconds\n %ns =d sltof %nanos\n %ms =d mul %sec, d_1000\n %fraction =d div %ns, d_1000000\n %total =d add %ms, %fraction\n ret %total\n}\nfunction l $trbn_oidc_ip_address(l %address, l %output) {\n@start\n %lenp =l add %output, 8\n %length =l loadl %lenp\n %valid =w ceql %length, 16\n jnz %valid, @prepare, @invalid\n@invalid\n ret 0\n@prepare\n %data =l add %address, 24\n %sizep =l add %address, 8\n %size =l loadl %sizep\n %clength =l call $strlen(l %data)\n %no_nul =w ceql %size, %clength\n jnz %no_nul, @parse_v4, @invalid\n@parse_v4\n %bytes =l alloc8 16\n call $memset(l %bytes, w 0, l 16)\n %v4 =w call $inet_pton(w 2, l %data, l %bytes)\n %yes4 =w ceqw %v4, 1\n jnz %yes4, @copy, @parse_v6\n@parse_v6\n %darwin =l loadl $trbn_oidc_darwin\n %scaled =l mul %darwin, 20\n %family =l add %scaled, 10\n %v6 =w call $inet_pton(w %family, l %data, l %bytes)\n %yes6 =w ceqw %v6, 1\n jnz %yes6, @copy, @invalid\n@copy\n %width =l phi @parse_v4 4, @parse_v6 16\n %valuesp =l add %output, 24\n %values =l loadl %valuesp\n jmp @item\n@item\n %index =l phi @copy 0, @item %next\n %source =l add %bytes, %index\n %byte =l loadub %source\n %offset =l mul %index, 8\n %slot =l add %values, %offset\n storel %byte, %slot\n %next =l add %index, 1\n %more =w csltl %next, 16\n jnz %more, @item, @done\n@done\n ret %width\n}\n")
	qbe_output_line(output, "function l $trbn_oidc_environment(l %name) {\n@start\n %data =l add %name, 24\n %value =l call $oidc_environment(l %data)\n jnz %value, @value, @empty\n@value\n %length =l call $strlen(l %value)\n %copy =l call $trbn_string_from_bytes(l %value, l %length)\n ret %copy\n@empty\n %empty =l call $trbn_string_from_bytes(l $trbn_oidc_empty, l 0)\n ret %empty\n}\n")
end
