import { emit_oidc_gzip } from backend/qbe/runtime/oidc_gzip
import { emit_oidc_uri } from backend/qbe/runtime/oidc_uri
import { emit_oidc_trust } from backend/qbe/runtime/oidc_trust
import { oidc_adapter_start, oidc_names } from mir/model/oidc_contract
import { mir_signature_standard } from mir/model/call_kinds
import { MirModule } from mir/model/module
import { QbeOutput, qbe_output_line } from backend/qbe/output

def oidc_runtime_needed(native_module: MirModule): Boolean
	mut needed := false
	native_module.signatures.each do |signature|
		if signature.kind == mir_signature_standard() && signature.adapter >= oidc_adapter_start() && signature.adapter < oidc_adapter_start() + oidc_names().size()
			needed = true
		end
	end
	return needed
end

# No managed allocation or callback occurs while EVP owns these resources.
# Zero-initialized slots give every success/failure edge one cleanup path.
def emit_oidc_rsa(mut output: QbeOutput)
	qbe_output_line(output, "function d $trbn_oidc_timestamp(d %value) {\n@start\n %integer =l dtosi %value\n %number =d sltof %integer\n ret %number\n}\n")
	qbe_output_line(output, "data $trbn_oidc_rsa_name = { b \"RSA\", b 0 }\ndata $trbn_oidc_sha256 = { b \"SHA256\", b 0 }\ndata $trbn_oidc_modulus = { b \"n\", b 0 }\ndata $trbn_oidc_exponent = { b \"e\", b 0 }\nfunction l $trbn_oidc_verify_rs256(l %modulus, l %exponent, l %message, l %signature) {\n@start\n %slots =l alloc8 64\n call $memset(l %slots, w 0, l 64)\n %ns =l add %slots, 8\n %es =l add %slots, 16\n %bs =l add %slots, 24\n %ps =l add %slots, 32\n %cs =l add %slots, 40\n %ms =l add %slots, 48\n %rs =l add %slots, 56\n %initialized =w call $OPENSSL_init_crypto(l 128, l 0)\n jnz %initialized, @modulus, @cleanup\n@modulus\n %nlp =l add %modulus, 8\n %nlen =l loadl %nlp\n %nfits =w cultl %nlen, 2147483648\n jnz %nfits, @make_n, @cleanup\n@make_n\n %ndata =l add %modulus, 24\n %n =l call $BN_bin2bn(l %ndata, w %nlen, l 0)\n storel %n, %ns\n jnz %n, @exponent, @cleanup\n@exponent\n %elp =l add %exponent, 8\n %elen =l loadl %elp\n %edata =l add %exponent, 24\n %e =l call $BN_bin2bn(l %edata, w %elen, l 0)\n storel %e, %es\n jnz %e, @builder, @cleanup\n@builder\n %builder =l call $OSSL_PARAM_BLD_new()\n storel %builder, %bs\n jnz %builder, @push_n, @cleanup\n@push_n\n %np =w call $OSSL_PARAM_BLD_push_BN(l %builder, l $trbn_oidc_modulus, l %n)\n jnz %np, @push_e, @cleanup\n@push_e\n %ep =w call $OSSL_PARAM_BLD_push_BN(l %builder, l $trbn_oidc_exponent, l %e)\n jnz %ep, @parameters, @cleanup\n@parameters\n %parameters =l call $OSSL_PARAM_BLD_to_param(l %builder)\n storel %parameters, %ps\n jnz %parameters, @context, @cleanup\n@context\n %context =l call $EVP_PKEY_CTX_new_from_name(l 0, l $trbn_oidc_rsa_name, l 0)\n storel %context, %cs\n jnz %context, @from_init, @cleanup\n@from_init\n %fi =w call $EVP_PKEY_fromdata_init(l %context)\n %fok =w csgtw %fi, 0\n jnz %fok, @from_data, @cleanup\n@from_data\n %made =w call $EVP_PKEY_fromdata(l %context, l %slots, w 134, l %parameters)\n %made_ok =w csgtw %made, 0\n jnz %made_ok, @digest_context, @cleanup\n@digest_context\n %md =l call $EVP_MD_CTX_new()\n storel %md, %ms\n jnz %md, @verify_init, @cleanup\n@verify_init\n %key =l loadl %slots\n %pkctx =l alloc8 8\n storel 0, %pkctx\n %vi =w call $EVP_DigestVerifyInit_ex(l %md, l %pkctx, l $trbn_oidc_sha256, l 0, l 0, l %key, l 0)\n %vi_ok =w ceqw %vi, 1\n jnz %vi_ok, @padding, @cleanup\n@padding\n %verification =l loadl %pkctx\n %padding =w call $EVP_PKEY_CTX_set_rsa_padding(l %verification, w 1)\n %padding_ok =w csgtw %padding, 0\n jnz %padding_ok, @verify, @cleanup\n@verify\n %slp =l add %signature, 8\n %slen =l loadl %slp\n %sdata =l add %signature, 24\n %mlp =l add %message, 8\n %mlen =l loadl %mlp\n %mdata =l add %message, 24\n %verified =w call $EVP_DigestVerify(l %md, l %sdata, l %slen, l %mdata, l %mlen)\n %valid =w ceqw %verified, 1\n %result =l extuw %valid\n storel %result, %rs\n jmp @cleanup\n@cleanup\n %free_md =l loadl %ms\n call $EVP_MD_CTX_free(l %free_md)\n %free_key =l loadl %slots\n call $EVP_PKEY_free(l %free_key)\n %free_context =l loadl %cs\n call $EVP_PKEY_CTX_free(l %free_context)\n %free_parameters =l loadl %ps\n call $OSSL_PARAM_free(l %free_parameters)\n %free_builder =l loadl %bs\n call $OSSL_PARAM_BLD_free(l %free_builder)\n %free_n =l loadl %ns\n call $BN_free(l %free_n)\n %free_e =l loadl %es\n call $BN_free(l %free_e)\n call $ERR_clear_error()\n %answer =l loadl %rs\n ret %answer\n}\n")
end

# Foreign callbacks touch only bounded raw storage. Handles are closed before
# copying results into rooted managed output slots.
def emit_oidc_fetch(mut output: QbeOutput)
	emit_oidc_trust(output)
	emit_oidc_uri(output)
	emit_oidc_gzip(output)
	qbe_output_line(output, "data $trbn_oidc_incomplete_gzip = { b \"unexpected end of gzip response\", b 0 }\ndata $trbn_oidc_empty = { b 0 }\ndata $trbn_oidc_global = align 8 { l 0 }\ndata $trbn_oidc_protocols = { b \"http,https\", b 0 }\ndata $trbn_oidc_gzip = { b \"gzip\", b 0 }\ndata $trbn_oidc_agent = { b \"Go-http-client/1.1\", b 0 }\ndata $trbn_oidc_http = { b \"HTTP/\", b 0 }\ndata $trbn_oidc_provider_error = { b \"HTTP provider failed\", b 0 }\ndata $trbn_oidc_cert_file = { b \"SSL_CERT_FILE\", b 0 }\ndata $trbn_oidc_cert_dir = { b \"SSL_CERT_DIR\", b 0 }\nfunction w $oidc_setopt(l %handle, w %option, l %value) {\n@start\n %result =w call $curl_easy_setopt(l %handle, w %option, ..., l %value)\n ret %result\n}\nfunction l $oidc_write(l %data, l %size, l %count, l %context) {\n@start\n %total =l mul %size, %count\n %statusp =l add %context, 24\n %status =l loadl %statusp\n %wanted =w ceql %status, 200\n jnz %wanted, @encoding, @discard\n@encoding\n %encodingp =l add %context, 32\n %encoding =l loadl %encodingp\n %gzip =w ceql %encoding, 1\n jnz %gzip, @inflate, @length\n@inflate\n %written =l call $oidc_inflate(l %data, l %total, l %context)\n ret %written\n@discard\n ret %total\n@length\n %lengthp =l add %context, 8\n %length =l loadl %lengthp\n %remaining =l sub 1048576, %length\n %fits =w culel %total, %remaining\n jnz %fits, @copy, @large\n@large\n %overflow =l add %context, 16\n storel 1, %overflow\n ret 0\n@copy\n %buffer =l loadl %context\n %destination =l add %buffer, %length\n call $memcpy(l %destination, l %data, l %total)\n %next =l add %length, %total\n storel %next, %lengthp\n ret %total\n}\nfunction l $oidc_header(l %data, l %size, l %count, l %context) {\n@start\n %total =l mul %size, %count\n %stop =w call $oidc_headers_done(l %data, l %total, l %context)\n jnz %stop, @stop, @encoding\n@stop\n ret 0\n@encoding\n call $oidc_encoding(l %data, l %total, l %context)\n %enough =w cugel %total, 12\n jnz %enough, @prefix, @done\n@prefix\n %prefix =w call $strncmp(l %data, l $trbn_oidc_http, l 5)\n %http =w ceqw %prefix, 0\n jnz %http, @code, @done\n@code\n %space =l call $memchr(l %data, w 32, l %total)\n jnz %space, @offset, @done\n@offset\n %offset =l sub %space, %data\n %remaining =l sub %total, %offset\n %safe =w cugel %remaining, 5\n jnz %safe, @parse, @done\n@parse\n %start =l add %space, 1\n %c0 =l loadub %start\n %p1 =l add %start, 1\n %c1 =l loadub %p1\n %p2 =l add %start, 2\n %c2 =l loadub %p2\n %v0 =l mul %c0, 100\n %v1 =l mul %c1, 10\n %sum =l add %v0, %v1\n %total_code =l add %sum, %c2\n %status =l sub %total_code, 5328\n %statusp =l add %context, 24\n storel %status, %statusp\n %encodingp =l add %context, 32\n storel 0, %encodingp\n %lengthp =l add %context, 8\n storel 0, %lengthp\n@done\n ret %total\n}\nfunction l $oidc_copy_bytes(l %data, l %length) {\n@start\n %size =l add %length, 17\n %result =l call $trbn_string_alloc(l %size)\n %lengthp =l add %result, 8\n %countp =l add %result, 16\n storel %length, %lengthp\n storel %length, %countp\n %destination =l add %result, 24\n jnz %length, @copy, @terminate\n@copy\n call $memcpy(l %destination, l %data, l %length)\n jmp @terminate\n@terminate\n %end =l add %destination, %length\n storeb 0, %end\n ret %result\n}\nfunction l $trbn_oidc_fetch(l %uri, l %proxy, l %timeout, l %output) {\n@start\n %lengthp =l add %output, 8\n %length =l loadl %lengthp\n %valid =w ceql %length, 3\n jnz %valid, @prepare, @invalid\n@invalid\n ret -1\n@prepare\n %context =l alloc8 72\n call $memset(l %context, w 0, l 72)\n %gzip_header =l alloc8 1104\n %gzip_headerp =l add %context, 64\n storel %gzip_header, %gzip_headerp\n %stream =l alloc8 112\n call $memset(l %stream, w 0, l 112)\n %streamp =l add %context, 48\n storel %stream, %streamp\n %statusp =l add %context, 24\n storel -1, %statusp\n %error =l alloc8 256\n call $memset(l %error, w 0, l 256)\n call $strcpy(l %error, l $trbn_oidc_provider_error)\n %handlep =l alloc8 8\n storel 0, %handlep\n %redirectp =l alloc8 8\n storel 0, %redirectp\n %body =l call $malloc(l 1048577)\n storel %body, %context\n jnz %body, @initialize, @copy_result\n@initialize\n %crypto_marker =w loadub $trbn_crypto_build_identity\n %oidc_marker =w loadub $trbn_oidc_build_identity\n %markers =w and %crypto_marker, %oidc_marker\n %marked =w ceqw %markers, 84\n jnz %marked, @global_state, @cleanup\n@global_state\n %initialized =l loadl $trbn_oidc_global\n jnz %initialized, @new_handle, @global_init\n@global_init\n %ssl =w call $OPENSSL_init_ssl(l 128, l 0)\n jnz %ssl, @curl_init, @cleanup\n@curl_init\n %curl =w call $curl_global_init(l 3)\n %curl_ok =w ceqw %curl, 0\n jnz %curl_ok, @register, @cleanup\n@register\n %registered =w call $atexit(l $curl_global_cleanup)\n %registered_ok =w ceqw %registered, 0\n jnz %registered_ok, @mark, @unregister\n@unregister\n call $curl_global_cleanup()\n jmp @cleanup\n@mark\n storel 1, $trbn_oidc_global\n jmp @new_handle\n@new_handle\n %handle =l call $curl_easy_init()\n storel %handle, %handlep\n jnz %handle, @options, @cleanup\n@options\n %url =l add %uri, 24\n %urlsizep =l add %uri, 8\n %urlsize =l loadl %urlsizep\n %clength =l call $strlen(l %url)\n %no_nul =w ceql %urlsize, %clength\n jnz %no_nul, @configure, @cleanup\n@configure\n %o0 =w call $oidc_setopt(l %handle, w 10002, l %url)\n %o1 =w call $oidc_setopt(l %handle, w 20011, l $oidc_write)\n %o2 =w call $oidc_setopt(l %handle, w 10001, l %context)\n %o3 =w call $oidc_setopt(l %handle, w 20079, l $oidc_header)\n %o4 =w call $oidc_setopt(l %handle, w 10029, l %context)\n %o5 =w call $oidc_setopt(l %handle, w 10010, l %error)\n %o6 =w call $oidc_setopt(l %handle, w 52, l 0)\n %o7 =w call $oidc_setopt(l %handle, w 68, l 9)\n %o8 =w call $oidc_setopt(l %handle, w 155, l %timeout)\n %o9 =w call $oidc_setopt(l %handle, w 99, l 1)\n %o10 =w call $oidc_setopt(l %handle, w 10318, l $trbn_oidc_protocols)\n %o11 =w call $oidc_setopt(l %handle, w 10319, l $trbn_oidc_protocols)\n %o12 =w call $oidc_setopt(l %handle, w 10102, l $trbn_oidc_gzip)\n %o13 =w call $oidc_setopt(l %handle, w 10018, l $trbn_oidc_agent)\n %o14 =w call $oidc_setopt(l %handle, w 32, l 6)\n %o15 =w call $oidc_setopt(l %handle, w 64, l 1)\n %o16 =w call $oidc_setopt(l %handle, w 81, l 2)\n %a0 =w or %o0, %o1\n %a1 =w or %a0, %o2\n %a2 =w or %a1, %o3\n %a3 =w or %a2, %o4\n %a4 =w or %a3, %o5\n %a5 =w or %a4, %o6\n %a6 =w or %a5, %o7\n %a7 =w or %a6, %o8\n %a8 =w or %a7, %o9\n %a9 =w or %a8, %o10\n %a10 =w or %a9, %o11\n %a11 =w or %a10, %o12\n %a12 =w or %a11, %o13\n %a13 =w or %a12, %o14\n %a14 =w or %a13, %o15\n %a15 =w or %a14, %o16\n %proxy_data =l add %proxy, 24\n %proxy_option =w call $oidc_setopt(l %handle, w 10004, l %proxy_data)\n %noproxy_option =w call $oidc_setopt(l %handle, w 10177, l $trbn_oidc_empty)\n %a16 =w or %a15, %proxy_option\n %decode_option =w call $oidc_setopt(l %handle, w 158, l 0)\n %a17 =w or %a16, %noproxy_option\n %a18 =w or %a17, %decode_option\n jnz %a18, @cleanup, @trust\n@trust\n %trust =w call $oidc_set_trust(l %handle)\n jnz %trust, @cleanup, @perform\n@perform\n storeb 0, %error\n %performed =w call $curl_easy_perform(l %handle)\n %overflowp =l add %context, 16\n %overflow =l loadl %overflowp\n jnz %overflow, @too_large, @performed\n@too_large\n storel -2, %statusp\n jmp @cleanup\n@performed\n %stopp =l add %context, 56\n %stopped =l loadl %stopp\n jnz %stopped, @response, @normal\n@normal\n jnz %performed, @request_error, @gzip_complete\n@gzip_complete\n %gzip_flagp =l add %context, 32\n %gzip_flag =l loadl %gzip_flagp\n %gzip_flagged =w ceql %gzip_flag, 1\n %http_status =l loadl %statusp\n %http_ok =w ceql %http_status, 200\n %needs_gzip =w and %gzip_flagged, %http_ok\n jnz %needs_gzip, @gzip_state, @response\n@gzip_state\n %gzip_statep =l add %context, 40\n %gzip_state =l loadl %gzip_statep\n %gzip_finished =w ceql %gzip_state, 2\n jnz %gzip_finished, @response, @gzip_incomplete\n@gzip_incomplete\n storel -1, %statusp\n call $strcpy(l %error, l $trbn_oidc_incomplete_gzip)\n jmp @cleanup\n@request_error\n storel -1, %statusp\n %first =w loadub %error\n jnz %first, @cleanup, @error_text\n@error_text\n %detail =l call $curl_easy_strerror(w %performed)\n call $strncpy(l %error, l %detail, l 255)\n jmp @cleanup\n@response\n %info =w call $curl_easy_getinfo(l %handle, w 2097154, ..., l %statusp)\n jnz %info, @info_failed, @redirect\n@redirect\n %locationp =l alloc8 8\n storel 0, %locationp\n %redirection =w call $curl_easy_getinfo(l %handle, w 1048607, ..., l %locationp)\n jnz %redirection, @info_failed, @location\n@location\n %location =l loadl %locationp\n jnz %location, @copy_location, @cleanup\n@copy_location\n %location_copy =l call $strdup(l %location)\n storel %location_copy, %redirectp\n jnz %location_copy, @cleanup, @info_failed\n@info_failed\n storel -1, %statusp\n jmp @cleanup\n@cleanup\n call $oidc_inflate_cleanup(l %context)\n %to_close =l loadl %handlep\n jnz %to_close, @close, @copy_result\n@close\n call $curl_easy_cleanup(l %to_close)\n jmp @copy_result\n@copy_result\n %result_status =l loadl %statusp\n %usedp =l add %context, 8\n %used =l loadl %usedp\n %body_result =l call $oidc_copy_bytes(l %body, l %used)\n %valuesp =l add %output, 24\n %values =l loadl %valuesp\n storel %body_result, %values\n %error_length =l call $strlen(l %error)\n %error_result =l call $oidc_copy_bytes(l %error, l %error_length)\n %final_values =l loadl %valuesp\n %error_slot =l add %final_values, 8\n storel %error_result, %error_slot\n %raw_redirect =l loadl %redirectp\n jnz %raw_redirect, @redirect_text, @redirect_empty\n@redirect_text\n %redirect_length =l call $strlen(l %raw_redirect)\n %redirect_copy =l call $oidc_copy_bytes(l %raw_redirect, l %redirect_length)\n jmp @store_redirect\n@redirect_empty\n %empty_redirect =l call $oidc_copy_bytes(l $trbn_oidc_empty, l 0)\n jmp @store_redirect\n@store_redirect\n %redirect_result =l phi @redirect_text %redirect_copy, @redirect_empty %empty_redirect\n %redirect_values =l loadl %valuesp\n %redirect_slot =l add %redirect_values, 16\n storel %redirect_result, %redirect_slot\n call $free(l %raw_redirect)\n call $free(l %body)\n ret %result_status\n}\n")
end
