import { QbeOutput, qbe_output_line } from backend/qbe/output

# The compiler owns discovery and checked test selection. This adapter returns
# names only, including symbolic-link entries without traversing link targets.
# It shares the existing project exclusions and bytewise deterministic ordering.
# nftw status constants are qualified by the supported-host header probe.
def emit_test_paths_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_test_stat_failure = align 4 { w -1 }\ndata $trbn_test_darwin = { b \"Darwin\", b 0 }\ndata $trbn_test_linux = { b \"Linux\", b 0 }\n")
	qbe_output_line(output, "function w $trbn_test_walk_callback(l %path, l %stat, w %type, l %walk) {\n@start\n %excluded =w call $trbn_project_path_excluded(l %path)\n jnz %excluded, @ignore, @classify\n@classify\n %directory =w ceqw %type, 1\n jnz %directory, @ignore, @errors\n@errors\n %unknown_kind =w loadw $trbn_test_stat_failure\n %unknown =w ceqw %type, %unknown_kind\n %denied =w ceqw %type, 2\n %failed =w or %unknown, %denied\n jnz %failed, @error, @source\n@source\n %source =w call $trbn_c_ends_with(l %path, l $trbn_project_trb_suffix)\n jnz %source, @collect, @ignore\n@collect\n %owned =l call $trbn_string_from_c(l %path)\n %paths =l loadl $trbn_project_paths\n call $trbn_array_push(l %paths, l %owned)\n ret 0\n@error\n %error =l call $trbn_string_from_c(l %path)\n storel %error, $trbn_project_error\n %error_root =l add $trbn_gc_global_roots, 88\n storel %error, %error_root\n ret 1\n@ignore\n ret 0\n}")
	qbe_output_line(output, "function l $trbn_collect_test_paths(l %source_root, l %out_root) {\n@start\n %platform =l alloc8 2048\n %identified =w call $uname(l %platform)\n %identify_failed =w cnew %identified, 0\n jnz %identify_failed, @unknown, @platform\n@platform\n %apple_name =w call $strcmp(l %platform, l $trbn_test_darwin)\n %apple =w ceqw %apple_name, 0\n jnz %apple, @darwin, @linux_check\n@darwin\n storew 4, $trbn_test_stat_failure\n jmp @allocate\n@linux_check\n %linux_name =w call $strcmp(l %platform, l $trbn_test_linux)\n %linux =w ceqw %linux_name, 0\n jnz %linux, @linux, @unknown\n@linux\n storew 3, $trbn_test_stat_failure\n jmp @allocate\n@unknown\n storew -1, $trbn_test_stat_failure\n jmp @allocate\n@allocate\n\t%paths =l call $trbn_array_new(l $trbn_desc_array_managed)\n\t%paths_root =l add $trbn_gc_global_roots, 64\n\tstorel %paths, %paths_root\n\t%sources =l call $trbn_array_new(l $trbn_desc_array_managed)\n\t%sources_root =l add $trbn_gc_global_roots, 72\n\tstorel %sources, %sources_root\n\t%result =l call $trbn_gc_alloc(l $trbn_desc_project_sources, l 24, l 0)\n\t%result_root =l add $trbn_gc_global_roots, 80\n\tstorel %result, %result_root\n\t%paths_slot =l add %result, 8\n\tstorel %paths, %paths_slot\n\t%sources_slot =l add %result, 16\n\tstorel %sources, %sources_slot\n\t%error_slot =l add %result, 24\n\tstorel $trbn_project_empty_string, %error_slot\n\tstorel %paths, $trbn_project_paths\n\tstorel 0, $trbn_project_error\n\t%error_root =l add $trbn_gc_global_roots, 88\n\tstorel 0, %error_root\n\t%source_data =l add %source_root, 24\n\t%out_data =l add %out_root, 24\n\tstorel %source_data, $trbn_project_source_root\n\tstorel %out_data, $trbn_project_out_root\n\t%unknown_kind =w loadw $trbn_test_stat_failure\n\t%unsupported =w ceqw %unknown_kind, -1\n\tjnz %unsupported, @root_failed, @walk\n@walk\n\t%walk_status =w call $nftw(l %source_data, l $trbn_test_walk_callback, w 32, w 1)\n\t%walk_error =l loadl $trbn_project_error\n\t%callback_failed =w cnel %walk_error, 0\n\tjnz %callback_failed, @failed, @walk_result\n@walk_result\n\t%walk_failed =w cnew %walk_status, 0\n\tjnz %walk_failed, @root_failed, @sort\n@root_failed\n\tstorel %source_root, %error_slot\n\tret %result\n@failed\n\tstorel %walk_error, %error_slot\n\tret %result\n@sort\n\t%path_count_address =l add %paths, 8\n\t%path_count =l loadl %path_count_address\n\t%multiple =w csltl 1, %path_count\n\tjnz %multiple, @sort_paths, @read_start\n@sort_paths\n\t%paths_data_slot =l add %paths, 24\n\t%paths_data =l loadl %paths_data_slot\n\tcall $qsort(l %paths_data, l %path_count, l 8, l $trbn_project_path_compare)\n\tjmp @read_start\n@read_start\n\tret %result\n}")
end
