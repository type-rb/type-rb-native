import { QbeOutput, qbe_output_line } from backend/qbe/output

# Explicit argv paths use the same build-time installation as the compiler.
def emit_crypto_link_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_crypto_link_required = align 8 { l 0 }\ndata $trbn_crypto_link_directory = { b \"TRBN_CRYPTO_LIB_DIR\", b 0 }\ndata $trbn_crypto_link_relative = { b \"/crypto\", b 0 }\ndata $trbn_crypto_link_library = { b \"/libcrypto.a\", b 0 }\ndata $trbn_crypto_link_identity = { b \"/crypto-identity.o\", b 0 }\ndata $trbn_crypto_link_error = { b \"compiler: pinned static cryptography library is missing; install crypto beside QBE or set TRBN_CRYPTO_LIB_DIR\", b 10, b 0 }\nfunction $trbn_set_crypto_link(l %needed) {\n@start\n storel %needed, $trbn_crypto_link_required\n ret\n}\nfunction l $trbn_crypto_link_arguments(l %tail, l %qbe) {\n@start\n %needed =l loadl $trbn_crypto_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @directory, @unchanged\n@unchanged\n ret %tail\n@directory\n %library_slot =l add %tail, 8\n %identity_slot =l add %tail, 16\n storel 0, %library_slot\n storel 0, %identity_slot\n %root =l call $trbn_link_directory(l $trbn_crypto_link_directory, l %qbe, l $trbn_crypto_link_relative)\n jmp @resolved\n@resolved\n %root_nonzero =w cnel %root, 0\n jnz %root_nonzero, @paths, @failed\n@paths\n %library =l call $trbn_link_path(l %root, l $trbn_crypto_link_library)\n %identity =l call $trbn_link_path(l %root, l $trbn_crypto_link_identity)\n call $free(l %root)\n storel %library, %library_slot\n storel %identity, %identity_slot\n %no_library =w ceql %library, 0\n %no_identity =w ceql %identity, 0\n %missing =w or %no_library, %no_identity\n jnz %missing, @failed, @readable\n@readable\n %library_status =w call $trbn_link_access(l %library)\n %identity_status =w call $trbn_link_access(l %identity)\n %status =w or %library_status, %identity_status\n jnz %status, @failed, @arguments\n@arguments\n storel $trbn_network_link_input, %tail\n %linux =l loadl $trbn_project_selected_linker\n %linux_nonzero =w cnel %linux, 0\n jnz %linux_nonzero, @linux, @darwin\n@linux\n %pthread_slot =l add %tail, 24\n storel $trbn_network_link_pthread, %pthread_slot\n %dl_slot =l add %tail, 32\n storel $trbn_network_link_dl, %dl_slot\n %linux_tail =l add %tail, 40\n ret %linux_tail\n@darwin\n %darwin_tail =l add %tail, 24\n ret %darwin_tail\n@failed\n call $trbn_crypto_link_cleanup(l %tail)\n %length =l call $strlen(l $trbn_crypto_link_error)\n call $write(w 2, l $trbn_crypto_link_error, l %length)\n ret 0\n}\nfunction $trbn_crypto_link_cleanup(l %tail) {\n@start\n %needed =l loadl $trbn_crypto_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @release, @done\n@release\n %library_slot =l add %tail, 8\n %library =l loadl %library_slot\n call $free(l %library)\n %identity_slot =l add %tail, 16\n %identity =l loadl %identity_slot\n call $free(l %identity)\n@done\n ret\n}\n")
end
