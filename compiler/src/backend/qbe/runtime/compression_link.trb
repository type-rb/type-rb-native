import { QbeOutput, qbe_output_line } from backend/qbe/output

# Explicit argv paths use the same build-time installation as the compiler.
def emit_compression_link_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_compression_link_required = align 8 { l 0 }\ndata $trbn_compression_link_directory = { b \"TRBN_COMPRESSION_LIB_DIR\", b 0 }\ndata $trbn_compression_link_relative = { b \"/compression\", b 0 }\ndata $trbn_compression_link_library = { b \"/libdeflate.a\", b 0 }\ndata $trbn_compression_link_identity = { b \"/compression-identity.o\", b 0 }\ndata $trbn_compression_link_error = { b \"compiler: pinned static gzip library is missing; install compression beside QBE or set TRBN_COMPRESSION_LIB_DIR\", b 10, b 0 }\nfunction $trbn_set_compression_link(l %needed) {\n@start\n storel %needed, $trbn_compression_link_required\n ret\n}\nfunction l $trbn_compression_link_arguments(l %tail, l %qbe) {\n@start\n %needed =l loadl $trbn_compression_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @directory, @unchanged\n@unchanged\n ret %tail\n@directory\n %library_slot =l add %tail, 8\n %identity_slot =l add %tail, 16\n storel 0, %library_slot\n storel 0, %identity_slot\n %root =l call $trbn_link_directory(l $trbn_compression_link_directory, l %qbe, l $trbn_compression_link_relative)\n jmp @resolved\n@resolved\n %root_nonzero =w cnel %root, 0\n jnz %root_nonzero, @paths, @failed\n@paths\n %library =l call $trbn_link_path(l %root, l $trbn_compression_link_library)\n %identity =l call $trbn_link_path(l %root, l $trbn_compression_link_identity)\n call $free(l %root)\n storel %library, %library_slot\n storel %identity, %identity_slot\n %no_library =w ceql %library, 0\n %no_identity =w ceql %identity, 0\n %missing =w or %no_library, %no_identity\n jnz %missing, @failed, @readable\n@readable\n %library_status =w call $trbn_link_access(l %library)\n %identity_status =w call $trbn_link_access(l %identity)\n %status =w or %library_status, %identity_status\n jnz %status, @failed, @arguments\n@arguments\n storel $trbn_network_link_input, %tail\n %new_tail =l add %tail, 24\n ret %new_tail\n@failed\n call $trbn_compression_link_cleanup(l %tail)\n %length =l call $strlen(l $trbn_compression_link_error)\n call $write(w 2, l $trbn_compression_link_error, l %length)\n ret 0\n}\nfunction $trbn_compression_link_cleanup(l %tail) {\n@start\n %needed =l loadl $trbn_compression_link_required\n %needed_nonzero =w cnel %needed, 0\n jnz %needed_nonzero, @release, @done\n@release\n %library_slot =l add %tail, 8\n %library =l loadl %library_slot\n call $free(l %library)\n %identity_slot =l add %tail, 16\n %identity =l loadl %identity_slot\n call $free(l %identity)\n@done\n ret\n}\n")
end
