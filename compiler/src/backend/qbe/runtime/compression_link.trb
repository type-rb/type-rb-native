import { QbeOutput, qbe_output_line } from backend/qbe/output

# Explicit argv paths use the same build-time installation as the compiler.
def emit_compression_link_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_compression_link_required = align 8 { l 0 }\ndata $trbn_compression_link_directory = { b \"TRBN_COMPRESSION_LIB_DIR\", b 0 }\ndata $trbn_compression_link_relative = { b \"/compression\", b 0 }\ndata $trbn_compression_link_library = { b \"/libdeflate.a\", b 0 }\ndata $trbn_compression_link_identity = { b \"/compression-identity.o\", b 0 }\ndata $trbn_compression_link_error = { b \"compiler: pinned static gzip library is missing; install compression beside QBE or set TRBN_COMPRESSION_LIB_DIR\", b 10, b 0 }\nfunction $trbn_set_compression_link(l %needed) {\n@start\n storel %needed, $trbn_compression_link_required\n ret\n}\nfunction l $trbn_compression_link_arguments(l %tail, l %qbe) {\n@start\n %needed =l loadl $trbn_compression_link_required\n jnz %needed, @directory, @unchanged\n@unchanged\n ret %tail\n@directory\n %library_slot =l add %tail, 8\n %identity_slot =l add %tail, 16\n storel 0, %library_slot\n storel 0, %identity_slot\n %environment =l call $getenv(l $trbn_compression_link_directory)\n jnz %environment, @environment, @adjacent\n@environment\n %first =w loadub %environment\n jnz %first, @explicit, @adjacent\n@explicit\n %explicit =l call $realpath(l %environment, l 0)\n jmp @resolved\n@adjacent\n %copy =l call $strdup(l %qbe)\n jnz %copy, @parent, @failed\n@parent\n %slash =l call $strrchr(l %copy, w 47)\n jnz %slash, @truncate, @no_parent\n@no_parent\n call $free(l %copy)\n jmp @failed\n@truncate\n storeb 0, %slash\n %relative =l call $trbn_network_link_path(l %copy, l $trbn_compression_link_relative)\n call $free(l %copy)\n jnz %relative, @canonical, @failed\n@canonical\n %adjacent =l call $realpath(l %relative, l 0)\n call $free(l %relative)\n jmp @resolved\n@resolved\n %root =l phi @explicit %explicit, @canonical %adjacent\n jnz %root, @paths, @failed\n@paths\n %library =l call $trbn_network_link_path(l %root, l $trbn_compression_link_library)\n %identity =l call $trbn_network_link_path(l %root, l $trbn_compression_link_identity)\n call $free(l %root)\n storel %library, %library_slot\n storel %identity, %identity_slot\n %no_library =w ceql %library, 0\n %no_identity =w ceql %identity, 0\n %missing =w or %no_library, %no_identity\n jnz %missing, @failed, @readable\n@readable\n %library_status =w call $access(l %library, w 4)\n %identity_status =w call $access(l %identity, w 4)\n %status =w or %library_status, %identity_status\n jnz %status, @failed, @arguments\n@arguments\n storel $trbn_network_link_input, %tail\n %new_tail =l add %tail, 24\n ret %new_tail\n@failed\n call $trbn_compression_link_cleanup(l %tail)\n %length =l call $strlen(l $trbn_compression_link_error)\n call $write(w 2, l $trbn_compression_link_error, l %length)\n ret 0\n}\nfunction $trbn_compression_link_cleanup(l %tail) {\n@start\n %needed =l loadl $trbn_compression_link_required\n jnz %needed, @release, @done\n@release\n %library_slot =l add %tail, 8\n %library =l loadl %library_slot\n call $free(l %library)\n %identity_slot =l add %tail, 16\n %identity =l loadl %identity_slot\n call $free(l %identity)\n@done\n ret\n}\n")
end
