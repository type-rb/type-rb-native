import { check, emit_qbe } from compiler
import { lex } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { resolve } from frontend/checking/program/resolution
import { CompilerState, compiler_new } from state/state
import { describe, expect, test } from trb/std/test
import { occurrence_count, output_source } from testing/compiler

describe("Native TypeRB frontend") do
	test("normalizes negative Array indexes before a terminal bounds check") do
		source := "def main()\n\tvalues := [1]\n\t_value := values[- 1]\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("call $trbn_fail(l $trbn_bounds_error, l 30)")).to_be_true()
		expect(occurrence_count(qbe, " =w cultl ") >= 2).to_be_true()
		expect(qbe.include?("call $trbn_array_address")).to_be_false()
	end

	test("splits common non-Float Array pushes from fixed quadruple growth") do
		source := "def main()\n\tmut managed: Array<String> := []\n\tmanaged.push(\"value\")\n\tmut scalar: Array<Integer> := []\n\tscalar.push(1)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function $trbn_array_push_paced(l %array, l %value) {")).to_be_true()
		expect(
			qbe.include?(
				"%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $trbn_array_grow_paced(l %array, l %value, l %length, l %capacity)\n\tret\n@store",
			),
		).to_be_true()
		expect(qbe.include?("function $trbn_array_grow_paced(l %array, l %value, l %length, l %capacity) {")).to_be_true()
		expect(qbe.include?("%new_capacity =l shl %capacity, 2\n\t%new_bytes =l shl %new_capacity, 3")).to_be_true()
		expect(qbe.include?("%offset =l shl %length, 3")).to_be_true()
		expect(qbe.include?("%managed_slot =l add %descriptor, 8")).to_be_false()
		expect(qbe.include?("function $trbn_array_push(l %array, l %value) {")).to_be_true()
		expect(qbe.include?("call $trbn_array_push_paced(l ")).to_be_true()
	end

	test("emits direct binary64 cells for Float Arrays") do
		source := "record Floats\n\tvalues: Array<Float>\nend\n\ndef carry(values: Array<Float>): Array<Float>\n\treturn values\nend\n\ndef main()\n\tmut values := [1, 2.5]\n\tvalues.push(3)\n\tvalues[0] += 0.5\n\tbox := Floats.new(values: values)\n\tresult := carry(box.values)\n\t_value := result[- 1]\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function $trbn_array_push_paced(l %array, l %value)")).to_be_true()
		expect(qbe.include?("function $trbn_array_push_d(l %array, d %value)")).to_be_true()
		expect(qbe.include?("call $trbn_gc_maybe_collect(l %growth)")).to_be_true()
		expect(qbe.include?("call $trbn_array_preflight(l ")).to_be_false()
		expect(qbe.include?("call $trbn_array_push_d(l ")).to_be_true()
		expect(qbe.include?(", d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=d loadd ")).to_be_true()
		expect(qbe.include?("stored ")).to_be_true()
		expect(qbe.include?("$trbn_array_push_d(l %array, l %value)")).to_be_false()
		expect(qbe.include?("\tcall $trbn_array_push(l %array, l 0)")).to_be_false()
	end
end
