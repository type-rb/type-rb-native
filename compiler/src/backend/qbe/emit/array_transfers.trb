import { MirArrayTransfer } from mir/model/module
import { QbeEmitContext, emit_label, emit_temporary } from backend/qbe/context
import { QbeOutput, qbe_output_line } from backend/qbe/output
import { integer_string } from support/literals

record QbeTransferCursor
	destination: String
	source: String
	remaining: String
end

# Emit one bounded-width copy loop, returning its cursors and remaining bytes.
# Primitive Arrays own their backing storage; identical-index aliases name the
# same span. Both cases satisfy blit's disjoint-or-identical overlap contract.
# Small constant blits avoid a foreign call and its caller-register spills.
def emit_mir_transfer_chunks(destination: String, source: String, bytes: String, width: Integer, mut context: QbeEmitContext, mut output: QbeOutput): QbeTransferCursor
	entry := emit_label(context)
	header := emit_label(context)
	body := emit_label(context)
	finish := emit_label(context)
	current := QbeTransferCursor.new(destination: emit_temporary(context), source: emit_temporary(context), remaining: emit_temporary(context))
	next_values := QbeTransferCursor.new(destination: emit_temporary(context), source: emit_temporary(context), remaining: emit_temporary(context))
	qbe_output_line(output, "\tjmp " + entry + "\n" + entry + "\n\tjmp " + header + "\n" + header)
	qbe_output_line(output, "\t" + current.destination + " =l phi " + entry + " " + destination + ", " + body + " " + next_values.destination)
	qbe_output_line(output, "\t" + current.source + " =l phi " + entry + " " + source + ", " + body + " " + next_values.source)
	qbe_output_line(output, "\t" + current.remaining + " =l phi " + entry + " " + bytes + ", " + body + " " + next_values.remaining)
	available := emit_temporary(context)
	chunk := integer_string(width)
	qbe_output_line(output, "\t" + available + " =w cugel " + current.remaining + ", " + chunk)
	qbe_output_line(output, "\tjnz " + available + ", " + body + ", " + finish + "\n" + body)
	qbe_output_line(output, "\tblit " + current.source + ", " + current.destination + ", " + chunk)
	qbe_output_line(output, "\t" + next_values.destination + " =l add " + current.destination + ", " + chunk)
	qbe_output_line(output, "\t" + next_values.source + " =l add " + current.source + ", " + chunk)
	qbe_output_line(output, "\t" + next_values.remaining + " =l sub " + current.remaining + ", " + chunk)
	qbe_output_line(output, "\tjmp " + header + "\n" + finish)
	return current
end

# All proof obligations belong to MIR. Array slots occupy eight bytes for
# every accepted primitive representation; four-slot chunks bound code growth.
# The exact tail neither allocates nor collects and never reads past the range.
def emit_mir_array_transfer(plan: MirArrayTransfer, operands: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput)
	count := emit_temporary(context)
	bytes := emit_temporary(context)
	offset := emit_temporary(context)
	qbe_output_line(output, "\t" + count + " =l sub " + operands[plan.limit] + ", " + operands[plan.index])
	qbe_output_line(output, "\t" + bytes + " =l shl " + count + ", 3")
	qbe_output_line(output, "\t" + offset + " =l shl " + operands[plan.index] + ", 3")
	mut addresses: Array<String> := []
	[plan.destination, plan.source].each do |owner|
		slot := emit_temporary(context)
		data := emit_temporary(context)
		address := emit_temporary(context)
		qbe_output_line(output, "\t" + slot + " =l add " + operands[owner] + ", 24")
		qbe_output_line(output, "\t" + data + " =l loadl " + slot)
		qbe_output_line(output, "\t" + address + " =l add " + data + ", " + offset)
		addresses.push(address)
	end
	tail := emit_mir_transfer_chunks(addresses[0], addresses[1], bytes, 32, context, output)
	emit_mir_transfer_chunks(tail.destination, tail.source, tail.remaining, 8, context, output)
	qbe_output_line(output, "\t" + operands[plan.next_value] + " =l copy " + operands[plan.limit])
end
