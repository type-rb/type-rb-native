import { MirArrayLoop, MirModule } from mir/model/module
import { mir_storage_type_name } from mir/model/types
import { QbeEmitContext, emit_label, emit_temporary, emit_typed_load, emit_typed_store } from backend/qbe/context
import { QbeOutput, qbe_output_branch, qbe_output_line } from backend/qbe/output
import { integer_string } from support/literals

def qbe_array_cache_name(header: Integer, slot: Integer): String
	return "%mir_array_cached_" + integer_string(header) + "_" + integer_string(slot)
end

# The MIR plan supplies the exclusive body/exit and every safe access. A shared
# lazy flag avoids new reads for zero iterations; writeback precedes exit work.
def emit_mir_array_cache_boundary(native_module: MirModule, plans: Array<MirArrayLoop>, block: Integer, operands: Array<String>, mut context: QbeEmitContext, mut output: QbeOutput)
	plans.each do |plan|
		if plan.cached_values.size() > 0
			first := plan.cached_values[0]
			ready := "%mir_array_ready_" + integer_string(plan.header)
			if block == first.body
				initialize := emit_label(context)
				body := emit_label(context)
				qbe_output_branch(output, ready, body, initialize)
				qbe_output_line(output, initialize)
				mut slot := 0
				while slot < plan.cached_values.size()
					cache := plan.cached_values[slot]
					name := qbe_array_cache_name(plan.header, slot)
					storage_slot := emit_temporary(context)
					storage := emit_temporary(context)
					offset := emit_temporary(context)
					qbe_output_line(output, "\t" + storage_slot + " =l add " + operands[cache.owner] + ", 24")
					qbe_output_line(output, "\t" + storage + " =l loadl " + storage_slot)
					qbe_output_line(output, "\t" + offset + " =l shl " + operands[cache.index] + ", 3")
					qbe_output_line(output, "\t" + name + "_address =l add " + storage + ", " + offset)
					emit_typed_load(output, name, mir_storage_type_name(native_module, cache.type_id), name + "_address")
					slot += 1
				end
				qbe_output_line(output, "\t" + ready + " =w copy 1\n\tjmp " + body)
				qbe_output_line(output, body)
			elsif block == first.exit
				flush := emit_label(context)
				finish := emit_label(context)
				qbe_output_branch(output, ready, flush, finish)
				qbe_output_line(output, flush)
				mut slot := 0
				while slot < plan.cached_values.size()
					cache := plan.cached_values[slot]
					name := qbe_array_cache_name(plan.header, slot)
					emit_typed_store(output, mir_storage_type_name(native_module, cache.type_id), name, name + "_address")
					slot += 1
				end
				qbe_output_line(output, "\tjmp " + finish)
				qbe_output_line(output, finish)
			end
		end
	end
end
