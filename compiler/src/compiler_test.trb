		expect(state.scalar_mir.array_headers[1]).to_equal([])
		qbe := output_source(emit_qbe(state))
		expect(occurrence_count(qbe, " =w cultl ")).to_equal(2)
	end

	test("retains immutable local Array headers across nested loops") do
