	end

	test("keeps local Array headers conservative for alias growth and conditional scopes") do
		bodies := [
			"values := input\n\tmut index := 0\n\twhile index < values.size()\n\t\toutput[index] = values[index]\n\t\tinput.push(2.0)\n\t\tindex += 1\n\tend",
			"mut values := input\n\toutput[0] = values[0]\n\tvalues = output",
			"if input.size() > 0\n\t\tvalues := input\n\t\toutput[0] = values[0]\n\tend",
			"mut index := 0\n\twhile index < input.size()\n\t\tvalues := input\n\t\toutput[index] = values[index]\n\t\tindex += 1\n\tend\n\tvalues := output\n\tinput[0] = values[0]",
		]
		mut index := 0
		while index < bodies.size()
			source := "def update(mut input: Array<Float>, mut output: Array<Float>)\n\t" + bodies[index] + "\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			expect(check(state)).to_be_true()
			expect(state.scalar_mir.array_headers).to_equal([[], []])
			emit_qbe(state)
			expect(has_diagnostic(state)).to_be_false()
			index += 1
		end
	end

	test("retains stable Array headers through checked conditional structure") do
		sources := ["def update(mut input: Array<Float>, mut output: Array<Float>)\n\tvalues := input\n\tmut index := 0\n\twhile index < input.size()\n\t\tif index == 0\n\t\t\tif values.size() > 0\n\t\t\t\toutput[index] = values[index]\n\t\t\tend\n\t\telsif index == 1\n\t\t\toutput[index] = input[index]\n\t\telse\n\t\t\toutput[index] = values[index]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\treturn\nend\n", "def update(mut input: Array<Float>, mut output: Array<Float>)\n\tif input.size() == 0\n\t\treturn\n\tend\n\toutput[0] = input[0]\n\treturn\nend\n\ndef main()\n\treturn\nend\n"]
		mut index := 0
		while index < sources.size()
			source := sources[index]
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			expect(check(state)).to_be_true()
			expect(state.scalar_mir.array_headers[0].size() > 0).to_be_true()
			expect(verify_mir(state.scalar_mir, true)).to_equal("")
			emit_qbe(state)
			expect(has_diagnostic(state)).to_be_false()
			index += 1
		end
	end

	test("blocks every stable Array header on local or parameter rebinding") do
		bodies := [
			"mut values := input\n\tvalues = output\n\tinput[0] = values[0]",
			"if input.size() > 0\n\t\tinput.push(2.0)\n\tend\n\toutput[0] = input[0]",
			"if input.size() > 0\n\t\tinput = output\n\tend\n\toutput[0] = input[0]",
			"if input.size() > 0\n\t\tunused: Array<Float> := []\n\tend\n\toutput[0] = input[0]",

			"input[0] = output[0]\n\tinput = output\n\tinput[0] = 8.0",
			"input = output\n\tinput[0] = output[0]",
			"mut values := input\n\tinput[0] = values[0]\n\tvalues = output\n\tinput[0] = values[- 1]",
		]
		mut index := 0
		while index < bodies.size()
			source := "def update(mut input: Array<Float>, mut output: Array<Float>)\n\t" + bodies[index] + "\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			expect(check(state)).to_be_true()
			expect(state.scalar_mir.array_headers).to_equal([[], []])
			expect(verify_mir(state.scalar_mir, true)).to_equal("")
			emit_qbe(state)
			expect(has_diagnostic(state)).to_be_false()
			index += 1
		end
	end

	test("blocks stable Array-header plans across allocating primitives") do
		effects := [
			"unused := Process.argv()",
			"unused := Box.new(value: 1)",
			"unused := index.to_s()",
			"unused := text + \"x\"",
			"unused := text[0]",
			"mut unused := text\n\t\tunused += \"x\"",
		]
		mut effect := 0
		while effect < effects.size()
			mut prefix := ""
			if effect == 0
				prefix = "import trb/std/process\n\n"
			end
			source := prefix + "record Box\n\tvalue: Integer\nend\n\ndef allocated(input: Array<Float>, text: String): Float\n\tmut total := 0.0\n\tmut index := 0\n\twhile index < input.size()\n\t\ttotal += input[index]\n\t\t" + effects[effect] + "\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef main()\n\treturn\nend\n"
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			checked := check(state)
			if !checked
				expect(load_string(state.diagnostic_messages, 0)).to_equal("")
			end
			expect(checked).to_be_true()
			expect(state.scalar_mir.array_headers[0]).to_equal([])
			expect(verify_mir(state.scalar_mir, true)).to_equal("")
			effect += 1
		end
	end

	test("retains bounds checks after a loop index changes before its access") do
