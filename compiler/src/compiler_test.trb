	end

	test("inlines only eligible scalar leaf calls in managed caller loops") do
		eligible_source := "def scalar(left: Integer, right: Integer): Integer\n\tsum := left + right\n\treturn sum * 2\nend\n\ndef main()\n\tmarker := \"managed caller\"\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := scalar(index, 1)\n\t\tindex += value\n\tend\n\treturn\nend\n"
		mut eligible := compiler_new(eligible_source.size() + 1)
		expect(lex(eligible, eligible_source)).to_be_true()
		expect(parse_module(eligible, 0, eligible.entry_module[0])).to_be_true()
		expect(resolve(eligible)).to_be_true()
		expect(check(eligible)).to_be_true()
		eligible_qbe := output_source(emit_qbe(eligible))
		expect(eligible_qbe.include?("call $trbnf0")).to_be_false()
		expect(eligible_qbe.include?("function l $trbnf0(")).to_be_false()
		expect(eligible_qbe.include?("# native retained scalar call ")).to_be_false()
		expect(eligible_qbe.include?("@scalar_inline_integer_range_failure")).to_be_true()
		expect(
			occurrence_count(eligible_qbe, "@scalar_inline_integer_range_failure"),
		).to_equal(4)

		non_loop_source := "def scalar(value: Integer): Integer\n\treturn value + 1\nend\n\ndef main()\n\tvalue := scalar(1)\n\treturn\nend\n"
		mut non_loop := compiler_new(non_loop_source.size() + 1)
		expect(lex(non_loop, non_loop_source)).to_be_true()
		expect(parse_module(non_loop, 0, non_loop.entry_module[0])).to_be_true()
		expect(resolve(non_loop)).to_be_true()
		expect(check(non_loop)).to_be_true()
		non_loop_qbe := output_source(emit_qbe(non_loop))
		expect(non_loop_qbe.include?("call $trbnf0")).to_be_true()
		expect(non_loop_qbe.include?("function l $trbnf0(")).to_be_true()
		expect(non_loop_qbe.include?("# native retained scalar call ")).to_be_false()
		expect(non_loop_qbe.include?("@scalar_inline_integer_range_failure")).to_be_false()

		ineligible_source := "def choose(value: Integer): Integer\n\tif value > 0\n\t\treturn value\n\telse\n\t\treturn 0\n\tend\nend\n\ndef main()\n\tmarker := \"managed caller\"\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := choose(index)\n\t\tindex += value + 1\n\tend\n\treturn\nend\n"
		mut ineligible := compiler_new(ineligible_source.size() + 1)
		expect(lex(ineligible, ineligible_source)).to_be_true()
		expect(parse_module(ineligible, 0, ineligible.entry_module[0])).to_be_true()
		expect(resolve(ineligible)).to_be_true()
		expect(check(ineligible)).to_be_true()
		expect(output_source(emit_qbe(ineligible)).include?("call $trbnf0")).to_be_true()

		delegating_source := "def increment(value: Integer): Integer\n\treturn value + 1\nend\n\ndef delegating(value: Integer): Integer\n\treturn increment(value)\nend\n\ndef main()\n\tmarker := \"managed caller\"\n\tmut index := 0\n\twhile index < 1\n\t\tindex = delegating(index)\n\tend\n\treturn\nend\n"
		mut delegating := compiler_new(delegating_source.size() + 1)
		expect(lex(delegating, delegating_source)).to_be_true()
		expect(parse_module(delegating, 0, delegating.entry_module[0])).to_be_true()
		expect(resolve(delegating)).to_be_true()
		expect(check(delegating)).to_be_true()
		expect(output_source(emit_qbe(delegating)).include?("call $trbnf1")).to_be_true()
	end

	test("rejects missing invalid and mismatched checked binary plans") do
		source := "def main()\n\tmut value := 7\n\tvalue += 1\n\tputs(value.to_s())\n\treturn\nend\n"
		invalid := [0, 22, 18]
		mut index := 0
		while index < invalid.size()
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			expect(check(state)).to_be_true()
			mut origin := 0
			while load_string(state.token_texts, origin) != "+="
				origin += 1
			end
			expect(load_integer(state.mir_nonnegative_facts, origin)).to_equal(17)
			store_integer(state.mir_nonnegative_facts, origin, invalid[index])
			emit_qbe(state)
			expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
			expect(load_string(state.diagnostic_messages, 0)).to_equal("invalid checked binary plan")
			index += 1
		end
	end

	test("constructs binary result metadata once from the checked result type") do
		operators := ["+", "-", "*", "/", "%", "+", "<", "+", "==", "!="]
		plans := [17, 18, 19, 20, 21, 33, 56, 65, 54, 55]
		operand_types := ["Integer", "Integer", "Integer", "Integer", "Integer", "Float", "Float", "String", "String", "String"]
		operands := ["7", "7", "7", "7", "7", "d_7.0", "d_7.0", "%string", "%string", "%string"]
		result_types := ["Integer", "Integer", "Integer", "Integer", "Integer", "Float", "Boolean", "String", "Boolean", "Boolean"]
		mut index := 0
		while index < plans.size()
			mut state := compiler_new(8)
			expect(lex(state, operators[index])).to_be_true()
			store_integer(state.mir_nonnegative_facts, 0, plans[index])
			mut context := emit_context_new(8, [64, 6, 2])
			mut output := qbe_output_new(256, [0, 0, 0, 0])
			value := emitted_value(operands[index], operand_types[index], 0, "", "")
			result := lower_checked_binary(state, context, output, 0, value, value)
			expect(result.type_name).to_equal(result_types[index])
			expect(result.category).to_equal(0)
			expect(result.name).to_equal("")
			expect(result.owner).to_equal("")
			expect(result.slot).to_equal("")
			expect(result.operand).to_equal("%t0")
			expect(state.diagnostic_count[0]).to_equal(0)
			index += 1
		end
	end

	test("retains caller lower-bound checks after the literal-return inline budget") do
		source := "def one(): Integer\n\treturn 1\nend\n\ndef main()\n\tmut value := 7\n\tmut index := 0\n\twhile index < 1\n\t\tvalue += one()\n\t\tvalue += one()\n\t\tvalue += one()\n\t\tindex += 1\n\tend\n\tputs(value.to_s())\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(occurrence_count(qbe, "call $trbnf0()")).to_equal(1)
		# The Boolean loop comparison and the retained call's lower-bound
		# check keep distinct result widths. The safety check is not omitted.
		# Neither of the two inlined literal returns needs that lower check.
		expect(occurrence_count(qbe, " =l csltl %t")).to_equal(1)
		expect(occurrence_count(qbe, " =w csltl %t")).to_equal(1)
	end

	test("branches on canonical Boolean values without repeated materialization") do
		# The loop precedes the retained call: an ordinary eligible call closes
		# the shared inline budget for every later call, even in a loop.
		source := "def invert(value: Boolean): Boolean\n\treturn !value\nend\n\ndef main()\n\tmut index := 0\n\twhile index < 1\n\t\tif invert(false)\n\t\t\tputs(\"ok\")\n\t\tend\n\t\tindex += 1\n\tend\n\tif invert(true)\n\t\tputs(\"bad\")\n\tend\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		scalar_body := qbe.split("function l $trbnf0(")[1].split("\n}\n")[0]
		# Inner temporary-root scopes also contain closing braces.
		main_body := qbe.split("function $trbnf1(")[1].split("\nfunction ")[0].split("\nexport function ")[0]
		expect(scalar_body.include?(" =l ceql ")).to_be_true()
		expect(main_body.include?(" =l csltl ")).to_be_true()
		expect(main_body.include?(" =l ceql ")).to_be_true()
		expect(scalar_body.include?("extuw")).to_be_false()
		expect(main_body.include?("extuw")).to_be_false()
		expect(main_body.include?(" =w cnel ")).to_be_false()
	end

	test("rejects non-Boolean branch conditions") do
		sources := ["def main()\n\tif 1\n\t\tputs(\"bad\")\n\tend\nend\n", "def main()\n\twhile 4294967296\n\t\tputs(\"bad\")\n\tend\nend\n"]
		mut index := 0
		while index < sources.size()
			source := sources[index]
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			expect(check(state)).to_be_false()
			index += 1
		end
	end

	test("limits managed caller scalar inlining to two call sites per small program") do
		source := "def scalar(value: Integer): Integer\n\treturn value + 1\nend\n\ndef main()\n\tmarker := \"managed caller\"\n\tmut index := 0\n\twhile index < 1\n\t\tfirst := scalar(index)\n\t\tsecond := scalar(index)\n\t\tthird := scalar(index)\n\t\tindex += first + second + third\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
