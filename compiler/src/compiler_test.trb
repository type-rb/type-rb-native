	test("splits common non-Float Array pushes from fixed quadruple growth") do
		source := "def main()\n\tmut managed: Array<String> := []\n\tmanaged.push(\"value\")\n\tmut scalar: Array<Integer> := []\n\tscalar.push(1)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function $trbn_array_push_paced(l %array, l %value) {")).to_be_true()
		expect(
			qbe.include?(
				"%full =w ceql %length, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $trbn_array_grow_paced(l %array, l %value, l %length, l %capacity)\n\tret\n@store",
			),
		).to_be_true()
		expect(qbe.include?("function $trbn_array_grow_paced(l %array, l %value, l %length, l %capacity) {")).to_be_true()
		expect(qbe.include?("%new_capacity =l shl %capacity, 2\n\t%new_bytes =l shl %new_capacity, 3")).to_be_true()
		expect(qbe.include?("%offset =l shl %length, 3")).to_be_true()
		expect(qbe.include?("%managed_slot =l add %descriptor, 8")).to_be_false()
		expect(qbe.include?("function $trbn_array_push(l %array, l %value) {")).to_be_true()
		expect(qbe.include?("call $trbn_array_push_paced(l ")).to_be_true()
	end

	test("splits temporary-root push storage from growth") do
		source := "def keep(value: String): String\n\treturn value\nend\n\ndef main()\n\tputs(keep(\"kept\"))\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function $trbn_gc_temp_push(l %value) {")).to_be_true()
		expect(
			qbe.include?(
				"%full =w ceql %count, %capacity\n\tjnz %full, @grow, @store\n@grow\n\tcall $trbn_gc_temp_grow(l %value, l %count, l %capacity)\n\tret\n@store",
			),
		).to_be_true()
		expect(qbe.include?("function $trbn_gc_temp_grow(l %value, l %count, l %capacity) {")).to_be_true()
		expect(qbe.include?("%new_data =l call $realloc(l %data, l %bytes)")).to_be_true()
		expect(qbe.include?("%nil =w ceql %value, 0\n\tjnz %nil, @finish, @descriptor")).to_be_true()
		expect(qbe.include?("%descriptor_mark =l loadl %value\n\t%static =w ceql %descriptor_mark, 0")).to_be_true()
		expect(qbe.include?("%offset =l shl %count, 3")).to_be_true()
		expect(qbe.include?("storel %value, %slot\n\t%next_count =l add %count, 1")).to_be_true()
	end

	test("emits direct binary64 cells for Float Arrays") do
		source := "record Floats\n\tvalues: Array<Float>\nend\n\ndef carry(values: Array<Float>): Array<Float>\n\treturn values\nend\n\ndef main()\n\tmut values := [1, 2.5]\n\tvalues.push(3)\n\tvalues[0] += 0.5\n\tbox := Floats.new(values: values)\n\tresult := carry(box.values)\n\tvalue := result[- 1]\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function $trbn_array_push_paced(l %array, l %value)")).to_be_true()
		expect(qbe.include?("function $trbn_array_push_d(l %array, d %value)")).to_be_true()
		expect(qbe.include?("call $trbn_gc_maybe_collect(l %growth)")).to_be_true()
		expect(qbe.include?("call $trbn_array_preflight(l ")).to_be_false()
		expect(qbe.include?("call $trbn_array_push_d(l ")).to_be_true()
		expect(qbe.include?(", d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=d loadd ")).to_be_true()
		expect(qbe.include?("stored ")).to_be_true()
		expect(qbe.include?("$trbn_array_push_d(l %array, l %value)")).to_be_false()
		expect(qbe.include?("\tcall $trbn_array_push(l %array, l 0)")).to_be_false()
	end

	test("eliminates scalar loop local stack slots through MIR block arguments") do
		source := "def main()\n\tmut index := 0\n\twhile index < 2\n\t\trepeated := index\n\t\tindex = repeated + 1\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(mir_function_index(state.scalar_mir, 0) >= 0).to_be_true()
		expect(qbe.include?("function $trbnf0() {\n@start\n\tjmp @mir_0")).to_be_true()
		expect(qbe.include?("%v0 =l alloc8 8")).to_be_false()

	end

	test("distinguishes keyword strings from parameter-reassignment boundaries") do
		keywords := ["end", "if", "while"]
		mut index := 0
		while index < keywords.size()
			keyword := keywords[index]
			source := "def rewrite(mut values: Array<Integer>)\n\tputs(\"" + keyword + "\")\n\tif true\n\t\twhile false\n\t\t\tputs(\"end\")\n\t\tend\n\t\tvalues = [123]\n\tend\n\treturn\nend\n\ndef untouched(values: Array<Integer>)\n\tputs(\"" + keyword + "\")\n\treturn\nend\n\ndef later(mut values: Array<Integer>)\n\tvalues = [999]\n\treturn\nend\n\ndef append(mut value: String)\n\tputs(\"end\")\n\tvalue += \"x\"\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			expect(check(state)).to_be_true()
			expect(function_reassigns_parameter(state, 0, "values")).to_be_true()
			expect(function_reassigns_parameter(state, 1, "values")).to_be_false()
			expect(function_reassigns_parameter(state, 2, "values")).to_be_true()
			expect(function_reassigns_parameter(state, 3, "value")).to_be_true()
			index += 1
		end
	end

	test("reserves the managed-local high-water mark and bulk-rewrites loop roots") do
		source := "def nested(limit: Integer): String\n\tmut outer: Array<String> := []\n\tmut index := 0\n\twhile index < limit\n\t\tmut inner: Array<String> := []\n\t\twhile inner.size() < 1\n\t\t\tinner.push(\"ok\")\n\t\tend\n\t\touter.push(inner[0])\n\t\tindex += 1\n\tend\n\treturn outer[0]\nend\n\ndef main()\n\tvalue := nested(1)\n\tputs(value)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function $trbn_gc_temp_reserve(l %required)")).to_be_true()
		expect(qbe.include?("\t%root_capacity =l add %temporary_roots, 2")).to_be_true()
		expect(qbe.include?("\tcall $trbn_gc_temp_reserve(l %root_capacity)")).to_be_true()
		expect(qbe.include?("=l loadl $trbn_gc_temp_data")).to_be_true()
		expect(qbe.include?("=l mul %temporary_roots, 8")).to_be_true()
		expect(qbe.include?("\tcall $trbn_gc_temp_reset(l %temporary_roots)")).to_be_false()
	end

	test("emits exact logical root segments and one managed-return epilogue") do
		source := "record Bundle\n\tlabel: String\n\tlabels: Array<String>\nend\n\ndef select(mut bundle: Bundle, mut current: String): String\n\twhile current != \"done\"\n\t\tcurrent = bundle.label\n\t\tbundle = Bundle.new(label: \"done\", labels: bundle.labels)\n\t\treturn bundle.labels[0]\n\tend\n\treturn current\nend\n\ndef grow(mut current: String): String\n\tmut index := 0\n\twhile index < 2\n\t\tcurrent += \"x\"\n\t\tindex += 1\n\tend\n\treturn current\nend\n\ndef main()\n\tmut labels: Array<String> := []\n\tlabels.push(\"kept\")\n\tbundle := Bundle.new(label: \"next\", labels: labels)\n\tresult := grow(select(bundle, \"start\"))\n\tputs(result)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("\t%temporary_roots =l loadl $trbn_gc_temp_count")).to_be_true()
		expect(qbe.include?("\tstorel %temporary_roots, $trbn_gc_temp_count")).to_be_true()
		expect(qbe.include?("\tcall $trbn_gc_temp_reset(l %temporary_roots)")).to_be_false()
		expect(qbe.include?("\tcall $trbn_gc_temp_push(l %t")).to_be_false()
		expect(
			qbe.include?(
				"\tstorel %temporary_roots, $trbn_gc_temp_count\n\t%return_result =l loadl %return_value\n\tcall $trbn_gc_temp_push(l %return_result)\n\tret %return_result\n",
			),
		).to_be_true()
		expect(qbe.include?("$trbn_gc_roots")).to_be_false()
		expect(qbe.include?("$trbn_gc_frame_enter")).to_be_false()
		expect(qbe.include?("$trbn_gc_frame_leave")).to_be_false()
	end

	test("keeps managed owners rooted without duplicating roots for loaded aliases") do
		source := "record Box\n\tvalues: Array<String>\nend\n\ndef first(box: Box): String\n\treturn box.values[0]\nend\n\ndef main()\n\tvalues := [\"kept\"]\n\tbox := Box.new(values: values)\n\tputs(first(box))\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(occurrence_count(qbe, "call $trbn_gc_temp_push")).to_equal(2)
		expect(qbe.include?("\tcall $trbn_gc_temp_push(l %t")).to_be_false()
		expect(qbe.include?("\tcall $trbn_gc_temp_push(l %object)")).to_be_true()
		expect(qbe.include?("\tcall $trbn_gc_temp_push(l %return_result)")).to_be_true()
	end

	test("omits managed root publication only without GC safe points") do
		prefix := "record FloatBucket\n\tvalues: Array<Float>\nend\n\n"
		no_safe_point := prefix + "def sum(bucket: FloatBucket): Float\n\tmut values := bucket.values\n\tmut total: Float := 0\n\tmut index := 0\n\twhile index < values.size()\n\t\ttotal += values[index]\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef main()\n\treturn\nend\n"
		mut no_safe_point_state := compiler_new(no_safe_point.size() + 1)
		expect(lex(no_safe_point_state, no_safe_point)).to_be_true()
		expect(parse_module(no_safe_point_state, 0, no_safe_point_state.entry_module[0])).to_be_true()
		expect(resolve(no_safe_point_state)).to_be_true()
		expect(check(no_safe_point_state)).to_be_true()
		no_safe_point_qbe := output_source(emit_qbe(no_safe_point_state))
		expect(no_safe_point_qbe.include?("%temporary_roots =l loadl $trbn_gc_temp_count")).to_be_false()
		expect(no_safe_point_qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_false()

		allocation := prefix + "def append(bucket: FloatBucket)\n\tmut values := bucket.values\n\tmut index := 0\n\twhile index < 1\n\t\tvalues.push(1.0)\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut allocation_state := compiler_new(allocation.size() + 1)
		expect(lex(allocation_state, allocation)).to_be_true()
		expect(parse_module(allocation_state, 0, allocation_state.entry_module[0])).to_be_true()
		expect(resolve(allocation_state)).to_be_true()
		expect(check(allocation_state)).to_be_true()
		allocation_qbe := output_source(emit_qbe(allocation_state))
		expect(allocation_qbe.include?("%temporary_roots =l loadl $trbn_gc_temp_count")).to_be_true()
		expect(allocation_qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_true()

		call := prefix + "def observe(_value: Float)\n\treturn\nend\n\ndef visit(bucket: FloatBucket)\n\tmut values := bucket.values\n\tmut index := 0\n\twhile index < values.size()\n\t\tobserve(values[index])\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut call_state := compiler_new(call.size() + 1)
		expect(lex(call_state, call)).to_be_true()
		expect(parse_module(call_state, 0, call_state.entry_module[0])).to_be_true()
		expect(resolve(call_state)).to_be_true()
		expect(check(call_state)).to_be_true()
		call_qbe := output_source(emit_qbe(call_state))
		expect(call_qbe.include?("%temporary_roots =l loadl $trbn_gc_temp_count")).to_be_true()
		expect(call_qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_true()
	end

	test("defers managed root publication until a safe-point-free loop exits") do
		source := "def observe(value: Array<String>)\n\treturn\nend\n\ndef carry(limit: Integer): String\n\tmut values: Array<String> := []\n\tvalues.push(\"kept\")\n\tmut index := 0\n\twhile index < limit\n\t\tindex += 1\n\tend\n\tvalues.push(\"after\")\n\treturn values[0]\nend\n\ndef call_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tobserve(values)\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function l $trbnf1(l %p0) {\n@start")).to_be_true()
		expect(qbe.include?("%root_capacity =l add %temporary_roots, 1")).to_be_true()
		expect(
			qbe.include?(
				"@l0\n\t%t2 =l loadl %v2\n\t%t3 =l loadl %v0",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"@l2\n\t%t8 =l loadl $trbn_gc_temp_data" +
				"\n\t%t9 =l mul %temporary_roots, 8" +
				"\n\t%t10 =l add %t8, %t9" +
				"\n\t%t11 =l loadl %v1" +
				"\n\tstorel %t11, %t10" +
				"\n\t%t12 =l add %temporary_roots, 1" +
				"\n\tstorel %t12, $trbn_gc_temp_count" +
				"\n\t%t13 =l loadl %v1" +
				"\n\tcall $trbn_array_push_paced(l %t13, l $trbns64)",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"@l0\n\t%t8 =l loadl $trbn_gc_temp_data" +
				"\n\t%t9 =l mul %temporary_roots, 8" +
				"\n\t%t10 =l add %t8, %t9" +
				"\n\t%t11 =l loadl %v1" +
				"\n\tstorel %t11, %t10" +
				"\n\t%t12 =l add %temporary_roots, 1" +
				"\n\tstorel %t12, $trbn_gc_temp_count" +
				"\n\t%t1 =l loadl %v2",
			),
		).to_be_true()
	end

	test("keeps managed root publication at every GC-safe loop header") do
		source := "def observe_loop_value(value: Array<String>)\n\treturn\nend\n\ndef make_loop_values(): Array<String>\n\treturn [\"made\"]\nend\n\ndef grow_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tvalues.push(\"grown\")\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef allocate_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tmade: Array<String> := []\n\t\tif made.size() > 0\n\t\t\tputs(\"unexpected\")\n\t\tend\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef managed_result_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tmade := make_loop_values()\n\t\tif made.size() == 0\n\t\t\tputs(\"unexpected\")\n\t\tend\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef opaque_call_in_loop(limit: Integer): String\n\tmut values: Array<String> := [\"kept\"]\n\tmut index := 0\n\twhile index < limit\n\t\tobserve_loop_value(values)\n\t\tindex += 1\n\tend\n\treturn values[0]\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(
			occurrence_count(qbe, "@l0\n\t%t8 =l loadl $trbn_gc_temp_data"),
		).to_equal(2)
		expect(
			occurrence_count(qbe, "@l0\n\t%t12 =l loadl $trbn_gc_temp_data"),
		).to_equal(2)
		expect(qbe.include?("@l1\n\t%t4 =l loadl %v1\n\tcall $trbn_array_push_paced")).to_be_true()
		expect(qbe.include?("@l1\n\t%t4 =l call $trbn_array_new")).to_be_true()
		expect(qbe.include?("@l1\n\t%t4 =l call $trbnf1()")).to_be_true()
		expect(qbe.include?("@l1\n\t%t4 =l loadl %v1\n\tcall $trbnf0(l %t4)")).to_be_true()
	end

	test("preserves a verified stable Array header across fallback invalidations") do
		mut context := emit_context_new(16, [64, 16, 2])
		mut output := qbe_output_new(16, [0, 0, 0, 0])
		context.array_headers.push(["%v0", "%length", "%data"])
		context.array_header_count[0] = 1
		length := emit_array_header(context, output, "%first", "%v0", 1, "8")
		emit_array_header(context, output, "%second", "%v1", 1, "8")
		emit_array_header(context, output, "%third", "%v2", 2, "24")
		invalidate_array_header_cache(context)
		expect(emit_array_header(context, output, "%first", "%v0", 1, "8")).to_equal(length)
		expect(emit_array_header(context, output, "%first", "%v0", 2, "24")).to_equal("%data")
		expect(output.count[0]).to_equal(4)
	end

	test("reuses both recent Array headers and invalidates both together") do
		mut context := emit_context_new(16, [64, 16, 2])
		mut output := qbe_output_new(16, [0, 0, 0, 0])
		first_length := emit_array_header(context, output, "%first", "%v0", 1, "8")
		second_length := emit_array_header(context, output, "%second", "%v1", 1, "8")
		first_data := emit_array_header(context, output, "%first", "%v0", 2, "24")
		second_data := emit_array_header(context, output, "%second", "%v1", 2, "24")
		expect(emit_array_header(context, output, "%first", "%v0", 1, "8")).to_equal(first_length)
		expect(emit_array_header(context, output, "%second", "%v1", 1, "8")).to_equal(second_length)
		expect(emit_array_header(context, output, "%first", "%v0", 2, "24")).to_equal(first_data)
		expect(emit_array_header(context, output, "%second", "%v1", 2, "24")).to_equal(second_data)
		expect(output.count[0]).to_equal(8)
		invalidate_array_header_cache(context)
		expect(emit_array_header(context, output, "%first", "%v0", 1, "8") == first_length).to_be_false()
		expect(emit_array_header(context, output, "%second", "%v1", 2, "24") == second_data).to_be_false()
		expect(output.count[0]).to_equal(12)
	end

	test("evicts only the least recently used fallback Array header") do
		mut context := emit_context_new(16, [64, 16, 2])
		mut output := qbe_output_new(16, [0, 0, 0, 0])
		first_length := emit_array_header(context, output, "%first", "%v0", 1, "8")
		second_length := emit_array_header(context, output, "%second", "%v1", 1, "8")
		expect(emit_array_header(context, output, "%first", "%v0", 1, "8")).to_equal(first_length)
		emit_array_header(context, output, "%third", "%v2", 1, "8")
		expect(emit_array_header(context, output, "%first", "%v0", 1, "8")).to_equal(first_length)
		expect(emit_array_header(context, output, "%second", "%v1", 1, "8") == second_length).to_be_false()
		expect(output.count[0]).to_equal(8)
	end

	test("keeps Array header loads local outside owned-managed loops") do
		mut context := emit_context_new(16, [64, 16, 2])
		mut output := qbe_output_new(16, [0, 0, 0, 0])
		first_length := emit_array_header(context, output, "%first", "", 1, "8")
		second_length := emit_array_header(context, output, "%second", "", 1, "8")
		expect(second_length == first_length).to_be_false()
		expect(output.count[0]).to_equal(4)
	end

	test("emits an opt-in sampled managed-runtime trace without changing stats v1") do
		source := "def main()\n\tmut value := \"seed\"\n\tmut index := 0\n\twhile index < 2\n\t\tvalue += \"x\"\n\t\tindex += 1\n\tend\n\tputs(value)\n\treturn\nend\n"
