	test("selects stable Array headers only across checked header-stable scopes") do
		source := "def scalar(index: Integer): Float\n\treturn index + 1\nend\n\ndef stable(input: Array<Float>, mut output: Array<Float>)\n\tmut outer := 0\n\twhile outer < input.size()\n\t\tmut total := 0.0\n\t\tmut inner := 0\n\t\twhile inner < input.size()\n\t\t\ttotal += input[inner]\n\t\t\tinner += 1\n\t\tend\n\t\toutput[outer] = total\n\t\touter += 1\n\tend\n\treturn\nend\n\ndef opaque(values: Array<Float>)\n\treturn\nend\n\ndef called(input: Array<Float>): Float\n\tmut index := 0\n\tmut total := 0.0\n\twhile index < input.size()\n\t\topaque(input)\n\t\ttotal += input[index]\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef allocated(input: Array<Float>): Float\n\tunused: Array<Float> := []\n\tmut index := 0\n\tmut total: Float := unused.size()\n\twhile index < input.size()\n\t\ttotal += input[index]\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef grown(mut input: Array<Float>): Float\n\tinput.push(1.0)\n\treturn input[0]\nend\n\ndef different(left: Array<Float>, right: Array<Float>): Float\n\tmut index := 0\n\tmut total := 0.0\n\twhile index < left.size()\n\t\ttotal += right[index]\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef alias_safe(input: Array<Float>, mut output: Array<Float>)\n\tmut index := 0\n\twhile index < input.size()\n\t\toutput[index] = input[index]\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		# A different loop bound does not invalidate header reuse. Access
		# checks still test the indexed Array's own length at runtime.
		expect(state.scalar_mir.array_headers).to_equal([[], [0, 1], [], [], [], [], [1], [1, 0], []])
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
	end

	test("publishes a stable Array-header plan without a scalar MIR function") do
		source := "def copy(input: Array<Float>, mut output: Array<Float>)\n\tmut index := 0\n\twhile index < input.size()\n\t\toutput[index] = input[index]\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
