		expect(check(state)).to_be_true()
	end

	test("parses the checked-in compiler closure through its own frontend") do
		root := Process.environment("TYPE_RB_NATIVE_ROOT")
		if root == nil
			expect(true).to_be_true()
		else
			base := root + "/compiler/src/"
			names := ["compiler", "unicode_case_data", "qbe_string_case", "qbe_string_transforms", "hash_key_runtime", "literal_cases", "union_members", "builtin_number_parsing", "qbe_number_parsing", "builtin_lookup", "builtin_results", "unicode_identifier_data", "unicode_identifiers", "compiler_bytes", "literal_types", "literal_type_syntax", "literal_mir", "newtype_mir_types", "newtype_model", "newtype_types", "newtype_syntax", "newtype_resolution", "newtype_mir", "newtype_methods", "sliced_iteration", "array_sorting", "enum_methods", "raw_enum_types", "raw_enum_syntax", "raw_enum_resolution", "raw_enum_checked", "union_types", "union_mir", "union_checked", "qbe_unions", "qbe_scalar_strings", "namespace_model", "namespace_references", "global_model", "global_declarations", "global_analysis", "mir_globals", "qbe_globals", "qbe_array_join", "range_methods", "array_queries", "qbe_array_mutations", "array_methods", "qbe_array_copies", "string_methods", "qbe_string_queries", "qbe_string_sequences", "qbe_string_slices", "qbe_string_trimming", "string_escapes", "qbe_string_literals", "float_methods", "integer_methods", "transform_model", "mir_array_loops", "checked_functions", "literals", "mir", "mir_flow", "mir_roots", "iteration_syntax", "iteration_mir", "path", "hash_types", "hash_mir", "storage", "state", "parser", "checked_values", "resolution", "hash_checked", "iteration_checked", "mir_analysis", "mir_construction", "mir_control", "mir_logical", "mir_calls", "mir_intrinsics", "mir_strings", "mir_instructions", "checked_types", "checked_program", "qbe_output", "hash_runtime", "mir_builder", "mir_passes", "mir_verifier", "project_config", "qbe_constants", "qbe_context", "qbe_roots", "qbe_strings", "qbe_numeric", "qbe_power", "qbe_calls", "qbe_mir", "qbe_control", "qbe_runtime", "mir_types", "mir_arrays", "qbe_arrays", "lexer", "literal_syntax", "mir_records", "qbe_records", "mir_identities", "mir_hashes", "mir_hash_inference", "qbe_hashes", "mir_ranges", "qbe_ranges", "mir_iteration_control", "mir_numeric", "qbe_functions", "argument_binding", "default_arguments", "mir_value_control", "nullable_types", "nullable_mir", "nullable_flow", "qbe_nullable", "checked_submission", "enum_model", "enum_syntax", "enum_types", "enum_checked", "enum_mir", "qbe_enums", "syntax_tokens", "generic_model", "generic_arguments", "generic_syntax", "generic_validation", "declaration_lookup", "type_resolution", "standard_library", "result_model", "result_checked", "checked_body", "generic_functions", "generic_program", "generic_check", "generic_bindings", "alias_model", "alias_syntax", "alias_patterns", "callable_types", "lambda_syntax", "lambda_resolution", "lambda_checking", "lambda_lowering", "mir_bindings", "mir_callables", "qbe_callables", "body_syntax", "declaration_syntax", "object_dispatch", "object_dispatch_mir", "object_dispatch_shapes", "object_fields", "object_initialization", "object_methods", "object_mir", "object_mir_types", "object_model", "object_resolution", "object_syntax", "object_types", "qbe_object_dispatch", "qbe_objects", "syntax_forms", "callable_state", "global_state", "attribute_model", "attribute_syntax", "attribute_check"]
			mut sources: Array<String> := []
			names.each do |name|
				sources.push(required_test_source(base + name + ".trb"))
			end
			mut capacity := 0
			mut module_index := 0
			while module_index < sources.size()
				expect(!sources[module_index].empty?()).to_be_true()
				capacity += sources[module_index].size() + 1
				module_index += 1
			end
			mut state := compiler_new(capacity)
			module_index = 0
			while module_index < names.size()
				add_module(state, names[module_index], base + names[module_index] + ".trb")
				module_index += 1
			end
			state.module_graph.entry_module[0] = 0
			module_index = 0
			while module_index < sources.size()
				start := state.source_tokens.token_count[0]
				expect(lex_module(state, sources[module_index], module_index)).to_be_true()
				expect(parse_module(state, start, module_index)).to_be_true()
				module_index += 1
			end
			mut import_index := 0
			while import_index < state.module_graph.import_count[0]
				target := find_module(state, load_string(state.module_graph.import_paths, import_index))
				expect(target >= 0).to_be_true()
				store_integer(state.module_graph.import_targets, import_index, target)
				import_index += 1
			end
			expect(find_record_in_module(state, 0, "CompilerState")).to_equal(- 1)
			expect(find_record_in_module(state, 0, "QbeOutput")).to_equal(- 1)
			expect(find_record_in_module(state, find_module(state, "qbe_output"), "QbeOutput") >= 0).to_be_true()
			expect(find_record_in_module(state, find_module(state, "state"), "CompilerState") >= 0).to_be_true()
			expect(find_record_in_module(state, 0, "CheckedLocals")).to_equal(- 1)
			expect(find_record_in_module(state, find_module(state, "state"), "CheckedLocals") >= 0).to_be_true()
			expect(find_record_in_module(state, 0, "CheckedValue")).to_equal(- 1)
			expect(find_record_in_module(state, find_module(state, "checked_values"), "CheckedValue") >= 0).to_be_true()
			expect(state.declarations.record_count[0] > 5).to_be_true()
			expect(state.declarations.function_count[0] > 20).to_be_true()
			if !resolve(state)
				puts(
					load_string(state.diagnostics.codes, 0) + ":" + load_integer(state.diagnostics.lines, 0).to_s() + ":" +
					load_string(state.diagnostics.messages, 0),
				)
			end
			expect(has_diagnostic(state)).to_be_false()
			# Function lookup is indexed by resolution, unlike record lookup.
			expect(find_function_in_module(state, 0, "parse_module")).to_equal(- 1)
			expect(find_function_in_module(state, find_module(state, "parser"), "parse_module") >= 0).to_be_true()
			expect(find_function_in_module(state, 0, "resolve")).to_equal(- 1)
			expect(find_function_in_module(state, find_module(state, "resolution"), "resolve") >= 0).to_be_true()
			expect(find_function_in_module(state, 0, "check_expression")).to_equal(- 1)
			expect(find_function_in_module(state, find_module(state, "checked_program"), "check_expression") >= 0).to_be_true()
			if !check(state)
				puts(
					load_string(state.diagnostics.codes, 0) + ":" + load_integer(state.diagnostics.lines, 0).to_s() + ":" +
					load_string(state.diagnostics.messages, 0),
				)
			end
			expect(has_diagnostic(state)).to_be_false()
			# Every compiler declaration, including intrinsic fallback bodies,
			# must have verified MIR when compiling the real module closure.
			expect(state.scalar_mir.functions.size()).to_equal(state.declarations.function_count[0])
			mut function := 0
			while function < state.declarations.function_count[0]
				if mir_function_index(state.scalar_mir, function) < 0
					puts("missing compiler MIR: " + load_string(state.declarations.function_names, function))
					expect(false).to_be_true()
				end
				function += 1
			end
		end
	end

	test("rejects duplicate declarations during resolution") do
		source := "def main()\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostics.lines, 0)).to_equal(5)
		expect(load_string(state.diagnostics.messages, 0)).to_equal("duplicate function declaration main")
	end

	test("reports the first repeated function while retaining last-match lookup") do
		source := "def value(): Integer\n\treturn 1\nend\n\ndef value(): Integer\n\treturn 2\nend\n\ndef value(): Integer\n\treturn 3\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(find_function_in_module(state, state.module_graph.entry_module[0], "value")).to_equal(2)
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostics.lines, 0)).to_equal(5)
		expect(load_string(state.diagnostics.messages, 0)).to_equal("duplicate function declaration value")
		expect(find_function_in_module(state, state.module_graph.entry_module[0], "value")).to_equal(2)
	end

	test("preserves an earlier declaration error before a duplicate function") do
		source := "def value(item: Missing): Integer\n\treturn 1\nend\n\ndef value(): Integer\n\treturn 2\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostics.lines, 0)).to_equal(1)
		expect(load_string(state.diagnostics.messages, 0)).to_equal("unknown parameter type Missing")
	end

	test("rejects an unresolved direct call during resolution") do
		source := "def main()\n\tmissing()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostics.lines, 0)).to_equal(2)
		expect(load_string(state.diagnostics.messages, 0)).to_equal("unresolved function missing")
	end

	test("rejects a local initializer type mismatch during checking") do
		source := "def main()\n\tvalue: Integer := \"bad\"\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_false()
		expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4004")
		expect(load_integer(state.diagnostics.lines, 0)).to_equal(2)
		expect(load_string(state.diagnostics.messages, 0)).to_equal("expected Integer, found String")
	end

	test("enforces the portable Integer literal range during checking") do
		valid_source := "def main()\n\t_value := 9007199254740991\n\treturn\nend\n"
		mut valid := compiler_new(valid_source.size() + 1)
		expect(lex(valid, valid_source)).to_be_true()
		expect(parse_module(valid, 0, valid.module_graph.entry_module[0])).to_be_true()
		expect(resolve(valid)).to_be_true()
		expect(check(valid)).to_be_true()

		invalid_source := "def main()\n\tvalue := 9007199254740992\n\treturn\nend\n"
		mut invalid := compiler_new(invalid_source.size() + 1)
		expect(lex(invalid, invalid_source)).to_be_true()
		expect(parse_module(invalid, 0, invalid.module_graph.entry_module[0])).to_be_true()
		expect(resolve(invalid)).to_be_true()
		expect(check(invalid)).to_be_false()
		expect(load_string(invalid.diagnostics.codes, 0)).to_equal("TRBN4004")
		expect(load_integer(invalid.diagnostics.lines, 0)).to_equal(2)
		expect(load_string(invalid.diagnostics.messages, 0)).to_equal(
			"Integer literal is outside the portable range",
		)
	end

	test("rejects direct-call arity mismatches during checking") do
		source := "def identity(value: Integer): Integer\n\treturn value\nend\n\ndef main()\n\tidentity()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_false()
		expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4004")
		expect(load_integer(state.diagnostics.lines, 0)).to_equal(6)
		expect(load_string(state.diagnostics.messages, 0)).to_equal("call argument count does not match identity")
	end

	test("rejects destructive calls through immutable bindings") do
		source := "def main()\n\tvalues: Array<Integer> := [1]\n\tvalues.push(2)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_false()
		expect(load_string(state.diagnostics.codes, 0)).to_equal("TRBN4004")
		expect(load_integer(state.diagnostics.lines, 0)).to_equal(3)
		expect(load_string(state.diagnostics.messages, 0)).to_equal("push receiver is immutable")
	end

	test("selects LLD only for compiler-driven Linux links") do
		compiler_source := "def compiler_main(source: String, path: String, check_only: Boolean): Integer\n\treturn 0\nend\n\ndef main()\n\treturn\nend\n"
		mut compiler_state := compiler_new(compiler_source.size() + 1)
		expect(lex(compiler_state, compiler_source)).to_be_true()
		expect(parse_module(compiler_state, 0, compiler_state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(compiler_state)).to_be_true()
		expect(check(compiler_state)).to_be_true()
		compiler_qbe := output_source(emit_qbe(compiler_state))
		expect(compiler_qbe.include?("data $trbn_project_linker_lld = { b \"-fuse-ld=lld\", b 0 }")).to_be_true()
		expect(
			compiler_qbe.include?(
				"data $trbn_dead_strip_linux = { b \"-Wl,--gc-sections,--strip-all,--no-eh-frame-hdr\", b 0 }",
			),
		).to_be_true()
		expect(compiler_qbe.include?("data $trbn_profile_linux_amd64 = { b \"linux-amd64-v0\", b 0 }")).to_be_true()
		expect(compiler_qbe.include?("data $trbn_qbe_linux_amd64 = { b \"amd64_sysv\", b 0 }")).to_be_true()
		expect(compiler_qbe.include?("@target_linux_amd64_check")).to_be_true()
		expect(compiler_qbe.include?("storel $trbn_qbe_linux_amd64, $trbn_selected_qbe_target")).to_be_true()
		expect(compiler_qbe.include?("storel $trbn_project_linker_lld, $trbn_project_selected_linker")).to_be_true()
		expect(compiler_qbe.include?("%has_linker =w cnel %linker, 0")).to_be_true()
		expect(compiler_qbe.include?("%tail =l phi @linker %linker_tail, @default %default_tail")).to_be_true()

		application_source := "def main()\n\treturn\nend\n"
		mut application_state := compiler_new(application_source.size() + 1)
		expect(lex(application_state, application_source)).to_be_true()
		expect(parse_module(application_state, 0, application_state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(application_state)).to_be_true()
		expect(check(application_state)).to_be_true()
		application_qbe := output_source(emit_qbe(application_state))
		expect(application_qbe.include?("trbn_project_linker_lld")).to_be_false()
	end

	test("checks and emits portable benchmark entry primitives") do
		source := "import trb/std/process\nimport trb/std/math as Numeric\n\ndef main()\n\tmut first := Process.argv()\n\tfirst.push(\"local\")\n\tsecond := Process.argv()\n\tparsed := second[0].to_i()\n\troot := Numeric.sqrt(parsed)\n\ttruncated := root.to_i()\n\tputs(first.size().to_s())\n\tputs(second.size().to_s())\n\tputs(truncated.to_s())\n\tnan := Numeric.sqrt(- 1)\n\tif nan != nan\n\t\tputs(\"nan\")\n\telse\n\t\tputs(\"number\")\n\tend\n\tputs(\"+9007199254740991\".to_i().to_s())\n\tputs(\"-9007199254740991\".to_i().to_s())\n\tvalue := - 2.75\n\tputs(value.to_i().to_s())\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		emitted := emit_qbe(state)
		expect(emitted.runtime_flags[1]).to_equal(1)
		expect(emitted.runtime_flags[2]).to_equal(0)
		expect(emitted.runtime_flags.size()).to_equal(8)
		expect(emitted.runtime_flags[5]).to_equal(0)
		qbe := output_source(emitted)
		expect(qbe.include?("storel %process_argc, $trbn_process_argc")).to_be_true()
		expect(qbe.include?("function l $trbn_process_argv()")).to_be_true()
		expect(qbe.include?("function l $trbn_string_to_integer(l %string)")).to_be_true()
		expect(qbe.include?("function l $trbn_integer_to_string(l %value)")).to_be_true()
		expect(qbe.include?("function l $trbn_float_to_integer(d %value)")).to_be_true()
		expect(qbe.include?("=d call $sqrt(d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=l dtosi ")).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-portable-entry"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case native_write_text(workspace + "/module.ssa", qbe)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case native_write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(workspace + "/program", ["9"])
			when Result::Ok(result)
				expect(result.success).to_be_true()
				expect(result.stdout).to_equal("2\n1\n3\nnan\n9007199254740991\n-9007199254740991\n-2\n")
				expect(result.stderr).to_equal("")
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
		end
	end

	test("preserves portable numeric conversion failure classes") do
		source := "import trb/std/process\nimport trb/std/math\n\ndef main()\n\tmode := Process.argv()[0]\n\tif mode == \"invalid-format\"\n\t\tputs(\"12x\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"sign-only\"\n\t\tputs(\"+\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"integer-range\"\n\t\tputs(\"9007199254740992\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"nan\"\n\t\tputs(Math.sqrt(- 1).to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"infinity\"\n\t\tzero := 0.0\n\t\tinfinite := 1.0 / zero\n\t\tputs(infinite.to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"float-range\"\n\t\toutside := 9007199254740992.0\n\t\tputs(outside.to_i().to_s())\n\t\treturn\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		checked := check(state)
		if !checked
			puts(load_integer(state.diagnostics.lines, 0).to_s() + ": " + load_string(state.diagnostics.messages, 0))
		end
		expect(checked).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-portable-entry-failures"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case native_write_text(workspace + "/module.ssa", output_source(emit_qbe(state)))
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case native_write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			modes := ["invalid-format", "sign-only", "integer-range", "nan", "infinity", "float-range"]
			expected := ["panic: invalid Integer\n", "panic: invalid Integer\n", "panic: Integer is outside the portable range\n", "panic: Float cannot be converted to Integer\n", "panic: Float cannot be converted to Integer\n", "panic: Integer is outside the portable range\n"]
			mut index := 0
			while index < modes.size()
				case Process.run(workspace + "/program", [modes[index]])
				when Result::Ok(result)
					expect(result.success).to_be_false()
					expect(result.stdout).to_equal("")
					expect(result.stderr).to_equal(expected[index])
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
				index += 1
			end
		end
	end

	test("rejects unsupported benchmark entry boundaries deterministically") do
		unsupported_package := load_file_root(
			"import trb/std/random\n\ndef main()\n\treturn\nend\n",
			"/tmp/portable-unsupported-package.trb",
		)
		expect(load_string(unsupported_package.diagnostics.codes, 0)).to_equal("TRBN4003")
		expect(load_string(unsupported_package.diagnostics.messages, 0)).to_equal("package imports are not supported by this compiler subset")

		member_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.environment()\n\treturn\nend\n"
		mut member_state := compiler_new(member_source.size() + 1)
		expect(lex(member_state, member_source)).to_be_true()
		expect(parse_module(member_state, 0, member_state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(member_state)).to_be_true()
		expect(check(member_state)).to_be_false()
		expect(load_string(member_state.diagnostics.codes, 0)).to_equal("TRBN4004")
		expect(load_string(member_state.diagnostics.messages, 0)).to_equal("unsupported standard package member")

		type_source := "import trb/std/math\n\ndef main()\n\tvalue := Math.sqrt(\"nine\")\n\treturn\nend\n"
		mut type_state := compiler_new(type_source.size() + 1)
		expect(lex(type_state, type_source)).to_be_true()
		expect(parse_module(type_state, 0, type_state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(type_state)).to_be_true()
		expect(check(type_state)).to_be_false()
		expect(load_string(type_state.diagnostics.codes, 0)).to_equal("TRBN4004")
		expect(load_string(type_state.diagnostics.messages, 0)).to_equal("expected Float, found String")

		arity_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.argv(1)\n\treturn\nend\n"
		mut arity_state := compiler_new(arity_source.size() + 1)
		expect(lex(arity_state, arity_source)).to_be_true()
		expect(parse_module(arity_state, 0, arity_state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(arity_state)).to_be_true()
		expect(check(arity_state)).to_be_false()
		expect(load_string(arity_state.diagnostics.codes, 0)).to_equal("TRBN4004")
		expect(load_string(arity_state.diagnostics.messages, 0)).to_equal("call argument count does not match Process")
	end

	test("inlines bounded scalar helpers outside lexical loops") do
		# Exercise the ordinary MIR path.
		source := "def scalar(value: Integer): Integer\n\tsum := value + 1\n\tproduct := sum * 2\n\treturn product / 2\nend\n\ndef main()\n\t_retained := {1 => 1}\n\tmut values: Array<Integer> := [0]\n\tmut index := 0\n\twhile index < 1\n\t\tvalues[0] = scalar(index)\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("call $trbn_integer_add")).to_be_false()
		expect(qbe.include?("call $trbn_integer_mul")).to_be_false()
		expect(qbe.include?("call $trbn_integer_divide")).to_be_false()
		# The pure scalar call preserves one earlier bound proof; the remaining
		# independent accesses still retain their checks in typed MIR.
		expect(occurrence_count(qbe, "call $trbn_fail(l $trbn_bounds_error, l 30)") >= 2).to_be_true()
	end

	test("routes dynamic Integer multiplication through the bounded checked entry") do
		source := "def multiply(left: Integer, right: Integer): Integer\n\treturn left * right\nend\n\ndef main()\n\t_value := multiply(2, 3)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("call $trbn_integer_mul(l ")).to_be_true()
		expect(qbe.include?("%c =l or %left, %right")).to_be_true()
		expect(qbe.include?("%u =l shr %c, 26")).to_be_true()
		expect(qbe.include?("jnz %u, @left_sign, @multiply")).to_be_true()
		expect(occurrence_count(qbe, "%right_zero =w ceql %right, 0")).to_equal(1)
	end

	test("omits only the impossible lower check for bounded nonnegative literal addition") do
		source := "def add_right(value: Integer): Integer\n\treturn value + 1\nend\n\ndef add_left(value: Integer): Integer\n\treturn 1 + value\nend\n\ndef add_limit(value: Integer): Integer\n\treturn value + 1024\nend\n\ndef add_large(value: Integer): Integer\n\treturn value + 1025\nend\n\ndef add_dynamic(left: Integer, right: Integer): Integer\n\treturn left + right\nend\n\ndef main()\n\tfirst := add_right(1)\n\tsecond := add_left(first)\n\tthird := add_limit(second)\n\tfourth := add_large(third)\n\t_value := add_dynamic(fourth, 1)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(
			occurrence_count(
				qbe,
				"%t0 =l add %p0, 1\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @integer_range_failure, @l0",
			),
		).to_equal(2)
		expect(
			qbe.include?(
				"%t0 =l add %p0, 1024\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @integer_range_failure, @l0",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"%t0 =l add %p0, 1025\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @integer_range_failure, @l0",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"%t0 =l add %p0, %p1\n" +
				"\t%t1 =l add %t0, 9007199254740991\n" +
				"\t%t2 =w cugtl %t1, 18014398509481982",
			),
		).to_be_true()
	end

	test("keeps the loop reserve independent when the non-loop reserve is exhausted") do
		# Exercise the ordinary MIR path.
		source := "def scalar(value: Integer, label: String): Integer\n\tmut result := value\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\treturn result\nend\n\ndef main()\n\t_retained := {1 => 1}\n\tmut values: Array<Integer> := [0]\n\tmut index := 0\n\twhile index < 1\n\t\tvalues[0] = scalar(index, \"managed caller\")\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("call $trbn_integer_add")).to_be_false()
		expect(qbe.include?("@integer_range_failure")).to_be_true()
		# A verified failure-only call keeps the captured position valid.
		expect(occurrence_count(qbe, "call $trbn_fail(l $trbn_bounds_error, l 30)") >= 2).to_be_true()
	end

	test("inlines only eligible scalar leaf calls in managed caller loops") do
		eligible_source := "def scalar(left: Integer, right: Integer): Integer\n\tsum := left + right\n\treturn sum * 2\nend\n\ndef main()\n\t_marker := {1 => 1}\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := scalar(index, 1)\n\t\tindex += value\n\tend\n\treturn\nend\n"
		mut eligible := compiler_new(eligible_source.size() + 1)
		expect(lex(eligible, eligible_source)).to_be_true()
		expect(parse_module(eligible, 0, eligible.module_graph.entry_module[0])).to_be_true()
		expect(resolve(eligible)).to_be_true()
		expect(check(eligible)).to_be_true()
		eligible_qbe := output_source(emit_qbe(eligible))
		expect(eligible_qbe.include?("call $trbnf0")).to_be_false()
		expect(eligible_qbe.include?("function l $trbnf0(")).to_be_true()
		expect(eligible_qbe.include?("# native retained scalar call ")).to_be_false()
		expect(eligible_qbe.include?("@integer_range_failure")).to_be_true()
		expect(
			occurrence_count(eligible_qbe, "@integer_range_failure\n"),
		).to_equal(2)

		non_loop_source := "def scalar(value: Integer): Integer\n\treturn value + 1\nend\n\ndef main()\n\t_value := scalar(1)\n\treturn\nend\n"
		mut non_loop := compiler_new(non_loop_source.size() + 1)
		expect(lex(non_loop, non_loop_source)).to_be_true()
		expect(parse_module(non_loop, 0, non_loop.module_graph.entry_module[0])).to_be_true()
		expect(resolve(non_loop)).to_be_true()
		expect(check(non_loop)).to_be_true()
		non_loop_qbe := output_source(emit_qbe(non_loop))
		expect(non_loop_qbe.include?("call $trbnf0")).to_be_true()
		expect(non_loop_qbe.include?("function l $trbnf0(")).to_be_true()
		expect(non_loop_qbe.include?("# native retained scalar call ")).to_be_false()
		expect(non_loop_qbe.include?("@integer_range_failure")).to_be_true()

		ineligible_source := "def choose(value: Integer): Integer\n\tif value > 0\n\t\treturn value\n\telse\n\t\treturn 0\n\tend\nend\n\ndef main()\n\t_marker := {1 => 1}\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := choose(index)\n\t\tindex += value + 1\n\tend\n\treturn\nend\n"
		mut ineligible := compiler_new(ineligible_source.size() + 1)
		expect(lex(ineligible, ineligible_source)).to_be_true()
		expect(parse_module(ineligible, 0, ineligible.module_graph.entry_module[0])).to_be_true()
		expect(resolve(ineligible)).to_be_true()
		expect(check(ineligible)).to_be_true()
		expect(output_source(emit_qbe(ineligible)).include?("call $trbnf0")).to_be_true()

		delegating_source := "def increment(value: Integer): Integer\n\treturn value + 1\nend\n\ndef delegating(value: Integer): Integer\n\treturn increment(value)\nend\n\ndef main()\n\t_marker := {1 => 1}\n\tmut index := 0\n\twhile index < 1\n\t\tindex = delegating(index)\n\tend\n\treturn\nend\n"
		mut delegating := compiler_new(delegating_source.size() + 1)
		expect(lex(delegating, delegating_source)).to_be_true()
		expect(parse_module(delegating, 0, delegating.module_graph.entry_module[0])).to_be_true()
		expect(resolve(delegating)).to_be_true()
		expect(check(delegating)).to_be_true()
		expect(output_source(emit_qbe(delegating)).include?("call $trbnf1")).to_be_true()
	end

	test("retains caller range checks after the literal-return inline budget") do
		# Exercise the ordinary MIR path.
		source := "def one(): Integer\n\treturn 1\nend\n\ndef main()\n\t_retained := {1 => 1}\n\t_owner := [1]\n\tmut value := 7\n\tmut index := 0\n\twhile index < 1\n\t\tvalue += one()\n\t\tvalue += one()\n\t\tvalue += one()\n\t\tindex += 1\n\tend\n\tputs(value.to_s())\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(occurrence_count(qbe, "call $trbnf0()")).to_equal(1)
		# Inlining does not invent caller range facts from the emitted operand.
		# All three call results retain range checks until MIR proves them.
		expect(occurrence_count(qbe, " =w cugtl %t")).to_equal(3)

	end

	test("branches on canonical Boolean values without repeated materialization") do
		# Exercise the ordinary MIR path.
		source := "def invert(value: Boolean): Boolean\n\treturn !value\nend\n\ndef main()\n\t_retained := {1 => 1}\n\t_owner := [1]\n\tmut index := 0\n\twhile index < 1\n\t\tif invert(false)\n\t\t\tputs(\"ok\")\n\t\tend\n\t\tindex += 1\n\tend\n\tif invert(true)\n\t\tputs(\"bad\")\n\tend\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		scalar_body := qbe.split("function l $trbnf0(")[1].split("\n}\n")[0]
		# Inner temporary-root scopes also contain closing braces.
		main_body := qbe.split("function $trbnf1(")[1].split("\nfunction ")[0].split("\nexport function ")[0]
		expect(scalar_body.include?(" =l ceql ")).to_be_true()
		expect(main_body.include?(" =l csltl ")).to_be_true()
		expect(main_body.include?(" =l ceql ")).to_be_true()
		expect(scalar_body.include?("extuw")).to_be_false()
		expect(main_body.include?("extuw")).to_be_false()
		expect(main_body.include?(" =w cnel ")).to_be_false()
	end

	test("rejects non-Boolean branch conditions") do
		sources := ["def main()\n\tif 1\n\t\tputs(\"bad\")\n\tend\nend\n", "def main()\n\twhile 4294967296\n\t\tputs(\"bad\")\n\tend\nend\n"]
		mut index := 0
		while index < sources.size()
			source := sources[index]
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.module_graph.entry_module[0])).to_be_true()
			expect(resolve(state)).to_be_true()
			expect(check(state)).to_be_false()
			index += 1
		end
	end

