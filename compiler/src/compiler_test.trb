def compiler_test_instruction_with_cell(instruction: MirInstruction, field: Integer, value: Integer): MirInstruction
	mut row := [instruction.kind, instruction.result, instruction.first, instruction.second, instruction.payload, instruction.failure, instruction.source_id, instruction.line]
	row[field] = value
	return MirInstruction.new(kind: row[0], result: row[1], first: row[2], second: row[3], payload: row[4], failure: row[5], source_id: row[6], line: row[7])
end

def clear_array_fixture_binary_plans(mut state: CompilerState, expected_count: Integer)
	# These fixtures contain only Integer < and +=. Every other origin,
	# including loop and Array-index origins, must have no direct-path fact.
	mut origin := 0
	mut count := 0
	while origin < state.token_count[0]
		plan := load_integer(state.mir_nonnegative_facts, origin)
		if plan != 0
			token := load_string(state.token_texts, origin)
			mut expected := 0
			if token == "<"
				expected = 56
			end
			if token == "+="
				expected = 17
			end
			expect(plan).to_equal(expected)
			count += 1
		end
		store_integer(state.mir_nonnegative_facts, origin, 0)
		origin += 1
	end
	expect(count).to_equal(expected_count)
end

def frontend_test_source(): String
	return "record Pair\n\tleft: Integer\n\tright: Integer\nend\n\ndef add(left: Integer, right: Integer): Integer\n\treturn left + right\nend\n\ndef main()\n\tpair := Pair.new(left: 20, right: 22)\n\tmut values: Array<Integer> := []\n\tvalues.push(add(pair.left, pair.right))\n\tmessage := \"o\" + \"k\"\n\tmut repetitions := 0\n\twhile repetitions < 1000000\n\t\trepeated := repetitions\n\t\trepetitions = repeated + 1\n\tend\n\tif values[0] == 42\n\t\tif message != \"bad\"\n\t\t\tif repetitions == 1000000\n\t\t\t\tputs(message)\n\t\t\telse\n\t\t\t\tputs(\"bad\")\n\t\t\tend\n\t\telse\n\t\t\tputs(\"bad\")\n\t\tend\n\telse\n\t\tputs(\"bad\")\n\tend\n\treturn\nend\n"
end

def output_source(output: QbeOutput): String
	mut writer := StringBuilder.new()
	mut index := 0
	while index < output.count[0]
		writer.append(load_string(output.lines, index))
		writer.append("\n")
		index += 1
	end
	return writer.to_s()
end

def required_test_source(path: String): String
	case native_read_text(path)
	when Result::Ok(source)
		return source
	when Result::Err(error)
		puts(error.operation + ": " + error.message)
		return ""
	end
end

def scale_test_source(count: Integer): String
	mut writer := StringBuilder.new()
	writer.append("def f0(value: Integer): Integer\n\treturn value\nend\n\n")
	mut index := 1
	while index < count
		writer.append("def f" + index.to_s() + "(value: Integer): Integer\n\treturn f")
		writer.append((index - 1).to_s())
		writer.append("(value)\nend\n\n")
		index += 1
	end
	writer.append("def main()\n\tvalue := f" + (count - 1).to_s() + "(1)\n\treturn\nend\n")
	return writer.to_s()
end

def repeat_text(fragment: String, count: Integer): String
	mut writer := StringBuilder.new()
	mut index := 0
	while index < count
		writer.append(fragment)
		index += 1
	end
	return writer.to_s()
end

def occurrence_count(value: String, needle: String): Integer
	mut count := 0
	mut index := 0
	while index + needle.size() <= value.size()
		if string_starts_at(value, index, needle)
			count += 1
		end
		index += 1
	end
	return count
end

def large_scalar_inline_test_source(): String
	mut writer := StringBuilder.new()
	writer.append("def scalar(value: Integer): Integer\n\treturn value + 1\nend\n\n")
	mut index := 1
	while index < 32
		writer.append("def filler" + index.to_s() + "(value: Integer): Integer\n\treturn value\nend\n\n")
		index += 1
	end
	writer.append("def main()\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := scalar(index)\n\t\tindex += value\n\tend\n\treturn\nend\n")
	return writer.to_s()
end

describe("Native TypeRB frontend") do
	test("skips unreachable structured statements without changing block boundaries") do
		source := "def main()\nreturn\nif true\nwhile true\nputs(\"unreachable\")\nend\nelse\nreturn\nend\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		output := emit_qbe(state)
		expect(has_diagnostic(state)).to_be_false()
		expect(output_source(output).include?("export function w $main")).to_be_true()
	end

	test("still type checks unreachable structured statements") do
		source := "def main()\nreturn\nif 1\nputs(\"unreachable\")\nend\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_false()
	end

	test("checks every elsif condition and isolates branch bindings") do
		source := "def main()\nif false\nvalue := 1\nputs(value)\nelsif false\nvalue := true\nputs(value)\nelsif true\nvalue := \"selected\"\nputs(value)\nelse\nvalue := 2.0\nputs(value == 2.0)\nend\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(mir_function_index(state.scalar_mir, 0)).to_equal(- 1)
		expect(output_source(emit_qbe(state)).include?("export function w $main")).to_be_true()
	end

	test("retains bounds checks when an elsif invalidates the loop induction") do
		source := "def read(values: Array<Integer>): Integer\nmut index := 0\nmut total := 0\nwhile index < values.size()\nif false\nreturn 0\nelsif true\nindex =- 2\nend\ntotal += values[index]\nindex += 1\nend\nreturn total\nend\ndef main()\nreturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(mir_function_index(state.scalar_mir, 0)).to_equal(- 1)
		expect(output_source(emit_qbe(state)).include?("@array_bounds_failure")).to_be_true()
	end

	test("lowers, verifies, and selects complete checked scalar leaf MIR") do
		source := "def scalar(value: Integer, scale: Float, enabled: Boolean): Float\n\tnext_value := value + 1\n\tconverted: Float := next_value\n\tproduct := converted * scale\n\tselected := enabled == true\n\tinverted := !selected\n\toffset := - value\n\tif_unused := inverted != false\n\treturn product + offset\nend\n\ndef delegated(value: Integer): Integer\n\treturn scalar(value, 1.0, true).to_i()\nend\n\ndef mutable_leaf(value: Integer): Integer\n\tmut result := value\n\treturn result\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(mir_function_index(state.scalar_mir, 0) >= 0).to_be_true()
		expect(mir_function_index(state.scalar_mir, 1)).to_equal(- 1)
		expect(mir_function_index(state.scalar_mir, 2) >= 0).to_be_true()
		expect(state.scalar_mir.literal_texts.size()).to_equal(3)
		mut literal_index := 0
		while state.scalar_mir.instructions[literal_index].kind != 6
			literal_index += 1
		end
		state.scalar_mir.instructions[literal_index] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[literal_index], 2, 0)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR Integer literal fact differs")
	end

	test("relocates each committed MIR literal once and preserves its source line") do
		source := "def first(): Integer\n\treturn 17\nend\n\ndef second(): Integer\n\treturn 29\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		expect(state.scalar_mir.literal_texts.size()).to_equal(2)
		expect(state.scalar_mir.instructions.size()).to_equal(2)
		expect(state.scalar_mir.instructions[0].payload).to_equal(0)
		expect(state.scalar_mir.instructions[1].payload).to_equal(1)
		expect(state.scalar_mir.literal_texts[0]).to_equal("17")
		expect(state.scalar_mir.literal_texts[1]).to_equal("29")
		expect(state.scalar_mir.instructions[0].line).to_equal(2)
		expect(state.scalar_mir.instructions[1].line).to_equal(6)
	end

	test("selects a verified guarded Integer multiply for scalar MIR in a managed loop") do
		source := "def product(left: Integer, right: Integer): Integer\n\treturn left * right\nend\n\ndef main()\n\tmarker := \"managed caller\"\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := product(index, index - 1)\n\t\tindex += value + 1\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		function_index := mir_function_index(state.scalar_mir, 0)
		expect(function_index >= 0).to_be_true()
		function := state.scalar_mir.functions[function_index]
		block := state.scalar_mir.blocks[function.block_start]
		instruction_index := block.instruction_start
		expect(state.scalar_mir.instructions[instruction_index].kind).to_equal(7)
		expect(state.scalar_mir.instructions[instruction_index].payload).to_equal(12)
		qbe := output_source(emit_qbe(state))
		expect(occurrence_count(qbe, " =w cultl ")).to_equal(1)
		expect(qbe.include?(", 67108864")).to_be_true()
		expect(occurrence_count(qbe, "call $trbn_integer_mul")).to_equal(1)

		state.scalar_mir.instructions[instruction_index] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[instruction_index], 4, 14)
		expect(verify_mir(state.scalar_mir, true)).to_equal(
			"MIR scalar binary type differs",
		)
		state.scalar_mir.instructions[instruction_index] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[instruction_index], 4, 12)
		state.scalar_mir.instructions[instruction_index] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[instruction_index], 5, - 1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR failure target does not exist")
	end

	test("selects a verified guarded Integer add for loop-local scalar MIR") do
		source := "def sum(left: Integer, right: Integer): Integer\n\treturn left + right\nend\n\ndef main()\n\tlefts := [1]\n\trights := [2]\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := sum(lefts[index], rights[index])\n\t\tindex += value\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		function_index := mir_function_index(state.scalar_mir, 0)
		expect(function_index >= 0).to_be_true()
		function := state.scalar_mir.functions[function_index]
		block := state.scalar_mir.blocks[function.block_start]
		instruction_index := block.instruction_start
		expect(state.scalar_mir.instructions[instruction_index].kind).to_equal(7)
		expect(state.scalar_mir.instructions[instruction_index].payload).to_equal(13)
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?(", 9007199254740992")).to_be_true()
		expect(qbe.include?("call $trbn_integer_add(l ")).to_be_true()

		state.scalar_mir.instructions[instruction_index] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[instruction_index], 4, 14)
		expect(verify_mir(state.scalar_mir, true)).to_equal(
			"MIR scalar binary type differs",
		)
		state.scalar_mir.instructions[instruction_index] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[instruction_index], 4, 13)
		state.scalar_mir.instructions[instruction_index] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[instruction_index], 5, - 1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR failure target does not exist")
	end

	test("lowers one complete Array induction helper through verified MIR") do
		source := "def scan(values: Array<Integer>)\n\tmut index := 0\n\twhile index < values.size()\n\t\tvalue := values[index]\n\t\tindex += 1\n\tend\n\treturn\nend\n\ndef main()\n\tscan([10, 20])\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		function_index := mir_function_index(state.scalar_mir, 0)
		expect(function_index >= 0).to_be_true()
		expect(state.scalar_mir.functions[function_index].block_count).to_equal(6)
		function := state.scalar_mir.functions[function_index]
		body := state.scalar_mir.blocks[function.block_start + 2]
		expect(state.scalar_mir.instructions[body.instruction_start].payload).to_equal(2)
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function $trbnf0(l %p0)")).to_be_true()
		expect(
			qbe.include?(
				"function $trbnf0(l %p0) {\n@start\n" +
				"\t%t2 =l add %p0, 8\n\t%t3 =l loadl %t2\n" +
				"\t%t4 =l add %p0, 24\n\t%t5 =l loadl %t4\n" +
				"\tjmp @l0\n@l0\n\t%t0 =l phi @start 0, @l1 %t1",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"@l1\n\t%t7 =l mul %t0, 8\n\t%t8 =l add %t5, %t7\n" +
				"\t%t9 =l loadl %t8\n\t%t1 =l add %t0, 1\n\tjmp @l0\n" +
				"@l2\n\tjmp @return",
			),
		).to_be_true()
		expect(qbe.include?("@array_bounds_failure")).to_be_false()
		expect(qbe.include?("csgtl %t1, 9007199254740991")).to_be_false()
		expect(qbe.include?("\t%v0 =l alloc8 8")).to_be_false()
		expect(qbe.include?(" =l loadl %v0")).to_be_false()
		expect(qbe.include?("storel %t1, %v0")).to_be_false()
		expect(occurrence_count(qbe, " =l sar ")).to_equal(0)
		clear_array_fixture_binary_plans(state, 2)
		expect(output_source(emit_qbe(state))).to_equal(qbe)
		state.scalar_mir.instructions[body.instruction_start] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start], 4, 1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		optimize_verified_mir(state.scalar_mir)
		expect(state.scalar_mir.instructions[body.instruction_start].payload).to_equal(2)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")

		load := state.scalar_mir.instructions[body.instruction_start + 1]
		mut value_index := 0
		while state.scalar_mir.values[value_index].id != load.result
			value_index += 1
		end
		value := state.scalar_mir.values[value_index]
		state.scalar_mir.values[value_index] = MirValue.new(
			function_id: value.function_id,
			id: value.id,
			type_id: 5,
			source_id: value.source_id,
			line: value.line,
		)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR Array load type differs")
		state.scalar_mir.values[value_index] = value
		state.scalar_mir.instructions[body.instruction_start] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start], 5, state.scalar_mir.functions[function_index].entry_block + 3)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR failure target is not a trap block")
		state.scalar_mir.instructions[body.instruction_start] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start], 5, state.scalar_mir.functions[function_index].entry_block + 5)
		state.scalar_mir.instructions[body.instruction_start] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start], 3, state.scalar_mir.arguments[state.scalar_mir.blocks[state.scalar_mir.functions[function_index].block_start + 1].parameter_start])
		# The header value dominates the body, but is not the admitted induction operand.
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR Array induction proof differs")
		state.scalar_mir.instructions[body.instruction_start] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start], 3, state.scalar_mir.arguments[body.parameter_start])
		state.scalar_mir.instructions[body.instruction_start + body.instruction_count - 1] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start + body.instruction_count - 1], 4, 2)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR Array induction proof differs")
		state.scalar_mir.instructions[body.instruction_start + body.instruction_count - 1] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start + body.instruction_count - 1], 4, 1)
		state.scalar_mir.instructions[body.instruction_start] = compiler_test_instruction_with_cell(state.scalar_mir.instructions[body.instruction_start], 6, 1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR instruction origin is invalid")
	end

	test("lowers one complete Array Integer reduction through two MIR phis") do
		source := "def sum(values: Array<Integer>): Integer\n\tmut index := 0\n\tmut total := 0\n\twhile index < values.size()\n\t\ttotal += values[index]\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		function_index := mir_function_index(state.scalar_mir, 0)
		expect(function_index >= 0).to_be_true()
		function := state.scalar_mir.functions[function_index]
		expect(function.block_count).to_equal(6)
		header := state.scalar_mir.blocks[function.block_start + 1]
		body := state.scalar_mir.blocks[function.block_start + 2]
		exit := state.scalar_mir.blocks[function.block_start + 3]
		expect(header.parameter_count).to_equal(2)
		expect(body.parameter_count).to_equal(2)
		expect(exit.parameter_count).to_equal(1)
		expect(state.scalar_mir.instructions[body.instruction_start].payload).to_equal(2)
		qbe := output_source(emit_qbe(state))
		expect(
			qbe.include?(
				"function l $trbnf0(l %p0) {\n@start\n\t%return_value =l alloc8 8\n" +
				"\t%t4 =l add %p0, 8\n\t%t5 =l loadl %t4\n" +
				"\t%t6 =l add %p0, 24\n\t%t7 =l loadl %t6\n" +
				"\tjmp @l0\n@l0\n\t%t0 =l phi @start 0, @l4 %t1\n" +
				"\t%t2 =l phi @start 0, @l4 %t3",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"@l1\n\t%t9 =l mul %t0, 8\n\t%t10 =l add %t7, %t9\n" +
				"\t%t11 =l loadl %t10\n\t%t3 =l add %t2, %t11\n" +
				"\t%t12 =w csgtl %t3, 9007199254740991",
			),
		).to_be_true()
		expect(qbe.include?("\t%t13 =w csltl %t3, -9007199254740991")).to_be_true()
		expect(qbe.include?("@l4\n\t%t1 =l add %t0, 1\n\tjmp @l0")).to_be_true()
		expect(qbe.include?("\tstorel %t2, %return_value")).to_be_true()
		expect(qbe.include?("@array_bounds_failure")).to_be_false()
		expect(qbe.include?("csgtl %t1, 9007199254740991")).to_be_false()
		expect(qbe.include?("\t%v0 =l alloc8 8")).to_be_false()
		expect(occurrence_count(qbe, " =l sar ")).to_equal(0)
		clear_array_fixture_binary_plans(state, 3)
		expect(output_source(emit_qbe(state))).to_equal(qbe)

		state.scalar_mir.arguments[body.first_argument_start + 1] = state.scalar_mir.arguments[body.parameter_start]
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR Array induction proof differs")
	end

	test("lowers one complete Array Float reduction through verified MIR") do
		source := "def sum(values: Array<Float>): Float\n\tmut index := 0\n\tmut total: Float := 0.0\n\twhile index < values.size()\n\t\ttotal += values[index]\n\t\tindex += 1\n\tend\n\treturn total\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		function_index := mir_function_index(state.scalar_mir, 0)
		expect(function_index >= 0).to_be_true()
		function := state.scalar_mir.functions[function_index]
		body := state.scalar_mir.blocks[function.block_start + 2]
		expect(state.scalar_mir.values[0].type_id).to_equal(6)
		expect(state.scalar_mir.instructions[body.instruction_start].payload).to_equal(2)
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("function d $trbnf0(l %p0)")).to_be_true()
		expect(qbe.include?(" =d phi @start d_0.0, ")).to_be_true()
		expect(qbe.include?(" =d loadd ")).to_be_true()
		expect(qbe.include?(" =d add ")).to_be_true()
		expect(qbe.include?("stored %t2, %return_value")).to_be_true()
		expect(qbe.include?("@array_bounds_failure")).to_be_false()
		expect(qbe.include?("csgtl %t1, 9007199254740991")).to_be_false()
		load := state.scalar_mir.instructions[body.instruction_start + 1]
		mut value_index := 0
		while state.scalar_mir.values[value_index].id != load.result
			value_index += 1
		end
		value := state.scalar_mir.values[value_index]
		state.scalar_mir.values[value_index] = MirValue.new(
			function_id: value.function_id,
			id: value.id,
			type_id: 1,
			source_id: value.source_id,
			line: value.line,
		)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR Array load type differs")
	end

	test("keeps unsupported Array Float reductions on the direct path") do
