		expect(parse_module(non_unit, 0, non_unit.entry_module[0])).to_be_true()
		expect(resolve(non_unit)).to_be_true()
		expect(check(non_unit)).to_be_true()
		non_unit_qbe := output_source(emit_qbe(non_unit))
		expect(occurrence_count(non_unit_qbe, " =l sar ")).to_equal(1)

		nested_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tif index == 0\n\t\t\tvalue := values[index]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn\nend\n"
