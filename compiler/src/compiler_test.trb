	test("grows chunked storage only as elements are stored") do
		empty := integer_storage(0)
		expect(empty.chunks[0].size()).to_equal(0)
		expect(empty.used[0]).to_equal(0)
		expect(store_integer(empty, 0, 1)).to_be_false()

		integers := integer_storage(513)
		expect(integers.chunks[0].size()).to_equal(0)
		expect(store_integer(integers, 0, 10)).to_be_true()
		expect(store_integer(integers, 255, 20)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(1)
		expect(integers.chunks[0][0].size()).to_equal(256)
		expect(store_integer(integers, 256, 30)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(2)
		expect(store_integer(integers, 512, 40)).to_be_true()
		expect(integers.chunks[0].size()).to_equal(3)
		expect(integers.chunks[0][1].size()).to_equal(256)
		expect(integers.chunks[0][2].size()).to_equal(256)
		expect(integers.used[0]).to_equal(513)
		expect(load_integer(integers, 0)).to_equal(10)
		expect(load_integer(integers, 255)).to_equal(20)
		expect(load_integer(integers, 256)).to_equal(30)
		expect(load_integer(integers, 512)).to_equal(40)
		expect(store_integer(integers, - 1, 50)).to_be_false()
		expect(store_integer(integers, 513, 50)).to_be_false()
		expect(integers.used[0]).to_equal(513)

		strings := string_storage(257)
		expect(store_string(strings, 0, "first")).to_be_true()
		expect(store_string(strings, 256, "last")).to_be_true()
		expect(load_string(strings, 0)).to_equal("first")
		expect(load_string(strings, 256)).to_equal("last")
		expect(store_string(strings, 257, "outside")).to_be_false()
	end

	test("returns the last matching symbol without changing missing lookup") do
		expect(character_in("a", "abc")).to_be_true()
		expect(character_in("c", "abc")).to_be_true()
		expect(character_in("z", "abc")).to_be_false()

		mut state := compiler_new(128)
		add_module(state, "shared", "/first.trb")
		add_module(state, "other", "/other.trb")
		add_module(state, "shared", "/last.trb")
		expect(find_module(state, "shared")).to_equal(2)
		expect(find_module(state, "missing")).to_equal(- 1)

		store_string(state.function_names, 0, "value")
		store_integer(state.function_modules, 0, 0)
		store_string(state.function_names, 1, "value")
		store_integer(state.function_modules, 1, 1)
		store_string(state.function_names, 2, "value")
		store_integer(state.function_modules, 2, 0)
		store_string(state.function_names, 3, "other")
		store_integer(state.function_modules, 3, 0)
		state.function_count[0] = 4
		store_string(state.record_names, 0, "Value")
		store_integer(state.record_modules, 0, 0)
		store_string(state.record_names, 1, "Value")
		store_integer(state.record_modules, 1, 1)
		store_string(state.record_names, 2, "Value")
		store_integer(state.record_modules, 2, 0)
		store_string(state.record_names, 3, "Other")
		store_integer(state.record_modules, 3, 0)
		state.record_count[0] = 4
		expect(find_record_type(state, "Record#2")).to_equal(2)
		expect(find_record_type(state, "Record#4")).to_equal(- 1)

		store_string(state.import_symbols, 0, "load")
		store_integer(state.import_modules, 0, 0)
		store_string(state.import_symbols, 1, "load")
		store_integer(state.import_modules, 1, 0)
		store_string(state.import_symbols, 2, "save")
		store_integer(state.import_modules, 2, 0)
		store_string(state.import_symbols, 3, "load")
		store_integer(state.import_modules, 3, 1)
		state.import_count[0] = 4
		store_integer(state.module_import_starts, 0, 0)
		store_integer(state.module_import_counts, 0, 3)
		store_integer(state.module_import_starts, 1, 3)
		store_integer(state.module_import_counts, 1, 1)
		state.function_lookup[function_index_key(0, "value")] = 2
		state.function_lookup[function_index_key(1, "value")] = 1
		state.function_lookup[function_index_key(0, "other")] = 3
		expect(find_function_in_module(state, 0, "value")).to_equal(2)
		expect(find_function_in_module(state, 0, "other")).to_equal(3)
		expect(find_function_in_module(state, 1, "value")).to_equal(1)
		expect(find_function_in_module(state, 0, "missing")).to_equal(- 1)
		expect(find_record_in_module(state, 0, "Value")).to_equal(2)
		expect(find_record_in_module(state, 0, "Other")).to_equal(3)
		expect(find_record_in_module(state, 0, "Missing")).to_equal(- 1)
		expect(find_import_binding(state, 0, "load")).to_equal(1)
		expect(find_import_binding(state, 0, "save")).to_equal(2)
		expect(find_import_binding(state, 1, "load")).to_equal(3)
		expect(find_import_binding(state, 0, "missing")).to_equal(- 1)

		store_integer(state.record_field_starts, 0, 0)
		store_integer(state.record_field_counts, 0, 3)
		store_string(state.field_names, 0, "item")
		store_string(state.field_names, 1, "other")
		store_string(state.field_names, 2, "item")
		expect(find_field(state, 0, "item")).to_equal(2)
		expect(find_field(state, 0, "missing")).to_equal(- 1)

		mut locals := locals_new(4)
		store_string(locals.names, 0, "item")
		store_string(locals.names, 1, "other")
		store_string(locals.names, 2, "item")
		locals.count[0] = 3
		expect(local_find(locals, "item")).to_equal(2)
		expect(local_find(locals, "missing")).to_equal(- 1)

	end

	test("preserves ASCII identifier and digit classification after hot-path ordering") do
		identifier_start := "fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_"
		identifier_continue := "0123456789" + identifier_start
		expect(character_in("a", identifier_start)).to_be_true()
		expect(character_in("Z", identifier_start)).to_be_true()
		expect(character_in("_", identifier_start)).to_be_true()
		expect(character_in("0", identifier_start)).to_be_false()
		expect(character_in("-", identifier_start)).to_be_false()
		expect(character_in("a", identifier_continue)).to_be_true()
		expect(character_in("Z", identifier_continue)).to_be_true()
		expect(character_in("_", identifier_continue)).to_be_true()
		expect(character_in("0", identifier_continue)).to_be_true()
		expect(character_in("-", identifier_continue)).to_be_false()
		expect(character_in("0", "0123456789")).to_be_true()
		expect(character_in("9", "0123456789")).to_be_true()
		expect(character_in("a", "0123456789")).to_be_false()
	end

	test("carries exact checked source origins without preserving computed text") do
		mut literal_state := compiler_new(4)
		expect(lex(literal_state, "1")).to_be_true()
		mut literal_position := [0]
		mut literal_locals := locals_new(4)
		literal := check_primary(literal_state, literal_position, literal_locals, "Integer")
		expect(literal.origin).to_equal(0)
		expect(load_string(literal_state.token_texts, literal.origin)).to_equal("1")

		mut identifier_state := compiler_new(8)
		expect(lex(identifier_state, "value")).to_be_true()
		mut identifier_position := [0]
		mut identifier_locals := locals_new(4)
		expect(local_add(identifier_state, identifier_locals, "value", "Integer", 0, 1)).to_be_true()
		identifier := check_primary(identifier_state, identifier_position, identifier_locals, "Integer")
		expect(identifier.origin).to_equal(0)
		expect(load_string(identifier_state.token_texts, identifier.origin)).to_equal("value")

		mut parenthesized_state := compiler_new(8)
		expect(lex(parenthesized_state, "(1)")).to_be_true()
		mut parenthesized_position := [0]
		mut parenthesized_locals := locals_new(4)
		parenthesized := check_primary(
			parenthesized_state,
			parenthesized_position,
			parenthesized_locals,
			"Integer",
		)
		expect(parenthesized.origin).to_equal(1)

		mut computed_state := compiler_new(8)
		expect(lex(computed_state, "1 + 2")).to_be_true()
		mut computed_position := [0]
		mut computed_locals := locals_new(4)
		computed := check_expression(computed_state, computed_position, computed_locals, 1, "Integer")
		expect(computed.origin).to_equal(9007199254740991)

		mut unary_state := compiler_new(8)
		expect(lex(unary_state, "- 1")).to_be_true()
		mut unary_position := [0]
		mut unary_locals := locals_new(4)
		unary := check_primary(unary_state, unary_position, unary_locals, "Integer")
		expect(unary.origin).to_equal(9007199254740991)
	end

	test("defers contextual conversion until the completed expression") do
		mut state := compiler_new(16)
		expect(lex(state, "((7)) / 2")).to_be_true()
		mut position := [0]
		mut locals := locals_new(4)
		value := check_primary(state, position, locals, "Float")
		expect(value.type_name).to_equal("Integer")
		expect(state.diagnostic_count[0]).to_equal(0)

		mut complete_position := [0]
		complete := check_expression(state, complete_position, locals, 1, "Float")
		# Outside active scalar MIR, widening is validated here and emitted later.
		expect(complete.type_name).to_equal("Integer")
		expect(state.diagnostic_count[0]).to_equal(0)
	end

	test("checks contextual postfix results after inferring their receivers") do
		expressions := ["((7 / 2).to_s())", "(([7]).size()).to_s()", "(\"12\").to_i().to_s()"]
		mut index := 0
		while index < expressions.size()
			mut state := compiler_new(64)
			expect(lex(state, expressions[index])).to_be_true()
			mut position := [0]
			mut locals := locals_new(4)
			value := check_expression(state, position, locals, 1, "String")
			expect(value.type_name).to_equal("String")
			expect(state.diagnostic_count[0]).to_equal(0)
			index += 1
		end
	end

	test("checks a generated declaration-chain scale probe") do
		source := scale_test_source(128)
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(state.function_count[0]).to_equal(129)
		expect(output_source(emit_qbe(state)).include?("function l $trbnf127")).to_be_true()
	end

	test("lexes and parses the registered declaration and expression subset") do
		source := frontend_test_source()
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(has_diagnostic(state)).to_be_false()
		expect(state.record_count[0]).to_equal(1)
		expect(load_string(state.record_names, 0)).to_equal("Pair")
		expect(state.field_count[0]).to_equal(2)
		expect(load_string(state.field_names, 0)).to_equal("left")
		expect(load_string(state.field_names, 1)).to_equal("right")
		expect(state.function_count[0]).to_equal(2)
		expect(load_string(state.function_names, 0)).to_equal("add")
		expect(load_string(state.function_names, 1)).to_equal("main")
		expect(load_string(state.function_result_types, 0)).to_equal("Integer")
		expect(load_string(state.function_result_types, 1)).to_equal("Void")
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
	end

	test("keeps declarations and named imports scoped to their source modules") do
		mut state := compiler_new(16384)
		add_module(state, "main", "/project/main.trb")
		add_module(state, "alpha", "/project/alpha.trb")
		add_module(state, "beta", "/project/beta.trb")
		state.entry_module[0] = 0
		sources := [
			"import { left } from alpha\nimport { right } from beta\n\ndef main()\n\tif left() + right() == 42\n\t\tputs(\"modules-ok\")\n\tend\n\treturn\nend\n",
			"record Value\n\tnumber: Integer\nend\n\ndef normalize(value: Integer): Integer\n\treturn value\nend\n\ndef left(): Integer\n\tvalue := Value.new(number: 20)\n\treturn normalize(value.number)\nend\n",
			"record Value\n\tnumber: Integer\nend\n\ndef normalize(value: Integer): Integer\n\treturn value\nend\n\ndef right(): Integer\n\tvalue := Value.new(number: 22)\n\treturn normalize(value.number)\nend\n",
		]
		mut module_index := 0
		while module_index < sources.size()
			start := state.token_count[0]
			expect(lex_module(state, sources[module_index], module_index)).to_be_true()
			expect(parse_module(state, start, module_index)).to_be_true()
			module_index += 1
		end
		expect(load_integer(state.module_import_starts, 0)).to_equal(0)
		expect(load_integer(state.module_import_counts, 0)).to_equal(2)
		expect(load_integer(state.module_import_starts, 1)).to_equal(2)
		expect(load_integer(state.module_import_counts, 1)).to_equal(0)
		expect(load_integer(state.module_import_starts, 2)).to_equal(2)
		expect(load_integer(state.module_import_counts, 2)).to_equal(0)
		mut import_index := 0
		while import_index < state.import_count[0]
			path := load_string(state.import_paths, import_index)
			if path == "alpha"
				store_integer(state.import_targets, import_index, 1)
			else
				store_integer(state.import_targets, import_index, 2)
			end
			import_index += 1
		end
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(state.record_count[0]).to_equal(2)
		expect(state.function_count[0]).to_equal(5)
		first := output_source(emit_qbe(state))
		second := output_source(emit_qbe(state))
		expect(first).to_equal(second)
	end

	test("rejects an unsupported source character deterministically") do
		source := "def main()\n\t@\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_false()
		expect(state.diagnostic_count[0]).to_equal(1)
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4001")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("unsupported source character @")
	end

	test("rejects an unfinished function deterministically") do
		source := "def main()\n\tputs(\"missing\")\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4002")
		expect(load_string(state.diagnostic_messages, 0)).to_equal("expected end")
	end

	test("rejects statement-leading next bindings before resolution") do
		declarations := ["next := 1", "next: Integer := 1"]
		mut index := 0
		while index < declarations.size()
			source := "def main()\n\t" + declarations[index] + "\n\tputs(next.to_s())\nend\n"
			mut state := compiler_new(source.size() + 1)
			expect(lex(state, source)).to_be_true()
			expect(parse_module(state, 0, state.entry_module[0])).to_be_false()
			expect(state.diagnostic_count[0]).to_equal(1)
			expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4002")
			expect(load_integer(state.diagnostic_lines, 0)).to_equal(2)
			expect(load_string(state.diagnostic_messages, 0)).to_equal("next does not take a value")
			index += 1
		end
	end

	test("preserves contextual next identifiers and nearby names") do
		source := "record Value\n\tnext: Integer\nend\n\ndef next_parameter(next: Integer): Integer\n\treturn next\nend\n\ndef main()\n\tnext_value := 1\n\tnext2 := 2\n\tmut next := 3\n\tvalue := Value.new(next: 4)\n\tputs((next_value + next_parameter(next2) + next + value.next).to_s())\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
	end

	test("parses the checked-in compiler closure through its own frontend") do
		root := Process.environment("TYPE_RB_NATIVE_ROOT")
		if root == nil
			expect(true).to_be_true()
		else
			base := root + "/compiler/src/"
			names := ["compiler", "literals", "mir", "iteration_mir", "path", "hash_types", "hash_mir", "storage", "state", "parser", "checked_values", "resolution", "hash_checked", "iteration_checked", "mir_analysis", "mir_construction", "mir_control", "mir_calls", "mir_flow", "mir_logical", "mir_instructions", "checked_types", "checked_program", "qbe_output", "hash_runtime", "mir_builder", "mir_passes", "mir_verifier", "project_config", "qbe_constants", "qbe_context", "qbe_memory", "qbe_numeric", "qbe_mir", "qbe_control", "qbe_runtime"]
			mut sources: Array<String> := []
			names.each do |name|
				sources.push(required_test_source(base + name + ".trb"))
			end
			mut capacity := 0
			mut module_index := 0
			while module_index < sources.size()
				expect(!sources[module_index].empty?()).to_be_true()
				capacity += sources[module_index].size() + 1
				module_index += 1
			end
			mut state := compiler_new(capacity)
			module_index = 0
			while module_index < names.size()
				add_module(state, names[module_index], base + names[module_index] + ".trb")
				module_index += 1
			end
			state.entry_module[0] = 0
			module_index = 0
			while module_index < sources.size()
				start := state.token_count[0]
				expect(lex_module(state, sources[module_index], module_index)).to_be_true()
				expect(parse_module(state, start, module_index)).to_be_true()
				module_index += 1
			end
			mut import_index := 0
			while import_index < state.import_count[0]
				target := find_module(state, load_string(state.import_paths, import_index))
				expect(target >= 0).to_be_true()
				store_integer(state.import_targets, import_index, target)
				import_index += 1
			end
			expect(find_record_in_module(state, 0, "CompilerState")).to_equal(- 1)
			expect(find_record_in_module(state, 0, "QbeOutput")).to_equal(- 1)
			expect(find_record_in_module(state, find_module(state, "qbe_output"), "QbeOutput") >= 0).to_be_true()
			expect(find_record_in_module(state, find_module(state, "state"), "CompilerState") >= 0).to_be_true()
			expect(find_record_in_module(state, 0, "CheckedLocals")).to_equal(- 1)
			expect(find_record_in_module(state, find_module(state, "state"), "CheckedLocals") >= 0).to_be_true()
			expect(find_record_in_module(state, 0, "CheckedValue")).to_equal(- 1)
			expect(find_record_in_module(state, find_module(state, "checked_values"), "CheckedValue") >= 0).to_be_true()
			expect(state.record_count[0] > 5).to_be_true()
			expect(state.function_count[0] > 20).to_be_true()
			if !resolve(state)
				puts(
					load_string(state.diagnostic_codes, 0) + ":" + load_integer(state.diagnostic_lines, 0).to_s() + ":" +
					load_string(state.diagnostic_messages, 0),
				)
			end
			expect(has_diagnostic(state)).to_be_false()
			# Function lookup is indexed by resolution, unlike record lookup.
			expect(find_function_in_module(state, 0, "parse_module")).to_equal(- 1)
			expect(find_function_in_module(state, find_module(state, "parser"), "parse_module") >= 0).to_be_true()
			expect(find_function_in_module(state, 0, "resolve")).to_equal(- 1)
			expect(find_function_in_module(state, find_module(state, "resolution"), "resolve") >= 0).to_be_true()
			expect(find_function_in_module(state, 0, "check_expression")).to_equal(- 1)
			expect(find_function_in_module(state, find_module(state, "checked_program"), "check_expression") >= 0).to_be_true()
			if !check(state)
				puts(
					load_string(state.diagnostic_codes, 0) + ":" + load_integer(state.diagnostic_lines, 0).to_s() + ":" +
					load_string(state.diagnostic_messages, 0),
				)
			end
			expect(has_diagnostic(state)).to_be_false()
		end
	end

	test("rejects duplicate declarations during resolution") do
		source := "def main()\n\treturn\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(5)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("duplicate function declaration main")
	end

	test("reports the first repeated function while retaining last-match lookup") do
		source := "def value(): Integer\n\treturn 1\nend\n\ndef value(): Integer\n\treturn 2\nend\n\ndef value(): Integer\n\treturn 3\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(find_function_in_module(state, state.entry_module[0], "value")).to_equal(2)
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(5)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("duplicate function declaration value")
		expect(find_function_in_module(state, state.entry_module[0], "value")).to_equal(2)
	end

	test("preserves an earlier declaration error before a duplicate function") do
		source := "def value(item: Missing): Integer\n\treturn 1\nend\n\ndef value(): Integer\n\treturn 2\nend\n\ndef main()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(1)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("unknown parameter type Missing")
	end

	test("rejects an unresolved direct call during resolution") do
		source := "def main()\n\tmissing()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("unresolved function missing")
	end

	test("rejects a local initializer type mismatch during checking") do
		source := "def main()\n\tvalue: Integer := \"bad\"\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(2)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("expected Integer, found String")
	end

	test("enforces the portable Integer literal range during checking") do
		valid_source := "def main()\n\tvalue := 9007199254740991\n\treturn\nend\n"
		mut valid := compiler_new(valid_source.size() + 1)
		expect(lex(valid, valid_source)).to_be_true()
		expect(parse_module(valid, 0, valid.entry_module[0])).to_be_true()
		expect(resolve(valid)).to_be_true()
		expect(check(valid)).to_be_true()

		invalid_source := "def main()\n\tvalue := 9007199254740992\n\treturn\nend\n"
		mut invalid := compiler_new(invalid_source.size() + 1)
		expect(lex(invalid, invalid_source)).to_be_true()
		expect(parse_module(invalid, 0, invalid.entry_module[0])).to_be_true()
		expect(resolve(invalid)).to_be_true()
		expect(check(invalid)).to_be_false()
		expect(load_string(invalid.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(load_integer(invalid.diagnostic_lines, 0)).to_equal(2)
		expect(load_string(invalid.diagnostic_messages, 0)).to_equal(
			"Integer literal is outside the portable range",
		)
	end

	test("rejects direct-call arity mismatches during checking") do
		source := "def identity(value: Integer): Integer\n\treturn value\nend\n\ndef main()\n\tidentity()\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(6)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("call argument count does not match identity")
	end

	test("rejects destructive calls through immutable bindings") do
		source := "def main()\n\tvalues: Array<Integer> := [1]\n\tvalues.push(2)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_false()
		expect(load_string(state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(load_integer(state.diagnostic_lines, 0)).to_equal(3)
		expect(load_string(state.diagnostic_messages, 0)).to_equal("push receiver is immutable")
	end

	test("selects LLD only for compiler-driven Linux links") do
		compiler_source := "def compiler_main(source: String, path: String, check_only: Boolean): Integer\n\treturn 0\nend\n\ndef main()\n\treturn\nend\n"
		mut compiler_state := compiler_new(compiler_source.size() + 1)
		expect(lex(compiler_state, compiler_source)).to_be_true()
		expect(parse_module(compiler_state, 0, compiler_state.entry_module[0])).to_be_true()
		expect(resolve(compiler_state)).to_be_true()
		expect(check(compiler_state)).to_be_true()
		compiler_qbe := output_source(emit_qbe(compiler_state))
		expect(compiler_qbe.include?("data $trbn_project_linker_lld = { b \"-fuse-ld=lld\", b 0 }")).to_be_true()
		expect(
			compiler_qbe.include?(
				"data $trbn_dead_strip_linux = { b \"-Wl,--gc-sections,--strip-all,--no-eh-frame-hdr\", b 0 }",
			),
		).to_be_true()
		expect(compiler_qbe.include?("data $trbn_profile_linux_amd64 = { b \"linux-amd64-v0\", b 0 }")).to_be_true()
		expect(compiler_qbe.include?("data $trbn_qbe_linux_amd64 = { b \"amd64_sysv\", b 0 }")).to_be_true()
		expect(compiler_qbe.include?("@target_linux_amd64_check")).to_be_true()
		expect(compiler_qbe.include?("storel $trbn_qbe_linux_amd64, $trbn_selected_qbe_target")).to_be_true()
		expect(compiler_qbe.include?("storel $trbn_project_linker_lld, $trbn_project_selected_linker")).to_be_true()
		expect(compiler_qbe.include?("%has_linker =w cnel %linker, 0")).to_be_true()
		expect(compiler_qbe.include?("%tail =l phi @linker %linker_tail, @default %default_tail")).to_be_true()

		application_source := "def main()\n\treturn\nend\n"
		mut application_state := compiler_new(application_source.size() + 1)
		expect(lex(application_state, application_source)).to_be_true()
		expect(parse_module(application_state, 0, application_state.entry_module[0])).to_be_true()
		expect(resolve(application_state)).to_be_true()
		expect(check(application_state)).to_be_true()
		application_qbe := output_source(emit_qbe(application_state))
		expect(application_qbe.include?("trbn_project_linker_lld")).to_be_false()
	end

	test("checks and emits portable benchmark entry primitives") do
		source := "import trb/std/process\nimport trb/std/math as Numeric\n\ndef main()\n\tmut first := Process.argv()\n\tfirst.push(\"local\")\n\tsecond := Process.argv()\n\tparsed := second[0].to_i()\n\troot := Numeric.sqrt(parsed)\n\ttruncated := root.to_i()\n\tputs(first.size().to_s())\n\tputs(second.size().to_s())\n\tputs(truncated.to_s())\n\tnan := Numeric.sqrt(- 1)\n\tif nan != nan\n\t\tputs(\"nan\")\n\telse\n\t\tputs(\"number\")\n\tend\n\tputs(\"+9007199254740991\".to_i().to_s())\n\tputs(\"-9007199254740991\".to_i().to_s())\n\tvalue := - 2.75\n\tputs(value.to_i().to_s())\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		emitted := emit_qbe(state)
		expect(emitted.runtime_flags[1]).to_equal(1)
		expect(emitted.runtime_flags[2]).to_equal(0)
		expect(emitted.runtime_flags.size()).to_equal(6)
		expect(emitted.runtime_flags[5]).to_equal(0)
		qbe := output_source(emitted)
		expect(qbe.include?("storel %process_argc, $trbn_process_argc")).to_be_true()
		expect(qbe.include?("function l $trbn_process_argv()")).to_be_true()
		expect(qbe.include?("function l $trbn_string_to_integer(l %string)")).to_be_true()
		expect(qbe.include?("function l $trbn_integer_to_string(l %value)")).to_be_true()
		expect(qbe.include?("function l $trbn_float_to_integer(d %value)")).to_be_true()
		expect(qbe.include?("=d call $sqrt(d ")).to_be_true()
		expect(qbe.include?("=d sltof ")).to_be_true()
		expect(qbe.include?("=l dtosi ")).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-portable-entry"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case native_write_text(workspace + "/module.ssa", qbe)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case native_write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(workspace + "/program", ["9"])
			when Result::Ok(result)
				expect(result.success).to_be_true()
				expect(result.stdout).to_equal("2\n1\n3\nnan\n9007199254740991\n-9007199254740991\n-2\n")
				expect(result.stderr).to_equal("")
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
		end
	end

	test("preserves portable numeric conversion failure classes") do
		source := "import trb/std/process\nimport trb/std/math\n\ndef main()\n\tmode := Process.argv()[0]\n\tif mode == \"invalid-format\"\n\t\tputs(\"12x\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"sign-only\"\n\t\tputs(\"+\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"integer-range\"\n\t\tputs(\"9007199254740992\".to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"nan\"\n\t\tputs(Math.sqrt(- 1).to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"infinity\"\n\t\tzero := 0.0\n\t\tinfinite := 1.0 / zero\n\t\tputs(infinite.to_i().to_s())\n\t\treturn\n\tend\n\tif mode == \"float-range\"\n\t\toutside := 9007199254740992.0\n\t\tputs(outside.to_i().to_s())\n\t\treturn\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		checked := check(state)
		if !checked
			puts(load_integer(state.diagnostic_lines, 0).to_s() + ": " + load_string(state.diagnostic_messages, 0))
		end
		expect(checked).to_be_true()
		qbe_path := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_path == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-portable-entry-failures"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case native_write_text(workspace + "/module.ssa", output_source(emit_qbe(state)))
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
			when Result::Ok(qbe_result)
				if !qbe_result.success
					puts(qbe_result.stderr)
				end
				expect(qbe_result.success).to_be_true()
				case native_write_text(workspace + "/module.s", qbe_result.stdout)
				when Result::Ok(_unit)
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
			when Result::Ok(link_result)
				if !link_result.success
					puts(link_result.stderr)
				end
				expect(link_result.success).to_be_true()
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			modes := ["invalid-format", "sign-only", "integer-range", "nan", "infinity", "float-range"]
			expected := ["panic: invalid Integer\n", "panic: invalid Integer\n", "panic: Integer is outside the portable range\n", "panic: Float cannot be converted to Integer\n", "panic: Float cannot be converted to Integer\n", "panic: Integer is outside the portable range\n"]
			mut index := 0
			while index < modes.size()
				case Process.run(workspace + "/program", [modes[index]])
				when Result::Ok(result)
					expect(result.success).to_be_false()
					expect(result.stdout).to_equal("")
					expect(result.stderr).to_equal(expected[index])
				when Result::Err(error)
					puts(error.operation + ": " + error.message)
					expect(false).to_be_true()
				end
				index += 1
			end
		end
	end

	test("rejects unsupported benchmark entry boundaries deterministically") do
		unsupported_package := load_file_root(
			"import trb/std/random\n\ndef main()\n\treturn\nend\n",
			"/tmp/portable-unsupported-package.trb",
		)
		expect(load_string(unsupported_package.diagnostic_codes, 0)).to_equal("TRBN4003")
		expect(load_string(unsupported_package.diagnostic_messages, 0)).to_equal("package imports are not supported by this compiler subset")

		member_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.environment()\n\treturn\nend\n"
		mut member_state := compiler_new(member_source.size() + 1)
		expect(lex(member_state, member_source)).to_be_true()
		expect(parse_module(member_state, 0, member_state.entry_module[0])).to_be_true()
		expect(resolve(member_state)).to_be_true()
		expect(check(member_state)).to_be_false()
		expect(load_string(member_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(load_string(member_state.diagnostic_messages, 0)).to_equal("unsupported standard package member")

		type_source := "import trb/std/math\n\ndef main()\n\tvalue := Math.sqrt(\"nine\")\n\treturn\nend\n"
		mut type_state := compiler_new(type_source.size() + 1)
		expect(lex(type_state, type_source)).to_be_true()
		expect(parse_module(type_state, 0, type_state.entry_module[0])).to_be_true()
		expect(resolve(type_state)).to_be_true()
		expect(check(type_state)).to_be_false()
		expect(load_string(type_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(load_string(type_state.diagnostic_messages, 0)).to_equal("expected Float, found String")

		arity_source := "import trb/std/process\n\ndef main()\n\tvalue := Process.argv(1)\n\treturn\nend\n"
		mut arity_state := compiler_new(arity_source.size() + 1)
		expect(lex(arity_state, arity_source)).to_be_true()
		expect(parse_module(arity_state, 0, arity_state.entry_module[0])).to_be_true()
		expect(resolve(arity_state)).to_be_true()
		expect(check(arity_state)).to_be_false()
		expect(load_string(arity_state.diagnostic_codes, 0)).to_equal("TRBN4004")
		expect(load_string(arity_state.diagnostic_messages, 0)).to_equal("call argument count does not match Process")
	end

	test("inlines bounded scalar helpers outside lexical loops") do
		source := "def scalar(value: Integer): Integer\n\tsum := value + 1\n\tproduct := sum * 2\n\treturn product / 2\nend\n\ndef main()\n\tmut values: Array<Integer> := [0]\n\tmut index := 0\n\twhile index < 1\n\t\tvalues[0] = scalar(index)\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("call $trbn_integer_add")).to_be_false()
		expect(qbe.include?("call $trbn_integer_mul")).to_be_false()
		expect(qbe.include?("call $trbn_integer_divide")).to_be_false()
		# The verified scalar call cannot invalidate the initially checked address.
		expect(occurrence_count(qbe, "call $trbn_array_address")).to_equal(0)
	end

	test("routes dynamic Integer multiplication through the bounded checked entry") do
		source := "def multiply(left: Integer, right: Integer): Integer\n\treturn left * right\nend\n\ndef main()\n\tvalue := multiply(2, 3)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("call $trbn_integer_mul(l ")).to_be_true()
		expect(qbe.include?("%c =l or %left, %right")).to_be_true()
		expect(qbe.include?("%u =l shr %c, 26")).to_be_true()
		expect(qbe.include?("jnz %u, @left_sign, @multiply")).to_be_true()
		expect(occurrence_count(qbe, "%right_zero =w ceql %right, 0")).to_equal(1)
	end

	test("omits only the impossible lower check for bounded nonnegative literal addition") do
		source := "def add_right(value: Integer): Integer\n\treturn value + 1\nend\n\ndef add_left(value: Integer): Integer\n\treturn 1 + value\nend\n\ndef add_limit(value: Integer): Integer\n\treturn value + 1024\nend\n\ndef add_large(value: Integer): Integer\n\treturn value + 1025\nend\n\ndef add_dynamic(left: Integer, right: Integer): Integer\n\treturn left + right\nend\n\ndef main()\n\tfirst := add_right(1)\n\tsecond := add_left(first)\n\tthird := add_limit(second)\n\tfourth := add_large(third)\n\tvalue := add_dynamic(fourth, 1)\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(
			occurrence_count(
				qbe,
				"%t0 =l add %p0, 1\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l1",
			),
		).to_equal(2)
		expect(
			qbe.include?(
				"%t0 =l add %p0, 1024\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l1\n" +
				"@l0\n\tcall $trbn_fail",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"%t0 =l add %p0, 1025\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l2\n" +
				"@l2\n\t%t2 =w csltl %t0, -9007199254740991",
			),
		).to_be_true()
		expect(
			qbe.include?(
				"%t0 =l add %p0, %p1\n" +
				"\t%t1 =w csgtl %t0, 9007199254740991\n" +
				"\tjnz %t1, @l0, @l2\n" +
				"@l2\n\t%t2 =w csltl %t0, -9007199254740991",
			),
		).to_be_true()
	end

	test("keeps the loop reserve independent when the non-loop reserve is exhausted") do
		source := "def scalar(value: Integer, label: String): Integer\n\tmut result := value\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\tresult += 1\n\treturn result\nend\n\ndef main()\n\tmut values: Array<Integer> := [0]\n\tmut index := 0\n\twhile index < 1\n\t\tvalues[0] = scalar(index, \"managed caller\")\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		expect(qbe.include?("call $trbn_integer_add")).to_be_true()
		# The final assignment store independently checks current storage.
		expect(occurrence_count(qbe, "call $trbn_array_address")).to_equal(1)
	end

	test("spends the loop inline budget on dynamic Array reads and mutation") do
		source := "def main()\n\tmut values: Array<Integer> := [10, 20]\n\tindices := [1, - 2]\n\tmut position := 0\n\twhile position < indices.size()\n\t\tindex := indices[position]\n\t\tvalues[index] = values[index] + 1\n\t\tposition += 1\n\tend\n\treturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		qbe := output_source(emit_qbe(state))
		# Initial accesses retain their checks; the effect-free store reuses its address.
		expect(occurrence_count(qbe, "call $trbn_array_address")).to_equal(0)
		expect(occurrence_count(qbe, "function l $trbn_array_address")).to_equal(0)
		expect(occurrence_count(qbe, "call $trbn_fail(l $trbn_bounds_error")).to_equal(2)
	end

	test("omits negative Array-index normalization only for proven induction locals") do
		proven_source := "def main()\n\tmut values: Array<Integer> := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tvalues[index] = values[index] + 1\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut proven := compiler_new(proven_source.size() + 1)
		expect(lex(proven, proven_source)).to_be_true()
		expect(parse_module(proven, 0, proven.entry_module[0])).to_be_true()
		expect(resolve(proven)).to_be_true()
		expect(check(proven)).to_be_true()
		proven_qbe := output_source(emit_qbe(proven))
		expect(occurrence_count(proven_qbe, " =l sar ")).to_equal(0)
		expect(occurrence_count(proven_qbe, " =w cultl ")).to_equal(2)

		direct_derived_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < 1\n\t\tvalue := values[index + 1]\n\t\tindex += 1\n\tend\n\treturn\nend\n"
		mut direct_derived := compiler_new(direct_derived_source.size() + 1)
		expect(lex(direct_derived, direct_derived_source)).to_be_true()
		expect(parse_module(direct_derived, 0, direct_derived.entry_module[0])).to_be_true()
		expect(resolve(direct_derived)).to_be_true()
		expect(check(direct_derived)).to_be_true()
		mut verified_index_facts := 0
		mut unresolved_index_facts := 0
		mut fact_index := 0
		while fact_index < direct_derived.token_count[0]
			if load_string(direct_derived.token_texts, fact_index) == "]"
				fact := mir_nonnegative_fact(direct_derived, fact_index)
				if fact == 2
					verified_index_facts += 1
				end
				if fact < 0
					unresolved_index_facts += 1
				end
			end
			fact_index += 1
		end
		expect(verified_index_facts).to_equal(1)
		expect(unresolved_index_facts).to_equal(0)
		direct_derived_qbe := output_source(emit_qbe(direct_derived))
		expect(occurrence_count(direct_derived_qbe, " =l sar ")).to_equal(0)

