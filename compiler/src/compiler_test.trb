		expect(occurrence_count(safe_nested_qbe, " =l sar ")).to_equal(0)

		derived_source := "def main()\n\tvalues := [10, 20]\n\tmut index := 0\n\twhile index < values.size()\n\t\tmut other := index + 1\n\t\twhile other < values.size()\n\t\t\tvalue := values[other]\n\t\t\tother += 1\n\t\tend\n\t\tindex += 1\n\tend\n\treturn\nend\n"
