import { gate4_array_element_type, gate4_array_type, gate4_builtin_type_exists, gate4_common_array_element_type, gate4_import_path_value, gate4_record_type } from resolution
import { describe, expect, test } from trb/std/test

describe("Declaration and type resolution") do
	test("retains exact Array element and numeric common-type rules") do
		expect(gate4_array_element_type("Array<Float>")).to_equal("Float")
		expect(gate4_array_element_type("Array<Array<Integer>>")).to_equal("Array<Integer>")
		expect(gate4_array_type("Boolean")).to_equal("")
		expect(gate4_array_type("Integer")).to_equal("Array<Integer>")
		expect(gate4_common_array_element_type("Integer", "Float")).to_equal("Float")
		expect(gate4_common_array_element_type("Float", "Integer")).to_equal("Float")
		expect(gate4_common_array_element_type("String", "Integer")).to_equal("")
		expect(gate4_builtin_type_exists("Void", false)).to_be_false()
		expect(gate4_builtin_type_exists("Void", true)).to_be_true()
	end

	test("preserves declaration spelling and canonical import paths without the loader") do
		expect(gate4_record_type(17)).to_equal("Record#17")
		expect(gate4_import_path_value("shared/item.trb")).to_equal("shared/item")
		expect(gate4_import_path_value("/shared/item.trb")).to_equal("")
		expect(gate4_import_path_value("../shared/item.trb")).to_equal("")
	end
end
