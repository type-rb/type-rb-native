import { import_path_value } from resolution
import { array_element_type, array_type, builtin_type_exists, common_array_element_type, record_type } from type_resolution
import { describe, expect, test } from trb/std/test

describe("Declaration and type resolution") do
	test("retains exact Array elements and canonical common types") do
		expect(array_element_type("Array<Float>")).to_equal("Float")
		expect(array_element_type("Array<Array<Integer>>")).to_equal("Array<Integer>")
		expect(array_type("Boolean")).to_equal("Array<Boolean>")
		expect(array_type("Integer")).to_equal("Array<Integer>")
		expect(array_element_type("Array<Array<Boolean>>")).to_equal("Array<Boolean>")
		expect(array_element_type("Array<Array<Array<Boolean>>>")).to_equal("Array<Array<Boolean>>")
		expect(array_element_type("Array<Array<Array<Array<Boolean>>>>")).to_equal("Array<Array<Array<Boolean>>>")
		expect(common_array_element_type("Boolean", "Integer")).to_equal("$Union<Boolean,Integer>")
		expect(common_array_element_type("Integer", "Boolean")).to_equal("$Union<Boolean,Integer>")
		expect(common_array_element_type("Integer", "Float")).to_equal("Float")
		expect(common_array_element_type("Float", "Integer")).to_equal("Float")
		expect(common_array_element_type("String", "Integer")).to_equal("$Union<Integer,String>")
		expect(builtin_type_exists("Void", false)).to_be_false()
		expect(builtin_type_exists("Void", true)).to_be_true()
	end

	test("preserves declaration spelling and canonical import paths without the loader") do
		expect(record_type(17)).to_equal("Record#17")
		expect(import_path_value("shared/item.trb")).to_equal("shared/item")
		expect(import_path_value("/shared/item.trb")).to_equal("")
		expect(import_path_value("../shared/item.trb")).to_equal("")
	end
	test("requires canonical record identity through recursive Array types") do
		expect(array_type("Record#0")).to_equal("Array<Record#0>")
		expect(array_element_type("Array<Array<Array<Record#1234>>>")).to_equal("Array<Array<Record#1234>>")
		expect(array_element_type("Array<Array<Array<Array<Record#0>>>>")).to_equal("Array<Array<Array<Record#0>>>")
		expect(array_element_type("Array<Record#>")).to_equal("")
		expect(array_element_type("Array<Record#01>")).to_equal("")
		expect(array_element_type("Array<Record#-1>")).to_equal("")
		expect(array_element_type("Array<Record#0junk>")).to_equal("")
		expect(array_element_type("Array<Array<Void>>")).to_equal("")
		expect(array_element_type("Array<Entry>")).to_equal("")
		expect(array_element_type("Array<Record#0>>")).to_equal("")
	end

end
