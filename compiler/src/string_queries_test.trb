import { check } from compiler
import { compiler_test_instruction_with_cell } from compiler_test
import { managed_mir_test_fixture } from hash_value_mir_test
import { logical_checked_source } from logical_test
import { mir_instruction_effects } from mir_roots
import { verify_mir } from mir_verifier
import { describe, expect, test } from trb/std/test

describe("String query MIR") do
	test("preserves query and boundary operations without source or storage order") do
		managed_mir_test_fixture("string-query-search-mir", 0)
		managed_mir_test_fixture("string-query-boundaries-mir", 0)
	end

	test("retains managed receivers, optional calls and lexical transfers") do
		managed_mir_test_fixture("string-query-managed-mir", 1)
		managed_mir_test_fixture("string-query-optional-mir", 1)
		managed_mir_test_fixture("string-query-transfer", 0)
	end

	test("rejects malformed search operands, results, modes and failure edges") do
		mut mutation := 0
		while mutation < 8
			mut state := logical_checked_source("def main()\nfound := \"abc\".index(\"b\")\nputs(found == nil)\nend\n")
			expect(check(state)).to_be_true()
			mut index := 0
			while index < state.scalar_mir.instructions.size() && state.scalar_mir.instructions[index].kind != 44
				index += 1
			end
			expect(index < state.scalar_mir.instructions.size()).to_be_true()
			instruction := state.scalar_mir.instructions[index]
			expect(mir_instruction_effects(state.scalar_mir, instruction)).to_equal(0)
			mut cell := mutation
			mut value := 999999
			if mutation == 0
				value = 45
			elsif mutation == 4
				value = 5
			elsif mutation == 5
				value = 0
			elsif mutation == 6
				cell = 4
				value =- 1
			elsif mutation == 7
				cell = 2
				# An available Integer result cannot be a String input.
				value = state.scalar_mir.instructions[index - 1].result
			end
			state.scalar_mir.instructions[index] = compiler_test_instruction_with_cell(instruction, cell, value)
			expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
			mutation += 1
		end
	end
end
