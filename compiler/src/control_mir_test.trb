import { check, emit_qbe, lex } from compiler
import { MirFunction, mir_function_index } from mir
import { verify_mir } from mir_verifier
import { parse_module } from parser
import qbe_output
import { resolve } from resolution
import { CompilerState, compiler_new } from state
import { load_integer, load_string, store_string } from storage
import { describe, expect, test } from trb/std/test

def control_test_state(body: String): CompilerState
	source := "def choose(value: Integer): Integer\n" + body + "\nend\ndef main()\n\tputs(choose(3))\n\treturn\nend\n"
	mut state := compiler_new(source.size() * 3 + 16)
	lex(state, source)
	parse_module(state, 0, state.entry_module[0])
	resolve(state)
	check(state)
	return state
end

def control_test_output(output: QbeOutput): String
	mut text := ""
	mut index := 0
	while index < output.count[0]
		text += load_string(output.lines, index) + "\n"
		index += 1
	end
	return text
end

describe("general scalar MIR control") do
	test("checks nested branches, elsif, early returns and continuing joins") do
		bodies := [
			"\tif value < 0\n\t\treturn -value\n\telse\n\t\treturn value + 1\n\tend",
			"\toffset := value + 1\n\tif value < 0\n\t\tif offset == 0\n\t\t\treturn 4\n\t\tend\n\t\treturn offset\n\telsif value == 0\n\t\treturn 7\n\tend\n\treturn offset * 2",
			"\tif value < 0\n\t\tunused := value + 1\n\telse\n\t\tunused := value + 2\n\tend\n\treturn value",
		]
		bodies.each do |body|
			state := control_test_state(body)
			expect(state.diagnostic_count[0]).to_equal(0)
			index := mir_function_index(state.scalar_mir, 0)
			expect(index >= 0).to_be_true()
			if index >= 0
				expect(state.scalar_mir.functions[index].kind).to_equal(3)
				expect(verify_mir(state.scalar_mir, true)).to_equal("")
			end
		end
	end

	test("emits checked control and values without reading the source body again") do
		mut state := control_test_state("\toffset := value + 1\n\tif offset < 3\n\t\treturn offset\n\tend\n\treturn offset * 2")
		expect(state.diagnostic_count[0]).to_equal(0)
		before := control_test_output(emit_qbe(state))
		mut index := load_integer(state.function_body_starts, 0)
		while index < load_integer(state.function_body_ends, 0)
			store_string(state.token_texts, index, "unavailable")
			index += 1
		end
		expect(control_test_output(emit_qbe(state))).to_equal(before)
		expect(before.include?("@mir_")).to_be_true()
	end

	test("rejects a control edge whose live argument is unavailable") do
		mut state := control_test_state("\toffset := value + 1\n\tif offset < 3\n\t\treturn offset\n\tend\n\treturn offset * 2")
		function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, 0)]
		entry := state.scalar_mir.blocks[function.block_start]
		mut arguments := state.scalar_mir.arguments
		arguments[entry.first_argument_start] = 9007199254740991
		expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
	end

	test("rejects selecting the induction adapter for a general conditional") do
		mut state := control_test_state("\tif value < 0\n\t\treturn -value\n\telse\n\t\treturn value\n\tend")
		index := mir_function_index(state.scalar_mir, 0)
		function := state.scalar_mir.functions[index]
		state.scalar_mir.functions[index] = MirFunction.new(kind: 2, integer_guard: 0, id: function.id, entry_block: function.entry_block, source_id: function.source_id, line: function.line, parameter_start: function.parameter_start, parameter_count: function.parameter_count, block_start: function.block_start, block_count: function.block_count)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR induction adapter shape differs")
	end
end
