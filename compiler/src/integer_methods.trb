import { CheckedValue, checked_mir_value, scalar_mir_binary, scalar_mir_convert_float, scalar_mir_instruction, scalar_mir_literal, scalar_mir_unary } from checked_values
import { mir_control_active, mir_control_prepare } from mir_control
import { mir_value_select } from mir_value_control
import { CompilerState } from state
import { CheckedLocals } from local_state
import { load_integer } from storage

# Receiver names and arity are shared with ordinary checking and the REPL.
def integer_method_kind(name: String): Integer
	if name == "abs"
		return 1
	elsif name == "zero?"
		return 2
	elsif name == "positive?"
		return 3
	elsif name == "negative?"
		return 4
	elsif name == "even?"
		return 5
	elsif name == "odd?"
		return 6
	elsif name == "min"
		return 7
	elsif name == "max"
		return 8
	elsif name == "clamp"
		return 9
	elsif name == "to_f"
		return 10
	end
	return 0
end

def integer_method_arity(kind: Integer): Integer
	if kind == 9
		return 2
	end
	if kind == 7 || kind == 8
		return 1
	end
	return 0
end

def mir_integer_bound(mut state: CompilerState, mut locals: CheckedLocals, value: CheckedValue, bound: CheckedValue, minimum: Boolean, origin: Integer): CheckedValue
	mut operator := ">"
	if minimum
		operator = "<"
	end
	condition := scalar_mir_binary(state, locals, operator, value, bound, "Boolean", origin)
	return mir_value_select(state, locals, condition, value, bound, origin)
end

# Predicates, selection and widening use existing typed operations and CFG joins.
# The guard is an explicit failure operation, independently checked by MIR.
def mir_integer_method(mut state: CompilerState, mut locals: CheckedLocals, kind: Integer, receiver: CheckedValue, arguments: Array<CheckedValue>, origin: Integer): CheckedValue
	mir_control_prepare(state, locals)
	if kind == 10
		return scalar_mir_convert_float(state, locals, receiver, origin)
	end
	zero := scalar_mir_literal(state, locals, "Integer", origin, "0")
	if kind == 1
		negative := scalar_mir_binary(state, locals, "<", receiver, zero, "Boolean", origin)
		absolute := scalar_mir_unary(state, locals, "-", receiver, "Integer", origin)
		return mir_value_select(state, locals, negative, absolute, receiver, origin)
	end
	if kind >= 2 && kind <= 4
		mut operator := "=="
		if kind == 3
			operator = ">"
		elsif kind == 4
			operator = "<"
		end
		return scalar_mir_binary(state, locals, operator, receiver, zero, "Boolean", origin)
	end
	if kind == 5 || kind == 6
		two := scalar_mir_literal(state, locals, "Integer", origin, "2")
		remainder := scalar_mir_binary(state, locals, "%", receiver, two, "Integer", origin)
		mut operator := "=="
		if kind == 6
			operator = "!="
		end
		return scalar_mir_binary(state, locals, operator, remainder, zero, "Boolean", origin)
	end
	if kind == 7 || kind == 8
		return mir_integer_bound(state, locals, receiver, arguments[0], kind == 7, origin)
	end
	valid := scalar_mir_binary(state, locals, "<=", arguments[0], arguments[1], "Boolean", origin)
	if mir_control_active(locals)
		scalar_mir_instruction(state, locals, 43, - 1, checked_mir_value(valid), - 1, 1, locals.mir_state[3], load_integer(state.source_tokens.token_lines, origin))
	end
	lower := mir_integer_bound(state, locals, receiver, arguments[0], false, origin)
	return mir_integer_bound(state, locals, lower, arguments[1], true, origin)
end
