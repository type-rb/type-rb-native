import { mir_checked_iteration_begin, mir_checked_iteration_end } from mir_iteration_control
import { mir_checked_range_new } from mir_ranges
import { mir_checked_hash_index, mir_checked_hash_literal, mir_checked_hash_method, mir_checked_hash_store } from mir_hashes
import { mir_checked_record_field, mir_checked_record_new } from mir_records
import { mir_checked_array_index, mir_checked_array_literal, mir_checked_array_operation, mir_checked_array_store } from mir_arrays
import { binary_result_type, check_expected, numeric_type, type_diagnostic } from checked_types
import { CheckedValue, array_region_operation, checked_assignment_operation, checked_bound_value, checked_mir_value, checked_value, scalar_leaf_inline_eligible, scalar_mir_binary, scalar_mir_convert_float, scalar_mir_disable, scalar_mir_literal, scalar_mir_unary } from checked_values
import { checked_hash_binding_target, checked_hash_method, checked_hash_plan, checked_hash_publish } from hash_checked
import { mir_hash_operation } from hash_mir
import { hash_key_type, hash_type, hash_value_type } from hash_types
import { checked_iteration_require, checked_iteration_shape, checked_range_require, iteration_element_type } from iteration_checked
import { MirIteration, MirRangeConstruction, mir_iteration_valid } from iteration_mir
import { float_literal_in_range, integer_literal_in_range, number_is_float, small_nonnegative_integer_operand } from literals
import { MirLoopTransfer, mir_loop_transfer_valid } from mir
import { mir_array_assignment_plan, mir_array_assignment_valid } from mir_analysis
import { mir_checked_call } from mir_calls
import { mir_logical_begin, mir_logical_join } from mir_logical
import { mir_checked_puts, mir_checked_string_binary, mir_checked_string_literal, mir_checked_string_operation } from mir_strings
import { mir_control_active, mir_control_allocate, mir_control_assign, mir_control_branch, mir_control_enter, mir_control_jump, mir_control_loop_begin, mir_control_loop_branch, mir_control_loop_end, mir_control_prepare, mir_control_return, mir_control_transfer } from mir_control
import { advance, binary_operator_id, declaration_start, expect, expect_identifier, finish_statement, parse_type, skip_newlines, syntax_block_end, syntax_conditional_tail, syntax_expression_precedence, syntax_iteration_suffix, syntax_loop_transfer_kind, syntax_statement_boundary, token_is } from parser
import { array_element_type, array_type, common_array_element_type, find_field, find_record_type, find_visible_function, find_visible_record, resolve_type_name, standard_package_import, standard_package_root, type_display } from resolution
import { CheckedLocals, CompilerState, diagnostic, has_diagnostic, local_add, local_find, terminal_token } from state
import { load_integer, load_string, sparse_integer_at, store_integer, store_string } from storage

def checked_hash_literal(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, expected: String): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	mut key_type := hash_key_type(expected)
	mut value_type := hash_value_type(expected)
	mut entries := 0
	mut keys: Array<Integer> := []
	mut values: Array<CheckedValue> := []
	advance(position)
	skip_newlines(state, position)
	while !token_is(state, position[0], "}")
		key := check_expression(state, position, locals, 1, key_type)
		if key.type_name != "Integer" && key.type_name != "String"
			return type_diagnostic(state, line, "Hash key must be String or Integer")
		end
		key_type = key.type_name
		keys.push(checked_mir_value(key))
		if !expect(state, position, "=>")
			return checked_value("Invalid", 0, origin, 0)
		end
		value := check_expression(state, position, locals, 1, hash_value_type(expected))
		if hash_value_type(expected) == ""
			common := common_array_element_type(value_type, value.type_name)
			if common == ""
				return type_diagnostic(state, line, "incompatible Hash value types")
			end
			value_type = common
		end
		values.push(value)
		entries += 1
		skip_newlines(state, position)
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	finish := position[0]
	expect(state, position, "}")
	mut type_name := "Hash"
	if key_type != "" && value_type != ""
		type_name = hash_type(key_type, value_type)
	end
	checked_hash_publish(state, mir_hash_operation(1, origin, finish, origin, type_name, true, entries))
	return mir_checked_hash_literal(state, locals, type_name, value_type, origin, keys, values)
end

def checked_hash_index(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	advance(position)
	key := check_expression(state, position, locals, 1, hash_key_type(receiver.type_name))
	if key.type_name != "Integer" && key.type_name != "String"
		return type_diagnostic(state, line, "Hash key must be String or Integer")
	end
	finish := position[0]
	expect(state, position, "]")
	mut kind := 2
	if token_is(state, position[0], "=")
		kind = 3
	end
	if binary_operator_id(load_string(state.token_texts, position[0])) >= 17
		return type_diagnostic(state, line, "compound assignment to Hash entries is unsupported")
	end
	mut type_name := receiver.type_name
	if type_name == "Hash"
		if kind != 3
			return type_diagnostic(state, line, "cannot index an untyped Hash; add Hash<K, V> annotation")
		end
		type_name = hash_type(key.type_name, "")
	end
	if kind == 3 && !checked_hash_binding_target(state, receiver.origin)
		return type_diagnostic(state, line, "assignment requires a mutable binding")
	end
	checked_hash_publish(state, mir_hash_operation(kind, origin, finish, receiver.origin, type_name, receiver.mutable != 0, 0))
	array_region_operation(locals, 6, 0, origin)
	return mir_checked_hash_index(state, locals, receiver, key, hash_value_type(type_name), origin, kind == 3)
end

def checked_hash_refine(mut state: CompilerState, mut locals: CheckedLocals, origin: Integer, value_type: String)
	plan := checked_hash_plan(state, origin)
	if plan.kind != 3 || plan.value_type != ""
		return
	end
	binding := local_find(locals, load_string(state.token_texts, plan.receiver_origin))
	if binding < 0
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "empty Hash requires a typed binding")
		return
	end
	type_name := hash_type(plan.key_type, value_type)
	store_string(locals.types, binding, type_name)
	literal_origin := load_integer(locals.hash_literal_origins, binding) - 1
	literal := checked_hash_plan(state, literal_origin)
	if literal.kind != 1
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "empty Hash requires a typed binding")
		return
	end
	checked_hash_publish(state, mir_hash_operation(1, literal.origin, literal.finish, literal.receiver_origin, type_name, true, 0))
	checked_hash_publish(state, mir_hash_operation(3, plan.origin, plan.finish, plan.receiver_origin, type_name, plan.mutable, 0))
end

def checked_hash_call(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue, method: String): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	kind := checked_hash_method(method)
	if kind == 0
		return type_diagnostic(state, line, "unsupported Hash method " + method)
	end
	if receiver.type_name == "Hash" && kind != 4 && kind != 12
		return type_diagnostic(state, line, "Hash method requires a concrete Hash<K, V> type")
	end
	if kind == 6 || kind == 9
		if receiver.mutable == 0 || !receiver.binding || !checked_hash_binding_target(state, receiver.origin)
			return type_diagnostic(state, line, "Hash mutation requires a mutable binding")
		end
	end
	advance(position)
	mut result_type := receiver.type_name
	mut argument :=- 1
	if kind == 5 || kind == 6 || kind == 13
		argument = checked_mir_value(check_expression(state, position, locals, 1, hash_key_type(receiver.type_name)))
		result_type = hash_value_type(receiver.type_name)
	end
	if kind == 8 || kind == 9
		argument = checked_mir_value(check_expression(state, position, locals, 1, receiver.type_name))
	end
	if kind == 4
		result_type = "Integer"
	elsif kind == 5 || kind == 12
		result_type = "Boolean"
	elsif kind == 9
		result_type = "Void"
	elsif kind == 10
		result_type = array_type(hash_key_type(receiver.type_name))
	elsif kind == 11
		result_type = array_type(hash_value_type(receiver.type_name))
	end
	if result_type == ""
		return type_diagnostic(state, line, "unsupported Hash result representation")
	end
	skip_newlines(state, position)
	finish := position[0]
	expect(state, position, ")")
	checked_hash_publish(state, mir_hash_operation(kind, origin, finish, receiver.origin, receiver.type_name, receiver.mutable != 0, 0))
	if kind != 4 && kind != 5 && kind != 12
		array_region_operation(locals, 6, 0, origin)
	end
	value := mir_checked_hash_method(state, locals, receiver, argument, kind, result_type, origin)
	return checked_value(result_type, value.category, 9007199254740991, 0)
end

def check_array_literal(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		expected: String,
	): CheckedValue
	origin := position[0]
	mut values: Array<CheckedValue> := []
	line := load_integer(state.token_lines, origin)
	advance(position)
	skip_newlines(state, position)
	contextual_element_type := array_element_type(expected)
	mut element_type := contextual_element_type
	mut finished := false
	while !finished
		if token_is(state, position[0], "]")
			finished = true
		else
			value := check_expression(state, position, locals, 1, contextual_element_type)
			values.push(value)
			if contextual_element_type == ""
				common_type := common_array_element_type(element_type, value.type_name)
				if common_type == ""
					check_expected(
						state,
						value.type_name,
						element_type,
						load_integer(state.token_lines, position[0]),
					)
				else
					element_type = common_type
				end
			end
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	if !expect(state, position, "]")
		return checked_value("Invalid", 0, 9007199254740991, 0)
	end
	if element_type == ""
		return type_diagnostic(state, line, "empty Array literal requires a contextual type")
	end
	result_type := array_type(element_type)
	if result_type == ""
		return type_diagnostic(state, line, "unsupported Array element type " + element_type)
	end
	return mir_checked_array_literal(state, locals, result_type, element_type, origin, values)
end

def check_primary(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		expected: String,
	): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	kind := load_integer(state.token_kinds, origin)
	if kind == 2
		literal := load_string(state.token_texts, origin)
		advance(position)
		if number_is_float(literal)
			if !float_literal_in_range(literal)
				return type_diagnostic(state, line, "Float literal is outside the finite binary64 range")
			end
			return scalar_mir_literal(state, locals, "Float", origin, literal)
		end
		if !integer_literal_in_range(literal)
			return type_diagnostic(state, line, "Integer literal is outside the portable range")
		end
		return scalar_mir_literal(state, locals, "Integer", origin, literal)
	end
	if kind == 3
		advance(position)
		return mir_checked_string_literal(state, locals, origin)
	end
	if token_is(state, position[0], "{")
		array_region_operation(locals, 6, 0, origin)
		return checked_hash_literal(state, position, locals, expected)
	end
	if token_is(state, position[0], "[")
		array_region_operation(locals, 6, 0, origin)
		return check_array_literal(state, position, locals, expected)
	end
	if token_is(state, position[0], "(")
		advance(position)
		skip_newlines(state, position)
		value := check_expression_value(state, position, locals, 1, expected)
		skip_newlines(state, position)
		expect(state, position, ")")
		return value
	end
	if token_is(state, position[0], "!")
		advance(position)
		value := check_postfix(
			state,
			position,
			locals,
			check_primary(state, position, locals, "Boolean"),
		)
		check_expected(state, value.type_name, "Boolean", line)
		return scalar_mir_unary(state, locals, "!", value, "Boolean", origin)
	end
	if token_is(state, position[0], "-")
		advance(position)
		value := check_postfix(
			state,
			position,
			locals,
			check_primary(state, position, locals, ""),
		)
		if !numeric_type(value.type_name)
			return type_diagnostic(state, line, "unary - requires Integer or Float")
		end
		return scalar_mir_unary(state, locals, "-", value, value.type_name, origin)
	end
	if token_is(state, position[0], "+")
		advance(position)
		value := check_postfix(
			state,
			position,
			locals,
			check_primary(state, position, locals, ""),
		)
		if !numeric_type(value.type_name)
			return type_diagnostic(state, line, "unary + requires Integer or Float")
		end
		return scalar_mir_unary(state, locals, "+", value, value.type_name, origin)
	end
	if kind == 1
		name := load_string(state.token_texts, origin)
		advance(position)
		if name == "true"
			return scalar_mir_literal(state, locals, "Boolean", origin, "true")
		end
		if name == "false"
			return scalar_mir_literal(state, locals, "Boolean", origin, "false")
		end
		local_index := local_find(locals, name)
		if local_index >= 0
			mir_value := load_integer(locals.mir_values, local_index)
			if locals.mir_state[0] > 0
				if mir_value > 0
					return checked_bound_value(
						load_string(locals.types, local_index),
						- mir_value,
						origin,
						load_integer(locals.mutable, local_index),
						true,
					)
				end
				scalar_mir_disable(locals)
			end
			return checked_bound_value(
				load_string(locals.types, local_index),
				0,
				origin,
				load_integer(locals.mutable, local_index),
				true,
			)
		end
		standard_package := standard_package_import(state, state.active_module[0], name)
		if standard_package < - 1
			return checked_value(standard_package_root(standard_package), 2 - standard_package, origin, 0)
		end
		if name == "puts"
			return checked_value("", 1, origin, 0)
		end
		if find_visible_function(state, state.active_module[0], name) >= 0
			return checked_value("", 1, origin, 0)
		end
		if find_visible_record(state, state.active_module[0], name) >= 0
			return checked_value("", 2, origin, 0)
		end
		return type_diagnostic(state, line, "unresolved value " + name)
	end
	return type_diagnostic(state, line, "expected an expression")
end

def check_call(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		callee_category: Integer,
		callee_name: String,
	): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	advance(position)
	skip_newlines(state, position)
	mut function_index := find_visible_function(state, state.active_module[0], callee_name)
	mut parameter_start := 0
	mut parameter_count := 1
	mut result_type := "Void"
	if callee_name == "puts"
		function_index =- 1
	else
		if callee_category == 4
			function_index =- 1
			parameter_count = 0
			result_type = "Array<String>"
		else
			if callee_category == 5
				function_index =- 1
				result_type = "Float"
			else
				if function_index >= 0
					parameter_start = load_integer(state.function_parameter_starts, function_index)
					parameter_count = load_integer(state.function_parameter_counts, function_index)
					result_type = load_string(state.function_result_types, function_index)
				else
					diagnostic(state, "TRBN4004", line, "value is not callable")
				end
			end
		end
	end
	mut argument_count := 0
	mut mir_arguments: Array<Integer> := []
	mut finished := false
	while !finished
		if token_is(state, position[0], ")")
			finished = true
		else
			argument_origin := position[0]
			mut argument_expected := "Invalid"
			if callee_category >= 4
				argument_expected = ""
			end
			if argument_count < parameter_count
				if callee_category == 5
					argument_expected = "Float"
				else
					if callee_name == "puts"
						argument_expected = ""
					else
						argument_expected = load_string(state.parameter_types, parameter_start + argument_count)
					end
				end
			end
			argument := check_expression(state, position, locals, 1, argument_expected)
			mir_arguments.push(checked_mir_value(argument))
			if function_index >= 0 && argument_count < parameter_count && hash_key_type(argument_expected) != ""
				if load_integer(state.parameter_mutable, parameter_start + argument_count) != 0
					if checked_readonly_reference_binding(state, locals, argument)
						diagnostic(state, "TRBN4004", line, "mutable Hash argument requires a mutable binding or fresh value")
					end
				end
			end
			if callee_name == "puts"
				if argument.type_name != "String"
					if argument.type_name != "Integer"
						if argument.type_name != "Boolean"
							diagnostic(state, "TRBN4004", line, "puts does not yet support " + type_display(state, argument.type_name))
						end
					end
				end
			end
			if argument.type_name == "Integer"
				if argument.origin != 9007199254740991
					if small_nonnegative_integer_operand(
							load_string(state.token_texts, argument.origin),
						)
						store_integer(state.mir_nonnegative_facts, argument_origin, 1)
					end
				end
			end
			argument_count += 1
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, ")")
	if argument_count != parameter_count
		diagnostic(state, "TRBN4004", line, "call argument count does not match " + callee_name)
	end
	if callee_name == "puts"
		return mir_checked_puts(state, locals, mir_arguments, origin)
	end
	return mir_checked_call(state, locals, function_index, mir_arguments, result_type, origin)
end

def check_record_new(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		record_name: String,
	): CheckedValue
	record_index := find_visible_record(state, state.active_module[0], record_name)
	origin := position[0]
	mut arguments: Array<Integer> := []
	array_region_operation(locals, 6, 0, position[0])
	line := load_integer(state.token_lines, position[0])
	advance(position)
	skip_newlines(state, position)
	field_start := load_integer(state.record_field_starts, record_index)
	field_count := load_integer(state.record_field_counts, record_index)
	mut argument_index := 0
	mut finished := false
	while !finished
		if token_is(state, position[0], ")")
			finished = true
		else
			label := expect_identifier(state, position)
			expect(state, position, ":")
			mut expected := "Invalid"
			if argument_index < field_count
				expected = load_string(state.field_types, field_start + argument_index)
				if label != load_string(state.field_names, field_start + argument_index)
					diagnostic(
						state,
						"TRBN4004",
						line,
						"record fields must be initialized in declaration order",
					)
				end
			end
			value := check_expression(state, position, locals, 1, expected)
			arguments.push(checked_mir_value(value))
			argument_index += 1
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, ")")
	if argument_index != field_count
		diagnostic(state, "TRBN4004", line, "record field count does not match " + record_name)
	end
	return mir_checked_record_new(state, locals, record_index, arguments, origin)
end

def check_method_call(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		receiver: CheckedValue,
		method: String,
	): CheckedValue
	if hash_key_type(receiver.type_name) != "" || receiver.type_name == "Hash"
		return checked_hash_call(state, position, locals, receiver, method)
	end
	line := load_integer(state.token_lines, position[0])
	advance(position)
	skip_newlines(state, position)
	if method == "size"
		expect(state, position, ")")
		if receiver.type_name == "String"
			return mir_checked_string_operation(state, locals, 15, checked_mir_value(receiver), - 1, 0, "Integer", position[0] - 1)
		end
		if array_element_type(receiver.type_name) != ""
			return mir_checked_array_operation(state, locals, 20, checked_mir_value(receiver), - 1, 0, "Integer", position[0] - 1)
		end
		return type_diagnostic(state, line, "size is unavailable on " + type_display(state, receiver.type_name))
	end
	if method == "push"
		array_region_operation(locals, 6, 0, position[0])
		element_type := array_element_type(receiver.type_name)
		if element_type == ""
			return type_diagnostic(state, line, "push is unavailable on " + type_display(state, receiver.type_name))
		end
		if receiver.mutable == 0
			diagnostic(state, "TRBN4004", line, "push receiver is immutable")
		elsif !receiver.binding
			diagnostic(state, "TRBN4004", line, "push requires a mutable binding")
		end
		value := check_expression(state, position, locals, 1, element_type)
		skip_newlines(state, position)
		expect(state, position, ")")
		return mir_checked_array_operation(state, locals, 24, checked_mir_value(receiver), checked_mir_value(value), 0, "Void", position[0] - 1)
	end
	if method == "to_i"
		expect(state, position, ")")
		if receiver.type_name == "String"
			return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 2, "Integer", position[0] - 1)
		end
		if receiver.type_name == "Float"
			return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 3, "Integer", position[0] - 1)
		end
	end
	if method == "to_s"
		array_region_operation(locals, 6, 0, position[0])
		expect(state, position, ")")
		if receiver.type_name == "Integer"
			return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 1, "String", position[0] - 1)
		end
	end
	return type_diagnostic(state, line, "unsupported method " + method)
end

def check_postfix(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		initial: CheckedValue,
	): CheckedValue
	mut value := CheckedValue.new(type_name: initial.type_name, category: initial.category, origin: initial.origin, mutable: initial.mutable, binding: initial.binding, readonly: initial.readonly)
	mut scanning := true
	while scanning
		if token_is(state, position[0], "[")
			if hash_key_type(value.type_name) != "" || value.type_name == "Hash"
				value = checked_hash_index(state, position, locals, value)
				if has_diagnostic(state)
					return value
				end
				next
			end
		end
		if token_is(state, position[0], "(")
			mut effect_free := value.category == 5
			if value.category == 1
				callee := find_visible_function(
					state,
					state.active_module[0],
					load_string(state.token_texts, value.origin),
				)
				if callee >= 0
					effect_free = scalar_leaf_inline_eligible(state, callee)
				end
			end
			if !effect_free
				array_region_operation(locals, 6, 0, position[0])
			end
			if value.category < 0
				value = checked_value(value.type_name, 0, value.origin, value.mutable)
			end
			if value.category == 3
				value = checked_value(value.type_name, 0, value.origin, value.mutable)
			end
			if value.category == 0
				value = type_diagnostic(
					state,
					load_integer(state.token_lines, position[0]),
					"value is not directly callable",
				)
				scanning = false
			else
				value = check_call(
					state,
					position,
					locals,
					value.category,
					load_string(state.token_texts, value.origin),
				)
			end
		else
			if token_is(state, position[0], ".")
				advance(position)
				member := expect_identifier(state, position)
				if member == "each" && syntax_iteration_suffix(state, position[0] - 2) >= 0
					position[0] -= 2
					break
				end
				if token_is(state, position[0], "(")
					if member != "size" && member != "to_i" && member != "to_s" && member != "push" && member != "new" && !((value.type_name == "Hash" || hash_key_type(value.type_name) != "") && checked_hash_method(member) != 0)
						scalar_mir_disable(locals)
					end
					if value.category >= 4
						mut expected_member := "sqrt"
						if value.category == 4
							expected_member = "argv"
						end
						if member != expected_member
							value = type_diagnostic(
								state,
								load_integer(state.token_lines, position[0]),
								"unsupported standard package member",
							)
							scanning = false
						end
					else
						if value.category == 2
							if member == "new"
								value = check_record_new(
									state,
									position,
									locals,
									load_string(state.token_texts, value.origin),
								)
							else
								value = type_diagnostic(
									state,
									load_integer(state.token_lines, position[0]),
									"unsupported record constructor member " + member,
								)
								scanning = false
							end
						else
							value = check_method_call(state, position, locals, value, member)
						end
					end
				else
					record_index := find_record_type(state, value.type_name)
					if record_index < 0
						value = type_diagnostic(
							state,
							load_integer(state.token_lines, position[0]),
							"field access requires a record value",
						)
						scanning = false
					else
						field_index := find_field(state, record_index, member)
						if field_index < 0
							value = type_diagnostic(
								state,
								load_integer(state.token_lines, position[0]),
								"unknown field " + member + " on " + type_display(state, value.type_name),
							)
							scanning = false
						else
							value = mir_checked_record_field(state, locals, value, field_index, position[0] - 1)
						end
					end
				end
			else
				if token_is(state, position[0], "[")
					index_origin := position[0]
					checked_assignment_operation(locals, 1, 0, index_origin)
					line := load_integer(state.token_lines, position[0])
					receiver_id := checked_mir_value(value)
					advance(position)
					index := check_expression(state, position, locals, 1, "Integer")
					index_id := checked_mir_value(index)
					checked_assignment_operation(locals, 2, index_origin, position[0])
					if value.origin < state.token_count[0]
						array_local := local_find(locals, load_string(state.token_texts, value.origin))
						if array_local >= 0
							if array_element_type(load_string(locals.types, array_local)) != ""
								if array_local < load_integer(state.function_parameter_counts, locals.mir_state[1])
									array_region_operation(locals, 4, array_local, position[0])
								else
									array_region_operation(locals, 5, array_local, position[0])
								end
							end
						end
					end
					mut lowered := false
					if locals.mir_state[0] == 1 && array_element_type(value.type_name) != ""
						mut assignment := token_is(state, position[0] + 1, "=")
						if binary_operator_id(load_string(state.token_texts, position[0] + 1)) >= 17
							assignment = true
						end
						value = mir_checked_array_index(state, locals, value, index, array_element_type(value.type_name), index_origin, assignment)
						lowered = true
					end
					if !lowered && value.type_name == "String"
						array_region_operation(locals, 6, 0, index_origin)
						value = mir_checked_string_operation(state, locals, 16, receiver_id, index_id, 0, "String", index_origin)
						lowered = true
					end
					if !lowered
						scalar_mir_disable(locals)
						store_integer(state.mir_nonnegative_facts, position[0], index.mutable)
					end
					expect(state, position, "]")
					if !lowered
						if value.type_name == "String"
							array_region_operation(locals, 6, 0, position[0])
							value = checked_value("String", 0, 9007199254740991, 0)
						else
							element_type := array_element_type(value.type_name)
							if element_type == ""
								value = type_diagnostic(
									state,
									line,
									"indexing is unavailable on " + value.type_name,
								)
								scanning = false
							else
								value = checked_bound_value(element_type, 0, index_origin, value.mutable, value.binding)
							end
						end
					end
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def check_expression_value(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		minimum_precedence: Integer,
		expected: String,
	): CheckedValue
	expression_origin := position[0]
	line := load_integer(state.token_lines, position[0])
	mut value := check_postfix(
		state,
		position,
		locals,
		check_primary(state, position, locals, expected),
	)
	mut scanning := true
	while scanning
		operator_origin := position[0]
		operator := load_string(state.token_texts, position[0])
		precedence := syntax_expression_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			mut short :=- 1
			if precedence <= 2
				mut short_value := 0
				if operator == "||"
					short_value = 1
				end
				short = mir_logical_begin(state, locals, value, short_value, operator_origin)
				array_region_operation(locals, 6, 0, operator_origin)
			end
			advance(position)
			skip_newlines(state, position)
			end_origin := position[0]
			right := check_expression(state, position, locals, precedence + 1, "")
			if precedence == 3
				array_region_operation(locals, 6, 0, operator_origin)
				if value.type_name != "Integer" || right.type_name != "Integer"
					return type_diagnostic(state, line, "Range endpoints must be Integer")
				end
				mut exclusive := 0
				if operator == "..."
					exclusive = 1
				end
				state.ranges.push(MirRangeConstruction.new(origin: expression_origin, operator_origin: operator_origin, end_origin: end_origin, finish: position[0], exclusive: exclusive, start_type: value.type_name, end_type: right.type_name))
				store_integer(state.range_origins, operator_origin, state.ranges.size())
				checked_range_require(state, expression_origin, operator_origin, end_origin, position[0])
				value = mir_checked_range_new(state, locals, value, right, exclusive, expression_origin)
				next
			end
			result_type := binary_result_type(state, operator, value.type_name, right.type_name, line, operator_origin)
			if result_type == "String"
				array_region_operation(locals, 6, 0, operator_origin)
			end
			# The compact origin marker exists only while structured checking derives
			# a backend-neutral loop fact and its enclosing-loop dependency.
			mut fact := 0
			if operator == "+"
				if value.mutable < 0
					if right.origin != 9007199254740991
						if small_nonnegative_integer_operand(
								load_string(state.token_texts, right.origin),
							)
							fact = value.mutable
						end
					end
				end
			end
			if precedence <= 2
				value = mir_logical_join(state, locals, value, right, short, operator_origin)
			elsif value.type_name == "String"
				value = mir_checked_string_binary(state, locals, value, right, operator, operator_origin)
			else
				value = scalar_mir_binary(
					state,
					locals,
					operator,
					value,
					right,
					result_type,
					operator_origin,
				)
			end
			if fact != 0
				value = checked_value(value.type_name, value.category, value.origin, fact)
			end
		end
	end
	return value
end

def check_expression(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		minimum_precedence: Integer,
		expected: String,
	): CheckedValue
	# Context guides Array literals without coercing a grouped operand early.
	expression_origin := position[0]
	line := load_integer(state.token_lines, expression_origin)
	mut value := check_expression_value(state, position, locals, minimum_precedence, expected)
	check_expected(state, value.type_name, expected, line)
	if expected == "Float"
		if value.type_name == "Integer"
			value = scalar_mir_convert_float(state, locals, value, expression_origin)
		end
	end
	return value
end

def checked_readonly_reference_binding(
		state: CompilerState,
		locals: CheckedLocals,
		value: CheckedValue,
	): Boolean
	if value.mutable != 0
		return false
	end
	# Only a direct checked binding read retains its binding-token origin.
	# Grouping preserves it; field/index reads and call results clear it.
	# Reference readonly is shallow, not inherited from every container.
	if value.origin >= state.token_count[0]
		return false
	end
	if array_element_type(value.type_name) == "" && hash_key_type(value.type_name) == "" && value.type_name != "Hash"
		if find_record_type(state, value.type_name) < 0
			return false
		end
	end
	return local_find(locals, load_string(state.token_texts, value.origin)) >= 0
end

def check_declaration(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
	): Boolean
	mut mutable := 0
	if token_is(state, position[0], "mut")
		mutable = 1
		advance(position)
	end
	declaration_origin := position[0]
	line := load_integer(state.token_lines, position[0])
	name := expect_identifier(state, position)
	mut declared_type := ""
	if token_is(state, position[0], ":")
		advance(position)
		declared_type = parse_type(state, position)
		resolved_type := resolve_type_name(state, state.active_module[0], declared_type, false)
		if resolved_type == ""
			diagnostic(state, "TRBN4004", line, "unknown local type " + declared_type)
		else
			declared_type = resolved_type
		end
	end
	expect(state, position, ":=")
	value := check_expression(state, position, locals, 1, declared_type)
	value_type := value.type_name
	if mutable == 1
		if checked_readonly_reference_binding(state, locals, value)
			diagnostic(state, "TRBN4004", line, "cannot initialize mutable " + name + " from an immutable value")
		end
	end
	mut fact := 0
	if mutable == 1
		if value.mutable < 0
			fact = value.mutable
		end
		if value.origin != 9007199254740991
			zero := load_string(state.token_texts, value.origin)
			if zero == "0"
				fact = 2
			end
			if zero == "0.0"
				fact = 2
			end
		end
	end
	mut local_type := declared_type
	if local_type == ""
		local_type = value_type
	end
	if local_type == "Void"
		diagnostic(state, "TRBN4004", line, "local binding cannot have type Void")
	end
	added := local_add(state, locals, name, local_type, mutable, line)
	if added && local_type == "Hash"
		if checked_hash_plan(state, value.origin).kind != 1
			diagnostic(state, "TRBN4004", line, "untyped Hash aliases require a Hash<K, V> annotation")
			return false
		end
		store_integer(locals.hash_literal_origins, locals.count[0] - 1, value.origin + 1)
	end
	if !added
		fact = 0
	else
		if array_element_type(local_type) != ""
			array_region_operation(locals, 2, locals.count[0] - 1, declaration_origin)
		end
		mir_value := checked_mir_value(value)
		if locals.mir_state[0] > 0
			if mir_value >= 0
				store_integer(locals.mir_values, locals.count[0] - 1, mir_value + 1)
			else
				scalar_mir_disable(locals)
			end
		end
	end
	finished := finish_statement(state, position)
	if fact != 0 && locals.mir_state[0] == 0
		# Retained direct controls still use their adjacent-loop marker.
		store_integer(locals.mutable, locals.count[0] - 1, position[0] + 3)
		position[1] = fact
	end
	return finished
end

def check_simple_statement(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
	): Boolean
	locals.mir_assignment[0] = []
	line := load_integer(state.token_lines, position[0])
	left := check_expression(state, position, locals, 1, "")
	operator_origin := position[0]
	operator := load_string(state.token_texts, position[0])
	mut assignment := operator == "="
	if binary_operator_id(operator) >= 17
		assignment = true
	end
	if assignment
		if left.readonly
			diagnostic(state, "TRBN4004", line, "record field is readonly")
		elsif left.mutable != 0 && !left.binding
			diagnostic(state, "TRBN4004", line, "assignment requires a mutable binding")
		end
	end
	if operator == "="
		if left.mutable == 0
			diagnostic(state, "TRBN4004", line, "assignment target is immutable")
		end
		advance(position)
		right := check_expression(state, position, locals, 1, left.type_name)
		checked_hash_refine(state, locals, left.origin, right.type_name)
		hash := checked_hash_plan(state, left.origin)
		if hash.kind == 3
			mir_checked_hash_store(state, locals, left, right, hash.type_name)
		elsif !mir_checked_array_store(state, locals, left, right)
			mir_control_assign(state, locals, left, right)
		end
	else
		if binary_operator_id(operator) >= 17
			compound := operator[0]
			if left.mutable == 0
				diagnostic(state, "TRBN4004", line, "assignment target is immutable")
			end
			advance(position)
			right := check_expression(state, position, locals, 1, left.type_name)
			result_type := binary_result_type(state, compound, left.type_name, right.type_name, line, operator_origin)
			if result_type == "String"
				array_region_operation(locals, 6, 0, position[0])
			end
			if locals.mir_state[0] == 1
				mut value := checked_value(result_type, 0, 9007199254740991, 0)
				if result_type == "String"
					value = mir_checked_string_binary(state, locals, left, right, compound, operator_origin)
				else
					value = scalar_mir_binary(state, locals, compound, left, right, result_type, operator_origin)
				end
				if !mir_checked_array_store(state, locals, left, value)
					mir_control_assign(state, locals, left, value)
				end
			end
		end
	end
	if assignment
		if left.origin < state.token_count[0]
			if array_element_type(left.type_name) != ""
				if !token_is(state, left.origin, "[")
					# Rebinding an Array variable can invalidate any retained binding
					# identity. Element stores still leave the header intact.
					array_region_operation(locals, 6, 0, operator_origin)
				end
			end
		end
	end
	if assignment
		if left.origin < state.token_count[0]
			if token_is(state, left.origin, "[") && checked_hash_plan(state, left.origin).kind == 0
				checked_assignment_operation(locals, 5, left.origin, operator_origin)
				state.array_assignment_regions.push(locals.mir_assignment[0])
				region := state.array_assignment_regions.size()
				store_integer(state.array_assignment_targets, left.origin, region)
				store_integer(state.array_assignment_targets, operator_origin, region)
			end
		end
	end
	# Later conditions must not append to a completed assignment region.
	locals.mir_assignment[0] = []
	return finish_statement(state, position)
end

def check_conditional(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		result_type: String,
		loop_origin: Integer,
	): Boolean
	saved_count := locals.count[0]
	array_region_operation(locals, 7, saved_count, position[0])
	mir_control_prepare(state, locals)
	join := mir_control_allocate(locals)
	mut incoming := 0
	mut fact_index := 0
	while fact_index < locals.count[0]
		if load_integer(locals.mutable, fact_index) < 0
			store_integer(locals.mutable, fact_index, 1)
		end
		fact_index += 1
	end
	line := load_integer(state.token_lines, position[0])
	advance(position)
	condition := check_expression(state, position, locals, 1, "Boolean")
	check_expected(state, condition.type_name, "Boolean", line)
	finish_statement(state, position)
	mut alternate := mir_control_branch(state, locals, condition, line)
	check_block(state, position, locals, result_type, loop_origin)
	array_region_operation(locals, 3, saved_count, position[0])
	locals.count[0] = saved_count
	incoming += mir_control_jump(state, locals, join, saved_count)
	mir_control_enter(state, locals, alternate, line)
	while token_is(state, position[0], "elsif")
		array_region_operation(locals, 8, saved_count, position[0])
		branch_line := load_integer(state.token_lines, position[0])
		advance(position)
		branch_condition := check_expression(state, position, locals, 1, "Boolean")
		check_expected(state, branch_condition.type_name, "Boolean", branch_line)
		finish_statement(state, position)
		alternate = mir_control_branch(state, locals, branch_condition, branch_line)
		check_block(state, position, locals, result_type, loop_origin)
		array_region_operation(locals, 3, saved_count, position[0])
		locals.count[0] = saved_count
		incoming += mir_control_jump(state, locals, join, saved_count)
		mir_control_enter(state, locals, alternate, branch_line)
		if has_diagnostic(state)
			return false
		end
	end
	if token_is(state, position[0], "else")
		array_region_operation(locals, 9, saved_count, position[0])
		advance(position)
		finish_statement(state, position)
		check_block(state, position, locals, result_type, loop_origin)
		array_region_operation(locals, 3, saved_count, position[0])
		locals.count[0] = saved_count
	end
	incoming += mir_control_jump(state, locals, join, saved_count)
	if incoming > 0
		mir_control_enter(state, locals, join, load_integer(state.token_lines, position[0]))
	end
	array_region_operation(locals, 10, saved_count, position[0])
	expect(state, position, "end")
	return finish_statement(state, position)
end

def checked_iteration_binding(mut locals: CheckedLocals, name: String, type_name: String)
	index := locals.count[0]
	store_string(locals.names, index, name)
	store_string(locals.types, index, type_name)
	store_integer(locals.mutable, index, 1)
	store_integer(locals.mir_values, index, 0)
	locals.count[0] = index + 1
end

def checked_iteration(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String, parent_loop: Integer): Boolean
	origin := position[0]
	encoded := sparse_integer_at(state.iteration_origins, origin)
	if encoded < 1 || encoded > state.iterations.size()
		return false
	end
	shape := state.iterations[encoded - 1]
	if !checked_iteration_shape(state, shape, origin)
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid iteration syntax plan")
		return false
	end
	array_region_operation(locals, 11, locals.count[0], origin)
	array_region_operation(locals, 6, 0, origin)
	mut fact_index := 0
	while fact_index < locals.count[0]
		if load_integer(locals.mutable, fact_index) < 0
			store_integer(locals.mutable, fact_index, 1)
		end
		fact_index += 1
	end
	receiver := check_expression(state, position, locals, 1, "")
	element_type := iteration_element_type(receiver.type_name)
	if element_type == "" || position[0] != shape.receiver_finish
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "ordinary each requires a supported Array or Range receiver")
		return false
	end
	mut source_kind := 1
	if receiver.type_name == "Range<Integer>"
		source_kind = 2
	end
	plan := MirIteration.new(origin: origin, receiver_finish: shape.receiver_finish, element_origin: shape.element_origin, index_origin: shape.index_origin, body_start: shape.body_start, body_finish: shape.body_finish, finish: shape.finish, parent_loop: parent_loop, source_kind: source_kind, type_name: receiver.type_name, element_type: element_type)
	state.iterations[encoded - 1] = plan
	checked_iteration_require(state, origin, parent_loop)
	saved := locals.count[0]
	# Match the hidden lexical slots used by the adapter so verified header
	# placements for declarations inside this loop keep their local identities.
	checked_iteration_binding(locals, "$iteration.receiver", receiver.type_name)
	checked_iteration_binding(locals, "$iteration.cursor", "Integer")
	if source_kind == 2 && plan.index_origin >= 0
		checked_iteration_binding(locals, "$iteration.ordinal", "Integer")
	end
	element := mir_checked_iteration_begin(state, locals, plan, receiver, saved)
	checked_iteration_binding(locals, load_string(state.token_texts, plan.element_origin), element_type)
	store_integer(locals.mir_values, locals.count[0] - 1, checked_mir_value(element) + 1)
	if plan.index_origin >= 0
		if load_string(state.token_texts, plan.element_origin) == load_string(state.token_texts, plan.index_origin)
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, plan.index_origin), "iteration block parameter is duplicated")
			return false
		end
		checked_iteration_binding(locals, load_string(state.token_texts, plan.index_origin), "Integer")
		mut index_slot := saved + 1
		if source_kind == 2
			index_slot = saved + 2
		end
		store_integer(locals.mir_values, locals.count[0] - 1, load_integer(locals.mir_values, index_slot))
	end
	position[0] = plan.body_start
	check_block(state, position, locals, result_type, origin)
	if position[0] != plan.body_finish
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid iteration body boundary")
	end
	array_region_operation(locals, 3, saved, plan.body_finish)
	array_region_operation(locals, 12, saved, plan.body_finish)
	mir_checked_iteration_end(state, locals, plan, saved)
	locals.count[0] = saved
	position[0] = plan.finish
	return finish_statement(state, position)
end

def checked_scalar_while(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String): Boolean
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	count := locals.count[0]
	array_region_operation(locals, 11, count, origin)
	exit := mir_control_loop_begin(state, locals, origin, line)
	advance(position)
	condition := check_expression(state, position, locals, 1, "Boolean")
	check_expected(state, condition.type_name, "Boolean", line)
	finish_statement(state, position)
	mir_control_loop_branch(state, locals, condition, exit, line)
	check_block(state, position, locals, result_type, origin)
	array_region_operation(locals, 3, count, position[0])
	array_region_operation(locals, 12, count, position[0])
	locals.count[0] = count
	mir_control_loop_end(state, locals, load_integer(state.token_lines, position[0]))
	expect(state, position, "end")
	return finish_statement(state, position)
end

def checked_while(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		result_type: String,
	): Boolean
	if locals.mir_state[0] == 1
		return checked_scalar_while(state, position, locals, result_type)
	end
	loop_start := position[0]
	array_region_operation(locals, 11, locals.count[0], loop_start)
	candidate := locals.count[0] - 1
	mut active := false
	mut fact := 0
	if candidate >= 0
		active = load_integer(locals.mutable, candidate) == loop_start + 3
	end
	if active
		# Retained direct controls keep their enclosing-loop dependency.
		fact = position[1]
		store_integer(locals.mutable, candidate, - loop_start)
	end
	store_integer(state.mir_nonnegative_facts, loop_start, fact)
	line := load_integer(state.token_lines, position[0])
	advance(position)
	condition := check_expression(state, position, locals, 1, "Boolean")
	check_expected(state, condition.type_name, "Boolean", line)
	finish_statement(state, position)
	saved_count := locals.count[0]
	check_block(state, position, locals, result_type, loop_start)
	if active
		if load_integer(locals.mutable, candidate) >= 0
			store_integer(state.mir_nonnegative_facts, loop_start, 0)
		end
		store_integer(locals.mutable, candidate, 1)
	end
	array_region_operation(locals, 3, saved_count, position[0])
	array_region_operation(locals, 12, saved_count, position[0])
	locals.count[0] = saved_count
	expect(state, position, "end")
	finish_statement(state, position)
	return !has_diagnostic(state)
end

def check_block(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		result_type: String,
		loop_origin: Integer,
	): Boolean
	skip_newlines(state, position)
	while true
		if mir_control_active(locals) && locals.mir_control[6] == 1
			if !syntax_block_end(state, position[0]) && !syntax_conditional_tail(state, position[0])
				# Keep checking the unreachable tail for language diagnostics,
				# without emitting values or reopening its terminated MIR block.
				scalar_mir_disable(locals)
				checked := check_block(state, position, locals, result_type, loop_origin)
				locals.mir_state[0] = 1
				return checked
			end
		end
		if locals.mir_state[0] > 0
			if locals.mir_state[4] >= 0
				if !syntax_block_end(state, position[0]) && !syntax_conditional_tail(state, position[0])
					scalar_mir_disable(locals)
				end
			else
				if locals.mir_state[4] == - 2
					if !syntax_block_end(state, position[0]) && !syntax_conditional_tail(state, position[0])
						scalar_mir_disable(locals)
					end
				end
			end
		end
		if terminal_token(state, position[0])
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, position[0]), "unexpected end of input")
			break
		elsif syntax_loop_transfer_kind(state, position[0]) > 0
			if loop_origin < 0
				diagnostic(state, "TRBN4004", load_integer(state.token_lines, position[0]), load_string(state.token_texts, position[0]) + " is only valid inside a loop")
			else
				store_integer(state.loop_transfer_kinds, position[0], syntax_loop_transfer_kind(state, position[0]))
				store_integer(state.loop_transfer_targets, position[0], loop_origin + 1)
				# Transfers carry the enclosing scalar environment; Array induction
				# and nonnegative side proofs still cannot survive an early edge.
				mir_control_transfer(state, locals, loop_origin, syntax_loop_transfer_kind(state, position[0]))
				array_region_operation(locals, 6, 0, position[0])
				mut fact_index := 0
				while fact_index < locals.count[0]
					if load_integer(locals.mutable, fact_index) < 0
						store_integer(locals.mutable, fact_index, 1)
					end
					fact_index += 1
				end
			end
			advance(position)
			finish_statement(state, position)
		elsif syntax_block_end(state, position[0]) || syntax_conditional_tail(state, position[0])
			break
		elsif token_is(state, position[0], "if")
			if !check_conditional(state, position, locals, result_type, loop_origin)
				return false
			end
		elsif token_is(state, position[0], "while")
			if !checked_while(state, position, locals, result_type)
				return false
			end
		elsif sparse_integer_at(state.iteration_origins, position[0]) > 0
			if !checked_iteration(state, position, locals, result_type, loop_origin)
				return false
			end
		elsif token_is(state, position[0], "return")
			line := load_integer(state.token_lines, position[0])
			advance(position)
			if syntax_statement_boundary(state, position[0])
				if result_type != "Void"
					diagnostic(state, "TRBN4004", line, "return value is required")
				else
					if mir_control_active(locals)
						mir_control_return(state, locals, - 1)
						locals.mir_state[4] =- 2
					end
				end
			else
				if result_type == "Void"
					diagnostic(state, "TRBN4004", line, "Void function cannot return a value")
				else
					return_value := check_expression(state, position, locals, 1, result_type)
					if locals.mir_state[0] > 0
						mir_value := checked_mir_value(return_value)
						if mir_value >= 0
							locals.mir_state[4] = mir_value
							mir_control_return(state, locals, mir_value)
						else
							scalar_mir_disable(locals)
						end
					end
				end
			end
			finish_statement(state, position)
		elsif declaration_start(state, position[0])
			check_declaration(state, position, locals)
		else
			statement_start := position[0]
			check_simple_statement(state, position, locals)
			tracked := local_find(
				locals,
				load_string(state.token_texts, statement_start),
			)
			if tracked >= 0
				assignment := load_string(state.token_texts, statement_start + 1)
				if load_integer(locals.mutable, tracked) < 0
					mut valid := assignment != "="
					if assignment.size() == 2
						valid = assignment == "+="
						if valid
							valid = load_string(state.token_texts, statement_start + 2) == "1"
						end
						if valid
							valid = load_integer(state.token_kinds, statement_start + 3) == 4
						end
					end
					if !valid
						store_integer(locals.mutable, tracked, 1)
					end
				end
			end
		end
		if has_diagnostic(state)
			break
		end
	end
	return !has_diagnostic(state)
end

# Validate exact source and nearest-loop bindings before an adapter consumes
# the plan. Zero-filled target storage represents absence, never token zero.
def checked_loop_transfer_kind(mut state: CompilerState, origin: Integer, loop_origin: Integer): Integer
	encoded_target := load_integer(state.loop_transfer_targets, origin)
	mut target :=- 1
	if encoded_target > 0
		target = encoded_target - 1
	end
	plan := MirLoopTransfer.new(
		kind: load_integer(state.loop_transfer_kinds, origin),
		origin: origin,
		target: target,
	)
	if mir_loop_transfer_valid(plan, origin, syntax_loop_transfer_kind(state, origin), loop_origin, state.token_count[0])
		if token_is(state, loop_origin, "while")
			return plan.kind
		end
		encoded_iteration := sparse_integer_at(state.iteration_origins, loop_origin)
		if encoded_iteration > 0 && encoded_iteration <= state.iterations.size()
			iteration := state.iterations[encoded_iteration - 1]
			if checked_iteration_shape(state, iteration, loop_origin) && mir_iteration_valid(iteration, loop_origin, state.token_count[0], iteration.type_name, iteration_element_type(iteration.type_name))
				if origin >= iteration.body_start && origin < iteration.body_finish
					return plan.kind
				end
			end
		end
	end
	diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked loop transfer target")
	return 0
end

def mir_nonnegative_fact(state: CompilerState, origin: Integer): Integer
	fact := load_integer(state.mir_nonnegative_facts, origin)
	if fact < 0
		return mir_nonnegative_fact(state, - fact)
	end
	return fact
end

def checked_array_assignment_store(state: CompilerState, index_origin: Integer): Integer
	store_origin := checked_array_assignment_target(state, index_origin) - 1
	if store_origin < 0
		return - 1
	end
	if store_origin >= state.token_count[0]
		return - 2
	end
	reverse_origin := checked_array_assignment_target(state, store_origin) - 1
	if !mir_array_assignment_valid(index_origin, store_origin, reverse_origin, state.token_count[0])
		return - 2
	end
	operator := load_string(state.token_texts, store_origin)
	if operator != "="
		if binary_operator_id(operator) < 17
			return - 2
		end
	end
	return store_origin
end

def checked_array_assignment_target(state: CompilerState, origin: Integer): Integer
	region := sparse_integer_at(state.array_assignment_targets, origin) - 1
	if region < 0
		return 0
	end
	if region >= state.array_assignment_regions.size()
		return state.token_count[0] + 1
	end
	operations := state.array_assignment_regions[region]
	if operations.size() == 0
		return state.token_count[0] + 1
	end
	store := operations[operations.size() - 1]
	if origin == store.origin
		return store.operand + 1
	end
	if origin == store.operand
		return store.origin + 1
	end
	return state.token_count[0] + 1
end

def checked_array_assignment_plan(state: CompilerState, index_origin: Integer): Integer
	region := load_integer(state.array_assignment_targets, index_origin) - 1
	if region < 0
		return - 1
	end
	if region >= state.array_assignment_regions.size()
		return - 1
	end
	store_origin := checked_array_assignment_store(state, index_origin)
	if store_origin < 0
		return - 1
	end
	if load_integer(state.array_assignment_targets, store_origin) != region + 1
		return - 1
	end
	return mir_array_assignment_plan(state.array_assignment_regions[region], index_origin, store_origin, state.token_count[0])
end

def checked_array_assignment_reads_old(state: CompilerState, index_origin: Integer): Boolean
	store_origin := checked_array_assignment_store(state, index_origin)
	if store_origin < 0
		return false
	end
	return !token_is(state, store_origin, "=")
end
