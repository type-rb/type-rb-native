def checked_hash_literal(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, expected: String): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	mut context := expected
	if nullable_element(context) != ""
		context = nullable_element(context)
	end
	mut key_type := hash_key_type(context)
	mut value_type := hash_value_type(context)
	if state.lambda_phase[0] == 2 && expected == ""
		analyzed := sparse_string_at(state.checked[0].hash_initial_types, origin)
		key_type = hash_key_type(analyzed)
		value_type = hash_value_type(analyzed)
	end
	saved_mir := locals.mir_state[0]
	mut diverged := false
	mut entries := 0
	mut keys: Array<Integer> := []
	mut values: Array<CheckedValue> := []
	advance(position)
	skip_newlines(state, position)
	while !token_is(state, position[0], "}")
		key := check_expression(state, position, locals, 1, "")
		if key.type_name == "Never"
			diverged = true
			scalar_mir_disable(locals)
		elsif !hash_scalar_key(key.type_name)
			return type_diagnostic(state, line, "Hash key must be String or Integer")
		end
		if key.type_name != "Never"
			if key_type != "" && key_type != key.type_name
				return type_diagnostic(state, line, "Hash key type must match exactly")
			end
			key_type = key.type_name
		end
		keys.push(checked_mir_value(key))
		if !expect(state, position, "=>")
			return checked_value("Invalid", 0, origin, 0)
		end
		value := check_expression(state, position, locals, 1, hash_value_type(context))
		if value.type_name == "Never"
			diverged = true
			scalar_mir_disable(locals)
		elsif hash_value_type(context) == ""
			common := common_array_element_type(value_type, value.type_name)
			if common == ""
				return type_diagnostic(state, line, "incompatible Hash value types")
			end
			value_type = common
		end
		values.push(value)
		entries += 1
		skip_newlines(state, position)
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	finish := position[0]
	expect(state, position, "}")
	if diverged
		store_integer(state.checked[0].diverging_hashes, origin, 1)
		locals.mir_state[0] = saved_mir
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	mut type_name := "Hash"
	if key_type != "" && value_type != ""
		type_name = hash_type(key_type, value_type)
	end
	checked_hash_publish(state, mir_hash_operation(1, origin, finish, origin, type_name, true, entries))
	return mir_checked_hash_literal(state, locals, type_name, value_type, origin, keys, values)
end

def checked_hash_index(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	advance(position)
	key := check_expression(state, position, locals, 1, "")
	if key.type_name == "Never"
		finish := position[0]
		expect(state, position, "]")
		checked_hash_publish(state, mir_hash_operation(2, origin, finish, receiver.origin, receiver.type_name, receiver.mutable != 0, 0))
		return key
	end
	if !hash_scalar_key(key.type_name)
		return type_diagnostic(state, line, "Hash key must be String or Integer")
	end
	if hash_key_type(receiver.type_name) != "" && hash_key_type(receiver.type_name) != key.type_name
		return type_diagnostic(state, line, "Hash key type must match exactly")
	end
	finish := position[0]
	expect(state, position, "]")
	mut kind := 2
	if token_is(state, position[0], "=")
		kind = 3
	end
	if binary_operator_id(load_string(state.token_texts, position[0])) >= 17
		return type_diagnostic(state, line, "compound assignment to Hash entries is unsupported")
	end
	mut type_name := receiver.type_name
	if type_name == "Hash"
		if kind != 3
			return type_diagnostic(state, line, "cannot index an untyped Hash; add Hash<K, V> annotation")
		end
		type_name = hash_type(key.type_name, "")
	end
	if kind == 3 && !checked_hash_binding_target(state, receiver.origin)
		return type_diagnostic(state, line, "assignment requires a mutable binding")
	end
	checked_hash_publish(state, mir_hash_operation(kind, origin, finish, receiver.origin, type_name, receiver.mutable != 0, 0))
	return mir_checked_hash_index(state, locals, receiver, key, hash_value_type(type_name), origin, kind == 3)
end

def checked_hash_inference_region(state: CompilerState, locals: CheckedLocals, origin: Integer): Boolean
	if origin < 0 || origin >= state.token_count[0]
		return false
	end
	plan := checked_hash_plan(state, origin)
	if plan.kind != 3 || plan.receiver_origin < 0 || plan.receiver_origin >= state.token_count[0] || hash_value_type(plan.type_name) == "" || locals.inference_active_region[0] == 0
		return false
	end
	binding := local_find(locals, load_string(state.token_texts, plan.receiver_origin))
	if binding < 0 || load_integer(locals.hash_literal_origins, binding) == 0 || load_integer(locals.hash_inference_regions, binding) != locals.inference_active_region[0]
		return false
	end
	return true
end

def checked_hash_numeric_region(state: CompilerState, locals: CheckedLocals, origin: Integer): Boolean
	if !checked_hash_inference_region(state, locals, origin)
		return false
	end
	return hash_value_type(checked_hash_plan(state, origin).type_name) == "Integer"
end

def checked_hash_refine(mut state: CompilerState, mut locals: CheckedLocals, origin: Integer, value_type: String)
	plan := checked_hash_plan(state, origin)
	if plan.kind != 3
		return
	end
	first_store := plan.value_type == ""
	if !first_store && !checked_hash_inference_region(state, locals, origin)
		return
	end
	mut resolved := value_type
	if !first_store
		resolved = common_array_element_type(plan.value_type, value_type)
		if resolved == ""
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "incompatible inferred Hash value types")
			return
		end
		if resolved == plan.value_type
			return
		end
	end
	binding := local_find(locals, load_string(state.token_texts, plan.receiver_origin))
	if binding < 0
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "empty Hash requires a typed binding")
		return
	end
	type_name := hash_type(plan.key_type, resolved)
	store_string(locals.types, binding, type_name)
	if first_store
		store_integer(locals.hash_inference_regions, binding, locals.inference_active_region[0])
	end
	declaration := load_integer(locals.hash_declaration_origins, binding)
	if declaration > 0
		store_string(state.checked[0].local_types, declaration - 1, type_name)
	end
	literal_origin := load_integer(locals.hash_literal_origins, binding) - 1
	literal := checked_hash_plan(state, literal_origin)
	if literal.kind != 1
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "empty Hash requires a typed binding")
		return
	end
	checked_hash_publish(state, mir_hash_operation(1, literal.origin, literal.finish, literal.receiver_origin, type_name, true, 0))
	checked_hash_publish(state, mir_hash_operation(3, plan.origin, plan.finish, plan.receiver_origin, type_name, plan.mutable, 0))
end

def checked_hash_call(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue, method: String): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	kind := checked_hash_method(method)
	if kind == 0
		return type_diagnostic(state, line, "unsupported Hash method " + method)
	end
	if receiver.type_name == "Hash" && kind != 4 && kind != 12
		return type_diagnostic(state, line, "Hash method requires a concrete Hash<K, V> type")
	end
	if kind == 6 || kind == 9
		if receiver.mutable == 0 || !receiver.binding || !checked_hash_binding_target(state, receiver.origin)
			return type_diagnostic(state, line, "Hash mutation requires a mutable binding")
		end
	end
	advance(position)
	mut result_type := receiver.type_name
	mut argument :=- 1
	mut diverged := false
	if kind == 5 || kind == 6 || kind == 13
		value := check_expression(state, position, locals, 1, hash_key_type(receiver.type_name))
		argument = checked_mir_value(value)
		diverged = value.type_name == "Never"
		result_type = hash_value_type(receiver.type_name)
	end
	if kind == 8 || kind == 9
		value := check_expression(state, position, locals, 1, receiver.type_name)
		argument = checked_mir_value(value)
		diverged = value.type_name == "Never"
	end
	if kind == 4
		result_type = "Integer"
	elsif kind == 5 || kind == 12
		result_type = "Boolean"
	elsif kind == 9
		result_type = "Void"
	elsif kind == 10
		result_type = array_type(hash_key_type(receiver.type_name))
	elsif kind == 11
		result_type = array_type(hash_value_type(receiver.type_name))
	end
	if result_type == ""
		return type_diagnostic(state, line, "unsupported Hash result representation")
	end
	skip_newlines(state, position)
	finish := position[0]
	expect(state, position, ")")
	checked_hash_publish(state, mir_hash_operation(kind, origin, finish, receiver.origin, receiver.type_name, receiver.mutable != 0, 0))
	if diverged
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	value := mir_checked_hash_method(state, locals, receiver, argument, kind, result_type, origin)
	return checked_value(result_type, value.category, 9007199254740991, 0)
end

def check_array_literal(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		expected: String,
	): CheckedValue
	origin := position[0]
	mut values: Array<CheckedValue> := []
	line := load_integer(state.token_lines, origin)
	advance(position)
	skip_newlines(state, position)
	mut context := expected
	if nullable_element(context) != ""
		context = nullable_element(context)
	end
	contextual_element_type := array_element_type(context)
	mut element_type := contextual_element_type
	saved_mir := locals.mir_state[0]
	mut diverged := false
	mut finished := false
	while !finished
		if token_is(state, position[0], "]")
			finished = true
		else
			value := check_expression(state, position, locals, 1, contextual_element_type)
			if value.type_name == "Never"
				diverged = true
				scalar_mir_disable(locals)
			end
			values.push(value)
			if contextual_element_type == "" && value.type_name != "Never"
				common_type := common_array_element_type(element_type, value.type_name)
				if common_type == ""
					check_expected(
						state,
						value.type_name,
						element_type,
						load_integer(state.token_lines, position[0]),
					)
				else
					element_type = common_type
				end
			end
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	if !expect(state, position, "]")
		return checked_value("Invalid", 0, 9007199254740991, 0)
	end
	if diverged
		locals.mir_state[0] = saved_mir
		store_string(state.checked[0].array_literal_types, origin, "Never")
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	mut result_type := "Array"
	if element_type != ""
		result_type = array_type(element_type)
	end
	if result_type == ""
		return type_diagnostic(state, line, "unsupported Array element type " + element_type)
	end
	store_string(state.checked[0].array_literal_types, origin, result_type)
	return mir_checked_array_literal(state, locals, result_type, element_type, origin, values)
end

def check_primary(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		expected: String,
	): CheckedValue
	if token_is(state, position[0], ":")
		advance(position)
		origin := position[0]
		advance(position)
		return mir_checked_string_literal(state, locals, origin)
	end
	if token_is(state, position[0], "if") || token_is(state, position[0], "case")
		return check_control_value(state, position, locals, true, expected, checked_value("Invalid", 0, 9007199254740991, 0))
	end
	if token_is(state, position[0], "try")
		if locals.value_block[0]
			return type_diagnostic(state, load_integer(state.token_lines, position[0]), "try is unavailable inside a value-producing collection block")
		end
		try_origin := position[0]
		advance(position)
		value := check_postfix(state, position, locals, check_primary(state, position, locals, ""))
		if value.type_name == "Never"
			return value
		end
		boundary := checked_return_type(state, locals)
		operation := result_operation(state, try_origin, position[0], value.type_name, boundary)
		return checked_result_try(state, locals, value, operation)
	end
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	kind := load_integer(state.token_kinds, origin)
	if token_is(state, origin, "fn")
		value := check_lambda_value(state, position, locals)
		if state.lambda_phase[0] == 0 && locals.lambda_result.size() == 0 && !has_diagnostic(state)
			return type_diagnostic(state, line, "fn values require lexical capture lowering, which is not yet supported")
		end
		return value
	end
	if token_is(state, origin, "nil")
		advance(position)
		return mir_checked_nullable(state, locals, 33, checked_value("Nil", 0, origin, 0), "Nil", 0, origin)
	end
	if kind == 2
		literal := load_string(state.token_texts, origin)
		advance(position)
		if number_is_float(literal)
			if !float_literal_in_range(literal)
				return type_diagnostic(state, line, "Float literal is outside the finite binary64 range")
			end
			return scalar_mir_literal(state, locals, "Float", origin, literal)
		end
		if !integer_literal_in_range(literal)
			return type_diagnostic(state, line, "Integer literal is outside the portable range")
		end
		return scalar_mir_literal(state, locals, "Integer", origin, literal)
	end
	if kind == 3
		advance(position)
		return mir_checked_string_literal(state, locals, origin)
	end
	if token_is(state, position[0], "{")
		return checked_hash_literal(state, position, locals, expected)
	end
	if token_is(state, position[0], "[")
		return check_array_literal(state, position, locals, expected)
	end
	if token_is(state, position[0], "(")
		advance(position)
		skip_newlines(state, position)
		value := check_expression_value(state, position, locals, 1, expected)
		skip_newlines(state, position)
		expect(state, position, ")")
		return value
	end
	if token_is(state, position[0], "!")
		advance(position)
		value := check_expression_value(state, position, locals, 8, "Boolean")
		if value.type_name == "Never"
			return value
		end
		check_expected(state, value.type_name, "Boolean", line)
		return scalar_mir_unary(state, locals, "!", value, "Boolean", origin)
	end
	if token_is(state, position[0], "-")
		advance(position)
		mut value := check_expression_value(state, position, locals, 8, "")
		if value.type_name == "Never"
			return value
		end
		value = mir_literal_scalar(state, locals, value, origin)
		if !numeric_type(value.type_name)
			return type_diagnostic(state, line, "unary - requires Integer or Float")
		end
		return scalar_mir_unary(state, locals, "-", value, value.type_name, origin)
	end
	if token_is(state, position[0], "+")
		advance(position)
		mut value := check_expression_value(state, position, locals, 8, "")
		if value.type_name == "Never"
			return value
		end
		value = mir_literal_scalar(state, locals, value, origin)
		if !numeric_type(value.type_name)
			return type_diagnostic(state, line, "unary + requires Integer or Float")
		end
		return scalar_mir_unary(state, locals, "+", value, value.type_name, origin)
	end
	if kind == 8
		advance(position)
		return checked_instance_field(state, locals, origin, position[0])
	end
	if kind == 1
		application_finish := sparse_integer_at(state.checked[0].generic_application_finishes, origin)
		if application_finish > origin
			if sparse_integer_at(state.checked[0].generic_calls, application_finish) > 0
				if local_find(locals, load_string(state.token_texts, origin)) >= 0 || find_visible_global(state, state.module_graph.active_module[0], load_string(state.token_texts, origin), origin) >= 0
					return type_diagnostic(state, line, "local value does not accept type arguments")
				end
				position[0] = application_finish
				return checked_value("", 1, origin, 0)
			end
			if find_object_type(state, sparse_string_at(state.checked[0].generic_application_types, origin)) >= 0
				position[0] = application_finish
				return checked_value(sparse_string_at(state.checked[0].generic_application_types, origin), 8, origin, 0)
			end
			if find_newtype_type(state, sparse_string_at(state.checked[0].generic_application_types, origin)) >= 0
				position[0] = application_finish
				return checked_value(sparse_string_at(state.checked[0].generic_application_types, origin), 7, origin, 0)
			end
			if find_enum_type(state, sparse_string_at(state.checked[0].generic_application_types, origin)) >= 0
				if token_is(state, application_finish, ".")
					position[0] = application_finish
					return checked_value(sparse_string_at(state.checked[0].generic_application_types, origin), 6, origin, 0)
				end
				return check_enum_constructor(state, position, locals)
			end
			if find_record_type(state, sparse_string_at(state.checked[0].generic_application_types, origin)) < 0
				return type_diagnostic(state, line, "constructor requires a nominal type")
			end
			position[0] = application_finish
			return checked_value("", 2, origin, 0)
		end
		mut selected_position := [origin]
		mut name := load_string(state.token_texts, origin)
		if name == "_"
			return type_diagnostic(state, line, "blank binding _ cannot be used as a value")
		end
		if local_find(locals, name) < 0
			name = parse_declaration_reference(state, selected_position)
		else
			selected_position[0] += 1
		end
		if token_is(state, selected_position[0], "::")
			return check_enum_constructor(state, position, locals)
		end
		position[0] = selected_position[0]
		if find_visible_declaration(state, state.module_graph.active_module[0], name, 6) >= 0
			return type_diagnostic(state, line, "module declaration is not a runtime value")
		end
		if name == "true"
			return scalar_mir_literal(state, locals, "Boolean", origin, "true")
		end
		if name == "false"
			return scalar_mir_literal(state, locals, "Boolean", origin, "false")
		end
		local_index := local_find(locals, name)
		if local_index >= 0
			lambda_use_binding(locals, local_index)
			store_integer(locals.binding_use_counts, local_index, sparse_integer_at(locals.binding_use_counts, local_index) + 1)
			value := mir_binding_read(state, locals, local_index, origin)
			return nullable_read(state, locals, value, local_index, - 1, origin)
		end
		if name == "value" && token_is(state, position[0], "(")
			self_slot := local_find(locals, "self")
			if self_slot >= 0 && find_newtype_type(state, load_string(locals.types, self_slot)) >= 0
				lambda_use_binding(locals, self_slot)
				receiver := mir_binding_read(state, locals, self_slot, origin)
				return check_newtype_member(state, position, locals, receiver, "value")
			end
		end
		mut newtype_owner := find_visible_newtype(state, state.module_graph.active_module[0], name)
		if name == "self"
			newtype_owner = find_newtype_in_module(state, state.module_graph.active_module[0], state.declaration_owner[0])
		end
		if newtype_owner >= 0 && token_is(state, position[0], ".")
			return checked_value(newtype_type(newtype_owner), 7, origin, 0)
		end
		if name == "self" && token_is(state, position[0], ".")
			class_type := object_static_self_type(state)
			if class_type != ""
				return checked_value(class_type, 8, origin, 0)
			end
		end
		constant := find_visible_global(state, state.module_graph.active_module[0], name, origin)
		if constant >= 0
			return checked_global_read(state, locals, constant, origin)
		end
		standard_package := standard_package_import(state, state.module_graph.active_module[0], name)
		if standard_package < - 1
			return checked_value(standard_package_root(standard_package), 2 - standard_package, origin, 0)
		end
		if token_is(state, position[0], "(") && sparse_integer_at(state.checked[0].generic_calls, position[0]) > 0
			return checked_value("", 1, origin, 0)
		end
		if name == "puts"
			return checked_value("", 1, origin, 0)
		end
		function := find_visible_function(state, state.module_graph.active_module[0], name)
		if function >= 0
			if !namespace_member_access(state, load_integer(state.function_modules, function), load_string(state.function_names, function), origin)
				return checked_value("", 0, origin, 0)
			end
			if token_is(state, position[0], "(")
				return checked_value("", 1, origin, 0)
			end
			if namespace_parent(load_string(state.function_names, function)) != ""
				return type_diagnostic(state, line, "module method requires an explicit fn wrapper to be used as a value")
			end
			return checked_function_value(state, locals, function, origin)
		end
		if find_visible_generic_function(state, state.module_graph.active_module[0], name) >= 0
			return type_diagnostic(state, line, "function " + name + " requires an explicit fn wrapper to be used as a value")
		end
		enum_owner := find_visible_enum(state, state.module_graph.active_module[0], name)
		if enum_owner >= 0 && token_is(state, position[0], ".")
			return checked_value(enum_type(enum_owner), 6, origin, 0)
		end
		if find_visible_declaration(state, state.module_graph.active_module[0], name, 9) >= 0
			return checked_value(resolve_type_name(state, state.module_graph.active_module[0], name, false), 8, origin, 0)
		end
		if find_visible_record(state, state.module_graph.active_module[0], name) >= 0
			return checked_value("", 2, origin, 0)
		end
		return type_diagnostic(state, line, "unresolved value " + name)
	end
	return type_diagnostic(state, line, "expected an expression")
end

def check_call(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, callee_category: Integer, callee_name: String, target: Integer, mut receiver: Integer, bound: Boolean): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	advance(position)
	skip_newlines(state, position)
	mut function := target
	if function < 0
		function = find_visible_function(state, state.module_graph.active_module[0], callee_name)
	end
	encoded := sparse_integer_at(state.checked[0].generic_calls, origin)
	if encoded > 0
		function = encoded - 1
	end
	mut parameter_start := 0
	mut result_type := "Void"
	if (callee_name == "puts" && encoded == 0) || callee_category == 4 || callee_category == 5
		function =- 1
	elsif function >= 0
		parameter_start = load_integer(state.function_parameter_starts, function)
		result_type = load_string(state.function_result_types, function)
	else
		return type_diagnostic(state, line, "value is not callable")
	end
	mut bindings := function_argument_bindings(state, function)
	if function >= 0 && sparse_string_at(state.function_receivers, function) != ""
		if !bound
			self_slot := local_find(locals, "self")
			if self_slot < 0 || load_string(locals.types, self_slot) != sparse_string_at(state.function_receivers, function)
				return type_diagnostic(state, line, "instance method requires its nominal receiver")
			end
			lambda_use_binding(locals, self_slot)
			receiver = checked_mir_value(mir_binding_read(state, locals, self_slot, origin))
		end
		bindings.values[0] = receiver
		bindings.provided[0] = true
		bindings.position[0] = 1
	end
	if callee_category == 4
		bindings = argument_bindings([], [])
		result_type = "Array<String>"
	elsif callee_category == 5
		result_type = "Float"
	end
	saved_mir := locals.mir_state[0]
	mut diverged := false
	mut finished := false
	while !finished
		if token_is(state, position[0], ")")
			finished = true
		else
			argument_line := load_integer(state.token_lines, position[0])
			label := parse_argument_label(state, position)
			slot := argument_binding_slot(bindings, label)
			if slot < 0
				if bindings.error[0] == "too many positional arguments"
					return type_diagnostic(state, line, "call argument count does not match " + callee_name)
				end
				return type_diagnostic(state, argument_line, bindings.error[0])
			end
			mut expected := ""
			if callee_category == 5
				expected = "Float"
			elsif function >= 0
				expected = load_string(state.parameter_types, parameter_start + slot)
			end
			mut argument := check_expression(state, position, locals, 1, expected)
			if callee_name == "puts" && encoded == 0
				argument = mir_literal_scalar(state, locals, argument, origin)
			end
			if argument.type_name == "Never"
				diverged = true
				scalar_mir_disable(locals)
			end
			bindings.values[slot] = checked_mir_value(argument)
			if (callee_name == "puts" && encoded == 0) && !mir_puts_type(argument.type_name)
				diagnostic(state, "TRBN4004", line, "puts does not yet support " + type_display(state, argument.type_name))
			end
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, ")")
	if !mir_complete_arguments(state, locals, bindings, origin)
		diagnostic(state, "TRBN4004", line, "call argument count does not match " + callee_name)
	end
	if diverged
		locals.mir_state[0] = saved_mir
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	if (callee_name == "puts" && encoded == 0)
		return mir_checked_puts(state, locals, bindings.values, origin)
	end
	if callee_category == 4 || callee_category == 5
		return mir_checked_standard_call(state, locals, callee_category, bindings.values, result_type, origin)
	end
	if callee_category == 9
		value := mir_checked_object_new(state, locals, receiver, object_instance_type(state, receiver), origin)
		bindings.values[0] = checked_mir_value(value)
		mir_checked_call(state, locals, function, bindings.values, result_type, origin)
		return value
	end
	return mir_checked_call(state, locals, function, bindings.values, result_type, origin)
end

def check_record_new(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, record_origin: Integer): CheckedValue
	record_name := checked_reference_name(state, record_origin)
	mut record_index := find_record_type(state, sparse_string_at(state.checked[0].generic_application_types, record_origin))
	if record_index < 0
		record_index = find_visible_record(state, state.module_graph.active_module[0], record_name)
	end
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	advance(position)
	skip_newlines(state, position)
	start := load_integer(state.record_field_starts, record_index)
	mut bindings := record_argument_bindings(state, record_index)
	saved_mir := locals.mir_state[0]
	mut diverged := false
	mut finished := false
	while !finished
		if token_is(state, position[0], ")")
			finished = true
		else
			argument_line := load_integer(state.token_lines, position[0])
			label := parse_argument_label(state, position)
			slot := argument_binding_slot(bindings, label)
			if slot < 0
				return type_diagnostic(state, argument_line, bindings.error[0])
			end
			value := check_expression(state, position, locals, 1, load_string(state.field_types, start + slot))
			if value.type_name == "Never"
				diverged = true
				scalar_mir_disable(locals)
			end
			bindings.values[slot] = checked_mir_value(value)
			if token_is(state, position[0], ",")
				advance(position)
				skip_newlines(state, position)
			else
				finished = true
			end
		end
	end
	expect(state, position, ")")
	if !mir_complete_arguments(state, locals, bindings, origin)
		diagnostic(state, "TRBN4004", line, "record field count does not match " + record_name)
	end
	if diverged
		locals.mir_state[0] = saved_mir
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	return mir_checked_record_new(state, locals, record_index, record_type(record_index), bindings.values, origin)
end

def checked_array_refine(mut state: CompilerState, mut locals: CheckedLocals, receiver: CheckedValue, element_type: String): String
	binding := local_find(locals, load_string(state.token_texts, receiver.origin))
	if binding < 0 || load_integer(locals.array_literal_origins, binding) == 0
		return "cannot infer an untyped Array after its value escapes"
	end
	inferred := array_type(element_type)
	if inferred == ""
		return "unsupported inferred Array element type " + element_type
	end
	store_string(locals.types, binding, inferred)
	store_string(state.checked[0].array_literal_types, load_integer(locals.array_literal_origins, binding) - 1, inferred)
	store_string(state.checked[0].local_types, load_integer(locals.array_declaration_origins, binding) - 1, inferred)
	if receiver.type_name == "Array"
		store_integer(locals.array_inference_regions, binding, locals.inference_active_region[0])
	end
	mir_checked_array_refine(state, locals, receiver, inferred)
	return ""
end

def checked_array_numeric_region(state: CompilerState, locals: CheckedLocals, receiver: CheckedValue): Boolean
	if receiver.type_name != "Array<Integer>" || locals.inference_active_region[0] == 0
		return false
	end
	if receiver.origin < 0 || receiver.origin >= state.token_count[0]
		return false
	end
	binding := local_find(locals, load_string(state.token_texts, receiver.origin))
	if binding < 0 || load_integer(locals.array_literal_origins, binding) == 0 || load_integer(locals.array_inference_regions, binding) != locals.inference_active_region[0]
		return false
	end
	return true
end

def checked_array_numeric_candidate(mut state: CompilerState, mut locals: CheckedLocals, value: CheckedValue, origin: Integer, eligible: Boolean): Integer
	if !eligible || value.type_name != "Integer" || locals.inference_active_region[0] == 0
		return - 1
	end
	converted := scalar_mir_convert_float(state, locals, value, origin)
	return checked_mir_value(converted)
end

def checked_array_numeric_record(mut locals: CheckedLocals, receiver: CheckedValue, conversion: Integer)
	if conversion < 0
		return
	end
	locals.mir_array_numeric_candidates.push(locals.mir_instructions.size() - 1)
	locals.mir_array_numeric_candidates.push(conversion)
	locals.mir_array_numeric_candidates.push(checked_mir_value(receiver))
end

def check_method_call(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		receiver: CheckedValue,
		method: String,
	): CheckedValue
	if find_newtype_type(state, receiver.type_name) >= 0
		return check_newtype_member(state, position, locals, receiver, method)
	end
	if method == "raw_value" && raw_enum_type(state, find_enum_type(state, receiver.type_name)) != ""
		origin := position[0]
		advance(position)
		skip_newlines(state, position)
		expect(state, position, ")")
		return checked_raw_enum_value(state, locals, receiver, origin)
	end
	function := enum_method_function(state, receiver.type_name, method)
	if function >= 0
		if !namespace_member_access(state, load_integer(state.function_modules, function), enum_method_declaration_name(state, receiver.type_name, method), position[0])
			return checked_value("Invalid", 0, position[0], 0)
		end
		return check_call(state, position, locals, 1, "", function, checked_mir_value(receiver), true)
	end
	if builtin_result_method(receiver.type_name, method) > 0
		return check_builtin_lookup(state, position, locals, receiver, method)
	end
	if hash_key_type(receiver.type_name) != "" || receiver.type_name == "Hash"
		return checked_hash_call(state, position, locals, receiver, method)
	end
	mut unshift_numeric_region := false
	if receiver.type_name == "Array<Integer>" && method == "unshift"
		unshift_numeric_region = checked_array_numeric_region(state, locals, receiver)
	end
	if (receiver.type_name == "Array" || unshift_numeric_region) && method == "unshift"
		origin := position[0]
		line := load_integer(state.token_lines, origin)
		if receiver.mutable == 0
			return type_diagnostic(state, line, "unshift receiver is immutable")
		end
		if !receiver.binding
			return type_diagnostic(state, line, "unshift requires a mutable binding")
		end
		advance(position)
		skip_newlines(state, position)
		mut argument_type := array_element_type(receiver.type_name)
		if unshift_numeric_region
			argument_type = ""
		end
		value := check_expression(state, position, locals, 1, argument_type)
		skip_newlines(state, position)
		expect(state, position, ")")
		if value.type_name == "Never"
			return value
		end
		if has_diagnostic(state)
			return checked_value("Invalid", 0, origin, 0)
		end
		if receiver.type_name == "Array"
			error := checked_array_refine(state, locals, receiver, value.type_name)
			if error != ""
				return type_diagnostic(state, line, error)
			end
		elsif value.type_name == "Float"
			error := checked_array_refine(state, locals, receiver, "Float")
			if error != ""
				return type_diagnostic(state, line, error)
			end
		else
			check_expected(state, value.type_name, "Integer", line)
		end
		mut candidate_eligible := unshift_numeric_region
		if receiver.type_name == "Array"
			candidate_eligible = true
		end
		conversion := checked_array_numeric_candidate(state, locals, value, origin, candidate_eligible)
		result := mir_checked_array_operation(state, locals, 48, checked_mir_value(receiver), checked_mir_value(value), 0, "Void", origin)
		checked_array_numeric_record(locals, receiver, conversion)
		return result
	end
	if (receiver.type_name == "Range<Integer>" && method == "to_a") || (receiver.type_name == "Integer" && integer_method_kind(method) > 0) || (receiver.type_name == "Float" && float_method_kind(method) > 0) || (receiver.type_name == "String" && string_method_kind(method) > 0) || (array_element_type(receiver.type_name) != "" && array_method_kind(method) > 0) || (receiver.type_name == "Array" && method == "empty?")
		return check_primitive_method(state, position, locals, receiver, method)
	end
	line := load_integer(state.token_lines, position[0])
	advance(position)
	skip_newlines(state, position)
	if method == "size"
		expect(state, position, ")")
		if receiver.type_name == "String"
			return mir_checked_string_operation(state, locals, 15, checked_mir_value(receiver), - 1, 0, "Integer", position[0] - 1)
		end
		if array_element_type(receiver.type_name) != "" || receiver.type_name == "Array"
			return mir_checked_array_operation(state, locals, 20, checked_mir_value(receiver), - 1, 0, "Integer", position[0] - 1)
		end
		return type_diagnostic(state, line, "size is unavailable on " + type_display(state, receiver.type_name))
	end
	if method == "push"
		element_type := array_element_type(receiver.type_name)
		numeric_region := checked_array_numeric_region(state, locals, receiver)
		if element_type == "" && receiver.type_name != "Array"
			return type_diagnostic(state, line, "push is unavailable on " + type_display(state, receiver.type_name))
		end
		if receiver.mutable == 0
			diagnostic(state, "TRBN4004", line, "push receiver is immutable")
		elsif !receiver.binding
			diagnostic(state, "TRBN4004", line, "push requires a mutable binding")
		end
		mut argument_type := element_type
		if numeric_region
			argument_type = ""
		end
		value := check_expression(state, position, locals, 1, argument_type)
		skip_newlines(state, position)
		expect(state, position, ")")
		if value.type_name == "Never"
			return value
		end
		if receiver.type_name == "Array" && !has_diagnostic(state)
			error := checked_array_refine(state, locals, receiver, value.type_name)
			if error != ""
				return type_diagnostic(state, line, error)
			end
		elsif numeric_region && !has_diagnostic(state)
			if value.type_name == "Float"
				error := checked_array_refine(state, locals, receiver, "Float")
				if error != ""
					return type_diagnostic(state, line, error)
				end
			else
				check_expected(state, value.type_name, element_type, line)
			end
		end
		mut candidate_eligible := numeric_region
		if receiver.type_name == "Array"
			candidate_eligible = true
		end
		conversion := checked_array_numeric_candidate(state, locals, value, position[0] - 1, candidate_eligible)
		result := mir_checked_array_operation(state, locals, 24, checked_mir_value(receiver), checked_mir_value(value), 0, "Void", position[0] - 1)
		checked_array_numeric_record(locals, receiver, conversion)
		return result
	end
	if method == "to_f" && receiver.type_name == "String"
		expect(state, position, ")")
		return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 6, "Float", position[0] - 1)
	end
	if method == "to_i"
		expect(state, position, ")")
		if receiver.type_name == "String"
			return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 2, "Integer", position[0] - 1)
		end
	end
	if method == "to_s"
		expect(state, position, ")")
		if receiver.type_name == "Integer"
			return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 1, "String", position[0] - 1)
		end
		if receiver.type_name == "Float"
			return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 4, "String", position[0] - 1)
		end
		if receiver.type_name == "Boolean"
			return mir_checked_string_operation(state, locals, 17, checked_mir_value(receiver), - 1, 5, "String", position[0] - 1)
		end
	end
	return type_diagnostic(state, line, "unsupported method " + method)
end

# Bottom-valued receivers have no field/index/call operation to emit. Their
# suffixes still receive syntax and nested-expression checks.
def check_never_postfix(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, value: CheckedValue): CheckedValue
	saved_mir := locals.mir_state[0]
	scalar_mir_disable(locals)
	mut scanning := true
	while scanning && !has_diagnostic(state)
		if token_is(state, position[0], ".")
			if syntax_iteration_suffix(state, position[0]) >= 0
				break
			end
			advance(position)
			expect_identifier(state, position)
		elsif token_is(state, position[0], "[")
			advance(position)
			skip_newlines(state, position)
			check_expression(state, position, locals, 1, "")
			skip_newlines(state, position)
			expect(state, position, "]")
		elsif token_is(state, position[0], "(")
			advance(position)
			skip_newlines(state, position)
			while !token_is(state, position[0], ")") && !has_diagnostic(state)
				parse_argument_label(state, position)
				check_expression(state, position, locals, 1, "")
				if !token_is(state, position[0], ",")
					break
				end
				advance(position)
				skip_newlines(state, position)
			end
			skip_newlines(state, position)
			expect(state, position, ")")
		else
			scanning = false
		end
	end
	locals.mir_state[0] = saved_mir
	return value
end

def check_member(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue, member: String): CheckedValue
	mut value := mir_literal_scalar(state, locals, checked_view(receiver, receiver.type_name, receiver.category), position[0])
	if find_object_type(state, value.type_name) >= 0
		return check_object_member(state, position, locals, value, member)
	end
	if find_newtype_type(state, value.type_name) >= 0
		return check_newtype_member(state, position, locals, value, member)
	end
	if value.category == 6
		owner := find_enum_type(state, value.type_name)
		raw_type := raw_enum_type(state, owner)
		origin := position[0]
		if member != "from_raw" || raw_type == "" || !token_is(state, origin, "(")
			return type_diagnostic(state, load_integer(state.token_lines, origin), "enum type requires a valid from_raw call")
		end
		advance(position)
		skip_newlines(state, position)
		argument := check_expression(state, position, locals, 1, raw_type)
		skip_newlines(state, position)
		expect(state, position, ")")
		if argument.type_name == "Never"
			return argument
		end
		return checked_raw_enum_from(state, locals, owner, argument, origin)
	end
	owner := find_record_type(state, value.type_name)
	if owner >= 0
		field := find_field(state, owner, member)
		if field >= 0 && callable_parts(load_string(state.field_types, field)).size() > 0
			return mir_checked_record_field(state, locals, value, field, load_string(state.field_types, field), position[0] - 1)
		end
	end
	if union_parts(value.type_name).size() > 0 && callable_parts(union_member_type(state, value.type_name, member)).size() > 0
		return check_union_member(state, locals, value, member, position[0] - 1)
	end
	if token_is(state, position[0], "(")
		if value.category < 4 && !(member == "raw_value" && raw_enum_type(state, find_enum_type(state, value.type_name)) != "") && enum_method_function(state, value.type_name, member) < 0 && builtin_result_method(value.type_name, member) == 0 && member != "size" && member != "to_i" && member != "to_f" && member != "to_s" && member != "push" && member != "new" && !(value.type_name == "Range<Integer>" && member == "to_a") && !(value.type_name == "Integer" && integer_method_kind(member) > 0) && !(value.type_name == "Float" && float_method_kind(member) > 0) && !(value.type_name == "String" && string_method_kind(member) > 0) && !(array_element_type(value.type_name) != "" && array_method_kind(member) > 0) && !(value.type_name == "Array" && (member == "empty?" || member == "unshift")) && !((value.type_name == "Hash" || hash_key_type(value.type_name) != "") && checked_hash_method(member) != 0)
			scalar_mir_disable(locals)
		end
		if value.category >= 4
			mut expected_member := "sqrt"
			if value.category == 4
				expected_member = "argv"
			end
			if member != expected_member
				value = type_diagnostic(
					state,
					load_integer(state.token_lines, position[0]),
					"unsupported standard package member",
				)
			end
		else
			if value.category == 2
				if member == "new"
					value = check_record_new(
						state,
						position,
						locals,
						value.origin,
					)
				else
					value = type_diagnostic(
						state,
						load_integer(state.token_lines, position[0]),
						"unsupported record constructor member " + member,
					)
				end
			else
				value = check_method_call(state, position, locals, value, member)
			end
		end
	else
		if union_parts(value.type_name).size() > 0
			return check_union_member(state, locals, value, member, position[0] - 1)
		end
		record_index := find_record_type(state, value.type_name)
		if record_index < 0
			value = type_diagnostic(
				state,
				load_integer(state.token_lines, position[0]),
				"field access requires a record value",
			)
		else
			field_index := find_field(state, record_index, member)
			if field_index < 0
				value = type_diagnostic(
					state,
					load_integer(state.token_lines, position[0]),
					"unknown field " + member + " on " + type_display(state, value.type_name),
				)
			else
				mut binding :=- 1
				if value.nullable_field == - 1
					binding = value.nullable_binding
				end
				value = mir_checked_record_field(state, locals, value, field_index, load_string(state.field_types, field_index), position[0] - 1)
				value = nullable_read(state, locals, value, binding, field_index, position[0] - 1)
			end
		end
	end
	return value
end

def check_postfix(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		initial: CheckedValue,
	): CheckedValue
	mut value := CheckedValue.new(type_name: initial.type_name, category: initial.category, origin: initial.origin, mutable: initial.mutable, binding: initial.binding, readonly: initial.readonly, immutable_reference: initial.immutable_reference, nullable_binding: initial.nullable_binding, nullable_field: initial.nullable_field, truth: initial.truth, falsity: initial.falsity, flow_type: initial.flow_type)
	mut scanning := true
	while scanning
		if value.type_name == "Never"
			return check_never_postfix(state, position, locals, value)
		end
		if syntax_iteration_suffix(state, position[0]) >= 0
			break
		end
		if token_is(state, position[0], "&.")
			value = check_safe_member(state, position, locals, value)
			if has_diagnostic(state)
				return value
			end
			next
		end
		if token_is(state, position[0], "[")
			if hash_key_type(value.type_name) != "" || value.type_name == "Hash"
				value = checked_hash_index(state, position, locals, value)
				if has_diagnostic(state)
					return value
				end
				next
			end
		end
		if token_is(state, position[0], "(")
			if callable_parts(value.type_name).size() > 0
				value = check_callable_call(state, position, locals, value)
				if has_diagnostic(state)
					return value
				end
				next
			end
			if value.category < 0
				value = checked_value(value.type_name, 0, value.origin, value.mutable)
			end
			if value.category == 3
				value = checked_value(value.type_name, 0, value.origin, value.mutable)
			end
			if value.category == 0
				value = type_diagnostic(
					state,
					load_integer(state.token_lines, position[0]),
					"value is not directly callable",
				)
				scanning = false
			else
				value = check_call(
					state,
					position,
					locals,
					value.category,
					checked_reference_name(state, value.origin),
					- 1, - 1, false,
				)
			end
		else
			if token_is(state, position[0], ".")
				if sparse_integer_at(state.transform_origins, position[0]) > 0
					value = check_transform(state, position, locals, value)
					if has_diagnostic(state)
						return value
					end
					next
				end
				advance(position)
				member := expect_identifier(state, position)
				if member == "each" && syntax_iteration_suffix(state, position[0] - 2) >= 0
					position[0] -= 2
					break
				end
				value = check_member(state, position, locals, value, member)
			else
				if token_is(state, position[0], "[")
					index_origin := position[0]
					line := load_integer(state.token_lines, position[0])
					receiver_id := checked_mir_value(value)
					advance(position)
					index := check_expression(state, position, locals, 1, "Integer")
					if index.type_name == "Never"
						expect(state, position, "]")
						value = index
						next
					end
					index_id := checked_mir_value(index)
					mut lowered := false
					if locals.mir_state[0] == 1 && array_element_type(value.type_name) != ""
						mut assignment := token_is(state, position[0] + 1, "=")
						if binary_operator_id(load_string(state.token_texts, position[0] + 1)) >= 17
							assignment = true
						end
						value = mir_checked_array_index(state, locals, value, index, array_element_type(value.type_name), index_origin, assignment)
						lowered = true
					end
					if !lowered && value.type_name == "String"
						value = mir_checked_string_operation(state, locals, 16, receiver_id, index_id, 0, "String", index_origin)
						lowered = true
					end
					if !lowered
						scalar_mir_disable(locals)
					end
					expect(state, position, "]")
					if !lowered
						if value.type_name == "String"
							value = checked_value("String", 0, 9007199254740991, 0)
						else
							element_type := array_element_type(value.type_name)
							if element_type == ""
								value = type_diagnostic(
									state,
									line,
									"indexing is unavailable on " + value.type_name,
								)
								scanning = false
							else
								value = checked_bound_value(element_type, 0, index_origin, value.mutable, value.binding)
							end
						end
					end
				else
					scanning = false
				end
			end
		end
	end
	return value
end

def check_expression_value(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		minimum_precedence: Integer,
		expected: String,
	): CheckedValue
	expression_origin := position[0]
	line := load_integer(state.token_lines, position[0])
	mut value := check_postfix(
		state,
		position,
		locals,
		check_primary(state, position, locals, expected),
	)
	mut scanning := true
	while scanning
		operator_origin := position[0]
		operator := load_string(state.token_texts, position[0])
		precedence := syntax_expression_precedence(operator)
		if precedence < minimum_precedence
			scanning = false
		else
			saved_mir := locals.mir_state[0]
			if value.type_name == "Never"
				scalar_mir_disable(locals)
			end
			flow_parent := locals.nullable_state[0]
			flow_first := locals.nullable_facts.size()
			mut short :=- 1
			if precedence <= 2 && value.type_name != "Never"
				mut short_value := 0
				if operator == "||"
					short_value = 1
				end
				short = mir_logical_begin(state, locals, value, short_value, operator_origin)
				if short_value == 0
					nullable_apply(locals, value.truth)
				else
					nullable_apply(locals, value.falsity)
				end
			end
			advance(position)
			skip_newlines(state, position)
			end_origin := position[0]
			mut right_precedence := precedence + 1
			if precedence == 8
				right_precedence = precedence
			end
			mut right := check_expression(state, position, locals, right_precedence, "")
			if precedence <= 2
				nullable_finish(locals, flow_parent, flow_first, locals.count[0])
			end
			if value.type_name == "Never" || (right.type_name == "Never" && precedence > 2)
				locals.mir_state[0] = saved_mir
				value = checked_value("Never", 0, 9007199254740991, 0)
				next
			end
			if precedence == 3
				value = mir_literal_scalar(state, locals, value, operator_origin)
				right = mir_literal_scalar(state, locals, right, operator_origin)
				if value.type_name != "Integer" || right.type_name != "Integer"
					return type_diagnostic(state, line, "Range endpoints must be Integer")
				end
				mut exclusive := 0
				if operator == "..."
					exclusive = 1
				end
				state.checked[0].ranges.push(MirRangeConstruction.new(origin: expression_origin, operator_origin: operator_origin, end_origin: end_origin, finish: position[0], exclusive: exclusive, start_type: value.type_name, end_type: right.type_name))
				store_integer(state.checked[0].range_origins, operator_origin, state.checked[0].ranges.size())
				checked_range_require(state, expression_origin, operator_origin, end_origin, position[0])
				value = mir_checked_range_new(state, locals, value, right, exclusive, expression_origin)
				next
			end
			if value.type_name == "Nil" || right.type_name == "Nil"
				mut subject := value
				if value.type_name == "Nil"
					subject = right
				end
				if (operator != "==" && operator != "!=") || (nullable_element(subject.type_name) == "" && subject.type_name != "Nil")
					return type_diagnostic(state, line, "nil comparison requires a nullable operand and == or !=")
				end
				value = nullable_nil_condition(state, locals, subject, operator == "!=", operator_origin)
				next
			end
			mut binary_right := checked_view(right, right.type_name, right.category)
			if find_newtype_type(state, value.type_name) >= 0 || find_newtype_type(state, right.type_name) >= 0
				if value.type_name != right.type_name || (operator != "==" && operator != "!=") || newtype_equality_type(state, value.type_name) == ""
					return type_diagnostic(state, line, "newtype operands require the same nominal type with portable equality")
				end
				mut owner := find_newtype_type(state, value.type_name)
				while owner >= 0
					representation := state.newtypes[owner].representation
					value = mir_newtype_operation(state, locals, 56, value, owner, representation, operator_origin)
					binary_right = mir_newtype_operation(state, locals, 56, binary_right, owner, representation, operator_origin)
					owner = find_newtype_type(state, representation)
				end
			end
			value = mir_literal_scalar(state, locals, value, operator_origin)
			binary_right = mir_literal_scalar(state, locals, binary_right, operator_origin)
			result_type := binary_result_type(state, operator, value.type_name, binary_right.type_name, line, operator_origin)
			if precedence <= 2
				value = mir_logical_join(state, locals, value, binary_right, short, operator_origin)
			elsif find_enum_type(state, value.type_name) >= 0
				value = mir_enum_operation(state, locals, 40, value, checked_mir_value(binary_right), binary_operator_id(operator), "Boolean", operator_origin)
			elsif value.type_name == "String"
				value = mir_checked_string_binary(state, locals, value, binary_right, operator, operator_origin)
			else
				value = scalar_mir_binary(
					state,
					locals,
					operator,
					value,
					binary_right,
					result_type,
					operator_origin,
				)
			end
		end
	end
	if minimum_precedence == 1 && token_is(state, position[0], "?")
		value = check_control_value(state, position, locals, true, expected, value)
	end
	return value
end

def check_expression(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		minimum_precedence: Integer,
		expected: String,
	): CheckedValue
	# Context guides Array literals without coercing a grouped operand early.
	expression_origin := position[0]
	line := load_integer(state.token_lines, expression_origin)
	mut value := check_expression_value(state, position, locals, minimum_precedence, expected)
	value = mir_literal_context(state, locals, value, expected, expression_origin, position[0])
	check_expected(state, value.type_name, expected, line)
	value = mir_nullable_coerce(state, locals, value, expected, expression_origin)
	mut displayed_mutable := 0
	# Mutation capability also belongs to projections; display marks only a
	# direct lexical binding, whose identity survives grouping and narrowing.
	if value.nullable_binding >= 0 && value.nullable_field == - 1 && value.mutable > 0
		displayed_mutable = 1
	end
	checked_submission_result(state, expression_origin, value.type_name, displayed_mutable)
	return value
end

def checked_readonly_reference_binding(
		state: CompilerState,
		locals: CheckedLocals,
		value: CheckedValue,
	): Boolean
	if value.immutable_reference
		return true
	end
	if value.mutable != 0
		return false
	end
	# Only a direct checked binding read retains its binding-token origin.
	# Grouping preserves it; field/index reads and call results clear it.
	# Reference readonly is shallow, not inherited from every container.
	if value.origin >= state.token_count[0]
		return false
	end
	mut reference_type := value.type_name
	if nullable_element(reference_type) != ""
		reference_type = nullable_element(reference_type)
	end
	if array_element_type(reference_type) == "" && hash_key_type(reference_type) == "" && reference_type != "Hash"
		if find_record_type(state, reference_type) < 0 && find_object_type(state, reference_type) < 0 && !(state.generic_template_mode[0] && string_starts_with(reference_type, "TypeParameter#"))
			return false
		end
	end
	if local_find(locals, load_string(state.token_texts, value.origin)) >= 0
		return true
	end
	return sparse_integer_at(state.checked[0].global_references, value.origin) > 0
end

def check_declaration(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
	): CheckedValue
	origin := position[0]
	mut mutable := 0
	if token_is(state, position[0], "mut")
		mutable = 1
		advance(position)
	end
	line := load_integer(state.token_lines, position[0])
	name := expect_identifier(state, position)
	if name == "_"
		diagnostic(state, "TRBN4004", line, "blank binding _ is only valid as a parameter or pattern binding")
	end
	if enum_uppercase(name)
		diagnostic(state, "TRBN4004", line, "constants may be declared only at top level or in a module")
	end
	mut declared_type := ""
	if token_is(state, position[0], ":")
		advance(position)
		declared_type = parse_type(state, position)
		resolved_type := resolve_type_name(state, state.module_graph.active_module[0], declared_type, false)
		if resolved_type == ""
			diagnostic(state, "TRBN4004", line, "unknown local type " + declared_type)
		else
			declared_type = resolved_type
		end
	end
	expect(state, position, ":=")
	value := check_statement_value(state, position, locals, declared_type)
	value_type := value.type_name
	if mutable == 1
		if checked_readonly_reference_binding(state, locals, value)
			diagnostic(state, "TRBN4004", line, "cannot initialize mutable " + name + " from an immutable value")
		end
	end
	mut local_type := declared_type
	if local_type == ""
		local_type = value_type
	end
	if local_type == "Nil"
		diagnostic(state, "TRBN4004", line, "cannot infer a binding from nil alone; add a nullable annotation")
	end
	if local_type == "Void"
		diagnostic(state, "TRBN4004", line, "local binding cannot have type Void")
	end
	added := local_add(state, locals, name, local_type, mutable, line)
	if added && !result_interactive_entry(state, locals)
		mut use_kind := 1
		if standard_result_instance(state, local_type) >= 0
			use_kind = 5
		end
		local_require_use(locals, locals.count[0] - 1, name, origin, use_kind)
	end
	if added
		nullable_replace(locals, locals.count[0] - 1, local_type)
	end
	if added && local_type == "Hash"
		if checked_hash_plan(state, value.origin).kind != 1
			diagnostic(state, "TRBN4004", line, "untyped Hash aliases require a Hash<K, V> annotation")
			return checked_value("Invalid", 0, 9007199254740991, 0)
		end
		store_integer(locals.hash_literal_origins, locals.count[0] - 1, value.origin + 1)
		store_integer(locals.hash_declaration_origins, locals.count[0] - 1, origin + 1)
	end
	if added && local_type == "Array"
		if !token_is(state, value.origin, "[") || !token_is(state, value.origin + 1, "]")
			diagnostic(state, "TRBN4004", line, "untyped Array aliases require an Array<T> annotation")
			return checked_value("Invalid", 0, 9007199254740991, 0)
		end
		store_integer(locals.array_literal_origins, locals.count[0] - 1, value.origin + 1)
		store_integer(locals.array_declaration_origins, locals.count[0] - 1, origin + 1)
	end
	if added && value.type_name != "Never"
		mir_binding_initialize(state, locals, locals.count[0] - 1, value, origin)
	end
	store_string(state.checked[0].local_types, origin, local_type)
	checked_submission_result(state, origin, local_type, mutable)
	finish_statement(state, position)
	if value.type_name == "Never"
		return value
	end
	return checked_value("Void", 0, 9007199254740991, 0)
end

def check_simple_statement(
		mut state: CompilerState,
		mut position: Array<Integer>,
		mut locals: CheckedLocals,
		contextual: String,
	): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, position[0])
	left := check_statement_value(state, position, locals, contextual)
	mut display_mutable := 0
	if left.nullable_binding >= 0 && left.nullable_field == - 1
		display_mutable = left.mutable
	end
	operator_origin := position[0]
	operator := load_string(state.token_texts, position[0])
	mut assignment := operator == "="
	if binary_operator_id(operator) >= 17
		assignment = true
	end
	if assignment
		if left.readonly
			diagnostic(state, "TRBN4004", line, "field is readonly")
		elsif left.mutable != 0 && !left.binding
			diagnostic(state, "TRBN4004", line, "assignment requires a mutable binding")
		end
	end
	if operator == "="
		if left.mutable == 0
			diagnostic(state, "TRBN4004", line, "assignment target is immutable")
		end
		advance(position)
		mut expected := left.type_name
		if left.nullable_binding >= 0 && left.nullable_field == - 1
			expected = load_string(locals.types, left.nullable_binding)
		elsif left.nullable_binding < - 1 && left.nullable_field == - 1
			expected = state.global_types[- left.nullable_binding - 2]
		end
		mut right_expected := expected
		hash_inference_region := checked_hash_inference_region(state, locals, left.origin)
		if expected == "Array" || hash_inference_region
			right_expected = ""
		end
		# A first empty Array value has no element witness. The reference
		# gives its Hash value an Array<Any> element boundary, which later
		# stores and mutations must box through verified MIR.
		pending_hash := checked_hash_plan(state, left.origin)
		if pending_hash.kind == 3 && expected == "" && token_is(state, position[0], "[") && token_is(state, position[0] + 1, "]")
			right_expected = "Array<Any>"
		end
		right := check_statement_value(state, position, locals, right_expected)
		if right.type_name == "Never"
			finish_statement(state, position)
			return right
		end
		if expected == "Array"
			element_type := array_element_type(right.type_name)
			if element_type == ""
				diagnostic(state, "TRBN4004", line, "untyped Array assignment requires a typed Array value")
			else
				error := checked_array_refine(state, locals, left, element_type)
				if error != ""
					diagnostic(state, "TRBN4004", line, error)
				end
			end
		end
		if left.nullable_binding >= 0 && left.nullable_field == - 1
			nullable_replace(locals, left.nullable_binding, right.flow_type)
		elsif left.nullable_binding < - 1 && left.nullable_field == - 1
			nullable_replace_type(locals, left.nullable_binding, expected, right.flow_type)
		end
		mut display_type := expected
		if right.flow_type == "Nil"
			display_type = "Nil"
		end
		checked_submission_result(state, origin, display_type, display_mutable)
		checked_hash_refine(state, locals, left.origin, right.type_name)
		hash := checked_hash_plan(state, left.origin)
		mut hash_value := checked_view(right, right.type_name, right.category)
		if hash.kind == 3 && hash_inference_region
			value_type := hash_value_type(hash.type_name)
			if value_type != "" && object_value_assignable(state, right.type_name, value_type)
				hash_value = mir_nullable_coerce(state, locals, right, value_type, left.origin)
			end
		end
		mut hash_conversion :=- 1
		if hash.kind == 3 && right.type_name == "Integer" && checked_hash_numeric_region(state, locals, left.origin)
			converted := scalar_mir_convert_float(state, locals, right, left.origin)
			hash_conversion = checked_mir_value(converted)
		end
		if mir_checked_union_store(state, locals, left, right)
			# The receiver was selected before the right-hand side.
		elsif mir_checked_object_store(state, locals, left, right)
			# The receiver was evaluated before the right-hand side.
		elsif hash.kind == 3
			mir_checked_hash_store(state, locals, left, hash_value, hash.type_name, hash_conversion)
		elsif !mir_checked_array_store(state, locals, left, right)
			mir_binding_assign(state, locals, left, right)
		end
	else
		if operator == "||=" || operator == "&&="
			if left.type_name != "Boolean"
				diagnostic(state, "TRBN4004", line, "logical assignment requires a Boolean target")
			end
			if left.mutable == 0
				diagnostic(state, "TRBN4004", line, "assignment target is immutable")
			end
			mut binary := "||"
			mut short_value := 1
			if operator == "&&="
				binary = "&&"
				short_value = 0
			end
			short := mir_logical_begin(state, locals, left, short_value, operator_origin)
			advance(position)
			right := check_statement_value(state, position, locals, "Boolean")
			result_type := binary_result_type(state, binary, left.type_name, right.type_name, line, operator_origin)
			checked_submission_result(state, origin, result_type, display_mutable)
			if right.type_name != "Never" && result_type == "Boolean" && locals.mir_state[0] == 1
				if !mir_checked_union_store(state, locals, left, right) && !mir_checked_object_store(state, locals, left, right) && !mir_checked_array_store(state, locals, left, right)
					mir_binding_assign(state, locals, left, right)
				end
			end
			mir_logical_join(state, locals, left, right, short, operator_origin)
		elsif binary_operator_id(operator) >= 17
			compound := operator[0]
			mut declared := left.type_name
			if left.nullable_field == - 1
				if left.nullable_binding >= 0
					declared = load_string(locals.types, left.nullable_binding)
				elsif left.nullable_binding < - 1
					declared = state.global_types[- left.nullable_binding - 2]
				end
			end
			if nullable_element(declared) != ""
				diagnostic(state, "TRBN4004", line, "compound assignment requires a non-nullable binding")
			end
			if left.mutable == 0
				diagnostic(state, "TRBN4004", line, "assignment target is immutable")
			end
			advance(position)
			right := check_statement_value(state, position, locals, left.type_name)
			if right.type_name == "Never"
				finish_statement(state, position)
				return right
			end
			result_type := binary_result_type(state, compound, left.type_name, right.type_name, line, operator_origin)
			checked_submission_result(state, origin, result_type, display_mutable)
			if locals.mir_state[0] == 1
				mut value := checked_value(result_type, 0, 9007199254740991, 0)
				if result_type == "String"
					value = mir_checked_string_binary(state, locals, left, right, compound, operator_origin)
				else
					value = scalar_mir_binary(state, locals, compound, left, right, result_type, operator_origin)
				end
				if !mir_checked_union_store(state, locals, left, value) && !mir_checked_object_store(state, locals, left, value) && !mir_checked_array_store(state, locals, left, value)
					mir_binding_assign(state, locals, left, value)
				end
			end
		end
	end
	finish_statement(state, position)
	if assignment
		return checked_value("Void", 0, 9007199254740991, 0)
	end
	return left
end

def checked_iteration(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String, parent_loop: Integer): CheckedValue
	flow_parent := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	origin := position[0]
	encoded := sparse_integer_at(state.iteration_origins, origin)
	if encoded < 1 || encoded > state.iterations.size()
		return checked_value("Invalid", 0, origin, 0)
	end
	shape := state.iterations[encoded - 1]
	if !checked_iteration_shape(state, shape, origin)
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid iteration syntax plan")
		return checked_value("Invalid", 0, origin, 0)
	end
	mut receiver := check_expression(state, position, locals, 1, "")
	saved_mir := locals.mir_state[0]
	mut optional := false
	if token_is(state, shape.receiver_finish, "&.") && nullable_element(receiver.type_name) != ""
		optional = true
	end
	mut absent :=- 1
	if optional
		condition := nullable_nil_condition(state, locals, receiver, true, shape.receiver_finish)
		absent = mir_control_branch(state, locals, condition, load_integer(state.token_lines, origin))
		nullable_apply(locals, condition.truth)
		present_type := nullable_element(receiver.type_name)
		payload := mir_checked_nullable(state, locals, 36, receiver, present_type, 0, shape.receiver_finish)
		receiver = checked_view(receiver, present_type, payload.category)
	end
	element_type := iteration_element_type(receiver.type_name)
	if element_type == "" || position[0] != shape.receiver_finish
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "ordinary each requires a supported Array, Range or Hash receiver")
		return checked_value("Invalid", 0, origin, 0)
	end
	mut source_kind := 1
	if receiver.type_name == "Range<Integer>"
		source_kind = 2
	end
	if hash_key_type(receiver.type_name) != ""
		source_kind = 3
	end
	plan := MirIteration.new(syntax: shape, parent_loop: parent_loop, source_kind: source_kind, type_name: receiver.type_name, element_type: element_type)
	if !checked_iteration_parameters(state, plan)
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "each block parameters differ from its receiver and with_index mode")
		return checked_value("Invalid", 0, origin, 0)
	end
	mut size := checked_value("Integer", 0, origin, 0)
	mut block_type := element_type
	if shape.slice_start >= 0
		position[0] = shape.slice_start
		size = check_expression(state, position, locals, 1, "Integer")
		if !check_expected(state, size.type_name, "Integer", load_integer(state.token_lines, shape.slice_start))
			return checked_value("Invalid", 0, origin, 0)
		end
		if position[0] != shape.slice_finish
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid each_slice size boundary")
			return checked_value("Invalid", 0, origin, 0)
		end
		if checked_slice_zero_literal(state, size.origin)
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, shape.slice_start), "each_slice size must be greater than zero")
			return checked_value("Invalid", 0, origin, 0)
		end
		block_type = array_type(element_type)
	end
	state.checked[0].iterations.push(plan)
	store_integer(state.checked[0].iteration_origins, origin, state.checked[0].iterations.size())
	checked_iteration_require(state, origin, parent_loop)
	# A size expression may leave its enclosing function or loop. Still check
	# the unreachable block, without constructing an iteration or Never operand.
	if size.type_name == "Never"
		scalar_mir_disable(locals)
	end
	saved := locals.count[0]
	mut element := checked_value(block_type, 0, plan.syntax.element_origin, 1)
	if shape.slice_start >= 0
		local_bind_temporary(locals, "$slice.receiver", receiver.type_name, 1)
		local_bind_temporary(locals, "$slice.cursor", "Integer", 1)
		local_bind_temporary(locals, "$slice.ordinal", "Integer", 1)
		local_bind_temporary(locals, "$slice.size", "Integer", 1)
		local_bind_temporary(locals, "$slice.finished", "Boolean", 1)
		element = mir_sliced_iteration_begin(state, locals, plan, receiver, size, saved)
	else
		# Hidden receiver/cursor bindings provide the loop-carried MIR values.
		local_bind(locals, "$iteration.receiver", receiver.type_name, 1)
		local_bind(locals, "$iteration.cursor", "Integer", 1)
		if source_kind == 2 && plan.syntax.second_origin >= 0
			local_bind(locals, "$iteration.ordinal", "Integer", 1)
		end
		if source_kind == 3
			local_bind(locals, "$iteration.keys", array_type(element_type), 1)
			local_bind(locals, "$iteration.values", array_type(hash_value_type(receiver.type_name)), 1)
		end
		element = mir_checked_iteration_begin(state, locals, plan, receiver, saved)
	end
	element_name := load_string(state.token_texts, plan.syntax.element_origin)
	local_bind(locals, element_name, block_type, 1)
	local_require_use(locals, locals.count[0] - 1, element_name, plan.syntax.element_origin, 2)
	mir_binding_initialize(state, locals, locals.count[0] - 1, element, plan.syntax.element_origin)
	if plan.syntax.second_origin >= 0
		if load_string(state.token_texts, plan.syntax.element_origin) == load_string(state.token_texts, plan.syntax.second_origin)
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, plan.syntax.second_origin), "iteration block parameter is duplicated")
			return checked_value("Invalid", 0, origin, 0)
		end
		mut second_type := "Integer"
		if source_kind == 3
			second_type = hash_value_type(receiver.type_name)
		end
		second_name := load_string(state.token_texts, plan.syntax.second_origin)
		local_bind(locals, second_name, second_type, 1)
		local_require_use(locals, locals.count[0] - 1, second_name, plan.syntax.second_origin, 2)
		mut index_slot := saved + 1
		if source_kind == 2 || shape.slice_start >= 0
			index_slot = saved + 2
		end
		mut second := mir_binding_read(state, locals, index_slot, plan.syntax.second_origin)
		if source_kind == 3
			values := mir_binding_read(state, locals, saved + 3, plan.syntax.second_origin)
			second = mir_checked_array_operation(state, locals, 22, checked_mir_value(values), checked_mir_value(second), 0, second_type, plan.syntax.second_origin)
		end
		mir_binding_initialize(state, locals, locals.count[0] - 1, second, plan.syntax.second_origin)
	end
	position[0] = plan.syntax.body_start
	nullable_loop_writes(state, locals, plan.syntax.body_start, plan.syntax.body_finish)
	check_block(state, position, locals, result_type, origin)
	if position[0] != plan.syntax.body_finish
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid iteration body boundary")
	end
	binding_scope_check(state, locals, saved)
	if shape.slice_start >= 0
		mir_sliced_iteration_end(state, locals, plan, saved)
	else
		mir_checked_iteration_end(state, locals, plan, saved)
	end
	locals.count[0] = saved
	if size.type_name == "Never"
		locals.mir_state[0] = saved_mir
	end
	if absent >= 0
		mir_control_jump(state, locals, absent, saved)
		mir_control_enter(state, locals, absent, load_integer(state.token_lines, origin))
	end
	nullable_finish(locals, flow_parent, flow_first, saved)
	position[0] = plan.syntax.finish
	finish_statement(state, position)
	if size.type_name == "Never" && !optional
		return checked_value("Never", 0, origin, 0)
	end
	return checked_value("Void", 0, origin, 0)
end

def checked_while(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String): Boolean
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	count := locals.count[0]
	flow_parent := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	nullable_loop_writes(state, locals, origin, sparse_integer_at(state.loop_finishes, origin))
	exit := mir_control_loop_begin(state, locals, origin, line)
	advance(position)
	condition := check_expression(state, position, locals, 1, "Boolean")
	check_expected(state, condition.type_name, "Boolean", line)
	finish_statement(state, position)
	mir_control_loop_branch(state, locals, condition, exit, line)
	nullable_apply(locals, condition.truth)
	check_block(state, position, locals, result_type, origin)
	binding_scope_check(state, locals, count)
	locals.count[0] = count
	mir_control_loop_end(state, locals, load_integer(state.token_lines, position[0]))
	nullable_finish(locals, flow_parent, flow_first, count)
	expect(state, position, "end")
	return finish_statement(state, position)
end

def check_block(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String, loop_origin: Integer): Boolean
	check_block_value(state, position, locals, result_type, loop_origin, false, "")
	return !has_diagnostic(state)
end

# An empty collection expression discarded by its enclosing block has no
# elements to evaluate and no observable allocation. A value-producing final
# statement and an interactive submission still need a concrete element type.
def checked_discarded_empty_collection(state: CompilerState, position: Array<Integer>, wants_value: Boolean, locals: CheckedLocals): Boolean
	origin := position[0]
	if result_interactive_entry(state, locals) && !wants_value
		return false
	end
	if !(token_is(state, origin, "[") && token_is(state, origin + 1, "]")) && !(token_is(state, origin, "{") && token_is(state, origin + 1, "}"))
		return false
	end
	mut after := [origin + 2]
	if load_integer(state.token_kinds, after[0]) != 4 && !terminal_token(state, after[0]) && !token_is(state, after[0], "}")
		return false
	end
	if wants_value
		skip_newlines(state, after)
		if syntax_block_end(state, after[0]) || syntax_conditional_tail(state, after[0])
			return false
		end
	end
	return true
end

def check_block_value(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String, loop_origin: Integer, wants_value: Boolean, expected: String): CheckedValue
	saved_loop := locals.lexical_loop[0]
	locals.lexical_loop[0] = loop_origin
	saved_mir := locals.mir_state[0]
	mut diverged := false
	mut result := checked_value("Void", 0, 9007199254740991, 0)
	skip_newlines(state, position)
	while !syntax_block_end(state, position[0]) && !syntax_conditional_tail(state, position[0])
		if terminal_token(state, position[0])
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, position[0]), "unexpected end of input")
			break
		end
		statement_origin := position[0]
		# Only the final value inherits context; earlier statements and explicit
		# returns keep their own expression/function boundaries.
		mut contextual := ""
		if wants_value && expected != ""
			mut after := [sparse_integer_at(state.statement_finishes, statement_origin)]
			if after[0] > 0
				skip_newlines(state, after)
				if syntax_block_end(state, after[0]) || syntax_conditional_tail(state, after[0])
					contextual = expected
				end
			end
		end
		checked_submission_boundary(state, locals, position[0])
		if diverged
			# Continue checking unreachable syntax and types without creating
			# instructions after a terminator or manufacturing a Never operand.
			scalar_mir_disable(locals)
		end
		result = checked_value("Void", 0, 9007199254740991, 0)
		if syntax_loop_transfer_kind(state, position[0]) > 0 || token_is(state, position[0], "return")
			guard := sparse_integer_at(state.control_origins, position[0])
			if guard > 0 && state.controls[guard - 1].kind == 4
				control := state.controls[guard - 1]
				mir_control_prepare(state, locals)
				position[0] = control.selector
				condition := check_expression(state, position, locals, 1, "Boolean")
				line := load_integer(state.token_lines, control.origin)
				guard_mir := locals.mir_state[0]
				if condition.type_name == "Never"
					scalar_mir_disable(locals)
				end
				guard_flow := locals.nullable_state[0]
				nullable_apply(locals, condition.truth)
				alternate := mir_control_branch(state, locals, condition, line)
				position[0] = control.origin
				check_transfer_value(state, position, locals, result_type, loop_origin, control.branches[0].finish)
				mir_control_enter(state, locals, alternate, line)
				locals.nullable_state[0] = guard_flow
				nullable_apply(locals, condition.falsity)
				if condition.type_name == "Never"
					locals.mir_state[0] = guard_mir
					result = condition
				end
				position[0] = control.finish
				finish_statement(state, position)
			else
				result = check_transfer_value(state, position, locals, result_type, loop_origin, - 1)
			end
		elsif token_is(state, position[0], "if") || token_is(state, position[0], "case")
			control := state.controls[sparse_integer_at(state.control_origins, position[0]) - 1]
			mut after := [control.finish]
			skip_newlines(state, after)
			mut last := syntax_block_end(state, after[0])
			if !last
				last = syntax_conditional_tail(state, after[0])
			end
			if !wants_value
				last = false
			end
			saved_region := locals.inference_active_region[0]
			if saved_region == 0
				locals.inference_active_region[0] = position[0] + 1
			end
			result = check_control_value(state, position, locals, last, "", checked_value("Invalid", 0, 9007199254740991, 0))
			locals.inference_active_region[0] = saved_region
			finish_statement(state, position)
		elsif token_is(state, position[0], "while")
			checked_while(state, position, locals, result_type)
		elsif sparse_integer_at(state.iteration_origins, position[0]) > 0
			result = checked_iteration(state, position, locals, result_type, loop_origin)
		elsif declaration_start(state, position[0])
			result = check_declaration(state, position, locals)
		elsif checked_discarded_empty_collection(state, position, wants_value, locals)
			position[0] += 2
			finish_statement(state, position)
		else
			result = check_simple_statement(state, position, locals, contextual)
		end
		if standard_result_instance(state, result.type_name) >= 0 && !result_interactive_entry(state, locals)
			mut after := [position[0]]
			skip_newlines(state, after)
			mut last := syntax_block_end(state, after[0])
			if !last
				last = syntax_conditional_tail(state, after[0])
			end
			if !wants_value || !last
				diagnostic(state, "TRBN4004", load_integer(state.token_lines, statement_origin), "Result value must be used; handle, return, pass or store it")
			end
		end
		if result.type_name == "Never"
			diverged = true
		end
		if has_diagnostic(state)
			break
		end
	end
	locals.lexical_loop[0] = saved_loop
	if diverged
		locals.mir_state[0] = saved_mir
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	return result
end

# The checker resolves branch values and transfer ownership; adapters only see
# ordinary typed blocks, jump arguments and return/loop terminators.
def check_control_value(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, wants_value: Boolean, expected: String, predicate: CheckedValue): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	control := state.controls[sparse_integer_at(state.control_origins, origin) - 1]
	saved_flow := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	saved_count := locals.count[0]
	saved_mir := locals.mir_state[0]
	mut reachable := true
	mir_control_prepare(state, locals)
	mut join := mir_value_join(locals, line)
	mut selector := checked_value(predicate.type_name, predicate.category, predicate.origin, predicate.mutable)
	mut enum_owner :=- 1
	mut union_selector := false
	mut literal_selector := false
	if control.kind == 2
		position[0] = control.selector
		selector = check_expression(state, position, locals, 1, "")
		enum_owner = find_enum_type(state, selector.type_name)
		if literal_case_type(selector.type_name) || selector.type_name == "Integer" || selector.type_name == "String"
			literal_selector = check_literal_case(state, control, selector.type_name)
			if has_diagnostic(state)
				return checked_value("Invalid", 0, origin, 0)
			end
			selector = mir_literal_scalar(state, locals, selector, control.selector)
		end
		union_selector = union_parts(selector.type_name).size() > 0
		if literal_selector
			union_selector = false
		end
		if union_selector && !check_union_patterns(state, control, selector.type_name)
			return checked_value("Invalid", 0, origin, 0)
		end
		if enum_owner >= 0 && !check_enum_patterns(state, control, enum_owner)
			return checked_value("Invalid", 0, origin, 0)
		end
		if enum_owner < 0 && !union_selector && !literal_selector && selector.type_name != "Never" && selector.type_name != "Integer" && selector.type_name != "String"
			return type_diagnostic(state, line, "case selector requires Integer, String, enum or union")
		end
	elsif control.kind == 3
		check_expected(state, predicate.type_name, "Boolean", line)
	end
	if selector.type_name == "Never"
		reachable = false
		scalar_mir_disable(locals)
	end
	mut immutable_reference := false
	mut common := "Never"
	mut completing := 0
	mut otherwise := false
	mut branch_index := 0
	while branch_index < control.branches.size()
		branch := control.branches[branch_index]
		mut alternate_flow := locals.nullable_state[0]
		mut false_facts :=- 1
		mut alternate :=- 1
		if branch.condition >= 0 || (control.kind == 3 && branch_index == 0)
			mut condition := checked_view(predicate, predicate.type_name, predicate.category)
			if control.kind == 2
				position[0] = branch.condition
				if union_selector
					pattern := state.checked[0].union_patterns[sparse_integer_at(state.checked[0].union_pattern_origins, branch.condition) - 1]
					condition = mir_union_operation(state, locals, 53, selector, pattern.type_name, "Boolean", branch.condition)
				elsif literal_selector && union_parts(selector.type_name).size() > 0
					mut first := true
					literal_branch_types(state, branch.condition, branch.condition_finish).each do |literal|
						mut short :=- 1
						if !first
							short = mir_logical_begin(state, locals, condition, 1, branch.condition)
						end
						test := mir_union_operation(state, locals, 53, selector, literal, "Boolean", branch.condition)
						if first
							condition = test
						else
							condition = mir_logical_join(state, locals, condition, test, short, branch.condition)
						end
						first = false
					end
				elsif enum_owner >= 0
					pattern := state.checked[0].enum_patterns[sparse_integer_at(state.checked[0].enum_pattern_origins, branch.condition) - 1]
					condition = mir_enum_operation(state, locals, 38, selector, - 1, pattern.variant, "Boolean", branch.condition)
				else
					condition = check_case_condition(state, position, locals, selector, branch.condition_finish)
				end
			elsif control.kind == 1
				position[0] = branch.condition
				condition = check_expression(state, position, locals, 1, "Boolean")
			end
			if condition.type_name == "Never"
				reachable = false
				scalar_mir_disable(locals)
			end
			alternate_flow = locals.nullable_state[0]
			false_facts = condition.falsity
			nullable_apply(locals, condition.truth)
			if (enum_owner >= 0 || union_selector || literal_selector) && branch_index == control.branches.size() - 1
				otherwise = true
			else
				alternate = mir_control_branch(state, locals, condition, line)
			end
		else
			otherwise = true
		end
		if union_selector && branch.condition >= 0
			check_union_binding(state, locals, selector, branch.condition)
		end
		if enum_owner >= 0 && branch.condition >= 0
			check_enum_bindings(state, locals, selector, branch.condition)
		end
		if control.kind == 2 && literal_selector
			narrow_union_discriminant(state, locals, control, branch_index)
		end
		position[0] = branch.body
		mut value := checked_value("Void", 0, 9007199254740991, 0)
		if control.kind == 3
			value = check_expression(state, position, locals, 1, expected)
		else
			mut result_type := "Void"
			if locals.mir_state[1] >= 0 || locals.lambda_result.size() > 0
				result_type = checked_return_type(state, locals)
			end
			value = check_block_value(state, position, locals, result_type, locals.lexical_loop[0], wants_value, "")
		end
		if reachable && value.type_name != "Never" && checked_readonly_reference_binding(state, locals, value)
			immutable_reference = true
		end
		binding_scope_check(state, locals, saved_count)
		locals.count[0] = saved_count
		if value.type_name != "Never" && reachable
			completing += 1
			if wants_value
				if value.type_name == "Void"
					return type_diagnostic(state, line, "control expression branch must end with a value or transfer")
				end
				if common == "Never"
					common = value.type_name
				elsif common != value.type_name
					common = nullable_common(common, value.type_name)
					if common == ""
						return type_diagnostic(state, line, "control expression branches have incompatible types")
					end
				end
				mir_value_exit(state, locals, join, value)
			else
				mir_control_jump(state, locals, join.target, saved_count)
			end
		end
		if alternate >= 0
			mir_control_enter(state, locals, alternate, line)
		end
		locals.nullable_state[0] = alternate_flow
		nullable_apply(locals, false_facts)
		branch_index += 1
		if has_diagnostic(state)
			return checked_value("Invalid", 0, 9007199254740991, 0)
		end
	end
	mut promoted_flow := saved_flow
	if !otherwise && completing == 0
		promoted_flow = locals.nullable_state[0]
	end
	nullable_finish(locals, promoted_flow, flow_first, saved_count)
	if !otherwise
		if wants_value
			return type_diagnostic(state, line, "control expression requires an else branch")
		end
		if reachable
			completing += 1
			mir_control_jump(state, locals, join.target, saved_count)
		end
	end
	position[0] = control.finish
	if !reachable
		locals.mir_state[0] = saved_mir
	end
	if wants_value
		store_string(state.checked[0].control_types, origin, common)
		value := mir_value_complete(state, locals, join, common, origin)
		return CheckedValue.new(type_name: value.type_name, category: value.category, origin: value.origin, mutable: value.mutable, binding: false, readonly: false, immutable_reference: immutable_reference, nullable_binding: value.nullable_binding, nullable_field: value.nullable_field, truth: value.truth, falsity: value.falsity, flow_type: value.flow_type)
	end
	store_string(state.checked[0].control_types, origin, "Void")
	if completing == 0
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	mir_control_enter(state, locals, join.target, line)
	return checked_value("Void", 0, 9007199254740991, 0)
end

def check_case_condition(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, selector: CheckedValue, finish: Integer): CheckedValue
	mut result := checked_value("Invalid", 0, 9007199254740991, 0)
	mut first := true
	while position[0] < finish
		origin := position[0]
		mut short :=- 1
		if !first
			short = mir_logical_begin(state, locals, result, 1, origin)
		end
		mut literal := origin
		if token_is(state, literal, "-")
			literal += 1
		end
		kind := load_integer(state.token_kinds, literal)
		if kind != 2 && kind != 3
			return type_diagnostic(state, load_integer(state.token_lines, origin), "case patterns currently require scalar literals")
		end
		mut expected := selector.type_name
		if expected == "Never"
			expected = ""
		end
		value := check_expression(state, position, locals, 1, expected)
		if position[0] != literal + 1
			return type_diagnostic(state, load_integer(state.token_lines, origin), "case patterns currently require scalar literals")
		end
		if selector.type_name == "Never"
			if token_is(state, position[0], ",")
				advance(position)
			end
			next
		end
		binary_result_type(state, "==", selector.type_name, value.type_name, load_integer(state.token_lines, origin), origin)
		mut comparison := checked_value("Boolean", 0, 9007199254740991, 0)
		if selector.type_name == "String"
			comparison = mir_checked_string_binary(state, locals, selector, value, "==", origin)
		else
			comparison = scalar_mir_binary(state, locals, "==", selector, value, "Boolean", origin)
		end
		if first
			result = comparison
		else
			result = mir_logical_join(state, locals, result, comparison, short, origin)
		end
		first = false
		if token_is(state, position[0], ",")
			advance(position)
		else
			break
		end
	end
	if selector.type_name == "Never"
		return selector
	end
	return result
end

# Validate exact source and nearest-loop bindings before an adapter consumes
# the plan. Zero-filled target storage represents absence, never token zero.
def checked_loop_transfer_kind(mut state: CompilerState, origin: Integer, loop_origin: Integer): Integer
	encoded_target := load_integer(state.checked[0].loop_transfer_targets, origin)
	mut target :=- 1
	if encoded_target > 0
		target = encoded_target - 1
	end
	plan := MirLoopTransfer.new(
		kind: load_integer(state.checked[0].loop_transfer_kinds, origin),
		origin: origin,
		target: target,
	)
	if mir_loop_transfer_valid(plan, origin, syntax_loop_transfer_kind(state, origin), loop_origin, state.token_count[0])
		if token_is(state, loop_origin, "while")
			return plan.kind
		end
		encoded_iteration := sparse_integer_at(state.checked[0].iteration_origins, loop_origin)
		if encoded_iteration > 0 && encoded_iteration <= state.checked[0].iterations.size()
			iteration := state.checked[0].iterations[encoded_iteration - 1]
			if checked_iteration_shape(state, iteration.syntax, loop_origin) && checked_iteration_parameters(state, iteration) && mir_iteration_valid(iteration, loop_origin, state.token_count[0], iteration.type_name, iteration_element_type(iteration.type_name))
				if origin >= iteration.syntax.body_start && origin < iteration.syntax.body_finish
					return plan.kind
				end
			end
		end
	end
	diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked loop transfer target")
	return 0
end

def check_transfer_value(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, result_type: String, loop_origin: Integer, finish: Integer): CheckedValue
	origin := position[0]
	if token_is(state, origin, "return") && locals.value_block[0]
		return type_diagnostic(state, load_integer(state.token_lines, origin), "return is unavailable inside a value-producing collection block")
	end
	if token_is(state, origin, "return") && locals.lambda_result.size() == 0 && sparse_integer_at(state.function_expression_bodies, locals.mir_state[1]) > 0
		return type_diagnostic(state, load_integer(state.token_lines, origin), "return is unavailable inside a default initializer")
	end
	line := load_integer(state.token_lines, origin)
	kind := syntax_loop_transfer_kind(state, origin)
	advance(position)
	if kind > 0
		if loop_origin < 0
			diagnostic(state, "TRBN4004", line, load_string(state.token_texts, origin) + " is only valid inside a loop")
		else
			store_integer(state.checked[0].loop_transfer_kinds, origin, kind)
			store_integer(state.checked[0].loop_transfer_targets, origin, loop_origin + 1)
			mir_control_transfer(state, locals, loop_origin, kind)
		end
	elsif position[0] == finish || syntax_statement_boundary(state, position[0])
		if result_type != "Void"
			diagnostic(state, "TRBN4004", line, "return value is required")
		elsif mir_control_active(locals)
			mir_control_return(state, locals, - 1)
			locals.mir_state[4] =- 2
		end
	else
		value := check_statement_value(state, position, locals, result_type)
		if result_type == "Void" && value.type_name != "Never"
			diagnostic(state, "TRBN4004", line, "Void function cannot return a value")
		elsif value.type_name != "Never" && locals.mir_state[0] > 0
			operand := checked_mir_value(value)
			if operand >= 0
				locals.mir_state[4] = operand
				mir_control_return(state, locals, operand)
			else
				scalar_mir_disable(locals)
			end
		end
	end
	if finish < 0
		finish_statement(state, position)
	elsif position[0] != finish
		diagnostic(state, "TRBN4004", line, "invalid conditional transfer body")
	end
	return checked_value("Never", 0, 9007199254740991, 0)
end

def check_safe_present_member(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue): CheckedValue
	if sparse_integer_at(state.transform_origins, position[0]) > 0
		return check_transform(state, position, locals, receiver)
	end
	advance(position)
	member := expect_identifier(state, position)
	mut value := check_member(state, position, locals, receiver, member)
	if callable_parts(value.type_name).size() > 0 && token_is(state, position[0], "(")
		value = check_callable_call(state, position, locals, value)
	end
	return value
end

# The receiver dominates both edges. Only the present edge evaluates authored
# arguments and blocks; the absent edge contributes none, or no Void result.
def check_safe_member(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	element := nullable_element(receiver.type_name)
	if element == ""
		value := check_safe_present_member(state, position, locals, receiver)
		store_integer(state.checked[0].safe_finishes, origin, position[0])
		store_string(state.checked[0].safe_types, origin, value.type_name)
		return value
	end
	flow_parent := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	condition := nullable_nil_condition(state, locals, receiver, true, origin)
	alternate := mir_control_branch(state, locals, condition, line)
	nullable_apply(locals, condition.truth)
	payload := mir_checked_nullable(state, locals, 36, receiver, element, 0, origin)
	value := check_safe_present_member(state, position, locals, checked_view(receiver, element, payload.category))
	nullable_finish(locals, flow_parent, flow_first, locals.count[0])
	mut result_type := nullable_type(value.type_name)
	if value.type_name == "Void"
		result_type = "Void"
	end
	if value.type_name == "Never"
		result_type = "Nil"
	end
	if has_diagnostic(state) || result_type == ""
		return type_diagnostic(state, line, "safe navigation result is unavailable")
	end
	mut join := mir_value_join(locals, line)
	if value.type_name == "Void"
		mir_control_jump(state, locals, join.target, locals.count[0])
	elsif value.type_name != "Never"
		mir_value_exit(state, locals, join, value)
	end
	mir_control_enter(state, locals, alternate, line)
	mut result := checked_value("Void", 0, 9007199254740991, 0)
	if result_type == "Void"
		mir_control_jump(state, locals, join.target, locals.count[0])
		mir_control_enter(state, locals, join.target, line)
	else
		none := mir_checked_nullable(state, locals, 33, receiver, result_type, 0, origin)
		mir_value_exit(state, locals, join, none)
		result = mir_value_complete(state, locals, join, result_type, origin)
	end
	store_integer(state.checked[0].safe_finishes, origin, position[0])
	store_string(state.checked[0].safe_types, origin, result_type)
	return result
end

def check_enum_constructor(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	mut owner := find_enum_type(state, sparse_string_at(state.checked[0].generic_application_types, origin))
	if owner >= 0
		position[0] = sparse_integer_at(state.checked[0].generic_application_finishes, origin)
	else
		owner = find_visible_enum(state, state.module_graph.active_module[0], parse_namespace_reference(state, position))
	end
	if owner < 0
		return type_diagnostic(state, line, "enum constructor requires explicit type arguments")
	end
	if !expect(state, position, "::")
		return checked_value("Invalid", 0, origin, 0)
	end
	variant := find_enum_variant(state, owner, expect_identifier(state, position))
	if variant < 0
		return type_diagnostic(state, line, "unknown enum variant")
	end
	row := state.enum_variants[variant]
	mut bindings := enum_argument_bindings(state, variant)
	if row.field_count == 0
		if token_is(state, position[0], "(")
			return type_diagnostic(state, line, "payloadless enum variant is not callable")
		end
		return mir_enum_construct(state, locals, variant, [], origin)
	end
	if !expect(state, position, "(")
		return checked_value("Invalid", 0, origin, 0)
	end
	saved := locals.mir_state[0]
	mut diverged := false
	skip_newlines(state, position)
	while !token_is(state, position[0], ")") && !has_diagnostic(state)
		label := parse_argument_label(state, position)
		slot := argument_binding_slot(bindings, label)
		if slot < 0
			return type_diagnostic(state, line, bindings.error[0])
		end
		value := check_expression(state, position, locals, 1, state.enum_fields[row.field_start + slot].type_name)
		if value.type_name == "Never"
			diverged = true
			scalar_mir_disable(locals)
		end
		bindings.values[slot] = checked_mir_value(value)
		skip_newlines(state, position)
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	if !expect(state, position, ")")
		return checked_value("Invalid", 0, origin, 0)
	end
	mut slot := 0
	while slot < row.field_count
		if !bindings.provided[slot]
			return type_diagnostic(state, line, "missing enum payload argument " + bindings.names[slot])
		end
		slot += 1
	end
	if diverged
		locals.mir_state[0] = saved
		return checked_value("Never", 0, origin, 0)
	end
	return mir_enum_construct(state, locals, variant, bindings.values, origin)
end

# Check one Result and lower both outcomes with the existing enum/CFG machinery.
def check_statement_value(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, expected: String): CheckedValue
	origin := position[0]
	encoded := sparse_integer_at(state.catch_origins, origin)
	if encoded == 0
		return check_expression(state, position, locals, 1, expected)
	end
	handler := state.catch_syntax[encoded - 1]
	value := check_expression(state, position, locals, 1, "")
	operation := result_operation(state, origin, handler.finish, value.type_name, "")
	if has_diagnostic(state)
		return checked_value("Invalid", 0, origin, 0)
	end
	line := load_integer(state.token_lines, origin)
	saved_count := locals.count[0]
	saved_flow := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	mut join := mir_value_join(locals, line)
	condition := mir_enum_operation(state, locals, 38, value, - 1, operation.ok_variant, "Boolean", origin)
	failure := mir_control_branch(state, locals, condition, line)
	payload := mir_enum_operation(state, locals, 39, value, - 1, state.enum_variants[operation.ok_variant].field_start, operation.success_type, origin)
	mir_value_exit(state, locals, join, payload)
	mir_control_enter(state, locals, failure, line)
	error := mir_enum_operation(state, locals, 39, value, - 1, state.enum_variants[operation.err_variant].field_start, operation.error_type, origin)
	catch_name := load_string(state.token_texts, handler.binding)
	local_bind(locals, catch_name, operation.error_type, 0)
	local_require_use(locals, locals.count[0] - 1, catch_name, handler.binding, 4)
	store_integer(locals.mir_values, locals.count[0] - 1, checked_mir_value(error) + 1)
	position[0] = handler.body
	boundary := checked_return_type(state, locals)
	recovered := check_block_value(state, position, locals, boundary, locals.lexical_loop[0], true, operation.success_type)
	binding_scope_check(state, locals, saved_count)
	locals.count[0] = saved_count
	if recovered.type_name != "Never"
		check_expected(state, recovered.type_name, operation.success_type, line)
		converted := mir_nullable_coerce(state, locals, recovered, operation.success_type, origin)
		mir_value_exit(state, locals, join, converted)
	end
	nullable_finish(locals, saved_flow, flow_first, saved_count)
	position[0] = handler.finish
	result := mir_value_complete(state, locals, join, operation.success_type, origin)
	check_expected(state, result.type_name, expected, line)
	return mir_nullable_coerce(state, locals, result, expected, origin)
end

def check_callable_call(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, callee: CheckedValue): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	parts := callable_parts(callee.type_name)
	advance(position)
	skip_newlines(state, position)
	mut arguments: Array<Integer> := []
	mut diverged := false
	saved := locals.mir_state[0]
	while !token_is(state, position[0], ")") && !has_diagnostic(state)
		if arguments.size() + 1 >= parts.size()
			return type_diagnostic(state, line, "callable argument count differs")
		end
		if parse_argument_label(state, position) != ""
			return type_diagnostic(state, line, "function values require positional arguments")
		end
		value := check_expression(state, position, locals, 1, parts[arguments.size() + 1])
		if value.type_name == "Never"
			diverged = true
			scalar_mir_disable(locals)
		end
		arguments.push(checked_mir_value(value))
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	expect(state, position, ")")
	if arguments.size() + 1 != parts.size()
		return type_diagnostic(state, line, "callable argument count differs")
	end
	if diverged
		locals.mir_state[0] = saved
		return checked_value("Never", 0, 9007199254740991, 0)
	end
	return mir_checked_callable_call(state, locals, callee, arguments, parts[0], origin)
end

# Each fn is checked in its own projection and transfer scope. The statement
# checker selects captures through actual bound references, including nested fn.
# Analysis selects captures; the lowering phase constructs their MIR environment.
def check_lambda_value(mut state: CompilerState, mut position: Array<Integer>, mut parent: CheckedLocals): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	encoded := sparse_integer_at(state.lambda_origins, origin)
	if encoded <= 0 || encoded > state.lambdas.size()
		return type_diagnostic(state, line, "fn requires an owned syntax region")
	end
	syntax := state.lambdas[encoded - 1]
	if state.lambda_phase[0] == 2
		position[0] = syntax.finish
		return lower_lambda(state, parent, origin)
	end
	previous := state.checked[0]
	type_name := load_string(previous.lambda_types, origin)
	mut locals := lambda_locals(state, parent, syntax, type_name)
	if has_diagnostic(state)
		return checked_value("Invalid", 0, origin, 0)
	end
	body := state.checked_bodies.size()
	state.checked_bodies.push(checked_body_new(- 1, syntax.body_start, syntax.body_finish + 1))
	state.checked[0] = state.checked_bodies[body]
	state.checked[0].generic_binding[0] = previous.generic_binding[0]
	mut names := lambda_names(locals, state.token_count[0] + 1)
	if resolve_body_names(state, syntax.body_start, syntax.body_finish, names)
		declare_default_functions(state)
		mut inner := [syntax.body_start]
		result_type := checked_return_type(state, locals)
		completion := check_block_value(state, inner, locals, result_type, - 1, false, "")
		binding_scope_check(state, locals, locals.capture_parents.size())
		if !has_diagnostic(state)
			if inner[0] != syntax.body_finish
				diagnostic(state, "TRBN4004", line, "checker did not consume the complete fn body")
			elsif result_type != "Void" && completion.type_name != "Never"
				diagnostic(state, "TRBN4004", line, "fn must return on every completing path")
			end
		end
	end
	state.checked[0] = previous
	position[0] = syntax.finish
	if has_diagnostic(state)
		return checked_value("Invalid", 0, origin, 0)
	end
	captures := lambda_captures(state, parent, locals, origin)
	mut lambda := CheckedLambda.new(origin: origin, type_name: type_name, body: body, inherited_count: locals.capture_parents.size(), function: [- 1], captures: captures)
	state.checked[0].lambdas.push(lambda)
	if state.lambda_phase[0] == 1
		declare_lambda(state, lambda)
	end
	return checked_value(type_name, 0, origin, 0)
end

# Transform values are loop-carried bindings above the receiver/cursor boundary.
# The same checked statement body supplies analysis, MIR and the REPL projection.
def check_transform(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	encoded := sparse_integer_at(state.transform_origins, origin)
	if encoded < 1 || encoded > state.transforms.size()
		return type_diagnostic(state, line, "missing collection transform syntax")
	end
	syntax := state.transforms[encoded - 1]
	shape := syntax.iteration
	if !checked_transform_shape(state, syntax, origin)
		return type_diagnostic(state, line, "invalid collection transform syntax")
	end
	element_type := iteration_element_type(receiver.type_name)
	if element_type == "" || hash_key_type(receiver.type_name) != ""
		return type_diagnostic(state, line, "collection transform requires a supported Array or Range receiver")
	end
	if syntax.kind >= 9 && array_element_type(receiver.type_name) == ""
		return type_diagnostic(state, line, "key-based sorting requires an Array receiver")
	end
	mut initial := checked_value("Void", 0, origin, 0)
	mut output := array_type(element_type)
	mut key_type := ""
	if syntax.kind >= 9
		key_type = sparse_string_at(state.checked[0].transform_key_types, origin)
	end
	if syntax.kind == 1
		output = sparse_string_at(state.checked[0].transform_types, origin)
	elsif syntax.kind == 7
		output = nullable_type(element_type)
	elsif syntax.kind == 8
		output = "Integer?"
	elsif syntax.kind >= 4 && syntax.kind <= 6
		output = "Boolean"
	elsif syntax.kind == 3
		position[0] = syntax.initial_start
		initial = check_expression(state, position, locals, 1, "")
		if position[0] != syntax.initial_finish || initial.type_name == "Void"
			return type_diagnostic(state, line, "reduce requires an initial value")
		end
		if initial.type_name == "Never"
			position[0] = shape.finish
			return initial
		end
		output = initial.type_name
	end
	mut source_kind := 1
	if receiver.type_name == "Range<Integer>"
		source_kind = 2
	end
	plan := MirIteration.new(syntax: shape, parent_loop: locals.lexical_loop[0], source_kind: source_kind, type_name: receiver.type_name, element_type: element_type)
	outer := locals.count[0]
	flow_parent := locals.nullable_state[0]
	flow_first := locals.nullable_facts.size()
	local_bind(locals, "$transform.result", output, 1)
	if syntax.kind == 7 || syntax.kind == 8
		initial = mir_checked_nullable(state, locals, 33, initial, output, 0, origin)
	elsif syntax.kind >= 4 && syntax.kind <= 6
		mut empty := "true"
		if syntax.kind == 4
			empty = "false"
		end
		initial = scalar_mir_literal(state, locals, "Boolean", origin, empty)
	elsif syntax.kind != 3
		initial = mir_checked_array_operation(state, locals, 19, - 1, - 1, 0, output, origin)
	end
	mir_binding_initialize(state, locals, outer, initial, origin)
	if syntax.kind >= 9
		local_bind(locals, "$transform.keys", array_type(key_type), 1)
		keys := mir_checked_array_operation(state, locals, 19, - 1, - 1, 0, array_type(key_type), origin)
		mir_binding_initialize(state, locals, outer + 1, keys, origin)
	end
	saved := locals.count[0]
	local_bind(locals, "$iteration.receiver", receiver.type_name, 1)
	local_bind(locals, "$iteration.cursor", "Integer", 1)
	if source_kind == 2 && shape.second_origin >= 0
		local_bind(locals, "$iteration.ordinal", "Integer", 1)
	end
	element := mir_checked_iteration_begin(state, locals, plan, receiver, saved)
	if syntax.kind == 3
		accumulator := mir_binding_read(state, locals, outer, syntax.accumulator_origin)
		accumulator_name := load_string(state.token_texts, syntax.accumulator_origin)
		local_bind(locals, accumulator_name, output, 1)
		local_require_use(locals, locals.count[0] - 1, accumulator_name, syntax.accumulator_origin, 2)
		mir_binding_initialize(state, locals, locals.count[0] - 1, accumulator, syntax.accumulator_origin)
		if load_string(state.token_texts, syntax.accumulator_origin) == load_string(state.token_texts, shape.element_origin)
			return type_diagnostic(state, line, "collection block parameter is duplicated")
		end
	end
	transform_name := load_string(state.token_texts, shape.element_origin)
	local_bind(locals, transform_name, element_type, 1)
	local_require_use(locals, locals.count[0] - 1, transform_name, shape.element_origin, 2)
	mir_binding_initialize(state, locals, locals.count[0] - 1, element, shape.element_origin)
	if shape.second_origin >= 0
		if load_string(state.token_texts, shape.second_origin) == load_string(state.token_texts, shape.element_origin)
			return type_diagnostic(state, line, "collection block parameter is duplicated")
		end
		mut index_slot := saved + 1
		if source_kind == 2
			index_slot = saved + 2
		end
		ordinal := mir_binding_read(state, locals, index_slot, shape.second_origin)
		ordinal_name := load_string(state.token_texts, shape.second_origin)
		local_bind(locals, ordinal_name, "Integer", 1)
		local_require_use(locals, locals.count[0] - 1, ordinal_name, shape.second_origin, 2)
		mir_binding_initialize(state, locals, locals.count[0] - 1, ordinal, shape.second_origin)
	end
	position[0] = shape.body_start
	nullable_loop_writes(state, locals, shape.body_start, shape.body_finish)
	previous_block := locals.value_block[0]
	locals.value_block[0] = true
	mut yielded := check_block_value(state, position, locals, "Void", - 1, true, "")
	locals.value_block[0] = previous_block
	if has_diagnostic(state)
		return yielded
	end
	if position[0] != shape.body_finish || yielded.type_name == "Void" || yielded.type_name == "Never"
		return type_diagnostic(state, line, "collection block must end with a result expression")
	end
	if syntax.kind == 1
		output = array_type(yielded.type_name)
		analyzed := sparse_string_at(state.checked[0].transform_types, origin)
		if state.lambda_phase[0] == 2 && analyzed != output
			return type_diagnostic(state, line, "collection result differs from analyzed type")
		end
		store_string(locals.types, outer, output)
	elsif syntax.kind >= 9
		yielded = mir_literal_scalar(state, locals, yielded, origin)
		key_type = yielded.type_name
		if key_type != "Integer" && key_type != "Float" && key_type != "String"
			return type_diagnostic(state, line, "sorting key requires portable natural order")
		end
		analyzed_key := sparse_string_at(state.checked[0].transform_key_types, origin)
		if state.lambda_phase[0] == 2 && analyzed_key != key_type
			return type_diagnostic(state, line, "sorting key differs from analyzed type")
		end
		store_string(locals.types, outer + 1, array_type(key_type))
		store_string(state.checked[0].transform_key_types, origin, key_type)
	elsif syntax.kind == 2 || syntax.kind >= 4
		check_expected(state, yielded.type_name, "Boolean", line)
	else
		check_expected(state, yielded.type_name, output, line)
		yielded = mir_nullable_coerce(state, locals, yielded, output, origin)
	end
	store_string(state.checked[0].transform_types, origin, output)
	transformation := MirTransform.new(syntax: syntax, iteration: plan, type_name: output, key_type: key_type)
	state.checked[0].transforms.push(transformation)
	store_integer(state.checked[0].transform_origins, origin, state.checked[0].transforms.size())
	checked_transform_require(state, origin)
	binding_scope_check(state, locals, saved)
	if syntax.kind >= 9
		values := mir_binding_read(state, locals, outer, origin)
		mir_checked_array_operation(state, locals, 24, checked_mir_value(values), checked_mir_value(element), 0, "Void", origin)
		keys := mir_binding_read(state, locals, outer + 1, origin)
		mir_checked_array_operation(state, locals, 24, checked_mir_value(keys), checked_mir_value(yielded), 0, "Void", origin)
	elsif syntax.kind >= 7
		mir_transform_search_yield(state, locals, transformation, outer, element, yielded)
	else
		mir_transform_yield(state, locals, syntax.kind, outer, element, yielded, origin)
	end
	mir_checked_iteration_end(state, locals, plan, saved)
	mut result := mir_binding_read(state, locals, outer, origin)
	if syntax.kind >= 9
		keys := mir_binding_read(state, locals, outer + 1, origin)
		result = mir_array_sort_keys(state, locals, result, keys, syntax.kind == 10, origin)
	end
	locals.count[0] = outer
	nullable_finish(locals, flow_parent, flow_first, outer)
	position[0] = shape.finish
	# A transform result is an expression, not an assignable source binding.
	return checked_value(output, result.category, origin, 1)
end

# Preserve source order and lexical transfers before lowering a receiver method.
def check_primitive_method(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue, method: String): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	mut kind := integer_method_kind(method)
	mut arity := integer_method_arity(kind)
	mut argument_type := "Integer"
	if receiver.type_name == "Range<Integer>"
		kind = 1
		arity = 0
	elsif receiver.type_name == "Float"
		kind = float_method_kind(method)
		arity = 0
	elsif receiver.type_name == "String"
		kind = string_method_kind(method)
		arity = string_method_arity(kind)
		argument_type = string_method_argument_type(kind)
	elsif array_element_type(receiver.type_name) != "" || receiver.type_name == "Array"
		kind = array_method_kind(method)
		arity = array_method_arity(kind)
		argument_type = "Range<Integer>"
		if kind >= 7
			argument_type = array_element_type(receiver.type_name)
		end
		if kind >= 16
			if argument_type != "Integer" && argument_type != "Float" && argument_type != "String" && literal_scalar_type(argument_type) == ""
				return type_diagnostic(state, line, method + " requires portable ordering for its Array element type")
			end
		elsif kind == 15
			if receiver.type_name != "Array<String>"
				return type_diagnostic(state, line, "join requires Array<String>")
			end
			argument_type = "String"
		elsif kind == 14
			argument_type = receiver.type_name
		elsif kind >= 10 && !array_query_comparable(state, argument_type)
			return type_diagnostic(state, line, method + " requires portable equality for its Array element type")
		end
		if kind >= 7 && kind <= 9
			if receiver.mutable == 0
				diagnostic(state, "TRBN4004", line, method + " receiver is immutable")
			elsif !receiver.binding
				diagnostic(state, "TRBN4004", line, method + " requires a mutable binding")
			end
		end
	end
	advance(position)
	skip_newlines(state, position)
	mut arguments: Array<CheckedValue> := []
	saved := locals.mir_state[0]
	mut diverged := false
	while !token_is(state, position[0], ")") && !has_diagnostic(state)
		if arguments.size() >= arity
			return type_diagnostic(state, line, receiver.type_name + " method argument count differs")
		end
		value := check_expression(state, position, locals, 1, argument_type)
		arguments.push(value)
		if value.type_name == "Never"
			diverged = true
			scalar_mir_disable(locals)
		end
		skip_newlines(state, position)
		if !token_is(state, position[0], ",")
			break
		end
		advance(position)
		skip_newlines(state, position)
	end
	if !expect(state, position, ")") || arguments.size() != arity
		return type_diagnostic(state, line, receiver.type_name + " method argument count differs")
	end
	if diverged
		locals.mir_state[0] = saved
		return checked_value("Never", 0, origin, 0)
	end
	if has_diagnostic(state)
		return checked_value("Invalid", 0, origin, 0)
	end
	if receiver.type_name == "Range<Integer>"
		return mir_range_array(state, locals, receiver, origin)
	elsif receiver.type_name == "Float"
		return mir_float_method(state, locals, kind, receiver, origin)
	elsif receiver.type_name == "String"
		if kind == 15
			return mir_checked_string_operation(state, locals, 61, checked_mir_value(receiver), checked_mir_value(arguments[0]), checked_mir_value(arguments[1]), "String", origin)
		end
		if arity == 0
			return mir_string_method(state, locals, kind, receiver, receiver, origin)
		end
		return mir_string_method(state, locals, kind, receiver, arguments[0], origin)
	end
	if array_element_type(receiver.type_name) != "" || receiver.type_name == "Array"
		if arity == 0
			return mir_array_method(state, locals, kind, receiver, receiver, origin)
		end
		return mir_array_method(state, locals, kind, receiver, arguments[0], origin)
	end
	return mir_integer_method(state, locals, kind, receiver, arguments, origin)
end

def check_newtype_member(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue, member: String): CheckedValue
	owner := find_newtype_type(state, receiver.type_name)
	definition := state.newtypes[owner]
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	class_method := receiver.category == 7
	if !token_is(state, origin, "(")
		return type_diagnostic(state, line, "newtype member requires an explicit call")
	end
	if class_method && member == "new"
		if definition.closed && (state.module_graph.active_module[0] != definition.source_id || state.declaration_owner[0] != definition.name)
			return type_diagnostic(state, line, "raw constructor for closed newtype " + definition.name + " is private")
		end
		advance(position)
		skip_newlines(state, position)
		value := check_expression(state, position, locals, 1, definition.representation)
		skip_newlines(state, position)
		if token_is(state, position[0], ",")
			advance(position)
			skip_newlines(state, position)
		end
		expect(state, position, ")")
		if value.type_name == "Never"
			return value
		end
		return mir_newtype_operation(state, locals, 55, value, owner, newtype_type(owner), origin)
	end
	if !class_method && member == "value"
		advance(position)
		skip_newlines(state, position)
		expect(state, position, ")")
		return mir_newtype_operation(state, locals, 56, receiver, owner, definition.representation, origin)
	end
	function := newtype_method_function(state, receiver.type_name, member, class_method)
	if function < 0
		return type_diagnostic(state, line, "newtype " + definition.name + " has no matching member " + member)
	end
	if !namespace_member_access(state, definition.source_id, definition.name + "::" + member, origin)
		return checked_value("Invalid", 0, origin, 0)
	end
	return check_call(state, position, locals, 1, "", function, checked_mir_value(receiver), !class_method)
end

# Capture receiver and authored argument once before the live bounds/key query.
def check_builtin_lookup(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue, method: String): CheckedValue
	origin := position[0]
	kind := builtin_result_method(receiver.type_name, method)
	mut expected := "Integer"
	if kind == 2
		expected = "Range<Integer>"
	elsif kind == 3
		expected = hash_key_type(receiver.type_name)
	end
	advance(position)
	skip_newlines(state, position)
	if kind == 4 || kind == 5
		expect(state, position, ")")
		if has_diagnostic(state)
			return checked_value("Invalid", 0, origin, 0)
		end
		return mir_builtin_number_parse(state, locals, receiver, kind == 5, origin)
	end
	argument := check_expression(state, position, locals, 1, expected)
	skip_newlines(state, position)
	if token_is(state, position[0], ",")
		advance(position)
		skip_newlines(state, position)
	end
	expect(state, position, ")")
	if has_diagnostic(state)
		return checked_value("Invalid", 0, origin, 0)
	end
	if argument.type_name == "Never"
		return argument
	end
	return mir_builtin_lookup(state, locals, kind, receiver, argument, origin)
end

# Object calls share ordinary argument binding and function MIR. Abstract
# contracts and instance allocation never masquerade as empty source bodies.
def check_object_member(mut state: CompilerState, mut position: Array<Integer>, mut locals: CheckedLocals, receiver: CheckedValue, member: String): CheckedValue
	origin := position[0]
	line := load_integer(state.token_lines, origin)
	owner := find_object_type(state, receiver.type_name)
	instance := state.object_instances[owner]
	definition := state.objects[instance.definition]
	if definition.interface_type && receiver.category == 8
		return type_diagnostic(state, line, "interface cannot be constructed or used as a class receiver")
	end
	mut method_arguments: Array<String> := []
	if token_is(state, position[0], "<")
		mut application := [position[0] - 1]
		raw := parse_type(state, application)
		generic_arguments(raw).each do |argument|
			method_arguments.push(resolve_type_name(state, state.module_graph.active_module[0], argument, false))
		end
		position[0] = application[0]
	end
	if !token_is(state, position[0], "(")
		field := object_field_index(state, owner, "@" + member)
		if receiver.category != 8 && field >= 0
			mut internal := false
			if receiver.origin >= 0 && receiver.origin < state.token_count[0] && token_is(state, receiver.origin, "self") && state.declaration_owner[0] == definition.name && state.module_graph.active_module[0] == definition.source_id
				internal = true
			end
			return checked_object_field(state, locals, receiver, field, origin - 1, position[0], internal)
		end
		return type_diagnostic(state, line, "unknown class field or missing method call")
	end
	class_member := receiver.category == 8
	if class_member && member == "new"
		if method_arguments.size() > 0
			return type_diagnostic(state, line, "constructor type arguments belong to the class")
		end
		initializer := object_method_function(state, receiver.type_name, "initialize", false, [])
		if initializer >= 0
			if load_string(state.function_result_types, initializer) != "Void"
				return type_diagnostic(state, line, "class initializer must return Void")
			end
			store_integer(state.checked[0].generic_calls, position[0], initializer + 1)
			return check_call(state, position, locals, 9, "initialize", initializer, owner, true)
		else
			advance(position)
			skip_newlines(state, position)
			expect(state, position, ")")
		end
		return mir_checked_object_new(state, locals, owner, receiver.type_name, origin)
	end
	function := object_method_function(state, receiver.type_name, member, class_member, method_arguments)
	if function < 0
		return type_diagnostic(state, line, "unknown class method " + member)
	end
	declaring_owner := object_function_owner(state, function)
	declaring := state.objects[declaring_owner]
	if !namespace_member_access(state, declaring.source_id, declaring.name + "::" + member, origin)
		return checked_value("Invalid", 0, origin, 0)
	end
	store_integer(state.checked[0].generic_calls, position[0], function + 1)
	return check_call(state, position, locals, 1, "", function, checked_mir_value(receiver), true)
end
