# Canonical directory values remain ordinary checked source above the host ABI.
def native_dir_source(): String
	return "import { FileHost } from trb/internal/filesystem_host\nimport trb/std/path\nimport trb/std/result\nimport trb/std/unit\nimport { FileSystemError } from trb/std/errors\n\nclass Dir\n def self.children(path: Path, *, max_entries: Integer): Result<Array<DirEntry<Path>>, FileSystemError>\n  spelling := path.to_s()\n  mut prefix := spelling\n  if !prefix.end_with?(\"/\")\n   prefix += \"/\"\n  end\n  mut names: Array<String> := []\n  mut kinds: Array<Integer> := []\n  mut error_path := [spelling]\n  status := FileHost.children(spelling, prefix, max_entries, names, kinds, error_path)\n  if status != 0\n   return FileHost.failure<Array<DirEntry<Path>>>(error_path[0], 6, status)\n  end\n  options := [DirEntryKind::File, DirEntryKind::Directory, DirEntryKind::Other]\n  mut entries: Array<DirEntry<Path>> := []\n  mut index := 0\n  while index < names.size()\n   entries.push(DirEntry<Path>.new(name: names[index], path: Path.new(prefix + names[index]), kind: options[kinds[index]]))\n   index += 1\n  end\n  return Result<Array<DirEntry<Path>>, FileSystemError>::Ok(entries)\n end\n\n def self.create_all(path: Path): Result<Unit, FileSystemError>\n  spelling := path.to_s()\n  status := FileHost.make_directories(spelling)\n  if status != 0\n   return FileHost.failure<Unit>(spelling, 7, status)\n  end\n  return Result<Unit, FileSystemError>::Ok(Unit.new())\n end\nend\n\nenum DirEntryKind\n File\n Directory\n Other\nend\n\nrecord DirEntry<P>\n name: String\n path: P\n kind: DirEntryKind\nend\n"
end

def native_directory_helpers_source(): String
	return "\ndef children(path: String, prefix: String, maximum: Integer, mut names: Array<String>, mut kinds: Array<Integer>, mut error_path: Array<String>): Integer\nend\n\ndef stat_kind(path: String, follow: Integer, mut output: Array<Integer>): Integer\nend\n\ndef mkdir(path: String): Integer\nend\n\ndef make_directories(path: String): Integer\n mut kind := [0]\n inspected := stat_kind(path, 1, kind)\n if inspected == 0\n  if kind[0] == 1\n   return 0\n  end\n  return 20\n end\n mut status := mkdir(path)\n if status == 0\n  return 0\n end\n if stat_kind(path, 1, kind) == 0 && kind[0] == 1\n  return 0\n end\n if status != 2\n  return status\n end\n mut finish := path.size()\n while finish > 0 && path[finish - 1] == \"/\"\n  finish -= 1\n end\n mut split := finish\n while split > 0 && path[split - 1] != \"/\"\n  split -= 1\n end\n if split > 0 && split < path.size()\n  status = make_directories(path.slice(0...split))\n  if status != 0\n   return status\n  end\n end\n status = mkdir(path)\n if status != 0 && stat_kind(path, 1, kind) == 0 && kind[0] == 1\n  return 0\n end\n return status\nend\n"
end
