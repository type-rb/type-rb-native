import { native_test_print_ranges_source } from project/test_inspection_data

# Failure-only quoting preserves the pinned Go reference, including invalid UTF-8.
# Helpers are ordinary checked TypeRB inside the inaccessible test host module.
def native_test_inspection_source(): String
	return native_test_print_ranges_source() + "def test_quote_hex(value: Integer, digits: Integer): String\n mut output := \"\"\n mut remaining := value\n mut index := 0\n while index < digits\n  output = \"0123456789abcdef\"[remaining % 16] + output\n  remaining /= 16\n  index += 1\n end\n return output\nend\n\ndef test_quote_width(bytes: Bytes, index: Integer): Integer\n first := bytes.at(index)\n mut width := 1\n if first >= 194 && first <= 223\n  width = 2\n elsif first >= 224 && first <= 239\n  width = 3\n elsif first >= 240 && first <= 244\n  width = 4\n else\n  return 1\n end\n if index + width > bytes.size()\n  return 1\n end\n mut offset := 1\n while offset < width\n  byte := bytes.at(index + offset)\n  if byte < 128 || byte > 191\n   return 1\n  end\n  offset += 1\n end\n second := bytes.at(index + 1)\n if (first == 224 && second < 160) || (first == 237 && second > 159) || (first == 240 && second < 144) || (first == 244 && second > 143)\n  return 1\n end\n return width\nend\n\ndef test_quote_printable(point: Integer, ranges: Array<Integer>): Boolean\n mut first := 0\n mut finish := ranges.size() / 2\n while first < finish\n  middle := (first + finish) / 2\n  if point < ranges[middle * 2]\n   finish = middle\n  elsif point > ranges[middle * 2 + 1]\n   first = middle + 1\n  else\n   return true\n  end\n end\n return false\nend\n\ndef inspect_string(value: String): String\n bytes := value.to_bytes()\n ranges := test_print_ranges()\n mut output := StringBuilder.new()\n output.append(\"\\\"\")\n mut index := 0\n while index < bytes.size()\n  first := bytes.at(index)\n  width := test_quote_width(bytes, index)\n  mut point := first\n  if width > 1\n   mut modulus := 32\n   if width == 3\n    modulus = 16\n   elsif width == 4\n    modulus = 8\n   end\n   point = first % modulus\n   mut offset := 1\n   while offset < width\n    point = point * 64 + bytes.at(index + offset) % 64\n    offset += 1\n   end\n  end\n  if width == 1 && first >= 128\n   output.append(\"\\\\x\" + test_quote_hex(first, 2))\n  elsif point == 34 || point == 92\n   output.append(\"\\\\\")\n   output.append_codepoint(point)\n  elsif test_quote_printable(point, ranges)\n   output.append_codepoint(point)\n  elsif point == 7\n   output.append(\"\\\\a\")\n  elsif point == 8\n   output.append(\"\\\\b\")\n  elsif point == 9\n   output.append(\"\\\\t\")\n  elsif point == 10\n   output.append(\"\\\\n\")\n  elsif point == 11\n   output.append(\"\\\\v\")\n  elsif point == 12\n   output.append(\"\\\\f\")\n  elsif point == 13\n   output.append(\"\\\\r\")\n  elsif point < 32 || point == 127\n   output.append(\"\\\\x\" + test_quote_hex(point, 2))\n  elsif point < 65536\n   output.append(\"\\\\u\" + test_quote_hex(point, 4))\n  else\n   output.append(\"\\\\U\" + test_quote_hex(point, 8))\n  end\n  index += width\n end\n output.append(\"\\\"\")\n return output.to_s()\nend\n"
end
