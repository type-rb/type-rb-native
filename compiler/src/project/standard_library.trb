import { lex_module } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { CompilerState, add_module, diagnostic, has_diagnostic } from state/state
import { native_url_source, official_source_kind, official_source_name, official_source_supported, official_source_text, pinned_url_source } from project/official_catalog
import { sparse_integer_at, store_integer } from support/storage

# Portable declarations use the same parser and nominal catalogs as authored
# modules. Their owner tag is assigned only by this loader, never by spelling.
def standard_source_kind(path: String): Integer
	if path == "trb/std/result"
		return 1
	end
	if path == "trb/std/unit"
		return 2
	end
	if path == "trb/std/errors"
		return 3
	end
	if path == "trb/std/url"
		return 4
	end
	if path == "trb/internal/url"
		return 5
	end
	return official_source_kind(path)
end

def standard_source_name(kind: Integer): String
	if kind >= 100
		return official_source_name(kind)
	end
	if kind == 4
		return "trb/std/url/index"
	end
	if kind == 5
		return "trb/internal/url/index"
	end
	if kind == 1
		return "trb/std/result/index"
	end
	if kind == 3
		return "trb/std/errors/index"
	end
	return "trb/std/unit/index"
end

def standard_source_text(kind: Integer): String
	if kind >= 100
		return official_source_text(kind)
	end
	if kind == 4
		return pinned_url_source()
	end
	if kind == 5
		return native_url_source()
	end
	if kind == 1
		return "enum Result<T, E>\nOk(value: T)\nErr(error: E)\nend\n"
	end
	if kind == 3
		return "record EnumValueError\nvalue: String | Integer\nmessage: String\nend\nrecord IndexLookupError\nindex: Integer\nsize: Integer\nmessage: String\nend\nrecord SliceRangeError\nstart: Integer\nfinish: Integer\nexclusive: Boolean\nsize: Integer\nmessage: String\nend\nrecord KeyLookupError\nkey: String | Integer\nmessage: String\nend\nenum NumberParseErrorKind\nInvalidFormat\nOutOfRange\nend\nrecord NumberParseError\nkind: NumberParseErrorKind\ninput: String\nmessage: String\nend\n"
	end
	return "record Unit\nend\n"
end

def load_standard_source(mut state: CompilerState, kind: Integer, line: Integer): Integer
	if kind == 5 && sparse_integer_at(state.standard_modules, state.module_graph.active_module[0]) != 4
		diagnostic(state, "TRBN4003", line, "internal package imports are reserved for verified standard sources: trb/internal/url")
		return -1
	end
	if kind >= 100 && !official_source_supported(kind)
		diagnostic(state, "TRBN4003", line, "official package requires an unimplemented platform or semantic provider: " + official_source_name(kind))
		return -1
	end
	mut index := 0
	while index < state.module_graph.module_count[0]
		if sparse_integer_at(state.standard_modules, index) == kind
			return index
		end
		index += 1
	end
	previous := state.module_graph.active_module[0]
	name := standard_source_name(kind)
	owner := add_module(state, name, "<" + name + ">")
	store_integer(state.standard_modules, owner, kind)
	state.module_graph.active_module[0] = owner
	start := state.source_tokens.token_count[0]
	lex_module(state, standard_source_text(kind), owner)
	if !has_diagnostic(state)
		parse_module(state, start, owner)
	end
	state.module_graph.active_module[0] = previous
	return owner
end
