import { native_time_calendar_source, native_time_host_source, native_time_parse_source, native_time_source, native_time_zones_source, pinned_time_source } from project/official_catalog
import { declare_web_bindings } from frontend/providers/web_declarations
import { declare_json_codecs } from frontend/providers/json_declarations
import { standard_source_errors, standard_source_internal_json, standard_source_internal_runtime, standard_source_internal_url, standard_source_json, standard_source_jsonc, standard_source_official_start, standard_source_result, standard_source_unit, standard_source_url } from state/standard_source_kinds
import { lex_module } from frontend/syntax/lexer
import { parse_module, register_namespace } from frontend/syntax/parser
import { CompilerState, add_module, diagnostic, has_diagnostic } from state/state
import { native_json_source, native_url_source, official_source_kind, official_source_name, official_source_supported, official_source_text, pinned_json_source, pinned_jsonc_source, pinned_url_source } from project/official_catalog
import { sparse_integer_at, store_integer } from support/storage

# Portable declarations use the same parser and nominal catalogs as authored
# modules. Their owner tag is assigned only by this loader, never by spelling.
def standard_source_kind(path: String): Integer
	if path == "trb/std/file"
		return standard_source_file()
	end
	if path == "trb/std/dir"
		return standard_source_dir()
	end
	if path == "trb/std/digest"
		return standard_source_digest()
	end
	if path == "trb/internal/hash"
		return standard_source_internal_hash()
	end
	if path == "trb/std/hmac"
		return standard_source_hmac()
	end
	if path == "trb/internal/hmac"
		return standard_source_internal_hmac()
	end
	if path == "trb/std/secure_compare"
		return standard_source_secure_compare()
	end
	if path == "trb/internal/web/compression"
		return standard_source_compression()
	end
	if path == "trb/internal/string_builder_storage"
		return standard_source_string_builder_storage()
	end
	if path == "trb/std/string_builder"
		return standard_source_string_builder()
	end
	if path == "trb/internal/network_host"
		return standard_source_network_host()
	end
	if path == "trb/internal/web_server"
		return standard_source_web_server()
	end
	if path == "trb/std/path"
		return standard_source_path()
	end
	if path == "trb/internal/web_dispatch"
		return standard_source_web_dispatch()
	end
	if path == "trb/std/encoding/hex"
		return standard_source_hex()
	end
	if path == "trb/internal/encoding/hex"
		return standard_source_internal_hex()
	end
	if path == "trb/std/encoding/base64"
		return standard_source_base64()
	end
	if path == "trb/internal/encoding/base64"
		return standard_source_internal_base64()
	end
	if path == "trb/std/secure_random"
		return standard_source_secure_random()
	end
	if path == "trb/internal/entropy"
		return standard_source_entropy()
	end
	if path == "trb/internal/encoding_bytes"
		return standard_source_encoding_bytes()
	end
	if path == "trb/internal/context_storage"
		return standard_source_web_context()
	end
	if path == "trb/std/time"
		return standard_source_time()
	end
	if path == "trb/internal/time"
		return standard_source_internal_time()
	end
	if path == "trb/internal/time_calendar"
		return standard_source_time_calendar()
	end
	if path == "trb/internal/time_parse"
		return standard_source_time_parse()
	end
	if path == "trb/internal/time_zones"
		return standard_source_time_zones()
	end
	if path == "trb/internal/time_host"
		return standard_source_time_host()
	end
	if path == "trb/std/result"
		return standard_source_result()
	end
	if path == "trb/std/unit"
		return standard_source_unit()
	end
	if path == "trb/std/errors"
		return standard_source_errors()
	end
	if path == "trb/std/url"
		return standard_source_url()
	end
	if path == "trb/internal/url"
		return standard_source_internal_url()
	end
	if path == "trb/std/json"
		return standard_source_json()
	end
	if path == "trb/std/jsonc"
		return standard_source_jsonc()
	end
	if path == "trb/internal/json"
		return standard_source_internal_json()
	end
	if path == "trb/internal/runtime"
		return standard_source_internal_runtime()
	end
	return official_source_kind(path)
end

def standard_source_name(kind: Integer): String
	if kind == standard_source_file()
		return "trb/std/file/index"
	end
	if kind == standard_source_dir()
		return "trb/std/dir/index"
	end
	if kind == standard_source_digest()
		return "trb/std/digest/index"
	end
	if kind == standard_source_internal_hash()
		return "trb/internal/hash/index"
	end
	if kind == standard_source_hmac()
		return "trb/std/hmac/index"
	end
	if kind == standard_source_internal_hmac()
		return "trb/internal/hmac/index"
	end
	if kind == standard_source_secure_compare()
		return "trb/std/secure_compare/index"
	end
	if kind == standard_source_string_builder_storage()
		return "trb/internal/string_builder_storage/index"
	end
	if kind == standard_source_string_builder()
		return "trb/std/string_builder/index"
	end
	if kind == standard_source_compression()
		return "trb/internal/web/compression/index"
	end
	if kind == standard_source_network_host()
		return "trb/internal/network_host/index"
	end
	if kind == standard_source_web_server()
		return "trb/internal/web_server/index"
	end
	if kind == standard_source_path()
		return "trb/std/path/index"
	end
	if kind == standard_source_web_dispatch()
		return "trb/internal/web_dispatch/index"
	end
	if kind == standard_source_hex()
		return "trb/std/encoding/hex/index"
	end
	if kind == standard_source_internal_hex()
		return "trb/internal/encoding/hex/index"
	end
	if kind == standard_source_base64()
		return "trb/std/encoding/base64/index"
	end
	if kind == standard_source_internal_base64()
		return "trb/internal/encoding/base64/index"
	end
	if kind == standard_source_secure_random()
		return "trb/std/secure_random/index"
	end
	if kind == standard_source_entropy()
		return "trb/internal/entropy/index"
	end
	if kind == standard_source_encoding_bytes()
		return "trb/internal/encoding_bytes/index"
	end
	if kind == standard_source_web_context()
		return "trb/internal/context_storage/index"
	end
	if kind == standard_source_time()
		return "trb/std/time/index"
	end
	if kind == standard_source_internal_time()
		return "trb/internal/time/index"
	end
	if kind == standard_source_time_calendar()
		return "trb/internal/time_calendar/index"
	end
	if kind == standard_source_time_parse()
		return "trb/internal/time_parse/index"
	end
	if kind == standard_source_time_zones()
		return "trb/internal/time_zones/index"
	end
	if kind == standard_source_time_host()
		return "trb/internal/time_host/index"
	end
	if kind == standard_source_internal_runtime()
		return "trb/internal/runtime/index"
	end
	if kind >= standard_source_official_start()
		return official_source_name(kind)
	end
	if kind == standard_source_json()
		return "trb/std/json/index"
	end
	if kind == standard_source_jsonc()
		return "trb/std/jsonc/index"
	end
	if kind == standard_source_internal_json()
		return "trb/internal/json/index"
	end
	if kind == standard_source_url()
		return "trb/std/url/index"
	end
	if kind == standard_source_internal_url()
		return "trb/internal/url/index"
	end
	if kind == standard_source_result()
		return "trb/std/result/index"
	end
	if kind == standard_source_errors()
		return "trb/std/errors/index"
	end
	return "trb/std/unit/index"
end

def standard_source_text(kind: Integer): String
	if kind == standard_source_file()
		return pinned_file_source()
	end
	if kind == standard_source_dir()
		return pinned_dir_source()
	end
	if kind == standard_source_digest()
		return pinned_hash_source()
	end
	if kind == standard_source_internal_hash()
		return "module Hash\nend\ndef md5(value: Bytes): Bytes\nend\ndef sha1(value: Bytes): Bytes\nend\ndef sha256(value: Bytes): Bytes\nend\ndef sha512(value: Bytes): Bytes\nend\n"
	end
	if kind == standard_source_hmac()
		return pinned_hmac_source()
	end
	if kind == standard_source_internal_hmac()
		return "module HMAC\nend\ndef sha256(key: Bytes, message: Bytes): Bytes\nend\ndef sha512(key: Bytes, message: Bytes): Bytes\nend\ndef equal(left: Bytes, right: Bytes): Boolean\nend\n"
	end
	if kind == standard_source_secure_compare()
		return "module SecureCompare\nend\ndef equal(left: Bytes, right: Bytes): Boolean\nend\n"
	end
	if kind == standard_source_string_builder_storage()
		return "module StringBuilderStorage\nend\ndef append_bytes(mut builder: StringBuilder, bytes: Bytes, start: Integer, finish: Integer)\nend\n"
	end
	if kind == standard_source_string_builder()
		return "module StringBuilder\nend\ndef new(): StringBuilder\nend\ndef from_string(value: String): StringBuilder\nend\n"
	end
	if kind == standard_source_compression()
		return "module Compression\nend\ndef gzip(value: Bytes): Bytes\nend\n"
	end
	if kind == standard_source_network_host()
		return native_network_host_source()
	end
	if kind == standard_source_web_server()
		return native_web_server_source()
	end
	if kind == standard_source_path()
		return native_path_source()
	end
	if kind == standard_source_web_dispatch()
		return native_web_dispatch_source()
	end
	if kind == standard_source_hex()
		return pinned_hex_source()
	end
	if kind == standard_source_internal_hex()
		return native_hex_source()
	end
	if kind == standard_source_base64()
		return pinned_base64_source()
	end
	if kind == standard_source_internal_base64()
		return native_base64_source()
	end
	if kind == standard_source_secure_random()
		return native_secure_random_source()
	end
	if kind == standard_source_entropy()
		return native_entropy_source()
	end
	if kind == standard_source_encoding_bytes()
		return native_encoding_bytes_source()
	end
	if kind == standard_source_web_context()
		return native_web_context_source()
	end
	if kind == standard_source_time()
		return pinned_time_source()
	end
	if kind == standard_source_internal_time()
		return native_time_source()
	end
	if kind == standard_source_time_calendar()
		return native_time_calendar_source()
	end
	if kind == standard_source_time_parse()
		return native_time_parse_source()
	end
	if kind == standard_source_time_zones()
		return native_time_zones_source()
	end
	if kind == standard_source_time_host()
		return native_time_host_source()
	end
	if kind == standard_source_internal_runtime()
		# This loader-owned declaration has no TypeRB body. Its checked identity
		# selects the verified runtime intrinsic, including concrete generic uses.
		return "module Runtime\nend\ndef fail<T>(message: String): T\nend\ndef recover<T>(action: () -> T, fallback: T): T\nend\n"
	end
	if kind >= standard_source_official_start()
		return official_source_text(kind)
	end
	if kind == standard_source_json()
		return pinned_json_source()
	end
	if kind == standard_source_jsonc()
		return pinned_jsonc_source()
	end
	if kind == standard_source_internal_json()
		return native_json_source()
	end
	if kind == standard_source_url()
		return pinned_url_source()
	end
	if kind == standard_source_internal_url()
		return native_url_source()
	end
	if kind == standard_source_result()
		return "enum Result<T, E>\nOk(value: T)\nErr(error: E)\nend\n"
	end
	if kind == standard_source_errors()
		return pinned_errors_source()
	end
	return "record Unit\nend\n"
end

def load_standard_source(mut state: CompilerState, kind: Integer, line: Integer): Integer
	if kind == standard_source_string_builder_storage() && sparse_integer_at(state.standard_modules, state.module_graph.active_module[0]) != standard_source_internal_json()
		diagnostic(state, "TRBN4003", line, "internal builder storage is reserved for the owned JSON implementation")
		return -1
	end
	caller_kind := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
	if (kind == standard_source_internal_hash() && caller_kind != standard_source_digest()) || (kind == standard_source_internal_hmac() && caller_kind != standard_source_hmac())
		diagnostic(state, "TRBN4003", line, "internal cryptography is reserved for verified standard sources")
		return -1
	end
	if kind == standard_source_compression() && caller_kind != official_source_kind("trb/web/middleware/compression")
		diagnostic(state, "TRBN4003", line, "internal compression is reserved for the owned Web middleware")
		return -1
	end
	if (kind == standard_source_network_host() && caller_kind != standard_source_web_server()) || (kind == standard_source_web_server() && caller_kind != official_source_kind("trb/web"))
		diagnostic(state, "TRBN4003", line, "internal network sources are reserved for the owned Web server")
		return -1
	end
	if kind == standard_source_web_dispatch() && caller_kind != official_source_kind("trb/web/testing") && caller_kind != official_source_kind("trb/web") && caller_kind != standard_source_web_server()
		diagnostic(state, "TRBN4003", line, "internal Web dispatch is reserved for the owned testing provider")
		return -1
	end
	if kind == standard_source_internal_hex()
		caller := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
		if caller != standard_source_hex()
			diagnostic(state, "TRBN4003", line, "internal encoding and entropy sources are reserved for verified standard sources")
			return -1
		end
	end
	if kind == standard_source_internal_base64()
		caller := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
		if caller != standard_source_base64()
			diagnostic(state, "TRBN4003", line, "internal encoding and entropy sources are reserved for verified standard sources")
			return -1
		end
	end
	if kind == standard_source_encoding_bytes()
		caller := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
		if caller != standard_source_internal_hex() && caller != standard_source_internal_base64() && caller != standard_source_internal_json()
			diagnostic(state, "TRBN4003", line, "internal encoding and entropy sources are reserved for verified standard sources")
			return -1
		end
	end
	if kind == standard_source_entropy()
		caller := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
		if caller != standard_source_secure_random()
			diagnostic(state, "TRBN4003", line, "internal encoding and entropy sources are reserved for verified standard sources")
			return -1
		end
	end
	if kind == standard_source_web_context() && sparse_integer_at(state.standard_modules, state.module_graph.active_module[0]) != official_source_kind("trb/web")
		diagnostic(state, "TRBN4003", line, "internal Web context storage is reserved for verified standard sources")
		return -1
	end
	if kind >= standard_source_internal_time() && kind <= standard_source_time_host()
		caller := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
		if caller < standard_source_time() || caller > standard_source_time_host()
			diagnostic(state, "TRBN4003", line, "internal time packages are reserved for verified standard sources")
			return -1
		end
	end
	if kind == standard_source_internal_runtime()
		caller := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
		if caller != official_source_kind("trb/web") && caller != official_source_kind("trb/web/middleware") && caller != official_source_kind("trb/web/middleware/compression") && caller != standard_source_internal_time() && caller != standard_source_secure_random() && caller != standard_source_web_dispatch() && caller != standard_source_web_server()
			diagnostic(state, "TRBN4003", line, "internal package imports are reserved for verified standard sources: trb/internal/runtime")
			return -1
		end
	end
	if kind == standard_source_internal_url() && sparse_integer_at(state.standard_modules, state.module_graph.active_module[0]) != standard_source_url()
		diagnostic(state, "TRBN4003", line, "internal package imports are reserved for verified standard sources: trb/internal/url")
		return -1
	end
	if kind == standard_source_internal_json()
		caller := sparse_integer_at(state.standard_modules, state.module_graph.active_module[0])
		if caller != standard_source_json() && caller != standard_source_jsonc()
			diagnostic(state, "TRBN4003", line, "internal package imports are reserved for verified standard sources: trb/internal/json")
			return -1
		end
	end
	if kind >= standard_source_official_start() && !official_source_supported(kind)
		diagnostic(state, "TRBN4003", line, "official package requires an unimplemented platform or semantic provider: " + official_source_name(kind))
		return -1
	end
	mut index := 0
	while index < state.module_graph.module_count[0]
		if sparse_integer_at(state.standard_modules, index) == kind
			return index
		end
		index += 1
	end
	mut source := standard_source_text(kind)
	compiler_reserve_source(state, source.size())
	previous := state.module_graph.active_module[0]
	name := standard_source_name(kind)
	owner := add_module(state, name, "<" + name + ">")
	store_integer(state.standard_modules, owner, kind)
	state.module_graph.active_module[0] = owner
	start := state.source_tokens.token_count[0]
	if kind == official_source_kind("trb/web/testing")
		source += web_dispatch_source(state, false)
	end
	if kind == standard_source_web_server()
		source += web_dispatch_source(state, true)
	end
	if kind == official_source_kind("trb/web")
		source += "\nimport { serve as serve_network } from trb/internal/web_server\nmodule Web\ndef self.serve(config: ServerConfig = ServerConfig.new())\nserve_network(config)\nreturn\nend\nend\n"
	end
	compiler_reserve_source(state, source.size())
	lex_module(state, source, owner)
	if !has_diagnostic(state)
		parse_module(state, start, owner)
	end
	if (kind == official_source_kind("trb/web/testing") || kind == standard_source_web_server()) && !has_diagnostic(state)
		append_web_route_imports(state, owner)
	end
	if kind == official_source_kind("trb/web") && !has_diagnostic(state)
		append_import(state, "trb/internal/context_storage", "", "", import_kind_module(), 1)
		store_integer(state.module_graph.module_import_counts, owner, load_integer(state.module_graph.module_import_counts, owner) + 1)
		declare_web_context(state, owner)
		declare_web_bindings(state, owner)
		load_standard_source(state, standard_source_errors(), 1)
	end
	if !has_diagnostic(state) && (kind == standard_source_json() || kind == official_source_kind("trb/web"))
		declare_json_codecs(state, owner)
	end
	if kind == standard_source_jsonc() && !has_diagnostic(state)
		# The pinned JSONC source has a registry-owned root, not a module wrapper.
		# Keep its bytes and source locations unchanged.
		register_namespace(state, "JSONC", owner, 1)
	end
	if !has_diagnostic(state) && kind == standard_source_digest()
		register_namespace(state, "Digest", owner, 1)
	elsif !has_diagnostic(state) && kind == standard_source_hmac()
		register_namespace(state, "HMAC", owner, 1)
	end
	state.module_graph.active_module[0] = previous
	return owner
end
