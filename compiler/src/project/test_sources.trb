# The portable public wrapper is pinned separately. This private capture
# declaration has an independently verified typed MIR/runtime contract.
def native_test_host_source(): String
	return "import trb/std/result\nrecord TestOutcome\nfailed: Boolean\nmessage: String\npath: String\nline: Integer\ncolumn: Integer\nend\ndef capture(action: () -> Void, path: String, line: Integer, column: Integer): TestOutcome\nend\ndef finish(status: Integer)\nend\n"
end

# The compiler-owned runner is ordinary checked TypeRB. Only capture and the
# terminal exit cross its independently verified runtime boundary.
def native_test_reporter_source(): String
	return "import { capture, finish } from trb/internal/test\n\nrecord NativeTestCase\n name: String\n path: String\n line: Integer\n column: Integer\n action: () -> Void\nend\n\ndef test_json_quote(value: String): String\n mut output := \"\\\"\"\n mut index := 0\n while index < value.size()\n  character := value[index]\n  bytes := character.to_bytes()\n  first := bytes.at(0)\n  if character == \"\\\"\" || character == \"\\\\\"\n   output += \"\\\\\" + character\n  elsif character == \"\\n\"\n   output += \"\\\\n\"\n  elsif character == \"\\r\"\n   output += \"\\\\r\"\n  elsif character == \"\\t\"\n   output += \"\\\\t\"\n  elsif first == 8\n   output += \"\\\\b\"\n  elsif first == 12\n   output += \"\\\\f\"\n  elsif first < 32 || first == 38 || first == 60 || first == 62\n   output += \"\\\\u00\" + \"0123456789abcdef\"[first / 16] + \"0123456789abcdef\"[first % 16]\n  elsif bytes.size() == 3 && first == 226 && bytes.at(1) == 128 && bytes.at(2) == 168\n   output += \"\\\\u2028\"\n  elsif bytes.size() == 3 && first == 226 && bytes.at(1) == 128 && bytes.at(2) == 169\n   output += \"\\\\u2029\"\n  else\n   output += character\n  end\n  index += 1\n end\n return output + \"\\\"\"\nend\n\ndef test_event(reporter: String, kind: String, name: String, test_file: String, path: String, line: Integer, column: Integer, message: String)\n if reporter == \"json\"\n  mut event := \"{\\\"column\\\":\" + column.to_s() + \",\\\"file\\\":\" + test_json_quote(path) + \",\\\"line\\\":\" + line.to_s()\n  if message != \"\"\n   event += \",\\\"message\\\":\" + test_json_quote(message)\n  end\n  event += \",\\\"name\\\":\" + test_json_quote(name) + \",\\\"test_file\\\":\" + test_json_quote(test_file) + \",\\\"type\\\":\" + test_json_quote(kind) + \"}\"\n  puts(event)\n elsif kind == \"test_passed\"\n  puts(\"PASS \" + name)\n elsif kind == \"test_failed\"\n  puts(\"FAIL \" + name)\n  puts(\"  \" + path + \":\" + line.to_s() + \":\" + column.to_s() + \": \" + message)\n end\nend\n\ndef run_tests(cases: Array<NativeTestCase>, reporter: String)\n mut failed := 0\n cases.each do |item|\n  test_event(reporter, \"test_started\", item.name, item.path, item.path, item.line, item.column, \"\")\n  outcome := capture(item.action, item.path, item.line, item.column)\n  if outcome.failed\n   failed += 1\n   test_event(reporter, \"test_failed\", item.name, item.path, outcome.path, outcome.line, outcome.column, outcome.message)\n  else\n   test_event(reporter, \"test_passed\", item.name, item.path, item.path, item.line, item.column, \"\")\n  end\n end\n if reporter == \"json\"\n  puts(\"{\\\"failed\\\":\" + failed.to_s() + \",\\\"total\\\":\" + cases.size().to_s() + \",\\\"type\\\":\\\"test_summary\\\"}\")\n else\n  puts(\"\")\n  puts(cases.size().to_s() + \" test(s), \" + failed.to_s() + \" failure(s)\")\n end\n if failed > 0\n  finish(1)\n end\nend\n"
end
