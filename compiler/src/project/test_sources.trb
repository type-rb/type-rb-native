# The portable public wrapper is pinned separately. This private capture
# declaration has an independently verified typed MIR/runtime contract.
def native_test_host_source(): String
	return "import trb/std/result\nrecord TestOutcome\nfailed: Boolean\nmessage: String\npath: String\nline: Integer\ncolumn: Integer\nend\ndef capture(action: () -> Void, path: String, line: Integer, column: Integer): TestOutcome\nend\n"
end
