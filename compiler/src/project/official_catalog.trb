		return "import { Context, Next, Response } from trb/web\nimport trb/internal/runtime\n\ninterface Middleware\n\tcall(context: Context, next_handler: Next): Response\nend\n\nclass WebMiddlewareChain implements Next\n\t@middlewares: Array<Middleware>\n\t@index: Integer\n\t@terminal: Next\n\t@called: Boolean\n\n\tdef initialize(middlewares: Array<Middleware>, index: Integer, terminal: Next)\n\t\t@middlewares = middlewares\n\t\t@index = index\n\t\t@terminal = terminal\n\t\t@called = false\n\t\treturn\n\tend\n\n\tdef call(context: Context): Response\n\t\tif @called\n\t\t\treturn Runtime.fail<Response>(\"trb/web Next.call may only be called once\")\n\t\tend\n\t\t@called = true\n\t\tif @index >= @middlewares.size()\n\t\t\treturn @terminal.call(context)\n\t\tend\n\t\tcurrent := @middlewares[@index]\n\t\tnext_handler := WebMiddlewareChain.new(@middlewares, @index + 1, @terminal)\n\t\treturn current.call(context, next_handler)\n\tend\nend\n\ndef compose(context: Context, next_handler: Next, middlewares: Array<Middleware>): Response\n\treturn WebMiddlewareChain.new(middlewares, 0, next_handler).call(context)\nend\n"
