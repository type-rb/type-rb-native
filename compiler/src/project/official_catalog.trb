def native_time_source(): String
	return "import { Date, TimeOfDay, DateTime, Instant, Duration, TimeZone, DateTimeError, DateTimeErrorKind } from trb/std/time\nimport { Result } from trb/std/result\nimport trb/internal/runtime\nimport { civil_days, clock_text, clock_valid, compare, date_text, date_valid, day_parts, epoch_parts, fraction, normalize } from trb/internal/time_calendar\nimport { iso, duration } from trb/internal/time_parse\nimport { load, offset } from trb/internal/time_zones\nimport trb/internal/time_host as Host\n\nmodule Time\nend\n\ndef _error(kind: DateTimeErrorKind, input: String, message: String): DateTimeError\n\treturn DateTimeError.new(kind: kind, input: input, message: message)\nend\n\ndef validate_date(year: Integer, month: Integer, day: Integer)\n\tif !date_valid(year, month, day)\n\t\tRuntime.fail<Boolean>(\"invalid Date\")\n\tend\nend\n\ndef date_try_new(year: Integer, month: Integer, day: Integer): Result<Date, DateTimeError>\n\tif !date_valid(year, month, day)\n\t\treturn Result<Date, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidDate, \"\", \"invalid Date\"))\n\tend\n\treturn Result<Date, DateTimeError>::Ok(Date.new(year, month, day))\nend\n\ndef date_try_parse(value: String): Result<Date, DateTimeError>\n\tparsed := iso(value, 0)\n\tif parsed.error != \"\"\n\t\treturn Result<Date, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidDate, value, parsed.error))\n\tend\n\treturn Result<Date, DateTimeError>::Ok(Date.new(parsed.parts[0], parsed.parts[1], parsed.parts[2]))\nend\n\ndef date_parse(value: String): Date\n\treturn date_try_parse(value) catch |error|\n\t\tRuntime.fail<Date>(\"invalid Date: \" + error.message)\n\tend\nend\n\ndef date_to_string(value: Date): String\n\treturn date_text(value.year(), value.month(), value.day())\nend\n\ndef date_add_days(value: Date, days: Integer): Date\n\tcurrent := civil_days(value.year(), value.month(), value.day())\n\tif days < -719162 - current || days > 2932896 - current\n\t\treturn Runtime.fail<Date>(\"Date is outside the portable range\")\n\tend\n\tparts := day_parts(current + days)\n\treturn Date.new(parts[0], parts[1], parts[2])\nend\n\ndef date_compare(left: Date, right: Date): Integer\n\treturn compare(civil_days(left.year(), left.month(), left.day()), 0, civil_days(right.year(), right.month(), right.day()), 0)\nend\n\ndef validate_time(hour: Integer, minute: Integer, second: Integer, nanos: Integer)\n\tif !clock_valid(hour, minute, second, nanos)\n\t\tRuntime.fail<Boolean>(\"invalid TimeOfDay\")\n\tend\nend\n\ndef time_of_day_try_new(hour: Integer, minute: Integer, second: Integer, nanos: Integer): Result<TimeOfDay, DateTimeError>\n\tif !clock_valid(hour, minute, second, nanos)\n\t\treturn Result<TimeOfDay, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidTime, \"\", \"invalid TimeOfDay\"))\n\tend\n\treturn Result<TimeOfDay, DateTimeError>::Ok(TimeOfDay.new(hour, minute, second, nanos))\nend\n\ndef time_of_day_try_parse(value: String): Result<TimeOfDay, DateTimeError>\n\tparsed := iso(value, 1)\n\tif parsed.error != \"\"\n\t\treturn Result<TimeOfDay, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidTime, value, parsed.error))\n\tend\n\treturn Result<TimeOfDay, DateTimeError>::Ok(TimeOfDay.new(parsed.parts[3], parsed.parts[4], parsed.parts[5], parsed.parts[6]))\nend\n\ndef time_of_day_parse(value: String): TimeOfDay\n\treturn time_of_day_try_parse(value) catch |error|\n\t\tRuntime.fail<TimeOfDay>(\"invalid date/time value: \" + error.message)\n\tend\nend\n\ndef time_of_day_to_string(value: TimeOfDay): String\n\treturn clock_text(value.hour(), value.minute(), value.second(), value.nanosecond())\nend\n\ndef time_of_day_compare(left: TimeOfDay, right: TimeOfDay): Integer\n\treturn compare(left.hour() * 3600 + left.minute() * 60 + left.second(), left.nanosecond(), right.hour() * 3600 + right.minute() * 60 + right.second(), right.nanosecond())\nend\n\ndef validate_datetime(year: Integer, month: Integer, day: Integer, hour: Integer, minute: Integer, second: Integer, nanos: Integer)\n\tif !date_valid(year, month, day) || !clock_valid(hour, minute, second, nanos)\n\t\tRuntime.fail<Boolean>(\"invalid DateTime\")\n\tend\nend\n\ndef datetime_try_new(year: Integer, month: Integer, day: Integer, hour: Integer, minute: Integer, second: Integer, nanos: Integer): Result<DateTime, DateTimeError>\n\tif !date_valid(year, month, day) || !clock_valid(hour, minute, second, nanos)\n\t\treturn Result<DateTime, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidDateTime, \"\", \"invalid DateTime\"))\n\tend\n\treturn Result<DateTime, DateTimeError>::Ok(DateTime.new(year, month, day, hour, minute, second, nanos))\nend\n\ndef datetime_try_parse(value: String): Result<DateTime, DateTimeError>\n\tparsed := iso(value, 2)\n\tif parsed.error != \"\"\n\t\treturn Result<DateTime, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidDateTime, value, parsed.error))\n\tend\n\tparts := parsed.parts\n\treturn Result<DateTime, DateTimeError>::Ok(DateTime.new(parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], parts[6]))\nend\n\ndef datetime_parse(value: String): DateTime\n\treturn datetime_try_parse(value) catch |error|\n\t\tRuntime.fail<DateTime>(\"invalid date/time value: \" + error.message)\n\tend\nend\n\ndef datetime_to_string(value: DateTime): String\n\treturn date_text(value.year(), value.month(), value.day()) + \"T\" + clock_text(value.hour(), value.minute(), value.second(), value.nanosecond())\nend\n\ndef _civil_seconds(value: DateTime): Integer\n\treturn civil_days(value.year(), value.month(), value.day()) * 86400 + value.hour() * 3600 + value.minute() * 60 + value.second()\nend\n\ndef datetime_compare(left: DateTime, right: DateTime): Integer\n\treturn compare(_civil_seconds(left), left.nanosecond(), _civil_seconds(right), right.nanosecond())\nend\n\ndef datetime_try_to_instant(value: DateTime, time_zone: TimeZone): Result<Instant, DateTimeError>\n\tzone := load(time_zone.identifier())\n\tif zone.error != \"\"\n\t\treturn Result<Instant, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidTimeZone, time_zone.identifier(), \"invalid TimeZone\"))\n\tend\n\tcivil := _civil_seconds(value)\n\tmut offsets: Array<Integer> := []\n\tmut hour := -36\n\twhile hour <= 36\n\t\tcurrent := offset(zone, civil + hour * 3600)\n\t\tif !offsets.include?(current)\n\t\t\toffsets.push(current)\n\t\tend\n\t\thour += 1\n\tend\n\tmut matches: Array<Integer> := []\n\toffsets.each do |current|\n\t\tcandidate := civil - current\n\t\tif offset(zone, candidate) == current\n\t\t\tmatches.push(candidate)\n\t\tend\n\tend\n\tif matches.size() == 0\n\t\treturn Result<Instant, DateTimeError>::Err(_error(DateTimeErrorKind::NonexistentLocalTime, time_zone.identifier(), \"local DateTime does not exist in TimeZone\"))\n\tend\n\tif matches.size() > 1\n\t\treturn Result<Instant, DateTimeError>::Err(_error(DateTimeErrorKind::AmbiguousLocalTime, time_zone.identifier(), \"local DateTime is ambiguous in TimeZone\"))\n\tend\n\treturn Result<Instant, DateTimeError>::Ok(Instant.new(matches[0], value.nanosecond()))\nend\n\ndef datetime_to_instant(value: DateTime, time_zone: TimeZone): Instant\n\treturn datetime_try_to_instant(value, time_zone) catch |error|\n\t\tRuntime.fail<Instant>(error.message)\n\tend\nend\n\ndef validate_duration(_seconds: Integer, nanos: Integer)\n\tif nanos < 0 || nanos >= 1000000000\n\t\tRuntime.fail<Boolean>(\"Duration is outside the portable range\")\n\tend\nend\n\ndef duration_from_seconds(value: Integer): Duration\n\treturn Duration.new(value)\nend\n\ndef duration_from_milliseconds(value: Integer): Duration\n\tparts := normalize(value / 1000, (value % 1000) * 1000000)\n\treturn Duration.new(parts[0], parts[1])\nend\n\ndef duration_try_parse(value: String): Result<Duration, DateTimeError>\n\tparsed := duration(value)\n\tif parsed.error != \"\"\n\t\treturn Result<Duration, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidDuration, value, parsed.error))\n\tend\n\treturn Result<Duration, DateTimeError>::Ok(Duration.new(parsed.parts[0], parsed.parts[1]))\nend\n\ndef duration_parse(value: String): Duration\n\treturn duration_try_parse(value) catch |_error|\n\t\tRuntime.fail<Duration>(\"invalid Duration\")\n\tend\nend\n\ndef duration_add(left: Duration, right: Duration): Duration\n\tparts := normalize(left.whole_seconds() + right.whole_seconds(), left.nanosecond() + right.nanosecond())\n\treturn Duration.new(parts[0], parts[1])\nend\n\ndef duration_subtract(left: Duration, right: Duration): Duration\n\tparts := normalize(left.whole_seconds() - right.whole_seconds(), left.nanosecond() - right.nanosecond())\n\treturn Duration.new(parts[0], parts[1])\nend\n\ndef duration_negative(value: Duration): Duration\n\tparts := normalize(-value.whole_seconds(), -value.nanosecond())\n\treturn Duration.new(parts[0], parts[1])\nend\n\ndef duration_to_string(value: Duration): String\n\tmut seconds := value.whole_seconds()\n\tmut nanos := value.nanosecond()\n\tmut sign := \"\"\n\tif seconds < 0\n\t\tsign = \"-\"\n\t\tseconds = -seconds\n\t\tif nanos != 0\n\t\t\tseconds -= 1\n\t\t\tnanos = 1000000000 - nanos\n\t\tend\n\tend\n\treturn sign + \"PT\" + seconds.to_s() + fraction(nanos) + \"S\"\nend\n\ndef duration_compare(left: Duration, right: Duration): Integer\n\treturn compare(left.whole_seconds(), left.nanosecond(), right.whole_seconds(), right.nanosecond())\nend\n\ndef validate_time_zone(identifier: String)\n\tzone := load(identifier)\n\tif zone.error != \"\"\n\t\tRuntime.fail<Boolean>(\"invalid TimeZone: \" + zone.error)\n\tend\nend\n\ndef time_zone_try_get(identifier: String): Result<TimeZone, DateTimeError>\n\tzone := load(identifier)\n\tif zone.error != \"\"\n\t\treturn Result<TimeZone, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidTimeZone, identifier, zone.error))\n\tend\n\treturn Result<TimeZone, DateTimeError>::Ok(TimeZone.new(identifier))\nend\n\ndef validate_instant(seconds: Integer, nanos: Integer)\n\tif seconds < -62135596800 || seconds > 253402300799 || nanos < 0 || nanos >= 1000000000\n\t\tRuntime.fail<Boolean>(\"Instant is outside the portable range\")\n\tend\nend\n\ndef instant_now(): Instant\n\tmut parts := [0, 0]\n\tif !Host.clock(parts)\n\t\treturn Runtime.fail<Instant>(\"system clock unavailable\")\n\tend\n\treturn Instant.new(parts[0], parts[1])\nend\n\ndef instant_try_parse(value: String): Result<Instant, DateTimeError>\n\tparsed := iso(value, 3)\n\tif parsed.error != \"\"\n\t\treturn Result<Instant, DateTimeError>::Err(_error(DateTimeErrorKind::InvalidInstant, value, parsed.error))\n\tend\n\tparts := parsed.parts\n\tseconds := civil_days(parts[0], parts[1], parts[2]) * 86400 + parts[3] * 3600 + parts[4] * 60 + parts[5] - parts[7]\n\treturn Result<Instant, DateTimeError>::Ok(Instant.new(seconds, parts[6]))\nend\n\ndef instant_parse(value: String): Instant\n\treturn instant_try_parse(value) catch |error|\n\t\tRuntime.fail<Instant>(\"invalid Instant: \" + error.message)\n\tend\nend\n\ndef instant_to_string(value: Instant): String\n\tparts := epoch_parts(value.epoch_seconds())\n\treturn date_text(parts[0], parts[1], parts[2]) + \"T\" + clock_text(parts[3], parts[4], parts[5], value.nanosecond()) + \"Z\"\nend\n\ndef instant_to_datetime(value: Instant, time_zone: TimeZone): DateTime\n\tzone := load(time_zone.identifier())\n\tif zone.error != \"\"\n\t\treturn Runtime.fail<DateTime>(\"invalid TimeZone: \" + zone.error)\n\tend\n\tparts := epoch_parts(value.epoch_seconds() + offset(zone, value.epoch_seconds()))\n\treturn DateTime.new(parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], value.nanosecond())\nend\n\ndef instant_add(value: Instant, amount: Duration): Instant\n\tparts := normalize(value.epoch_seconds() + amount.whole_seconds(), value.nanosecond() + amount.nanosecond())\n\treturn Instant.new(parts[0], parts[1])\nend\n\ndef instant_subtract(value: Instant, amount: Duration): Instant\n\tparts := normalize(value.epoch_seconds() - amount.whole_seconds(), value.nanosecond() - amount.nanosecond())\n\treturn Instant.new(parts[0], parts[1])\nend\n\ndef instant_duration_since(left: Instant, right: Instant): Duration\n\tparts := normalize(left.epoch_seconds() - right.epoch_seconds(), left.nanosecond() - right.nanosecond())\n\treturn Duration.new(parts[0], parts[1])\nend\n\ndef instant_compare(left: Instant, right: Instant): Integer\n\treturn compare(left.epoch_seconds(), left.nanosecond(), right.epoch_seconds(), right.nanosecond())\nend\n"
end

def native_time_calendar_source(): String
	return "# Gregorian calendar and normalized second arithmetic, independent of the host.\ndef floor_div(value: Integer, divisor: Integer): Integer\n\tmut quotient := value / divisor\n\tif value % divisor < 0\n\t\tquotient -= 1\n\tend\n\treturn quotient\nend\n\ndef leap(year: Integer): Boolean\n\treturn year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)\nend\n\ndef month_days(year: Integer, month: Integer): Integer\n\tif month < 1 || month > 12\n\t\treturn 0\n\tend\n\tif month == 2 && leap(year)\n\t\treturn 29\n\tend\n\treturn [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1]\nend\n\ndef date_valid(year: Integer, month: Integer, day: Integer): Boolean\n\treturn year >= 1 && year <= 9999 && day >= 1 && day <= month_days(year, month)\nend\n\ndef clock_valid(hour: Integer, minute: Integer, second: Integer, nanos: Integer): Boolean\n\treturn hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59 && second >= 0 && second <= 59 && nanos >= 0 && nanos < 1000000000\nend\n\ndef year_days(year: Integer): Integer\n\tprior := year - 1\n\treturn prior * 365 + floor_div(prior, 4) - floor_div(prior, 100) + floor_div(prior, 400)\nend\n\ndef civil_days(year: Integer, month: Integer, day: Integer): Integer\n\tmut days := year_days(year) - 719162 + day - 1\n\tmut current := 1\n\twhile current < month\n\t\tdays += month_days(year, current)\n\t\tcurrent += 1\n\tend\n\treturn days\nend\n\ndef day_parts(days: Integer): Array<Integer>\n\tabsolute := days + 719162\n\t# A 400-year cycle always has 146097 days. The bounded search handles\n\t# negative epochs without depending on truncating integer division.\n\tcycle := floor_div(absolute, 146097)\n\tmut low := cycle * 400 + 1\n\tmut high := low + 400\n\twhile low + 1 < high\n\t\tmiddle := floor_div(low + high, 2)\n\t\tif year_days(middle) <= absolute\n\t\t\tlow = middle\n\t\telse\n\t\t\thigh = middle\n\t\tend\n\tend\n\tmut remaining := absolute - year_days(low)\n\tmut month := 1\n\twhile remaining >= month_days(low, month)\n\t\tremaining -= month_days(low, month)\n\t\tmonth += 1\n\tend\n\treturn [low, month, remaining + 1]\nend\n\ndef epoch_parts(seconds: Integer): Array<Integer>\n\tdays := floor_div(seconds, 86400)\n\tclock := seconds - days * 86400\n\tparts := day_parts(days)\n\treturn [parts[0], parts[1], parts[2], clock / 3600, (clock / 60) % 60, clock % 60]\nend\n\ndef normalize(seconds: Integer, nanos: Integer): Array<Integer>\n\tcarry := floor_div(nanos, 1000000000)\n\treturn [seconds + carry, nanos - carry * 1000000000]\nend\n\ndef compare(left: Integer, left_nanos: Integer, right: Integer, right_nanos: Integer): Integer\n\tif left < right || (left == right && left_nanos < right_nanos)\n\t\treturn -1\n\tend\n\tif left > right || (left == right && left_nanos > right_nanos)\n\t\treturn 1\n\tend\n\treturn 0\nend\n\ndef padded(value: Integer, width: Integer): String\n\tmut result := value.to_s()\n\twhile result.size() < width\n\t\tresult = \"0\" + result\n\tend\n\treturn result\nend\n\ndef fraction(nanos: Integer): String\n\tif nanos == 0\n\t\treturn \"\"\n\tend\n\tvalue := padded(nanos, 9)\n\tmut finish := value.size()\n\twhile finish > 0 && value[finish - 1] == \"0\"\n\t\tfinish -= 1\n\tend\n\treturn \".\" + value.slice(0...finish)\nend\n\ndef date_text(year: Integer, month: Integer, day: Integer): String\n\treturn padded(year, 4) + \"-\" + padded(month, 2) + \"-\" + padded(day, 2)\nend\n\ndef clock_text(hour: Integer, minute: Integer, second: Integer, nanos: Integer): String\n\treturn padded(hour, 2) + \":\" + padded(minute, 2) + \":\" + padded(second, 2) + fraction(nanos)\nend\n"
end

def native_time_parse_source(): String
	return "import { month_days } from trb/internal/time_calendar\n\nrecord ParsedTime\n\tparts: Array<Integer>\n\terror: String\nend\n\n# Match the pinned time parser's byte-oriented diagnostic quoting, including\n# non-ASCII UTF-8 and control bytes. This is distinct from JSON string quoting.\ndef quoted(value: String): String\n\tmut result := \"\\\"\"\n\tbytes := value.to_bytes()\n\tprintable := \" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\\x7f\"\n\thex := \"0123456789abcdef\"\n\tmut index := 0\n\twhile index < bytes.size()\n\t\toctet := bytes.at(index)\n\t\tif octet < 32 || octet >= 128\n\t\t\tresult += \"\\\\x\" + hex[octet / 16] + hex[octet % 16]\n\t\telse\n\t\t\tif octet == 34 || octet == 92\n\t\t\t\tresult += \"\\\\\"\n\t\t\tend\n\t\t\tresult += printable[octet - 32]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn result + \"\\\"\"\nend\n\ndef digit(value: String): Integer\n\tmut index := 0\n\twhile index < 10\n\t\tif value == \"0123456789\"[index]\n\t\t\treturn index\n\t\tend\n\t\tindex += 1\n\tend\n\treturn -1\nend\n\ndef number(value: String, mut position: Array<Integer>, minimum: Integer, maximum: Integer): Integer\n\tstart := position[0]\n\tmut result := 0\n\twhile position[0] < value.size() && position[0] - start < maximum\n\t\tpart := digit(value[position[0]])\n\t\tif part < 0\n\t\t\tbreak\n\t\tend\n\t\tresult = result * 10 + part\n\t\tposition[0] += 1\n\tend\n\tif position[0] - start < minimum\n\t\tposition[0] = start\n\t\treturn -1\n\tend\n\treturn result\nend\n\ndef mismatch(value: String, layout: String, position: Integer, token: String): String\n\treturn \"parsing time \" + quoted(value) + \" as \" + quoted(layout) + \": cannot parse \" + quoted(value.slice(position...value.size())) + \" as \" + quoted(token)\nend\n\ndef range_error(value: String, field: String): String\n\treturn \"parsing time \" + quoted(value) + \": \" + field + \" out of range\"\nend\n\ndef failed(message: String): ParsedTime\n\treturn ParsedTime.new(parts: [], error: message)\nend\n\ndef separator(value: String, mut position: Array<Integer>, token: String): Boolean\n\tif position[0] >= value.size() || value[position[0]] != token\n\t\treturn false\n\tend\n\tposition[0] += 1\n\treturn true\nend\n\n# The pinned parser accepts the ISO-shaped Go layouts, including a one-digit\n# hour and a decimal comma. It truncates excess fractional digits to nanos.\ndef iso(value: String, kind: Integer): ParsedTime\n\tmut layout := \"2006-01-02\"\n\tif kind == 1\n\t\tlayout = \"15:04:05.999999999\"\n\telsif kind == 2\n\t\tlayout += \"T15:04:05.999999999\"\n\telsif kind == 3\n\t\tlayout += \"T15:04:05.999999999Z07:00\"\n\tend\n\tmut parts := [0, 1, 1, 0, 0, 0, 0, 0]\n\tmut position := [0]\n\tmut had_seconds := false\n\tif kind != 1\n\t\tparts[0] = number(value, position, 4, 4)\n\t\tif parts[0] < 0\n\t\t\treturn failed(mismatch(value, layout, position[0], \"2006\"))\n\t\tend\n\t\tif !separator(value, position, \"-\")\n\t\t\treturn failed(mismatch(value, layout, position[0], \"-\"))\n\t\tend\n\t\tparts[1] = number(value, position, 2, 2)\n\t\tif parts[1] < 0\n\t\t\treturn failed(mismatch(value, layout, position[0], \"01\"))\n\t\tend\n\t\tif parts[1] < 1 || parts[1] > 12\n\t\t\treturn failed(range_error(value, \"month\"))\n\t\tend\n\t\tif !separator(value, position, \"-\")\n\t\t\treturn failed(mismatch(value, layout, position[0], \"-\"))\n\t\tend\n\t\tparts[2] = number(value, position, 2, 2)\n\t\tif parts[2] < 0\n\t\t\treturn failed(mismatch(value, layout, position[0], \"02\"))\n\t\tend\n\t\tif kind > 1 && !separator(value, position, \"T\")\n\t\t\treturn failed(mismatch(value, layout, position[0], \"T\"))\n\t\tend\n\tend\n\tif kind > 0\n\t\tparts[3] = number(value, position, 1, 2)\n\t\tif parts[3] < 0\n\t\t\treturn failed(mismatch(value, layout, position[0], \"15\"))\n\t\tend\n\t\tif parts[3] > 23\n\t\t\treturn failed(range_error(value, \"hour\"))\n\t\tend\n\t\tif !separator(value, position, \":\")\n\t\t\treturn failed(mismatch(value, layout, position[0], \":\"))\n\t\tend\n\t\tparts[4] = number(value, position, 2, 2)\n\t\tif parts[4] < 0\n\t\t\treturn failed(mismatch(value, layout, position[0], \"04\"))\n\t\tend\n\t\tif parts[4] > 59\n\t\t\treturn failed(range_error(value, \"minute\"))\n\t\tend\n\t\tif position[0] < value.size() || kind == 3\n\t\t\tif !separator(value, position, \":\")\n\t\t\t\treturn failed(mismatch(value, layout, position[0], \":\"))\n\t\t\tend\n\t\t\thad_seconds = true\n\t\t\tparts[5] = number(value, position, 2, 2)\n\t\t\tif parts[5] < 0\n\t\t\t\treturn failed(mismatch(value, layout, position[0], \"05\"))\n\t\t\tend\n\t\t\tif parts[5] > 59\n\t\t\t\treturn failed(range_error(value, \"second\"))\n\t\t\tend\n\t\t\tif position[0] + 1 < value.size() && (value[position[0]] == \".\" || value[position[0]] == \",\") && digit(value[position[0] + 1]) >= 0\n\t\t\t\tposition[0] += 1\n\t\t\t\tmut scale := 100000000\n\t\t\t\twhile position[0] < value.size() && digit(value[position[0]]) >= 0\n\t\t\t\t\tparts[6] += digit(value[position[0]]) * scale\n\t\t\t\t\tscale /= 10\n\t\t\t\t\tposition[0] += 1\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif kind == 3\n\t\tstart := position[0]\n\t\tif !separator(value, position, \"Z\")\n\t\t\tmut sign := 1\n\t\t\tif separator(value, position, \"-\")\n\t\t\t\tsign = -1\n\t\t\telsif !separator(value, position, \"+\")\n\t\t\t\treturn failed(mismatch(value, layout, start, \"Z07:00\"))\n\t\t\tend\n\t\t\thour := number(value, position, 2, 2)\n\t\t\tif hour < 0 || !separator(value, position, \":\")\n\t\t\t\treturn failed(mismatch(value, layout, start, \"Z07:00\"))\n\t\t\tend\n\t\t\tminute := number(value, position, 2, 2)\n\t\t\tif minute < 0\n\t\t\t\treturn failed(mismatch(value, layout, start, \"Z07:00\"))\n\t\t\tend\n\t\t\tif hour > 24\n\t\t\t\treturn failed(range_error(value, \"time zone offset hour\"))\n\t\t\tend\n\t\t\tif minute > 60\n\t\t\t\treturn failed(range_error(value, \"time zone offset minute\"))\n\t\t\tend\n\t\t\tparts[7] = sign * (hour * 3600 + minute * 60)\n\t\tend\n\tend\n\tif position[0] != value.size()\n\t\treturn failed(\"parsing time \" + quoted(value) + \": extra text: \" + quoted(value.slice(position[0]...value.size())))\n\tend\n\tif kind != 1 && (parts[2] < 1 || parts[2] > month_days(parts[0], parts[1]))\n\t\tif kind == 2 && !had_seconds\n\t\t\treturn failed(mismatch(value, layout, position[0], \":\"))\n\t\tend\n\t\treturn failed(range_error(value, \"day\"))\n\tend\n\treturn ParsedTime.new(parts: parts, error: \"\")\nend\n\ndef duration(value: String): ParsedTime\n\tmut position := 0\n\tmut negative := false\n\tif value.start_with?(\"-\")\n\t\tnegative = true\n\t\tposition = 1\n\tend\n\tif value.size() < position + 4 || value.slice(position...position + 2) != \"PT\" || !value.end_with?(\"S\")\n\t\treturn failed(\"invalid Duration\")\n\tend\n\tposition += 2\n\tstart := position\n\tmut seconds := 0\n\twhile position < value.size() - 1 && digit(value[position]) >= 0\n\t\tpart := digit(value[position])\n\t\tif seconds > (9007199254740991 - part) / 10\n\t\t\treturn failed(\"invalid Duration\")\n\t\tend\n\t\tseconds = seconds * 10 + part\n\t\tposition += 1\n\tend\n\tif position == start\n\t\treturn failed(\"invalid Duration\")\n\tend\n\tmut nanos := 0\n\tif position < value.size() - 1 && value[position] == \".\"\n\t\tposition += 1\n\t\tfraction_start := position\n\t\tmut scale := 100000000\n\t\twhile position < value.size() - 1 && digit(value[position]) >= 0\n\t\t\tif scale == 0\n\t\t\t\treturn failed(\"invalid Duration\")\n\t\t\tend\n\t\t\tnanos += digit(value[position]) * scale\n\t\t\tscale /= 10\n\t\t\tposition += 1\n\t\tend\n\t\tif position == fraction_start\n\t\t\treturn failed(\"invalid Duration\")\n\t\tend\n\tend\n\tif position != value.size() - 1\n\t\treturn failed(\"invalid Duration\")\n\tend\n\tif negative\n\t\tseconds = -seconds\n\t\tif nanos != 0\n\t\t\tseconds -= 1\n\t\t\tnanos = 1000000000 - nanos\n\t\tend\n\tend\n\treturn ParsedTime.new(parts: [seconds, nanos], error: \"\")\nend\n"
end

def native_time_zones_source(): String
	return "import { civil_days, day_parts, floor_div, leap, month_days } from trb/internal/time_calendar\nimport { digit, number, separator } from trb/internal/time_parse\nimport trb/internal/time_host as Host\n\nrecord ZoneData\n\ttransitions: Array<Integer>\n\ttypes: Array<Integer>\n\toffsets: Array<Integer>\n\tdaylight: Array<Integer>\n\tfooter: String\n\terror: String\nend\n\ndef invalid(message: String): ZoneData\n\treturn ZoneData.new(transitions: [], types: [], offsets: [], daylight: [], footer: \"\", error: message)\nend\n\ndef unsigned(bytes: Bytes, start: Integer, width: Integer): Integer\n\tmut value := 0\n\tmut index := start\n\twhile index < start + width\n\t\tvalue = value * 256 + bytes.at(index)\n\t\tindex += 1\n\tend\n\treturn value\nend\n\ndef signed(bytes: Bytes, start: Integer, width: Integer): Integer\n\tmut value := 0\n\tif bytes.at(start) >= 128\n\t\tvalue = -1\n\tend\n\tmut index := start\n\twhile index < start + width\n\t\t# TZif permits int64 sentinels outside TypeRB's Integer and civil range.\n\t\t# Saturate only outside all supported instants, before multiplication.\n\t\tif value > 3906250000\n\t\t\treturn 1000000000000\n\t\tend\n\t\tif value < -3906250000\n\t\t\treturn -1000000000000\n\t\tend\n\t\tvalue = value * 256 + bytes.at(index)\n\t\tindex += 1\n\tend\n\treturn value\nend\n\ndef header(bytes: Bytes, start: Integer): Array<Integer>\n\tif start < 0 || start + 44 > bytes.size()\n\t\treturn []\n\tend\n\tif bytes.at(start) != 84 || bytes.at(start + 1) != 90 || bytes.at(start + 2) != 105 || bytes.at(start + 3) != 102\n\t\treturn []\n\tend\n\tmut counts: Array<Integer> := []\n\tmut index := 0\n\twhile index < 6\n\t\tcount := unsigned(bytes, start + 20 + index * 4, 4)\n\t\tif count > bytes.size()\n\t\t\treturn []\n\t\tend\n\t\tcounts.push(count)\n\t\tindex += 1\n\tend\n\tif counts[4] == 0 || counts[4] > 256 || counts[5] == 0\n\t\treturn []\n\tend\n\treturn counts\nend\n\ndef block_size(counts: Array<Integer>, width: Integer): Integer\n\treturn counts[3] * (width + 1) + counts[4] * 6 + counts[5] + counts[2] * (width + 4) + counts[0] + counts[1]\nend\n\n# TZif v1/v2/v3 layout follows RFC 9636. Zone decisions and POSIX footer\n# evaluation remain ordinary checked TypeRB; the host supplies bounded bytes.\ndef decode(bytes: Bytes): ZoneData\n\tmut counts := header(bytes, 0)\n\tif counts.size() == 0\n\t\treturn invalid(\"malformed time zone information\")\n\tend\n\tversion := bytes.at(4)\n\tmut width := 4\n\tmut start := 44\n\tif version == 50 || version == 51\n\t\tstart += block_size(counts, 4)\n\t\tcounts = header(bytes, start)\n\t\tif counts.size() == 0\n\t\t\treturn invalid(\"malformed time zone information\")\n\t\tend\n\t\twidth = 8\n\t\tstart += 44\n\telsif version != 0\n\t\treturn invalid(\"malformed time zone information\")\n\tend\n\tfinish := start + block_size(counts, width)\n\tif finish > bytes.size()\n\t\treturn invalid(\"malformed time zone information\")\n\tend\n\tmut transitions: Array<Integer> := []\n\tmut types: Array<Integer> := []\n\tmut offsets: Array<Integer> := []\n\tmut daylight: Array<Integer> := []\n\tmut index := 0\n\twhile index < counts[3]\n\t\ttransitions.push(signed(bytes, start + index * width, width))\n\t\ttype_index := bytes.at(start + counts[3] * width + index)\n\t\tif type_index >= counts[4]\n\t\t\treturn invalid(\"malformed time zone information\")\n\t\tend\n\t\ttypes.push(type_index)\n\t\tindex += 1\n\tend\n\tzone_start := start + counts[3] * (width + 1)\n\tindex = 0\n\twhile index < counts[4]\n\t\tposition := zone_start + index * 6\n\t\tif bytes.at(position + 4) > 1 || bytes.at(position + 5) >= counts[5]\n\t\t\treturn invalid(\"malformed time zone information\")\n\t\tend\n\t\toffsets.push(signed(bytes, position, 4))\n\t\tdaylight.push(bytes.at(position + 4))\n\t\tindex += 1\n\tend\n\tmut footer := \"\"\n\tif width == 8 && finish + 1 < bytes.size() && bytes.at(finish) == 10\n\t\tindex = finish + 1\n\t\twhile index < bytes.size() && bytes.at(index) != 10\n\t\t\toctet := bytes.at(index)\n\t\t\tif octet < 32 || octet > 126\n\t\t\t\treturn invalid(\"malformed time zone information\")\n\t\t\tend\n\t\t\tfooter += \" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\"[octet - 32]\n\t\t\tindex += 1\n\t\tend\n\tend\n\treturn ZoneData.new(transitions: transitions, types: types, offsets: offsets, daylight: daylight, footer: footer, error: \"\")\nend\n\ndef load(identifier: String): ZoneData\n\tif identifier == \"\" || identifier == \"UTC\"\n\t\treturn ZoneData.new(transitions: [], types: [], offsets: [0], daylight: [0], footer: \"\", error: \"\")\n\tend\n\tif identifier.start_with?(\"/\") || identifier.start_with?(\"\\\\\") || identifier.include?(\"..\")\n\t\treturn invalid(\"time: invalid location name\")\n\tend\n\tif identifier.include?(\"\\x00\")\n\t\treturn invalid(\"invalid argument\")\n\tend\n\tmut path := \"/usr/share/zoneinfo/\" + identifier\n\tif identifier == \"Local\"\n\t\tpath = \"/etc/localtime\"\n\tend\n\tdata := Host.zone_data(path)\n\tif data.size() == 0\n\t\treturn invalid(\"unknown time zone \" + identifier)\n\tend\n\treturn decode(data.to_bytes())\nend\n\ndef first_type(zone: ZoneData): Integer\n\tif !zone.types.include?(0)\n\t\treturn 0\n\tend\n\tif zone.types.size() > 0 && zone.daylight[zone.types[0]] != 0\n\t\tmut index := zone.types[0] - 1\n\t\twhile index >= 0\n\t\t\tif zone.daylight[index] == 0\n\t\t\t\treturn index\n\t\t\tend\n\t\t\tindex -= 1\n\t\tend\n\tend\n\tmut index := 0\n\twhile index < zone.daylight.size()\n\t\tif zone.daylight[index] == 0\n\t\t\treturn index\n\t\tend\n\t\tindex += 1\n\tend\n\treturn 0\nend\n\ndef name(value: String, mut position: Array<Integer>): Boolean\n\tstart := position[0]\n\tif separator(value, position, \"<\")\n\t\twhile position[0] < value.size() && value[position[0]] != \">\"\n\t\t\tposition[0] += 1\n\t\tend\n\t\treturn separator(value, position, \">\")\n\tend\n\twhile position[0] < value.size()\n\t\tcharacter := value[position[0]]\n\t\tif digit(character) >= 0 || character == \",\" || character == \"-\" || character == \"+\"\n\t\t\tbreak\n\t\tend\n\t\tposition[0] += 1\n\tend\n\treturn position[0] - start >= 3\nend\n\ndef offset_value(value: String, mut position: Array<Integer>): Array<Integer>\n\tmut sign := 1\n\tif separator(value, position, \"-\")\n\t\tsign = -1\n\telse\n\t\tseparator(value, position, \"+\")\n\tend\n\thour := number(value, position, 1, 3)\n\tif hour < 0 || hour > 168\n\t\treturn []\n\tend\n\tmut result := hour * 3600\n\tif separator(value, position, \":\")\n\t\tminute := number(value, position, 1, 2)\n\t\tif minute < 0 || minute > 59\n\t\t\treturn []\n\t\tend\n\t\tresult += minute * 60\n\t\tif separator(value, position, \":\")\n\t\t\tsecond := number(value, position, 1, 2)\n\t\t\tif second < 0 || second > 59\n\t\t\t\treturn []\n\t\t\tend\n\t\t\tresult += second\n\t\tend\n\tend\n\treturn [sign * result]\nend\n\ndef rule(value: String, mut position: Array<Integer>): Array<Integer>\n\tmut kind := 0\n\tmut first := 0\n\tmut second := 0\n\tmut third := 0\n\tif separator(value, position, \"M\")\n\t\tkind = 2\n\t\tfirst = number(value, position, 1, 2)\n\t\tif first < 1 || first > 12 || !separator(value, position, \".\")\n\t\t\treturn []\n\t\tend\n\t\tsecond = number(value, position, 1, 1)\n\t\tif second < 1 || second > 5 || !separator(value, position, \".\")\n\t\t\treturn []\n\t\tend\n\t\tthird = number(value, position, 1, 1)\n\t\tif third < 0 || third > 6\n\t\t\treturn []\n\t\tend\n\telsif separator(value, position, \"J\")\n\t\tkind = 1\n\t\tfirst = number(value, position, 1, 3)\n\t\tif first < 1 || first > 365\n\t\t\treturn []\n\t\tend\n\telse\n\t\tfirst = number(value, position, 1, 3)\n\t\tif first < 0 || first > 365\n\t\t\treturn []\n\t\tend\n\tend\n\tmut seconds := 7200\n\tif separator(value, position, \"/\")\n\t\tparsed := offset_value(value, position)\n\t\tif parsed.size() == 0\n\t\t\treturn []\n\t\tend\n\t\tseconds = parsed[0]\n\tend\n\treturn [kind, first, second, third, seconds]\nend\n\ndef rule_epoch(year: Integer, parts: Array<Integer>, prior_offset: Integer): Integer\n\tmut days := civil_days(year, 1, 1) + parts[1]\n\tif parts[0] == 1\n\t\tdays -= 1\n\t\tif leap(year) && parts[1] >= 60\n\t\t\tdays += 1\n\t\tend\n\telsif parts[0] == 2\n\t\tstart := civil_days(year, parts[1], 1)\n\t\tweekday := start + 4 - floor_div(start + 4, 7) * 7\n\t\tmut day := 1 + (parts[3] - weekday + 7) % 7 + (parts[2] - 1) * 7\n\t\tif day > month_days(year, parts[1])\n\t\t\tday -= 7\n\t\tend\n\t\tdays = start + day - 1\n\tend\n\treturn days * 86400 + parts[4] - prior_offset\nend\n\ndef footer_offset(value: String, seconds: Integer): Array<Integer>\n\tmut position := [0]\n\tif !name(value, position)\n\t\treturn []\n\tend\n\tstandard := offset_value(value, position)\n\tif standard.size() == 0\n\t\treturn []\n\tend\n\tstd_offset := -standard[0]\n\tif position[0] == value.size()\n\t\treturn [std_offset]\n\tend\n\tif !name(value, position)\n\t\treturn []\n\tend\n\tmut dst_offset := std_offset + 3600\n\tif position[0] < value.size() && value[position[0]] != \",\" && value[position[0]] != \";\"\n\t\tsummer := offset_value(value, position)\n\t\tif summer.size() == 0\n\t\t\treturn []\n\t\tend\n\t\tdst_offset = -summer[0]\n\tend\n\tmut start_rule := [2, 3, 2, 0, 7200]\n\tmut end_rule := [2, 11, 1, 0, 7200]\n\tif position[0] < value.size()\n\t\tif !separator(value, position, \",\") && !separator(value, position, \";\")\n\t\t\treturn []\n\t\tend\n\t\tstart_rule = rule(value, position)\n\t\tif start_rule.size() == 0 || !separator(value, position, \",\")\n\t\t\treturn []\n\t\tend\n\t\tend_rule = rule(value, position)\n\t\tif end_rule.size() == 0 || position[0] != value.size()\n\t\t\treturn []\n\t\tend\n\tend\n\tyear := day_parts(floor_div(seconds, 86400))[0]\n\tstart := rule_epoch(year, start_rule, std_offset)\n\tfinish := rule_epoch(year, end_rule, dst_offset)\n\tmut summer := seconds >= start && seconds < finish\n\tif finish < start\n\t\tsummer = seconds >= start || seconds < finish\n\tend\n\tif summer\n\t\treturn [dst_offset]\n\tend\n\treturn [std_offset]\nend\n\ndef offset(zone: ZoneData, seconds: Integer): Integer\n\tcount := zone.transitions.size()\n\tif zone.footer != \"\" && (count == 0 || seconds >= zone.transitions[count - 1])\n\t\tfuture := footer_offset(zone.footer, seconds)\n\t\tif future.size() > 0\n\t\t\treturn future[0]\n\t\tend\n\tend\n\tif count == 0 || seconds < zone.transitions[0]\n\t\treturn zone.offsets[first_type(zone)]\n\tend\n\tmut low := 0\n\tmut high := count\n\twhile low + 1 < high\n\t\tmiddle := (low + high) / 2\n\t\tif zone.transitions[middle] <= seconds\n\t\t\tlow = middle\n\t\telse\n\t\t\thigh = middle\n\t\tend\n\tend\n\treturn zone.offsets[zone.types[low]]\nend\n"
end

def native_time_host_source(): String
	return "# Only loader-owned time implementation sources can import these declarations.\n# Their complete signatures select verified MIR adapters, never source spelling.\nmodule TimeHost\nend\n\ndef clock(mut parts: Array<Integer>): Boolean\nend\n\ndef zone_data(path: String): String\nend\n"
end

def native_web_context_source(): String
	return "import trb/std/result\nimport trb/std/unit\n\nmodule ContextStorage\nend\n\nrecord Entry\n\tkey: Any\n\tvalue: Any\nend\n\n# These private declarations are checked by loader identity and full signature.\n# Their bodies lower to independently verified typed MIR operations.\ndef pack<T>(value: T): Any\nend\n\ndef accepts<T>(value: Any): Boolean\nend\n\ndef unpack<T>(value: Any): T\nend\n\ndef same<K>(left: K, right: K): Boolean\nend\n\ndef copy_state<C, V>(source: C, replacement: V): C\nend\n\ndef copy_request<C, V>(source: C, replacement: V): C\nend\n\ndef matches<K>(entry: Entry, key: K): Boolean\n\tif !accepts<K>(entry.key)\n\t\treturn false\n\tend\n\treturn same<K>(unpack<K>(entry.key), key)\nend\n\n# Copy the entry list, retaining the original identities of keys and values.\ndef put<K, V>(state: Any?, key: K, value: V): Any\n\tmut entries: Array<Entry> := []\n\tif state != nil\n\t\tprevious := unpack<Array<Entry>>(state)\n\t\tprevious.each do |entry|\n\t\t\tif !matches<K>(entry, key)\n\t\t\t\tentries.push(entry)\n\t\t\tend\n\t\tend\n\tend\n\tentries.push(Entry.new(key: pack<K>(key), value: pack<V>(value)))\n\treturn pack<Array<Entry>>(entries)\nend\n\ndef find<K, V>(state: Any?, key: K): Result<V, Unit>\n\tif state != nil\n\t\tentries := unpack<Array<Entry>>(state)\n\t\tmut index := 0\n\t\twhile index < entries.size()\n\t\t\tentry := entries[index]\n\t\t\tif matches<K>(entry, key)\n\t\t\t\treturn Result<V, Unit>::Ok(unpack<V>(entry.value))\n\t\t\tend\n\t\t\tindex += 1\n\t\tend\n\tend\n\treturn Result<V, Unit>::Err(Unit.new())\nend\n"
end

def native_hex_source(): String
	return "import trb/std/encoding/hex as PublicHex\nimport trb/std/result\nimport trb/internal/encoding_bytes as Octets\n\nmodule Hex\nend\n\ndef encode(value: Bytes): String\n\tmut parts: Array<String> := []\n\tmut index := 0\n\twhile index < value.size()\n\t\toctet := value.at(index)\n\t\tparts.push(\"0123456789abcdef\"[octet / 16])\n\t\tparts.push(\"0123456789abcdef\"[octet % 16])\n\t\tindex += 1\n\tend\n\treturn parts.join(\"\")\nend\n\ndef _digit(point: Integer): Integer\n\tif point >= 48 && point <= 57\n\t\treturn point - 48\n\telsif point >= 65 && point <= 70\n\t\treturn point - 55\n\telsif point >= 97 && point <= 102\n\t\treturn point - 87\n\tend\n\treturn -1\nend\n\ndef decode(value: String): Result<Bytes, PublicHex::DecodeError>\n\tpoints := value.codepoints()\n\tmut digits: Array<Integer> := []\n\tmut index := 0\n\twhile index < points.size()\n\t\tdigit := _digit(points[index])\n\t\tif digit < 0\n\t\t\treturn Result<Bytes, PublicHex::DecodeError>::Err(PublicHex::DecodeError.new(kind: PublicHex::DecodeErrorKind::InvalidCharacter, input: value, index: index, message: \"invalid hexadecimal character\"))\n\t\tend\n\t\tdigits.push(digit)\n\t\tindex += 1\n\tend\n\tif digits.size() % 2 != 0\n\t\treturn Result<Bytes, PublicHex::DecodeError>::Err(PublicHex::DecodeError.new(kind: PublicHex::DecodeErrorKind::OddLength, input: value, index: digits.size(), message: \"hex input has odd length\"))\n\tend\n\tmut parts: Array<String> := []\n\tindex = 0\n\twhile index < digits.size()\n\t\tparts.push(Octets.octet(digits[index] * 16 + digits[index + 1]))\n\t\tindex += 2\n\tend\n\treturn Result<Bytes, PublicHex::DecodeError>::Ok(parts.join(\"\").to_bytes())\nend\n"
end

def native_base64_source(): String
	return "import trb/std/encoding/base64 as PublicBase64\nimport trb/std/result\nimport trb/internal/encoding_bytes as Octets\n\nmodule Base64\nend\n\ndef _encode(value: Bytes, url: Boolean): String\n\tmut alphabet := \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n\tif url\n\t\talphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\"\n\tend\n\tmut parts: Array<String> := []\n\tmut index := 0\n\twhile index < value.size()\n\t\tfirst := value.at(index)\n\t\tmut second := 0\n\t\tmut third := 0\n\t\tif index + 1 < value.size()\n\t\t\tsecond = value.at(index + 1)\n\t\tend\n\t\tif index + 2 < value.size()\n\t\t\tthird = value.at(index + 2)\n\t\tend\n\t\tparts.push(alphabet[first / 4])\n\t\tparts.push(alphabet[(first % 4) * 16 + second / 16])\n\t\tif index + 1 < value.size()\n\t\t\tparts.push(alphabet[(second % 16) * 4 + third / 64])\n\t\telsif !url\n\t\t\tparts.push(\"=\")\n\t\tend\n\t\tif index + 2 < value.size()\n\t\t\tparts.push(alphabet[third % 64])\n\t\telsif !url\n\t\t\tparts.push(\"=\")\n\t\tend\n\t\tindex += 3\n\tend\n\treturn parts.join(\"\")\nend\n\ndef encode(value: Bytes): String\n\treturn _encode(value, false)\nend\n\ndef url_encode(value: Bytes): String\n\treturn _encode(value, true)\nend\n\ndef _digit(point: Integer, url: Boolean): Integer\n\tif point >= 65 && point <= 90\n\t\treturn point - 65\n\telsif point >= 97 && point <= 122\n\t\treturn point - 71\n\telsif point >= 48 && point <= 57\n\t\treturn point + 4\n\telsif(url && point == 45) || (!url && point == 43)\n\t\treturn 62\n\telsif(url && point == 95) || (!url && point == 47)\n\t\treturn 63\n\tend\n\treturn -1\nend\n\ndef _error(kind: PublicBase64::DecodeErrorKind, input: String, index: Integer, message: String): Result<Bytes, PublicBase64::DecodeError>\n\treturn Result<Bytes, PublicBase64::DecodeError>::Err(PublicBase64::DecodeError.new(kind: kind, input: input, index: index, message: message))\nend\n\ndef _decode(value: String, url: Boolean): Result<Bytes, PublicBase64::DecodeError>\n\tpoints := value.codepoints()\n\tlength := points.size()\n\tif url && length % 4 == 1\n\t\treturn _error(PublicBase64::DecodeErrorKind::InvalidLength, value, length, \"base64url input has invalid length\")\n\telsif !url && length % 4 != 0\n\t\treturn _error(PublicBase64::DecodeErrorKind::InvalidLength, value, length, \"base64 input length must be a multiple of 4\")\n\tend\n\tmut padding := 0\n\tmut digits: Array<Integer> := []\n\tmut index := 0\n\twhile index < length\n\t\tpoint := points[index]\n\t\tif point == 61\n\t\t\tif url\n\t\t\t\treturn _error(PublicBase64::DecodeErrorKind::InvalidPadding, value, index, \"base64url input must not contain padding\")\n\t\t\tend\n\t\t\tpadding += 1\n\t\t\tif index < length - 2 || padding > 2\n\t\t\t\treturn _error(PublicBase64::DecodeErrorKind::InvalidPadding, value, index, \"invalid base64 padding\")\n\t\t\tend\n\t\telse\n\t\t\tif padding > 0\n\t\t\t\treturn _error(PublicBase64::DecodeErrorKind::InvalidPadding, value, index, \"invalid base64 padding\")\n\t\t\tend\n\t\t\tdigit := _digit(point, url)\n\t\t\tif digit < 0\n\t\t\t\tmut message := \"invalid base64 character\"\n\t\t\t\tif url\n\t\t\t\t\tmessage = \"invalid base64url character\"\n\t\t\t\tend\n\t\t\t\treturn _error(PublicBase64::DecodeErrorKind::InvalidCharacter, value, index, message)\n\t\t\tend\n\t\t\tdigits.push(digit)\n\t\tend\n\t\tindex += 1\n\tend\n\t# Strict decoding requires the unused low bits of the final digit to be zero.\n\tcount := digits.size()\n\tmut noncanonical := false\n\tif count % 4 == 2\n\t\tnoncanonical = digits[count - 1] % 16 != 0\n\telsif count % 4 == 3\n\t\tnoncanonical = digits[count - 1] % 4 != 0\n\tend\n\tif noncanonical\n\t\tmut message := \"non-canonical base64 encoding\"\n\t\tif url\n\t\t\tmessage = \"non-canonical base64url encoding\"\n\t\tend\n\t\treturn _error(PublicBase64::DecodeErrorKind::NonCanonical, value, count - 1, message)\n\tend\n\tmut parts: Array<String> := []\n\tindex = 0\n\twhile index < count\n\t\tparts.push(Octets.octet(digits[index] * 4 + digits[index + 1] / 16))\n\t\tif index + 2 < count\n\t\t\tparts.push(Octets.octet((digits[index + 1] % 16) * 16 + digits[index + 2] / 4))\n\t\tend\n\t\tif index + 3 < count\n\t\t\tparts.push(Octets.octet((digits[index + 2] % 4) * 64 + digits[index + 3]))\n\t\tend\n\t\tindex += 4\n\tend\n\treturn Result<Bytes, PublicBase64::DecodeError>::Ok(parts.join(\"\").to_bytes())\nend\n\ndef decode(value: String): Result<Bytes, PublicBase64::DecodeError>\n\treturn _decode(value, false)\nend\n\ndef url_decode(value: String): Result<Bytes, PublicBase64::DecodeError>\n\treturn _decode(value, true)\nend\n"
end

def native_encoding_bytes_source(): String
	return "module EncodingBytes\nend\n\n# Immutable raw octets are shared by the portable decoders.\nOCTETS := [\n\t\"\\x00\",\n\t\"\\x01\",\n\t\"\\x02\",\n\t\"\\x03\",\n\t\"\\x04\",\n\t\"\\x05\",\n\t\"\\x06\",\n\t\"\\x07\",\n\t\"\\x08\",\n\t\"\\x09\",\n\t\"\\x0a\",\n\t\"\\x0b\",\n\t\"\\x0c\",\n\t\"\\x0d\",\n\t\"\\x0e\",\n\t\"\\x0f\",\n\t\"\\x10\",\n\t\"\\x11\",\n\t\"\\x12\",\n\t\"\\x13\",\n\t\"\\x14\",\n\t\"\\x15\",\n\t\"\\x16\",\n\t\"\\x17\",\n\t\"\\x18\",\n\t\"\\x19\",\n\t\"\\x1a\",\n\t\"\\x1b\",\n\t\"\\x1c\",\n\t\"\\x1d\",\n\t\"\\x1e\",\n\t\"\\x1f\",\n\t\"\\x20\",\n\t\"\\x21\",\n\t\"\\x22\",\n\t\"\\x23\",\n\t\"\\x24\",\n\t\"\\x25\",\n\t\"\\x26\",\n\t\"\\x27\",\n\t\"\\x28\",\n\t\"\\x29\",\n\t\"\\x2a\",\n\t\"\\x2b\",\n\t\"\\x2c\",\n\t\"\\x2d\",\n\t\"\\x2e\",\n\t\"\\x2f\",\n\t\"\\x30\",\n\t\"\\x31\",\n\t\"\\x32\",\n\t\"\\x33\",\n\t\"\\x34\",\n\t\"\\x35\",\n\t\"\\x36\",\n\t\"\\x37\",\n\t\"\\x38\",\n\t\"\\x39\",\n\t\"\\x3a\",\n\t\"\\x3b\",\n\t\"\\x3c\",\n\t\"\\x3d\",\n\t\"\\x3e\",\n\t\"\\x3f\",\n\t\"\\x40\",\n\t\"\\x41\",\n\t\"\\x42\",\n\t\"\\x43\",\n\t\"\\x44\",\n\t\"\\x45\",\n\t\"\\x46\",\n\t\"\\x47\",\n\t\"\\x48\",\n\t\"\\x49\",\n\t\"\\x4a\",\n\t\"\\x4b\",\n\t\"\\x4c\",\n\t\"\\x4d\",\n\t\"\\x4e\",\n\t\"\\x4f\",\n\t\"\\x50\",\n\t\"\\x51\",\n\t\"\\x52\",\n\t\"\\x53\",\n\t\"\\x54\",\n\t\"\\x55\",\n\t\"\\x56\",\n\t\"\\x57\",\n\t\"\\x58\",\n\t\"\\x59\",\n\t\"\\x5a\",\n\t\"\\x5b\",\n\t\"\\x5c\",\n\t\"\\x5d\",\n\t\"\\x5e\",\n\t\"\\x5f\",\n\t\"\\x60\",\n\t\"\\x61\",\n\t\"\\x62\",\n\t\"\\x63\",\n\t\"\\x64\",\n\t\"\\x65\",\n\t\"\\x66\",\n\t\"\\x67\",\n\t\"\\x68\",\n\t\"\\x69\",\n\t\"\\x6a\",\n\t\"\\x6b\",\n\t\"\\x6c\",\n\t\"\\x6d\",\n\t\"\\x6e\",\n\t\"\\x6f\",\n\t\"\\x70\",\n\t\"\\x71\",\n\t\"\\x72\",\n\t\"\\x73\",\n\t\"\\x74\",\n\t\"\\x75\",\n\t\"\\x76\",\n\t\"\\x77\",\n\t\"\\x78\",\n\t\"\\x79\",\n\t\"\\x7a\",\n\t\"\\x7b\",\n\t\"\\x7c\",\n\t\"\\x7d\",\n\t\"\\x7e\",\n\t\"\\x7f\",\n\t\"\\x80\",\n\t\"\\x81\",\n\t\"\\x82\",\n\t\"\\x83\",\n\t\"\\x84\",\n\t\"\\x85\",\n\t\"\\x86\",\n\t\"\\x87\",\n\t\"\\x88\",\n\t\"\\x89\",\n\t\"\\x8a\",\n\t\"\\x8b\",\n\t\"\\x8c\",\n\t\"\\x8d\",\n\t\"\\x8e\",\n\t\"\\x8f\",\n\t\"\\x90\",\n\t\"\\x91\",\n\t\"\\x92\",\n\t\"\\x93\",\n\t\"\\x94\",\n\t\"\\x95\",\n\t\"\\x96\",\n\t\"\\x97\",\n\t\"\\x98\",\n\t\"\\x99\",\n\t\"\\x9a\",\n\t\"\\x9b\",\n\t\"\\x9c\",\n\t\"\\x9d\",\n\t\"\\x9e\",\n\t\"\\x9f\",\n\t\"\\xa0\",\n\t\"\\xa1\",\n\t\"\\xa2\",\n\t\"\\xa3\",\n\t\"\\xa4\",\n\t\"\\xa5\",\n\t\"\\xa6\",\n\t\"\\xa7\",\n\t\"\\xa8\",\n\t\"\\xa9\",\n\t\"\\xaa\",\n\t\"\\xab\",\n\t\"\\xac\",\n\t\"\\xad\",\n\t\"\\xae\",\n\t\"\\xaf\",\n\t\"\\xb0\",\n\t\"\\xb1\",\n\t\"\\xb2\",\n\t\"\\xb3\",\n\t\"\\xb4\",\n\t\"\\xb5\",\n\t\"\\xb6\",\n\t\"\\xb7\",\n\t\"\\xb8\",\n\t\"\\xb9\",\n\t\"\\xba\",\n\t\"\\xbb\",\n\t\"\\xbc\",\n\t\"\\xbd\",\n\t\"\\xbe\",\n\t\"\\xbf\",\n\t\"\\xc0\",\n\t\"\\xc1\",\n\t\"\\xc2\",\n\t\"\\xc3\",\n\t\"\\xc4\",\n\t\"\\xc5\",\n\t\"\\xc6\",\n\t\"\\xc7\",\n\t\"\\xc8\",\n\t\"\\xc9\",\n\t\"\\xca\",\n\t\"\\xcb\",\n\t\"\\xcc\",\n\t\"\\xcd\",\n\t\"\\xce\",\n\t\"\\xcf\",\n\t\"\\xd0\",\n\t\"\\xd1\",\n\t\"\\xd2\",\n\t\"\\xd3\",\n\t\"\\xd4\",\n\t\"\\xd5\",\n\t\"\\xd6\",\n\t\"\\xd7\",\n\t\"\\xd8\",\n\t\"\\xd9\",\n\t\"\\xda\",\n\t\"\\xdb\",\n\t\"\\xdc\",\n\t\"\\xdd\",\n\t\"\\xde\",\n\t\"\\xdf\",\n\t\"\\xe0\",\n\t\"\\xe1\",\n\t\"\\xe2\",\n\t\"\\xe3\",\n\t\"\\xe4\",\n\t\"\\xe5\",\n\t\"\\xe6\",\n\t\"\\xe7\",\n\t\"\\xe8\",\n\t\"\\xe9\",\n\t\"\\xea\",\n\t\"\\xeb\",\n\t\"\\xec\",\n\t\"\\xed\",\n\t\"\\xee\",\n\t\"\\xef\",\n\t\"\\xf0\",\n\t\"\\xf1\",\n\t\"\\xf2\",\n\t\"\\xf3\",\n\t\"\\xf4\",\n\t\"\\xf5\",\n\t\"\\xf6\",\n\t\"\\xf7\",\n\t\"\\xf8\",\n\t\"\\xf9\",\n\t\"\\xfa\",\n\t\"\\xfb\",\n\t\"\\xfc\",\n\t\"\\xfd\",\n\t\"\\xfe\",\n\t\"\\xff\",\n]\n\ndef octet(value: Integer): String\n\treturn OCTETS[value]\nend\n"
