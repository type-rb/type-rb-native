	if kind == 117
		return "import trb/std/result\nimport trb/std/json\nimport trb/std/url\nimport { Body, Header, Headers, HeaderValueError, HttpMethod } from trb/http\nimport trb/internal/runtime\n\nrecord RequestCookie\n\tname: String\n\tvalue: String\nend\n\nenum QueryValueError\n\tMalformed(error: URL::DecodeError)\n\tMissing(name: String)\n\tDuplicate(name: String)\nend\n\nenum CookieValueError\n\tMissing(name: String)\n\tDuplicate(name: String)\nend\n\nenum RequestError\n\tMissingContentType\n\tDuplicateContentType\n\tUnsupportedContentType(value: String)\n\tInvalidUtf8\n\tInvalidJson(error: JSON::Error)\nend\n\nenum ParameterSource\n\tPath\n\tQuery\nend\n\nenum ParameterError\n\tMalformedQuery(error: URL::DecodeError)\n\tMissing(*, source: ParameterSource, name: String)\n\tDuplicate(*, source: ParameterSource, name: String)\n\tInvalid(*, source: ParameterSource, name: String, value: String, expected: String)\nend\n\nenum EndpointInputError\n\tParams(error: ParameterError)\n\tQuery(error: ParameterError)\n\tBody(error: RequestError)\nend\n\nrecord ContextValueError\n\tkey: String\nend\n\nclass ContextKey<T>\n\treadonly @name: String\n\n\tdef initialize(name: String)\n\t\t@name = name\n\t\treturn\n\tend\nend\n\nclass Request\n\treadonly @method: HttpMethod\n\treadonly @path: String\n\treadonly @query_string: String\n\treadonly @headers: Headers\n\treadonly @body: Body\n\n\tdef initialize(*, method: HttpMethod, path: String, query_string: String, headers: Headers, body: Body)\n\t\t@method = method\n\t\t@path = path\n\t\t@query_string = query_string\n\t\t@headers = headers\n\t\t@body = body\n\t\treturn\n\tend\n\n\tdef query_parameters(): Result<Array<URL::QueryParameter>, URL::DecodeError>\n\t\treturn URL.parse_query(@query_string)\n\tend\n\n\tdef query_values(name: String): Result<Array<String>, URL::DecodeError>\n\t\tcase query_parameters()\n\t\twhen Result::Ok(parameters)\n\t\t\tmut values: Array<String> := []\n\t\t\tparameters.each do |parameter|\n\t\t\t\tif parameter.name == name\n\t\t\t\t\tvalues.push(parameter.value)\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn Result<Array<String>, URL::DecodeError>::Ok(values)\n\t\twhen Result::Err(error)\n\t\t\treturn Result<Array<String>, URL::DecodeError>::Err(error)\n\t\tend\n\tend\n\n\tdef query_value(name: String): Result<String, QueryValueError>\n\t\tcase query_values(name)\n\t\twhen Result::Ok(values)\n\t\t\tif values.empty?()\n\t\t\t\treturn Result<String, QueryValueError>::Err(QueryValueError::Missing(name))\n\t\t\tend\n\t\t\tif values.size() > 1\n\t\t\t\treturn Result<String, QueryValueError>::Err(QueryValueError::Duplicate(name))\n\t\t\tend\n\t\t\treturn Result<String, QueryValueError>::Ok(values[0])\n\t\twhen Result::Err(error)\n\t\t\treturn Result<String, QueryValueError>::Err(QueryValueError::Malformed(error))\n\t\tend\n\tend\n\n\tdef header_values(name: String): Array<String>\n\t\treturn @headers.values(name)\n\tend\n\n\tdef header_value(name: String): Result<String, HeaderValueError>\n\t\treturn @headers.value(name)\n\tend\n\n\tdef cookies(): Array<RequestCookie>\n\t\tmut result: Array<RequestCookie> := []\n\t\theader_values(\"cookie\").each do |header|\n\t\t\theader.split(\";\").each do |part|\n\t\t\t\tpair := part.strip()\n\t\t\t\tif pair == \"\"\n\t\t\t\t\tnext\n\t\t\t\tend\n\t\t\t\tparts := pair.split(\"=\")\n\t\t\t\tif parts.size() < 2\n\t\t\t\t\tnext\n\t\t\t\tend\n\t\t\t\tname := parts.first().strip()\n\t\t\t\tif name == \"\"\n\t\t\t\t\tnext\n\t\t\t\tend\n\t\t\t\tmut value_parts := parts.dup()\n\t\t\t\tvalue_parts.shift()\n\t\t\t\tvalue := value_parts.join(\"=\").strip()\n\t\t\t\tresult.push(RequestCookie.new(name: name, value: value))\n\t\t\tend\n\t\tend\n\t\treturn result\n\tend\n\n\tdef cookie_values(name: String): Array<String>\n\t\tmut values: Array<String> := []\n\t\tcookies().each do |candidate|\n\t\t\tif candidate.name == name\n\t\t\t\tvalues.push(candidate.value)\n\t\t\tend\n\t\tend\n\t\treturn values\n\tend\n\n\tdef cookie_value(name: String): Result<String, CookieValueError>\n\t\tvalues := cookie_values(name)\n\t\tif values.empty?()\n\t\t\treturn Result<String, CookieValueError>::Err(CookieValueError::Missing(name))\n\t\tend\n\t\tif values.size() > 1\n\t\t\treturn Result<String, CookieValueError>::Err(CookieValueError::Duplicate(name))\n\t\tend\n\t\treturn Result<String, CookieValueError>::Ok(values[0])\n\tend\n\n\tdef text(): Result<String, RequestError>\n\t\tvalue := @body.bytes()\n\t\tif !value.valid_utf8?()\n\t\t\treturn Result<String, RequestError>::Err(RequestError::InvalidUtf8)\n\t\tend\n\t\treturn Result<String, RequestError>::Ok(value.to_s())\n\tend\n\n\tdef bytes(): Bytes\n\t\treturn @body.bytes()\n\tend\n\n\tdef with_header(name: String, value: String): Request\n\t\treturn Request.new(method: @method, path: @path, query_string: @query_string, headers: @headers.with(name, value), body: @body)\n\tend\n\n\tdef add_header(name: String, value: String): Request\n\t\treturn Request.new(method: @method, path: @path, query_string: @query_string, headers: @headers.add(name, value), body: @body)\n\tend\n\n\tdef without_header(name: String): Request\n\t\treturn Request.new(method: @method, path: @path, query_string: @query_string, headers: @headers.without(name), body: @body)\n\tend\nend\n\nmodule Web\n\trecord ServerConfig\n\t\thost: String = \"0.0.0.0\"\n\t\tport: Integer = 3000\n\t\tbody_limit_bytes: Integer = 1048576\n\t\tshutdown_timeout_milliseconds: Integer = 10000\n\tend\nend\n\nenum CookieSameSite\n\tLax\n\tStrict\n\tNone\nend\n\nenum ResponseCookieAttribute\n\tDomain(value: String)\n\tPath(value: String)\n\tMaxAge(seconds: Integer)\n\tSecure\n\tHttpOnly\n\tSameSite(value: CookieSameSite)\nend\n\nrecord ResponseCookie\n\tname: String\n\tvalue: String\n\tattributes: Array<ResponseCookieAttribute> = []\nend\n\nclass Context\n\treadonly @request: Request\n\treadonly @_path_parameters: Hash<String, String>\n\treadonly @_trb_context_state: Any? := nil\n\n\tdef initialize(*, request: Request, path_parameters: Hash<String, String>)\n\t\t@request = request\n\t\t@_path_parameters = path_parameters\n\t\treturn\n\tend\n\n\tdef path_value(name: String): String\n\t\treturn @_path_parameters[name]\n\tend\n\n\tdef with_request(request: Request): Context\n\t\treturn Context.new(request: request, path_parameters: @_path_parameters)\n\tend\nend\n\nclass Response\n\treadonly @status: Integer\n\treadonly @headers: Headers\n\treadonly @body: Body\n\n\tdef initialize(*, status: Integer, headers: Headers, body: Body)\n\t\t@status = status\n\t\t@headers = headers\n\t\t@body = body\n\t\treturn\n\tend\n\n\tdef self.text(value: String, status: Integer = 200): Response\n\t\treturn Response.new(\n\t\t\tstatus: status,\n\t\t\theaders: Headers.new([Header.new(name: \"content-type\", value: \"text/plain; charset=utf-8\")]),\n\t\t\tbody: Body.new(value.to_bytes()),\n\t\t)\n\tend\n\n\tdef self.bytes(value: Bytes, status: Integer = 200): Response\n\t\treturn Response.new(\n\t\t\tstatus: status,\n\t\t\theaders: Headers.new([Header.new(name: \"content-type\", value: \"application/octet-stream\")]),\n\t\t\tbody: Body.new(value),\n\t\t)\n\tend\n\n\tdef self.empty(status: Integer = 204): Response\n\t\treturn Response.new(status: status, headers: Headers.new(), body: Body.empty())\n\tend\n\n\tdef self.redirect(location: String, status: Integer = 302): Response\n\t\treturn Response.empty(status).with_header(\"location\", location)\n\tend\n\n\tdef with_status(status: Integer): Response\n\t\treturn Response.new(status: status, headers: @headers, body: @body)\n\tend\n\n\tdef with_header(name: String, value: String): Response\n\t\treturn Response.new(status: @status, headers: @headers.with(name, value), body: @body)\n\tend\n\n\tdef add_header(name: String, value: String): Response\n\t\treturn Response.new(status: @status, headers: @headers.add(name, value), body: @body)\n\tend\n\n\tdef without_header(name: String): Response\n\t\treturn Response.new(status: @status, headers: @headers.without(name), body: @body)\n\tend\n\n\tdef header_values(name: String): Array<String>\n\t\treturn @headers.values(name)\n\tend\n\n\tdef header_value(name: String): Result<String, HeaderValueError>\n\t\treturn @headers.value(name)\n\tend\n\n\tdef vary(field: String): Response\n\t\tnormalized_field := field.strip().downcase()\n\t\tif normalized_field == \"\"\n\t\t\treturn self\n\t\tend\n\t\theader_values(\"vary\").each do |value|\n\t\t\tvalue.split(\",\").each do |existing_field|\n\t\t\t\tnormalized_existing := existing_field.strip().downcase()\n\t\t\t\tif normalized_existing == \"*\" || normalized_existing == normalized_field\n\t\t\t\t\treturn self\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif normalized_field == \"*\"\n\t\t\treturn with_header(\"vary\", \"*\")\n\t\tend\n\t\treturn add_header(\"vary\", field.strip())\n\tend\n\n\tdef set_cookie(cookie_value: ResponseCookie): Response\n\t\tif !_valid_response_cookie?(cookie_value)\n\t\t\treturn Runtime.fail<Response>(\"trb/web response cookie is invalid\")\n\t\tend\n\t\tprefix := cookie_value.name + \"=\"\n\t\theader_values(\"set-cookie\").each do |existing_value|\n\t\t\tif existing_value.start_with?(prefix)\n\t\t\t\treturn Runtime.fail<Response>(\"trb/web response contains duplicate cookie name\")\n\t\t\tend\n\t\tend\n\t\tmut parts := [cookie_value.name + \"=\" + cookie_value.value]\n\t\tcookie_value.attributes.each do |attribute|\n\t\t\tparts.push(_response_cookie_attribute(attribute))\n\t\tend\n\t\treturn add_header(\"set-cookie\", parts.join(\"; \"))\n\tend\nend\n\nclass Endpoint\nend\n\ndef handles(handler: (Context) -> Response)\n\treturn\nend\n\ndef input<T>()\n\treturn\nend\n\ndef response<T>(*, status: Integer)\n\treturn\nend\n\ndef _valid_response_cookie?(cookie_value: ResponseCookie): Boolean\n\tif !_valid_cookie_name?(cookie_value.name) || !_valid_cookie_value?(cookie_value.value)\n\t\treturn false\n\tend\n\tmut seen: Hash<String, Boolean> := {}\n\tmut secure := false\n\tmut has_domain := false\n\tmut has_path := false\n\tmut path := \"\"\n\tmut same_site_none := false\n\tcookie_value.attributes.each do |attribute|\n\t\tname := _response_cookie_attribute_name(attribute)\n\t\tif seen.key?(name)\n\t\t\treturn false\n\t\tend\n\t\tseen[name] = true\n\t\tcase attribute\n\t\twhen ResponseCookieAttribute::Domain(value)\n\t\t\tif !_valid_cookie_domain?(value)\n\t\t\t\treturn false\n\t\t\tend\n\t\t\thas_domain = true\n\t\twhen ResponseCookieAttribute::Path(value)\n\t\t\tif !_valid_cookie_path?(value)\n\t\t\t\treturn false\n\t\t\tend\n\t\t\thas_path = true\n\t\t\tpath = value\n\t\twhen ResponseCookieAttribute::MaxAge(seconds)\n\t\t\tif seconds < 0\n\t\t\t\treturn false\n\t\t\tend\n\t\twhen ResponseCookieAttribute::Secure\n\t\t\tsecure = true\n\t\twhen ResponseCookieAttribute::HttpOnly\n\t\twhen ResponseCookieAttribute::SameSite(value)\n\t\t\tif value == CookieSameSite::None\n\t\t\t\tsame_site_none = true\n\t\t\tend\n\t\tend\n\tend\n\tif same_site_none && !secure\n\t\treturn false\n\tend\n\tnormalized_name := cookie_value.name.downcase()\n\tif normalized_name.start_with?(\"__secure-\") && !secure\n\t\treturn false\n\tend\n\tif normalized_name.start_with?(\"__host-\")\n\t\tif !secure || has_domain || !has_path || path != \"/\"\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_name?(value: String): Boolean\n\tif value == \"\"\n\t\treturn false\n\tend\n\tvalue.codepoints().each do |codepoint|\n\t\tletter := codepoint >= 65 && codepoint <= 90 || codepoint >= 97 && codepoint <= 122\n\t\tdigit := codepoint >= 48 && codepoint <= 57\n\t\tsymbol := codepoint == 33 || codepoint >= 35 && codepoint <= 39 || codepoint == 42 || codepoint == 43 || codepoint == 45 || codepoint == 46 || codepoint == 94 || codepoint == 95 || codepoint == 96 || codepoint == 124 || codepoint == 126\n\t\tif !letter && !digit && !symbol\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_value?(value: String): Boolean\n\tvalue.codepoints().each do |codepoint|\n\t\tallowed := codepoint == 33 || codepoint >= 35 && codepoint <= 43 || codepoint >= 45 && codepoint <= 58 || codepoint >= 60 && codepoint <= 91 || codepoint >= 93 && codepoint <= 126\n\t\tif !allowed\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_domain?(value: String): Boolean\n\tif value == \"\" || value.size() > 253 || value.start_with?(\".\") || value.end_with?(\".\")\n\t\treturn false\n\tend\n\tvalue.split(\".\").each do |label|\n\t\tcodepoints := label.codepoints()\n\t\tif codepoints.empty?() || codepoints.size() > 63 || codepoints[0] == 45 || codepoints[codepoints.size() - 1] == 45\n\t\t\treturn false\n\t\tend\n\t\tcodepoints.each do |codepoint|\n\t\t\tletter := codepoint >= 65 && codepoint <= 90 || codepoint >= 97 && codepoint <= 122\n\t\t\tdigit := codepoint >= 48 && codepoint <= 57\n\t\t\tif !letter && !digit && codepoint != 45\n\t\t\t\treturn false\n\t\t\tend\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_path?(value: String): Boolean\n\tif !value.start_with?(\"/\")\n\t\treturn false\n\tend\n\tvalue.codepoints().each do |codepoint|\n\t\tif !(codepoint >= 32 && codepoint <= 58 || codepoint >= 60 && codepoint <= 126)\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _response_cookie_attribute_name(attribute: ResponseCookieAttribute): String\n\tcase attribute\n\twhen ResponseCookieAttribute::Domain(_value)\n\t\treturn \"domain\"\n\twhen ResponseCookieAttribute::Path(_value)\n\t\treturn \"path\"\n\twhen ResponseCookieAttribute::MaxAge(_seconds)\n\t\treturn \"max-age\"\n\twhen ResponseCookieAttribute::Secure\n\t\treturn \"secure\"\n\twhen ResponseCookieAttribute::HttpOnly\n\t\treturn \"httponly\"\n\twhen ResponseCookieAttribute::SameSite(_value)\n\t\treturn \"samesite\"\n\tend\nend\n\ndef _response_cookie_attribute(attribute: ResponseCookieAttribute): String\n\tcase attribute\n\twhen ResponseCookieAttribute::Domain(value)\n\t\treturn \"Domain=\" + value\n\twhen ResponseCookieAttribute::Path(value)\n\t\treturn \"Path=\" + value\n\twhen ResponseCookieAttribute::MaxAge(seconds)\n\t\treturn \"Max-Age=\" + seconds.to_s()\n\twhen ResponseCookieAttribute::Secure\n\t\treturn \"Secure\"\n\twhen ResponseCookieAttribute::HttpOnly\n\t\treturn \"HttpOnly\"\n\twhen ResponseCookieAttribute::SameSite(value)\n\t\treturn \"SameSite=\" + _cookie_same_site(value)\n\tend\nend\n\ndef _cookie_same_site(value: CookieSameSite): String\n\tcase value\n\twhen CookieSameSite::Lax\n\t\treturn \"Lax\"\n\twhen CookieSameSite::Strict\n\t\treturn \"Strict\"\n\twhen CookieSameSite::None\n\t\treturn \"None\"\n\tend\nend\n\ninterface Next\n\tcall(context: Context): Response\nend\n"
	end
	return ""
end

def official_source_supported(kind: Integer): Boolean
	if kind == 100
		return true
	end
	if kind == 101
		return false
	end
	if kind == 102
		return true
	end
	if kind == 103
		return false
	end
	if kind == 104
		return false
	end
	if kind == 105
		return false
	end
	if kind == 106
		return false
	end
	if kind == 107
		return false
	end
	if kind == 108
		return true
	end
	if kind == 109
		return true
	end
	if kind == 110
		return true
	end
	if kind == 111
		return true
	end
	if kind == 112
		return true
	end
	if kind == 113
		return true
	end
	if kind == 114
		return true
	end
	if kind == 115
		return true
	end
	if kind == 116
		return false
	end
	if kind == 117
		return false
	end
	return false
end

def pinned_url_source(): String
	return "import trb/std/result\nimport trb/internal/url as native_url\n\nmodule URL\n\tenum DecodeErrorKind\n\t\tInvalidEscape\n\t\tInvalidUtf8\n\tend\n\n\trecord DecodeError\n\t\tkind: URL::DecodeErrorKind\n\t\tinput: String\n\t\tmessage: String\n\tend\n\n\trecord QueryParameter\n\t\tname: String\n\t\tvalue: String\n\tend\nend\n\ndef encode_component(value: String): String\n\treturn native_url.encode_component(value)\nend\n\ndef decode_component(value: String): Result<String, URL::DecodeError>\n\treturn native_url.decode_component(value)\nend\n\ndef _decode_query_component(value: String): Result<String, URL::DecodeError>\n\tcase decode_component(value.split(\"+\").join(\" \"))\n\twhen Result::Ok(decoded)\n\t\treturn Result<String, URL::DecodeError>::Ok(decoded)\n\twhen Result::Err(error)\n\t\tcase error.kind\n\t\twhen URL::DecodeErrorKind::InvalidEscape\n\t\t\tquery_error := URL::DecodeError.new(\n\t\t\t\tkind: error.kind,\n\t\t\t\tinput: value,\n\t\t\t\tmessage: \"invalid percent escape in URL query component\",\n\t\t\t)\n\t\t\treturn Result<String, URL::DecodeError>::Err(query_error)\n\t\twhen URL::DecodeErrorKind::InvalidUtf8\n\t\t\tquery_error := URL::DecodeError.new(\n\t\t\t\tkind: error.kind,\n\t\t\t\tinput: value,\n\t\t\t\tmessage: \"decoded URL query component is not valid UTF-8\",\n\t\t\t)\n\t\t\treturn Result<String, URL::DecodeError>::Err(query_error)\n\t\tend\n\tend\nend\n\ndef _encode_query_component(value: String): String\n\tencoded := encode_component(value)\n\treturn encoded.split(\"%20\").join(\"+\").split(\"%2A\").join(\"*\").split(\"~\").join(\"%7E\")\nend\n\ndef _parse_query_parameter(value: String): Result<URL::QueryParameter, URL::DecodeError>\n\tparts := value.split(\"=\")\n\tname_part := parts.first()\n\tmut value_parts := parts.dup()\n\tvalue_parts.shift()\n\tvalue_part := value_parts.join(\"=\")\n\tcase _decode_query_component(name_part)\n\twhen Result::Err(error)\n\t\treturn Result<URL::QueryParameter, URL::DecodeError>::Err(error)\n\twhen Result::Ok(name)\n\t\tcase _decode_query_component(value_part)\n\t\twhen Result::Err(error)\n\t\t\treturn Result<URL::QueryParameter, URL::DecodeError>::Err(error)\n\t\twhen Result::Ok(parameter_value)\n\t\t\tparameter := URL::QueryParameter.new(name: name, value: parameter_value)\n\t\t\treturn Result<URL::QueryParameter, URL::DecodeError>::Ok(parameter)\n\t\tend\n\tend\nend\n\ndef parse_query(value: String): Result<Array<URL::QueryParameter>, URL::DecodeError>\n\tmut parameters: Array<URL::QueryParameter> := []\n\tvalue.split(\"&\").each do |part|\n\t\tif part == \"\"\n\t\t\tnext\n\t\tend\n\t\tcase _parse_query_parameter(part)\n\t\twhen Result::Ok(parameter)\n\t\t\tparameters.push(parameter)\n\t\twhen Result::Err(error)\n\t\t\treturn Result<Array<URL::QueryParameter>, URL::DecodeError>::Err(error)\n\t\tend\n\tend\n\treturn Result<Array<URL::QueryParameter>, URL::DecodeError>::Ok(parameters)\nend\n\ndef build_query(parameters: Array<URL::QueryParameter>): String\n\tmut parts: Array<String> := []\n\tparameters.each do |parameter|\n\t\tname := _encode_query_component(parameter.name)\n\t\tvalue := _encode_query_component(parameter.value)\n\t\tparts.push(name + \"=\" + value)\n\tend\n\treturn parts.join(\"&\")\nend\n"
end

def native_url_source(): String
	return "import { Result } from trb/std/result\nimport trb/std/url as PublicURL\n\nmodule URL\nend\n\ndef _octet(value: Integer): String\n\tif value < 128\n\t\treturn \"\\x00\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x0a\\x0b\\x0c\\x0d\\x0e\\x0f\\x10\\x11\\x12\\x13\\x14\\x15\\x16\\x17\\x18\\x19\\x1a\\x1b\\x1c\\x1d\\x1e\\x1f\\x20\\x21\\x22\\x23\\x24\\x25\\x26\\x27\\x28\\x29\\x2a\\x2b\\x2c\\x2d\\x2e\\x2f\\x30\\x31\\x32\\x33\\x34\\x35\\x36\\x37\\x38\\x39\\x3a\\x3b\\x3c\\x3d\\x3e\\x3f\\x40\\x41\\x42\\x43\\x44\\x45\\x46\\x47\\x48\\x49\\x4a\\x4b\\x4c\\x4d\\x4e\\x4f\\x50\\x51\\x52\\x53\\x54\\x55\\x56\\x57\\x58\\x59\\x5a\\x5b\\x5c\\x5d\\x5e\\x5f\\x60\\x61\\x62\\x63\\x64\\x65\\x66\\x67\\x68\\x69\\x6a\\x6b\\x6c\\x6d\\x6e\\x6f\\x70\\x71\\x72\\x73\\x74\\x75\\x76\\x77\\x78\\x79\\x7a\\x7b\\x7c\\x7d\\x7e\\x7f\"[value]\n\tend\n\treturn [\"\\x80\", \"\\x81\", \"\\x82\", \"\\x83\", \"\\x84\", \"\\x85\", \"\\x86\", \"\\x87\", \"\\x88\", \"\\x89\", \"\\x8a\", \"\\x8b\", \"\\x8c\", \"\\x8d\", \"\\x8e\", \"\\x8f\", \"\\x90\", \"\\x91\", \"\\x92\", \"\\x93\", \"\\x94\", \"\\x95\", \"\\x96\", \"\\x97\", \"\\x98\", \"\\x99\", \"\\x9a\", \"\\x9b\", \"\\x9c\", \"\\x9d\", \"\\x9e\", \"\\x9f\", \"\\xa0\", \"\\xa1\", \"\\xa2\", \"\\xa3\", \"\\xa4\", \"\\xa5\", \"\\xa6\", \"\\xa7\", \"\\xa8\", \"\\xa9\", \"\\xaa\", \"\\xab\", \"\\xac\", \"\\xad\", \"\\xae\", \"\\xaf\", \"\\xb0\", \"\\xb1\", \"\\xb2\", \"\\xb3\", \"\\xb4\", \"\\xb5\", \"\\xb6\", \"\\xb7\", \"\\xb8\", \"\\xb9\", \"\\xba\", \"\\xbb\", \"\\xbc\", \"\\xbd\", \"\\xbe\", \"\\xbf\", \"\\xc0\", \"\\xc1\", \"\\xc2\", \"\\xc3\", \"\\xc4\", \"\\xc5\", \"\\xc6\", \"\\xc7\", \"\\xc8\", \"\\xc9\", \"\\xca\", \"\\xcb\", \"\\xcc\", \"\\xcd\", \"\\xce\", \"\\xcf\", \"\\xd0\", \"\\xd1\", \"\\xd2\", \"\\xd3\", \"\\xd4\", \"\\xd5\", \"\\xd6\", \"\\xd7\", \"\\xd8\", \"\\xd9\", \"\\xda\", \"\\xdb\", \"\\xdc\", \"\\xdd\", \"\\xde\", \"\\xdf\", \"\\xe0\", \"\\xe1\", \"\\xe2\", \"\\xe3\", \"\\xe4\", \"\\xe5\", \"\\xe6\", \"\\xe7\", \"\\xe8\", \"\\xe9\", \"\\xea\", \"\\xeb\", \"\\xec\", \"\\xed\", \"\\xee\", \"\\xef\", \"\\xf0\", \"\\xf1\", \"\\xf2\", \"\\xf3\", \"\\xf4\", \"\\xf5\", \"\\xf6\", \"\\xf7\", \"\\xf8\", \"\\xf9\", \"\\xfa\", \"\\xfb\", \"\\xfc\", \"\\xfd\", \"\\xfe\", \"\\xff\"][value - 128]\nend\n\ndef _hex(value: String): Integer\n\tmut index := 0\n\twhile index < 16\n\t\tif \"0123456789ABCDEF\"[index] == value || \"0123456789abcdef\"[index] == value\n\t\t\treturn index\n\t\tend\n\t\tindex += 1\n\tend\n\treturn -1\nend\n\ndef encode_component(value: String): String\n\tbytes := value.to_bytes()\n\tmut encoded := \"\"\n\tmut index := 0\n\twhile index < bytes.size()\n\t\toctet := bytes.at(index)\n\t\tif (octet >= 65 && octet <= 90) || (octet >= 97 && octet <= 122) || (octet >= 48 && octet <= 57) || octet == 45 || octet == 46 || octet == 95 || octet == 126\n\t\t\tencoded += _octet(octet)\n\t\telse\n\t\t\tencoded += \"%\" + \"0123456789ABCDEF\"[octet / 16] + \"0123456789ABCDEF\"[octet % 16]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn encoded\nend\n\ndef _invalid_escape(value: String): Result<String, PublicURL::DecodeError>\n\treturn Result<String, PublicURL::DecodeError>::Err(PublicURL::DecodeError.new(\n\t\t\tkind: PublicURL::DecodeErrorKind::InvalidEscape,\n\t\t\tinput: value,\n\t\t\tmessage: \"invalid percent escape in URL component\",\n\t\t))\nend\n\ndef decode_component(value: String): Result<String, PublicURL::DecodeError>\n\tmut decoded := \"\"\n\tmut index := 0\n\twhile index < value.size()\n\t\tcharacter := value[index]\n\t\tif character != \"%\"\n\t\t\tdecoded += character\n\t\t\tindex += 1\n\t\telse\n\t\t\tif index + 2 >= value.size()\n\t\t\t\treturn _invalid_escape(value)\n\t\t\tend\n\t\t\thigh := _hex(value[index + 1])\n\t\t\tlow := _hex(value[index + 2])\n\t\t\tif high < 0 || low < 0\n\t\t\t\treturn _invalid_escape(value)\n\t\t\tend\n\t\t\tdecoded += _octet(high * 16 + low)\n\t\t\tindex += 3\n\t\tend\n\tend\n\tbytes := decoded.to_bytes()\n\tif !bytes.valid_utf8?()\n\t\treturn Result<String, PublicURL::DecodeError>::Err(PublicURL::DecodeError.new(\n\t\t\t\tkind: PublicURL::DecodeErrorKind::InvalidUtf8,\n\t\t\t\tinput: value,\n\t\t\t\tmessage: \"decoded URL component is not valid UTF-8\",\n\t\t\t))\n\tend\n\treturn Result<String, PublicURL::DecodeError>::Ok(bytes.to_s())\nend\n"
end
