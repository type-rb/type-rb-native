def native_secure_random_source(): String
	return "import trb/internal/entropy as Entropy\nimport trb/internal/runtime as Runtime\n\nmodule SecureRandom\nend\n\n# The public bound is checked TypeRB behavior. The private host bridge only\n# transfers OS entropy; it never substitutes a deterministic or weak generator.\ndef bytes(value: Integer): Bytes\n\tlength := value\n\tif length < 0 || length > 65536\n\t\treturn Runtime.fail<Bytes>(\"secure_random.bytes length must be between 0 and 65536\")\n\tend\n\tdata := Entropy.read(length).to_bytes()\n\tif data.size() != length\n\t\treturn Runtime.fail<Bytes>(\"secure_random.bytes could not read operating system entropy\")\n\tend\n\treturn data\nend\n"
end

def native_entropy_source(): String
	return "# Only the loader-owned SecureRandom wrapper can import this declaration.\nmodule Entropy\nend\n\ndef read(length: Integer): String\nend\n"
end
