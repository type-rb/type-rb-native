dy.new(compressed_body),\n\t)\nend\n\ndef _compressible?(context: Context, response: Response, options: CompressionOptions): Boolean\n\tif context.request.method.to_s() == \"HEAD\"\n\t\treturn false\n\tend\n\tif response.status < 200 || response.status == 204 || response.status == 206 || response.status == 304\n\t\treturn false\n\tend\n\tif response.body.size() < options.minimum_size_bytes || response.body.empty?()\n\t\treturn false\n\tend\n\tif response.headers.key?(\"content-encoding\") || response.headers.key?(\"content-range\")\n\t\treturn false\n\tend\n\tif _cache_control_prevents_transform?(response)\n\t\treturn false\n\tend\n\treturn _compressible_content_type?(response)\nend\n\ndef _cache_control_prevents_transform?(response: Response): Boolean\n\tresponse.header_values(\"cache-control\").each do |header|\n\t\theader.split(\",\").each do |directive|\n\t\t\tif directive.strip().downcase() == \"no-transform\"\n\t\t\t\treturn true\n\t\t\tend\n\t\tend\n\tend\n\treturn false\nend\n\ndef _compressible_content_type?(response: Response): Boolean\n\tvalues := response.header_values(\"content-type\")\n\tif values.size() != 1\n\t\treturn false\n\tend\n\tmedia_type := values[0].split(\";\")[0].strip().downcase()\n\tif media_type.start_with?(\"text/\") || media_type.end_with?(\"+json\") || media_type.end_with?(\"+xml\")\n\t\treturn true\n\tend\n\treturn [\n\t\t\"application/json\",\n\t\t\"application/javascript\",\n\t\t\"application/xml\",\n\t\t\"image/svg+xml\",\n\t\t\"application/wasm\",\n\t\t\"font/otf\",\n\t\t\"font/ttf\",\n\t].include?(media_type)\nend\n\ndef _accepts_gzip?(context: Context): Boolean\n\tmut wildcard_found := false\n\tmut wildcard_allowed := false\n\tcontext.request.header_values(\"accept-encoding\").each do |header|\n\t\theader.split(\",\").each do |item|\n\t\t\tparts := item.split(\";\")\n\t\t\tcoding := parts[0].strip().downcase()\n\t\t\tallowed := _quality_allows?(parts)\n\t\t\tif coding == \"gzip\"\n\t\t\t\treturn allowed\n\t\t\tend\n\t\t\tif coding == \"*\"\n\t\t\t\twildcard_found = true\n\t\t\t\twildcard_allowed = allowed\n\t\t\tend\n\t\tend\n\tend\n\treturn wildcard_found && wildcard_allowed\nend\n\ndef _quality_allows?(parts: Array<String>): Boolean\n\tmut index := 1\n\twhile index < parts.size()\n\t\tparameter := parts[index].split(\"=\")\n\t\tif parameter.size() == 2 && parameter[0].strip().downcase() == \"q\"\n\t\t\tcase parameter[1].strip().try_to_f()\n\t\t\twhen Result::Ok(value)\n\t\t\t\treturn value > 0.0 && value <= 1.0\n\t\t\twhen Result::Err(_error)\n\t\t\t\treturn false\n\t\t\tend\n\t\tend\n\t\tindex += 1\n\tend\n\treturn true\nend\n"
