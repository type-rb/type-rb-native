	if kind == 117
		return "import trb/std/result\nimport trb/std/json\nimport trb/std/url\nimport { Body, Header, Headers, HeaderValueError, HttpMethod } from trb/http\nimport trb/internal/runtime\n\nrecord RequestCookie\n\tname: String\n\tvalue: String\nend\n\nenum QueryValueError\n\tMalformed(error: URL::DecodeError)\n\tMissing(name: String)\n\tDuplicate(name: String)\nend\n\nenum CookieValueError\n\tMissing(name: String)\n\tDuplicate(name: String)\nend\n\nenum RequestError\n\tMissingContentType\n\tDuplicateContentType\n\tUnsupportedContentType(value: String)\n\tInvalidUtf8\n\tInvalidJson(error: JSON::Error)\nend\n\nenum ParameterSource\n\tPath\n\tQuery\nend\n\nenum ParameterError\n\tMalformedQuery(error: URL::DecodeError)\n\tMissing(*, source: ParameterSource, name: String)\n\tDuplicate(*, source: ParameterSource, name: String)\n\tInvalid(*, source: ParameterSource, name: String, value: String, expected: String)\nend\n\nenum EndpointInputError\n\tParams(error: ParameterError)\n\tQuery(error: ParameterError)\n\tBody(error: RequestError)\nend\n\nrecord ContextValueError\n\tkey: String\nend\n\nclass ContextKey<T>\n\treadonly @name: String\n\n\tdef initialize(name: String)\n\t\t@name = name\n\t\treturn\n\tend\nend\n\nclass Request\n\treadonly @method: HttpMethod\n\treadonly @path: String\n\treadonly @query_string: String\n\treadonly @headers: Headers\n\treadonly @body: Body\n\n\tdef initialize(*, method: HttpMethod, path: String, query_string: String, headers: Headers, body: Body)\n\t\t@method = method\n\t\t@path = path\n\t\t@query_string = query_string\n\t\t@headers = headers\n\t\t@body = body\n\t\treturn\n\tend\n\n\tdef query_parameters(): Result<Array<URL::QueryParameter>, URL::DecodeError>\n\t\treturn URL.parse_query(@query_string)\n\tend\n\n\tdef query_values(name: String): Result<Array<String>, URL::DecodeError>\n\t\tcase query_parameters()\n\t\twhen Result::Ok(parameters)\n\t\t\tmut values: Array<String> := []\n\t\t\tparameters.each do |parameter|\n\t\t\t\tif parameter.name == name\n\t\t\t\t\tvalues.push(parameter.value)\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn Result<Array<String>, URL::DecodeError>::Ok(values)\n\t\twhen Result::Err(error)\n\t\t\treturn Result<Array<String>, URL::DecodeError>::Err(error)\n\t\tend\n\tend\n\n\tdef query_value(name: String): Result<String, QueryValueError>\n\t\tcase query_values(name)\n\t\twhen Result::Ok(values)\n\t\t\tif values.empty?()\n\t\t\t\treturn Result<String, QueryValueError>::Err(QueryValueError::Missing(name))\n\t\t\tend\n\t\t\tif values.size() > 1\n\t\t\t\treturn Result<String, QueryValueError>::Err(QueryValueError::Duplicate(name))\n\t\t\tend\n\t\t\treturn Result<String, QueryValueError>::Ok(values[0])\n\t\twhen Result::Err(error)\n\t\t\treturn Result<String, QueryValueError>::Err(QueryValueError::Malformed(error))\n\t\tend\n\tend\n\n\tdef header_values(name: String): Array<String>\n\t\treturn @headers.values(name)\n\tend\n\n\tdef header_value(name: String): Result<String, HeaderValueError>\n\t\treturn @headers.value(name)\n\tend\n\n\tdef cookies(): Array<RequestCookie>\n\t\tmut result: Array<RequestCookie> := []\n\t\theader_values(\"cookie\").each do |header|\n\t\t\theader.split(\";\").each do |part|\n\t\t\t\tpair := part.strip()\n\t\t\t\tif pair == \"\"\n\t\t\t\t\tnext\n\t\t\t\tend\n\t\t\t\tparts := pair.split(\"=\")\n\t\t\t\tif parts.size() < 2\n\t\t\t\t\tnext\n\t\t\t\tend\n\t\t\t\tname := parts.first().strip()\n\t\t\t\tif name == \"\"\n\t\t\t\t\tnext\n\t\t\t\tend\n\t\t\t\tmut value_parts := parts.dup()\n\t\t\t\tvalue_parts.shift()\n\t\t\t\tvalue := value_parts.join(\"=\").strip()\n\t\t\t\tresult.push(RequestCookie.new(name: name, value: value))\n\t\t\tend\n\t\tend\n\t\treturn result\n\tend\n\n\tdef cookie_values(name: String): Array<String>\n\t\tmut values: Array<String> := []\n\t\tcookies().each do |candidate|\n\t\t\tif candidate.name == name\n\t\t\t\tvalues.push(candidate.value)\n\t\t\tend\n\t\tend\n\t\treturn values\n\tend\n\n\tdef cookie_value(name: String): Result<String, CookieValueError>\n\t\tvalues := cookie_values(name)\n\t\tif values.empty?()\n\t\t\treturn Result<String, CookieValueError>::Err(CookieValueError::Missing(name))\n\t\tend\n\t\tif values.size() > 1\n\t\t\treturn Result<String, CookieValueError>::Err(CookieValueError::Duplicate(name))\n\t\tend\n\t\treturn Result<String, CookieValueError>::Ok(values[0])\n\tend\n\n\tdef text(): Result<String, RequestError>\n\t\tvalue := @body.bytes()\n\t\tif !value.valid_utf8?()\n\t\t\treturn Result<String, RequestError>::Err(RequestError::InvalidUtf8)\n\t\tend\n\t\treturn Result<String, RequestError>::Ok(value.to_s())\n\tend\n\n\tdef bytes(): Bytes\n\t\treturn @body.bytes()\n\tend\n\n\tdef with_header(name: String, value: String): Request\n\t\treturn Request.new(method: @method, path: @path, query_string: @query_string, headers: @headers.with(name, value), body: @body)\n\tend\n\n\tdef add_header(name: String, value: String): Request\n\t\treturn Request.new(method: @method, path: @path, query_string: @query_string, headers: @headers.add(name, value), body: @body)\n\tend\n\n\tdef without_header(name: String): Request\n\t\treturn Request.new(method: @method, path: @path, query_string: @query_string, headers: @headers.without(name), body: @body)\n\tend\nend\n\nmodule Web\n\trecord ServerConfig\n\t\thost: String = \"0.0.0.0\"\n\t\tport: Integer = 3000\n\t\tbody_limit_bytes: Integer = 1048576\n\t\tshutdown_timeout_milliseconds: Integer = 10000\n\tend\nend\n\nenum CookieSameSite\n\tLax\n\tStrict\n\tNone\nend\n\nenum ResponseCookieAttribute\n\tDomain(value: String)\n\tPath(value: String)\n\tMaxAge(seconds: Integer)\n\tSecure\n\tHttpOnly\n\tSameSite(value: CookieSameSite)\nend\n\nrecord ResponseCookie\n\tname: String\n\tvalue: String\n\tattributes: Array<ResponseCookieAttribute> = []\nend\n\nclass Context\n\treadonly @request: Request\n\treadonly @_path_parameters: Hash<String, String>\n\treadonly @_trb_context_state: Any? := nil\n\n\tdef initialize(*, request: Request, path_parameters: Hash<String, String>)\n\t\t@request = request\n\t\t@_path_parameters = path_parameters\n\t\treturn\n\tend\n\n\tdef path_value(name: String): String\n\t\treturn @_path_parameters[name]\n\tend\n\n\tdef with_request(request: Request): Context\n\t\treturn Context.new(request: request, path_parameters: @_path_parameters)\n\tend\nend\n\nclass Response\n\treadonly @status: Integer\n\treadonly @headers: Headers\n\treadonly @body: Body\n\n\tdef initialize(*, status: Integer, headers: Headers, body: Body)\n\t\t@status = status\n\t\t@headers = headers\n\t\t@body = body\n\t\treturn\n\tend\n\n\tdef self.text(value: String, status: Integer = 200): Response\n\t\treturn Response.new(\n\t\t\tstatus: status,\n\t\t\theaders: Headers.new([Header.new(name: \"content-type\", value: \"text/plain; charset=utf-8\")]),\n\t\t\tbody: Body.new(value.to_bytes()),\n\t\t)\n\tend\n\n\tdef self.bytes(value: Bytes, status: Integer = 200): Response\n\t\treturn Response.new(\n\t\t\tstatus: status,\n\t\t\theaders: Headers.new([Header.new(name: \"content-type\", value: \"application/octet-stream\")]),\n\t\t\tbody: Body.new(value),\n\t\t)\n\tend\n\n\tdef self.empty(status: Integer = 204): Response\n\t\treturn Response.new(status: status, headers: Headers.new(), body: Body.empty())\n\tend\n\n\tdef self.redirect(location: String, status: Integer = 302): Response\n\t\treturn Response.empty(status).with_header(\"location\", location)\n\tend\n\n\tdef with_status(status: Integer): Response\n\t\treturn Response.new(status: status, headers: @headers, body: @body)\n\tend\n\n\tdef with_header(name: String, value: String): Response\n\t\treturn Response.new(status: @status, headers: @headers.with(name, value), body: @body)\n\tend\n\n\tdef add_header(name: String, value: String): Response\n\t\treturn Response.new(status: @status, headers: @headers.add(name, value), body: @body)\n\tend\n\n\tdef without_header(name: String): Response\n\t\treturn Response.new(status: @status, headers: @headers.without(name), body: @body)\n\tend\n\n\tdef header_values(name: String): Array<String>\n\t\treturn @headers.values(name)\n\tend\n\n\tdef header_value(name: String): Result<String, HeaderValueError>\n\t\treturn @headers.value(name)\n\tend\n\n\tdef vary(field: String): Response\n\t\tnormalized_field := field.strip().downcase()\n\t\tif normalized_field == \"\"\n\t\t\treturn self\n\t\tend\n\t\theader_values(\"vary\").each do |value|\n\t\t\tvalue.split(\",\").each do |existing_field|\n\t\t\t\tnormalized_existing := existing_field.strip().downcase()\n\t\t\t\tif normalized_existing == \"*\" || normalized_existing == normalized_field\n\t\t\t\t\treturn self\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif normalized_field == \"*\"\n\t\t\treturn with_header(\"vary\", \"*\")\n\t\tend\n\t\treturn add_header(\"vary\", field.strip())\n\tend\n\n\tdef set_cookie(cookie_value: ResponseCookie): Response\n\t\tif !_valid_response_cookie?(cookie_value)\n\t\t\treturn Runtime.fail<Response>(\"trb/web response cookie is invalid\")\n\t\tend\n\t\tprefix := cookie_value.name + \"=\"\n\t\theader_values(\"set-cookie\").each do |existing_value|\n\t\t\tif existing_value.start_with?(prefix)\n\t\t\t\treturn Runtime.fail<Response>(\"trb/web response contains duplicate cookie name\")\n\t\t\tend\n\t\tend\n\t\tmut parts := [cookie_value.name + \"=\" + cookie_value.value]\n\t\tcookie_value.attributes.each do |attribute|\n\t\t\tparts.push(_response_cookie_attribute(attribute))\n\t\tend\n\t\treturn add_header(\"set-cookie\", parts.join(\"; \"))\n\tend\nend\n\nclass Endpoint\nend\n\ndef handles(handler: (Context) -> Response)\n\treturn\nend\n\ndef input<T>()\n\treturn\nend\n\ndef response<T>(*, status: Integer)\n\treturn\nend\n\ndef _valid_response_cookie?(cookie_value: ResponseCookie): Boolean\n\tif !_valid_cookie_name?(cookie_value.name) || !_valid_cookie_value?(cookie_value.value)\n\t\treturn false\n\tend\n\tmut seen: Hash<String, Boolean> := {}\n\tmut secure := false\n\tmut has_domain := false\n\tmut has_path := false\n\tmut path := \"\"\n\tmut same_site_none := false\n\tcookie_value.attributes.each do |attribute|\n\t\tname := _response_cookie_attribute_name(attribute)\n\t\tif seen.key?(name)\n\t\t\treturn false\n\t\tend\n\t\tseen[name] = true\n\t\tcase attribute\n\t\twhen ResponseCookieAttribute::Domain(value)\n\t\t\tif !_valid_cookie_domain?(value)\n\t\t\t\treturn false\n\t\t\tend\n\t\t\thas_domain = true\n\t\twhen ResponseCookieAttribute::Path(value)\n\t\t\tif !_valid_cookie_path?(value)\n\t\t\t\treturn false\n\t\t\tend\n\t\t\thas_path = true\n\t\t\tpath = value\n\t\twhen ResponseCookieAttribute::MaxAge(seconds)\n\t\t\tif seconds < 0\n\t\t\t\treturn false\n\t\t\tend\n\t\twhen ResponseCookieAttribute::Secure\n\t\t\tsecure = true\n\t\twhen ResponseCookieAttribute::HttpOnly\n\t\twhen ResponseCookieAttribute::SameSite(value)\n\t\t\tif value == CookieSameSite::None\n\t\t\t\tsame_site_none = true\n\t\t\tend\n\t\tend\n\tend\n\tif same_site_none && !secure\n\t\treturn false\n\tend\n\tnormalized_name := cookie_value.name.downcase()\n\tif normalized_name.start_with?(\"__secure-\") && !secure\n\t\treturn false\n\tend\n\tif normalized_name.start_with?(\"__host-\")\n\t\tif !secure || has_domain || !has_path || path != \"/\"\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_name?(value: String): Boolean\n\tif value == \"\"\n\t\treturn false\n\tend\n\tvalue.codepoints().each do |codepoint|\n\t\tletter := codepoint >= 65 && codepoint <= 90 || codepoint >= 97 && codepoint <= 122\n\t\tdigit := codepoint >= 48 && codepoint <= 57\n\t\tsymbol := codepoint == 33 || codepoint >= 35 && codepoint <= 39 || codepoint == 42 || codepoint == 43 || codepoint == 45 || codepoint == 46 || codepoint == 94 || codepoint == 95 || codepoint == 96 || codepoint == 124 || codepoint == 126\n\t\tif !letter && !digit && !symbol\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_value?(value: String): Boolean\n\tvalue.codepoints().each do |codepoint|\n\t\tallowed := codepoint == 33 || codepoint >= 35 && codepoint <= 43 || codepoint >= 45 && codepoint <= 58 || codepoint >= 60 && codepoint <= 91 || codepoint >= 93 && codepoint <= 126\n\t\tif !allowed\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_domain?(value: String): Boolean\n\tif value == \"\" || value.size() > 253 || value.start_with?(\".\") || value.end_with?(\".\")\n\t\treturn false\n\tend\n\tvalue.split(\".\").each do |label|\n\t\tcodepoints := label.codepoints()\n\t\tif codepoints.empty?() || codepoints.size() > 63 || codepoints[0] == 45 || codepoints[codepoints.size() - 1] == 45\n\t\t\treturn false\n\t\tend\n\t\tcodepoints.each do |codepoint|\n\t\t\tletter := codepoint >= 65 && codepoint <= 90 || codepoint >= 97 && codepoint <= 122\n\t\t\tdigit := codepoint >= 48 && codepoint <= 57\n\t\t\tif !letter && !digit && codepoint != 45\n\t\t\t\treturn false\n\t\t\tend\n\t\tend\n\tend\n\treturn true\nend\n\ndef _valid_cookie_path?(value: String): Boolean\n\tif !value.start_with?(\"/\")\n\t\treturn false\n\tend\n\tvalue.codepoints().each do |codepoint|\n\t\tif !(codepoint >= 32 && codepoint <= 58 || codepoint >= 60 && codepoint <= 126)\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\ndef _response_cookie_attribute_name(attribute: ResponseCookieAttribute): String\n\tcase attribute\n\twhen ResponseCookieAttribute::Domain(_value)\n\t\treturn \"domain\"\n\twhen ResponseCookieAttribute::Path(_value)\n\t\treturn \"path\"\n\twhen ResponseCookieAttribute::MaxAge(_seconds)\n\t\treturn \"max-age\"\n\twhen ResponseCookieAttribute::Secure\n\t\treturn \"secure\"\n\twhen ResponseCookieAttribute::HttpOnly\n\t\treturn \"httponly\"\n\twhen ResponseCookieAttribute::SameSite(_value)\n\t\treturn \"samesite\"\n\tend\nend\n\ndef _response_cookie_attribute(attribute: ResponseCookieAttribute): String\n\tcase attribute\n\twhen ResponseCookieAttribute::Domain(value)\n\t\treturn \"Domain=\" + value\n\twhen ResponseCookieAttribute::Path(value)\n\t\treturn \"Path=\" + value\n\twhen ResponseCookieAttribute::MaxAge(seconds)\n\t\treturn \"Max-Age=\" + seconds.to_s()\n\twhen ResponseCookieAttribute::Secure\n\t\treturn \"Secure\"\n\twhen ResponseCookieAttribute::HttpOnly\n\t\treturn \"HttpOnly\"\n\twhen ResponseCookieAttribute::SameSite(value)\n\t\treturn \"SameSite=\" + _cookie_same_site(value)\n\tend\nend\n\ndef _cookie_same_site(value: CookieSameSite): String\n\tcase value\n\twhen CookieSameSite::Lax\n\t\treturn \"Lax\"\n\twhen CookieSameSite::Strict\n\t\treturn \"Strict\"\n\twhen CookieSameSite::None\n\t\treturn \"None\"\n\tend\nend\n\ninterface Next\n\tcall(context: Context): Response\nend\n"
	end
	return ""
end

def official_source_supported(kind: Integer): Boolean
	if kind == 100
		return true
	end
	if kind == 101
		return false
	end
	if kind == 102
		return true
	end
	if kind == 103
		return false
	end
	if kind == 104
		return false
	end
	if kind == 105
		return false
	end
	if kind == 106
		return false
	end
	if kind == 107
		return false
	end
	if kind == 108
		return true
	end
	if kind == 109
		return true
	end
	if kind == 110
		return true
	end
	if kind == 111
		return true
	end
	if kind == 112
		return true
	end
	if kind == 113
		return true
	end
	if kind == 114
		return true
	end
	if kind == 115
		return true
	end
	if kind == 116
		return false
	end
	if kind == 117
		return true
	end
	return false
end

def pinned_url_source(): String
	return "import trb/std/result\nimport trb/internal/url as native_url\n\nmodule URL\n\tenum DecodeErrorKind\n\t\tInvalidEscape\n\t\tInvalidUtf8\n\tend\n\n\trecord DecodeError\n\t\tkind: URL::DecodeErrorKind\n\t\tinput: String\n\t\tmessage: String\n\tend\n\n\trecord QueryParameter\n\t\tname: String\n\t\tvalue: String\n\tend\nend\n\ndef encode_component(value: String): String\n\treturn native_url.encode_component(value)\nend\n\ndef decode_component(value: String): Result<String, URL::DecodeError>\n\treturn native_url.decode_component(value)\nend\n\ndef _decode_query_component(value: String): Result<String, URL::DecodeError>\n\tcase decode_component(value.split(\"+\").join(\" \"))\n\twhen Result::Ok(decoded)\n\t\treturn Result<String, URL::DecodeError>::Ok(decoded)\n\twhen Result::Err(error)\n\t\tcase error.kind\n\t\twhen URL::DecodeErrorKind::InvalidEscape\n\t\t\tquery_error := URL::DecodeError.new(\n\t\t\t\tkind: error.kind,\n\t\t\t\tinput: value,\n\t\t\t\tmessage: \"invalid percent escape in URL query component\",\n\t\t\t)\n\t\t\treturn Result<String, URL::DecodeError>::Err(query_error)\n\t\twhen URL::DecodeErrorKind::InvalidUtf8\n\t\t\tquery_error := URL::DecodeError.new(\n\t\t\t\tkind: error.kind,\n\t\t\t\tinput: value,\n\t\t\t\tmessage: \"decoded URL query component is not valid UTF-8\",\n\t\t\t)\n\t\t\treturn Result<String, URL::DecodeError>::Err(query_error)\n\t\tend\n\tend\nend\n\ndef _encode_query_component(value: String): String\n\tencoded := encode_component(value)\n\treturn encoded.split(\"%20\").join(\"+\").split(\"%2A\").join(\"*\").split(\"~\").join(\"%7E\")\nend\n\ndef _parse_query_parameter(value: String): Result<URL::QueryParameter, URL::DecodeError>\n\tparts := value.split(\"=\")\n\tname_part := parts.first()\n\tmut value_parts := parts.dup()\n\tvalue_parts.shift()\n\tvalue_part := value_parts.join(\"=\")\n\tcase _decode_query_component(name_part)\n\twhen Result::Err(error)\n\t\treturn Result<URL::QueryParameter, URL::DecodeError>::Err(error)\n\twhen Result::Ok(name)\n\t\tcase _decode_query_component(value_part)\n\t\twhen Result::Err(error)\n\t\t\treturn Result<URL::QueryParameter, URL::DecodeError>::Err(error)\n\t\twhen Result::Ok(parameter_value)\n\t\t\tparameter := URL::QueryParameter.new(name: name, value: parameter_value)\n\t\t\treturn Result<URL::QueryParameter, URL::DecodeError>::Ok(parameter)\n\t\tend\n\tend\nend\n\ndef parse_query(value: String): Result<Array<URL::QueryParameter>, URL::DecodeError>\n\tmut parameters: Array<URL::QueryParameter> := []\n\tvalue.split(\"&\").each do |part|\n\t\tif part == \"\"\n\t\t\tnext\n\t\tend\n\t\tcase _parse_query_parameter(part)\n\t\twhen Result::Ok(parameter)\n\t\t\tparameters.push(parameter)\n\t\twhen Result::Err(error)\n\t\t\treturn Result<Array<URL::QueryParameter>, URL::DecodeError>::Err(error)\n\t\tend\n\tend\n\treturn Result<Array<URL::QueryParameter>, URL::DecodeError>::Ok(parameters)\nend\n\ndef build_query(parameters: Array<URL::QueryParameter>): String\n\tmut parts: Array<String> := []\n\tparameters.each do |parameter|\n\t\tname := _encode_query_component(parameter.name)\n\t\tvalue := _encode_query_component(parameter.value)\n\t\tparts.push(name + \"=\" + value)\n\tend\n\treturn parts.join(\"&\")\nend\n"
end

def pinned_json_source(): String
	return "import trb/std/result\nimport trb/internal/json as native_json\n\nmodule JSON\n\tenum ErrorKind\n\t\tSyntax\n\t\tDecode\n\t\tEncode\n\tend\n\n\trecord Error\n\t\tkind: JSON::ErrorKind\n\t\tmessage: String\n\t\tpath: String\n\t\tline: Integer?\n\t\tcolumn: Integer?\n\tend\n\n\tenum Value\n\t\tNull\n\t\tBoolean(value: Boolean)\n\t\tInteger(value: Integer)\n\t\tFloat(value: Float)\n\t\tString(value: String)\n\t\tArray(value: Array<JSON::Value>)\n\t\tObject(value: Hash<String, JSON::Value>)\n\tend\nend\n\ndef parse(source: String): Result<JSON::Value, JSON::Error>\n\treturn native_json.parse(source)\nend\n\ndef stringify(value: JSON::Value): Result<String, JSON::Error>\n\treturn native_json.stringify(value)\nend\n\ndef as_boolean(value: JSON::Value): Result<Boolean, JSON::Error>\n\tcase value\n\twhen JSON::Value::Boolean(result)\n\t\treturn Result<Boolean, JSON::Error>::Ok(result)\n\telse\n\t\treturn Result<Boolean, JSON::Error>::Err(_decode_error(\"\", \"JSON value is not Boolean\"))\n\tend\nend\n\ndef as_integer(value: JSON::Value): Result<Integer, JSON::Error>\n\tcase value\n\twhen JSON::Value::Integer(result)\n\t\treturn Result<Integer, JSON::Error>::Ok(result)\n\telse\n\t\treturn Result<Integer, JSON::Error>::Err(_decode_error(\"\", \"JSON value is not Integer\"))\n\tend\nend\n\ndef as_float(value: JSON::Value): Result<Float, JSON::Error>\n\tcase value\n\twhen JSON::Value::Float(result)\n\t\treturn Result<Float, JSON::Error>::Ok(result)\n\telse\n\t\treturn Result<Float, JSON::Error>::Err(_decode_error(\"\", \"JSON value is not Float\"))\n\tend\nend\n\ndef as_string(value: JSON::Value): Result<String, JSON::Error>\n\tcase value\n\twhen JSON::Value::String(result)\n\t\treturn Result<String, JSON::Error>::Ok(result)\n\telse\n\t\treturn Result<String, JSON::Error>::Err(_decode_error(\"\", \"JSON value is not String\"))\n\tend\nend\n\ndef as_array(value: JSON::Value): Result<Array<JSON::Value>, JSON::Error>\n\tcase value\n\twhen JSON::Value::Array(result)\n\t\treturn Result<Array<JSON::Value>, JSON::Error>::Ok(result)\n\telse\n\t\treturn Result<Array<JSON::Value>, JSON::Error>::Err(_decode_error(\"\", \"JSON value is not Array\"))\n\tend\nend\n\ndef as_object(value: JSON::Value): Result<Hash<String, JSON::Value>, JSON::Error>\n\tcase value\n\twhen JSON::Value::Object(result)\n\t\treturn Result<Hash<String, JSON::Value>, JSON::Error>::Ok(result)\n\telse\n\t\treturn Result<Hash<String, JSON::Value>, JSON::Error>::Err(_decode_error(\"\", \"JSON value is not Object\"))\n\tend\nend\n\ndef field(value: JSON::Value, name: String): Result<JSON::Value, JSON::Error>\n\tcase value\n\twhen JSON::Value::Object(fields)\n\t\tif fields.key?(name)\n\t\t\treturn Result<JSON::Value, JSON::Error>::Ok(fields.fetch(name))\n\t\tend\n\t\treturn Result<JSON::Value, JSON::Error>::Err(_decode_error(\"/\" + name, \"JSON object field is missing\"))\n\telse\n\t\treturn Result<JSON::Value, JSON::Error>::Err(_decode_error(\"\", \"JSON value is not Object\"))\n\tend\nend\n\ndef _decode_error(path: String, message: String): JSON::Error\n\treturn JSON::Error.new(\n\t\tkind: JSON::ErrorKind::Decode,\n\t\tmessage: message,\n\t\tpath: path,\n\t\tline: nil,\n\t\tcolumn: nil\n\t)\nend\n"
end

def pinned_jsonc_source(): String
	return "import trb/std/result\nimport trb/std/json\nimport trb/internal/json as native_json\n\ndef parse(source: String): Result<JSON::Value, JSON::Error>\n\treturn native_json.parse_jsonc(source)\nend\n"
end

def pinned_time_source(): String
	return "import trb/std/result\nimport trb/internal/time as native_time\n\nenum DateTimeErrorKind\n\tInvalidDate\n\tInvalidTime\n\tInvalidDateTime\n\tInvalidInstant\n\tInvalidDuration\n\tInvalidTimeZone\n\tAmbiguousLocalTime\n\tNonexistentLocalTime\nend\n\nrecord DateTimeError\n\tkind: DateTimeErrorKind\n\tinput: String\n\tmessage: String\nend\n\nclass Date\n\treadonly @_year: Integer\n\treadonly @_month: Integer\n\treadonly @_day: Integer\n\n\tdef initialize(year: Integer, month: Integer, day: Integer)\n\t\tnative_time.validate_date(year, month, day)\n\t\t@_year = year\n\t\t@_month = month\n\t\t@_day = day\n\tend\n\n\tdef self.try_new(year: Integer, month: Integer, day: Integer): Result<Date, DateTimeError>\n\t\treturn native_time.date_try_new(year, month, day)\n\tend\n\n\tdef self.parse(value: String): Date\n\t\treturn native_time.date_parse(value)\n\tend\n\n\tdef self.try_parse(value: String): Result<Date, DateTimeError>\n\t\treturn native_time.date_try_parse(value)\n\tend\n\n\tdef year(): Integer\n\t\treturn @_year\n\tend\n\n\tdef month(): Integer\n\t\treturn @_month\n\tend\n\n\tdef day(): Integer\n\t\treturn @_day\n\tend\n\n\tdef to_s(): String\n\t\treturn native_time.date_to_string(self)\n\tend\n\n\tdef add_days(days: Integer): Date\n\t\treturn native_time.date_add_days(self, days)\n\tend\n\n\tdef before?(other: Date): Boolean\n\t\treturn native_time.date_compare(self, other) < 0\n\tend\n\n\tdef after?(other: Date): Boolean\n\t\treturn native_time.date_compare(self, other) > 0\n\tend\n\n\tdef same?(other: Date): Boolean\n\t\treturn native_time.date_compare(self, other) == 0\n\tend\n\n\tdef at(time: TimeOfDay): DateTime\n\t\treturn DateTime.new(\n\t\t\t@_year,\n\t\t\t@_month,\n\t\t\t@_day,\n\t\t\ttime.hour(),\n\t\t\ttime.minute(),\n\t\t\ttime.second(),\n\t\t\ttime.nanosecond()\n\t\t)\n\tend\nend\n\nclass TimeOfDay\n\treadonly @_hour: Integer\n\treadonly @_minute: Integer\n\treadonly @_second: Integer\n\treadonly @_nanosecond: Integer\n\n\tdef initialize(hour: Integer, minute: Integer, second: Integer = 0, nanosecond: Integer = 0)\n\t\tnative_time.validate_time(hour, minute, second, nanosecond)\n\t\t@_hour = hour\n\t\t@_minute = minute\n\t\t@_second = second\n\t\t@_nanosecond = nanosecond\n\tend\n\n\tdef self.midnight(): TimeOfDay\n\t\treturn TimeOfDay.new(0, 0)\n\tend\n\n\tdef self.try_new(hour: Integer, minute: Integer, second: Integer = 0, nanosecond: Integer = 0): Result<TimeOfDay, DateTimeError>\n\t\treturn native_time.time_of_day_try_new(hour, minute, second, nanosecond)\n\tend\n\n\tdef self.parse(value: String): TimeOfDay\n\t\treturn native_time.time_of_day_parse(value)\n\tend\n\n\tdef self.try_parse(value: String): Result<TimeOfDay, DateTimeError>\n\t\treturn native_time.time_of_day_try_parse(value)\n\tend\n\n\tdef hour(): Integer\n\t\treturn @_hour\n\tend\n\n\tdef minute(): Integer\n\t\treturn @_minute\n\tend\n\n\tdef second(): Integer\n\t\treturn @_second\n\tend\n\n\tdef nanosecond(): Integer\n\t\treturn @_nanosecond\n\tend\n\n\tdef to_s(): String\n\t\treturn native_time.time_of_day_to_string(self)\n\tend\n\n\tdef before?(other: TimeOfDay): Boolean\n\t\treturn native_time.time_of_day_compare(self, other) < 0\n\tend\n\n\tdef after?(other: TimeOfDay): Boolean\n\t\treturn native_time.time_of_day_compare(self, other) > 0\n\tend\n\n\tdef same?(other: TimeOfDay): Boolean\n\t\treturn native_time.time_of_day_compare(self, other) == 0\n\tend\nend\n\nclass DateTime\n\treadonly @_year: Integer\n\treadonly @_month: Integer\n\treadonly @_day: Integer\n\treadonly @_hour: Integer\n\treadonly @_minute: Integer\n\treadonly @_second: Integer\n\treadonly @_nanosecond: Integer\n\n\tdef initialize(year: Integer, month: Integer, day: Integer, hour: Integer, minute: Integer, second: Integer = 0, nanosecond: Integer = 0)\n\t\tnative_time.validate_datetime(year, month, day, hour, minute, second, nanosecond)\n\t\t@_year = year\n\t\t@_month = month\n\t\t@_day = day\n\t\t@_hour = hour\n\t\t@_minute = minute\n\t\t@_second = second\n\t\t@_nanosecond = nanosecond\n\tend\n\n\tdef self.try_new(year: Integer, month: Integer, day: Integer, hour: Integer, minute: Integer, second: Integer = 0, nanosecond: Integer = 0): Result<DateTime, DateTimeError>\n\t\treturn native_time.datetime_try_new(year, month, day, hour, minute, second, nanosecond)\n\tend\n\n\tdef self.parse(value: String): DateTime\n\t\treturn native_time.datetime_parse(value)\n\tend\n\n\tdef self.try_parse(value: String): Result<DateTime, DateTimeError>\n\t\treturn native_time.datetime_try_parse(value)\n\tend\n\n\tdef year(): Integer\n\t\treturn @_year\n\tend\n\n\tdef month(): Integer\n\t\treturn @_month\n\tend\n\n\tdef day(): Integer\n\t\treturn @_day\n\tend\n\n\tdef hour(): Integer\n\t\treturn @_hour\n\tend\n\n\tdef minute(): Integer\n\t\treturn @_minute\n\tend\n\n\tdef second(): Integer\n\t\treturn @_second\n\tend\n\n\tdef nanosecond(): Integer\n\t\treturn @_nanosecond\n\tend\n\n\tdef date(): Date\n\t\treturn Date.new(@_year, @_month, @_day)\n\tend\n\n\tdef time_of_day(): TimeOfDay\n\t\treturn TimeOfDay.new(@_hour, @_minute, @_second, @_nanosecond)\n\tend\n\n\tdef to_s(): String\n\t\treturn native_time.datetime_to_string(self)\n\tend\n\n\tdef to_instant(time_zone: TimeZone): Instant\n\t\treturn native_time.datetime_to_instant(self, time_zone)\n\tend\n\n\tdef try_to_instant(time_zone: TimeZone): Result<Instant, DateTimeError>\n\t\treturn native_time.datetime_try_to_instant(self, time_zone)\n\tend\n\n\tdef before?(other: DateTime): Boolean\n\t\treturn native_time.datetime_compare(self, other) < 0\n\tend\n\n\tdef after?(other: DateTime): Boolean\n\t\treturn native_time.datetime_compare(self, other) > 0\n\tend\n\n\tdef same?(other: DateTime): Boolean\n\t\treturn native_time.datetime_compare(self, other) == 0\n\tend\nend\n\nclass Duration\n\treadonly @_seconds: Integer\n\treadonly @_nanosecond: Integer\n\n\tdef initialize(seconds: Integer, nanosecond: Integer = 0)\n\t\tnative_time.validate_duration(seconds, nanosecond)\n\t\t@_seconds = seconds\n\t\t@_nanosecond = nanosecond\n\tend\n\n\tdef self.seconds(value: Integer): Duration\n\t\treturn Duration.new(value)\n\tend\n\n\tdef self.milliseconds(value: Integer): Duration\n\t\treturn native_time.duration_from_milliseconds(value)\n\tend\n\n\tdef self.minutes(value: Integer): Duration\n\t\treturn native_time.duration_from_seconds(value * 60)\n\tend\n\n\tdef self.hours(value: Integer): Duration\n\t\treturn native_time.duration_from_seconds(value * 3600)\n\tend\n\n\tdef self.parse(value: String): Duration\n\t\treturn native_time.duration_parse(value)\n\tend\n\n\tdef self.try_parse(value: String): Result<Duration, DateTimeError>\n\t\treturn native_time.duration_try_parse(value)\n\tend\n\n\tdef whole_seconds(): Integer\n\t\treturn @_seconds\n\tend\n\n\tdef nanosecond(): Integer\n\t\treturn @_nanosecond\n\tend\n\n\tdef total_seconds(): Float\n\t\treturn @_seconds.to_f() + @_nanosecond.to_f() / 1000000000.0\n\tend\n\n\tdef add(other: Duration): Duration\n\t\treturn native_time.duration_add(self, other)\n\tend\n\n\tdef subtract(other: Duration): Duration\n\t\treturn native_time.duration_subtract(self, other)\n\tend\n\n\tdef negative(): Duration\n\t\treturn native_time.duration_negative(self)\n\tend\n\n\tdef to_s(): String\n\t\treturn native_time.duration_to_string(self)\n\tend\n\n\tdef before?(other: Duration): Boolean\n\t\treturn native_time.duration_compare(self, other) < 0\n\tend\n\n\tdef after?(other: Duration): Boolean\n\t\treturn native_time.duration_compare(self, other) > 0\n\tend\n\n\tdef same?(other: Duration): Boolean\n\t\treturn native_time.duration_compare(self, other) == 0\n\tend\nend\n\nclass TimeZone\n\treadonly @_identifier: String\n\n\tdef initialize(identifier: String)\n\t\tnative_time.validate_time_zone(identifier)\n\t\t@_identifier = identifier\n\tend\n\n\tdef self.utc(): TimeZone\n\t\treturn TimeZone.new(\"UTC\")\n\tend\n\n\tdef self.get(identifier: String): TimeZone\n\t\treturn TimeZone.new(identifier)\n\tend\n\n\tdef self.try_get(identifier: String): Result<TimeZone, DateTimeError>\n\t\treturn native_time.time_zone_try_get(identifier)\n\tend\n\n\tdef identifier(): String\n\t\treturn @_identifier\n\tend\n\n\tdef same?(other: TimeZone): Boolean\n\t\treturn @_identifier == other.identifier()\n\tend\nend\n\nclass Instant\n\treadonly @_epoch_seconds: Integer\n\treadonly @_nanosecond: Integer\n\n\tdef initialize(epoch_seconds: Integer, nanosecond: Integer = 0)\n\t\tnative_time.validate_instant(epoch_seconds, nanosecond)\n\t\t@_epoch_seconds = epoch_seconds\n\t\t@_nanosecond = nanosecond\n\tend\n\n\tdef self.now(): Instant\n\t\treturn native_time.instant_now()\n\tend\n\n\tdef self.parse(value: String): Instant\n\t\treturn native_time.instant_parse(value)\n\tend\n\n\tdef self.try_parse(value: String): Result<Instant, DateTimeError>\n\t\treturn native_time.instant_try_parse(value)\n\tend\n\n\tdef epoch_seconds(): Integer\n\t\treturn @_epoch_seconds\n\tend\n\n\tdef nanosecond(): Integer\n\t\treturn @_nanosecond\n\tend\n\n\tdef to_s(): String\n\t\treturn native_time.instant_to_string(self)\n\tend\n\n\tdef to_datetime(time_zone: TimeZone): DateTime\n\t\treturn native_time.instant_to_datetime(self, time_zone)\n\tend\n\n\tdef to_date(time_zone: TimeZone): Date\n\t\treturn to_datetime(time_zone).date()\n\tend\n\n\tdef add(duration: Duration): Instant\n\t\treturn native_time.instant_add(self, duration)\n\tend\n\n\tdef subtract(duration: Duration): Instant\n\t\treturn native_time.instant_subtract(self, duration)\n\tend\n\n\tdef duration_since(other: Instant): Duration\n\t\treturn native_time.instant_duration_since(self, other)\n\tend\n\n\tdef before?(other: Instant): Boolean\n\t\treturn native_time.instant_compare(self, other) < 0\n\tend\n\n\tdef after?(other: Instant): Boolean\n\t\treturn native_time.instant_compare(self, other) > 0\n\tend\n\n\tdef same?(other: Instant): Boolean\n\t\treturn native_time.instant_compare(self, other) == 0\n\tend\nend\n\ndef now(): Instant\n\treturn Instant.now()\nend\n"
end

def pinned_hex_source(): String
	return "import trb/std/result\nimport trb/internal/encoding/hex as native_hex\n\nmodule Hex\n\tenum DecodeErrorKind\n\t\tOddLength\n\t\tInvalidCharacter\n\tend\n\n\trecord DecodeError\n\t\tkind: Hex::DecodeErrorKind\n\t\tinput: String\n\t\tindex: Integer\n\t\tmessage: String\n\tend\nend\n\ndef encode(value: Bytes): String\n\treturn native_hex.encode(value)\nend\n\ndef decode(value: String): Result<Bytes, Hex::DecodeError>\n\treturn native_hex.decode(value)\nend\n"
end

def pinned_base64_source(): String
	return "import trb/std/result\nimport trb/internal/encoding/base64 as native_base64\n\nmodule Base64\n\tenum DecodeErrorKind\n\t\tInvalidLength\n\t\tInvalidCharacter\n\t\tInvalidPadding\n\t\tNonCanonical\n\tend\n\n\trecord DecodeError\n\t\tkind: Base64::DecodeErrorKind\n\t\tinput: String\n\t\tindex: Integer\n\t\tmessage: String\n\tend\nend\n\ndef encode(value: Bytes): String\n\treturn native_base64.encode(value)\nend\n\ndef decode(value: String): Result<Bytes, Base64::DecodeError>\n\treturn native_base64.decode(value)\nend\n\ndef url_encode(value: Bytes): String\n\treturn native_base64.url_encode(value)\nend\n\ndef url_decode(value: String): Result<Bytes, Base64::DecodeError>\n\treturn native_base64.url_decode(value)\nend\n"
end

def native_url_source(): String
	return "import { Result } from trb/std/result\nimport trb/std/url as PublicURL\n\nmodule URL\nend\n\ndef _octet(value: Integer): String\n\tif value < 128\n\t\treturn \"\\x00\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x0a\\x0b\\x0c\\x0d\\x0e\\x0f\\x10\\x11\\x12\\x13\\x14\\x15\\x16\\x17\\x18\\x19\\x1a\\x1b\\x1c\\x1d\\x1e\\x1f\\x20\\x21\\x22\\x23\\x24\\x25\\x26\\x27\\x28\\x29\\x2a\\x2b\\x2c\\x2d\\x2e\\x2f\\x30\\x31\\x32\\x33\\x34\\x35\\x36\\x37\\x38\\x39\\x3a\\x3b\\x3c\\x3d\\x3e\\x3f\\x40\\x41\\x42\\x43\\x44\\x45\\x46\\x47\\x48\\x49\\x4a\\x4b\\x4c\\x4d\\x4e\\x4f\\x50\\x51\\x52\\x53\\x54\\x55\\x56\\x57\\x58\\x59\\x5a\\x5b\\x5c\\x5d\\x5e\\x5f\\x60\\x61\\x62\\x63\\x64\\x65\\x66\\x67\\x68\\x69\\x6a\\x6b\\x6c\\x6d\\x6e\\x6f\\x70\\x71\\x72\\x73\\x74\\x75\\x76\\x77\\x78\\x79\\x7a\\x7b\\x7c\\x7d\\x7e\\x7f\"[value]\n\tend\n\treturn [\"\\x80\", \"\\x81\", \"\\x82\", \"\\x83\", \"\\x84\", \"\\x85\", \"\\x86\", \"\\x87\", \"\\x88\", \"\\x89\", \"\\x8a\", \"\\x8b\", \"\\x8c\", \"\\x8d\", \"\\x8e\", \"\\x8f\", \"\\x90\", \"\\x91\", \"\\x92\", \"\\x93\", \"\\x94\", \"\\x95\", \"\\x96\", \"\\x97\", \"\\x98\", \"\\x99\", \"\\x9a\", \"\\x9b\", \"\\x9c\", \"\\x9d\", \"\\x9e\", \"\\x9f\", \"\\xa0\", \"\\xa1\", \"\\xa2\", \"\\xa3\", \"\\xa4\", \"\\xa5\", \"\\xa6\", \"\\xa7\", \"\\xa8\", \"\\xa9\", \"\\xaa\", \"\\xab\", \"\\xac\", \"\\xad\", \"\\xae\", \"\\xaf\", \"\\xb0\", \"\\xb1\", \"\\xb2\", \"\\xb3\", \"\\xb4\", \"\\xb5\", \"\\xb6\", \"\\xb7\", \"\\xb8\", \"\\xb9\", \"\\xba\", \"\\xbb\", \"\\xbc\", \"\\xbd\", \"\\xbe\", \"\\xbf\", \"\\xc0\", \"\\xc1\", \"\\xc2\", \"\\xc3\", \"\\xc4\", \"\\xc5\", \"\\xc6\", \"\\xc7\", \"\\xc8\", \"\\xc9\", \"\\xca\", \"\\xcb\", \"\\xcc\", \"\\xcd\", \"\\xce\", \"\\xcf\", \"\\xd0\", \"\\xd1\", \"\\xd2\", \"\\xd3\", \"\\xd4\", \"\\xd5\", \"\\xd6\", \"\\xd7\", \"\\xd8\", \"\\xd9\", \"\\xda\", \"\\xdb\", \"\\xdc\", \"\\xdd\", \"\\xde\", \"\\xdf\", \"\\xe0\", \"\\xe1\", \"\\xe2\", \"\\xe3\", \"\\xe4\", \"\\xe5\", \"\\xe6\", \"\\xe7\", \"\\xe8\", \"\\xe9\", \"\\xea\", \"\\xeb\", \"\\xec\", \"\\xed\", \"\\xee\", \"\\xef\", \"\\xf0\", \"\\xf1\", \"\\xf2\", \"\\xf3\", \"\\xf4\", \"\\xf5\", \"\\xf6\", \"\\xf7\", \"\\xf8\", \"\\xf9\", \"\\xfa\", \"\\xfb\", \"\\xfc\", \"\\xfd\", \"\\xfe\", \"\\xff\"][value - 128]\nend\n\ndef _hex(value: String): Integer\n\tmut index := 0\n\twhile index < 16\n\t\tif \"0123456789ABCDEF\"[index] == value || \"0123456789abcdef\"[index] == value\n\t\t\treturn index\n\t\tend\n\t\tindex += 1\n\tend\n\treturn -1\nend\n\ndef encode_component(value: String): String\n\tbytes := value.to_bytes()\n\tmut encoded := \"\"\n\tmut index := 0\n\twhile index < bytes.size()\n\t\toctet := bytes.at(index)\n\t\tif (octet >= 65 && octet <= 90) || (octet >= 97 && octet <= 122) || (octet >= 48 && octet <= 57) || octet == 45 || octet == 46 || octet == 95 || octet == 126\n\t\t\tencoded += _octet(octet)\n\t\telse\n\t\t\tencoded += \"%\" + \"0123456789ABCDEF\"[octet / 16] + \"0123456789ABCDEF\"[octet % 16]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn encoded\nend\n\ndef _invalid_escape(value: String): Result<String, PublicURL::DecodeError>\n\treturn Result<String, PublicURL::DecodeError>::Err(PublicURL::DecodeError.new(\n\t\t\tkind: PublicURL::DecodeErrorKind::InvalidEscape,\n\t\t\tinput: value,\n\t\t\tmessage: \"invalid percent escape in URL component\",\n\t\t))\nend\n\ndef decode_component(value: String): Result<String, PublicURL::DecodeError>\n\tmut decoded := \"\"\n\tmut index := 0\n\twhile index < value.size()\n\t\tcharacter := value[index]\n\t\tif character != \"%\"\n\t\t\tdecoded += character\n\t\t\tindex += 1\n\t\telse\n\t\t\tif index + 2 >= value.size()\n\t\t\t\treturn _invalid_escape(value)\n\t\t\tend\n\t\t\thigh := _hex(value[index + 1])\n\t\t\tlow := _hex(value[index + 2])\n\t\t\tif high < 0 || low < 0\n\t\t\t\treturn _invalid_escape(value)\n\t\t\tend\n\t\t\tdecoded += _octet(high * 16 + low)\n\t\t\tindex += 3\n\t\tend\n\tend\n\tbytes := decoded.to_bytes()\n\tif !bytes.valid_utf8?()\n\t\treturn Result<String, PublicURL::DecodeError>::Err(PublicURL::DecodeError.new(\n\t\t\t\tkind: PublicURL::DecodeErrorKind::InvalidUtf8,\n\t\t\t\tinput: value,\n\t\t\t\tmessage: \"decoded URL component is not valid UTF-8\",\n\t\t\t))\n\tend\n\treturn Result<String, PublicURL::DecodeError>::Ok(bytes.to_s())\nend\n"
end

def native_json_source(): String
	return "import { Result } from trb/std/result\nimport trb/std/json as PublicJSON\nimport trb/internal/encoding_bytes as Octets\n\nmodule JSON\nend\n\n# Preserve raw numbers until the whole document is valid and duplicate object\n# keys have been resolved. Syntax errors precede value conversion errors.\nrecord JsonNode\n\tkind: Integer\n\ttext: String\n\titems: Array<Integer>\n\tmembers: Hash<String, Integer>\nend\n\nrecord JsonParser\n\tbytes: Bytes\n\tposition: Array<Integer>\n\tnodes: Array<JsonNode>\n\tfailure: Array<PublicJSON::Error>\nend\n\ndef _slice(source: String, start: Integer, finish: Integer): String\n\tmut text := \"\"\n\tmut index := start\n\twhile index < finish\n\t\ttext += source[index]\n\t\tindex += 1\n\tend\n\treturn text\nend\n\ndef _byte(parser: JsonParser): Integer\n\tif parser.position[0] >= parser.bytes.size()\n\t\treturn -1\n\tend\n\treturn parser.bytes.at(parser.position[0])\nend\n\ndef _source_slice(mut parser: JsonParser, start: Integer, finish: Integer): String\n\tmut text := \"\"\n\tmut index := start\n\twhile index < finish\n\t\ttext += Octets.octet(parser.bytes.at(index))\n\t\tindex += 1\n\tend\n\treturn text\nend\n\ndef _space(mut parser: JsonParser)\n\tmut character := _byte(parser)\n\twhile character == 32 || character == 10 || character == 13 || character == 9\n\t\tparser.position[0] += 1\n\t\tcharacter = _byte(parser)\n\tend\nend\n\ndef _error(kind: PublicJSON::ErrorKind, message: String, path: String): PublicJSON::Error\n\treturn PublicJSON::Error.new(kind: kind, message: message, path: path, line: nil, column: nil)\nend\n\ndef _byte_width(bytes: Bytes, position: Integer, finish: Integer): Integer\n\tfirst := bytes.at(position)\n\tmut width := 1\n\tif first >= 194 && first < 224\n\t\twidth = 2\n\telsif first >= 224 && first < 240\n\t\twidth = 3\n\telsif first >= 240 && first < 245\n\t\twidth = 4\n\tend\n\tif position + width > finish\n\t\treturn 1\n\tend\n\t# Validate encoded bytes directly. Building a String here would allocate\n\t# for every code point, including the common unescaped JSON string path.\n\tmut index := 1\n\twhile index < width\n\t\tcontinuation := bytes.at(position + index)\n\t\tif continuation < 128 || continuation > 191\n\t\t\treturn 1\n\t\tend\n\t\tindex += 1\n\tend\n\tif width >= 3\n\t\tsecond := bytes.at(position + 1)\n\t\tif (first == 224 && second < 160) || (first == 237 && second >= 160) || (first == 240 && second < 144) || (first == 244 && second >= 144)\n\t\t\treturn 1\n\t\tend\n\tend\n\treturn width\nend\n\ndef _syntax(mut parser: JsonParser, message: String, location: Integer)\n\tif !parser.failure.empty?()\n\t\treturn\n\tend\n\tif location < 0\n\t\tparser.failure.push(_error(PublicJSON::ErrorKind::Syntax, message, \"\"))\n\t\treturn\n\tend\n\t# The reference counts runes before the error's final byte, consuming each\n\t# incomplete or invalid UTF-8 byte separately rather than replacing a run.\n\tmut line := 1\n\tmut column := 1\n\tmut index := 0\n\twhile index < location\n\t\tif parser.bytes.at(index) == 10\n\t\t\tline += 1\n\t\t\tcolumn = 1\n\t\telse\n\t\t\tcolumn += 1\n\t\tend\n\t\tindex += _byte_width(parser.bytes, index, location)\n\tend\n\tparser.failure.push(PublicJSON::Error.new(kind: PublicJSON::ErrorKind::Syntax, message: message, path: \"\", line: line, column: column))\nend\n\ndef _diagnostic_hex(value: Integer, width: Integer): String\n\tmut number := value\n\tmut text := \"\"\n\tmut index := 0\n\twhile index < width\n\t\ttext = \"0123456789abcdef\"[number % 16] + text\n\t\tnumber /= 16\n\t\tindex += 1\n\tend\n\treturn text\nend\n\ndef _diagnostic_range(data: String, point: Integer): Boolean\n\tmut low := 0\n\tmut high := data.size() / 12\n\twhile low < high\n\t\tmiddle := low + (high - low) / 2\n\t\tmut start := 0\n\t\tmut finish := 0\n\t\tmut index := 0\n\t\twhile index < 6\n\t\t\tstart = start * 16 + _hex(data[middle * 12 + index])\n\t\t\tfinish = finish * 16 + _hex(data[middle * 12 + 6 + index])\n\t\t\tindex += 1\n\t\tend\n\t\tif point < start\n\t\t\thigh = middle\n\t\telsif point > finish\n\t\t\tlow = middle + 1\n\t\telse\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\ndef _diagnostic_character(character: String, quote: String): String\n\tif !character.to_bytes().valid_utf8?()\n\t\treturn \"\\\\x\" + _diagnostic_hex(character.to_bytes().at(0), 2)\n\tend\n\tif character == quote || character == \"\\\\\"\n\t\treturn \"\\\\\" + character\n\tend\n\tpoint := character.codepoints()[0]\n\tif _diagnostic_range(_diagnostic_printable_data(), point)\n\t\treturn character\n\tend\n\tif point == 7\n\t\treturn \"\\\\a\"\n\telsif point == 8\n\t\treturn \"\\\\b\"\n\telsif point == 9\n\t\treturn \"\\\\t\"\n\telsif point == 10\n\t\treturn \"\\\\n\"\n\telsif point == 11\n\t\treturn \"\\\\v\"\n\telsif point == 12\n\t\treturn \"\\\\f\"\n\telsif point == 13\n\t\treturn \"\\\\r\"\n\telsif point < 32 || point == 127\n\t\treturn \"\\\\x\" + _diagnostic_hex(point, 2)\n\telsif point < 65536\n\t\treturn \"\\\\u\" + _diagnostic_hex(point, 4)\n\tend\n\treturn \"\\\\U\" + _diagnostic_hex(point, 8)\nend\n\ndef _quoted(character: String): String\n\treturn \"'\" + _diagnostic_character(character, \"'\") + \"'\"\nend\n\ndef _bad(mut parser: JsonParser, context: String)\n\tif _byte(parser) < 0\n\t\t_syntax(parser, \"unexpected EOF\", -1)\n\telse\n\t\twidth := _byte_width(parser.bytes, parser.position[0], parser.bytes.size())\n\t\tcharacter := _source_slice(parser, parser.position[0], parser.position[0] + width)\n\t\t_syntax(parser, \"invalid character \" + _quoted(character) + \" \" + context, parser.position[0] + width - 1)\n\tend\nend\n\ndef _hex(character: String): Integer\n\tmut index := 0\n\twhile index < 16\n\t\tif \"0123456789abcdef\"[index] == character || \"0123456789ABCDEF\"[index] == character\n\t\t\treturn index\n\t\tend\n\t\tindex += 1\n\tend\n\treturn -1\nend\n\ndef _hex_byte(character: Integer): Integer\n\tif character >= 48 && character <= 57\n\t\treturn character - 48\n\telsif character >= 65 && character <= 70\n\t\treturn character - 55\n\telsif character >= 97 && character <= 102\n\t\treturn character - 87\n\tend\n\treturn -1\nend\n\ndef _rune(point: Integer): String\n\tif point < 128\n\t\treturn Octets.octet(point)\n\telsif point < 2048\n\t\treturn Octets.octet(192 + point / 64) + Octets.octet(128 + point % 64)\n\telsif point < 65536\n\t\treturn Octets.octet(224 + point / 4096) + Octets.octet(128 + point / 64 % 64) + Octets.octet(128 + point % 64)\n\tend\n\treturn Octets.octet(240 + point / 262144) + Octets.octet(128 + point / 4096 % 64) + Octets.octet(128 + point / 64 % 64) + Octets.octet(128 + point % 64)\nend\n\ndef _escape_diagnostic(sequence: String): String\n\tbytes := sequence.to_bytes()\n\tmut needs_quotes := false\n\tmut encoded := \"\\\"\"\n\tmut index := 0\n\twhile index < bytes.size()\n\t\twidth := _byte_width(bytes, index, bytes.size())\n\t\tif width == 1 && bytes.at(index) >= 128\n\t\t\tneeds_quotes = true\n\t\t\tencoded += \"\\\\x\" + _diagnostic_hex(bytes.at(index), 2)\n\t\telse\n\t\t\tmut raw := \"\"\n\t\t\tmut offset := 0\n\t\t\twhile offset < width\n\t\t\t\traw += Octets.octet(bytes.at(index + offset))\n\t\t\t\toffset += 1\n\t\t\tend\n\t\t\tcharacter := raw.to_bytes().to_s()\n\t\t\tpoint := character.codepoints()[0]\n\t\t\tif point == 96 || point == 65533 || !_diagnostic_range(_diagnostic_printable_data(), point) || _diagnostic_range(_diagnostic_space_data(), point)\n\t\t\t\tneeds_quotes = true\n\t\t\tend\n\t\t\tencoded += _diagnostic_character(character, \"\\\"\")\n\t\tend\n\t\tindex += width\n\tend\n\tif needs_quotes\n\t\treturn encoded + \"\\\"\"\n\tend\n\treturn \"`\" + sequence.to_bytes().to_s() + \"`\"\nend\n\ndef _unicode(mut parser: JsonParser): Integer\n\tmut value := 0\n\tmut count := 0\n\tmut sequence := \"\\\\u\"\n\tmut valid := true\n\twhile count < 4 && _byte(parser) >= 0\n\t\tcharacter := _byte(parser)\n\t\tsequence += Octets.octet(character)\n\t\tdigit := _hex_byte(character)\n\t\tif digit < 0\n\t\t\tvalid = false\n\t\telse\n\t\t\tvalue = value * 16 + digit\n\t\tend\n\t\tparser.position[0] += 1\n\t\tcount += 1\n\tend\n\tif count < 4 && _byte(parser) < 0 && valid\n\t\t_syntax(parser, \"unexpected EOF\", -1)\n\t\treturn -1\n\tend\n\tif !valid || count != 4\n\t\t_syntax(parser, \"invalid escape sequence \" + _escape_diagnostic(sequence) + \" in string\", parser.position[0] - 1)\n\t\treturn -1\n\tend\n\treturn value\nend\n\ndef _string(mut parser: JsonParser): String\n\tparser.position[0] += 1\n\tmut text := \"\"\n\twhile _byte(parser) >= 0 && parser.failure.empty?()\n\t\tcharacter := _byte(parser)\n\t\tif character == 34\n\t\t\tparser.position[0] += 1\n\t\t\t# Raw invalid bytes and unpaired surrogates were already replaced;\n\t\t\t# the accumulated text is valid UTF-8 without another decoding pass.\n\t\t\treturn text\n\t\tend\n\t\tif character < 32\n\t\t\t_bad(parser, \"in string\")\n\t\t\treturn \"\"\n\t\tend\n\t\tif character >= 128\n\t\t\twidth := _byte_width(parser.bytes, parser.position[0], parser.bytes.size())\n\t\t\tif width == 1\n\t\t\t\ttext += _rune(65533)\n\t\t\telse\n\t\t\t\ttext += _source_slice(parser, parser.position[0], parser.position[0] + width)\n\t\t\tend\n\t\t\tparser.position[0] += width\n\t\t\tnext\n\t\tend\n\t\tparser.position[0] += 1\n\t\tif character != 92\n\t\t\ttext += Octets.octet(character)\n\t\t\tnext\n\t\tend\n\t\tescape := _byte(parser)\n\t\tif escape < 0\n\t\t\tbreak\n\t\tend\n\t\tparser.position[0] += 1\n\t\tif escape == 34 || escape == 92 || escape == 47\n\t\t\ttext += Octets.octet(escape)\n\t\telsif escape == 98\n\t\t\ttext += \"\\x08\"\n\t\telsif escape == 102\n\t\t\ttext += \"\\x0c\"\n\t\telsif escape == 110\n\t\t\ttext += \"\\n\"\n\t\telsif escape == 114\n\t\t\ttext += \"\\r\"\n\t\telsif escape == 116\n\t\t\ttext += \"\\t\"\n\t\telsif escape == 117\n\t\t\tmut point := _unicode(parser)\n\t\t\tif point < 0\n\t\t\t\treturn \"\"\n\t\t\tend\n\t\t\tif point >= 55296 && point <= 56319\n\t\t\t\tstart := parser.position[0]\n\t\t\t\tif start + 6 <= parser.bytes.size() && parser.bytes.at(start) == 92 && parser.bytes.at(start + 1) == 117\n\t\t\t\t\tmut low := 0\n\t\t\t\t\tmut offset := 2\n\t\t\t\t\twhile offset < 6 && _hex_byte(parser.bytes.at(start + offset)) >= 0\n\t\t\t\t\t\tlow = low * 16 + _hex_byte(parser.bytes.at(start + offset))\n\t\t\t\t\t\toffset += 1\n\t\t\t\t\tend\n\t\t\t\t\tif offset == 6 && low >= 56320 && low <= 57343\n\t\t\t\t\t\tpoint = 65536 + (point - 55296) * 1024 + low - 56320\n\t\t\t\t\t\tparser.position[0] += 6\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif point >= 55296 && point <= 57343\n\t\t\t\tpoint = 65533\n\t\t\tend\n\t\t\ttext += _rune(point)\n\t\telse\n\t\t\t_syntax(parser, \"invalid escape sequence \" + _escape_diagnostic(\"\\\\\" + Octets.octet(escape)) + \" in string\", parser.position[0] - 1)\n\t\t\treturn \"\"\n\t\tend\n\tend\n\t_syntax(parser, \"unexpected EOF\", -1)\n\treturn \"\"\nend\n\ndef _digit(character: Integer): Boolean\n\treturn character >= 48 && character <= 57\nend\n\ndef _number(mut parser: JsonParser): String\n\tstart := parser.position[0]\n\tif _byte(parser) == 45\n\t\tparser.position[0] += 1\n\tend\n\tif !_digit(_byte(parser))\n\t\t_bad(parser, \"in numeric literal\")\n\t\treturn \"\"\n\tend\n\tif _byte(parser) == 48\n\t\tparser.position[0] += 1\n\telse\n\t\twhile _digit(_byte(parser))\n\t\t\tparser.position[0] += 1\n\t\tend\n\tend\n\tif _byte(parser) == 46\n\t\tparser.position[0] += 1\n\t\tif !_digit(_byte(parser))\n\t\t\t_bad(parser, \"in numeric literal\")\n\t\t\treturn \"\"\n\t\tend\n\t\twhile _digit(_byte(parser))\n\t\t\tparser.position[0] += 1\n\t\tend\n\tend\n\tif _byte(parser) == 101 || _byte(parser) == 69\n\t\tparser.position[0] += 1\n\t\tif _byte(parser) == 43 || _byte(parser) == 45\n\t\t\tparser.position[0] += 1\n\t\tend\n\t\tif !_digit(_byte(parser))\n\t\t\t_bad(parser, \"in numeric literal\")\n\t\t\treturn \"\"\n\t\tend\n\t\twhile _digit(_byte(parser))\n\t\t\tparser.position[0] += 1\n\t\tend\n\tend\n\treturn _source_slice(parser, start, parser.position[0])\nend\n\ndef _literal(mut parser: JsonParser, literal: String)\n\tbytes := literal.to_bytes()\n\tmut index := 0\n\twhile index < bytes.size()\n\t\tif _byte(parser) != bytes.at(index)\n\t\t\t_bad(parser, \"in literal \" + literal + \" (expecting '\" + literal[index] + \"')\")\n\t\t\treturn\n\t\tend\n\t\tparser.position[0] += 1\n\t\tindex += 1\n\tend\nend\n\n# Nodes retain raw values; only reachable children are converted after syntax\n# and duplicate-key handling finish. Explicit stacks preserve the JSON depth\n# contract without consuming an evaluator call frame for each container.\ndef _atom(mut parser: JsonParser, depth: Integer): Integer\n\t_space(parser)\n\tcharacter := _byte(parser)\n\tmut kind := 0\n\tmut text := \"\"\n\tif character == 34\n\t\tkind = 3\n\t\ttext = _string(parser)\n\telsif character == 110\n\t\t_literal(parser, \"null\")\n\telsif character == 116 || character == 102\n\t\tkind = 1\n\t\ttext = \"true\"\n\t\tif character == 102\n\t\t\ttext = \"false\"\n\t\tend\n\t\t_literal(parser, text)\n\telsif character == 45 || _digit(character)\n\t\tkind = 2\n\t\ttext = _number(parser)\n\telsif character == 91 || character == 123\n\t\tif depth >= 10000\n\t\t\t_syntax(parser, \"exceeded max depth\", parser.position[0])\n\t\t\treturn -1\n\t\tend\n\t\tkind = 4\n\t\tif character == 123\n\t\t\tkind = 5\n\t\tend\n\t\tparser.position[0] += 1\n\telse\n\t\t_bad(parser, \"looking for beginning of value\")\n\t\treturn -1\n\tend\n\tif !parser.failure.empty?()\n\t\treturn -1\n\tend\n\tidentity := parser.nodes.size()\n\tparser.nodes.push(JsonNode.new(kind: kind, text: text, items: [], members: {}))\n\treturn identity\nend\n\ndef _node(mut parser: JsonParser): Integer\n\troot := _atom(parser, 0)\n\tif root < 0 || parser.nodes[root].kind < 4\n\t\treturn root\n\tend\n\tmut frames := [root]\n\tmut phases := [0]\n\twhile !frames.empty?() && parser.failure.empty?()\n\t\ttop := frames.size() - 1\n\t\tmut node := parser.nodes[frames[top]]\n\t\tmut closing := 93\n\t\tif node.kind == 5\n\t\t\tclosing = 125\n\t\tend\n\t\t_space(parser)\n\t\tcharacter := _byte(parser)\n\t\tif phases[top] == 0 && character == closing\n\t\t\tparser.position[0] += 1\n\t\t\tframes.pop()\n\t\t\tphases.pop()\n\t\t\tnext\n\t\tend\n\t\tif phases[top] != 2\n\t\t\tmut key := \"\"\n\t\t\tif node.kind == 5\n\t\t\t\tif character != 34\n\t\t\t\t\t_bad(parser, \"looking for beginning of object key string\")\n\t\t\t\t\treturn -1\n\t\t\t\tend\n\t\t\t\tkey = _string(parser)\n\t\t\t\t_space(parser)\n\t\t\t\tif _byte(parser) != 58\n\t\t\t\t\t_bad(parser, \"after object key\")\n\t\t\t\t\treturn -1\n\t\t\t\tend\n\t\t\t\tparser.position[0] += 1\n\t\t\tend\n\t\t\tchild := _atom(parser, frames.size())\n\t\t\tif child < 0\n\t\t\t\treturn -1\n\t\t\tend\n\t\t\tif node.kind == 5\n\t\t\t\tnode.members[key] = child\n\t\t\telse\n\t\t\t\tnode.items.push(child)\n\t\t\tend\n\t\t\tphases[top] = 2\n\t\t\tif parser.nodes[child].kind >= 4\n\t\t\t\tframes.push(child)\n\t\t\t\tphases.push(0)\n\t\t\tend\n\t\t\tnext\n\t\tend\n\t\tif character == closing\n\t\t\tparser.position[0] += 1\n\t\t\tframes.pop()\n\t\t\tphases.pop()\n\t\telsif character == 44\n\t\t\tparser.position[0] += 1\n\t\t\tphases[top] = 1\n\t\telse\n\t\t\tif node.kind == 5\n\t\t\t\t_bad(parser, \"after object key:value pair\")\n\t\t\telse\n\t\t\t\t_bad(parser, \"after array element\")\n\t\t\tend\n\t\t\treturn -1\n\t\tend\n\tend\n\treturn root\nend\n\ndef _pointer(name: String): String\n\tmut escaped := \"\"\n\tmut index := 0\n\twhile index < name.size()\n\t\tif name[index] == \"~\"\n\t\t\tescaped += \"~0\"\n\t\telsif name[index] == \"/\"\n\t\t\tescaped += \"~1\"\n\t\telse\n\t\t\tescaped += name[index]\n\t\tend\n\t\tindex += 1\n\tend\n\treturn escaped\nend\n\ndef _atomic_value(node: JsonNode): Result<PublicJSON::Value, PublicJSON::Error>\n\tif node.kind == 0\n\t\treturn Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Null)\n\telsif node.kind == 1\n\t\treturn Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Boolean(node.text == \"true\"))\n\telsif node.kind == 2\n\t\tcase node.text.try_to_f()\n\t\twhen Result::Ok(number)\n\t\t\tif number < -9007199254740991.0 || number > 9007199254740991.0\n\t\t\t\treturn Result<PublicJSON::Value, PublicJSON::Error>::Err(_error(PublicJSON::ErrorKind::Decode, \"JSON integer is outside the portable range\", \"\"))\n\t\t\tend\n\t\t\tinteger := number.to_i()\n\t\t\tif integer.to_f() == number\n\t\t\t\treturn Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Integer(integer))\n\t\t\tend\n\t\t\treturn Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Float(number))\n\t\twhen Result::Err(_cause)\n\t\t\treturn Result<PublicJSON::Value, PublicJSON::Error>::Err(_error(PublicJSON::ErrorKind::Decode, \"JSON number is not finite\", \"\"))\n\t\tend\n\telsif node.kind == 3\n\t\treturn Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::String(node.text))\n\tend\n\treturn Result<PublicJSON::Value, PublicJSON::Error>::Ok(PublicJSON::Value::Null)\nend\n\ndef _path(parents: Array<Integer>, parts: Array<String>, identity: Integer): String\n\t# Both traversals keep raw keys; escape only when an error needs its path.\n\tmut path := \"\"\n\tmut index := identity\n\twhile parents[index] >= 0\n\t\tpath = \"/\" + _pointer(parts[index]) + path\n\t\tindex = parents[index]\n\tend\n\treturn path\nend\n\ndef _value(nodes: Array<JsonNode>, identity: Integer): Result<PublicJSON::Value, PublicJSON::Error>\n\t# Node identities are dense indexes; unreachable duplicate-key nodes keep\n\t# their unused placeholder without requiring a second Hash lookup per edge.\n\tmut values: Array<PublicJSON::Value> := []\n\tmut parents: Array<Integer> := []\n\tmut parts: Array<String> := []\n\tmut index := 0\n\twhile index < nodes.size()\n\t\tvalues.push(PublicJSON::Value::Null)\n\t\tparents.push(-1)\n\t\tparts.push(\"\")\n\t\tindex += 1\n\tend\n\tmut pending := [identity]\n\tmut entered := [false]\n\twhile !pending.empty?()\n\t\ttop := p