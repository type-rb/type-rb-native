		return "import { Context, Next, Request, Response } from trb/web\nimport trb/web/middleware\n\nenum PreflightMaxAge\n\tDisabled\n\tSeconds(value: Integer)\nend\n\nrecord CORSOptions\n\tallow_origins: Array<String>\n\tallow_methods: Array<String>\n\tallow_headers: Array<String>\n\texpose_headers: Array<String>\n\tcredentials: Boolean\n\tmax_age: PreflightMaxAge\nend\n\nclass CORSMiddleware implements Middleware\n\t@options: CORSOptions\n\n\tdef initialize(options: CORSOptions)\n\t\t@options = options\n\t\treturn\n\tend\n\n\tdef call(context: Context, next_handler: Next): Response\n\t\treturn _invoke(context, next_handler, @options)\n\tend\nend\n\nmodule CORS\n\tdef self.default_options(): CORSOptions\n\t\treturn CORSOptions.new(\n\t\t\tallow_origins: [\"*\"],\n\t\t\tallow_methods: [\"GET\", \"HEAD\", \"PUT\", \"POST\", \"DELETE\", \"PATCH\", \"OPTIONS\"],\n\t\t\tallow_headers: [],\n\t\t\texpose_headers: [],\n\t\t\tcredentials: false,\n\t\t\tmax_age: PreflightMaxAge::Disabled,\n\t\t)\n\tend\n\n\tdef self.middleware(options: CORSOptions = CORS.default_options()): Middleware\n\t\treturn CORSMiddleware.new(options)\n\tend\n\n\tdef self.call(context: Context, next_handler: Next, options: CORSOptions = CORS.default_options()): Response\n\t\treturn _invoke(context, next_handler, options)\n\tend\nend\n\ndef _invoke(context: Context, next_handler: Next, options: CORSOptions): Response\n\trequest := context.request\n\torigin := _request_origin(request)\n\tif _preflight?(request)\n\t\treturn _preflight_response(request, origin, options)\n\tend\n\tresponse := next_handler.call(context)\n\treturn _apply_actual_response(response, origin, options)\nend\n\ndef _request_origin(request: Request): String\n\tvalues := request.header_values(\"origin\")\n\tif values.size() != 1\n\t\treturn \"\"\n\tend\n\treturn values[0]\nend\n\ndef _preflight?(request: Request): Boolean\n\tif request.method.to_s() != \"OPTIONS\"\n\t\treturn false\n\tend\n\treturn request.header_values(\"access-control-request-method\").size() == 1\nend\n\ndef _preflight_response(request: Request, origin: String, options: CORSOptions): Response\n\tmut response := Response.empty()\n\tif _varies_by_origin?(options)\n\t\tresponse = response.vary(\"Origin\")\n\tend\n\tallowed_origin := _allowed_origin(origin, options)\n\tif allowed_origin == \"\"\n\t\treturn response\n\tend\n\tresponse = _apply_origin(response, allowed_origin, options)\n\tif !options.allow_methods.empty?()\n\t\tresponse = response.with_header(\"access-control-allow-methods\", options.allow_methods.join(\", \"))\n\tend\n\tif options.allow_headers.empty?()\n\t\trequested_headers := request.header_values(\"access-control-request-headers\")\n\t\tif !requested_headers.empty?()\n\t\t\tresponse = response.with_header(\"access-control-allow-headers\", requested_headers.join(\", \"))\n\t\t\tresponse = response.vary(\"Access-Control-Request-Headers\")\n\t\tend\n\telse\n\t\tresponse = response.with_header(\"access-control-allow-headers\", options.allow_headers.join(\", \"))\n\tend\n\treturn _apply_max_age(response, options.max_age)\nend\n\ndef _apply_actual_response(mut response: Response, origin: String, options: CORSOptions): Response\n\tif _varies_by_origin?(options)\n\t\tresponse = response.vary(\"Origin\")\n\tend\n\tallowed_origin := _allowed_origin(origin, options)\n\tif allowed_origin == \"\"\n\t\treturn response\n\tend\n\tresponse = _apply_origin(response, allowed_origin, options)\n\tif !options.expose_headers.empty?()\n\t\tresponse = response.with_header(\"access-control-expose-headers\", options.expose_headers.join(\", \"))\n\tend\n\treturn response\nend\n\ndef _allowed_origin(origin: String, options: CORSOptions): String\n\tif origin == \"\"\n\t\treturn \"\"\n\tend\n\tif options.allow_origins.include?(\"*\")\n\t\tif options.credentials\n\t\t\treturn origin\n\t\tend\n\t\treturn \"*\"\n\tend\n\tif options.allow_origins.include?(origin)\n\t\treturn origin\n\tend\n\treturn \"\"\nend\n\ndef _varies_by_origin?(options: CORSOptions): Boolean\n\treturn !options.allow_origins.include?(\"*\") || options.credentials\nend\n\ndef _apply_origin(response: Response, origin: String, options: CORSOptions): Response\n\tmut result := response.with_header(\"access-control-allow-origin\", origin)\n\tif options.credentials\n\t\tresult = result.with_header(\"access-control-allow-credentials\", \"true\")\n\tend\n\treturn result\nend\n\ndef _apply_max_age(response: Response, max_age: PreflightMaxAge): Response\n\tcase max_age\n\twhen PreflightMaxAge::Disabled\n\t\treturn response\n\twhen PreflightMaxAge::Seconds(value)\n\t\tif value < 0\n\t\t\treturn response\n\t\tend\n\t\treturn response.with_header(\"access-control-max-age\", value.to_s())\n\tend\nend\n"
