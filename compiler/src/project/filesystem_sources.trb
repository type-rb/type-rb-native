def native_file_source(): String
	return "import { FileHost } from trb/internal/filesystem_host\nimport trb/std/result\nimport trb/std/unit\nimport { FileSystemError } from trb/std/errors\n\nclass File\n\n def read(*, max_bytes: Integer): Result<Bytes, FileSystemError>\n  mut output := [\"\".to_bytes()]\n  status := FileHost.read_bytes(self, max_bytes, output)\n  if status != 0\n   return FileHost.failure<Bytes>(FileHost.path(self), 2, status)\n  end\n  return Result<Bytes, FileSystemError>::Ok(output[0])\n end\n\n def read_text(*, max_bytes: Integer): Result<String, FileSystemError>\n  mut output := [\"\"]\n  status := FileHost.read_text(self, max_bytes, output)\n  if status != 0\n   return FileHost.failure<String>(FileHost.path(self), 3, status)\n  end\n  return Result<String, FileSystemError>::Ok(output[0])\n end\n\n def write(value: Bytes): Result<Unit, FileSystemError>\n  status := FileHost.write_bytes(self, value)\n  if status != 0\n   return FileHost.failure<Unit>(FileHost.path(self), 4, status)\n  end\n  return Result<Unit, FileSystemError>::Ok(Unit.new())\n end\n\n def write_text(value: String): Result<Unit, FileSystemError>\n  status := FileHost.write_text(self, value)\n  if status != 0\n   return FileHost.failure<Unit>(FileHost.path(self), 5, status)\n  end\n  return Result<Unit, FileSystemError>::Ok(Unit.new())\n end\nend\n\nenum FileMode\n Read\n Write\n CreateNew\nend\n"
end

def native_filesystem_host_source(): String
	return "module FileHost\nend\nimport { File, FileMode } from trb/std/file\nimport trb/std/path\nimport trb/std/result\nimport { FileSystemError, FileSystemErrorKind, FileSystemTarget } from trb/std/errors\n\ndef read_bytes(file: File, maximum: Integer, mut output: Array<Bytes>): Integer\nend\ndef read_text(file: File, maximum: Integer, mut output: Array<String>): Integer\nend\ndef write_bytes(file: File, value: Bytes): Integer\nend\ndef write_text(file: File, value: String): Integer\nend\ndef path(file: File): String\nend\ndef error_kind(status: Integer): Integer\nend\ndef error_message(status: Integer): String\nend\n\ndef path_value(path: Path): String\n return path.to_s()\nend\n\ndef mode_value(mode: FileMode): Integer\n case mode\n when FileMode::Read\n  return 0\n when FileMode::Write\n  return 1\n when FileMode::CreateNew\n  return 2\n end\nend\n\ndef failure<T>(path: String, operation: Integer, status: Integer): Result<T, FileSystemError>\n names := [\"open\", \"close\", \"read\", \"read_text\", \"write\", \"write_text\", \"children\", \"create_all\"]\n kinds := [FileSystemErrorKind::Other, FileSystemErrorKind::AlreadyExists, FileSystemErrorKind::NotFound, FileSystemErrorKind::PermissionDenied, FileSystemErrorKind::InvalidPath, FileSystemErrorKind::InvalidLimit, FileSystemErrorKind::TooLarge, FileSystemErrorKind::InvalidEncoding, FileSystemErrorKind::Unsupported, FileSystemErrorKind::UnsupportedName]\n name := names[operation]\n mut message := error_message(status)\n if status > 0\n  message = name + \" \" + path + \": \" + message.downcase()\n end\n return Result<T, FileSystemError>::Err(FileSystemError.new(operation: name, target: FileSystemTarget::Host(Path.new(path)), kind: kinds[error_kind(status)], message: message))\nend\n"
end
