import { QbeOutput, qbe_output_line } from qbe_output

# The verified operands stay rooted across one allocation. No callbacks can
# mutate the retained Array during sizing or copying in this single-mutator ABI.
# Decode the completed bytes once: UTF-8 sequences can cross item boundaries.
def emit_array_join_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction l $trbn_array_join(l %array, l %separator) {\n@start\n %count_address =l add %array, 8\n %count =l loadl %count_address\n %storage_address =l add %array, 24\n %storage =l loadl %storage_address\n %separator_length_address =l add %separator, 8\n %separator_length =l loadl %separator_length_address\n %separator_data =l add %separator, 24\n jmp @measure\n@measure\n %index =l phi @start 0, @measured %next_index\n %size =l phi @start 0, @measured %next_size\n %done =w ceql %index, %count\n jnz %done, @allocate, @element\n@element\n %offset =l mul %index, 8\n %slot =l add %storage, %offset\n %item =l loadl %slot\n %item_length_address =l add %item, 8\n %item_length =l loadl %item_length_address\n %room =l sub 9007199254740991, %size\n %item_overflow =w cugtl %item_length, %room\n jnz %item_overflow, @fail, @add_item\n@add_item\n %with_item =l add %size, %item_length\n %first =w ceql %index, 0\n jnz %first, @without_separator, @separator_size\n@separator_size\n %separator_room =l sub 9007199254740991, %with_item\n %separator_overflow =w cugtl %separator_length, %separator_room\n jnz %separator_overflow, @fail, @add_separator\n@add_separator\n %with_separator =l add %with_item, %separator_length\n jmp @measured\n@without_separator\n jmp @measured\n@measured\n %next_size =l phi @without_separator %with_item, @add_separator %with_separator\n %next_index =l add %index, 1\n jmp @measure\n@allocate\n %payload =l add %size, 17\n %result =l call $trbn_string_alloc(l %payload)\n %result_length_address =l add %result, 8\n storel %size, %result_length_address\n %data =l add %result, 24\n jmp @copy\n@copy\n %position =l phi @allocate 0, @copied %next_position\n %cursor =l phi @allocate %data, @copied %next_cursor\n %finished =w ceql %position, %count\n jnz %finished, @finish, @copy_start\n@copy_start\n %initial =w ceql %position, 0\n jnz %initial, @copy_initial, @copy_separator\n@copy_separator\n call $memcpy(l %cursor, l %separator_data, l %separator_length)\n %after_separator =l add %cursor, %separator_length\n jmp @copy_element\n@copy_initial\n jmp @copy_element\n@copy_element\n %target =l phi @copy_initial %cursor, @copy_separator %after_separator\n %item_offset =l mul %position, 8\n %item_slot =l add %storage, %item_offset\n %text =l loadl %item_slot\n %text_length_address =l add %text, 8\n %text_length =l loadl %text_length_address\n %text_data =l add %text, 24\n call $memcpy(l %target, l %text_data, l %text_length)\n %next_cursor =l add %target, %text_length\n %next_position =l add %position, 1\n jmp @copied\n@copied\n jmp @copy\n@finish\n storeb 0, %cursor\n %points =l call $trbn_utf8_count(l %data, l %size)\n %points_address =l add %result, 16\n storel %points, %points_address\n ret %result\n@fail\n call $trbn_fail(l $trbn_allocation_error, l 25)\n hlt\n}\n")
end
