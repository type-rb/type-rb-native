import { describe, expect, test } from trb/std/test
import { check, emit_qbe, lex } from compiler
import { parse_module } from parser
import { resolve } from resolution
import { compiler_new, has_diagnostic } from state
import { mir_function_index, verify_mir } from mir

describe("Checked record arrays") do
	test("keeps record array reads outside numeric reduction MIR") do
		source := "record Entry\nid: Integer\nend\ndef read(values: Array<Entry>, index: Integer): Integer\nreturn values[index].id\nend\ndef sum(values: Array<Entry>): Integer\nmut index := 0\nmut result := 0\nwhile index < values.size()\nresult += values[index].id\nindex += 1\nend\nreturn result\nend\ndef main()\nreturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(mir_function_index(state.scalar_mir, 0)).to_equal(- 1)
		expect(mir_function_index(state.scalar_mir, 1)).to_equal(- 1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		emit_qbe(state)
		expect(has_diagnostic(state)).to_be_false()
	end
end
