import { ObjectDefinition, ObjectInstance } from object_model
import { NewtypeDefinition } from newtype_model
import { GlobalDeclaration } from global_model
import { TransformSyntax } from transform_model
import { NamespaceDeclaration } from namespace_model
import { TypeAlias, TypeAliasInstance } from alias_model
import { CheckedLambda, LambdaSyntax } from callable_types
import { CheckedBody, checked_body_new } from checked_body
import { CatchSyntax } from result_model
import { GenericBinding, GenericDefinition, GenericFunction, GenericFunctionInstance, GenericInstance } from generic_model
import { EnumDefinition, EnumField, EnumVariant, RawEnumValue } from enum_model
import iteration_syntax
import { integer_string } from literals
import { MirBlock, MirCall, MirControlLoop, MirIndexedTarget, MirInstruction, MirModule, MirUnionTarget, MirValue } from mir
import { IntegerStorage, StringStorage, integer_storage, integer_storage_copy, load_integer, load_string, sparse_integer_at, store_integer, store_string, string_storage, string_storage_copy } from storage

# Parsed declaration-scope expression. Function identities are assigned only
# after all authored declarations and their types have been resolved.
record DefaultInitializer
	kind: Integer
	owner: Integer
	slot: Integer
	start: Integer
	finish: Integer
end

# Authored flow-only type spellings are rejected after the REPL has identified
# its compiler-generated binding projections. Ordinary files have no such span.
record InternalTypeAnnotation
	source_id: Integer
	origin: Integer
end

# Parsed branch regions retained for checking and the checked REPL projection.
# Native execution uses only the resulting typed MIR blocks and edges.
record ControlBranch
	condition: Integer
	condition_finish: Integer
	body: Integer
	finish: Integer
end

record ControlSyntax
	kind: Integer
	origin: Integer
	finish: Integer
	selector: Integer
	selector_finish: Integer
	branches: Array<ControlBranch>
end

# Optional checked projection for a single interactive input. The ordinary
# compiler leaves this empty; no backend consumes it.
record CheckedFlowFact
	name: String
	field: String
	presence: Integer
end

record CheckedSubmission
	start: Integer
	finish: Integer
	before: Array<CheckedFlowFact>
	after: Array<CheckedFlowFact>
	types: StringStorage
	mutable: IntegerStorage
	resets: Array<Integer>
	# Retained mutable captures are lexical facts, never observed value proofs.
	captured: Array<String>
end

# One independent diagnostic result per compiler state. Generic specialization
# starts with a fresh result while sharing its immutable source tokens.
record CompilerDiagnostics
	codes: StringStorage
	lines: IntegerStorage
	messages: StringStorage
	modules: IntegerStorage
	count: Array<Integer>
end

# Parsed module and import catalogs. Generic specialization shares source facts
# but owns its active-module cursor and import-use facts.
record CompilerModuleGraph
	module_names: StringStorage
	module_files: StringStorage
	module_count: Array<Integer>
	module_import_starts: IntegerStorage
	module_import_counts: IntegerStorage
	module_lookup: Hash<String, Integer>
	entry_module: Array<Integer>
	active_module: Array<Integer>
	import_modules: IntegerStorage
	import_paths: StringStorage
	import_symbols: StringStorage
	import_declarations: StringStorage
	import_kinds: IntegerStorage
	import_lines: IntegerStorage
	import_targets: IntegerStorage
	import_used: IntegerStorage
	import_count: Array<Integer>
end

# Type aliases and generic specializations share one resolution catalog. A
# template-checking fork retains declarations but owns mutable lookup/progress.
record CompilerTypeResolution
	type_aliases: Array<TypeAlias>
	alias_instances: Array<TypeAliasInstance>
	alias_instance_lookup: Hash<String, Integer>
	alias_patterns: StringStorage
	alias_expansion_path: IntegerStorage
	alias_expansion_depth: Array<Integer>
	generic_definitions: Array<GenericDefinition>
	generic_instances: Array<GenericInstance>
	generic_instance_lookup: Hash<String, Integer>
	generic_depth: Array<Integer>
	generic_functions: Array<GenericFunction>
	generic_function_instances: Array<GenericFunctionInstance>
	generic_function_lookup: Hash<String, Integer>
	generic_bindings: Array<GenericBinding>
	record_generic_bindings: IntegerStorage
	function_generic_bindings: IntegerStorage
	generic_template_mode: Array<Boolean>
end

# Parsed record, function and parameter declarations form one catalog. A
# template-checking fork copies its mutable storage and lookup independently.
record CompilerDeclarationCatalog
	record_names: StringStorage
	record_modules: IntegerStorage
	record_field_starts: IntegerStorage
	record_field_counts: IntegerStorage
	record_lines: IntegerStorage
	record_count: Array<Integer>
	field_names: StringStorage
	field_types: StringStorage
	field_lines: IntegerStorage
	field_count: Array<Integer>
	function_names: StringStorage
	function_modules: IntegerStorage
	function_parameter_starts: IntegerStorage
	function_parameter_counts: IntegerStorage
	function_result_types: StringStorage
	function_body_starts: IntegerStorage
	function_body_ends: IntegerStorage
	function_lines: IntegerStorage
	function_count: Array<Integer>
	function_lookup: Hash<String, Integer>
	parameter_names: StringStorage
	parameter_types: StringStorage
	parameter_mutable: IntegerStorage
	parameter_named_only: IntegerStorage
	parameter_lines: IntegerStorage
	parameter_count: Array<Integer>
end

# Parsed statement regions and authored initializer plans remain source facts.
# A template-checking fork shares syntax indexes but owns mutable default plans.
record CompilerParsedProgram
	catch_syntax: Array<CatchSyntax>
	catch_origins: IntegerStorage
	statement_finishes: IntegerStorage
	loop_finishes: IntegerStorage
	controls: Array<ControlSyntax>
	# Positive rows identify parsed controls; typed facts live in CheckedBody.
	control_origins: IntegerStorage
	default_initializers: Array<DefaultInitializer>
	default_functions: Array<Integer>
	parameter_defaults: IntegerStorage
	field_defaults: IntegerStorage
	function_expression_bodies: IntegerStorage
	record_default_parameters: IntegerStorage
	transforms: Array<TransformSyntax>
	transform_origins: IntegerStorage
	iterations: Array<IterationSyntax>
	iteration_origins: IntegerStorage
end

record CompilerState
	objects: Array<ObjectDefinition>
	object_instances: Array<ObjectInstance>
	object_instance_lookup: Hash<String, Integer>
	newtypes: Array<NewtypeDefinition>
	token_fused_literals: IntegerStorage
	raw_enum_values: Array<RawEnumValue>
	raw_enum_results: StringStorage
	function_receivers: StringStorage
	internal_type_annotations: Array<InternalTypeAnnotation>
	projected_type_lines: Array<Integer>
	# Synthetic entries retain authored submission order independently of headers.
	global_scope_orders: IntegerStorage
	globals: Array<GlobalDeclaration>
	global_types: Array<String>
	global_functions: Array<Integer>
	global_order: Array<Integer>
	namespaces: Array<NamespaceDeclaration>
	declaration_owner: Array<String>
	token_namespaces: StringStorage
	lambdas: Array<LambdaSyntax>
	lambda_origins: IntegerStorage
	# Analysis discovers the complete callable catalog before MIR signatures freeze.
	lambda_phase: Array<Integer>
	checked_lambdas: Array<CheckedLambda>
	function_lambdas: IntegerStorage
	checked: Array<CheckedBody>
	checked_bodies: Array<CheckedBody>
	checked_body_indices: IntegerStorage
	standard_modules: IntegerStorage
	type_resolution: CompilerTypeResolution
	enums: Array<EnumDefinition>
	enum_variants: Array<EnumVariant>
	enum_fields: Array<EnumField>
	submissions: Array<CheckedSubmission>
	parsed: CompilerParsedProgram
	hash_repl: Array<Boolean>
	token_kinds: IntegerStorage
	token_texts: StringStorage
	token_lines: IntegerStorage
	token_count: Array<Integer>
	scalar_mir: MirModule
	module_graph: CompilerModuleGraph
	declarations: CompilerDeclarationCatalog
	diagnostics: CompilerDiagnostics
end

def compiler_parsed_program_new(capacity: Integer): CompilerParsedProgram
	return CompilerParsedProgram.new(
		catch_syntax: [], catch_origins: integer_storage(capacity),
		statement_finishes: integer_storage(capacity), loop_finishes: integer_storage(capacity),
		controls: [], control_origins: integer_storage(capacity),
		default_initializers: [], default_functions: [],
		parameter_defaults: integer_storage(capacity), field_defaults: integer_storage(capacity),
		function_expression_bodies: integer_storage(capacity), record_default_parameters: integer_storage(capacity),
		transforms: [], transform_origins: integer_storage(capacity),
		iterations: [], iteration_origins: integer_storage(capacity),
	)
end

def compiler_parsed_program_fork(parsed: CompilerParsedProgram): CompilerParsedProgram
	mut default_initializers: Array<DefaultInitializer> := []
	parsed.default_initializers.each do |value|
		default_initializers.push(value)
	end
	mut default_functions: Array<Integer> := []
	parsed.default_functions.each do |value|
		default_functions.push(value)
	end
	return CompilerParsedProgram.new(
		catch_syntax: parsed.catch_syntax, catch_origins: parsed.catch_origins,
		statement_finishes: parsed.statement_finishes, loop_finishes: parsed.loop_finishes,
		controls: parsed.controls, control_origins: parsed.control_origins,
		default_initializers: default_initializers, default_functions: default_functions,
		parameter_defaults: integer_storage_copy(parsed.parameter_defaults),
		field_defaults: integer_storage_copy(parsed.field_defaults),
		function_expression_bodies: integer_storage_copy(parsed.function_expression_bodies),
		record_default_parameters: integer_storage_copy(parsed.record_default_parameters),
		transforms: parsed.transforms, transform_origins: parsed.transform_origins,
		iterations: parsed.iterations, iteration_origins: parsed.iteration_origins,
	)
end

def compiler_type_resolution_new(capacity: Integer): CompilerTypeResolution
	return CompilerTypeResolution.new(
		type_aliases: [], alias_instances: [], alias_instance_lookup: {},
		alias_patterns: string_storage(capacity), alias_expansion_path: integer_storage(capacity), alias_expansion_depth: [0],
		generic_definitions: [], generic_instances: [], generic_instance_lookup: {}, generic_depth: [0],
		generic_functions: [], generic_function_instances: [], generic_function_lookup: {},
		generic_bindings: [], record_generic_bindings: integer_storage(capacity), function_generic_bindings: integer_storage(capacity),
		generic_template_mode: [false],
	)
end

def compiler_module_graph_new(capacity: Integer): CompilerModuleGraph
	return CompilerModuleGraph.new(
		module_names: string_storage(capacity),
		module_files: string_storage(capacity),
		module_count: [0],
		module_import_starts: integer_storage(capacity),
		module_import_counts: integer_storage(capacity),
		module_lookup: {},
		entry_module: [0],
		active_module: [0],
		import_modules: integer_storage(capacity),
		import_paths: string_storage(capacity),
		import_symbols: string_storage(capacity),
		import_declarations: string_storage(capacity),
		import_kinds: integer_storage(capacity),
		import_lines: integer_storage(capacity),
		import_targets: integer_storage(capacity),
		import_used: integer_storage(capacity),
		import_count: [0],
	)
end

def compiler_module_graph_fork(graph: CompilerModuleGraph, active_module: Array<Integer>): CompilerModuleGraph
	return CompilerModuleGraph.new(
		module_names: graph.module_names,
		module_files: graph.module_files,
		module_count: graph.module_count,
		module_import_starts: graph.module_import_starts,
		module_import_counts: graph.module_import_counts,
		module_lookup: graph.module_lookup,
		entry_module: graph.entry_module,
		active_module: active_module,
		import_modules: graph.import_modules,
		import_paths: graph.import_paths,
		import_symbols: graph.import_symbols,
		import_declarations: graph.import_declarations,
		import_kinds: graph.import_kinds,
		import_lines: graph.import_lines,
		import_targets: graph.import_targets,
		import_used: integer_storage_copy(graph.import_used),
		import_count: graph.import_count,
	)
end

def compiler_declaration_catalog_new(capacity: Integer): CompilerDeclarationCatalog
	return CompilerDeclarationCatalog.new(
		record_names: string_storage(capacity), record_modules: integer_storage(capacity),
		record_field_starts: integer_storage(capacity), record_field_counts: integer_storage(capacity),
		record_lines: integer_storage(capacity), record_count: [0],
		field_names: string_storage(capacity), field_types: string_storage(capacity),
		field_lines: integer_storage(capacity), field_count: [0],
		function_names: string_storage(capacity), function_modules: integer_storage(capacity),
		function_parameter_starts: integer_storage(capacity), function_parameter_counts: integer_storage(capacity),
		function_result_types: string_storage(capacity), function_body_starts: integer_storage(capacity),
		function_body_ends: integer_storage(capacity), function_lines: integer_storage(capacity),
		function_count: [0], function_lookup: {},
		parameter_names: string_storage(capacity), parameter_types: string_storage(capacity),
		parameter_mutable: integer_storage(capacity), parameter_named_only: integer_storage(capacity),
		parameter_lines: integer_storage(capacity), parameter_count: [0],
	)
end

def compiler_declaration_catalog_fork(catalog: CompilerDeclarationCatalog): CompilerDeclarationCatalog
	mut record_count: Array<Integer> := []
	catalog.record_count.each do |value|
		record_count.push(value)
	end
	mut field_count: Array<Integer> := []
	catalog.field_count.each do |value|
		field_count.push(value)
	end
	mut function_count: Array<Integer> := []
	catalog.function_count.each do |value|
		function_count.push(value)
	end
	mut function_lookup: Hash<String, Integer> := {}
	mut function := 0
	while function < catalog.function_count[0]
		key := function_index_key(load_integer(catalog.function_modules, function), load_string(catalog.function_names, function))
		if catalog.function_lookup.key?(key)
			function_lookup[key] = catalog.function_lookup[key]
		end
		function += 1
	end
	mut parameter_count: Array<Integer> := []
	catalog.parameter_count.each do |value|
		parameter_count.push(value)
	end
	return CompilerDeclarationCatalog.new(
		record_names: string_storage_copy(catalog.record_names),
		record_modules: integer_storage_copy(catalog.record_modules),
		record_field_starts: integer_storage_copy(catalog.record_field_starts),
		record_field_counts: integer_storage_copy(catalog.record_field_counts),
		record_lines: integer_storage_copy(catalog.record_lines), record_count: record_count,
		field_names: string_storage_copy(catalog.field_names),
		field_types: string_storage_copy(catalog.field_types),
		field_lines: integer_storage_copy(catalog.field_lines), field_count: field_count,
		function_names: string_storage_copy(catalog.function_names),
		function_modules: integer_storage_copy(catalog.function_modules),
		function_parameter_starts: integer_storage_copy(catalog.function_parameter_starts),
		function_parameter_counts: integer_storage_copy(catalog.function_parameter_counts),
		function_result_types: string_storage_copy(catalog.function_result_types),
		function_body_starts: integer_storage_copy(catalog.function_body_starts),
		function_body_ends: integer_storage_copy(catalog.function_body_ends),
		function_lines: integer_storage_copy(catalog.function_lines),
		function_count: function_count, function_lookup: function_lookup,
		parameter_names: string_storage_copy(catalog.parameter_names),
		parameter_types: string_storage_copy(catalog.parameter_types),
		parameter_mutable: integer_storage_copy(catalog.parameter_mutable),
		parameter_named_only: integer_storage_copy(catalog.parameter_named_only),
		parameter_lines: integer_storage_copy(catalog.parameter_lines),
		parameter_count: parameter_count,
	)
end

def compiler_new(capacity: Integer): CompilerState
	return CompilerState.new(objects: [], object_instances: [], object_instance_lookup: {}, newtypes: [], token_fused_literals: integer_storage(capacity), raw_enum_values: [], raw_enum_results: string_storage(capacity), function_receivers: string_storage(capacity), internal_type_annotations: [], projected_type_lines: [- 1, - 1],
		global_scope_orders: integer_storage(capacity), globals: [], global_types: [], global_functions: [], global_order: [],
		namespaces: [], declaration_owner: [""], token_namespaces: string_storage(capacity),
		lambdas: [], lambda_origins: integer_storage(capacity),
		lambda_phase: [0], checked_lambdas: [], function_lambdas: integer_storage(capacity),
		checked: [checked_body_new(- 1, 0, capacity)], checked_bodies: [], checked_body_indices: integer_storage(capacity),
		standard_modules: integer_storage(capacity),
		type_resolution: compiler_type_resolution_new(capacity),
		enums: [], enum_variants: [], enum_fields: [],
		submissions: [],
		parsed: compiler_parsed_program_new(capacity),
		hash_repl: [false],
		token_kinds: integer_storage(capacity),
		token_texts: string_storage(capacity),
		token_lines: integer_storage(capacity),
		token_count: [0],
		scalar_mir: MirModule.new(object_methods: [], object_witnesses: [], objects: [], newtypes: [], unions: [], globals: [], global_initialization: [], callables: [], enums: [], enum_variants: [], enum_fields: [], numeric_plans: [[]], types: [], records: [], fields: [], root_plans: [], array_loops: [], array_check_reuse: [],
			signatures: [], calls: [],
			source_count: [1],
			entry_function: [0],
			functions: [],
			blocks: [],
			values: [],
			instructions: [],
			arguments: [],
			literal_texts: [],
		),
		module_graph: compiler_module_graph_new(capacity),
		declarations: compiler_declaration_catalog_new(capacity),
		diagnostics: CompilerDiagnostics.new(
			codes: string_storage(1), lines: integer_storage(1),
			messages: string_storage(1), modules: integer_storage(1), count: [0],
		),
	)
end

def find_name_index(index: Hash<String, Integer>, name: String): Integer
	if index.key?(name)
		return index[name]
	end
	return - 1
end

def function_index_key(module_index: Integer, name: String): String
	return integer_string(module_index) + ":" + name
end

def add_module(mut state: CompilerState, name: String, filename: String): Integer
	index := state.module_graph.module_count[0]
	store_string(state.module_graph.module_names, index, name)
	store_string(state.module_graph.module_files, index, filename)
	store_integer(state.module_graph.module_import_starts, index, state.module_graph.import_count[0])
	store_integer(state.module_graph.module_import_counts, index, 0)
	state.module_graph.module_count[0] = index + 1
	state.module_graph.module_lookup[name] = index
	return index
end

def find_module(state: CompilerState, name: String): Integer
	return find_name_index(state.module_graph.module_lookup, name)
end

def terminal_token(state: CompilerState, index: Integer): Boolean
	kind := load_integer(state.token_kinds, index)
	if kind == 0
		return true
	end
	return kind == 6
end

def has_diagnostic(state: CompilerState): Boolean
	return state.diagnostics.count[0] > 0
end

def diagnostic(mut state: CompilerState, code: String, line: Integer, message: String)
	if state.diagnostics.count[0] == 0
		store_string(state.diagnostics.codes, 0, code)
		store_integer(state.diagnostics.lines, 0, line)
		store_string(state.diagnostics.messages, 0, message)
		store_integer(state.diagnostics.modules, 0, state.module_graph.active_module[0])
		state.diagnostics.count[0] = 1
	end
	return
end

# Persistent path facts make branch rollback constant time. Field -2 is a
# binding replacement barrier; field -1 denotes the binding itself.
record NullableFact
	identity: Integer
	field: Integer
	type_name: String
	version: Integer
	previous: Integer
end

record CheckedLocals
	# Active slots can be reused after scope exit; declaration identities cannot.
	binding_ids: IntegerStorage
	binding_slots: Array<Integer>
	# Anonymous checking has an inherited prefix followed by its own bindings.
	capture_parents: Array<Integer>
	capture_uses: Array<Integer>
	lambda_result: Array<String>
	# Source token and binding kind share one encoded obligation per active slot.
	binding_use_obligations: IntegerStorage
	binding_use_counts: IntegerStorage
	nullable_facts: Array<NullableFact>
	nullable_state: Array<Integer>
	lexical_loop: Array<Integer>
	value_block: Array<Boolean>
	hash_literal_origins: IntegerStorage
	hash_declaration_origins: IntegerStorage
	hash_inference_regions: IntegerStorage
	array_literal_origins: IntegerStorage
	array_declaration_origins: IntegerStorage
	array_inference_regions: IntegerStorage
	inference_active_region: Array<Integer>
	names: StringStorage
	types: StringStorage
	mutable: IntegerStorage
	# Binding semantics remain in types; cells have independent MIR storage types.
	mir_cell_plans: IntegerStorage
	mir_cell_types: StringStorage
	mir_values: IntegerStorage
	mir_value_rows: Array<MirValue>
	mir_instructions: Array<MirInstruction>
	mir_literal_texts: Array<String>
	mir_control: Array<Integer>
	mir_blocks: Array<MirBlock>
	mir_loops: Array<MirControlLoop>
	mir_hash_refinements: Array<Integer>
	mir_array_refinements: Array<Integer>
	mir_array_numeric_candidates: Array<Integer>
	mir_hash_numeric_candidates: Array<Integer>
	mir_object_targets: Array<MirIndexedTarget>
	mir_union_targets: Array<MirUnionTarget>
	mir_targets: Array<MirIndexedTarget>
	mir_calls: Array<MirCall>
	mir_arguments: Array<Integer>
	mir_state: Array<Integer>
	count: Array<Integer>
end

def locals_new(capacity: Integer): CheckedLocals
	return CheckedLocals.new(
		binding_ids: integer_storage(capacity), binding_slots: [],
		capture_parents: [], capture_uses: [], lambda_result: [],
		binding_use_obligations: integer_storage(capacity), binding_use_counts: integer_storage(capacity),
		nullable_facts: [],
		nullable_state: [- 1, 0],
		lexical_loop: [- 1], value_block: [false],
		hash_literal_origins: integer_storage(capacity),
		hash_declaration_origins: integer_storage(capacity),
		hash_inference_regions: integer_storage(capacity),
		array_literal_origins: integer_storage(capacity),
		array_declaration_origins: integer_storage(capacity),
		array_inference_regions: integer_storage(capacity),
		inference_active_region: [0],
		names: string_storage(capacity),
		types: string_storage(capacity),
		mutable: integer_storage(capacity),
		mir_cell_plans: integer_storage(capacity), mir_cell_types: string_storage(capacity),
		mir_values: integer_storage(capacity),
		mir_value_rows: [],
		mir_instructions: [],
		mir_literal_texts: [],
		# active, current/next block, instruction start, parameter span,
		# terminated, source line and lexical loop depth for checked control flow.
		mir_control: [0, 0, 0, 0, 0, 0, 0, 0, 0],
		mir_blocks: [],
		mir_loops: [],
		mir_hash_refinements: [],
		mir_array_refinements: [],
		mir_array_numeric_candidates: [],
		mir_hash_numeric_candidates: [],
		mir_object_targets: [],
		mir_union_targets: [],
		mir_targets: [],
		mir_calls: [],
		mir_arguments: [],
		# Active, function, next value, Integer failure, return value.
		mir_state: [0, - 1, 0, - 1, - 1],
		count: [0],
	)
end

def local_find(locals: CheckedLocals, name: String): Integer
	mut index := locals.count[0] - 1
	while index >= 0
		if load_string(locals.names, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def local_add(
		mut state: CompilerState,
		mut locals: CheckedLocals,
		name: String,
		type_name: String,
		mutable: Integer,
		line: Integer,
	): Boolean
	if local_find(locals, name) >= locals.capture_parents.size()
		diagnostic(state, "TRBN4003", line, "duplicate local declaration " + name)
		return false
	end
	local_bind(locals, name, type_name, mutable)
	return true
end

# Register one lexical binding, including deliberate block-parameter shadowing.
# Each concrete body owns its identities independently of reusable active slots.
def local_bind(mut locals: CheckedLocals, name: String, type_name: String, mutable: Integer): Integer
	return local_bind_identity(locals, name, type_name, mutable, locals.binding_slots.size())
end

# Materialized closures retain analyzed declaration IDs even when unused
# inherited declarations have no runtime parameter or active lookup slot.
def local_bind_identity(mut locals: CheckedLocals, name: String, type_name: String, mutable: Integer, identity: Integer): Integer
	index := local_bind_temporary(locals, name, type_name, mutable)
	while locals.binding_slots.size() <= identity
		locals.binding_slots.push(- 1)
	end
	store_integer(locals.binding_ids, index, identity)
	locals.binding_slots[identity] = index
	return index
end

# MIR-only scratch slots must not consume analyzed lexical declaration IDs.
# They cannot be captured and disappear when their builder restores the count.
def local_bind_temporary(mut locals: CheckedLocals, name: String, type_name: String, mutable: Integer): Integer
	index := locals.count[0]
	store_integer(locals.binding_ids, index, - 1)
	store_integer(locals.binding_use_obligations, index, 0)
	store_integer(locals.binding_use_counts, index, 0)
	store_integer(locals.hash_literal_origins, index, 0)
	store_integer(locals.hash_declaration_origins, index, 0)
	store_integer(locals.hash_inference_regions, index, 0)
	store_integer(locals.array_literal_origins, index, 0)
	store_integer(locals.array_declaration_origins, index, 0)
	store_integer(locals.array_inference_regions, index, 0)
	store_string(locals.names, index, name)
	store_string(locals.types, index, type_name)
	store_integer(locals.mutable, index, mutable)
	store_integer(locals.mir_values, index, 0)
	store_string(locals.mir_cell_types, index, "")
	locals.count[0] = index + 1
	return index
end

# Only authored bindings have a use obligation. A leading underscore explicitly
# permits a named discard, except that a Result binding retains must-use policy.
# Kind 1 is a local, 2 a block parameter, 3 a pattern, 4 a catch, 5 a Result.
def local_require_use(mut locals: CheckedLocals, slot: Integer, name: String, origin: Integer, kind: Integer)
	if kind != 5 && (name.size() == 0 || name[0] == "_")
		return
	end
	store_integer(locals.binding_use_obligations, slot, (origin + 1) * 8 + kind)
end

def local_storage_type(locals: CheckedLocals, slot: Integer): String
	cell := load_string(locals.mir_cell_types, slot)
	if cell != ""
		return cell
	end
	return load_string(locals.types, slot)
end

def local_identity(locals: CheckedLocals, slot: Integer): Integer
	if slot < 0 || slot >= locals.count[0]
		return - 1
	end
	return load_integer(locals.binding_ids, slot)
end

def local_slot(locals: CheckedLocals, identity: Integer): Integer
	if identity < 0 || identity >= locals.binding_slots.size()
		return - 1
	end
	slot := locals.binding_slots[identity]
	if slot < 0 || slot >= locals.count[0] || load_integer(locals.binding_ids, slot) != identity
		return - 1
	end
	return slot
end

# Select by semantic function identity, preserving an explicit caller context.
# Source token origins remain authored coordinates within each independent body.
def select_checked_body(mut state: CompilerState, function: Integer): CheckedBody
	previous := state.checked[0]
	if function < 0 || function >= state.declarations.function_count[0]
		diagnostic(state, "TRBN4004", 1, "checked body requires a declared function")
		return previous
	end
	mut encoded := sparse_integer_at(state.checked_body_indices, function)
	if encoded == 0
		mut origin := load_integer(state.declarations.function_body_starts, function)
		mut finish := load_integer(state.declarations.function_body_ends, function) + 1
		state.type_resolution.generic_function_instances.each do |instance|
			if instance.function == function
				state.objects.each do |definition|
					definition.methods.each do |method|
						if method.generic_function == instance.definition
							origin = definition.origin
							definition.fields.each do |field|
								if field.default_finish >= finish
									finish = field.default_finish + 1
								end
							end
						end
					end
				end
			end
		end
		state.checked_bodies.push(checked_body_new(function, origin, finish))
		encoded = state.checked_bodies.size()
		store_integer(state.checked_body_indices, function, encoded)
	end
	state.checked[0] = state.checked_bodies[encoded - 1]
	state.checked[0].generic_binding[0] = sparse_integer_at(state.type_resolution.function_generic_bindings, function)
	return previous
end
