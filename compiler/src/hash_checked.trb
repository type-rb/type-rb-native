import { find_object_type } from object_types
import { literal_type_base } from literal_types
import { find_newtype_type } from newtype_types
import { union_parts } from union_types
import { callable_parts } from callable_types
import { find_enum_type } from enum_types
import { token_is } from syntax_tokens
import { nullable_element } from nullable_types
import { MirHashOperation, mir_hash_operation, mir_hash_valid } from hash_mir
import { hash_key_type, hash_value_type } from hash_types
import { array_element_type, find_record_type } from type_resolution
import { CompilerState, diagnostic } from state
import { load_integer, load_string, sparse_integer_at, store_integer } from storage

def checked_hash_index_at(state: CompilerState, origin: Integer): Integer
	return sparse_integer_at(state.checked[0].hash_origins, origin) - 1
end

# Publish a single named plan per source operation; the origin table is only an
# index into verified MIR, never an independent collection semantics store.
def checked_hash_publish(mut state: CompilerState, plan: MirHashOperation)
	mut operations := state.checked[0].hash_operations
	index := checked_hash_index_at(state, plan.origin)
	if index >= 0
		operations[index] = plan
	else
		operations.push(plan)
		store_integer(state.checked[0].hash_origins, plan.origin, operations.size())
	end
	store_integer(state.checked[0].hash_origins, plan.finish, load_integer(state.checked[0].hash_origins, plan.origin))
end

def checked_hash_plan(state: CompilerState, origin: Integer): MirHashOperation
	if origin >= 0 && origin < state.token_count[0]
		index := checked_hash_index_at(state, origin)
		if index >= 0 && index < state.checked[0].hash_operations.size()
			return state.checked[0].hash_operations[index]
		end
	end
	return mir_hash_operation(0, - 1, - 1, - 1, "", false, 0)
end

def checked_hash_method(method: String): Integer
	if method == "fetch"
		return 13
	elsif method == "size"
		return 4
	elsif method == "key?"
		return 5
	elsif method == "delete"
		return 6
	elsif method == "dup"
		return 7
	elsif method == "merge"
		return 8
	elsif method == "update"
		return 9
	elsif method == "keys"
		return 10
	elsif method == "values"
		return 11
	elsif method == "empty?"
		return 12
	end
	return 0
end

def checked_hash_empty_constant(state: CompilerState, plan: MirHashOperation): Boolean
	if plan.type_name != "Hash" || plan.entries != 0
		return false
	end
	if plan.kind == 4 || plan.kind == 12
		return true
	end
	if plan.kind != 1
		return false
	end
	mut index := 0
	while index < state.globals.size()
		row := state.globals[index]
		mut start := row.start
		mut finish := row.finish
		while finish - start > 2 && token_is(state, start, "(") && token_is(state, finish - 1, ")")
			start += 1
			finish -= 1
		end
		if row.constant && start == plan.origin && finish == plan.finish + 1
			return true
		end
		index += 1
	end
	return false
end

def checked_hash_valid(state: CompilerState, plan: MirHashOperation, pending: Boolean): Boolean
	mut allow_pending := pending
	if checked_hash_empty_constant(state, plan)
		allow_pending = true
	end
	if !mir_hash_valid(plan, state.token_count[0], allow_pending)
		return false
	end
	if plan.type_name != "Hash" && !checked_hash_value_layout(state, plan.value_type)
		return false
	end
	if plan.kind == 3 || plan.kind == 6 || plan.kind == 9
		if !checked_hash_binding_target(state, plan.receiver_origin)
			return false
		end
	end
	if plan.kind == 1
		if token_is(state, plan.origin, "{") && token_is(state, plan.finish, "}")
			return true
		end
		return false
	end
	if plan.kind == 2 || plan.kind == 3
		if !token_is(state, plan.origin, "[") || !token_is(state, plan.finish, "]")
			return false
		end
		if plan.kind == 3
			return token_is(state, plan.finish + 1, "=")
		end
		return true
	end
	if token_is(state, plan.origin, "(") && token_is(state, plan.finish, ")") && plan.kind == checked_hash_method(load_string(state.token_texts, plan.origin - 1))
		return true
	end
	return false
end

def checked_hash_require(mut state: CompilerState, origin: Integer, type_name: String): MirHashOperation
	plan := checked_hash_plan(state, origin)
	if !checked_hash_valid(state, plan, false) || plan.origin != origin || plan.type_name != type_name
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "invalid checked Hash operation")
	end
	return plan
end

def checked_hash_verify_body(mut state: CompilerState): Boolean
	state.checked[0].hash_operations.each do |plan|
		if !checked_hash_valid(state, plan, state.hash_repl[0])
			diagnostic(state, "TRBN4004", load_integer(state.token_lines, plan.origin), "unresolved or invalid Hash operation; annotate Hash<K, V>")
			return false
		end
	end
	return true
end

# A fresh value may be passed to a mutable parameter, but mutation syntax
# requires a binding. Follow checked indexed receivers without token guessing.
def checked_hash_binding_target(state: CompilerState, origin: Integer): Boolean
	mut root := origin
	mut depth := 0
	while depth < state.token_count[0]
		parent := checked_hash_plan(state, root)
		if parent.kind == 1
			return false
		end
		if parent.kind != 2
			return true
		end
		root = parent.receiver_origin
		depth += 1
	end
	return false
end

def checked_hash_value_layout(state: CompilerState, type_name: String): Boolean
	if literal_type_base(type_name) != ""
		return true
	end
	alternatives := union_parts(type_name)
	if alternatives.size() > 0
		mut valid := true
		alternatives.each do |alternative|
			if !checked_hash_value_layout(state, alternative)
				valid = false
			end
		end
		return valid
	end
	parts := callable_parts(type_name)
	if parts.size() > 0
		mut index := 0
		while index < parts.size()
			if !(index == 0 && parts[index] == "Void") && !checked_hash_value_layout(state, parts[index])
				return false
			end
			index += 1
		end
		return true
	end
	if nullable_element(type_name) != ""
		return checked_hash_value_layout(state, nullable_element(type_name))
	end
	if type_name == "Any" || type_name == "Nil" || type_name == "Integer" || type_name == "Float" || type_name == "Boolean" || type_name == "String" || type_name == "Range<Integer>"
		return true
	end
	if hash_key_type(type_name) != ""
		return checked_hash_value_layout(state, hash_value_type(type_name))
	end
	element := array_element_type(type_name)
	if element != ""
		return checked_hash_value_layout(state, element)
	end
	if find_newtype_type(state, type_name) >= 0
		return true
	end
	if find_enum_type(state, type_name) >= 0
		return true
	end
	if find_record_type(state, type_name) >= 0
		return true
	end
	return find_object_type(state, type_name) >= 0
end

def checked_hash_verify(mut state: CompilerState): Boolean
	previous := state.checked[0]
	mut valid := true
	state.checked_bodies.each do |body|
		state.checked[0] = body
		if !checked_hash_verify_body(state)
			valid = false
			break
		end
	end
	state.checked[0] = previous
	return valid
end
