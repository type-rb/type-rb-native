import { QbeOutput, qbe_output_line } from qbe_output

# Unicode 17.0 White_Space matches the portable reference contract.
# Scan bounded code points once, then copy the retained bytes in one allocation.
# Invalid UTF-8 and embedded NUL are preserved; no-op trims reuse immutable input.
def emit_string_trim_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction w $trbn_unicode_white_space(l %point) {\n@start\n %control_low =w csgel %point, 9\n %control_high =w cslel %point, 13\n %control =w and %control_low, %control_high\n %block_low =w csgel %point, 8192\n %block_high =w cslel %point, 8202\n %block =w and %block_low, %block_high\n %ranges =w or %control, %block\n %point0 =w ceql %point, 32\n %space0 =w or %ranges, %point0\n %point1 =w ceql %point, 133\n %space1 =w or %space0, %point1\n %point2 =w ceql %point, 160\n %space2 =w or %space1, %point2\n %point3 =w ceql %point, 5760\n %space3 =w or %space2, %point3\n %point4 =w ceql %point, 8232\n %space4 =w or %space3, %point4\n %point5 =w ceql %point, 8233\n %space5 =w or %space4, %point5\n %point6 =w ceql %point, 8239\n %space6 =w or %space5, %point6\n %point7 =w ceql %point, 8287\n %space7 =w or %space6, %point7\n %point8 =w ceql %point, 12288\n %space8 =w or %space7, %point8\n ret %space8\n}\n\nfunction l $trbn_string_trim(l %source, l %mode) {\n@start\n %length_slot =l add %source, 8\n %length =l loadl %length_slot\n %data =l add %source, 24\n jmp @loop\n@loop\n %offset =l phi @start 0, @advance %next\n %first =l phi @start -1, @advance %first_saved\n %last =l phi @start 0, @advance %last_saved\n %done =w ceql %offset, %length\n jnz %done, @bounds, @decode\n@decode\n %address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %point =l call $trbn_utf8_scalar(l %address, l %remaining)\n %next =l add %offset, %width\n %white =w call $trbn_unicode_white_space(l %point)\n jnz %white, @white, @nonwhite\n@white\n jmp @advance\n@nonwhite\n %unseen =w csltl %first, 0\n jnz %unseen, @initial, @existing\n@initial\n jmp @marked\n@existing\n jmp @marked\n@marked\n %next_first =l phi @initial %offset, @existing %first\n jmp @advance\n@advance\n %first_saved =l phi @white %first, @marked %next_first\n %last_saved =l phi @white %last, @marked %next\n jmp @loop\n@bounds\n %empty =w csltl %first, 0\n jnz %empty, @empty, @left_mode\n@empty\n jmp @copy_bounds\n@left_mode\n %right_only =w ceql %mode, 2\n jnz %right_only, @keep_left, @trim_left\n@keep_left\n jmp @right_mode\n@trim_left\n jmp @right_mode\n@right_mode\n %begin =l phi @keep_left 0, @trim_left %first\n %left_only =w ceql %mode, 1\n jnz %left_only, @keep_right, @trim_right\n@keep_right\n jmp @chosen\n@trim_right\n jmp @chosen\n@chosen\n %end =l phi @keep_right %length, @trim_right %last\n jmp @copy_bounds\n@copy_bounds\n %start =l phi @empty 0, @chosen %begin\n %finish =l phi @empty 0, @chosen %end\n %size =l sub %finish, %start\n %unchanged =w ceql %size, %length\n jnz %unchanged, @original, @allocate\n@original\n ret %source\n@allocate\n %payload =l add %size, 17\n %result =l call $trbn_string_alloc(l %payload)\n %result_length =l add %result, 8\n storel %size, %result_length\n %result_data =l add %result, 24\n %input =l add %data, %start\n call $memcpy(l %result_data, l %input, l %size)\n %terminator =l add %result_data, %size\n storeb 0, %terminator\n %count =l call $trbn_utf8_count(l %result_data, l %size)\n %result_count =l add %result, 16\n storel %count, %result_count\n ret %result\n}\n")
end
