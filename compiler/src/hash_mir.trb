import { hash_key_type, hash_type, hash_value_type, native_managed_type, native_value_layout } from hash_types

# This checked MIR region owns Hash representation, mutation effects, and
# literal capacity. It does not claim complete block/value MIR admission.
record MirHashOperation
	kind: Integer
	origin: Integer
	finish: Integer
	receiver_origin: Integer
	type_name: String
	key_type: String
	value_type: String
	mutable: Boolean
	entries: Integer
	capacity: Integer
end

def mir_hash_capacity(entries: Integer): Integer
	if entries == 0
		return 0
	end
	mut capacity := 8
	while entries > capacity / 4 * 3
		capacity *= 2
	end
	return capacity
end

def mir_hash_operation(kind: Integer, origin: Integer, finish: Integer, receiver: Integer, type_name: String, mutable: Boolean, entries: Integer): MirHashOperation
	return MirHashOperation.new(kind: kind, origin: origin, finish: finish, receiver_origin: receiver, type_name: type_name, key_type: hash_key_type(type_name), value_type: hash_value_type(type_name), mutable: mutable, entries: entries, capacity: mir_hash_capacity(entries))
end

def mir_hash_valid(plan: MirHashOperation, token_count: Integer, pending: Boolean): Boolean
	if plan.kind < 1 || plan.kind > 13 || plan.origin < 0 || plan.finish <= plan.origin || plan.finish >= token_count
		return false
	end
	if plan.kind == 1
		if plan.receiver_origin != plan.origin
			return false
		end
	elsif plan.receiver_origin != 9007199254740991
		if plan.receiver_origin < 0 || plan.receiver_origin >= plan.origin
			return false
		end
	end
	if plan.entries < 0 || plan.entries > token_count
		return false
	end
	if plan.kind != 1 && plan.entries != 0
		return false
	end
	if plan.capacity != mir_hash_capacity(plan.entries)
		return false
	end
	if plan.kind == 3 || plan.kind == 6 || plan.kind == 9
		if !plan.mutable
			return false
		end
	end
	if plan.type_name == "Hash"
		if pending && (plan.kind == 1 || plan.kind == 4 || plan.kind == 12) && plan.entries == 0
			return true
		end
		return false
	end
	if plan.key_type == "" || plan.key_type != hash_key_type(plan.type_name)
		return false
	end
	if plan.type_name != hash_type(plan.key_type, plan.value_type)
		return false
	end
	if native_value_layout(plan.value_type) && plan.value_type == hash_value_type(plan.type_name)
		return true
	end
	return false
end

def mir_hash_key_managed(plan: MirHashOperation): Boolean
	return plan.key_type == "String"
end

def mir_hash_value_managed(plan: MirHashOperation): Boolean
	return native_managed_type(plan.value_type)
end
