record Gate4IntegerStorage
	chunks: Array<Array<Array<Integer>>>
	limit: Array<Integer>
	used: Array<Integer>
end

record Gate4StringStorage
	chunks: Array<Array<Array<String>>>
	limit: Array<Integer>
	used: Array<Integer>
end

def gate4_storage_chunk_size(): Integer
	return 256
end

def gate4_integer_chunk(): Array<Integer>
	mut values: Array<Integer> := []
	mut index := 0
	while index < gate4_storage_chunk_size()
		values.push(0)
		index += 1
	end
	return values
end

def gate4_string_chunk(): Array<String>
	mut values: Array<String> := []
	mut index := 0
	while index < gate4_storage_chunk_size()
		values.push("")
		index += 1
	end
	return values
end

def gate4_integer_storage(capacity: Integer): Gate4IntegerStorage
	return Gate4IntegerStorage.new(chunks: [[]], limit: [capacity], used: [0])
end

def gate4_string_storage(capacity: Integer): Gate4StringStorage
	return Gate4StringStorage.new(chunks: [[]], limit: [capacity], used: [0])
end

def gate4_store_integer(mut storage: Gate4IntegerStorage, index: Integer, value: Integer): Boolean
	if index < 0
		return false
	end
	if index >= storage.limit[0]
		return false
	end
	chunk_size := gate4_storage_chunk_size()
	chunk_index := index / chunk_size
	mut chunks := storage.chunks[0]
	while chunks.size() <= chunk_index
		chunks.push([])
	end
	storage.chunks[0] = chunks
	if storage.chunks[0][chunk_index].size() == 0
		storage.chunks[0][chunk_index] = gate4_integer_chunk()
	end
	storage.chunks[0][chunk_index][index % chunk_size] = value
	if index >= storage.used[0]
		storage.used[0] = index + 1
	end
	return true
end

def gate4_store_string(mut storage: Gate4StringStorage, index: Integer, value: String): Boolean
	if index < 0
		return false
	end
	if index >= storage.limit[0]
		return false
	end
	chunk_size := gate4_storage_chunk_size()
	chunk_index := index / chunk_size
	mut chunks := storage.chunks[0]
	while chunks.size() <= chunk_index
		chunks.push([])
	end
	storage.chunks[0] = chunks
	if storage.chunks[0][chunk_index].size() == 0
		storage.chunks[0][chunk_index] = gate4_string_chunk()
	end
	storage.chunks[0][chunk_index][index % chunk_size] = value
	if index >= storage.used[0]
		storage.used[0] = index + 1
	end
	return true
end

def gate4_load_integer(storage: Gate4IntegerStorage, index: Integer): Integer
	chunk_size := gate4_storage_chunk_size()
	return storage.chunks[0][index / chunk_size][index % chunk_size]
end

def gate4_load_string(storage: Gate4StringStorage, index: Integer): String
	chunk_size := gate4_storage_chunk_size()
	return storage.chunks[0][index / chunk_size][index % chunk_size]
end
