import { Gate4MirArrayOperation, Gate4MirBlock, Gate4MirFunction, Gate4MirInstruction, Gate4MirModule, Gate4MirValue, gate4_optimize_verified_mir, gate4_verify_mir } from mir
import { describe, expect, test } from trb/std/test

def gate4_mir_test_instruction_with_cell(instruction: Gate4MirInstruction, field: Integer, value: Integer): Gate4MirInstruction
	mut row := [instruction.kind, instruction.result, instruction.first, instruction.second, instruction.payload, instruction.failure, instruction.source_id, instruction.line]
	row[field] = value
	return Gate4MirInstruction.new(kind: row[0], result: row[1], first: row[2], second: row[3], payload: row[4], failure: row[5], source_id: row[6], line: row[7])
end

def gate4_mir_test_module(
		supplied_fact: Boolean,
		invalid_index: Boolean,
	): Gate4MirModule
	mut array_index := 5
	if invalid_index
		array_index = 99
	end
	mut facts: Array<Array<Integer>> := []
	if supplied_fact
		facts.push([1])
	end
	return Gate4MirModule.new(
		source_count: [1],
		entry_function: [1],
		functions: [Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5)],
		blocks: [
			Gate4MirBlock.new(id: 10, source_id: 0, line: 2, parameter_start: 1, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: 1, condition: - 1, first_target: 11, second_target: - 1, first_argument_start: 1, first_argument_count: 1, second_argument_start: 0, second_argument_count: 0, return_value: - 1),
			Gate4MirBlock.new(id: 11, source_id: 0, line: 3, parameter_start: 2, parameter_count: 1, instruction_start: 1, instruction_count: 2, terminator: 2, condition: 4, first_target: 12, second_target: 14, first_argument_start: 3, first_argument_count: 1, second_argument_start: 4, second_argument_count: 0, return_value: - 1),
			Gate4MirBlock.new(id: 12, source_id: 0, line: 4, parameter_start: 4, parameter_count: 1, instruction_start: 3, instruction_count: 3, terminator: 1, condition: - 1, first_target: 11, second_target: - 1, first_argument_start: 5, first_argument_count: 1, second_argument_start: 0, second_argument_count: 0, return_value: - 1),
			Gate4MirBlock.new(id: 13, source_id: 0, line: 5, parameter_start: 6, parameter_count: 0, instruction_start: 6, instruction_count: 0, terminator: 4, condition: - 1, first_target: - 1, second_target: - 1, first_argument_start: 0, first_argument_count: 0, second_argument_start: 0, second_argument_count: 0, return_value: - 1),
			Gate4MirBlock.new(id: 14, source_id: 0, line: 6, parameter_start: 6, parameter_count: 0, instruction_start: 6, instruction_count: 0, terminator: 3, condition: - 1, first_target: - 1, second_target: - 1, first_argument_start: 0, first_argument_count: 0, second_argument_start: 0, second_argument_count: 0, return_value: - 1),
		],
		values: [
			Gate4MirValue.new(function_id: 1, id: 0, type_id: 3, source_id: 0, line: 1),
			Gate4MirValue.new(function_id: 1, id: 1, type_id: 1, source_id: 0, line: 2),
			Gate4MirValue.new(function_id: 1, id: 2, type_id: 1, source_id: 0, line: 3),
			Gate4MirValue.new(function_id: 1, id: 3, type_id: 1, source_id: 0, line: 3),
			Gate4MirValue.new(function_id: 1, id: 4, type_id: 2, source_id: 0, line: 3),
			Gate4MirValue.new(function_id: 1, id: 5, type_id: 1, source_id: 0, line: 4),
			Gate4MirValue.new(function_id: 1, id: 6, type_id: 4, source_id: 0, line: 4),
			Gate4MirValue.new(function_id: 1, id: 7, type_id: 1, source_id: 0, line: 4),
			Gate4MirValue.new(function_id: 1, id: 8, type_id: 1, source_id: 0, line: 4),
		],
		instructions: [
			Gate4MirInstruction.new(kind: 1, result: 1, first: - 1, second: - 1, payload: 0, failure: - 1, source_id: 0, line: 2),
			Gate4MirInstruction.new(kind: 4, result: 3, first: 0, second: - 1, payload: 0, failure: - 1, source_id: 0, line: 3),
			Gate4MirInstruction.new(kind: 3, result: 4, first: 2, second: 3, payload: 0, failure: - 1, source_id: 0, line: 3),
			Gate4MirInstruction.new(kind: 5, result: 6, first: 0, second: array_index, payload: 0, failure: 13, source_id: 0, line: 4),
			Gate4MirInstruction.new(kind: 1, result: 7, first: - 1, second: - 1, payload: 1, failure: - 1, source_id: 0, line: 4),
			Gate4MirInstruction.new(kind: 2, result: 8, first: 5, second: 7, payload: 0, failure: 13, source_id: 0, line: 4),
		],
		arguments: [0, 1, 2, 2, 5, 8],
		array_regions: [],
		array_headers: facts,
		literal_texts: [],
	)
end

def gate4_mir_test_block_with_cell(block: Gate4MirBlock, field: Integer, value: Integer): Gate4MirBlock
	mut row := [block.id, block.source_id, block.line, block.parameter_start, block.parameter_count, block.instruction_start, block.instruction_count, block.terminator, block.condition, block.first_target, block.second_target, block.first_argument_start, block.first_argument_count, block.second_argument_start, block.second_argument_count, block.return_value]
	row[field] = value
	return Gate4MirBlock.new(id: row[0], source_id: row[1], line: row[2], parameter_start: row[3], parameter_count: row[4], instruction_start: row[5], instruction_count: row[6], terminator: row[7], condition: row[8], first_target: row[9], second_target: row[10], first_argument_start: row[11], first_argument_count: row[12], second_argument_start: row[13], second_argument_count: row[14], return_value: row[15])
end

describe("Native MIR model and verifier") do
	test("verifies a checked scalar and Array loop MIR skeleton") do
		native_module := gate4_mir_test_module(false, false)
		expect(gate4_verify_mir(native_module, false)).to_equal("")
	end

	test("rejects an undefined MIR Array index") do
		native_module := gate4_mir_test_module(false, true)
		expect(gate4_verify_mir(native_module, false)).to_equal("MIR Array address type differs")
	end

	test("rejects supplied MIR optimization facts") do
		native_module := gate4_mir_test_module(true, false)
		expect(gate4_verify_mir(native_module, false)).to_equal(
			"MIR input cannot supply optimization facts",
		)
	end

	test("rejects missing or extra optimized Array-header facts") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.array_regions.push([Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 13)])
		expect(gate4_verify_mir(native_module, true)).to_equal("MIR optimized Array-header fact is invalid")
		native_module.array_headers.push([0])
		native_module.array_headers.push([13])
		expect(gate4_verify_mir(native_module, true)).to_equal("MIR optimized Array-header fact is invalid")
	end

	test("rejects a forged optimized Array-header parameter ordinal") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.array_regions.push([Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 13)])
		native_module.array_headers.push([11])
		expect(gate4_verify_mir(native_module, true)).to_equal("MIR optimized Array-header fact is invalid")
	end

	test("derives only Array-header identity from raw parameters and operations") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.array_regions.push([Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 13)])
		expect(gate4_verify_mir(native_module, false)).to_equal("")
		gate4_optimize_verified_mir(native_module)
		expect(native_module.array_headers).to_equal([[0]])
		expect(gate4_verify_mir(native_module, true)).to_equal("")
		gate4_optimize_verified_mir(native_module)
		expect(native_module.array_headers).to_equal([[0]])
		expect(gate4_verify_mir(native_module, true)).to_equal("")
	end

	test("rejects forged Array-header facts after raw parameters or accesses change") do
		changes := [[0, 0], [2, 1]]
		mut index := 0
		while index < changes.size()
			mut native_module := gate4_mir_test_module(false, false)
			mut region := [Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 1, operand: 2, origin: 11), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 13)]
			native_module.array_regions.push(region)
			gate4_optimize_verified_mir(native_module)
			operation := region[changes[index][0]]
			region[changes[index][0]] = Gate4MirArrayOperation.new(kind: operation.kind, operand: changes[index][1], origin: operation.origin)
			if index == 0
				expect(gate4_verify_mir(native_module, true)).to_equal("MIR Array region is invalid")
			else
				expect(gate4_verify_mir(native_module, true)).to_equal("MIR optimized Array-header fact is invalid")
			end
			index += 1
		end
	end

	test("rejects forged Array-header facts across opaque effects") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.array_regions.push([Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 13), Gate4MirArrayOperation.new(kind: 6, operand: 0, origin: 14)])
		native_module.array_headers.push([0])
		expect(gate4_verify_mir(native_module, true)).to_equal("MIR optimized Array-header fact is invalid")
	end

	test("retains distinct Array parameter identities across repeated accesses") do
		mut native_module := gate4_mir_test_module(false, false)
		region := [Gate4MirArrayOperation.new(kind: 1, operand: 2, origin: 10), Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 11), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 13), Gate4MirArrayOperation.new(kind: 4, operand: 1, origin: 15), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 16)]
		native_module.array_regions.push(region)
		expect(gate4_verify_mir(native_module, false)).to_equal("")
		gate4_optimize_verified_mir(native_module)
		expect(native_module.array_headers).to_equal([[0, 1]])
		expect(gate4_verify_mir(native_module, true)).to_equal("")
	end

	test("verifies complete unique Array-header lists including mutable bindings") do
		mut native_module := gate4_mir_test_module(false, false)
		region := [Gate4MirArrayOperation.new(kind: 1, operand: 2, origin: 10), Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 11), Gate4MirArrayOperation.new(kind: 2, operand: 2, origin: 20), Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 25), Gate4MirArrayOperation.new(kind: 4, operand: 1, origin: 26), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 27), Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 28)]
		native_module.array_regions.push(region)
		expect(gate4_verify_mir(native_module, false)).to_equal("")
		gate4_optimize_verified_mir(native_module)
		expect(native_module.array_headers).to_equal([[2, 1, 0]])
		expect(gate4_verify_mir(native_module, true)).to_equal("")
		forged: Array<Array<Integer>> := [[2, 1], [2, 1, 0, 0], [0, 1, 2], [2, 1, 3], []]
		mut index := 0
		while index < forged.size()
			native_module.array_headers[0] = forged[index]
			expect(gate4_verify_mir(native_module, true)).to_equal("MIR optimized Array-header fact is invalid")
			index += 1
		end
		gate4_optimize_verified_mir(native_module)
		expect(native_module.array_headers).to_equal([[2, 1, 0]])
		expect(gate4_verify_mir(native_module, true)).to_equal("")
	end

	test("verifies immutable local header declarations and preserves outer scope identity") do
		mut native_module := gate4_mir_test_module(false, false)
		mut region := [Gate4MirArrayOperation.new(kind: 1, operand: 0, origin: 10), Gate4MirArrayOperation.new(kind: 2, operand: 2, origin: 20), Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 25), Gate4MirArrayOperation.new(kind: 3, operand: 3, origin: 30), Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 35)]
		native_module.array_regions.push(region)
		expect(gate4_verify_mir(native_module, false)).to_equal("")
		gate4_optimize_verified_mir(native_module)
		expect(native_module.array_headers).to_equal([[1]])
		expect(gate4_verify_mir(native_module, true)).to_equal("")
		region[1] = Gate4MirArrayOperation.new(kind: 2, operand: 3, origin: 20)
		expect(gate4_verify_mir(native_module, true)).to_equal("MIR Array region is invalid")
	end

	test("rejects local header access before declaration and after scope exit") do
		declaration := Gate4MirArrayOperation.new(kind: 2, operand: 2, origin: 20)
		access := Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 25)
		exit_scope := Gate4MirArrayOperation.new(kind: 3, operand: 2, origin: 24)
		regions := [[access, declaration], [declaration, exit_scope, access], [declaration, Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 20)], [Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 2, operand: 0, origin: 20)]]
		mut index := 0
		while index < regions.size()
			mut native_module := gate4_mir_test_module(false, false)
			native_module.array_regions.push(regions[index])
			expect(gate4_verify_mir(native_module, false)).to_equal("MIR Array region is invalid")
			index += 1
		end
	end

	test("does not retain local header facts across effects or recycled lexical slots") do
		declaration := Gate4MirArrayOperation.new(kind: 2, operand: 2, origin: 20)
		access := Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 25)
		barriers := [Gate4MirArrayOperation.new(kind: 6, operand: 0, origin: 30), Gate4MirArrayOperation.new(kind: 3, operand: 2, origin: 30)]
		mut index := 0
		while index < barriers.size()
			mut native_module := gate4_mir_test_module(false, false)
			native_module.array_regions.push([declaration, access, barriers[index], Gate4MirArrayOperation.new(kind: 2, operand: 2, origin: 40), Gate4MirArrayOperation.new(kind: 5, operand: 2, origin: 45)])
			expect(gate4_verify_mir(native_module, false)).to_equal("")
			gate4_optimize_verified_mir(native_module)
			expect(native_module.array_headers).to_equal([[]])
			native_module.array_headers[0] = [0]
			expect(gate4_verify_mir(native_module, true)).to_equal("MIR optimized Array-header fact is invalid")
			index += 1
		end
	end

	test("rejects malformed raw Array regions") do
		regions := [
			[Gate4MirArrayOperation.new(kind: 1, operand: 3, origin: 10)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 1, operand: 0, origin: 10)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 1, operand: 0, origin: 9)],
			[Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 10), Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 11)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 12), Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 13)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: 99, origin: 13)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 9007199254740991, origin: 10)],
			[Gate4MirArrayOperation.new(kind: 1, operand: - 9007199254740991, origin: 10)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: - 1)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 0, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: 0, origin: 11)],
			[Gate4MirArrayOperation.new(kind: 1, operand: 1, origin: 10), Gate4MirArrayOperation.new(kind: 4, operand: - 1, origin: 11)],
			[Gate4MirArrayOperation.new(kind: 6, operand: 1, origin: 12)],
			[Gate4MirArrayOperation.new(kind: 5, operand: 0, origin: 12)],
			[Gate4MirArrayOperation.new(kind: 7, operand: 0, origin: 12)],
			[Gate4MirArrayOperation.new(kind: 0, operand: 0, origin: 12)],
		]
		mut index := 0
		while index < regions.size()
			mut native_module := gate4_mir_test_module(false, false)
			native_module.array_regions.push(regions[index])
			expect(gate4_verify_mir(native_module, false)).to_equal("MIR Array region is invalid")
			index += 1
		end
	end
end

describe("Native MIR value carrier semantics") do
	test("rejects invalid value identities, types, origins and absent definitions") do
		rows := [
			Gate4MirValue.new(function_id: 99, id: 0, type_id: 3, source_id: 0, line: 1),
			Gate4MirValue.new(function_id: 1, id: - 1, type_id: 3, source_id: 0, line: 1),
			Gate4MirValue.new(function_id: 1, id: 0, type_id: 0, source_id: 0, line: 1),
			Gate4MirValue.new(function_id: 1, id: 0, type_id: 8, source_id: 0, line: 1),
			Gate4MirValue.new(function_id: 1, id: 0, type_id: 3, source_id: 1, line: 1),
			Gate4MirValue.new(function_id: 1, id: 0, type_id: 3, source_id: 0, line: 0),
			Gate4MirValue.new(function_id: 1, id: 99, type_id: 3, source_id: 0, line: 1),
		]
		expected := [
			"MIR value identity is invalid", "MIR value identity is invalid",
			"MIR value type is invalid", "MIR value type is invalid",
			"MIR value origin is invalid", "MIR value origin is invalid",
			"MIR value definition count differs",
		]
		mut index := 0
		while index < rows.size()
			mut native_module := gate4_mir_test_module(false, false)
			native_module.values[0] = rows[index]
			expect(gate4_verify_mir(native_module, false)).to_equal(expected[index])
			index += 1
		end
	end

	test("rejects repeated value identities independently of instruction definitions") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.values.push(Gate4MirValue.new(function_id: 1, id: 0, type_id: 3, source_id: 0, line: 1))
		expect(gate4_verify_mir(native_module, false)).to_equal("MIR value is defined more than once")
	end
end

describe("Native MIR function carrier invariants") do
	test("rejects malformed function identity, origin, entry and ranges") do
		rows := [
			Gate4MirFunction.new(integer_guard: 0, id: - 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: - 1, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 1, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 0, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: - 1, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 99, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: - 1, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 7, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 99, parameter_count: 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: - 1, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 7, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 9007199254740991, block_start: 0, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: - 1, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 6, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 99, block_count: 5),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: - 1),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 6),
			Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 9007199254740991),
		]
		expected := [
			"MIR function identifier is invalid",
			"MIR function origin is invalid",
			"MIR function origin is invalid",
			"MIR function origin is invalid",
			"MIR function entry block does not exist",
			"MIR function entry block does not exist",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function parameter range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
			"MIR function block range is invalid",
		]
		mut index := 0
		while index < rows.size()
			mut native_module := gate4_mir_test_module(false, false)
			native_module.functions[0] = rows[index]
			expect(gate4_verify_mir(native_module, false)).to_equal(expected[index])
			expect(gate4_verify_mir(native_module, true)).to_equal(expected[index])
			index += 1
		end
	end

	test("rejects duplicate function identities") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.functions.push(native_module.functions[0])
		expect(gate4_verify_mir(native_module, false)).to_equal("MIR function identifier is duplicated")
	end

	test("rejects malformed block ranges before traversing value definitions or targets") do
		fields := [3, 4, 5, 6, 11, 12, 13, 14]
		messages := [
			"MIR block parameter range is invalid", "MIR block parameter range is invalid",
			"MIR block instruction range is invalid", "MIR block instruction range is invalid",
			"MIR terminator argument range is invalid", "MIR terminator argument range is invalid",
			"MIR alternate argument range is invalid", "MIR alternate argument range is invalid",
		]
		invalid := [- 1, 99, 9007199254740991]
		mut index := 0
		while index < fields.size()
			mut value_index := 0
			while value_index < invalid.size()
				mut native_module := gate4_mir_test_module(false, false)
				native_module.blocks[0] = gate4_mir_test_block_with_cell(native_module.blocks[0], fields[index], invalid[value_index])
				expect(gate4_verify_mir(native_module, false)).to_equal(messages[index])
				expect(gate4_verify_mir(native_module, true)).to_equal(messages[index])
				value_index += 1
			end
			index += 1
		end
	end

end

describe("Native MIR block carrier semantics") do
	test("preserves block origins, identities, terminators and successor checks") do
		changes := [
			[0, 1, - 1],
			[0, 1, 1],
			[0, 2, 0],
			[0, 7, 99],
			[0, 8, 0],
			[0, 9, 99],
			[0, 10, 12],
			[0, 12, 0],
			[1, 8, 99],
			[1, 10, 99],
			[4, 15, 99],
			[3, 11, 1],
		]
		expected := [
			"MIR block origin is invalid",
			"MIR block origin is invalid",
			"MIR block origin is invalid",
			"MIR terminator kind is unsupported",
			"MIR jump shape differs",
			"MIR terminator target does not exist",
			"MIR jump shape differs",
			"MIR block argument arity differs",
			"MIR branch shape differs",
			"MIR terminator target does not exist",
			"MIR return value is undefined",
			"MIR trap shape differs",
		]
		mut index := 0
		while index < changes.size()
			mut native_module := gate4_mir_test_module(false, false)
			change := changes[index]
			native_module.blocks[change[0]] = gate4_mir_test_block_with_cell(native_module.blocks[change[0]], change[1], change[2])
			expect(gate4_verify_mir(native_module, false)).to_equal(expected[index])
			expect(gate4_verify_mir(native_module, true)).to_equal(expected[index])
			index += 1
		end
	end
end

describe("Native MIR duplicate block identity") do
	test("rejects a duplicate trap block without duplicated definitions") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.blocks.push(native_module.blocks[3])
		native_module.functions[0] = Gate4MirFunction.new(integer_guard: 0, id: 1, entry_block: 10, source_id: 0, line: 1, parameter_start: 0, parameter_count: 1, block_start: 0, block_count: 6)
		expect(gate4_verify_mir(native_module, false)).to_equal("MIR block identifier is duplicated")
		expect(gate4_verify_mir(native_module, true)).to_equal("MIR block identifier is duplicated")
	end
end

describe("Native MIR instruction carrier semantics") do
	test("preserves instruction kind, origin, operands, payload and failure checks") do
		changes := [[0, 0, 99], [0, 1, 99], [0, 2, 0], [0, 3, 0], [0, 5, 13], [0, 6, 1], [0, 7, 0], [1, 2, 99], [1, 4, 1], [2, 2, 99], [2, 4, 1], [3, 3, 99], [3, 4, 3], [3, 5, 99], [3, 5, 14], [5, 2, 8], [5, 4, 1]]
		expected := [
			"MIR instruction kind is unsupported", "MIR value definition count differs",
			"MIR Integer constant shape differs", "MIR Integer constant shape differs", "MIR Integer constant shape differs",
			"MIR instruction origin is invalid", "MIR instruction origin is invalid",
			"MIR Array length type differs", "MIR Array length shape differs",
			"MIR Integer comparison type differs", "MIR Integer comparison shape differs",
			"MIR Array address type differs", "MIR Array address shape differs",
			"MIR failure target does not exist", "MIR failure target is not a trap block",
			"MIR checked Integer add type differs", "MIR checked Integer add shape differs",
		]
		mut index := 0
		while index < changes.size()
			mut native_module := gate4_mir_test_module(false, false)
			change := changes[index]
			native_module.instructions[change[0]] = gate4_mir_test_instruction_with_cell(native_module.instructions[change[0]], change[1], change[2])
			expect(gate4_verify_mir(native_module, false)).to_equal(expected[index])
			expect(gate4_verify_mir(native_module, true)).to_equal(expected[index])
			index += 1
		end
	end
end

describe("Native MIR instruction replacement") do
	test("retains instruction snapshots across repeated verified rewrites") do
		mut native_module := gate4_mir_test_module(false, false)
		native_module.instructions[5] = Gate4MirInstruction.new(kind: 7, result: 8, first: 5, second: 7, payload: 1, failure: 13, source_id: 0, line: 4)
		original := native_module.instructions[5]
		expect(gate4_verify_mir(native_module, false)).to_equal("")
		gate4_optimize_verified_mir(native_module)
		expect(original.payload).to_equal(1)
		expect(native_module.instructions[5]).to_equal(Gate4MirInstruction.new(kind: 7, result: 8, first: 5, second: 7, payload: 13, failure: 13, source_id: 0, line: 4))
		expect(gate4_verify_mir(native_module, true)).to_equal("")
		rewritten := native_module.instructions[5]
		gate4_optimize_verified_mir(native_module)
		expect(native_module.instructions[5]).to_equal(rewritten)
		expect(gate4_verify_mir(native_module, true)).to_equal("")
	end
end
