import { QbeOutput, qbe_output_line } from qbe_output

# Literal transforms preserve bytes, including NUL and malformed UTF-8.
# Searches are bounded; split releases temporary roots after each managed append.
# Replacement measures the complete result before its single String allocation.
def emit_string_transform_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\ndata $trbn_split_error = { b \"panic: String split separator is empty\", b 10 }\ndata $trbn_replace_error = { b \"panic: String replacement pattern is empty\", b 10 }\nfunction l $trbn_string_find_bytes(l %source, l %pattern, l %start) {\n@start\n %source_length_slot =l add %source, 8\n %pattern_length_slot =l add %pattern, 8\n %length =l loadl %source_length_slot\n %width =l loadl %pattern_length_slot\n %limit =l sub %length, %width\n %data =l add %source, 24\n %needle =l add %pattern, 24\n %first =w loadub %needle\n jmp @search\n@search\n %offset =l phi @start %start, @advance %next\n %past =w csgtl %offset, %limit\n jnz %past, @missing, @locate\n@locate\n %from =l add %data, %offset\n %remaining =l sub %limit, %offset\n %available =l add %remaining, 1\n %candidate =l call $memchr(l %from, w %first, l %available)\n %absent =w ceql %candidate, 0\n jnz %absent, @missing, @compare\n@compare\n %comparison =w call $memcmp(l %candidate, l %needle, l %width)\n %position =l sub %candidate, %data\n jnz %comparison, @advance, @found\n@advance\n %next =l add %position, 1\n jmp @search\n@found\n ret %position\n@missing\n ret -1\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_string_split(l %source, l %separator) {\n@start\n %separator_length_slot =l add %separator, 8\n %width =l loadl %separator_length_slot\n %empty =w ceql %width, 0\n jnz %empty, @failure, @prepare\n@failure\n call $trbn_fail(l $trbn_split_error, l 39)\n hlt\n@prepare\n %length_slot =l add %source, 8\n %length =l loadl %length_slot\n %data =l add %source, 24\n %result =l call $trbn_array_new(l $trbn_desc_array_managed)\n %retained =l loadl $trbn_gc_temp_count\n jmp @loop\n@loop\n %start =l phi @prepare 0, @advance %next\n %match =l call $trbn_string_find_bytes(l %source, l %separator, l %start)\n %missing =w csltl %match, 0\n jnz %missing, @tail, @part\n@tail\n jmp @append\n@part\n jmp @append\n@append\n %end =l phi @tail %length, @part %match\n %size =l sub %end, %start\n %from =l add %data, %start\n %text =l call $trbn_string_from_bytes(l %from, l %size)\n call $trbn_array_push_paced(l %result, l %text)\n call $trbn_gc_temp_reset(l %retained)\n jnz %missing, @finish, @advance\n@advance\n %next =l add %end, %width\n jmp @loop\n@finish\n ret %result\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_string_replace(l %source, l %pattern, l %replacement) {\n@start\n %pattern_length_slot =l add %pattern, 8\n %width =l loadl %pattern_length_slot\n %empty =w ceql %width, 0\n jnz %empty, @failure, @prepare\n@failure\n call $trbn_fail(l $trbn_replace_error, l 43)\n hlt\n@prepare\n %length_slot =l add %source, 8\n %length =l loadl %length_slot\n %replacement_length_slot =l add %replacement, 8\n %replacement_length =l loadl %replacement_length_slot\n %data =l add %source, 24\n %replacement_data =l add %replacement, 24\n jmp @measure\n@measure\n %offset =l phi @prepare 0, @measured %next_offset\n %count =l phi @prepare 0, @measured %next_count\n %found =l call $trbn_string_find_bytes(l %source, l %pattern, l %offset)\n %done =w csltl %found, 0\n jnz %done, @size, @measured\n@measured\n %next_offset =l add %found, %width\n %next_count =l add %count, 1\n jmp @measure\n@size\n %unchanged =w ceql %count, 0\n jnz %unchanged, @original, @capacity\n@original\n ret %source\n@capacity\n %removed =l mul %count, %width\n %base =l sub %length, %removed\n %deletion =w ceql %replacement_length, 0\n jnz %deletion, @allocate, @growth\n@growth\n %room =l sub 9007199254740974, %base\n %maximum =l div %room, %replacement_length\n %too_large =w csgtl %count, %maximum\n jnz %too_large, @overflow, @allocate\n@overflow\n call $trbn_fail(l $trbn_allocation_error, l 26)\n hlt\n@allocate\n %added =l mul %count, %replacement_length\n %size =l add %base, %added\n %payload =l add %size, 17\n %result =l call $trbn_string_alloc(l %payload)\n %result_length_slot =l add %result, 8\n storel %size, %result_length_slot\n %result_data =l add %result, 24\n jmp @copy\n@copy\n %start =l phi @allocate 0, @copied %next_start\n %position =l phi @allocate 0, @copied %next_position\n %match =l call $trbn_string_find_bytes(l %source, l %pattern, l %start)\n %missing =w csltl %match, 0\n jnz %missing, @tail, @part\n@tail\n jmp @span\n@part\n jmp @span\n@span\n %end =l phi @tail %length, @part %match\n %span =l sub %end, %start\n %from =l add %data, %start\n %target =l add %result_data, %position\n call $memcpy(l %target, l %from, l %span)\n %after_span =l add %position, %span\n jnz %missing, @finish, @copied\n@copied\n %replacement_target =l add %result_data, %after_span\n call $memcpy(l %replacement_target, l %replacement_data, l %replacement_length)\n %next_position =l add %after_span, %replacement_length\n %next_start =l add %end, %width\n jmp @copy\n@finish\n %terminator =l add %result_data, %size\n storeb 0, %terminator\n %points =l call $trbn_utf8_count(l %result_data, l %size)\n %points_slot =l add %result, 16\n storel %points, %points_slot\n ret %result\n}\n")
end
