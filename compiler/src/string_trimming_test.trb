import { check } from compiler
import { compiler_test_instruction_with_cell } from compiler_test
import { managed_mir_test_fixture } from hash_value_mir_test
import { logical_checked_source } from logical_test
import { MirRootPlan } from mir
import { mir_instruction_effects } from mir_roots
import { verify_mir } from mir_verifier
import { describe, expect, test } from trb/std/test

describe("String trimming MIR") do
	test("executes directional empty and optional trims after source erasure and block reordering") do
		managed_mir_test_fixture("string-trimming-mir", 8)
	end
	test("retains receivers and results across callbacks containers and collection") do
		managed_mir_test_fixture("string-trimming-managed-mir", 10)
	end
	test("rejects invalid types operands modes and failure shapes") do
		mut mutation := 0
		while mutation < 9
			mut state := logical_checked_source("def main()\nnumber := 1\nputs((\" value \" + \" \" ).strip())\nputs(number)\nend\n")
			expect(check(state)).to_be_true()
			mut index := 0
			while index < state.scalar_mir.instructions.size() && state.scalar_mir.instructions[index].kind != 50
				index += 1
			end
			expect(index < state.scalar_mir.instructions.size()).to_be_true()
			instruction := state.scalar_mir.instructions[index]
			expect(mir_instruction_effects(state.scalar_mir, instruction)).to_equal(9)
			mut cell := mutation
			mut value := 999999
			if mutation == 0
				value = 51
			elsif mutation == 2
				value = 0
			elsif mutation == 3
				value = instruction.first
			elsif mutation == 4
				value = 3
			elsif mutation == 5
				value = 0
			elsif mutation == 6
				cell = 2
				value =- 1
			elsif mutation == 7
				cell = 4
				value =- 1
			elsif mutation == 8
				cell = 2
				value = instruction.result
			end
			state.scalar_mir.instructions[index] = compiler_test_instruction_with_cell(instruction, cell, value)
			expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
			mutation += 1
		end
	end
	test("requires the input String to remain rooted during result allocation") do
		mut state := logical_checked_source("def main()\nputs((\" value \" + \" \" ).strip())\nend\n")
		expect(check(state)).to_be_true()
		plan := state.scalar_mir.root_plans[0]
		mut point := 0
		while state.scalar_mir.instructions[plan.instructions[point]].kind != 50
			point += 1
		end
		expect(plan.roots[point].size()).to_equal(1)
		mut roots := plan.roots
		roots[point] = []
		state.scalar_mir.root_plans[0] = MirRootPlan.new(function_id: plan.function_id, instructions: plan.instructions, roots: roots, capacity: plan.capacity)
		expect(verify_mir(state.scalar_mir, true)).to_equal("MIR live root plan differs")
	end
end
