import { native_write_text } from project/native_file_system
import trb/std/process
import trb/std/result

def logical_run_qbe(qbe_path: String, source: String): Result<String, String>
	return logical_run_qbe_arguments(qbe_path, source, [])
end

def logical_run_qbe_arguments(qbe_path: String, source: String, arguments: Array<String>): Result<String, String>
	allocated := case Process.run("/usr/bin/mktemp", ["-d", "/tmp/type-rb-native-logical-layout.XXXXXX"])
	when Result::Ok(result)
		result
	when Result::Err(error)
		return Result<String, String>::Err(error.message)
	end
	if !allocated.success
		return Result<String, String>::Err(allocated.stderr)
	end
	workspace := allocated.stdout.strip()
	case native_write_text(workspace + "/module.ssa", source)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<String, String>::Err(error.message)
	end
	assembled := case Process.run(qbe_path, ["-t", "arm64_apple", workspace + "/module.ssa"])
	when Result::Ok(result)
		result
	when Result::Err(error)
		return Result<String, String>::Err(error.message)
	end
	if !assembled.success
		return Result<String, String>::Err(assembled.stderr)
	end
	case native_write_text(workspace + "/module.s", assembled.stdout)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<String, String>::Err(error.message)
	end
	linked := case Process.run("/usr/bin/cc", [workspace + "/module.s", "-lm", "-o", workspace + "/program"])
	when Result::Ok(result)
		result
	when Result::Err(error)
		return Result<String, String>::Err(error.message)
	end
	if !linked.success
		return Result<String, String>::Err(linked.stderr)
	end
	case Process.run(workspace + "/program", arguments)
	when Result::Ok(result)
		if !result.success || !result.stderr.empty?()
			return Result<String, String>::Err(result.stderr)
		end
		case Process.run("/bin/rm", ["-r", workspace])
		when Result::Ok(cleanup)
			if !cleanup.success
				return Result<String, String>::Err(cleanup.stderr)
			end
		when Result::Err(error)
			return Result<String, String>::Err(error.message)
		end
		return Result<String, String>::Ok(result.stdout)
	when Result::Err(error)
		return Result<String, String>::Err(error.message)
	end
end
