import { check } from compiler
import { lex } from frontend/syntax/lexer
import { parse_module } from frontend/syntax/parser
import { resolve } from frontend/checking/program/resolution
import { CompilerState, compiler_new } from state/state
import { load_string } from support/storage
import { QbeOutput } from backend/qbe/output

def control_test_state(body: String): CompilerState
	source := "def choose(value: Integer): Integer\n" + body + "\nend\ndef main()\n\tputs(choose(3))\n\treturn\nend\n"
	mut state := compiler_new(source.size() * 3 + 16)
	lex(state, source)
	parse_module(state, 0, state.module_graph.entry_module[0])
	resolve(state)
	check(state)
	return state
end

def control_test_output(output: QbeOutput): String
	mut text := ""
	mut index := 0
	while index < output.lines.used[0]
		text += load_string(output.lines, index) + "\n"
		index += 1
	end
	return text
end
