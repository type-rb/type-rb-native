import { QbeOutput, qbe_output_line } from qbe_output

# Key flags come from verified MIR: bit 0 selects String content, and bit 2
# retains a union object whose payload belongs to that same scalar domain.
# Buckets keep the original object so snapshots retain its checked type and root.
def emit_hash_key_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\nfunction l $trbn_hash_key(l %table, l %key) {\n@start\n %flags_slot =l add %table, 40\n %flags =l loadl %flags_slot\n %managed =l and %flags, 5\n jnz %managed, @managed, @integer\n@managed\n ret %key\n@integer\n %encoded =l add %key, 9007199254740992\n ret %encoded\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_hash_code(l %key, l %string) {\n@start\n jnz %string, @string, @integer\n@integer\n %shift1 =l shr %key, 30\n %xor1 =l xor %key, %shift1\n %mix1 =l mul %xor1, 13787848793156543929\n %shift2 =l shr %mix1, 27\n %xor2 =l xor %mix1, %shift2\n %mix2 =l mul %xor2, 10723151780598845931\n %shift3 =l shr %mix2, 31\n %result =l xor %mix2, %shift3\n ret %result\n@string\n %length_slot =l add %key, 8\n %length =l loadl %length_slot\n %data =l add %key, 24\n jmp @loop\n@loop\n %index =l phi @string 0, @byte %next\n %hash =l phi @string 14695981039346656037, @byte %next_hash\n %done =w ceql %index, %length\n jnz %done, @finish, @byte\n@byte\n %address =l add %data, %index\n %byte =w loadub %address\n %wide =l extuw %byte\n %xored =l xor %hash, %wide\n %next_hash =l mul %xored, 1099511628211\n %next =l add %index, 1\n jmp @loop\n@finish\n ret %hash\n}\n")
	qbe_output_line(output, "\nfunction l $trbn_hash_slot(l %table, l %key) {\n@start\n %capacity_slot =l add %table, 16\n %capacity =l loadl %capacity_slot\n %empty =w ceql %capacity, 0\n jnz %empty, @empty, @prepare\n@empty\n ret -1\n@prepare\n %mask =l sub %capacity, 1\n %keys_slot =l add %table, 24\n %keys =l loadl %keys_slot\n %data_slot =l add %keys, 24\n %data =l loadl %data_slot\n %flags_slot =l add %table, 40\n %flags =l loadl %flags_slot\n %string =l and %flags, 1\n %managed =l and %flags, 5\n %boxed =l and %flags, 4\n jnz %boxed, @boxed_query, @direct_query\n@boxed_query\n %query_slot =l add %key, 16\n %query_payload =l loadl %query_slot\n jmp @key_ready\n@direct_query\n jmp @key_ready\n@key_ready\n %query =l phi @boxed_query %query_payload, @direct_query %key\n %hash =l call $trbn_hash_code(l %query, l %string)\n %initial =l and %hash, %mask\n jmp @probe\n@probe\n %index =l phi @key_ready %initial, @advance %next\n %first =l phi @key_ready -1, @advance %next_first\n %scaled =l mul %index, 8\n %address =l add %data, %scaled\n %stored =l loadl %address\n %vacant =w ceql %stored, 0\n jnz %vacant, @vacant, @occupied\n@occupied\n %integer_tomb =w ceql %stored, -1\n %string_tomb_match =w ceql %stored, $trbn_hash_tombstone\n %is_string =w cnel %managed, 0\n %string_tomb =w and %is_string, %string_tomb_match\n %tomb =w or %integer_tomb, %string_tomb\n jnz %tomb, @deleted, @compare\n@deleted\n %unset =w csltl %first, 0\n jnz %unset, @remember, @retain\n@remember\n jmp @advance\n@retain\n jmp @advance\n@compare\n %identity =w ceql %stored, %key\n jnz %identity, @found, @content\n@content\n jnz %boxed, @boxed_stored, @direct_stored\n@boxed_stored\n %stored_slot =l add %stored, 16\n %stored_payload =l loadl %stored_slot\n jmp @values_ready\n@direct_stored\n jmp @values_ready\n@values_ready\n %stored_value =l phi @boxed_stored %stored_payload, @direct_stored %stored\n jnz %string, @strings, @integers\n@integers\n %integer_same =w ceql %stored_value, %query\n jnz %integer_same, @found, @different\n@strings\n %same =l call $trbn_string_equal(l %stored_value, l %query)\n jnz %same, @found, @different\n@different\n jmp @advance\n@advance\n %next_first =l phi @remember %index, @retain %first, @different %first\n %increment =l add %index, 1\n %next =l and %increment, %mask\n jmp @probe\n@found\n ret %index\n@vacant\n %has_deleted =w cslel 0, %first\n jnz %has_deleted, @use_deleted, @use_vacant\n@use_deleted\n %deleted_result =l sub -1, %first\n ret %deleted_result\n@use_vacant\n %vacant_result =l sub -1, %index\n ret %vacant_result\n}\n")
end
