import { ObjectInstance } from object_model
import { TypeAliasInstance } from alias_model
import { generic_application } from generic_arguments
import { integer_string } from literals
import { GenericBinding, GenericFunctionInstance, GenericInstance } from generic_model
import { EnumDefinition, EnumField, EnumVariant } from enum_model
import { CompilerState, CompilerTypeResolution, DefaultInitializer, compiler_module_graph_fork, compiler_new, function_index_key } from state
import { integer_storage_copy, load_integer, load_string, string_storage_copy } from storage

# Template validation uses the ordinary checker with abstract parameter identities.
# It shares immutable parsed syntax and owns all mutable semantic catalogs.
# No synthetic source, token substitution, runtime layout or fallback is involved.
def generic_program_fork(state: CompilerState): CompilerState
	fresh := compiler_new(state.token_kinds.limit[0])
	mut object_instances: Array<ObjectInstance> := []
	mut object_instance_lookup: Hash<String, Integer> := {}
	state.object_instances.each do |value|
		object_instance_lookup[generic_application(integer_string(value.definition), value.arguments)] = object_instances.size()
		object_instances.push(value)
	end
	mut alias_instances: Array<TypeAliasInstance> := []
	mut alias_lookup: Hash<String, Integer> := {}
	mut alias_index := 0
	state.type_resolution.alias_instances.each do |instance|
		alias_instances.push(instance)
		alias_lookup[generic_application(integer_string(instance.definition), instance.arguments)] = alias_index
		alias_index += 1
	end
	mut generic_bindings: Array<GenericBinding> := []
	state.type_resolution.generic_bindings.each do |binding|
		generic_bindings.push(binding)
	end
	mut generic_instances: Array<GenericInstance> := []
	state.type_resolution.generic_instances.each do |value|
		generic_instances.push(value)
	end
	mut generic_instance_lookup: Hash<String, Integer> := {}
	mut instance := 0
	state.type_resolution.generic_instances.each do |value|
		key := generic_application(integer_string(value.definition), value.arguments)
		generic_instance_lookup[key] = instance
		instance += 1
	end
	mut generic_depth: Array<Integer> := []
	state.type_resolution.generic_depth.each do |value|
		generic_depth.push(value)
	end
	mut generic_function_instances: Array<GenericFunctionInstance> := []
	state.type_resolution.generic_function_instances.each do |value|
		generic_function_instances.push(value)
	end
	mut generic_function_lookup: Hash<String, Integer> := {}
	mut function_instance := 0
	state.type_resolution.generic_function_instances.each do |value|
		generic_function_lookup[value.application_key] = function_instance
		function_instance += 1
	end
	mut enums: Array<EnumDefinition> := []
	state.enums.each do |value|
		enums.push(value)
	end
	mut enum_variants: Array<EnumVariant> := []
	state.enum_variants.each do |value|
		enum_variants.push(value)
	end
	mut enum_fields: Array<EnumField> := []
	state.enum_fields.each do |value|
		enum_fields.push(value)
	end
	mut default_initializers: Array<DefaultInitializer> := []
	state.default_initializers.each do |value|
		default_initializers.push(value)
	end
	mut default_functions: Array<Integer> := []
	state.default_functions.each do |value|
		default_functions.push(value)
	end
	mut active_module: Array<Integer> := []
	state.module_graph.active_module.each do |value|
		active_module.push(value)
	end
	mut record_count: Array<Integer> := []
	state.record_count.each do |value|
		record_count.push(value)
	end
	mut field_count: Array<Integer> := []
	state.field_count.each do |value|
		field_count.push(value)
	end
	mut function_count: Array<Integer> := []
	state.function_count.each do |value|
		function_count.push(value)
	end
	mut function_lookup: Hash<String, Integer> := {}
	mut function := 0
	while function < state.function_count[0]
		key := function_index_key(load_integer(state.function_modules, function), load_string(state.function_names, function))
		if state.function_lookup.key?(key)
			function_lookup[key] = state.function_lookup[key]
		end
		function += 1
	end
	mut parameter_count: Array<Integer> := []
	state.parameter_count.each do |value|
		parameter_count.push(value)
	end
	mut global_types: Array<String> := []
	state.global_types.each do |value|
		global_types.push(value)
	end
	mut global_functions: Array<Integer> := []
	state.global_functions.each do |value|
		global_functions.push(value)
	end
	return CompilerState.new(objects: state.objects, object_instances: object_instances, object_instance_lookup: object_instance_lookup, newtypes: state.newtypes, token_fused_literals: state.token_fused_literals, raw_enum_values: state.raw_enum_values, raw_enum_results: state.raw_enum_results, function_receivers: string_storage_copy(state.function_receivers), internal_type_annotations: state.internal_type_annotations, projected_type_lines: state.projected_type_lines,
		global_scope_orders: state.global_scope_orders, globals: state.globals, global_types: global_types, global_functions: global_functions, global_order: state.global_order,
		namespaces: state.namespaces, declaration_owner: [state.declaration_owner[0]], token_namespaces: state.token_namespaces,
		lambdas: state.lambdas,
		lambda_origins: state.lambda_origins,
		lambda_phase: [1], checked_lambdas: [], function_lambdas: fresh.function_lambdas,
		checked: fresh.checked,
		checked_bodies: fresh.checked_bodies,
		checked_body_indices: fresh.checked_body_indices,
		catch_syntax: state.catch_syntax,
		catch_origins: state.catch_origins,
		statement_finishes: state.statement_finishes,
		standard_modules: state.standard_modules,
		type_resolution: CompilerTypeResolution.new(
			type_aliases: state.type_resolution.type_aliases,
			alias_instances: alias_instances,
			alias_instance_lookup: alias_lookup,
			alias_patterns: string_storage_copy(state.type_resolution.alias_patterns),
			alias_expansion_path: fresh.type_resolution.alias_expansion_path,
			alias_expansion_depth: [0],
			generic_definitions: state.type_resolution.generic_definitions,
			generic_instances: generic_instances,
			generic_instance_lookup: generic_instance_lookup,
			generic_depth: generic_depth,
			generic_functions: state.type_resolution.generic_functions,
			generic_function_instances: generic_function_instances,
			generic_function_lookup: generic_function_lookup,
			generic_bindings: generic_bindings,
			record_generic_bindings: integer_storage_copy(state.type_resolution.record_generic_bindings),
			function_generic_bindings: integer_storage_copy(state.type_resolution.function_generic_bindings),
			generic_template_mode: [true],
		),
		enums: enums,
		enum_variants: enum_variants,
		enum_fields: enum_fields,
		submissions: fresh.submissions,
		loop_finishes: state.loop_finishes,
		controls: state.controls,
		control_origins: state.control_origins,
		default_initializers: default_initializers,
		default_functions: default_functions,
		parameter_defaults: integer_storage_copy(state.parameter_defaults),
		field_defaults: integer_storage_copy(state.field_defaults),
		function_expression_bodies: integer_storage_copy(state.function_expression_bodies),
		record_default_parameters: integer_storage_copy(state.record_default_parameters),
		transforms: state.transforms, transform_origins: state.transform_origins,
		iterations: state.iterations,
		iteration_origins: state.iteration_origins,
		hash_repl: fresh.hash_repl,
		token_kinds: state.token_kinds,
		token_texts: state.token_texts,
		token_lines: state.token_lines,
		token_count: state.token_count,
		scalar_mir: fresh.scalar_mir,
		module_graph: compiler_module_graph_fork(state.module_graph, active_module),
		record_names: string_storage_copy(state.record_names),
		record_modules: integer_storage_copy(state.record_modules),
		record_field_starts: integer_storage_copy(state.record_field_starts),
		record_field_counts: integer_storage_copy(state.record_field_counts),
		record_lines: integer_storage_copy(state.record_lines),
		record_count: record_count,
		field_names: string_storage_copy(state.field_names),
		field_types: string_storage_copy(state.field_types),
		field_lines: integer_storage_copy(state.field_lines),
		field_count: field_count,
		function_names: string_storage_copy(state.function_names),
		function_modules: integer_storage_copy(state.function_modules),
		function_parameter_starts: integer_storage_copy(state.function_parameter_starts),
		function_parameter_counts: integer_storage_copy(state.function_parameter_counts),
		function_result_types: string_storage_copy(state.function_result_types),
		function_body_starts: integer_storage_copy(state.function_body_starts),
		function_body_ends: integer_storage_copy(state.function_body_ends),
		function_lines: integer_storage_copy(state.function_lines),
		function_count: function_count,
		function_lookup: function_lookup,
		parameter_names: string_storage_copy(state.parameter_names),
		parameter_types: string_storage_copy(state.parameter_types),
		parameter_mutable: integer_storage_copy(state.parameter_mutable),
		parameter_named_only: integer_storage_copy(state.parameter_named_only),
		parameter_lines: integer_storage_copy(state.parameter_lines),
		parameter_count: parameter_count,
		diagnostics: fresh.diagnostics,
	)
end
