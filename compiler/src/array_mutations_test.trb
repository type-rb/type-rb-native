import { array_loop_mir_check } from array_loop_mir_test
import { check } from compiler
import { compiler_test_instruction_with_cell } from compiler_test
import { managed_mir_test_fixture } from hash_value_mir_test
import { logical_checked_source } from logical_test
import { MirRootPlan, mir_function_index } from mir
import { mir_instruction_effects } from mir_roots
import { verify_mir } from mir_verifier
import { describe, expect, test } from trb/std/test

describe("Array mutation MIR") do
	test("preserves raw scalar values without source or block storage order") do
		managed_mir_test_fixture("array-mutation-mir", 5)
	end
	test("retains removed elements and inserted values across collection and growth") do
		managed_mir_test_fixture("array-mutation-managed-mir", 8)
	end
	test("never retains loop storage across shortening or insertion") do
		bodies := ["", "values.pop()", "values.shift()", "values.unshift(9)"]
		bodies.each.with_index do |body, index|
			state := array_loop_mir_check("def main()\nmut values := [1, 2, 3]\nmut index := 0\nmut total := 0\nwhile index < values.size()\n" + body + "\ntotal += values[index]\nindex += 1\nend\nputs(total)\nend\n")
			mut expected := 0
			if index == 0
				expected = 1
			end
			expect(state.scalar_mir.array_loops[mir_function_index(state.scalar_mir, 0)].size()).to_equal(expected)
		end
	end
	test("rejects invalid mutation types modes operands and failure edges") do
		sources := ["values.unshift(3)", "values.pop()", "values.shift()"]
		sources.each.with_index do |source, mode|
			mut mutation := 0
			while mutation < 6
				mut state := logical_checked_source("def main()\nmut values := [1, 2]\n" + source + "\nend\n")
				expect(check(state)).to_be_true()
				mut index := 0
				while state.scalar_mir.instructions[index].kind != 48
					index += 1
				end
				instruction := state.scalar_mir.instructions[index]
				mut effects := 10
				if mode == 0
					effects = 11
				end
				expect(mir_instruction_effects(state.scalar_mir, instruction)).to_equal(effects)
				mut value := 999999
				if mutation == 0
					value = 49
				elsif mutation == 3
					value = instruction.first
				elsif mutation == 4
					value = 3
				elsif mutation == 5
					value = 0
				end
				state.scalar_mir.instructions[index] = compiler_test_instruction_with_cell(instruction, mutation, value)
				expect(verify_mir(state.scalar_mir, true).empty?()).to_be_false()
				mutation += 1
			end
		end
	end
	test("rejects a growth root plan that drops either managed operand") do
		mut mutation := 0
		while mutation < 2
			mut state := logical_checked_source("def main()\nmut values := [\"kept\"]\nvalues.unshift(\"new\" + \" value\")\nend\n")
			expect(check(state)).to_be_true()
			plan := state.scalar_mir.root_plans[0]
			mut point := 0
			while state.scalar_mir.instructions[plan.instructions[point]].kind != 48
				point += 1
			end
			instruction := state.scalar_mir.instructions[plan.instructions[point]]
			mut retained := instruction.first
			if mutation == 1
				retained = instruction.second
			end
			expect(plan.roots[point].size()).to_equal(2)
			mut roots := plan.roots
			roots[point] = [retained]
			state.scalar_mir.root_plans[0] = MirRootPlan.new(function_id: plan.function_id, instructions: plan.instructions, roots: roots, capacity: plan.capacity)
			expect(verify_mir(state.scalar_mir, true)).to_equal("MIR live root plan differs")
			mutation += 1
		end
	end
end
