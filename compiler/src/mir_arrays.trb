import { CheckedValue, checked_mir_value, checked_value, mir_checked_value, scalar_mir_convert_float, scalar_mir_disable, scalar_mir_instruction, scalar_mir_value } from checked_values
import { MirArrayTarget, MirBlock, MirFunction, MirInstruction, MirModule, mir_value_type } from mir
import { mir_control_active, mir_control_prepare } from mir_control
import { MirFlow, mir_value_available } from mir_flow
import { mir_element_type, mir_semantic_type_id } from mir_types
import { CheckedLocals, CompilerState } from state
import { load_integer } from storage

# 19: empty Array; 20: live size; 21: checked logical position; 22: load;
# 23: store (payload is the value); 24: push. Position selection precedes RHS
# evaluation. Loads/stores keep the owner and logical index, never an address.
def mir_checked_array_operation(mut state: CompilerState, mut locals: CheckedLocals, kind: Integer, first: Integer, second: Integer, payload: Integer, type_name: String, origin: Integer): CheckedValue
	mir_control_prepare(state, locals)
	type_id := mir_semantic_type_id(state.scalar_mir, type_name)
	if (type_id == 0 && type_name != "Void") || (kind != 19 && first < 0) || (kind >= 21 && second < 0) || (kind == 23 && payload < 0)
		scalar_mir_disable(locals)
	end
	mut mutable := 0
	if kind == 19
		mutable = 1
	end
	if !mir_control_active(locals)
		return checked_value(type_name, 0, origin, mutable)
	end
	mut result :=- 1
	if type_name != "Void"
		result = scalar_mir_value(state, locals, type_id, origin)
	end
	scalar_mir_instruction(state, locals, kind, result, first, second, payload, - 1, load_integer(state.token_lines, origin))
	return mir_checked_value(type_name, result, origin, mutable)
end

def mir_checked_array_literal(mut state: CompilerState, mut locals: CheckedLocals, type_name: String, element: String, origin: Integer, values: Array<CheckedValue>): CheckedValue
	# Evaluate all elements before allocation, including mixed Float literals.
	# Their SSA operands remain live across each following allocation/push.
	mut operands: Array<Integer> := []
	values.each do |value|
		mut operand := value
		if element == "Float" && value.type_name == "Integer"
			operand = scalar_mir_convert_float(state, locals, value, origin)
		end
		operands.push(checked_mir_value(operand))
	end
	array := mir_checked_array_operation(state, locals, 19, - 1, - 1, 0, type_name, origin)
	operands.each do |operand|
		mir_checked_array_operation(state, locals, 24, checked_mir_value(array), operand, 0, "Void", origin)
	end
	return array
end

def mir_checked_array_index(mut state: CompilerState, mut locals: CheckedLocals, receiver: CheckedValue, index: CheckedValue, type_name: String, origin: Integer, assignment: Boolean): CheckedValue
	owner := checked_mir_value(receiver)
	mut position := checked_mir_value(index)
	if assignment
		selected := mir_checked_array_operation(state, locals, 21, owner, position, 0, "Integer", origin)
		position = checked_mir_value(selected)
		locals.mir_targets.push(MirArrayTarget.new(origin: origin, owner: owner, index: position))
	end
	value := mir_checked_array_operation(state, locals, 22, owner, position, 0, type_name, origin)
	return checked_value(value.type_name, value.category, origin, receiver.mutable)
end

def mir_checked_array_store(mut state: CompilerState, mut locals: CheckedLocals, target: CheckedValue, value: CheckedValue): Boolean
	mut index := locals.mir_targets.size() - 1
	while index >= 0
		row := locals.mir_targets[index]
		if row.origin == target.origin
			mir_checked_array_operation(state, locals, 23, row.owner, row.index, checked_mir_value(value), "Void", target.origin)
			return true
		end
		index -= 1
	end
	return false
end

def mir_array_instruction_error(flow: MirFlow, native_module: MirModule, function: MirFunction, block: MirBlock, index: Integer, instruction: MirInstruction): String
	kind := instruction.kind
	result := mir_value_type(native_module, function.id, instruction.result)
	if instruction.failure != - 1 || (kind != 23 && instruction.payload != 0)
		return "MIR Array operation shape differs"
	end
	if kind == 19
		if mir_element_type(native_module, result) == 0 || instruction.first != - 1 || instruction.second != - 1
			return "MIR Array construction type differs"
		end
		return ""
	end
	if !mir_value_available(flow, block, index, instruction.first)
		return "MIR Array owner is undefined"
	end
	element := mir_element_type(native_module, mir_value_type(native_module, function.id, instruction.first))
	if element == 0
		return "MIR Array owner type differs"
	end
	if kind == 20
		if result != 1 || instruction.second != - 1
			return "MIR Array size type differs"
		end
		return ""
	end
	if !mir_value_available(flow, block, index, instruction.second)
		return "MIR Array operand is undefined"
	end
	second := mir_value_type(native_module, function.id, instruction.second)
	if kind == 24
		if instruction.result == - 1 && second == element
			return ""
		end
		return "MIR Array push type differs"
	end
	if second != 1
		return "MIR Array index type differs"
	end
	if kind == 21 && result == 1
		return ""
	end
	if kind == 22 && result == element
		return ""
	end
	if kind == 23 && instruction.result == - 1
		if !mir_value_available(flow, block, index, instruction.payload)
			return "MIR Array stored value is undefined"
		end
		if mir_value_type(native_module, function.id, instruction.payload) == element
			return ""
		end
	end
	return "MIR Array result or stored type differs"
end
