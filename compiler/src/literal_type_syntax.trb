import { literal_integer_type, literal_string_type } from literal_types
import { expand_quoted_token } from literal_syntax
import { CompilerState, diagnostic } from state
import { load_integer, load_string, sparse_integer_at } from storage

# Only authored literal expressions narrow. Constant folding must not turn an
# arbitrary scalar expression into a permitted singleton initializer.
def source_literal_type(state: CompilerState, start: Integer, finish: Integer): String
	mut first := start
	mut last := finish
	while last - first >= 3 && load_string(state.token_texts, first) == "(" && load_string(state.token_texts, last - 1) == ")"
		first += 1
		last -= 1
	end
	if last - first == 1
		kind := load_integer(state.token_kinds, first)
		if kind == 2
			return literal_integer_type(load_string(state.token_texts, first))
		elsif kind == 3 && sparse_integer_at(state.token_fused_literals, first) == 0
			return literal_string_type(load_string(state.token_texts, first))
		end
	elsif last - first == 2 && load_string(state.token_texts, first) == "-" && load_integer(state.token_kinds, first + 1) == 2
		return literal_integer_type("-" + load_string(state.token_texts, first + 1))
	end
	return ""
end

def parse_literal_type(mut state: CompilerState, mut position: Array<Integer>): String
	origin := position[0]
	kind := load_integer(state.token_kinds, origin)
	if kind != 2 && kind != 3 && kind != 7 && load_string(state.token_texts, origin) != "-"
		return ""
	end
	if !expand_quoted_token(state, origin, false)
		return ""
	end
	position[0] += 1
	if load_string(state.token_texts, origin) == "-"
		position[0] += 1
	end
	result := source_literal_type(state, origin, position[0])
	if result == ""
		diagnostic(state, "TRBN4002", load_integer(state.token_lines, origin), "expected an Integer or String literal type")
		return ""
	end
	following := load_string(state.token_texts, position[0])
	if following == "?" || following == "[" || following == "<"
		diagnostic(state, "TRBN4002", load_integer(state.token_lines, origin), "literal types do not support type modifiers")
		return ""
	end
	return result
end
