import { QbeOutput, qbe_output_line } from qbe_output

# Binary64 conversion searches significant precision and verifies round trips.
# At powers of two, the lower rounding interval is narrower: the next higher
# decimal coefficient can be shortest even when the nearest coefficient fails.
# Expand the selected digits directly; formatting the binary value with %f
# would expose its exact binary tail instead of the shortest decimal.
# Finite binary64 needs at most 17 significant digits and exponents -324..308;
# 64 candidate bytes and 384 fixed-output bytes bound the stack buffers.
def emit_float_string_runtime(mut output: QbeOutput)
	qbe_output_line(output, "data $trbn_decimal_format = { b \"%.*e\", b 0 }\ndata $trbn_decimal_exponent = { b \"e%+d\", b 0 }\ndata $trbn_float_zero = align 8 { l 0, l 3, l 3, b \"0.0\", b 0 }\ndata $trbn_float_nan = align 8 { l 0, l 3, l 3, b \"NaN\", b 0 }\ndata $trbn_float_infinity = align 8 { l 0, l 8, l 8, b \"Infinity\", b 0 }\ndata $trbn_float_negative_infinity = align 8 { l 0, l 9, l 9, b \"-Infinity\", b 0 }\ndata $trbn_float_format_error = { b \"panic: Float formatting failed\", b 10 }\nfunction l $trbn_float_to_string(d %value) {\n")
	qbe_output_line(output, "@start\n %nan =w cned %value, %value\n jnz %nan, @nan, @zero_check\n")
	qbe_output_line(output, "@nan\n ret $trbn_float_nan\n")
	qbe_output_line(output, "@zero_check\n %zero =w ceqd %value, d_0.0\n jnz %zero, @zero, @sign\n")
	qbe_output_line(output, "@zero\n ret $trbn_float_zero\n")
	qbe_output_line(output, "@sign\n %negative =w cltd %value, d_0.0\n jnz %negative, @negative, @positive\n")
	qbe_output_line(output, "@negative\n %absolute =d sub d_0.0, %value\n jmp @finite\n")
	qbe_output_line(output, "@positive\n jmp @finite\n")
	qbe_output_line(output, "@finite\n %magnitude =d phi @negative %absolute, @positive %value\n %difference =d sub %magnitude, %magnitude\n %infinite =w cned %difference, %difference\n jnz %infinite, @infinite, @prepare\n")
	qbe_output_line(output, "@infinite\n jnz %negative, @negative_infinity, @positive_infinity\n")
	qbe_output_line(output, "@negative_infinity\n ret $trbn_float_negative_infinity\n")
	qbe_output_line(output, "@positive_infinity\n ret $trbn_float_infinity\n")
	qbe_output_line(output, "@prepare\n %buffer =l alloc8 64\n %digits =l alloc8 32\n jmp @precision\n")
	qbe_output_line(output, "@precision\n %places =w phi @prepare 0, @more %next_places\n %written =w call $snprintf(l %buffer, l 64, l $trbn_decimal_format, ..., w %places, d %magnitude)\n %bad_write =w cugtw %written, 63\n jnz %bad_write, @fail, @roundtrip\n")
	qbe_output_line(output, "@roundtrip\n %parsed =d call $strtod(l %buffer, l 0)\n %same =w ceqd %parsed, %magnitude\n jnz %same, @digits_start, @neighbor_check\n")
	qbe_output_line(output, "@neighbor_check\n %below =w cltd %parsed, %magnitude\n jnz %below, @neighbor, @more\n")
	qbe_output_line(output, "@neighbor\n %no_fraction =w ceqw %places, 0\n %last_fraction =w add %places, 1\n jnz %no_fraction, @one_digit, @many_digits\n")
	qbe_output_line(output, "@one_digit\n jmp @carry_start\n")
	qbe_output_line(output, "@many_digits\n jmp @carry_start\n")
	qbe_output_line(output, "@carry_start\n %last_digit =w phi @one_digit 0, @many_digits %last_fraction\n %last_index =l extsw %last_digit\n jmp @carry\n")
	qbe_output_line(output, "@carry\n %index =l phi @carry_start %last_index, @carry_next %previous\n %under =w csltl %index, 0\n jnz %under, @carry_exponent, @carry_digit\n")
	qbe_output_line(output, "@carry_digit\n %address =l add %buffer, %index\n %digit =w loadub %address\n %dot =w ceqw %digit, 46\n jnz %dot, @carry_next, @carry_nine\n")
	qbe_output_line(output, "@carry_nine\n %nine =w ceqw %digit, 57\n jnz %nine, @carry_zero, @carry_increment\n")
	qbe_output_line(output, "@carry_zero\n storeb 48, %address\n jmp @carry_next\n")
	qbe_output_line(output, "@carry_next\n %previous =l sub %index, 1\n jmp @carry\n")
	qbe_output_line(output, "@carry_increment\n %incremented =w add %digit, 1\n storeb %incremented, %address\n jmp @neighbor_roundtrip\n")
	qbe_output_line(output, "@carry_exponent\n storeb 49, %buffer\n %suffix_offset =l add %last_index, 1\n %suffix =l add %buffer, %suffix_offset\n %exponent_text =l add %suffix, 1\n %exponent =l call $strtol(l %exponent_text, l 0, w 10)\n %exponent_word =w copy %exponent\n %next_exponent =w add %exponent_word, 1\n call $snprintf(l %suffix, l 16, l $trbn_decimal_exponent, ..., w %next_exponent)\n jmp @neighbor_roundtrip\n")
	qbe_output_line(output, "@neighbor_roundtrip\n %neighbor_value =d call $strtod(l %buffer, l 0)\n %neighbor_same =w ceqd %neighbor_value, %magnitude\n jnz %neighbor_same, @digits_start, @more\n")
	qbe_output_line(output, "@more\n %next_places =w add %places, 1\n %too_many =w cugtw %next_places, 16\n jnz %too_many, @fail, @precision\n")
	qbe_output_line(output, "@fail\n call $trbn_fail(l $trbn_float_format_error, l 31)\n hlt\n")
	qbe_output_line(output, "@digits_start\n jmp @digits_loop\n")
	qbe_output_line(output, "@digits_loop\n %source_index =l phi @digits_start 0, @digits_next %source_next\n %count =l phi @digits_start 0, @digits_next %count_next\n %source_address =l add %buffer, %source_index\n %character =w loadub %source_address\n %at_exponent =w ceqw %character, 101\n jnz %at_exponent, @digits_done, @digits_dot_check\n")
	qbe_output_line(output, "@digits_dot_check\n %is_dot =w ceqw %character, 46\n jnz %is_dot, @digits_dot, @digits_copy\n")
	qbe_output_line(output, "@digits_dot\n jmp @digits_next\n")
	qbe_output_line(output, "@digits_copy\n %destination =l add %digits, %count\n storeb %character, %destination\n %count_added =l add %count, 1\n jmp @digits_next\n")
	qbe_output_line(output, "@digits_next\n %count_next =l phi @digits_dot %count, @digits_copy %count_added\n %source_next =l add %source_index, 1\n jmp @digits_loop\n")
	qbe_output_line(output, "@digits_done\n %power_text =l add %source_address, 1\n %power =l call $strtol(l %power_text, l 0, w 10)\n %point =l add %power, 1\n %sign =l extuw %negative\n %result =l call $trbn_decimal_fixed(l %digits, l %count, l %point, l %sign)\n ret %result\n}\nfunction l $trbn_decimal_fixed(l %digits, l %count, l %point, l %negative) {\n")
	qbe_output_line(output, "@start\n %buffer =l alloc8 384\n storeb 45, %buffer\n %fraction =w cslel %point, 0\n jnz %fraction, @fraction, @integer\n")
	qbe_output_line(output, "@fraction\n %zero_address =l add %buffer, %negative\n storeb 48, %zero_address\n %dot_address =l add %zero_address, 1\n storeb 46, %dot_address\n %fraction_cursor =l add %negative, 2\n jmp @loop_start\n")
	qbe_output_line(output, "@integer\n %extended =w csgtl %point, %count\n jnz %extended, @extended, @short\n")
	qbe_output_line(output, "@extended\n jmp @integer_ready\n")
	qbe_output_line(output, "@short\n jmp @integer_ready\n")
	qbe_output_line(output, "@integer_ready\n %integer_end =l phi @extended %point, @short %count\n jmp @loop_start\n")
	qbe_output_line(output, "@loop_start\n %initial =l phi @fraction %point, @integer_ready 0\n %end =l phi @fraction %count, @integer_ready %integer_end\n %initial_cursor =l phi @fraction %fraction_cursor, @integer_ready %negative\n jmp @loop\n")
	qbe_output_line(output, "@loop\n %index =l phi @loop_start %initial, @next %next_index\n %cursor =l phi @loop_start %initial_cursor, @next %next_cursor\n %done =w csgel %index, %end\n jnz %done, @done, @dot_check\n")
	qbe_output_line(output, "@dot_check\n %at_point =w ceql %index, %point\n %positive_point =w csgtl %point, 0\n %needs_dot =w and %at_point, %positive_point\n jnz %needs_dot, @dot, @no_dot\n")
	qbe_output_line(output, "@dot\n %dot_slot =l add %buffer, %cursor\n storeb 46, %dot_slot\n %after_dot =l add %cursor, 1\n jmp @digit\n")
	qbe_output_line(output, "@no_dot\n jmp @digit\n")
	qbe_output_line(output, "@digit\n %position =l phi @dot %after_dot, @no_dot %cursor\n %below =w csltl %index, 0\n %above =w csgel %index, %count\n %padding =w or %below, %above\n jnz %padding, @padding, @copy\n")
	qbe_output_line(output, "@padding\n jmp @store\n")
	qbe_output_line(output, "@copy\n %source =l add %digits, %index\n %value =w loadub %source\n jmp @store\n")
	qbe_output_line(output, "@store\n %character =w phi @padding 48, @copy %value\n %target =l add %buffer, %position\n storeb %character, %target\n jmp @next\n")
	qbe_output_line(output, "@next\n %next_cursor =l add %position, 1\n %next_index =l add %index, 1\n jmp @loop\n")
	qbe_output_line(output, "@done\n %whole =w csgel %point, %count\n jnz %whole, @whole, @fraction_done\n")
	qbe_output_line(output, "@whole\n %decimal =l add %buffer, %cursor\n storeb 46, %decimal\n %zero =l add %decimal, 1\n storeb 48, %zero\n %whole_length =l add %cursor, 2\n jmp @finish\n")
	qbe_output_line(output, "@fraction_done\n jmp @finish\n")
	qbe_output_line(output, "@finish\n %length =l phi @whole %whole_length, @fraction_done %cursor\n %result =l call $trbn_string_from_bytes(l %buffer, l %length)\n ret %result\n}\n\n")
end
