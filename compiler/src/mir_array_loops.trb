import { integer_string } from literals
import { MirArrayHeader, MirArrayLoop, MirBlock, MirFunction, MirModule } from mir
import { mir_exact_integer_literal } from mir_analysis
import { MirFlow, mir_build_flow, mir_flow_blocks, mir_flow_type } from mir_flow
import { mir_instruction_effects, mir_live_add, mir_live_equal } from mir_roots
import { mir_element_type } from mir_types

# A checked position (kind 21) is an in-range logical index for its owner.
# Reuse it within the same MIR block until an operation can change collection
# state or run user code. The verifier independently reconstructs this list;
# the QBE adapter never infers validity from source or opcode proximity.
def mir_function_array_check_reuse(native_module: MirModule, function: MirFunction): Array<Integer>
	mut reuse: Array<Integer> := []
	if function.kind != 3
		return reuse
	end
	mut block_index := function.block_start
	while block_index < function.block_start + function.block_count
		block := native_module.blocks[block_index]
		mut checked: Hash<String, Integer> := {}
		mut index := block.instruction_start
		while index < block.instruction_start + block.instruction_count
			instruction := native_module.instructions[index]
			if instruction.kind == 22 || instruction.kind == 23
				key := integer_string(instruction.second)
				if checked.key?(key) && checked[key] == instruction.first
					mir_live_add(reuse, index)
				end
			end
			effects := mir_instruction_effects(native_module, instruction)
			if effects != 0 && effects != 8
				checked = {}
			end
			if instruction.kind == 21
				checked[integer_string(instruction.result)] = instruction.first
			end
			index += 1
		end
		block_index += 1
	end
	return reuse
end

# Plans name verified blocks and values, never source positions or a fixed
# block layout. Unknown aliases, effects and induction updates keep checks.
def mir_loop_dominates(flow: MirFlow, owner: Integer, mut block: Integer): Boolean
	if flow.ranks[block] < 0
		return false
	end
	while block != owner && block != flow.entry
		block = flow.dominators[block]
	end
	return block == owner
end

def mir_loop_alias(aliases: Hash<String, Integer>, value: Integer): Integer
	key := integer_string(value)
	if aliases.key?(key)
		return aliases[key]
	end
	return - 2
end

# Hold the candidate header's parameters fixed while forwarding identities
# through other block parameters. Bottom (-2), one value, and conflict (-1)
# form a finite lattice; cycles with no incoming definition remain unknown.
def mir_loop_aliases(native_module: MirModule, function: MirFunction, flow: MirFlow, header: MirBlock): Hash<String, Integer>
	mut aliases: Hash<String, Integer> := {}
	mut index := function.parameter_start
	while index < function.parameter_start + function.parameter_count
		value := native_module.arguments[index]
		aliases[integer_string(value)] = value
		index += 1
	end
	index = header.parameter_start
	while index < header.parameter_start + header.parameter_count
		value := native_module.arguments[index]
		aliases[integer_string(value)] = value
		index += 1
	end
	index = function.block_start
	while index < function.block_start + function.block_count
		block := native_module.blocks[index]
		mut instruction := block.instruction_start
		while instruction < block.instruction_start + block.instruction_count
			value := native_module.instructions[instruction].result
			if value >= 0
				aliases[integer_string(value)] = value
			end
			instruction += 1
		end
		index += 1
	end
	mut changed := true
	while changed
		changed = false
		index = function.block_start
		while index < function.block_start + function.block_count
			block := native_module.blocks[index]
			if block.id != header.id
				mut slot := 0
				while slot < block.parameter_count
					value := native_module.arguments[block.parameter_start + slot]
					old := mir_loop_alias(aliases, value)
					mut merged := old
					flow.incoming_starts[index - function.block_start].each do |start|
						incoming := mir_loop_alias(aliases, native_module.arguments[start + slot])
						if incoming != - 2
							if merged == - 2
								merged = incoming
							elsif merged != incoming
								merged =- 1
							end
						end
					end
					if old != merged
						aliases[integer_string(value)] = merged
						changed = true
					end
					slot += 1
				end
			end
			index += 1
		end
	end
	return aliases
end

def mir_loop_definition(flow: MirFlow, value: Integer): Integer
	key := integer_string(value)
	if flow.positions.key?(key)
		return flow.positions[key]
	end
	return - 1
end

def mir_loop_literal(native_module: MirModule, flow: MirFlow, value: Integer, text: String): Boolean
	position := mir_loop_definition(flow, value)
	if position < 0
		return false
	end
	return mir_exact_integer_literal(native_module, native_module.instructions[position], text)
end

# A checked increment of the zero-origin induction value is also nonnegative.
# It does not prove the position belongs to any particular Array.
def mir_loop_nonnegative_index(native_module: MirModule, flow: MirFlow, aliases: Hash<String, Integer>, induction: Integer, value: Integer): Boolean
	if mir_loop_alias(aliases, value) == induction
		return true
	end
	definition := mir_loop_definition(flow, value)
	if definition < 0
		return false
	end
	instruction := native_module.instructions[definition]
	if instruction.kind != 7 || (instruction.payload != 1 && instruction.payload != 13) || instruction.failure < 0
		return false
	end
	if mir_loop_alias(aliases, instruction.first) != induction
		return false
	end
	return mir_loop_literal(native_module, flow, mir_loop_alias(aliases, instruction.second), "1")
end

def mir_loop_parameter(native_module: MirModule, header: MirBlock, value: Integer): Integer
	mut slot := 0
	while slot < header.parameter_count
		if native_module.arguments[header.parameter_start + slot] == value
			return slot
		end
		slot += 1
	end
	return - 1
end

def mir_no_array_loop(): MirArrayLoop
	return MirArrayLoop.new(header: - 1, preheader: - 1, owner: - 1, length: - 1, accesses: [], headers: [])
end

# Retain Array owners whose header parameter has exactly the same identity on
# every backedge. This proves stable length and backing data, but does not
# equate their lengths to a separate loop guard or scalar bound.
def mir_array_stable_headers(native_module: MirModule, flow: MirFlow, header: MirBlock, header_index: Integer, preheader_start: Integer, guard_owner: Integer, aliases: Hash<String, Integer>): Array<MirArrayHeader>
	mut headers: Array<MirArrayHeader> := []
	mut slot := 0
	while slot < header.parameter_count
		identity := native_module.arguments[header.parameter_start + slot]
		if identity != guard_owner && mir_element_type(native_module, mir_flow_type(flow, identity)) != 0
			mut stable := true
			mut edge := 0
			while edge < flow.predecessors[header_index].size()
				previous := flow.predecessors[header_index][edge]
				if mir_loop_dominates(flow, header_index, previous)
					start := flow.incoming_starts[header_index][edge]
					if mir_loop_alias(aliases, native_module.arguments[start + slot]) != identity
						stable = false
					end
				end
				edge += 1
			end
			if stable
				owner := native_module.arguments[preheader_start + slot]
				headers.push(MirArrayHeader.new(identity: identity, owner: owner, accesses: [], nonnegative_accesses: []))
			end
		end
		slot += 1
	end
	return headers
end

def mir_array_loop(native_module: MirModule, function: MirFunction, flow: MirFlow, header_index: Integer): MirArrayLoop
	header := native_module.blocks[function.block_start + header_index]
	if header.terminator != 2 || flow.ranks[header_index] < 0 || header.first_target == header.id || header.first_target == header.second_target
		return mir_no_array_loop()
	end
	condition_index := mir_loop_definition(flow, header.condition)
	if condition_index < header.instruction_start || condition_index >= header.instruction_start + header.instruction_count
		return mir_no_array_loop()
	end
	condition := native_module.instructions[condition_index]
	if condition.kind != 7 || condition.payload != 8
		return mir_no_array_loop()
	end
	mut length_index := mir_loop_definition(flow, condition.second)
	mut guard_owner :=- 1
	if length_index >= header.instruction_start && length_index < header.instruction_start + header.instruction_count
		length := native_module.instructions[length_index]
		if length.kind == 20
			guard_owner = length.first
		end
	end
	if guard_owner < 0
		length_index =- 1
	end
	index_slot := mir_loop_parameter(native_module, header, condition.first)
	mut owner_slot :=- 1
	if guard_owner >= 0
		owner_slot = mir_loop_parameter(native_module, header, guard_owner)
	end
	if index_slot < 0 || (guard_owner >= 0 && owner_slot < 0)
		return mir_no_array_loop()
	end
	aliases := mir_loop_aliases(native_module, function, flow, header)
	mut preheader :=- 1
	mut preheader_start :=- 1
	mut owner :=- 1
	mut members: Array<Integer> := [header_index]
	mut visited: Hash<String, Integer> := {}
	visited[integer_string(header_index)] = 1
	mut pending: Array<Integer> := []
	mut edge := 0
	while edge < flow.predecessors[header_index].size()
		block_index := flow.predecessors[header_index][edge]
		block := native_module.blocks[function.block_start + block_index]
		start := flow.incoming_starts[header_index][edge]
		index_value := mir_loop_alias(aliases, native_module.arguments[start + index_slot])
		mut owner_value :=- 1
		if owner_slot >= 0
			owner_value = mir_loop_alias(aliases, native_module.arguments[start + owner_slot])
		end
		if mir_loop_dominates(flow, header_index, block_index)
			if guard_owner >= 0 && owner_value != guard_owner
				return mir_no_array_loop()
			end
			if index_value != condition.first
				definition := mir_loop_definition(flow, index_value)
				if definition < 0
					return mir_no_array_loop()
				end
				update := native_module.instructions[definition]
				if update.kind != 7 || (update.payload != 1 && update.payload != 13) || update.failure < 0
					return mir_no_array_loop()
				end
				if mir_loop_alias(aliases, update.first) != condition.first || !mir_loop_literal(native_module, flow, mir_loop_alias(aliases, update.second), "1")
					return mir_no_array_loop()
				end
			end
			pending.push(block_index)
		else
			if preheader >= 0 || block.terminator != 1 || !mir_loop_literal(native_module, flow, index_value, "0")
				return mir_no_array_loop()
			end
			preheader = block.id
			preheader_start = start
			if owner_slot >= 0
				owner = native_module.arguments[start + owner_slot]
			end
		end
		edge += 1
	end
	if preheader < 0 || pending.size() == 0
		return mir_no_array_loop()
	end
	# Walk natural-loop predecessors, excluding the preheader and exits.
	mut cursor := 0
	while cursor < pending.size()
		current := pending[cursor]
		cursor += 1
		if !visited.key?(integer_string(current))
			if !mir_loop_dominates(flow, header_index, current)
				return mir_no_array_loop()
			end
			visited[integer_string(current)] = 1
			members.push(current)
			flow.predecessors[current].each do |previous|
				pending.push(previous)
			end
		end
	end
	if visited.key?(integer_string(flow.blocks[integer_string(header.second_target)]))
		return mir_no_array_loop()
	end
	mut accesses: Array<Integer> := []
	mut headers := mir_array_stable_headers(native_module, flow, header, header_index, preheader_start, guard_owner, aliases)
	body := flow.blocks[integer_string(header.first_target)]
	members.each do |member|
		block := native_module.blocks[function.block_start + member]
		mut captured: Hash<String, Integer> := {}
		mut instruction_index := block.instruction_start
		while instruction_index < block.instruction_start + block.instruction_count
			instruction := native_module.instructions[instruction_index]
			# Only scalar operations, non-allocating Array access and verified
			# effect-free calls can retain the Array header across the loop.
			mut pure_call := false
			if instruction.kind == 11 && instruction.payload >= 0 && instruction.payload < native_module.calls.size()
				pure_call = native_module.calls[instruction.payload].effects == 0
			end
			if (instruction.kind < 6 || instruction.kind > 9) && (instruction.kind < 20 || instruction.kind > 23) && !pure_call
				return mir_no_array_loop()
			end
			if guard_owner >= 0 && instruction.kind >= 21 && instruction.kind <= 23 && mir_loop_dominates(flow, body, member)
				if mir_loop_alias(aliases, instruction.first) == guard_owner
					mut guarded := mir_loop_alias(aliases, instruction.second) == condition.first
					if !guarded && captured.key?(integer_string(instruction.second))
						guarded = captured[integer_string(instruction.second)] == guard_owner
					end
					if guarded
						mir_live_add(accesses, instruction_index)
						if instruction.kind == 21
							captured[integer_string(instruction.result)] = guard_owner
						end
					end
				end
			end
			if instruction.kind >= 20 && instruction.kind <= 23
				identity := mir_loop_alias(aliases, instruction.first)
				headers.each do |candidate|
					if candidate.identity == identity
						mir_live_add(candidate.accesses, instruction_index)
						if instruction.kind >= 21 && mir_loop_dominates(flow, body, member) && mir_loop_nonnegative_index(native_module, flow, aliases, condition.first, instruction.second)
							mir_live_add(candidate.nonnegative_accesses, instruction_index)
						end
					end
				end
			end
			instruction_index += 1
		end
	end
	mut reused: Array<MirArrayHeader> := []
	headers.each do |candidate|
		if candidate.accesses.size() > 0
			reused.push(candidate)
		end
	end
	if accesses.size() == 0 && reused.size() == 0
		return mir_no_array_loop()
	end
	return MirArrayLoop.new(header: header.id, preheader: preheader, owner: owner, length: length_index, accesses: accesses, headers: reused)
end

def mir_function_array_loops(native_module: MirModule, function: MirFunction): Array<MirArrayLoop>
	mut plans: Array<MirArrayLoop> := []
	if function.kind != 3
		return plans
	end
	# Sort by block identity so physical block reordering preserves the plan.
	# Most functions have no candidate. Inspect local guard shapes before
	# constructing dominance and forwarding information for the whole function.
	mut headers: Array<Integer> := []
	mut index := 0
	while index < function.block_count
		block := native_module.blocks[function.block_start + index]
		if mir_array_loop_candidate(native_module, block)
			mir_live_add(headers, block.id)
		end
		index += 1
	end
	if headers.size() == 0
		return plans
	end
	flow := mir_build_flow(native_module, function, mir_flow_blocks(native_module, function))
	headers.each do |id|
		plan := mir_array_loop(native_module, function, flow, flow.blocks[integer_string(id)])
		if plan.header >= 0
			plans.push(plan)
		end
	end
	return plans
end

def mir_array_loop_candidate(native_module: MirModule, block: MirBlock): Boolean
	if block.terminator != 2
		return false
	end
	mut condition :=- 1
	mut index := block.instruction_start
	while index < block.instruction_start + block.instruction_count
		instruction := native_module.instructions[index]
		if instruction.result == block.condition && instruction.kind == 7 && instruction.payload == 8
			condition = instruction.first
		end
		index += 1
	end
	if condition < 0
		return false
	end
	index = block.parameter_start
	while index < block.parameter_start + block.parameter_count
		if native_module.arguments[index] == condition
			return true
		end
		index += 1
	end
	return false
end

def mir_array_loops_equal(left: Array<MirArrayLoop>, right: Array<MirArrayLoop>): Boolean
	if left.size() != right.size()
		return false
	end
	mut index := 0
	while index < left.size()
		a := left[index]
		b := right[index]
		if a.header != b.header || a.preheader != b.preheader || a.owner != b.owner || a.length != b.length || !mir_live_equal(a.accesses, b.accesses) || a.headers.size() != b.headers.size()
			return false
		end
		mut header := 0
		while header < a.headers.size()
			left_header := a.headers[header]
			right_header := b.headers[header]
			if left_header.identity != right_header.identity || left_header.owner != right_header.owner || !mir_live_equal(left_header.accesses, right_header.accesses) || !mir_live_equal(left_header.nonnegative_accesses, right_header.nonnegative_accesses)
				return false
			end
			header += 1
		end
		index += 1
	end
	return true
end
