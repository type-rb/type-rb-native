import { callable_parts } from callable_types
import { nullable_element } from nullable_types
import { ascii_code } from literals
import { string_starts_with } from path

# Canonical Hash spellings contain one scalar key and one resolved value type.
def hash_key_type(type_name: String): String
	if !string_starts_with(type_name, "Hash<") || type_name[type_name.size() - 1] != ">"
		return ""
	end
	if string_starts_with(type_name, "Hash<Integer,")
		return "Integer"
	end
	if string_starts_with(type_name, "Hash<String,")
		return "String"
	end
	return ""
end

def hash_value_type(type_name: String): String
	key := hash_key_type(type_name)
	if key == ""
		return ""
	end
	mut result := ""
	mut index := 6 + key.size()
	while index < type_name.size() - 1
		result += type_name[index]
		index += 1
	end
	return result
end

def hash_type(key: String, value: String): String
	return "Hash<" + key + "," + value + ">"
end

def native_managed_type(type_name: String): Boolean
	if callable_parts(type_name).size() > 0
		return true
	end
	if nullable_element(type_name) != ""
		return true
	end
	if type_name == "String" || type_name == "Range<Integer>" || string_starts_with(type_name, "Array<") || string_starts_with(type_name, "Record#") || string_starts_with(type_name, "Enum#") || hash_key_type(type_name) != "" || type_name == "Hash"
		return true
	end
	return false
end

# Validate the word-sized scalar/managed layouts admitted by Hash MIR.
def native_value_layout(type_name: String): Boolean
	parts := callable_parts(type_name)
	if parts.size() > 0
		mut index := 0
		while index < parts.size()
			if !(index == 0 && parts[index] == "Void")
				if !native_value_layout(parts[index])
					return false
				end
			end
			index += 1
		end
		return true
	end
	optional := nullable_element(type_name)
	if optional != ""
		return native_value_layout(optional)
	end
	if type_name == "Integer" || type_name == "Float" || type_name == "Boolean" || type_name == "String" || type_name == "Range<Integer>"
		return true
	end
	if hash_key_type(type_name) != ""
		return native_value_layout(hash_value_type(type_name))
	end
	if string_starts_with(type_name, "Array<") && type_name[type_name.size() - 1] == ">"
		mut element := ""
		mut index := 6
		while index < type_name.size() - 1
			element += type_name[index]
			index += 1
		end
		return native_value_layout(element)
	end
	mut prefix := 7
	if string_starts_with(type_name, "Enum#")
		prefix = 5
	elsif !string_starts_with(type_name, "Record#")
		return false
	end
	if type_name.size() == prefix
		return false
	end
	if type_name.size() > prefix + 1 && type_name[prefix] == "0"
		return false
	end
	mut index := prefix
	while index < type_name.size()
		code := ascii_code(type_name[index])
		if code < 48 || code > 57
			return false
		end
		index += 1
	end
	return true
end

# Checked generic bodies can carry abstract values without assigning a layout.
# Only fully concrete types are admitted later by MIR/runtime layout checks.
def semantic_value_type(type_name: String): Boolean
	parts := callable_parts(type_name)
	if parts.size() > 0
		mut index := 0
		while index < parts.size()
			if !(index == 0 && parts[index] == "Void")
				if !semantic_value_type(parts[index])
					return false
				end
			end
			index += 1
		end
		return true
	end
	if native_value_layout(type_name) || string_starts_with(type_name, "TypeParameter#")
		return true
	end
	optional := nullable_element(type_name)
	if optional != ""
		return semantic_value_type(optional)
	end
	if hash_key_type(type_name) != ""
		return semantic_value_type(hash_value_type(type_name))
	end
	if string_starts_with(type_name, "Array<") && type_name[type_name.size() - 1] == ">"
		mut element := ""
		mut index := 6
		while index < type_name.size() - 1
			element += type_name[index]
			index += 1
		end
		return semantic_value_type(element)
	end
	return false
end
