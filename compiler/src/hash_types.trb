import { gate4_string_starts_with } from path

# Canonical Hash spellings contain one scalar key and one resolved value type.
def hash_key_type(type_name: String): String
	if !gate4_string_starts_with(type_name, "Hash<") || type_name[type_name.size() - 1] != ">"
		return ""
	end
	if gate4_string_starts_with(type_name, "Hash<Integer,")
		return "Integer"
	end
	if gate4_string_starts_with(type_name, "Hash<String,")
		return "String"
	end
	return ""
end

def hash_value_type(type_name: String): String
	key := hash_key_type(type_name)
	if key == ""
		return ""
	end
	mut result := ""
	mut index := 6 + key.size()
	while index < type_name.size() - 1
		result += type_name[index]
		index += 1
	end
	return result
end

def hash_type(key: String, value: String): String
	return "Hash<" + key + "," + value + ">"
end

def native_managed_type(type_name: String): Boolean
	if type_name == "String" || gate4_string_starts_with(type_name, "Array<") || gate4_string_starts_with(type_name, "Record#") || hash_key_type(type_name) != "" || type_name == "Hash"
		return true
	end
	return false
end
