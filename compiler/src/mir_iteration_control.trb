import { CheckedValue, checked_mir_value, checked_value, mir_checked_value, scalar_mir_binary, scalar_mir_disable, scalar_mir_literal } from checked_values
import { MirIteration } from iteration_mir
import { MirControlLoop } from mir
import { mir_checked_array_operation } from mir_arrays
import { mir_control_active, mir_control_allocate, mir_control_conditional, mir_control_enter, mir_control_jump, mir_control_loop_begin, mir_control_loop_branch, mir_control_prepare } from mir_control
import { mir_checked_range_field } from mir_ranges
import { CheckedLocals, CompilerState } from state
import { load_integer, store_integer } from storage

def mir_iteration_local(locals: CheckedLocals, slot: Integer, type_name: String, origin: Integer): CheckedValue
	return mir_checked_value(type_name, load_integer(locals.mir_values, slot) - 1, origin, 0)
end

# Both Range comparisons and every exit are ordinary MIR control edges. The
# dynamic exclusivity flag never requires computing end + 1 at portable MAX.
def mir_iteration_range_test(mut state: CompilerState, mut locals: CheckedLocals, frame: MirControlLoop, body: Integer, saved: Integer)
	line := load_integer(state.token_lines, frame.origin)
	owner := load_integer(locals.mir_values, saved) - 1
	exclusive := mir_checked_range_field(state, locals, owner, 2, frame.origin)
	first := mir_control_allocate(locals)
	second := mir_control_allocate(locals)
	mir_control_conditional(state, locals, checked_mir_value(exclusive), first, frame.binding_count, second, frame.binding_count)
	mir_control_enter(state, locals, first, line)
	first_owner := load_integer(locals.mir_values, saved) - 1
	first_end := mir_checked_range_field(state, locals, first_owner, 1, frame.origin)
	first_cursor := mir_iteration_local(locals, saved + 1, "Integer", frame.origin)
	before := scalar_mir_binary(state, locals, "<", first_cursor, first_end, "Boolean", frame.origin)
	mir_control_conditional(state, locals, checked_mir_value(before), body, frame.binding_count, frame.exit, frame.exit_binding_count)
	mir_control_enter(state, locals, second, line)
	second_owner := load_integer(locals.mir_values, saved) - 1
	second_end := mir_checked_range_field(state, locals, second_owner, 1, frame.origin)
	second_cursor := mir_iteration_local(locals, saved + 1, "Integer", frame.origin)
	through := scalar_mir_binary(state, locals, "<=", second_cursor, second_end, "Boolean", frame.origin)
	mir_control_conditional(state, locals, checked_mir_value(through), body, frame.binding_count, frame.exit, frame.exit_binding_count)
end

def mir_checked_iteration_begin(mut state: CompilerState, mut locals: CheckedLocals, plan: MirIteration, receiver: CheckedValue, saved: Integer): CheckedValue
	mir_control_prepare(state, locals)
	owner := checked_mir_value(receiver)
	if owner < 0
		scalar_mir_disable(locals)
	end
	if !mir_control_active(locals)
		return checked_value(plan.element_type, 0, plan.element_origin, 0)
	end
	store_integer(locals.mir_values, saved, owner + 1)
	mut cursor := scalar_mir_literal(state, locals, "Integer", plan.origin, "0")
	zero := cursor
	if plan.source_kind == 2
		cursor = mir_checked_range_field(state, locals, owner, 0, plan.origin)
	end
	store_integer(locals.mir_values, saved + 1, checked_mir_value(cursor) + 1)
	if plan.source_kind == 2 && plan.index_origin >= 0
		store_integer(locals.mir_values, saved + 2, checked_mir_value(zero) + 1)
	end
	line := load_integer(state.token_lines, plan.origin)
	exit := mir_control_loop_begin(state, locals, plan.origin, line)
	depth := locals.mir_control[8] - 1
	previous := locals.mir_loops[depth]
	frame := MirControlLoop.new(origin: plan.origin, header: previous.header, exit: exit, continuation: mir_control_allocate(locals), binding_count: previous.binding_count, exit_binding_count: saved)
	locals.mir_loops[depth] = frame
	if plan.source_kind == 1
		array := load_integer(locals.mir_values, saved) - 1
		position := mir_iteration_local(locals, saved + 1, "Integer", plan.origin)
		length := mir_checked_array_operation(state, locals, 20, array, - 1, 0, "Integer", plan.origin)
		available := scalar_mir_binary(state, locals, "<", position, length, "Boolean", plan.origin)
		mir_control_loop_branch(state, locals, available, exit, line)
		body_array := load_integer(locals.mir_values, saved) - 1
		body_index := load_integer(locals.mir_values, saved + 1) - 1
		return mir_checked_array_operation(state, locals, 22, body_array, body_index, 0, plan.element_type, plan.element_origin)
	end
	body := mir_control_allocate(locals)
	mir_iteration_range_test(state, locals, frame, body, saved)
	mir_control_enter(state, locals, body, line)
	return mir_iteration_local(locals, saved + 1, "Integer", plan.element_origin)
end

def mir_iteration_has_edge(locals: CheckedLocals, target: Integer): Boolean
	locals.mir_blocks.each do |block|
		if (block.terminator == 1 || block.terminator == 2) && block.first_target == target
			return true
		end
		if block.terminator == 2 && block.second_target == target
			return true
		end
	end
	return false
end

def mir_checked_iteration_end(mut state: CompilerState, mut locals: CheckedLocals, plan: MirIteration, saved: Integer)
	if !mir_control_active(locals)
		return
	end
	depth := locals.mir_control[8] - 1
	frame := locals.mir_loops[depth]
	line := load_integer(state.token_lines, plan.body_finish)
	mir_control_jump(state, locals, frame.continuation, frame.binding_count)
	locals.count[0] = frame.binding_count
	# An unconditional break/return may leave no continuation predecessor.
	# Do not publish an unreachable latch with artificial unbound parameters.
	if mir_iteration_has_edge(locals, frame.continuation)
		mir_control_enter(state, locals, frame.continuation, line)
		if plan.source_kind == 2
			owner := load_integer(locals.mir_values, saved) - 1
			bound := mir_checked_range_field(state, locals, owner, 1, plan.origin)
			cursor := mir_iteration_local(locals, saved + 1, "Integer", plan.origin)
			last := scalar_mir_binary(state, locals, "==", cursor, bound, "Boolean", plan.origin)
			step := mir_control_allocate(locals)
			mir_control_conditional(state, locals, checked_mir_value(last), frame.exit, frame.exit_binding_count, step, frame.binding_count)
			mir_control_enter(state, locals, step, line)
		end
		cursor := mir_iteration_local(locals, saved + 1, "Integer", plan.origin)
		one := scalar_mir_literal(state, locals, "Integer", plan.origin, "1")
		next_cursor := scalar_mir_binary(state, locals, "+", cursor, one, "Integer", plan.origin)
		store_integer(locals.mir_values, saved + 1, checked_mir_value(next_cursor) + 1)
		if plan.source_kind == 2 && plan.index_origin >= 0
			# No ordinal is needed after the final exclusive element, either.
			advance := mir_control_allocate(locals)
			mir_iteration_range_test(state, locals, frame, advance, saved)
			mir_control_enter(state, locals, advance, line)
			ordinal := mir_iteration_local(locals, saved + 2, "Integer", plan.origin)
			increment := scalar_mir_literal(state, locals, "Integer", plan.origin, "1")
			next_ordinal := scalar_mir_binary(state, locals, "+", ordinal, increment, "Integer", plan.origin)
			store_integer(locals.mir_values, saved + 2, checked_mir_value(next_ordinal) + 1)
		end
		mir_control_jump(state, locals, frame.header, frame.binding_count)
	end
	locals.mir_control[8] = depth
	locals.count[0] = saved
	mir_control_enter(state, locals, frame.exit, line)
end
