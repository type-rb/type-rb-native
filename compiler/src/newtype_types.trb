import { literal_type_base } from literal_types
import { enum_payloadless, find_enum_type } from enum_types
import { integer_string } from literals
import { CompilerState } from state

# These internal names are semantic identities, never source-level aliases.
def newtype_type(owner: Integer): String
	return "Newtype#" + integer_string(owner)
end

def find_newtype_type(state: CompilerState, type_name: String): Integer
	mut owner := 0
	while owner < state.newtypes.size()
		if newtype_type(owner) == type_name
			return owner
		end
		owner += 1
	end
	return - 1
end

def find_newtype_in_module(state: CompilerState, source: Integer, name: String): Integer
	mut owner := 0
	while owner < state.newtypes.size()
		definition := state.newtypes[owner]
		if definition.source_id == source && definition.name == name
			return owner
		end
		owner += 1
	end
	return - 1
end

# Only recursively expanded scalar and payloadless-enum equality is portable.
def newtype_equality_type(state: CompilerState, type_name: String): String
	mut result := type_name
	mut remaining := state.newtypes.size() + 1
	while remaining > 0
		owner := find_newtype_type(state, result)
		if owner < 0
			if literal_type_base(result) != ""
				return literal_type_base(result)
			end
			if result == "Integer" || result == "Float" || result == "Boolean" || result == "String"
				return result
			end
			enum_index := find_enum_type(state, result)
			if enum_index >= 0 && enum_payloadless(state, enum_index)
				return result
			end
			return ""
		end
		result = state.newtypes[owner].representation
		remaining -= 1
	end
	return ""
end
