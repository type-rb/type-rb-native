import { CheckedLambda, LambdaSyntax } from frontend/types/callable_types
import { CheckedBody, checked_body_new } from state/checked_body
import { IntegerStorage, integer_storage } from support/storage

# Parsed lambda syntax is shared with template checks. Checked bodies, phase
# progress and function-to-lambda bindings are specific to each program fork.
record CompilerCallableAnalysis
	lambdas: Array<LambdaSyntax>
	lambda_origins: IntegerStorage
	lambda_phase: Array<Integer>
	checked_lambdas: Array<CheckedLambda>
	function_lambdas: IntegerStorage
	checked: Array<CheckedBody>
	checked_bodies: Array<CheckedBody>
	checked_body_indices: IntegerStorage
end

def compiler_callable_analysis_new(capacity: Integer): CompilerCallableAnalysis
	return CompilerCallableAnalysis.new(
		lambdas: [], lambda_origins: integer_storage(capacity),
		lambda_phase: [0], checked_lambdas: [], function_lambdas: integer_storage(capacity),
		checked: [checked_body_new(-1, 0, capacity)],
		checked_bodies: [], checked_body_indices: integer_storage(capacity),
	)
end

def compiler_callable_analysis_fork(source: CompilerCallableAnalysis, capacity: Integer): CompilerCallableAnalysis
	return CompilerCallableAnalysis.new(
		lambdas: source.lambdas, lambda_origins: source.lambda_origins,
		lambda_phase: [1], checked_lambdas: [], function_lambdas: integer_storage(capacity),
		checked: [checked_body_new(-1, 0, capacity)], checked_bodies: [],
		checked_body_indices: integer_storage(capacity),
	)
end
