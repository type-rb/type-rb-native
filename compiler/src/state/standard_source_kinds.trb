# Loader-assigned source ownership is independent of declaration spelling.
# IDs from 100 belong to the generated official catalog; do not rename or reorder
# its generated rows here. Negative Process/Math import targets are separate.

def standard_source_unowned(): Integer
	return 0
end

def standard_source_result(): Integer
	return 1
end

def standard_source_unit(): Integer
	return 2
end

def standard_source_errors(): Integer
	return 3
end

def standard_source_url(): Integer
	return 4
end

def standard_source_internal_url(): Integer
	return 5
end

def standard_source_json(): Integer
	return 6
end

def standard_source_jsonc(): Integer
	return 7
end

def standard_source_internal_json(): Integer
	return 8
end

def standard_source_internal_runtime(): Integer
	return 9
end

# Root-only exports and file-level service functions are owned loader contracts.
# These policies never apply to authored declarations with the same spelling.
def standard_source_root(kind: Integer): String
	if kind == standard_source_url() || kind == standard_source_internal_url()
		return "URL"
	elsif kind == standard_source_json() || kind == standard_source_internal_json()
		return "JSON"
	elsif kind == standard_source_jsonc()
		return "JSONC"
	elsif kind == standard_source_internal_runtime()
		return "Runtime"
	end
	return ""
end

def standard_source_function(kind: Integer, name: String): Boolean
	if kind == standard_source_url() || kind == standard_source_internal_url()
		if name == "::encode_component" || name == "::decode_component"
			return true
		end
		if kind == standard_source_url()
			if name == "::parse_query" || name == "::build_query"
				return true
			end
		end
	elsif kind == standard_source_internal_runtime()
		return name == "::fail"
	elsif kind == standard_source_jsonc()
		return name == "::parse"
	elsif kind == standard_source_internal_json()
		if name == "::parse" || name == "::parse_jsonc" || name == "::stringify"
			return true
		end
	elsif kind == standard_source_json()
		if name == "::parse" || name == "::stringify" || name == "::as_boolean" || name == "::as_integer" || name == "::as_float" || name == "::as_string" || name == "::as_array" || name == "::as_object" || name == "::field"
			return true
		end
	end
	return false
end

def standard_source_official_start(): Integer
	return 100
end
