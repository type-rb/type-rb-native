# Loader-assigned source ownership is independent of declaration spelling.
# IDs from 100 belong to the generated official catalog; do not rename or reorder
# its generated rows here. Negative Process/Math import targets are separate.

def standard_source_unowned(): Integer
	return 0
end

def standard_source_result(): Integer
	return 1
end

def standard_source_unit(): Integer
	return 2
end

def standard_source_errors(): Integer
	return 3
end

def standard_source_url(): Integer
	return 4
end

def standard_source_internal_url(): Integer
	return 5
end

def standard_source_json(): Integer
	return 6
end

def standard_source_jsonc(): Integer
	return 7
end

def standard_source_internal_json(): Integer
	return 8
end

def standard_source_internal_runtime(): Integer
	return 9
end

def standard_source_time(): Integer
	return 10
end

def standard_source_internal_time(): Integer
	return 11
end

def standard_source_time_calendar(): Integer
	return 12
end

def standard_source_time_parse(): Integer
	return 13
end

def standard_source_time_zones(): Integer
	return 14
end

def standard_source_time_host(): Integer
	return 15
end

# Root-only exports and file-level service functions are owned loader contracts.
# These policies never apply to authored declarations with the same spelling.
def standard_source_root(kind: Integer): String
	if kind == standard_source_url() || kind == standard_source_internal_url()
		return "URL"
	elsif kind == standard_source_json() || kind == standard_source_internal_json()
		return "JSON"
	elsif kind == standard_source_jsonc()
		return "JSONC"
	elsif kind == standard_source_internal_time()
		return "Time"
	elsif kind == standard_source_time_host()
		return "TimeHost"
	elsif kind == standard_source_internal_runtime()
		return "Runtime"
	end
	return ""
end

def standard_source_function(kind: Integer, name: String): Boolean
	if kind == standard_source_internal_time()
		names := ["::validate_date", "::date_try_new", "::date_try_parse", "::date_parse", "::date_to_string", "::date_add_days", "::date_compare", "::validate_time", "::time_of_day_try_new", "::time_of_day_try_parse", "::time_of_day_parse", "::time_of_day_to_string", "::time_of_day_compare", "::validate_datetime", "::datetime_try_new", "::datetime_try_parse", "::datetime_parse", "::datetime_to_string", "::datetime_compare", "::datetime_try_to_instant", "::datetime_to_instant", "::validate_duration", "::duration_from_seconds", "::duration_from_milliseconds", "::duration_try_parse", "::duration_parse", "::duration_add", "::duration_subtract", "::duration_negative", "::duration_to_string", "::duration_compare", "::validate_time_zone", "::time_zone_try_get", "::validate_instant", "::instant_now", "::instant_try_parse", "::instant_parse", "::instant_to_string", "::instant_to_datetime", "::instant_add", "::instant_subtract", "::instant_duration_since", "::instant_compare"]
		mut index := 0
		while index < names.size()
			if names[index] == name
				return true
			end
			index += 1
		end
		return false
	end
	if kind == standard_source_time_host()
		if name == "::clock" || name == "::zone_data"
			return true
		end
		return false
	end
	if kind == standard_source_url() || kind == standard_source_internal_url()
		if name == "::encode_component" || name == "::decode_component"
			return true
		end
		if kind == standard_source_url()
			if name == "::parse_query" || name == "::build_query"
				return true
			end
		end
	elsif kind == standard_source_internal_runtime()
		return name == "::fail"
	elsif kind == standard_source_jsonc()
		return name == "::parse"
	elsif kind == standard_source_internal_json()
		if name == "::parse" || name == "::parse_jsonc" || name == "::stringify"
			return true
		end
	elsif kind == standard_source_json()
		if name == "::decode" || name == "::encode"
			return true
		end
		if name == "::parse" || name == "::stringify" || name == "::as_boolean" || name == "::as_integer" || name == "::as_float" || name == "::as_string" || name == "::as_array" || name == "::as_object" || name == "::field"
			return true
		end
	end
	return false
end

def standard_source_official_start(): Integer
	return 100
end
