# Project-owned source facts. They are frozen before semantic checking and
# shared read-only by speculative generic forks; execution consumes typed MIR.
record ProjectWebRoute
	source_id: Integer
	function_id: Integer
	path: String
	directory: String
	method: String
	segments: Array<String>
end

# Checked endpoint facts retain nominal identities rather than backend types.
# They are produced once after source resolution and are metadata only.
record ProjectWebResponse
	status: Integer
	type_name: String
	authored_type: String
	origin: Integer
end

record ProjectWebEndpoint
	object_id: Integer
	route_index: Integer
	input_type: String
	input_name: String
	responses: Array<ProjectWebResponse>
end
