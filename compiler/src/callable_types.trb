import { generic_application, generic_arguments, generic_base } from generic_arguments

# This spelling is internal and cannot be authored as an identifier. Result is
# first so zero-argument and higher-order signatures use the same structure.
def callable_type(parameters: Array<String>, result: String): String
	mut parts := [result]
	parameters.each do |parameter|
		parts.push(parameter)
	end
	return generic_application("$Callable", parts)
end

def callable_parts(name: String): Array<String>
	if name.size() == 0 || name[0] != "$"
		return []
	end
	if generic_base(name) == "$Callable"
		return generic_arguments(name)
	end
	return []
end
