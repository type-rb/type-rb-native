# Nominal declaration rows shared by checking and independently verified MIR.
record EnumDefinition
	name: String
	source_id: Integer
	line: Integer
	variant_start: Integer
	variant_count: Integer
end

record EnumVariant
	owner: Integer
	name: String
	line: Integer
	field_start: Integer
	field_count: Integer
end

record EnumField
	name: String
	type_name: String
	line: Integer
	named_only: Boolean
end

# Source declarations are consumed during checking, never by the backend.
record RawEnumValue
	variant: Integer
	type_name: String
	text: String
	origin: Integer
end

# The REPL consumes the checked nominal conversion result without reinference.
record RawEnumConversion
	origin: Integer
	owner: Integer
	result_type: String
end

# Pattern bindings are authored token origins in canonical payload field order.
# This is a checked REPL projection, never backend input.
record EnumPattern
	origin: Integer
	variant: Integer
	bindings: Array<Integer>
end
