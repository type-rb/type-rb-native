import { ResultOperation } from result_model
import { EnumPattern } from enum_model
import { MirHashOperation } from hash_mir
import { MirIteration, MirRangeConstruction } from iteration_mir
import { IntegerStorage, StringStorage, integer_storage_span, string_storage_span } from storage

# Optional frontend/REPL projections for one concrete function body. MIR owns
# executable semantics; these tables may be discarded after checking.
record CheckedBody
	function: Integer
	generic_binding: Array<Integer>
	generic_calls: IntegerStorage
	result_operations: Array<ResultOperation>
	generic_application_types: StringStorage
	generic_application_finishes: IntegerStorage
	enum_patterns: Array<EnumPattern>
	enum_pattern_origins: IntegerStorage
	nullable_reads: StringStorage
	safe_finishes: IntegerStorage
	safe_types: StringStorage
	control_types: StringStorage
	ranges: Array<MirRangeConstruction>
	range_origins: IntegerStorage
	hash_operations: Array<MirHashOperation>
	hash_origins: IntegerStorage
	checked_operator_plans: IntegerStorage
	loop_transfer_kinds: IntegerStorage
	loop_transfer_targets: IntegerStorage
	iterations: Array<MirIteration>
	iteration_origins: IntegerStorage
	diverging_hashes: IntegerStorage
end

def checked_body_new(function: Integer, origin: Integer, finish: Integer): CheckedBody
	return CheckedBody.new(
		function: function, generic_binding: [0], generic_calls: integer_storage_span(origin, finish),
		result_operations: [],
		generic_application_types: string_storage_span(origin, finish),
		generic_application_finishes: integer_storage_span(origin, finish),
		enum_patterns: [],
		enum_pattern_origins: integer_storage_span(origin, finish),
		nullable_reads: string_storage_span(origin, finish),
		safe_finishes: integer_storage_span(origin, finish),
		safe_types: string_storage_span(origin, finish),
		control_types: string_storage_span(origin, finish),
		ranges: [],
		range_origins: integer_storage_span(origin, finish),
		hash_operations: [],
		hash_origins: integer_storage_span(origin, finish),
		checked_operator_plans: integer_storage_span(origin, finish),
		loop_transfer_kinds: integer_storage_span(origin, finish),
		loop_transfer_targets: integer_storage_span(origin, finish),
		iterations: [],
		iteration_origins: integer_storage_span(origin, finish),
		diverging_hashes: integer_storage_span(origin, finish),
	)
end
