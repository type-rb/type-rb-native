import { describe, expect, test } from trb/std/test
import { gate4_check, gate4_emit_qbe, gate4_lex } from compiler
import { gate4_parse_module } from parser
import { gate4_resolve } from resolution
import { gate4_compiler_new, gate4_has_diagnostic } from state
import { gate4_verify_mir, mir_function_index } from mir

describe("Checked Boolean arrays") do
	test("keeps Boolean array reads outside numeric reduction MIR") do
		source := "def read(values: Array<Boolean>, index: Integer): Boolean\nreturn values[index]\nend\ndef every(values: Array<Boolean>): Boolean\nmut index := 0\nwhile index < values.size()\nif !values[index]\nreturn false\nend\nindex += 1\nend\nreturn true\nend\ndef main()\nreturn\nend\n"
		mut state := gate4_compiler_new(source.size() + 1)
		expect(gate4_lex(state, source)).to_be_true()
		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(gate4_resolve(state)).to_be_true()
		expect(gate4_check(state)).to_be_true()
		expect(mir_function_index(state.scalar_mir, 0)).to_equal(- 1)
		expect(mir_function_index(state.scalar_mir, 1)).to_equal(- 1)
		expect(gate4_verify_mir(state.scalar_mir, true)).to_equal("")
		gate4_emit_qbe(state)
		expect(gate4_has_diagnostic(state)).to_be_false()
	end
end
