import { check, emit_qbe, lex } from compiler
import { mir_function_index } from mir
import { verify_mir } from mir_verifier
import { parse_module } from parser
import { resolve } from resolution
import { compiler_new, has_diagnostic } from state
import { describe, expect, test } from trb/std/test

describe("Checked Boolean arrays") do
	test("keeps Boolean array reads outside numeric reduction MIR") do
		source := "def read(values: Array<Boolean>, index: Integer): Boolean\nreturn values[index]\nend\ndef every(values: Array<Boolean>): Boolean\nmut index := 0\nwhile index < values.size()\nif !values[index]\nreturn false\nend\nindex += 1\nend\nreturn true\nend\ndef main()\nreturn\nend\n"
		mut state := compiler_new(source.size() + 1)
		expect(lex(state, source)).to_be_true()
		expect(parse_module(state, 0, state.entry_module[0])).to_be_true()
		expect(resolve(state)).to_be_true()
		expect(check(state)).to_be_true()
		expect(mir_function_index(state.scalar_mir, 0)).to_equal(- 1)
		expect(mir_function_index(state.scalar_mir, 1)).to_equal(- 1)
		expect(verify_mir(state.scalar_mir, true)).to_equal("")
		emit_qbe(state)
		expect(has_diagnostic(state)).to_be_false()
	end
end
