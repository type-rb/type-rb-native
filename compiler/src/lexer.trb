import { decode_escape } from string_escapes
import { advance } from syntax_tokens
import { CompilerState, add_module, diagnostic, has_diagnostic } from state
import { load_integer, load_string, store_integer, store_string } from storage

# The source body supports recovery; the compiler runtime adapts this declaration.
def compiler_source_slice(source: String, start: Integer, finish: Integer): String
	mut value := ""
	mut index := start
	while index < finish
		value += source[index]
		index += 1
	end
	return value
end

# The reference frontend validates source encoding before recovery. Ordinary
# compilers adapt this identity to byte validation before decoding any token.
def compiler_source_is_utf8(_source: String): Boolean
	return true
end

def character_in(character: String, characters: String): Boolean
	mut index := 0
	while index < characters.size()
		if characters[index] == character
			return true
		end
		index += 1
	end
	return false
end

def number_character(character: String): Boolean
	if character_in(character, "0123456789")
		return true
	end
	return character == "_"
end

def push_token(mut state: CompilerState, kind: Integer, text: String, line: Integer)
	mut index := state.token_count[0]
	# The following token distinguishes a complete right literal from a postfix.
	if index >= 3
		if load_integer(state.token_kinds, index - 3) == 3
			if load_integer(state.token_kinds, index - 2) == 5
				if load_string(state.token_texts, index - 2) == "+"
					if load_integer(state.token_kinds, index - 1) == 3
						if text != "."
							if text != "["
								combined := load_string(state.token_texts, index - 3) + load_string(state.token_texts, index - 1)
								store_string(state.token_texts, index - 3, combined)
								store_integer(state.token_fused_literals, index - 3, 1)
								index -= 2
							end
						end
					end
				end
			end
		end
	end
	store_integer(state.token_fused_literals, index, 0)
	store_integer(state.token_kinds, index, kind)
	store_string(state.token_texts, index, text)
	store_integer(state.token_lines, index, line)
	state.token_count[0] = index + 1
	return
end

def scan_identifier(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if character_in(
					source[position[0]],
					"0123456789fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
				)
				advance(position)
			else
				scanning = false
			end
		end
	end
	if position[0] < source.size()
		if source[position[0]] == "?"
			advance(position)
		end
	end
	push_token(state, 1, compiler_source_slice(source, start, position[0]), line)
	return
end

def scan_number(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	start := position[0]
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if number_character(source[position[0]])
				advance(position)
			else
				scanning = false
			end
		end
	end
	if position[0] + 1 < source.size()
		if source[position[0]] == "."
			if character_in(source[position[0] + 1], "0123456789")
				advance(position)
				scanning = true
				while scanning
					if position[0] >= source.size()
						scanning = false
					else
						if number_character(source[position[0]])
							advance(position)
						else
							scanning = false
						end
					end
				end
			end
		end
	end
	push_token(state, 2, compiler_source_slice(source, start, position[0]), line)
	return
end

# Locate embedded expressions without treating quoted braces as delimiters.
def interpolation_end(source: String, mut index: Integer): Integer
	mut depth := 1
	while index < source.size()
		character := source[index]
		if character == "\""
			index = interpolation_quote_end(source, index + 1)
			if index < 0
				return - 1
			end
		else
			if character == "{"
				depth += 1
			end
			if character == "}"
				depth -= 1
				if depth == 0
					return index
				end
			end
			if character == "#"
				mut comment := true
				while comment
					if index >= source.size()
						comment = false
					else
						if source[index] == "\n"
							comment = false
						else
							index += 1
						end
					end
				end
			end
		end
		index += 1
	end
	return - 1
end

def interpolation_quote_end(source: String, mut index: Integer): Integer
	while index < source.size()
		character := source[index]
		if character == "\\"
			index += 1
		else
			if character == "\""
				return index
			end
			if character == "#"
				if index + 1 < source.size()
					if source[index + 1] == "{"
						index = interpolation_end(source, index + 2)
						if index < 0
							return - 1
						end
					end
				end
			end
		end
		index += 1
	end
	return - 1
end

# Normalize interpolation to grouped String concatenation before checking.
# Each embedded expression is evaluated once by the shared ordinary pipeline.
def scan_string(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		mut line: Integer,
		interpolation: Boolean,
	): Integer
	start_line := line
	advance(position)
	mut interpolated := false
	mut text := ""
	mut chunk_start := position[0]
	mut scanning := true
	mut closed := false
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			current := source[position[0]]
			if current == "\""
				text += compiler_source_slice(source, chunk_start, position[0])
				closed = true
				scanning = false
				advance(position)
			else
				if current == "\n"
					diagnostic(state, "TRBN4001", line, "unterminated String literal")
					scanning = false
				else
					if current == "\\"
						text += compiler_source_slice(source, chunk_start, position[0])
						advance(position)
						if position[0] >= source.size()
							diagnostic(state, "TRBN4001", line, "unterminated String escape")
							scanning = false
						else
							escaped_hash := source[position[0]] == "#"
							if escaped_hash
								text += "#"
								advance(position)
							else
								text += decode_escape(state, source, position, line)
							end
							if has_diagnostic(state)
								return line - start_line
							end
							chunk_start = position[0]
						end
					else
						if current == "#"
							if position[0] + 1 < source.size()
								mut opening := source[position[0] + 1] == "{"
								if opening
									opening = interpolation
								end
								if opening
									finish := interpolation_end(source, position[0] + 2)
									if finish < 0
										diagnostic(state, "TRBN4001", line, "unterminated String interpolation")
										scanning = false
									else
										if finish == position[0] + 2
											position[0] = finish + 1
										else
											if !interpolated
												push_token(state, 5, "(", start_line)
												interpolated = true
											end
											text += compiler_source_slice(source, chunk_start, position[0])
											push_token(state, 3, text, line)
											push_token(state, 5, "+", line)
											push_token(state, 5, "(", line)
											first_token := state.token_count[0]
											inner := compiler_source_slice(source, position[0] + 2, finish)
											mut first := 0
											mut last := inner.size()
											mut inner_line := line
											mut trim := true
											while trim
												if first >= last
													trim = false
												else
													if character_in(inner[first], " \t\r\n")
														if inner[first] == "\n"
															inner_line += 1
														end
														first += 1
													else
														trim = false
													end
												end
											end
											trim = true
											while trim
												if last <= first
													trim = false
												else
													if character_in(inner[last - 1], " \t\r\n")
														last -= 1
													else
														trim = false
													end
												end
											end
											lex_source(state, compiler_source_slice(inner, first, last), 0)
											state.token_count[0] = state.token_count[0] - 1
											mut token := first_token
											while token < state.token_count[0]
												store_integer(state.token_lines, token, load_integer(state.token_lines, token) + inner_line - 1)
												token += 1
											end
											if has_diagnostic(state)
												store_integer(state.diagnostic_lines, 0, load_integer(state.diagnostic_lines, 0) + inner_line - 1)
												return line - start_line
											end
											mut character_index := 0
											while character_index < inner.size()
												if inner[character_index] == "\n"
													line += 1
												end
												character_index += 1
											end
											push_token(state, 5, ")", line)
											push_token(state, 5, "+", line)
											position[0] = finish + 1
											chunk_start = position[0]
											text = ""
										end
									end
								else
									advance(position)
								end
							else
								advance(position)
							end
						else
							advance(position)
						end
					end
				end
			end
		end
	end
	if closed
		push_token(state, 3, text, line)
		if interpolated
			push_token(state, 5, ")", line)
		end
	else
		if !has_diagnostic(state)
			diagnostic(state, "TRBN4001", line, "unterminated String literal")
		end
	end
	return line - start_line
end

# A quoted Symbol contains literal interpolation spelling. Preserve ambiguous
# quotes until the expression parser chooses String or Symbol interpretation.
# Ordinary quotes without interpolation retain the existing literal token.
def scan_quoted_token(mut state: CompilerState, source: String, mut position: Array<Integer>, line: Integer): Integer
	finish := interpolation_quote_end(source, position[0] + 1)
	if finish < 0
		return scan_string(state, source, position, line, true)
	end
	mut index := position[0] + 1
	mut deferred := false
	mut lines := 0
	while index < finish
		if source[index] == "\\"
			index += 1
		elsif source[index] == "#" && index + 1 < finish && source[index + 1] == "{"
			deferred = true
		elsif source[index] == "\n"
			lines += 1
		end
		index += 1
	end
	if deferred
		push_token(state, 7, compiler_source_slice(source, position[0], finish + 1), line)
		position[0] = finish + 1
		return lines
	end
	return scan_string(state, source, position, line, true)
end

def two_character_symbol(pair: String): Boolean
	mut supported := false
	if pair == "->" || pair == "||"
		supported = true
	end
	if pair == "&."
		supported = true
	end
	if pair == "&&"
		supported = true
	end
	if pair == "::"
		supported = true
	end
	if pair == ":="
		supported = true
	end
	if pair == "=="
		supported = true
	end
	if pair == "!="
		supported = true
	end
	if pair == "<="
		supported = true
	end
	if pair == ">="
		supported = true
	end
	if pair == "+="
		supported = true
	end
	if pair == "-="
		supported = true
	end
	if pair == "*="
		supported = true
	end
	if pair == "/="
		supported = true
	end
	if pair == "=>"
		supported = true
	end
	if pair == "->"
		supported = true
	end
	return supported
end

def scan_symbol(
		mut state: CompilerState,
		source: String,
		mut position: Array<Integer>,
		line: Integer,
	)
	character := source[position[0]]
	mut symbol := character
	if position[0] + 1 < source.size()
		pair := character + source[position[0] + 1]
		if pair == ".."
			symbol = pair
			advance(position)
			if position[0] + 1 < source.size() && source[position[0] + 1] == "."
				symbol = "..."
				advance(position)
			end
		elsif two_character_symbol(pair)
			symbol = pair
			advance(position)
		end
	end
	mut supported := symbol.size() >= 2
	if !supported
		supported = character_in(character, "()[]{}:,.+-*/%<>=!|?")
	end
	if supported
		push_token(state, 5, symbol, line)
	else
		diagnostic(state, "TRBN4001", line, "unsupported source character " + character)
	end
	advance(position)
	return
end

def skip_comment(source: String, mut position: Array<Integer>)
	mut scanning := true
	while scanning
		if position[0] >= source.size()
			scanning = false
		else
			if source[position[0]] == "\n"
				scanning = false
			else
				advance(position)
			end
		end
	end
	return
end

def lex_source(mut state: CompilerState, source: String, terminal_kind: Integer): Boolean
	if !compiler_source_is_utf8(source)
		diagnostic(state, "TRBN4001", 1, "source is not valid UTF-8")
		push_token(state, terminal_kind, "", 1)
		return false
	end
	mut position := [0]
	mut line := 1
	mut character := ""
	while position[0] < source.size()
		character = source[position[0]]
		if character == " "
			advance(position)
		else
			if character == "\t"
				advance(position)
			else
				if character == "\r"
					advance(position)
				else
					if character == "\n" || character == ";"
						push_token(state, 4, character, line)
						if character == "\n"
							line += 1
						end
						advance(position)
					else
						if character == "#"
							skip_comment(source, position)
						else
							if character_in(
									character,
									"fretnmoidupglsavchbyxkwqzjABCDEFGHIJKLMNOPQRSTUVWXYZ_",
								)
								scan_identifier(state, source, position, line)
							else
								if character_in(character, "0123456789")
									scan_number(state, source, position, line)
								else
									if character == "\""
										line += scan_quoted_token(state, source, position, line)
									else
										scan_symbol(state, source, position, line)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	push_token(state, terminal_kind, "", line)
	return !has_diagnostic(state)
end

def lex_module(mut state: CompilerState, source: String, module_index: Integer): Boolean
	state.active_module[0] = module_index
	return lex_source(state, source, 6)
end

def lex(mut state: CompilerState, source: String): Boolean
	if state.module_count[0] == 0
		add_module(state, "entry", "")
	end
	state.entry_module[0] = 0
	state.active_module[0] = 0
	return lex_source(state, source, 0)
end
