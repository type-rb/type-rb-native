import { QbeOutput, qbe_output_line } from qbe_output

# Checked slicing rejects invalid code-point ranges before offset lookup.
# Measure normalized bytes, allocate once, then copy the selected code points.
def emit_string_slice_runtime(mut output: QbeOutput)
	qbe_output_line(output, "\ndata $trbn_string_slice_error = { b \"panic: String slice range is out of bounds\", b 10 }\n\nfunction l $trbn_string_slice(l %source, l %range) {\n@start\n %first_slot =l add %range, 8\n %first =l loadl %first_slot\n %last_slot =l add %range, 16\n %last =l loadl %last_slot\n %exclusive_slot =l add %range, 24\n %exclusive_value =l loadl %exclusive_slot\n %exclusive =w ceql %exclusive_value, 1\n %count_slot =l add %source, 16\n %count =l loadl %count_slot\n %negative_first =w csltl %first, 0\n %negative_last =w csltl %last, 0\n %negative =w or %negative_first, %negative_last\n %reversed =w csgtl %first, %last\n %invalid =w or %negative, %reversed\n jnz %invalid, @failure, @bound\n@bound\n %below =w csltl %last, %count\n %equal =w ceql %last, %count\n %at_end =w and %equal, %exclusive\n %valid =w or %below, %at_end\n jnz %valid, @mode, @failure\n@failure\n call $trbn_fail(l $trbn_string_slice_error, l 43)\n hlt\n@mode\n jnz %exclusive, @exclusive, @inclusive\n@exclusive\n jmp @normalized\n@inclusive\n %stop =l add %last, 1\n jmp @normalized\n@normalized\n %finish =l phi @exclusive %last, @inclusive %stop\n %begin =l call $trbn_string_offset(l %source, l %first)\n %end =l call $trbn_string_offset(l %source, l %finish)\n %points =l sub %finish, %first\n %data =l add %source, 24\n jmp @measure\n@measure\n %offset =l phi @normalized %begin, @measured %next\n %size =l phi @normalized 0, @measured %next_size\n %done =w ceql %offset, %end\n jnz %done, @allocate, @inspect\n@inspect\n %address =l add %data, %offset\n %remaining =l sub %end, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %lead =w loadub %address\n %high =w cugtw %lead, 127\n %one =w ceql %width, 1\n %invalid =w and %high, %one\n jnz %invalid, @expanded, @original\n@expanded\n jmp @measured\n@original\n jmp @measured\n@measured\n %encoded =l phi @expanded 3, @original %width\n %next_size =l add %size, %encoded\n %next =l add %offset, %width\n jmp @measure\n@allocate\n %payload =l add %size, 17\n %result =l call $trbn_string_alloc(l %payload)\n %length_address =l add %result, 8\n storel %size, %length_address\n %points_address =l add %result, 16\n storel %points, %points_address\n %result_data =l add %result, 24\n %terminator =l add %result_data, %size\n storeb 0, %terminator\n jmp @copy_loop\n@copy_loop\n %position =l phi @allocate %begin, @advance %next_position\n %output_offset =l phi @allocate 0, @advance %next_output\n %finished =w ceql %position, %end\n jnz %finished, @finish, @decode\n@decode\n %input =l add %data, %position\n %left =l sub %end, %position\n %input_width =l call $trbn_utf8_width(l %input, l %left)\n %head =w loadub %input\n %nonascii =w cugtw %head, 127\n %single =w ceql %input_width, 1\n %bad =w and %nonascii, %single\n %target =l add %result_data, %output_offset\n jnz %bad, @replacement, @copy\n@replacement\n storeb 239, %target\n %second =l add %target, 1\n storeb 191, %second\n %third =l add %target, 2\n storeb 189, %third\n jmp @advance\n@copy\n call $memcpy(l %target, l %input, l %input_width)\n jmp @advance\n@advance\n %output_width =l phi @replacement 3, @copy %input_width\n %next_output =l add %output_offset, %output_width\n %next_position =l add %position, %input_width\n jmp @copy_loop\n@finish\n ret %result\n}\n")
end
