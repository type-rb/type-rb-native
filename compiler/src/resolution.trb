import { hash_key_type, hash_type, hash_value_type } from hash_types
import { ascii_code, integer_string } from literals
import { syntax_loop_transfer_kind, token_is } from parser
import { path_basename, path_directory, string_starts_with, string_without_suffix } from path
import { CheckedLocals, CompilerState, diagnostic, find_name_index, function_index_key, has_diagnostic, local_find, locals_new, terminal_token } from state
import { load_integer, load_string, store_integer, store_string } from storage

def import_path_value(raw: String): String
	mut path := string_without_suffix(raw, ".trb")
	if path == ""
		return ""
	end
	if path[0] == "/"
		return ""
	end
	mut simple := true
	mut simple_index := 0
	while simple_index < path.size()
		character := path[simple_index]
		if character == ":"
			simple = false
		end
		if character == "/"
			simple = false
		end
		if character == "."
			simple = false
		end
		simple_index += 1
	end
	if simple
		return path
	end
	mut segments: Array<String> := []
	mut segment := ""
	mut index := 0
	while index <= path.size()
		mut character := "/"
		if index < path.size()
			character = path[index]
		end
		if character == ":"
			return ""
		end
		if character == "/"
			if segment == ".."
				return ""
			end
			if segment != ""
				if segment != "."
					segments.push(segment)
				end
			end
			segment = ""
		else
			segment += character
		end
		index += 1
	end
	if segments.size() == 0
		return ""
	end
	mut normalized := ""
	index = 0
	while index < segments.size()
		if normalized != ""
			normalized += "/"
		end
		normalized += segments[index]
		index += 1
	end
	return normalized
end

def normalize_import_path(mut state: CompilerState, raw: String, line: Integer): String
	normalized := import_path_value(raw)
	if normalized == ""
		diagnostic(state, "TRBN4003", line, "invalid project import path " + raw)
	end
	return normalized
end

def ascii_fold(value: String): String
	upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	mut result := ""
	mut index := 0
	while index < value.size()
		character := value[index]
		mut folded := character
		mut letter := 0
		while letter < upper.size()
			if upper[letter] == character
				folded = "abcdefghijklmnopqrstuvwxyz"[letter]
				letter = upper.size()
			else
				letter += 1
			end
		end
		result += folded
		index += 1
	end
	return result
end

def path_root_key(name: String): String
	mut without_underscores := ""
	mut index := 0
	while index < name.size()
		if name[index] != "_"
			without_underscores += name[index]
		end
		index += 1
	end
	return ascii_fold(without_underscores)
end

def standard_package_target(path: String): Integer
	if path == "trb/std/process"
		return - 2
	end
	if path == "trb/std/math"
		return - 3
	end
	return - 1
end

def standard_package_root(target: Integer): String
	if target == - 2
		return "Process"
	end
	return "Math"
end

def standard_package_import(
		mut state: CompilerState,
		module_index: Integer,
		name: String,
	): Integer
	import_index := find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := load_integer(state.import_targets, import_index)
	if target < - 1
		store_integer(state.import_used, import_index, 1)
	end
	return target
end

def find_record_in_module(state: CompilerState, module_index: Integer, name: String): Integer
	mut index := state.record_count[0] - 1
	while index >= 0
		if load_integer(state.record_modules, index) == module_index
			if load_string(state.record_names, index) == name
				return index
			end
		end
		index -= 1
	end
	return - 1
end

def find_function_in_module(state: CompilerState, module_index: Integer, name: String): Integer
	return find_name_index(state.function_lookup, function_index_key(module_index, name))
end

def find_import_binding(state: CompilerState, module_index: Integer, name: String): Integer
	start := load_integer(state.module_import_starts, module_index)
	mut index := start + load_integer(state.module_import_counts, module_index) - 1
	while index >= start
		if load_string(state.import_symbols, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def find_visible_record(mut state: CompilerState, module_index: Integer, name: String): Integer
	local := find_record_in_module(state, module_index, name)
	if local >= 0
		return local
	end
	import_index := find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := load_integer(state.import_targets, import_index)
	if target < 0
		return - 1
	end
	resolved := find_record_in_module(
		state,
		target,
		load_string(state.import_declarations, import_index),
	)
	if resolved >= 0
		store_integer(state.import_used, import_index, 1)
	end
	return resolved
end

def find_visible_function(mut state: CompilerState, module_index: Integer, name: String): Integer
	local := find_function_in_module(state, module_index, name)
	if local >= 0
		return local
	end
	import_index := find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := load_integer(state.import_targets, import_index)
	if target < 0
		return - 1
	end
	resolved := find_function_in_module(
		state,
		target,
		load_string(state.import_declarations, import_index),
	)
	if resolved >= 0
		store_integer(state.import_used, import_index, 1)
	end
	return resolved
end

def record_type(record_index: Integer): String
	return "Record#" + integer_string(record_index)
end

def find_record_type(state: CompilerState, type_name: String): Integer
	mut found :=- 1
	mut index := 0
	while index < state.record_count[0]
		if record_type(index) == type_name
			found = index
		end
		index += 1
	end
	return found
end

def type_display(state: CompilerState, type_name: String): String
	if hash_key_type(type_name) != ""
		return "Hash<" + hash_key_type(type_name) + ", " + type_display(state, hash_value_type(type_name)) + ">"
	end
	record_index := find_record_type(state, type_name)
	if record_index >= 0
		return load_string(state.record_names, record_index)
	end
	element := array_element_type(type_name)
	if element != ""
		return "Array<" + type_display(state, element) + ">"
	end
	return type_name
end

def find_field(state: CompilerState, record_index: Integer, name: String): Integer
	start := load_integer(state.record_field_starts, record_index)
	mut index := start + load_integer(state.record_field_counts, record_index) - 1
	while index >= start
		if load_string(state.field_names, index) == name
			return index
		end
		index -= 1
	end
	return - 1
end

def builtin_type_exists(type_name: String, allow_void: Boolean): Boolean
	if type_name == "Integer" || type_name == "Range<Integer>"
		return true
	end
	if type_name == "Float"
		return true
	end
	if type_name == "Boolean"
		return true
	end
	if type_name == "String"
		return true
	end
	if type_name == "Void"
		return allow_void
	end
	if array_element_type(type_name) != ""
		return true
	end
	return false
end

def resolve_type_name(
		mut state: CompilerState,
		module_index: Integer,
		type_name: String,
		allow_void: Boolean,
	): String
	key := hash_key_type(type_name)
	if key != ""
		value := resolve_type_name(state, module_index, hash_value_type(type_name), false)
		if value == ""
			return ""
		end
		return hash_type(key, value)
	end
	if builtin_type_exists(type_name, allow_void)
		return type_name
	end
	record_index := find_visible_record(state, module_index, type_name)
	if record_index >= 0
		return record_type(record_index)
	end
	mut element := array_inner_name(type_name)
	if element != ""
		mut depth := 1
		while depth < 3
			nested := array_inner_name(element)
			if nested == ""
				break
			end
			element = nested
			depth += 1
		end
		leaf := find_visible_record(state, module_index, element)
		if leaf >= 0
			mut resolved := record_type(leaf)
			while depth > 0
				resolved = "Array<" + resolved + ">"
				depth -= 1
			end
			return resolved
		end
	end
	return ""
end

# Extract syntax only; declaration resolution or canonical element validation
# must establish the type before this spelling reaches checked lowering.
def array_inner_name(type_name: String): String
	if type_name.size() < 8
		return ""
	end
	if !string_starts_with(type_name, "Array<")
		return ""
	end
	finish := type_name.size() - 1
	if type_name[finish] != ">"
		return ""
	end
	mut element := ""
	mut index := 6
	while index < finish
		element += type_name[index]
		index += 1
	end
	return element
end

def record_array_element(type_name: String): String
	if type_name.size() < 15
		return ""
	end
	element := array_inner_name(type_name)
	mut leaf := element
	mut depth := 1
	while depth < 3
		nested := array_inner_name(leaf)
		if nested == ""
			break
		end
		leaf = nested
		depth += 1
	end
	if !string_starts_with(leaf, "Record#")
		return ""
	end
	if leaf.size() < 8
		return ""
	end
	if leaf.size() > 8
		if leaf[7] == "0"
			return ""
		end
	end
	mut digit := 7
	while digit < leaf.size()
		code := ascii_code(leaf[digit])
		if code < 48
			return ""
		end
		if code > 57
			return ""
		end
		digit += 1
	end
	return element
end

def array_element_type(type_name: String): String
	if type_name == "Array<Range<Integer>>" || type_name == "Array<Array<Range<Integer>>>" || type_name == "Array<Array<Array<Range<Integer>>>>"
		return array_inner_name(type_name)
	end
	if type_name == "Array<Integer>"
		return "Integer"
	end
	if type_name == "Array<String>"
		return "String"
	end
	if type_name == "Array<Float>"
		return "Float"
	end
	if type_name == "Array<Array<Integer>>"
		return "Array<Integer>"
	end
	if type_name == "Array<Array<String>>"
		return "Array<String>"
	end
	if type_name == "Array<Array<Float>>"
		return "Array<Float>"
	end
	if type_name == "Array<Array<Array<Integer>>>"
		return "Array<Array<Integer>>"
	end
	if type_name == "Array<Array<Array<String>>>"
		return "Array<Array<String>>"
	end
	if type_name == "Array<Array<Array<Float>>>"
		return "Array<Array<Float>>"
	end
	if type_name == "Array<Boolean>"
		return "Boolean"
	end
	if type_name == "Array<Array<Boolean>>"
		return "Array<Boolean>"
	end
	if type_name == "Array<Array<Array<Boolean>>>"
		return "Array<Array<Boolean>>"
	end
	return record_array_element(type_name)
end

def array_type(element_type: String): String
	result := "Array<" + element_type + ">"
	if builtin_type_exists(result, false)
		return result
	end
	return ""
end

def common_array_element_type(left: String, right: String): String
	if left == ""
		return right
	end
	if left == right
		return left
	end
	if left == "Integer"
		if right == "Float"
			return "Float"
		end
	end
	if left == "Float"
		if right == "Integer"
			return "Float"
		end
	end
	return ""
end

def resolution_local_add(
		mut locals: CheckedLocals,
		name: String,
		type_name: String,
		mutable: Integer,
	)
	if local_find(locals, name) < 0
		index := locals.count[0]
		store_string(locals.names, index, name)
		store_string(locals.types, index, type_name)
		store_integer(locals.mutable, index, mutable)
		store_integer(locals.mir_values, index, 0)
		locals.count[0] = index + 1
	end
	return
end

def resolution_keyword(name: String): Boolean
	if name == "do"
		return true
	end
	mut keyword := false
	if name == "if"
		keyword = true
	end
	if name == "else"
		keyword = true
	end
	if name == "elsif"
		keyword = true
	end
	if name == "end"
		keyword = true
	end
	if name == "while"
		keyword = true
	end
	if name == "return"
		keyword = true
	end
	if name == "mut"
		keyword = true
	end
	if name == "true"
		keyword = true
	end
	if name == "false"
		keyword = true
	end
	return keyword
end

def is_typed_local_declaration(state: CompilerState, index: Integer): Boolean
	mut depth := 0
	mut cursor := index + 2
	while !terminal_token(state, cursor)
		if load_integer(state.token_kinds, cursor) == 4
			return false
		end
		if token_is(state, cursor, ":=")
			return depth == 0
		end
		if token_is(state, cursor, ",") && depth == 0
			return false
		end
		if token_is(state, cursor, ")")
			return false
		end
		if token_is(state, cursor, "<")
			depth += 1
		elsif token_is(state, cursor, ">")
			depth -= 1
		end
		cursor += 1
	end
	return false
end

def resolve_bare_imports(mut state: CompilerState): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		if load_integer(state.import_kinds, import_index) == 1
			module_index := load_integer(state.import_modules, import_index)
			state.active_module[0] = module_index
			mut target := load_integer(state.import_targets, import_index)
			line := load_integer(state.import_lines, import_index)
			if target == - 1
				target = standard_package_target(
					import_path_value(load_string(state.import_paths, import_index)),
				)
				if target < - 1
					store_integer(state.import_targets, import_index, target)
				end
			end
			if target < 0
				if target < - 1
					declaration := standard_package_root(target)
					store_string(state.import_declarations, import_index, declaration)
					if load_string(state.import_symbols, import_index) == ""
						store_string(state.import_symbols, import_index, declaration)
					end
				else
					diagnostic(state, "TRBN4003", line, "bare import target is unresolved")
					return false
				end
			else
				mut segment := load_string(state.module_names, target)
				if path_basename(segment) == "index"
					segment = path_directory(segment)
				end
				segment = path_basename(segment)
				wanted := path_root_key(segment)
				mut matches := 0
				mut declaration := ""
				mut candidates := ""
				mut record_index := 0
				while record_index < state.record_count[0]
					if load_integer(state.record_modules, record_index) == target
						name := load_string(state.record_names, record_index)
						if ascii_fold(name) == wanted
							if candidates != ""
								candidates += ", "
							end
							candidates += name
							declaration = name
							matches += 1
						end
					end
					record_index += 1
				end
				raw_path := load_string(state.import_paths, import_index)
				if matches == 0
					mut matching_function := false
					mut function_index := 0
					while function_index < state.function_count[0]
						if load_integer(state.function_modules, function_index) == target
							name := load_string(state.function_names, function_index)
							if ascii_fold(name) == wanted
								matching_function = true
							end
						end
						function_index += 1
					end
					if matching_function
						diagnostic(
							state,
							"TRBN4003",
							line,
							"import " + raw_path + " matches only a top-level function; use an exact named import",
						)
					else
						diagnostic(
							state,
							"TRBN4003",
							line,
							"import " + raw_path + " has no record root declaration matching " + segment,
						)
					end
					return false
				end
				if matches > 1
					diagnostic(
						state,
						"TRBN4003",
						line,
						"import " + raw_path + " has multiple record root declarations matching " + segment + ": " + candidates + "; use an exact named import",
					)
					return false
				end
				store_string(state.import_declarations, import_index, declaration)
				if load_string(state.import_symbols, import_index) == ""
					store_string(state.import_symbols, import_index, declaration)
				end
			end
		end
		import_index += 1
	end
	return true
end

def validate_import_bindings(mut state: CompilerState): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		module_index := load_integer(state.import_modules, import_index)
		state.active_module[0] = module_index
		name := load_string(state.import_symbols, import_index)
		declaration := load_string(state.import_declarations, import_index)
		line := load_integer(state.import_lines, import_index)
		target := load_integer(state.import_targets, import_index)
		mut other := load_integer(state.module_import_starts, module_index)
		while other < import_index
			other_target := load_integer(state.import_targets, other)
			other_declaration := load_string(state.import_declarations, other)
			if target >= 0
				if other_target == target
					if other_declaration == declaration
						diagnostic(
							state,
							"TRBN4003",
							line,
							"declaration " + declaration + " from " + load_string(state.module_names, target) + " is already imported as " + load_string(state.import_symbols, other),
						)
					end
				end
			end
			if !has_diagnostic(state)
				if load_string(state.import_symbols, other) == name
					diagnostic(state, "TRBN4003", line, "duplicate import binding " + name)
				end
			end
			other += 1
		end
		if find_record_in_module(state, module_index, name) >= 0
			diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		if find_function_in_module(state, module_index, name) >= 0
			diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		mut exported := target < - 1
		if target >= 0
			if find_record_in_module(state, target, declaration) >= 0
				exported = true
			end
			if find_function_in_module(state, target, declaration) >= 0
				exported = true
			end
		end
		if !exported
			diagnostic(state, "TRBN4003", line, "module does not export " + declaration)
		end
		import_index += 1
	end
	return !has_diagnostic(state)
end

def validate_import_usage(mut state: CompilerState): Boolean
	mut import_index := 0
	while import_index < state.import_count[0]
		if load_integer(state.import_used, import_index) == 0
			state.active_module[0] = load_integer(state.import_modules, import_index)
			diagnostic(
				state,
				"TRBN4003",
				load_integer(state.import_lines, import_index),
				"unused import " + load_string(state.import_symbols, import_index),
			)
		end
		import_index += 1
	end
	return !has_diagnostic(state)
end

def resolve_declarations(mut state: CompilerState): Boolean
	if !validate_import_bindings(state)
		return false
	end
	mut record_index := 0
	while record_index < state.record_count[0]
		module_index := load_integer(state.record_modules, record_index)
		state.active_module[0] = module_index
		mut other_record := record_index - 1
		while other_record >= 0
			if load_integer(state.record_modules, other_record) != module_index
				other_record =- 1
			else
				if load_string(state.record_names, other_record) == load_string(state.record_names, record_index)
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.record_lines, record_index),
						"duplicate record declaration " + load_string(state.record_names, record_index),
					)
				end
				other_record -= 1
			end
		end
		start := load_integer(state.record_field_starts, record_index)
		finish := start + load_integer(state.record_field_counts, record_index)
		mut field_index := start
		while field_index < finish
			mut other_field := start
			while other_field < field_index
				if load_string(state.field_names, other_field) == load_string(state.field_names, field_index)
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.field_lines, field_index),
						"duplicate field declaration " + load_string(state.field_names, field_index),
					)
				end
				other_field += 1
			end
			raw_type := load_string(state.field_types, field_index)
			resolved_type := resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				diagnostic(state, "TRBN4003", load_integer(state.field_lines, field_index), "unknown field type " + raw_type)
			else
				store_string(state.field_types, field_index, resolved_type)
			end
			field_index += 1
		end
		record_index += 1
	end
	mut main_count := 0
	mut declared_functions: Hash<String, Integer> := {}
	mut declared_module :=- 1
	mut function_index := 0
	while function_index < state.function_count[0]
		module_index := load_integer(state.function_modules, function_index)
		if module_index != declared_module
			declared_functions = {}
			declared_module = module_index
		end
		state.active_module[0] = module_index
		if module_index == state.entry_module[0]
			if load_string(state.function_names, function_index) == "main"
				main_count += 1
				if load_integer(state.function_parameter_counts, function_index) != 0
					diagnostic(state, "TRBN4003", load_integer(state.function_lines, function_index), "main must take no parameters")
				end
				if load_string(state.function_result_types, function_index) != "Void"
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.function_lines, function_index),
						"main must return Void, found " + load_string(state.function_result_types, function_index),
					)
				end
			end
		end
		name := load_string(state.function_names, function_index)
		if declared_functions.key?(name)
			diagnostic(
				state,
				"TRBN4003",
				load_integer(state.function_lines, function_index),
				"duplicate function declaration " + name,
			)
		else
			declared_functions[name] = 0
		end
		parameter_start := load_integer(state.function_parameter_starts, function_index)
		parameter_finish := parameter_start + load_integer(state.function_parameter_counts, function_index)
		mut parameter_index := parameter_start
		while parameter_index < parameter_finish
			mut other_parameter := parameter_start
			while other_parameter < parameter_index
				if load_string(state.parameter_names, other_parameter) == load_string(state.parameter_names, parameter_index)
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.parameter_lines, parameter_index),
						"duplicate parameter declaration " + load_string(state.parameter_names, parameter_index),
					)
				end
				other_parameter += 1
			end
			raw_type := load_string(state.parameter_types, parameter_index)
			resolved_type := resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				diagnostic(state, "TRBN4003", load_integer(state.parameter_lines, parameter_index), "unknown parameter type " + raw_type)
			else
				store_string(state.parameter_types, parameter_index, resolved_type)
			end
			parameter_index += 1
		end
		raw_result := load_string(state.function_result_types, function_index)
		resolved_result := resolve_type_name(state, module_index, raw_result, true)
		if resolved_result == ""
			diagnostic(state, "TRBN4003", load_integer(state.function_lines, function_index), "unknown result type " + raw_result)
		else
			store_string(state.function_result_types, function_index, resolved_result)
		end
		function_index += 1
	end
	if main_count != 1
		state.active_module[0] = state.entry_module[0]
		diagnostic(state, "TRBN4003", 1, "program must declare exactly one main function")
	end
	return !has_diagnostic(state)
end

def resolve_function_body(
		mut state: CompilerState,
		function_index: Integer,
		mut locals: CheckedLocals,
	): Boolean
	module_index := load_integer(state.function_modules, function_index)
	state.active_module[0] = module_index
	parameter_start := load_integer(state.function_parameter_starts, function_index)
	parameter_finish := parameter_start + load_integer(state.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		resolution_local_add(
			locals,
			load_string(state.parameter_names, parameter_index),
			load_string(state.parameter_types, parameter_index),
			load_integer(state.parameter_mutable, parameter_index),
		)
		parameter_index += 1
	end
	mut iteration_index := 0
	while iteration_index < state.iterations.size()
		iteration := state.iterations[iteration_index]
		if iteration.origin >= load_integer(state.function_body_starts, function_index) && iteration.finish <= load_integer(state.function_body_ends, function_index)
			resolution_local_add(locals, load_string(state.token_texts, iteration.element_origin), "", 1)
			if iteration.index_origin >= 0
				resolution_local_add(locals, load_string(state.token_texts, iteration.index_origin), "", 1)
			end
		end
		iteration_index += 1
	end
	mut index := load_integer(state.function_body_starts, function_index)
	finish := load_integer(state.function_body_ends, function_index)
	mut skipping_type := false
	while index < finish
		kind := load_integer(state.token_kinds, index)
		text := load_string(state.token_texts, index)
		if skipping_type
			if token_is(state, index, ":=")
				skipping_type = false
			end
		else
			if kind == 1
				mut keyword := resolution_keyword(text)
				if syntax_loop_transfer_kind(state, index) > 0
					mut leading := index == load_integer(state.function_body_starts, function_index)
					if !leading
						leading = load_integer(state.token_kinds, index - 1) == 4
						if !leading
							leading = token_is(state, index - 1, "|")
						end
					end
					if leading
						keyword = true
					end
				end
				if keyword
				else
					mut previous := ""
					if index > load_integer(state.function_body_starts, function_index)
						previous = load_string(state.token_texts, index - 1)
					end
					if previous == "."
					else
						if token_is(state, index + 1, ":=")
							resolution_local_add(locals, text, "", 0)
						else
							if token_is(state, index + 1, ":")
								if is_typed_local_declaration(state, index)
									resolution_local_add(locals, text, "", 0)
									skipping_type = true
								end
							else
								if token_is(state, index + 1, "(")
									if text != "puts"
										if find_visible_function(state, module_index, text) < 0
											diagnostic(
												state,
												"TRBN4003",
												load_integer(state.token_lines, index),
												"unresolved function " + text,
											)
										end
									end
								else
									if token_is(state, index + 1, ".")
										if token_is(state, index + 2, "new")
											if find_visible_record(state, module_index, text) < 0
												diagnostic(
													state,
													"TRBN4003",
													load_integer(state.token_lines, index),
													"unresolved record " + text,
												)
											end
										else
											if local_find(locals, text) < 0
												if find_import_binding(state, module_index, text) < 0
													diagnostic(
														state,
														"TRBN4003",
														load_integer(state.token_lines, index),
														"unresolved local " + text,
													)
												end
											end
										end
									else
										if local_find(locals, text) < 0
											diagnostic(
												state,
												"TRBN4003",
												load_integer(state.token_lines, index),
												"unresolved local " + text,
											)
										end
									end
								end
							end
						end
					end
				end
			end
		end
		index += 1
	end
	return !has_diagnostic(state)
end

def resolve(mut state: CompilerState): Boolean
	if !resolve_bare_imports(state)
		return false
	end
	if !resolve_declarations(state)
		return false
	end
	mut function_index := 0
	while function_index < state.function_count[0]
		mut locals := locals_new(state.token_count[0] + 1)
		resolve_function_body(state, function_index, locals)
		function_index += 1
	end
	return !has_diagnostic(state)
end

def compiler_entry_function(state: CompilerState): Integer
	index := find_function_in_module(state, state.entry_module[0], "compiler_main")
	if index < 0
		return - 1
	end
	if load_integer(state.function_parameter_counts, index) != 3
		return - 1
	end
	start := load_integer(state.function_parameter_starts, index)
	if load_string(state.parameter_types, start) != "String"
		return - 1
	end
	if load_string(state.parameter_types, start + 1) != "String"
		return - 1
	end
	if load_string(state.parameter_types, start + 2) != "Boolean"
		return - 1
	end
	if load_string(state.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def compiler_runtime_intrinsic(name: String): Boolean
	if name == "compiler_reset_temporary_storage" || name == "compiler_file_exists" || name == "compiler_read_source" || name == "compiler_source_slice" || name == "compiler_collect_project_sources" || name == "compiler_eputs"
		return true
	end
	return false
end
