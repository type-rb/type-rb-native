import { resolution_local_add, resolve_body_names } from body_resolution
import { find_object_in_module, object_initializer_owner } from object_types
import { resolve_object_declarations, validate_object_inheritance } from object_resolution
import { builtin_result_source } from builtin_results
import { resolve_newtype_declarations, validate_closed_newtypes } from newtype_resolution
import { find_newtype_in_module } from newtype_types
import { resolve_raw_enum_results } from raw_enum_resolution
import { declare_global_functions } from global_declarations
import { namespace_parent } from namespace_model
import { validate_generic_functions } from generic_functions
import { load_standard_source, standard_source_kind } from standard_library
import { find_alias_in_module, find_declaration_in_module, find_function_in_module, find_generic_function_in_module, find_generic_in_module, find_import_binding, find_record_in_module, find_visible_function } from declaration_lookup
import { resolve_type_name, type_display } from type_resolution
import { EnumField } from enum_model
import { validate_alias_declarations, validate_generic_declarations } from generic_validation
import { find_enum_in_module, find_enum_variant } from enum_types
import { path_basename, path_directory, string_without_suffix } from path
import { CompilerState, diagnostic, has_diagnostic, select_checked_body } from state
import { CheckedLocals, locals_new } from local_state
import { load_integer, load_string, sparse_string_at, store_integer, store_string } from storage
import { declare_default_functions } from default_arguments

def import_path_value(raw: String): String
	mut path := string_without_suffix(raw, ".trb")
	if path == ""
		return ""
	end
	if path[0] == "/"
		return ""
	end
	mut simple := true
	mut simple_index := 0
	while simple_index < path.size()
		character := path[simple_index]
		if character == ":"
			simple = false
		end
		if character == "/"
			simple = false
		end
		if character == "."
			simple = false
		end
		simple_index += 1
	end
	if simple
		return path
	end
	mut segments: Array<String> := []
	mut segment := ""
	mut index := 0
	while index <= path.size()
		mut character := "/"
		if index < path.size()
			character = path[index]
		end
		if character == ":"
			return ""
		end
		if character == "/"
			if segment == ".."
				return ""
			end
			if segment != ""
				if segment != "."
					segments.push(segment)
				end
			end
			segment = ""
		else
			segment += character
		end
		index += 1
	end
	if segments.size() == 0
		return ""
	end
	mut normalized := ""
	index = 0
	while index < segments.size()
		if normalized != ""
			normalized += "/"
		end
		normalized += segments[index]
		index += 1
	end
	return normalized
end

def normalize_import_path(mut state: CompilerState, raw: String, line: Integer): String
	normalized := import_path_value(raw)
	if normalized == ""
		diagnostic(state, "TRBN4003", line, "invalid project import path " + raw)
	end
	return normalized
end

def ascii_fold(value: String): String
	upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	mut result := ""
	mut index := 0
	while index < value.size()
		character := value[index]
		mut folded := character
		mut letter := 0
		while letter < upper.size()
			if upper[letter] == character
				folded = "abcdefghijklmnopqrstuvwxyz"[letter]
				letter = upper.size()
			else
				letter += 1
			end
		end
		result += folded
		index += 1
	end
	return result
end

def path_root_key(name: String): String
	mut without_underscores := ""
	mut index := 0
	while index < name.size()
		if name[index] != "_"
			without_underscores += name[index]
		end
		index += 1
	end
	return ascii_fold(without_underscores)
end

def standard_package_target(path: String): Integer
	if path == "trb/std/process"
		return - 2
	end
	if path == "trb/std/math"
		return - 3
	end
	return - 1
end

def standard_package_root(target: Integer): String
	if target == - 2
		return "Process"
	end
	return "Math"
end

def standard_package_import(
		mut state: CompilerState,
		module_index: Integer,
		name: String,
	): Integer
	import_index := find_import_binding(state, module_index, name)
	if import_index < 0
		return - 1
	end
	target := load_integer(state.module_graph.import_targets, import_index)
	if target < - 1
		store_integer(state.module_graph.import_used, import_index, 1)
	end
	return target
end

def resolve_bare_imports(mut state: CompilerState): Boolean
	mut import_index := 0
	while import_index < state.module_graph.import_count[0]
		if load_integer(state.module_graph.import_kinds, import_index) == 1
			module_index := load_integer(state.module_graph.import_modules, import_index)
			state.module_graph.active_module[0] = module_index
			mut target := load_integer(state.module_graph.import_targets, import_index)
			line := load_integer(state.module_graph.import_lines, import_index)
			if target == - 1
				target = standard_package_target(
					import_path_value(load_string(state.module_graph.import_paths, import_index)),
				)
				if target < - 1
					store_integer(state.module_graph.import_targets, import_index, target)
				end
			end
			if target < 0
				if target < - 1
					declaration := standard_package_root(target)
					store_string(state.module_graph.import_declarations, import_index, declaration)
					if load_string(state.module_graph.import_symbols, import_index) == ""
						store_string(state.module_graph.import_symbols, import_index, declaration)
					end
				else
					diagnostic(state, "TRBN4003", line, "bare import target is unresolved")
					return false
				end
			else
				mut segment := load_string(state.module_graph.module_names, target)
				if path_basename(segment) == "index"
					segment = path_directory(segment)
				end
				segment = path_basename(segment)
				wanted := path_root_key(segment)
				mut matches := 0
				mut declaration := ""
				mut candidates := ""
				state.global_bindings.globals.each do |definition|
					if definition.constant && definition.source_id == target && ascii_fold(definition.name) == wanted
						if candidates != ""
							candidates += ", "
						end
						candidates += definition.name
						declaration = definition.name
						matches += 1
					end
				end
				state.global_bindings.namespaces.each do |definition|
					if definition.source_id == target && ascii_fold(definition.name) == wanted
						if candidates != ""
							candidates += ", "
						end
						candidates += definition.name
						declaration = definition.name
						matches += 1
					end
				end
				mut record_index := 0
				while record_index < state.declarations.record_count[0]
					if load_integer(state.declarations.record_modules, record_index) == target
						name := load_string(state.declarations.record_names, record_index)
						if ascii_fold(name) == wanted
							if candidates != ""
								candidates += ", "
							end
							candidates += name
							declaration = name
							matches += 1
						end
					end
					record_index += 1
				end
				state.nominal.enums.each do |definition|
					if definition.source_id == target && ascii_fold(definition.name) == wanted
						if candidates != ""
							candidates += ", "
						end
						candidates += definition.name
						declaration = definition.name
						matches += 1
					end
				end
				state.type_resolution.generic_definitions.each do |definition|
					if definition.source_id == target && ascii_fold(definition.name) == wanted
						if candidates != ""
							candidates += ", "
						end
						candidates += definition.name
						declaration = definition.name
						matches += 1
					end
				end
				state.nominal.newtypes.each do |definition|
					if definition.source_id == target && ascii_fold(definition.name) == wanted
						if candidates != ""
							candidates += ", "
						end
						candidates += definition.name
						declaration = definition.name
						matches += 1
					end
				end
				state.type_resolution.type_aliases.each do |definition|
					if definition.source_id == target && ascii_fold(definition.name) == wanted
						if candidates != ""
							candidates += ", "
						end
						candidates += definition.name
						declaration = definition.name
						matches += 1
					end
				end
				raw_path := load_string(state.module_graph.import_paths, import_index)
				if matches == 0
					mut matching_function := false
					mut function_index := 0
					while function_index < state.declarations.function_count[0]
						if load_integer(state.declarations.function_modules, function_index) == target
							name := load_string(state.declarations.function_names, function_index)
							if ascii_fold(name) == wanted
								matching_function = true
							end
						end
						function_index += 1
					end
					state.type_resolution.generic_functions.each do |definition|
						if definition.source_id == target && ascii_fold(definition.name) == wanted
							matching_function = true
						end
					end
					if matching_function
						diagnostic(
							state,
							"TRBN4003",
							line,
							"import " + raw_path + " matches only a top-level function; use an exact named import",
						)
					else
						diagnostic(
							state,
							"TRBN4003",
							line,
							"import " + raw_path + " has no record root declaration matching " + segment,
						)
					end
					return false
				end
				if matches > 1
					diagnostic(
						state,
						"TRBN4003",
						line,
						"import " + raw_path + " has multiple record root declarations matching " + segment + ": " + candidates + "; use an exact named import",
					)
					return false
				end
				store_string(state.module_graph.import_declarations, import_index, declaration)
				if load_string(state.module_graph.import_symbols, import_index) == ""
					store_string(state.module_graph.import_symbols, import_index, declaration)
				end
			end
		end
		import_index += 1
	end
	return true
end

def validate_import_bindings(mut state: CompilerState): Boolean
	mut import_index := 0
	while import_index < state.module_graph.import_count[0]
		module_index := load_integer(state.module_graph.import_modules, import_index)
		state.module_graph.active_module[0] = module_index
		name := load_string(state.module_graph.import_symbols, import_index)
		declaration := load_string(state.module_graph.import_declarations, import_index)
		line := load_integer(state.module_graph.import_lines, import_index)
		target := load_integer(state.module_graph.import_targets, import_index)
		mut other := load_integer(state.module_graph.module_import_starts, module_index)
		while other < import_index
			other_target := load_integer(state.module_graph.import_targets, other)
			other_declaration := load_string(state.module_graph.import_declarations, other)
			if target >= 0
				if other_target == target
					if other_declaration == declaration
						diagnostic(
							state,
							"TRBN4003",
							line,
							"declaration " + declaration + " from " + load_string(state.module_graph.module_names, target) + " is already imported as " + load_string(state.module_graph.import_symbols, other),
						)
					end
				end
			end
			if !has_diagnostic(state)
				if load_string(state.module_graph.import_symbols, other) == name
					diagnostic(state, "TRBN4003", line, "duplicate import binding " + name)
				end
			end
			other += 1
		end
		if find_record_in_module(state, module_index, name) >= 0 || find_enum_in_module(state, module_index, name) >= 0 || find_generic_in_module(state, module_index, name) >= 0 || find_alias_in_module(state, module_index, name) >= 0 || find_newtype_in_module(state, module_index, name) >= 0 || find_object_in_module(state, module_index, name) >= 0
			diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		if find_function_in_module(state, module_index, name) >= 0 || find_generic_function_in_module(state, module_index, name) >= 0
			diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		mut exported := target < - 1
		if find_declaration_in_module(state, module_index, name, 6) >= 0 || find_declaration_in_module(state, module_index, name, 7) >= 0
			diagnostic(state, "TRBN4003", line, "import binding conflicts with local declaration " + name)
		end
		if target >= 0
			global := find_declaration_in_module(state, target, declaration, 7)
			if find_declaration_in_module(state, target, declaration, 6) >= 0 || (global >= 0 && state.global_bindings.globals[global].constant)
				exported = true
			end
			if find_record_in_module(state, target, declaration) >= 0 || find_enum_in_module(state, target, declaration) >= 0 || find_generic_in_module(state, target, declaration) >= 0 || find_alias_in_module(state, target, declaration) >= 0 || find_newtype_in_module(state, target, declaration) >= 0 || find_object_in_module(state, target, declaration) >= 0
				exported = true
			end
			if find_function_in_module(state, target, declaration) >= 0 || find_generic_function_in_module(state, target, declaration) >= 0
				exported = true
			end
		end
		if !exported
			diagnostic(state, "TRBN4003", line, "module does not export " + declaration)
		end
		import_index += 1
	end
	return !has_diagnostic(state)
end

def validate_import_usage(mut state: CompilerState): Boolean
	mut import_index := 0
	while import_index < state.module_graph.import_count[0]
		if load_integer(state.module_graph.import_used, import_index) == 0
			state.module_graph.active_module[0] = load_integer(state.module_graph.import_modules, import_index)
			diagnostic(
				state,
				"TRBN4003",
				load_integer(state.module_graph.import_lines, import_index),
				"unused import " + load_string(state.module_graph.import_symbols, import_index),
			)
		end
		import_index += 1
	end
	return !has_diagnostic(state)
end

def resolve_declarations(mut state: CompilerState): Boolean
	state.global_bindings.namespaces.each do |declaration|
		mut kind := 0
		while kind < 6
			if find_declaration_in_module(state, declaration.source_id, declaration.name, kind) >= 0
				state.module_graph.active_module[0] = declaration.source_id
				diagnostic(state, "TRBN4003", declaration.line, "duplicate declaration " + declaration.name)
			end
			kind += 1
		end
	end
	if has_diagnostic(state)
		return false
	end
	if !validate_import_bindings(state)
		return false
	end
	if !validate_alias_declarations(state)
		return false
	end
	if !validate_generic_functions(state)
		return false
	end
	if !validate_generic_declarations(state)
		return false
	end
	if !resolve_object_declarations(state)
		return false
	end
	if !resolve_enum_declarations(state)
		return false
	end
	if !resolve_newtype_declarations(state)
		return false
	end
	mut record_index := 0
	while record_index < state.declarations.record_count[0]
		module_index := load_integer(state.declarations.record_modules, record_index)
		state.module_graph.active_module[0] = module_index
		mut other_record := record_index - 1
		state.global_bindings.declaration_owner[0] = namespace_parent(load_string(state.declarations.record_names, record_index))
		while other_record >= 0
			if load_integer(state.declarations.record_modules, other_record) != module_index
				other_record =- 1
			else
				if load_string(state.declarations.record_names, other_record) == load_string(state.declarations.record_names, record_index)
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.declarations.record_lines, record_index),
						"duplicate record declaration " + load_string(state.declarations.record_names, record_index),
					)
				end
				other_record -= 1
			end
		end
		start := load_integer(state.declarations.record_field_starts, record_index)
		finish := start + load_integer(state.declarations.record_field_counts, record_index)
		mut field_index := start
		while field_index < finish
			mut other_field := start
			while other_field < field_index
				if load_string(state.declarations.field_names, other_field) == load_string(state.declarations.field_names, field_index)
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.declarations.field_lines, field_index),
						"duplicate field declaration " + load_string(state.declarations.field_names, field_index),
					)
				end
				other_field += 1
			end
			raw_type := load_string(state.declarations.field_types, field_index)
			resolved_type := resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				diagnostic(state, "TRBN4003", load_integer(state.declarations.field_lines, field_index), "unknown field type " + type_display(state, raw_type))
			else
				store_string(state.declarations.field_types, field_index, resolved_type)
			end
			field_index += 1
		end
		record_index += 1
	end
	if !validate_closed_newtypes(state)
		return false
	end
	mut main_count := 0
	mut declared_functions: Hash<String, Integer> := {}
	mut declared_module :=- 1
	mut function_index := 0
	while function_index < state.declarations.function_count[0]
		module_index := load_integer(state.declarations.function_modules, function_index)
		if module_index != declared_module
			declared_functions = {}
			declared_module = module_index
		end
		state.module_graph.active_module[0] = module_index
		if module_index == state.module_graph.entry_module[0]
			if load_string(state.declarations.function_names, function_index) == "main"
				main_count += 1
				if load_integer(state.declarations.function_parameter_counts, function_index) != 0
					diagnostic(state, "TRBN4003", load_integer(state.declarations.function_lines, function_index), "main must take no parameters")
				end
				if load_string(state.declarations.function_result_types, function_index) != "Void"
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.declarations.function_lines, function_index),
						"main must return Void, found " + load_string(state.declarations.function_result_types, function_index),
					)
				end
			end
		end
		name := load_string(state.declarations.function_names, function_index)
		state.global_bindings.declaration_owner[0] = namespace_parent(name)
		if declared_functions.key?(name)
			diagnostic(
				state,
				"TRBN4003",
				load_integer(state.declarations.function_lines, function_index),
				"duplicate function declaration " + name,
			)
		else
			declared_functions[name] = 0
		end
		parameter_start := load_integer(state.declarations.function_parameter_starts, function_index)
		parameter_finish := parameter_start + load_integer(state.declarations.function_parameter_counts, function_index)
		mut parameter_index := parameter_start
		while parameter_index < parameter_finish
			mut other_parameter := parameter_start
			while other_parameter < parameter_index
				if load_string(state.declarations.parameter_names, other_parameter) == load_string(state.declarations.parameter_names, parameter_index)
					diagnostic(
						state,
						"TRBN4003",
						load_integer(state.declarations.parameter_lines, parameter_index),
						"duplicate parameter declaration " + load_string(state.declarations.parameter_names, parameter_index),
					)
				end
				other_parameter += 1
			end
			raw_type := load_string(state.declarations.parameter_types, parameter_index)
			resolved_type := resolve_type_name(state, module_index, raw_type, false)
			if resolved_type == ""
				diagnostic(state, "TRBN4003", load_integer(state.declarations.parameter_lines, parameter_index), "unknown parameter type " + type_display(state, raw_type))
			else
				store_string(state.declarations.parameter_types, parameter_index, resolved_type)
			end
			parameter_index += 1
		end
		raw_result := load_string(state.declarations.function_result_types, function_index)
		resolved_result := resolve_type_name(state, module_index, raw_result, true)
		if resolved_result == ""
			diagnostic(state, "TRBN4003", load_integer(state.declarations.function_lines, function_index), "unknown result type " + type_display(state, raw_result))
		else
			store_string(state.declarations.function_result_types, function_index, resolved_result)
		end
		function_index += 1
	end
	if main_count != 1
		state.module_graph.active_module[0] = state.module_graph.entry_module[0]
		diagnostic(state, "TRBN4003", 1, "program must declare exactly one main function")
	end
	return !has_diagnostic(state)
end

def resolve_function_body(
		mut state: CompilerState,
		function_index: Integer,
		mut locals: CheckedLocals,
	): Boolean
	select_checked_body(state, function_index)
	module_index := load_integer(state.declarations.function_modules, function_index)
	state.module_graph.active_module[0] = module_index
	body_start := load_integer(state.declarations.function_body_starts, function_index)
	state.global_bindings.declaration_owner[0] = sparse_string_at(state.source_tokens.token_namespaces, body_start)
	body_finish := load_integer(state.declarations.function_body_ends, function_index)
	parameter_start := load_integer(state.declarations.function_parameter_starts, function_index)
	parameter_finish := parameter_start + load_integer(state.declarations.function_parameter_counts, function_index)
	mut parameter_index := parameter_start
	while parameter_index < parameter_finish
		resolution_local_add(
			locals,
			load_string(state.declarations.parameter_names, parameter_index),
			load_string(state.declarations.parameter_types, parameter_index),
			load_integer(state.declarations.parameter_mutable, parameter_index),
		)
		parameter_index += 1
	end
	owner := object_initializer_owner(state, function_index)
	if owner >= 0
		state.nominal.object_instances[owner].fields.each do |field|
			if field.default_start >= 0 && !resolve_body_names(state, field.default_start, field.default_finish, locals)
				return false
			end
		end
	end
	return resolve_body_names(state, body_start, body_finish, locals)
end

# Resolve one owned lexical region, shared by named and anonymous bodies.
def resolve(mut state: CompilerState): Boolean
	if state.nominal.raw_enum_values.size() > 0 || builtin_result_source(state)
		load_standard_source(state, 1)
		load_standard_source(state, 3)
	end
	mut import_index := 0
	while import_index < state.module_graph.import_count[0]
		kind := standard_source_kind(import_path_value(load_string(state.module_graph.import_paths, import_index)))
		if kind > 0
			store_integer(state.module_graph.import_targets, import_index, load_standard_source(state, kind))
		end
		import_index += 1
	end
	if !resolve_bare_imports(state)
		return false
	end
	if !resolve_declarations(state)
		return false
	end
	if !resolve_raw_enum_results(state)
		return false
	end
	declare_default_functions(state)
	if !declare_global_functions(state)
		return false
	end
	mut function_index := 0
	while function_index < state.declarations.function_count[0]
		mut locals := locals_new(state.source_tokens.token_count[0] + 1)
		resolve_function_body(state, function_index, locals)
		declare_default_functions(state)
		function_index += 1
		if has_diagnostic(state)
			return false
		end
	end
	return validate_object_inheritance(state)
end

def compiler_main_signature(state: CompilerState, index: Integer): Integer
	if index < 0
		return - 1
	end
	if load_integer(state.declarations.function_parameter_counts, index) != 3
		return - 1
	end
	start := load_integer(state.declarations.function_parameter_starts, index)
	if load_string(state.declarations.parameter_types, start) != "String"
		return - 1
	end
	if load_string(state.declarations.parameter_types, start + 1) != "String"
		return - 1
	end
	if load_string(state.declarations.parameter_types, start + 2) != "Boolean"
		return - 1
	end
	if load_string(state.declarations.function_result_types, index) != "Integer"
		return - 1
	end
	return index
end

def compiler_entry_function(state: CompilerState): Integer
	return compiler_main_signature(state, find_function_in_module(state, state.module_graph.entry_module[0], "compiler_main"))
end

# CLI entry adapters import the ordinary compiler under core_main. Follow that
# declaration to its own visible bindings, including extracted intrinsic owners.
def compiler_runtime_owner(state: CompilerState): Integer
	if compiler_entry_function(state) < 0
		return - 1
	end
	if find_function_in_module(state, state.module_graph.entry_module[0], "native_cli_main") >= 0
		core := find_visible_function(state, state.module_graph.entry_module[0], "core_main")
		if compiler_main_signature(state, core) < 0
			return - 1
		end
		if load_string(state.declarations.function_names, core) != "compiler_main"
			return - 1
		end
		return load_integer(state.declarations.function_modules, core)
	end
	return state.module_graph.entry_module[0]
end

def compiler_runtime_intrinsic(state: CompilerState, function_index: Integer): Boolean
	if function_index < 0 || function_index >= state.declarations.function_count[0]
		return false
	end
	name := load_string(state.declarations.function_names, function_index)
	if name == "compiler_string_bytes" || name == "compiler_source_is_utf8" || name == "compiler_literal_byte"
		owner := compiler_runtime_owner(state)
		if owner >= 0
			mut anchor := "emit_static_strings"
			if name == "compiler_source_is_utf8" || name == "compiler_literal_byte"
				anchor = "compiler_source_slice"
			end
			emitter := find_visible_function(state, owner, anchor)
			if emitter >= 0
				if name == "compiler_literal_byte"
					decoder := find_visible_function(state, load_integer(state.declarations.function_modules, emitter), "decode_escape")
					if decoder < 0
						return false
					end
					return find_visible_function(state, load_integer(state.declarations.function_modules, decoder), name) == function_index
				end
				return find_visible_function(state, load_integer(state.declarations.function_modules, emitter), name) == function_index
			end
		end
		return false
	end
	if name == "compiler_reset_temporary_storage" || name == "compiler_file_exists" || name == "compiler_read_source" || name == "compiler_source_slice" || name == "compiler_collect_project_sources" || name == "compiler_eputs"
		owner := compiler_runtime_owner(state)
		if owner >= 0
			return find_visible_function(state, owner, name) == function_index
		end
	end
	return false
end

def compiler_host_intrinsic(state: CompilerState, function_index: Integer): Boolean
	if function_index < 0 || function_index >= state.declarations.function_count[0]
		return false
	end
	if compiler_entry_function(state) < 0 || find_function_in_module(state, state.module_graph.entry_module[0], "native_cli_main") < 0
		return false
	end
	return load_string(state.module_graph.module_names, load_integer(state.declarations.function_modules, function_index)) == "host"
end

def resolve_enum_declarations(mut state: CompilerState): Boolean
	mut owner := 0
	while owner < state.nominal.enums.size()
		definition := state.nominal.enums[owner]
		state.module_graph.active_module[0] = definition.source_id
		state.global_bindings.declaration_owner[0] = namespace_parent(definition.name)
		if find_enum_in_module(state, definition.source_id, definition.name) != owner || find_record_in_module(state, definition.source_id, definition.name) >= 0 || find_function_in_module(state, definition.source_id, definition.name) >= 0
			diagnostic(state, "TRBN4003", definition.line, "duplicate declaration " + definition.name)
		end
		mut variant := definition.variant_start
		while variant < definition.variant_start + definition.variant_count
			row := state.nominal.enum_variants[variant]
			if find_enum_variant(state, owner, row.name) != variant
				diagnostic(state, "TRBN4003", row.line, "duplicate enum variant " + row.name)
			end
			mut field := row.field_start
			while field < row.field_start + row.field_count
				item := state.nominal.enum_fields[field]
				mut previous := row.field_start
				while previous < field
					if state.nominal.enum_fields[previous].name == item.name
						diagnostic(state, "TRBN4003", item.line, "duplicate enum payload field " + item.name)
					end
					previous += 1
				end
				type_name := resolve_type_name(state, definition.source_id, item.type_name, false)
				if type_name == ""
					diagnostic(state, "TRBN4003", item.line, "unknown enum payload type " + item.type_name)
				end
				state.nominal.enum_fields[field] = EnumField.new(name: item.name, type_name: type_name, line: item.line, named_only: item.named_only)
				field += 1
			end
			variant += 1
		end
		owner += 1
	end
	return !has_diagnostic(state)
end
