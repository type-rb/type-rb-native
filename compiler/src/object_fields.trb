import { CheckedValue, checked_bound_value, checked_mir_value, scalar_mir_disable, scalar_mir_instruction, scalar_mir_value } from checked_values
import { MirIndexedTarget } from mir
import { mir_binding_read } from mir_bindings
import { mir_control_active, mir_control_prepare } from mir_control
import { find_object_type, object_field_index, object_initializer_owner } from object_types
import { CheckedLocals, CompilerState, diagnostic, local_find } from state
import { load_integer, load_string } from storage
import { binary_operator_id } from syntax_forms
import { token_is } from syntax_tokens

# Lvalues keep the receiver SSA value, never a raw interior pointer. Plain
# assignment selects storage without reading a possibly uninitialized field.
def checked_object_field(mut state: CompilerState, mut locals: CheckedLocals, receiver: CheckedValue, field: Integer, origin: Integer, next_token: Integer, internal: Boolean): CheckedValue
	owner := find_object_type(state, receiver.type_name)
	row := state.object_instances[owner].fields[field]
	mut readonly := row.readonly
	mut mutable := receiver.mutable
	mut binding := receiver.binding
	if internal
		mutable = 1
		binding = true
		if object_initializer_owner(state, locals.mir_state[1]) == owner
			readonly = false
		end
	elsif row.name.size() > 1 && row.name[1] == "_"
		diagnostic(state, "TRBN4004", row.line, "private class field cannot be accessed externally")
	end
	assignment := token_is(state, next_token, "=")
	compound := binary_operator_id(load_string(state.token_texts, next_token)) >= 17
	mir_control_prepare(state, locals)
	operand := checked_mir_value(receiver)
	mut category := 0
	if mir_control_active(locals) && operand >= 0
		if assignment || compound
			locals.mir_object_targets.push(MirIndexedTarget.new(origin: origin, owner: operand, index: field))
		end
		if !assignment
			category = mir_checked_object_field(state, locals, receiver, field, origin).category
		end
	end
	return CheckedValue.new(type_name: row.type_name, category: category, origin: origin, mutable: mutable, binding: binding, readonly: readonly, immutable_reference: false, nullable_binding: - 1, nullable_field: - 1, truth: - 1, falsity: - 1, flow_type: row.type_name)
end

# Common union members use the same typed field read after their payload has
# been checked. This operation carries no assignment target or source lookup.
def mir_checked_object_field(mut state: CompilerState, mut locals: CheckedLocals, receiver: CheckedValue, field: Integer, origin: Integer): CheckedValue
	owner := find_object_type(state, receiver.type_name)
	row := state.object_instances[owner].fields[field]
	mut category := 0
	mir_control_prepare(state, locals)
	operand := checked_mir_value(receiver)
	if mir_control_active(locals) && operand >= 0
		result := scalar_mir_value(state, locals, state.scalar_mir.objects[owner].fields[field].type_id, origin)
		scalar_mir_instruction(state, locals, 64, result, operand, - 1, field, - 1, load_integer(state.token_lines, origin))
		category =- result - 1
	end
	return checked_bound_value(row.type_name, category, origin, receiver.mutable, receiver.binding)
end

def checked_instance_field(mut state: CompilerState, mut locals: CheckedLocals, origin: Integer, next_token: Integer): CheckedValue
	slot := local_find(locals, "self")
	if slot >= 0
		receiver := mir_binding_read(state, locals, slot, origin)
		owner := find_object_type(state, receiver.type_name)
		if owner >= 0
			field := object_field_index(state, owner, load_string(state.token_texts, origin))
			if field >= 0
				return checked_object_field(state, locals, receiver, field, origin, next_token, true)
			end
		end
	end
	diagnostic(state, "TRBN4004", load_integer(state.token_lines, origin), "instance field requires its declaring receiver")
	return checked_bound_value("Invalid", 0, origin, 0, false)
end

def mir_checked_object_store(mut state: CompilerState, mut locals: CheckedLocals, target: CheckedValue, value: CheckedValue): Boolean
	mut index := locals.mir_object_targets.size() - 1
	while index >= 0
		row := locals.mir_object_targets[index]
		if row.origin == target.origin
			if mir_control_active(locals)
				operand := checked_mir_value(value)
				if operand < 0
					scalar_mir_disable(locals)
				else
					scalar_mir_instruction(state, locals, 65, - 1, row.owner, operand, row.index, - 1, load_integer(state.token_lines, target.origin))
				end
			end
			return true
		end
		index -= 1
	end
	return false
end

def mir_initialize_object_field(mut state: CompilerState, mut locals: CheckedLocals, owner: Integer, name: String, value: CheckedValue, origin: Integer)
	if mir_control_active(locals)
		receiver := mir_binding_read(state, locals, local_find(locals, "self"), origin)
		field := object_field_index(state, owner, name)
		scalar_mir_instruction(state, locals, 65, - 1, checked_mir_value(receiver), checked_mir_value(value), field, - 1, load_integer(state.token_lines, origin))
	end
end
