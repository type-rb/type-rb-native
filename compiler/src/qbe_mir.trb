import { emit_mir_call } from qbe_calls
import { mir_semantic_type_name } from mir_types
import { integer_string, number_without_underscores } from literals
import { MirInstruction, mir_block_index, mir_function_index } from mir
import { mir_scalar_result_fact } from mir_analysis
import { QbeEmitContext, QbeValue, emit_label, emit_temporary, emitted_value } from qbe_context
import { lower_binary_operand } from qbe_numeric
import { QbeOutput, qbe_output_branch, qbe_output_line } from qbe_output
import { CompilerState } from state

def emit_mir_scalar_instruction(
		state: CompilerState,
		function_index: Integer,
		instruction: MirInstruction,
		operands: Array<String>,
		types: Array<String>,
		facts: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		inline: Boolean,
		safe: Boolean,
	): QbeValue
	if instruction.kind == 11
		return emit_mir_call(state, instruction, operands, context, output)
	end
	result_type := types[instruction.result]
	mut result := emitted_value("", result_type, 0, "", "")
	if instruction.kind == 6
		literal := number_without_underscores(state.scalar_mir.literal_texts[instruction.payload])
		mut operand := literal
		if result_type == "Boolean"
			operand = "0"
			if literal == "true"
				operand = "1"
			end
		end
		if result_type == "Float"
			operand = "d_" + literal
		end
		result = emitted_value(operand, result_type, 0, "", "")
	else
		if instruction.kind == 7
			left_id := instruction.first
			right_id := instruction.second
			mut operator_id := instruction.payload
			mut guarded_operator := instruction.payload
			if operator_id == 12
				operator_id = 3
			end
			if operator_id == 13
				operator_id = 1
			end
			if !inline
				guarded_operator = 0
			end
			mut operand := ""
			if safe && result_type == "Integer"
				operand = emit_temporary(context)
				mut operation := "add"
				if operator_id == 3
					operation = "mul"
				elsif operator_id == 4
					operation = "udiv"
				end
				qbe_output_line(output, "\t" + operand + " =l " + operation + " " + operands[left_id] + ", " + operands[right_id])
			else
				operand = lower_binary_operand(
					context,
					output,
					operator_id,
					emitted_value(operands[left_id], types[left_id], 0, "", ""),
					emitted_value(operands[right_id], types[right_id], 0, "", ""),
					result_type,
					facts[left_id] == 1,
					facts[right_id] == 1,
					guarded_operator,
				)
			end
			result = emitted_value(operand, result_type, 0, "", "")
		else
			if instruction.kind == 8
				value_id := instruction.first
				if instruction.payload == 1
					operand := emit_temporary(context)
					qbe_output_line(output, "\t" + operand + " =l ceql " + operands[value_id] + ", 0")
					result = emitted_value(operand, "Boolean", 0, "", "")
				else
					if instruction.payload == 2
						operand := emit_temporary(context)
						if result_type == "Float"
							qbe_output_line(output, "\t" + operand + " =d sub d_-0.0, " + operands[value_id])
						else
							qbe_output_line(output, "\t" + operand + " =l call $trbn_integer_subtract(l 0, l " + operands[value_id] + ")")
						end
						result = emitted_value(operand, result_type, 0, "", "")
					else
						result = emitted_value(operands[value_id], result_type, 0, "", "")
					end
				end
			else
				value_id := instruction.first
				operand := emit_temporary(context)
				qbe_output_line(output, "\t" + operand + " =d sltof " + operands[value_id])
				result = emitted_value(operand, "Float", 0, "", "")
			end
		end
	end
	return result
end

def emit_scalar_mir_body(
		state: CompilerState,
		function_index: Integer,
		argument_operands: Array<String>,
		argument_types: Array<String>,
		argument_facts: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		inline: Boolean,
		safe: Boolean,
	): QbeValue
	saved_inline_depth := context.scalar_inline_depth[0]
	if inline
		context.scalar_inline_depth[0] = saved_inline_depth + 1
	end
	mut operands: Array<String> := []
	mut types: Array<String> := []
	mut facts: Array<Integer> := []
	mut index := 0
	while index < argument_operands.size()
		operands.push(argument_operands[index])
		types.push(argument_types[index])
		facts.push(argument_facts[index])
		index += 1
	end
	state.scalar_mir.values.each do |value|
		if value.function_id == function_index && value.id >= argument_types.size()
			while types.size() <= value.id
				types.push("")
			end
			types[value.id] = mir_semantic_type_name(state.scalar_mir, value.type_id)
		end
	end
	function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, function_index)]
	block := state.scalar_mir.blocks[mir_block_index(state.scalar_mir, function, function.entry_block)]
	index = block.instruction_start
	finish := index + block.instruction_count
	while index < finish
		instruction := state.scalar_mir.instructions[index]
		result := emit_mir_scalar_instruction(state, function_index, instruction, operands, types, facts, context, output, inline, safe)
		result_fact := mir_scalar_result_fact(instruction, facts)
		operands.push(result.operand)
		facts.push(result_fact)
		index += 1
	end
	context.scalar_inline_depth[0] = saved_inline_depth
	return emitted_value(operands[block.return_value], types[block.return_value], 0, "", "")
end

def emit_scalar_mir(
		state: CompilerState,
		function_index: Integer,
		argument_operands: Array<String>,
		argument_types: Array<String>,
		argument_facts: Array<Integer>,
		mut context: QbeEmitContext,
		mut output: QbeOutput,
		inline: Boolean,
	): QbeValue
	function := state.scalar_mir.functions[mir_function_index(state.scalar_mir, function_index)]
	if !inline || function.integer_guard == 0
		return emit_scalar_mir_body(state, function_index, argument_operands, argument_types, argument_facts, context, output, inline, false)
	end
	mut combined := argument_operands[0]
	mut index := 1
	while index < argument_operands.size()
		merged := emit_temporary(context)
		qbe_output_line(output, "\t" + merged + " =l or " + combined + ", " + argument_operands[index])
		combined = merged
		index += 1
	end
	valid := emit_temporary(context)
	fast := emit_label(context)
	slow := emit_label(context)
	complete := emit_label(context)
	result := emit_temporary(context)
	qbe_output_line(output, "\t" + valid + " =w cultl " + combined + ", " + integer_string(function.integer_guard))
	qbe_output_branch(output, valid, fast, slow)
	qbe_output_line(output, slow)
	checked := emit_scalar_mir_body(state, function_index, argument_operands, argument_types, argument_facts, context, output, inline, false)
	mut width := "l"
	if checked.type_name == "Float"
		width = "d"
	end
	qbe_output_line(output, "\t" + result + " =" + width + " copy " + checked.operand)
	qbe_output_line(output, "\tjmp " + complete)
	qbe_output_line(output, fast)
	unchecked := emit_scalar_mir_body(state, function_index, argument_operands, argument_types, argument_facts, context, output, inline, true)
	qbe_output_line(output, "\t" + result + " =" + width + " copy " + unchecked.operand)
	qbe_output_line(output, complete)
	return emitted_value(result, checked.type_name, 0, "", "")
end
