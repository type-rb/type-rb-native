import { UnionPattern, union_parts } from union_types
import { mir_union_operation } from union_mir
import { expect, expect_identifier, parse_type, skip_newlines } from syntax_tokens
import { CheckedValue, checked_mir_value } from checked_values
import { nullable_replace } from nullable_flow
import { CheckedLocals, CompilerState, ControlSyntax, diagnostic, has_diagnostic, local_bind, local_require_use } from state
import { load_integer, load_string, sparse_integer_at, store_integer } from storage

def check_union_patterns(mut state: CompilerState, control: ControlSyntax, selector_type: String): Boolean
	alternatives := union_parts(selector_type)
	mut seen: Array<String> := []
	mut otherwise := false
	mut index := 0
	while index < control.branches.size() && !has_diagnostic(state)
		branch := control.branches[index]
		index += 1
		if branch.condition < 0
			otherwise = true
			next
		end
		mut position := [branch.condition]
		line := load_integer(state.token_lines, branch.condition)
		type_name := parse_type(state, position)
		if type_name != "Integer" && type_name != "Float" && type_name != "Boolean" && type_name != "String"
			diagnostic(state, "TRBN4004", line, "union type pattern requires a non-nullable scalar type")
			return false
		end
		mut present := false
		alternatives.each do |alternative|
			if alternative == type_name
				present = true
			end
		end
		if !present
			diagnostic(state, "TRBN4004", line, "type pattern is not a union alternative")
			return false
		end
		seen.each do |previous|
			if previous == type_name
				diagnostic(state, "TRBN4004", line, "union alternative is handled more than once")
			end
		end
		seen.push(type_name)
		if !expect(state, position, "(")
			return false
		end
		skip_newlines(state, position)
		binding := position[0]
		expect_identifier(state, position)
		skip_newlines(state, position)
		if !expect(state, position, ")") || position[0] != branch.condition_finish
			diagnostic(state, "TRBN4004", line, "union type pattern binds exactly one value")
			return false
		end
		pattern := UnionPattern.new(origin: branch.condition, type_name: type_name, binding: binding)
		encoded := sparse_integer_at(state.checked[0].union_pattern_origins, branch.condition)
		if encoded > 0
			state.checked[0].union_patterns[encoded - 1] = pattern
		else
			state.checked[0].union_patterns.push(pattern)
			store_integer(state.checked[0].union_pattern_origins, branch.condition, state.checked[0].union_patterns.size())
		end
	end
	if !otherwise && seen.size() != alternatives.size()
		diagnostic(state, "TRBN4004", load_integer(state.token_lines, control.origin), "union case is not exhaustive")
	end
	return !has_diagnostic(state)
end

def check_union_binding(mut state: CompilerState, mut locals: CheckedLocals, selector: CheckedValue, origin: Integer)
	pattern := state.checked[0].union_patterns[sparse_integer_at(state.checked[0].union_pattern_origins, origin) - 1]
	value := mir_union_operation(state, locals, 54, selector, pattern.type_name, pattern.type_name, pattern.binding)
	index := local_bind(locals, load_string(state.token_texts, pattern.binding), pattern.type_name, 0)
	local_require_use(locals, index, load_string(state.token_texts, pattern.binding), pattern.binding, 3)
	store_integer(locals.mir_values, index, checked_mir_value(value) + 1)
	nullable_replace(locals, index, pattern.type_name)
end
