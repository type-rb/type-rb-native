def sum_to(limit: Integer): Integer
	mut index := 0
	mut total := 0
	while index < limit
		index += 1
		total += index
	end
	return total
end

def reduce(mut value: Integer): Integer
	while value > 3
		if value % 2 == 0
			value /= 2
		else
			value -= 1
		end
	end
	return value
end

def scale(value: Float): Float
	return value * 1.5
end

def main()
	total := sum_to(100)
	if total == 5050
		if reduce(42) == 2
			if - 7 / 3 == - 2
				if - 7 % 3 == - 1
					if !false
						if scale(2.0) == 3.0
							if 3 ** 4 == 81
								puts("gate1-scalar-control-flow")
								return
							end
						end
					end
				end
			end
		end
	end
	puts("gate1-scalar-control-flow-failed")
	return
end
