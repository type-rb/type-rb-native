import { hash_types_source_import_prefix, hash_mir_source_import_prefix, hash_checked_source_import_prefix, hash_runtime_source_import_prefix, checked_program_source_import_prefix, compiler_source_directory, compiler_source_has_import, compiler_source_import_prefix, compiler_source_path, flatten_compiler_recovery_source, mir_source_import_prefix, parser_source_import_prefix, project_config_source_import_prefix, qbe_output_source_import_prefix, qbe_runtime_source_import_prefix, read_required_compiler_source, resolution_source_import_prefix, state_source_import_prefix } from compiler_recovery_source
import trb/std/result
import trb/std/process
import { describe, expect, test } from trb/std/test

describe("Compiler recovery source closure") do
	test("matches the canonical compiler entry imports before recovery") do
		root := Process.environment("TYPE_RB_NATIVE_ROOT")
		if root != nil
			case read_required_compiler_source(root + "/compiler/src/compiler.trb")
			when Result::Ok(source)
				expect(source.start_with?(compiler_source_import_prefix())).to_be_true()
			when Result::Err(message)
				puts(message)
				expect(false).to_be_true()
			end
		end
	end

	test("keeps source paths rooted at the explicit compiler entry") do
		expect(compiler_source_directory("compiler.trb")).to_equal(".")
		expect(compiler_source_directory("/compiler.trb")).to_equal("/")
		expect(compiler_source_directory("a source/compiler.trb")).to_equal("a source")
		expect(compiler_source_path("/", "storage.trb")).to_equal("/storage.trb")
		expect(compiler_source_path("a source", "storage.trb")).to_equal("a source/storage.trb")
	end

	test("reports an unreadable required source without substituting content") do
		case read_required_compiler_source("__missing_recovery_source__/compiler.trb")
		when Result::Ok(_source)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message.empty?()).to_be_false()
		end
	end

	test("recognizes import tokens without rejecting identifiers or comments") do
		expect(compiler_source_has_import("import")).to_be_true()
		expect(compiler_source_has_import("\t import { item } from source\n")).to_be_true()
		expect(compiler_source_has_import("import_index := 0\nimportant := 1\nimport2 := 2\n")).to_be_false()
		expect(compiler_source_has_import("# import source\n\t# import other\n")).to_be_false()
	end

	test("derives one deterministic recovery source from the canonical modules") do
		entry := compiler_source_import_prefix() + "def main()\n\treturn\nend\n"
		case flatten_compiler_recovery_source(entry, "def storage()\n\treturn\nend\n", "def path()\n\treturn\nend\n", mir_source_import_prefix() + "def mir()\n\treturn\nend\n", "def literals()\n\treturn\nend\n", state_source_import_prefix() + "def state()\n\treturn\nend\n", parser_source_import_prefix() + "def parser()\n\treturn\nend\n", resolution_source_import_prefix() + "def resolution()\n\treturn\nend\n", checked_program_source_import_prefix() + "def checked_program()\n\treturn\nend\n", qbe_output_source_import_prefix() + "def qbe_output()\n\treturn\nend\n", qbe_runtime_source_import_prefix() + "def qbe_runtime()\n\treturn\nend\n", project_config_source_import_prefix() + "def project_config()\n\treturn\nend\n", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
		when Result::Ok(flattened)
			expect(flattened).to_equal(
				"def iteration_mir()\n\treturn\nend\n\ndef storage()\n\treturn\nend\n\ndef path()\n\treturn\nend\n\ndef literals()\n\treturn\nend\n\ndef mir()\n\treturn\nend\n\ndef state()\n\treturn\nend\n\ndef parser()\n\treturn\nend\n\ndef resolution()\n\treturn\nend\n\ndef checked_program()\n\treturn\nend\n\ndef qbe_output()\n\treturn\nend\n\ndef qbe_runtime()\n\treturn\nend\n\ndef project_config()\n\treturn\nend\n\ndef hash_types()\n\treturn\nend\n\ndef hash_mir()\n\treturn\nend\n\ndef hash_checked()\n\treturn\nend\n\ndef hash_runtime()\n\treturn\nend\n\ndef main()\n\treturn\nend\n",
			)
		when Result::Err(message)
			puts(message)
			expect(false).to_be_true()
		end
	end

	test("rejects a changed compiler import boundary") do
		case flatten_compiler_recovery_source("def main()\n\treturn\nend\n", "", "", "", "", "", "", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program", qbe_output_source_import_prefix() + "qbe_output", qbe_runtime_source_import_prefix() + "qbe_runtime", project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
		when Result::Ok(_flattened)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("compiler entry import boundary differs")
		end
	end

	test("rejects a missing or changed MIR import boundary") do
		entry := compiler_source_import_prefix() + "def main()\n\treturn\nend\n"
		case flatten_compiler_recovery_source(entry, "storage", "path", "import unknown\n", "literals", "", "", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program", qbe_output_source_import_prefix() + "qbe_output", qbe_runtime_source_import_prefix() + "qbe_runtime", project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
		when Result::Ok(_flattened)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("MIR source import boundary differs")
		end
	end

	test("rejects missing or changed state and parser import boundaries") do
		entry := compiler_source_import_prefix() + "entry"
		invalid := ["", "import unknown\n"]
		mut index := 0
		while index < invalid.size()
			case flatten_compiler_recovery_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", invalid[index], parser_source_import_prefix() + "parser", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program", qbe_output_source_import_prefix() + "qbe_output", qbe_runtime_source_import_prefix() + "qbe_runtime", project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("State source import boundary differs")
			end
			case flatten_compiler_recovery_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", invalid[index], resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program", qbe_output_source_import_prefix() + "qbe_output", qbe_runtime_source_import_prefix() + "qbe_runtime", project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("Parser source import boundary differs")
			end
			index += 1
		end
	end

	test("rejects missing or changed semantic frontend import boundaries") do
		entry := compiler_source_import_prefix() + "entry"
		invalid := ["", "import unknown\n"]
		mut index := 0
		while index < invalid.size()
			case flatten_compiler_recovery_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", parser_source_import_prefix() + "parser", invalid[index], checked_program_source_import_prefix() + "checked_program", qbe_output_source_import_prefix() + "qbe_output", qbe_runtime_source_import_prefix() + "qbe_runtime", project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("Resolution source import boundary differs")
			end
			case flatten_compiler_recovery_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", parser_source_import_prefix() + "parser", resolution_source_import_prefix() + "resolution", invalid[index], qbe_output_source_import_prefix() + "qbe_output", qbe_runtime_source_import_prefix() + "qbe_runtime", project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("Checked-program source import boundary differs")
			end
			index += 1
		end
	end

	test("rejects missing or changed QBE output and runtime import boundaries") do
		entry := compiler_source_import_prefix() + "entry"
		invalid := ["", "import unknown\n"]
		mut index := 0
		while index < invalid.size()
			case flatten_compiler_recovery_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", parser_source_import_prefix() + "parser", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program", invalid[index], qbe_runtime_source_import_prefix() + "qbe_runtime", project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("QBE-output source import boundary differs")
			end
			case flatten_compiler_recovery_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", parser_source_import_prefix() + "parser", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program", qbe_output_source_import_prefix() + "qbe_output", invalid[index], project_config_source_import_prefix() + "project_config", hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("QBE-runtime source import boundary differs")
			end
			index += 1
		end
	end

	test("rejects a missing or changed project-configuration import boundary") do
		invalid := ["", "import unknown\n"]
		mut index := 0
		while index < invalid.size()
			case flatten_compiler_recovery_source(compiler_source_import_prefix() + "entry", "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", parser_source_import_prefix() + "parser", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program", qbe_output_source_import_prefix() + "qbe_output", qbe_runtime_source_import_prefix() + "qbe_runtime", invalid[index], hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("Project-configuration source import boundary differs")
			end
			index += 1
		end
	end

	test("rejects empty bodies and extra imports in every declaration source") do
		invalid := ["", "import other\n", "\timport{value}from other\n", "\rimport\tother\n", "import# comment\nother\n"]
		mut invalid_index := 0
		while invalid_index < invalid.size()
			mut slot := 0
			while slot < 12
				mut sources := ["def main()\n\treturn\nend\n", "storage", "path", "mir", "literals", "state", "parser", "resolution", "checked_program", "qbe_output", "qbe_runtime", "project_config"]
				sources[slot] = invalid[invalid_index]
				case flatten_compiler_recovery_source(compiler_source_import_prefix() + sources[0], sources[1], sources[2], mir_source_import_prefix() + sources[3], sources[4], state_source_import_prefix() + sources[5], parser_source_import_prefix() + sources[6], resolution_source_import_prefix() + sources[7], checked_program_source_import_prefix() + sources[8], qbe_output_source_import_prefix() + sources[9], qbe_runtime_source_import_prefix() + sources[10], project_config_source_import_prefix() + sources[11], hash_types_source_import_prefix() + "def hash_types()\n\treturn\nend\n", hash_mir_source_import_prefix() + "def hash_mir()\n\treturn\nend\n", hash_checked_source_import_prefix() + "def hash_checked()\n\treturn\nend\n", hash_runtime_source_import_prefix() + "def hash_runtime()\n\treturn\nend\n", "def iteration_mir()\n\treturn\nend\n")
				when Result::Ok(_flattened)
					expect(false).to_be_true()
				when Result::Err(message)
					expected := if invalid_index == 0
						"compiler declaration source is empty"
					else
						"compiler declaration source has an unexpected import"
					end
					expect(message).to_equal(expected)
				end
				slot += 1
			end
			invalid_index += 1
		end
	end
end
