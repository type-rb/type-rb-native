import { compiler_recovery_layout } from compiler_recovery_layout
import { RecoveryCompilerSources, compiler_source_directory, compiler_source_has_import, compiler_source_path, flatten_compiler_recovery_source, read_compiler_recovery_sources, read_required_compiler_source } from compiler_recovery_source
import trb/std/result
import trb/std/process
import { describe, expect, test } from trb/std/test

def synthetic_recovery_sources(): RecoveryCompilerSources
	mut names: Array<String> := []
	mut contents: Array<String> := []
	compiler_recovery_layout().each do |module|
		names.push(module.name)
		contents.push(module.imports + "def " + module.name + "()\n\treturn\nend\n")
	end
	return RecoveryCompilerSources.new(names: names, contents: contents, flattened: "")
end

describe("Compiler recovery source closure") do
	test("matches every canonical compiler module before recovery") do
		root := Process.environment("TYPE_RB_NATIVE_ROOT")
		if root != nil
			case read_compiler_recovery_sources(root + "/compiler/src/compiler.trb")
			when Result::Ok(sources)
				expect(sources.names.size()).to_equal(compiler_recovery_layout().size())
				expect(compiler_source_has_import(sources.flattened)).to_be_false()
			when Result::Err(message)
				puts(message)
				expect(false).to_be_true()
			end
		end
	end

	test("keeps source paths rooted at the explicit compiler entry") do
		expect(compiler_source_directory("compiler.trb")).to_equal(".")
		expect(compiler_source_directory("/compiler.trb")).to_equal("/")
		expect(compiler_source_directory("a source/compiler.trb")).to_equal("a source")
		expect(compiler_source_path("/", "storage.trb")).to_equal("/storage.trb")
		expect(compiler_source_path("a source", "storage.trb")).to_equal("a source/storage.trb")
	end

	test("reports an unreadable required source without substituting content") do
		case read_required_compiler_source("__missing_recovery_source__/compiler.trb")
		when Result::Ok(_source)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message.empty?()).to_be_false()
		end
	end

	test("recognizes import tokens without rejecting identifiers or comments") do
		expect(compiler_source_has_import("import")).to_be_true()
		expect(compiler_source_has_import("\t import { item } from source\n")).to_be_true()
		expect(compiler_source_has_import("import_index := 0\nimportant := 1\nimport2 := 2\n")).to_be_false()
		expect(compiler_source_has_import("# import source\n\t# import other\n")).to_be_false()
	end

	test("derives one deterministic source in exact dependency order") do
		sources := synthetic_recovery_sources()
		mut expected := ""
		sources.names.each do |name|
			if !expected.empty?()
				expected += "\n"
			end
			expected += "def " + name + "()\n\treturn\nend\n"
		end
		case flatten_compiler_recovery_source(sources.names, sources.contents)
		when Result::Ok(flattened)
			expect(flattened).to_equal(expected)
		when Result::Err(message)
			puts(message)
			expect(false).to_be_true()
		end
	end

	test("rejects missing, reordered, duplicated and extra module identities") do
		mut sources := synthetic_recovery_sources()
		case flatten_compiler_recovery_source([], sources.contents)
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("compiler source inventory differs")
		end
		first := sources.names[0]
		sources.names[0] = sources.names[1]
		case flatten_compiler_recovery_source(sources.names, sources.contents)
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("compiler source identity differs at " + first)
		end
		sources.names[1] = first
		case flatten_compiler_recovery_source(sources.names, sources.contents)
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("compiler source identity differs at " + first)
		end
		sources.names.push("extra")
		case flatten_compiler_recovery_source(sources.names, sources.contents)
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("compiler source inventory differs")
		end
	end

	test("rejects changed import boundaries in every imported module") do
		compiler_recovery_layout().each.with_index do |module, index|
			if !module.imports.empty?()
				mut sources := synthetic_recovery_sources()
				sources.contents[index] = "import unknown\n"
				case flatten_compiler_recovery_source(sources.names, sources.contents)
				when Result::Ok(_value)
					expect(false).to_be_true()
				when Result::Err(message)
					expect(message).to_equal(module.name + " source import boundary differs")
				end
			end
		end
	end

	test("rejects empty bodies and extra imports in every declaration source") do
		invalid := ["", "import other\n", "\timport{value}from other\n", "\rimport\tother\n", "import# comment\nother\n"]
		invalid.each.with_index do |body, invalid_index|
			compiler_recovery_layout().each.with_index do |module, slot|
				mut sources := synthetic_recovery_sources()
				sources.contents[slot] = module.imports + body
				case flatten_compiler_recovery_source(sources.names, sources.contents)
				when Result::Ok(_value)
					expect(false).to_be_true()
				when Result::Err(message)
					mut expected := module.name + " declaration source has an unexpected import"
					if invalid_index == 0
						expected = module.name + " declaration source is empty"
					end
					expect(message).to_equal(expected)
				end
			end
		end
	end
end
