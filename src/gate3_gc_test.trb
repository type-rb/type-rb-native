import { ComparisonOperator, Gate1Instruction, ScalarType } from gate1_mir
import { Gate3TypeDefinition, Gate3ValueType } from gate3_layout
import { Gate3Block, Gate3Function, Gate3Instruction, Gate3Module, Gate3Parameter, Gate3ResultType, Gate3RuntimeStatistic, Gate3Terminator, verify_gate3_mir } from gate3_mir
import { build_gate3_executable } from gate3_toolchain
import { NativeSource } from native_mir
import { SourceOrigin } from snapshot
import trb/std/filesystem
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

def _gate3_gc_origin(line: Integer): SourceOrigin
	return SourceOrigin.new(
		source_id: "main",
		start_line: line,
		start_column: 1,
		end_line: line,
		end_column: 8,
	)
end

def _gate3_gc_closure_type(): Gate3ValueType
	return Gate3ValueType::Aggregate("() -> Void")
end

def _gate3_gc_array_type(): Gate3ValueType
	return Gate3ValueType::Aggregate("Array<() -> Void>")
end

def _gate3_gc_body(): Gate3Function
	origin := _gate3_gc_origin(1)
	return Gate3Function.new(
		id: "cycle#body",
		name: "body",
		parameters: [],
		result_type: Gate3ResultType::Void,
		entry: "entry",
		origin: origin,
		blocks: [
			Gate3Block.new(
				id: "entry",
				parameters: [],
				origin: origin,
				instructions: [],
				terminator: Gate3Terminator::Return(nil, origin),
			),
		],
		captures: [Gate3Parameter.new(id: "items", value_type: _gate3_gc_array_type(), origin: origin)],
	)
end

def _gate3_gc_make_cycle(): Gate3Function
	origin := _gate3_gc_origin(5)
	return Gate3Function.new(
		id: "cycle#make",
		name: "makeCycle",
		parameters: [],
		result_type: Gate3ResultType::Void,
		entry: "entry",
		origin: origin,
		blocks: [
			Gate3Block.new(
				id: "entry",
				parameters: [],
				origin: origin,
				instructions: [
					Gate3Instruction::ArrayConstruct("items", "Array<() -> Void>", [], origin),
					Gate3Instruction::ClosureConstruct(
						"callback",
						"() -> Void",
						"cycle#body",
						["items"],
						origin,
					),
					Gate3Instruction::ArrayPush("Array<() -> Void>", "items", "callback", origin),
				],
				terminator: Gate3Terminator::Return(nil, origin),
			),
		],
	)
end

def _gate3_gc_main(): Gate3Function
	origin := _gate3_gc_origin(10)
	boolean_type := Gate3ValueType::Scalar(ScalarType::Boolean)
	return Gate3Function.new(
		id: "cycle#main",
		name: "main",
		parameters: [],
		result_type: Gate3ResultType::Void,
		entry: "entry",
		origin: origin,
		blocks: [
			Gate3Block.new(
				id: "entry",
				parameters: [],
				origin: origin,
				instructions: [
					Gate3Instruction::Call(nil, "cycle#make", [], origin),
					Gate3Instruction::RuntimeCollect(origin),
					Gate3Instruction::RuntimeCollect(origin),
					Gate3Instruction::RuntimeStatistic("collections", Gate3RuntimeStatistic::CollectionCount, origin),
					Gate3Instruction::RuntimeStatistic("live", Gate3RuntimeStatistic::HeapBytes, origin),
					Gate3Instruction::RuntimeStatistic("reclaimed", Gate3RuntimeStatistic::ReclaimedBytes, origin),
					Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("two", 2, origin)),
					Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("liveLimit", 65536, origin)),
					Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("zero", 0, origin)),
					Gate3Instruction::Scalar(
						Gate1Instruction::IntegerCompare(
							"enoughCollections",
							ComparisonOperator::GreaterThanOrEqual,
							"collections",
							"two",
							origin,
						)
					),
					Gate3Instruction::Scalar(
						Gate1Instruction::IntegerCompare(
							"boundedLiveSet",
							ComparisonOperator::LessThanOrEqual,
							"live",
							"liveLimit",
							origin,
						)
					),
					Gate3Instruction::Scalar(
						Gate1Instruction::IntegerCompare(
							"reclaimedCycle",
							ComparisonOperator::GreaterThan,
							"reclaimed",
							"zero",
							origin,
						)
					),
				],
				terminator: Gate3Terminator::Branch(
					"enoughCollections",
					"checkLive",
					["boundedLiveSet", "reclaimedCycle"],
					"failure",
					[],
					origin,
				),
			),
			Gate3Block.new(
				id: "checkLive",
				parameters: [
					Gate3Parameter.new(id: "liveOK", value_type: boolean_type, origin: origin),
					Gate3Parameter.new(id: "reclaimedOK", value_type: boolean_type, origin: origin),
				],
				origin: origin,
				instructions: [],
				terminator: Gate3Terminator::Branch(
					"liveOK",
					"checkReclaimed",
					["reclaimedOK"],
					"failure",
					[],
					origin,
				),
			),
			Gate3Block.new(
				id: "checkReclaimed",
				parameters: [Gate3Parameter.new(id: "cycleOK", value_type: boolean_type, origin: origin)],
				origin: origin,
				instructions: [],
				terminator: Gate3Terminator::Branch(
					"cycleOK",
					"success",
					[],
					"failure",
					[],
					origin,
				),
			),
			Gate3Block.new(
				id: "success",
				parameters: [],
				origin: origin,
				instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("gc-ok\n", origin))],
				terminator: Gate3Terminator::Return(nil, origin),
			),
			Gate3Block.new(
				id: "failure",
				parameters: [],
				origin: origin,
				instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("gc-fail\n", origin))],
				terminator: Gate3Terminator::Return(nil, origin),
			),
		],
	)
end

def gate3_gc_stress_module(): Gate3Module
	return Gate3Module.new(
		id: "cycle",
		entry_function: "cycle#main",
		sources: [NativeSource.new(id: "main", path: "src/main.trb")],
		types: [
			Gate3TypeDefinition::Function("() -> Void", [], nil),
			Gate3TypeDefinition::Array("Array<() -> Void>", _gate3_gc_closure_type()),
		],
		functions: [_gate3_gc_body(), _gate3_gc_make_cycle(), _gate3_gc_main()],
	)
end

describe("Gate 3 tracing collector") do
	test("verifies the closure and Array cycle stress MIR") do
		case verify_gate3_mir(gate3_gc_stress_module())
		when Result::Ok(valid)
			expect(valid).to_be_true()
		when Result::Err(diagnostic)
			puts(diagnostic.path + ": " + diagnostic.message)
			expect(false).to_be_true()
		end
	end

	test("reclaims an unreachable closure and Array cycle across repeated collections") do
		qbe_command := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_command == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate3-gc"
			case FileSystem.create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case build_gate3_executable(
					gate3_gc_stress_module(),
					qbe_command,
					"/usr/bin/cc",
					workspace,
					workspace + "/stress",
				)
			when Result::Ok(report)
				case Process.run(report.output_path, [])
				when Result::Ok(process)
					expect(process.success).to_be_true()
					expect(process.stdout).to_equal("gc-ok\n")
					expect(process.stderr).to_equal("")
				when Result::Err(_error)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.phase + ": " + error.message + "\n" + error.stderr)
				expect(false).to_be_true()
			end
		end
	end
end
