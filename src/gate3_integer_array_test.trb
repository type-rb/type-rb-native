import { ComparisonOperator, Gate1Instruction, ScalarType } from gate1_mir
import { Gate3TypeDefinition, Gate3ValueType } from gate3_layout
import { Gate3Block, Gate3Function, Gate3Instruction, Gate3Module, Gate3Parameter, Gate3ResultType, Gate3Terminator } from gate3_mir
import { build_gate3_executable } from gate3_toolchain
import { NativeSource } from native_mir
import { SourceOrigin } from snapshot
import { native_create_directory } from native_file_system
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

def _gate3_integer_array_module(): Gate3Module
	origin := SourceOrigin.new(
		source_id: "main",
		start_line: 1,
		start_column: 1,
		end_line: 12,
		end_column: 4,
	)
	return Gate3Module.new(
		id: "integer-array",
		entry_function: "integer-array#main",
		sources: [NativeSource.new(id: "main", path: "src/main.trb")],
		types: [
			Gate3TypeDefinition::Array(
				"Array<Integer>",
				Gate3ValueType::Scalar(ScalarType::Integer),
			),
			Gate3TypeDefinition::Array(
				"Array<Array<Integer>>",
				Gate3ValueType::Aggregate("Array<Integer>"),
			),
		],
		functions: [
			Gate3Function.new(
				id: "integer-array#main",
				name: "main",
				parameters: [],
				result_type: Gate3ResultType::Void,
				entry: "entry",
				origin: origin,
				blocks: [
					Gate3Block.new(
						id: "entry",
						parameters: [],
						origin: origin,
						instructions: [
							Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("zero", 0, origin)),
							Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("ten", 10, origin)),
							Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("twenty", 20, origin)),
							Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("two", 2, origin)),
							Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("last", - 1, origin)),
							Gate3Instruction::ArrayConstruct("values", "Array<Integer>", ["ten"], origin),
							Gate3Instruction::ArrayConstruct(
								"groups",
								"Array<Array<Integer>>",
								["values"],
								origin,
							),
							Gate3Instruction::ArrayGet(
								"selected",
								"Array<Array<Integer>>",
								"groups",
								"zero",
								origin,
							),
							Gate3Instruction::ArrayPush("Array<Integer>", "selected", "twenty", origin),
							Gate3Instruction::ArraySet("Array<Integer>", "selected", "last", "ten", origin),
							Gate3Instruction::ArrayGet("actual", "Array<Integer>", "selected", "last", origin),
							Gate3Instruction::ArraySize("size", "Array<Integer>", "selected", origin),
							Gate3Instruction::Scalar(
								Gate1Instruction::IntegerCompare(
									"valueMatches",
									ComparisonOperator::Equal,
									"actual",
									"ten",
									origin,
								)
							),
							Gate3Instruction::Scalar(
								Gate1Instruction::IntegerCompare(
									"sizeMatches",
									ComparisonOperator::Equal,
									"size",
									"two",
									origin,
								)
							),
						],
						terminator: Gate3Terminator::Branch(
							"valueMatches",
							"checkSize",
							["sizeMatches"],
							"failure",
							[],
							origin,
						),
					),
					Gate3Block.new(
						id: "checkSize",
						parameters: [
							Gate3Parameter.new(
								id: "matches",
								value_type: Gate3ValueType::Scalar(ScalarType::Boolean),
								origin: origin,
							),
						],
						origin: origin,
						instructions: [],
						terminator: Gate3Terminator::Branch(
							"matches",
							"success",
							[],
							"failure",
							[],
							origin,
						),
					),
					Gate3Block.new(
						id: "success",
						parameters: [],
						origin: origin,
						instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("integer-array-ok\n", origin))],
						terminator: Gate3Terminator::Return(nil, origin),
					),
					Gate3Block.new(
						id: "failure",
						parameters: [],
						origin: origin,
						instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("integer-array-fail\n", origin))],
						terminator: Gate3Terminator::Return(nil, origin),
					),
				],
			),
		],
	)
end

describe("Gate 3 Integer Array runtime") do
	test("executes nested construction, growth, mutation, indexing, and size") do
		qbe_command := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_command == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate3-integer-array"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case build_gate3_executable(
					_gate3_integer_array_module(),
					qbe_command,
					"/usr/bin/cc",
					workspace,
					workspace + "/sample",
				)
			when Result::Ok(report)
				case Process.run(report.output_path, [])
				when Result::Ok(process)
					expect(process.success).to_be_true()
					expect(process.stdout).to_equal("integer-array-ok\n")
					expect(process.stderr).to_equal("")
				when Result::Err(_error)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.phase + ": " + error.message + "\n" + error.stderr)
				expect(false).to_be_true()
			end
		end
	end
end
