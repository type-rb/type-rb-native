# Internal recovery transport for the bounded flattened compiler source.
# The 64 MiB bound matches native_read_text used to prepare that source.
# The managed String owns a copy before the temporary C buffer is released.
def recovery_bootstrap_file_runtime(): String
	return "function l $trbn_bootstrap_read_file(l %path) {\n@start\n\t%file =l call $fopen(l %path, l $trbn_bootstrap_rb)\n\t%missing =w ceql %file, 0\n\tjnz %missing, @fail, @seek\n@seek\n\t%seek =w call $fseek(l %file, l 0, w 2)\n\t%seek_failed =w cnew %seek, 0\n\tjnz %seek_failed, @close, @length\n@length\n\t%length =l call $ftell(l %file)\n\t%negative =w csltl %length, 0\n\t%large =w cugtl %length, 67108864\n\t%invalid =w or %negative, %large\n\tjnz %invalid, @close, @rewind\n@rewind\n\t%rewind =w call $fseek(l %file, l 0, w 0)\n\t%rewind_failed =w cnew %rewind, 0\n\tjnz %rewind_failed, @close, @allocate\n@allocate\n\t%size =l add %length, 1\n\t%bytes =l call $malloc(l %size)\n\t%allocation_failed =w ceql %bytes, 0\n\tjnz %allocation_failed, @close, @read\n@read\n\t%read =l call $fread(l %bytes, l 1, l %length, l %file)\n\t%closed =w call $fclose(l %file)\n\t%short =w cnel %read, %length\n\t%close_failed =w cnew %closed, 0\n\t%failed =w or %short, %close_failed\n\tjnz %failed, @free, @string\n@string\n\t%source =l call $trbn_string_new(l %bytes, l %length, l %length)\n\tcall $free(l %bytes)\n\tret %source\n@free\n\tcall $free(l %bytes)\n\tjmp @fail\n@close\n\t%ignored =w call $fclose(l %file)\n\tjmp @fail\n@fail\n\tret 0\n}\n"
end
