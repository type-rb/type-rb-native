import { Gate3Field, Gate3TypeDefinition, Gate3ValueType, Gate3Variant } from gate3_layout
import {
	Gate3Block,
	Gate3Function,
	Gate3Instruction,
	Gate3Module,
	Gate3ResultType,
	Gate3Terminator,
} from gate3_mir
import { build_gate3_executable } from gate3_toolchain
import { NativeSource } from native_mir
import { SourceOrigin } from snapshot
import { create_directory } from trb/std/filesystem
import { environment, run } from trb/std/process
import { Result } from trb/std/result
import { describe, expect, test } from trb/std/test

def _gate3_managed_aggregate_origin(): SourceOrigin
	return SourceOrigin.new(
		source_id: "main",
		start_line: 1,
		start_column: 1,
		end_line: 12,
		end_column: 4,
	)
end

def _gate3_managed_aggregate_module(): Gate3Module
	origin := _gate3_managed_aggregate_origin()
	string_type := Gate3ValueType::Aggregate("String")
	box_type := Gate3ValueType::Aggregate("managed#Box")
	return Gate3Module.new(
		id: "managed-aggregate",
		entry_function: "managed#main",
		sources: [NativeSource.new(id: "main", path: "src/main.trb")],
		types: [
			Gate3TypeDefinition::String("String"),
			Gate3TypeDefinition::Record(
				"managed#Box",
				[Gate3Field.new(name: "text", value_type: string_type)],
			),
			Gate3TypeDefinition::Tagged(
				"managed#MaybeBox",
				[
					Gate3Variant.new(
						name: "Found",
						fields: [Gate3Field.new(name: "box", value_type: box_type)],
					),
					Gate3Variant.new(name: "None", fields: []),
				],
			),
		],
		functions: [
			Gate3Function.new(
				id: "managed#main",
				name: "main",
				parameters: [],
				result_type: Gate3ResultType::Void,
				entry: "entry",
				origin: origin,
				blocks: [
					Gate3Block.new(
						id: "entry",
						parameters: [],
						origin: origin,
						instructions: [
							Gate3Instruction::StringLiteral("text", "managed aggregate", origin),
							Gate3Instruction::RecordConstruct("box", "managed#Box", ["text"], origin),
							Gate3Instruction::VariantConstruct(
								"maybe",
								"managed#MaybeBox",
								"Found",
								["box"],
								origin,
							),
							Gate3Instruction::RuntimeCollect(origin),
							Gate3Instruction::VariantProject(
								"projectedBox",
								"managed#MaybeBox",
								"maybe",
								"Found",
								"box",
								origin,
							),
							Gate3Instruction::RecordProject(
								"projectedText",
								"managed#Box",
								"projectedBox",
								"text",
								origin,
							),
							Gate3Instruction::WriteString("projectedText", true, origin),
						],
						terminator: Gate3Terminator::Return(nil, origin),
					),
				],
			),
		],
	)
end

describe("Gate 3 managed aggregate runtime") do
	test("keeps reference-containing records and tagged values live through collection") do
		qbe_command := environment("TYPE_RB_NATIVE_QBE")
		if qbe_command == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate3-managed-aggregate"
			case create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case build_gate3_executable(
					_gate3_managed_aggregate_module(),
					qbe_command,
					"/usr/bin/cc",
					workspace,
					workspace + "/sample",
				)
			when Result::Ok(report)
				case run(report.output_path, [])
				when Result::Ok(process)
					expect(process.success).to_be_true()
					expect(process.stdout).to_equal("managed aggregate\n")
					expect(process.stderr).to_equal("")
				when Result::Err(_error)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.phase + ": " + error.message + "\n" + error.stderr)
				expect(false).to_be_true()
			end
		end
	end
end
