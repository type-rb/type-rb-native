import { decode_bootstrap_snapshot, decode_recovery_managed_snapshot } from recovery_managed_snapshot
import { native_read_text } from native_file_system
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

def _recovery_managed_snapshot_fixture(): String
	root := Process.environment("TYPE_RB_NATIVE_ROOT")
	if root == nil
		return ""
	end
	case native_read_text(root + "/fixtures/recovery-managed/valid/managed.json")
	when Result::Ok(source)
		return source
	when Result::Err(_error)
		return ""
	end
end

def _recovery_managed_managed_snapshot_fixture(): String
	root := Process.environment("TYPE_RB_NATIVE_ROOT")
	if root == nil
		return ""
	end
	case native_read_text(root + "/fixtures/recovery-managed/valid/managed-values.json")
	when Result::Ok(source)
		return source
	when Result::Err(_error)
		return ""
	end
end

def _recovery_function_count_snapshot(count: Integer): String
	mut functions := ""
	mut index := 0
	while index < count
		if index > 0
			functions += ","
		end
		functions += "{\"id\":\"example#main\",\"name\":\"main\",\"captures\":[],\"parameters\":[],\"result\":\"Void\",\"entry\":\"b0\",\"origin\":{\"source\":\"main\",\"startLine\":1,\"startColumn\":1,\"endLine\":1,\"endColumn\":1},\"blocks\":[{\"id\":\"b0\",\"parameters\":[],\"origin\":{\"source\":\"main\",\"startLine\":1,\"startColumn\":1,\"endLine\":1,\"endColumn\":1},\"instructions\":[],\"terminator\":{\"op\":\"return\",\"value\":null,\"origin\":{\"source\":\"main\",\"startLine\":1,\"startColumn\":1,\"endLine\":1,\"endColumn\":1}}}]}".replace_all("example#main", "example#f" + index.to_s())
		index += 1
	end
	return "{\"format\":\"type-rb-bootstrap-snapshot\",\"version\":4,\"module\":\"example\",\"entryFunction\":\"example#f0\",\"sources\":[{\"id\":\"main\",\"path\":\"main.trb\"}],\"types\":[],\"functions\":[" + functions + "]}"
end

describe("Managed recovery snapshot v4") do
	test("bounds compiler recovery functions separately from ordinary snapshots") do
		[512, 513, 1024, 1025].each do |count|
			source := _recovery_function_count_snapshot(count)
			case decode_recovery_managed_snapshot(source)
			when Result::Ok(native_module)
				expect(count).to_equal(512)
				expect(native_module.functions.size()).to_equal(count)
			when Result::Err(diagnostic)
				expect(count > 512).to_be_true()
				expect(diagnostic.code).to_equal("TRBN0005")
				expect(diagnostic.path).to_equal("/functions")
			end
			case decode_bootstrap_snapshot(source)
			when Result::Ok(native_module)
				expect(count <= 1024).to_be_true()
				expect(native_module.functions.size()).to_equal(count)
			when Result::Err(diagnostic)
				expect(count).to_equal(1025)
				expect(diagnostic.code).to_equal("TRBN0005")
				expect(diagnostic.path).to_equal("/functions")
			end
		end
	end

	test("strictly decodes aggregate type and instruction definitions") do
		case decode_recovery_managed_snapshot(_recovery_managed_snapshot_fixture())
		when Result::Ok(native_module)
			expect(native_module.id).to_equal("example")
			expect(native_module.types.size()).to_equal(2)
			expect(native_module.functions.size()).to_equal(1)
		when Result::Err(diagnostic)
			puts(diagnostic.path + ": " + diagnostic.message)
			expect(false).to_be_true()
		end
	end

	test("strictly decodes managed types, captures, and operations") do
		case decode_recovery_managed_snapshot(_recovery_managed_managed_snapshot_fixture())
		when Result::Ok(native_module)
			expect(native_module.id).to_equal("managed")
			expect(native_module.types.size()).to_equal(3)
			expect(native_module.functions.size()).to_equal(2)
			expect(native_module.functions[0].captures.size()).to_equal(1)
			expect(native_module.functions[1].blocks[0].instructions.size()).to_equal(14)
		when Result::Err(diagnostic)
			puts(diagnostic.path + ": " + diagnostic.message)
			expect(false).to_be_true()
		end
	end

	test("rejects a closure whose captures do not match its function") do
		source := _recovery_managed_managed_snapshot_fixture().replace_all("\"captures\": [\"suffix\"]", "\"captures\": []")
		case decode_recovery_managed_snapshot(source)
		when Result::Ok(_native_module)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0004")
			expect(diagnostic.message).to_equal("closure capture count does not match the function")
		end
	end

	test("rejects version and unknown root fields deterministically") do
		source := _recovery_managed_snapshot_fixture()
		case decode_recovery_managed_snapshot(source.replace_all("\"version\": 4", "\"version\": 5"))
		when Result::Ok(_native_module)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0003")
			expect(diagnostic.path).to_equal("/version")
		end
		unknown := source.replace_all("\"functions\": [", "\"unexpected\": true, \"functions\": [")
		case decode_recovery_managed_snapshot(unknown)
		when Result::Ok(_native_module)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0002")
			expect(diagnostic.path).to_equal("/unexpected")
		end
	end

	test("rejects unsupported operations and Void fields") do
		source := _recovery_managed_snapshot_fixture()
		unsupported := source.replace_all("\"op\": \"record_construct\"", "\"op\": \"record_build\"")
		case decode_recovery_managed_snapshot(unsupported)
		when Result::Ok(_native_module)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0003")
			expect(diagnostic.message).to_equal("unsupported Managed recovery instruction")
		end
		void_field := source.replace_all(
			"{ \"name\": \"x\", \"type\": \"Integer\" }",
			"{ \"name\": \"x\", \"type\": \"Void\" }",
		)
		case decode_recovery_managed_snapshot(void_field)
		when Result::Ok(_native_module)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0003")
			expect(diagnostic.message).to_equal("unsupported Managed recovery value type")
		end
	end
end
