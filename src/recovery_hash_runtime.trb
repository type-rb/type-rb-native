import { qbe_line } from qbe

# Snapshot-only String/Integer Hash storage. Ordinary compilation owns its
# separate runtime ABI; this adapter retains the snapshot collector's roots.
def emit_recovery_hash_runtime(mut writer: StringBuilder)
	lines := [
		"data $trbn_hash_descriptor = align 8 { l 1, l 2, l 32, l 40 }",
		"data $trbn_hash_keys_descriptor = align 8 { l 2, l 1 }",
		"data $trbn_hash_values_descriptor = align 8 { l 2, l 0 }",
		"data $trbn_hash_missing = { b \"panic: Hash key is missing\\n\" }",
		"",
		"function l $trbn_hash_new(l %capacity) {",
		"@start",
		" %frame =l alloc8 24",
		" %previous =l loadl $trbn_roots",
		" storel %previous, %frame",
		" %count_address =l add %frame, 8",
		" storel 1, %count_address",
		" %root =l add %frame, 16",
		" storel 0, %root",
		" storel %frame, $trbn_roots",
		" %hash =l call $trbn_alloc(l $trbn_hash_descriptor, l 24, l 0)",
		" storel %hash, %root",
		" %keys =l call $trbn_array_new(l $trbn_hash_keys_descriptor, l %capacity)",
		" %keys_address =l add %hash, 32",
		" storel %keys, %keys_address",
		" %values =l call $trbn_array_new(l $trbn_hash_values_descriptor, l %capacity)",
		" %values_address =l add %hash, 40",
		" storel %values, %values_address",
		" storel %previous, $trbn_roots",
		" ret %hash",
		"}",
		"",
		"function l $trbn_hash_slot(l %keys, l %key) {",
		"@start",
		" %size_address =l add %key, 32",
		" %size =l loadl %size_address",
		" %data =l add %key, 48",
		" %capacity =l call $trbn_array_size(l %keys)",
		" %mask =l sub %capacity, 1",
		" jmp @hash_loop",
		"@hash_loop",
		" %i =l phi @start 0, @hash_byte %next",
		" %hash =l phi @start 14695981039346656037, @hash_byte %mixed",
		" %done =w ceql %i, %size",
		" jnz %done, @first_slot, @hash_byte",
		"@hash_byte",
		" %address =l add %data, %i",
		" %byte =l loadub %address",
		" %xor =l xor %hash, %byte",
		" %mixed =l mul %xor, 1099511628211",
		" %next =l add %i, 1",
		" jmp @hash_loop",
		"@first_slot",
		" %first =l and %hash, %mask",
		" jmp @probe",
		"@probe",
		" %slot =l phi @first_slot %first, @advance %next_slot",
		" %stored =l call $trbn_array_get(l %keys, l %slot)",
		" %empty =w ceql %stored, 0",
		" jnz %empty, @finish, @compare",
		"@compare",
		" %equal =w call $trbn_string_equal(l %stored, l %key)",
		" jnz %equal, @finish, @advance",
		"@advance",
		" %incremented =l add %slot, 1",
		" %next_slot =l and %incremented, %mask",
		" jmp @probe",
		"@finish",
		" ret %slot",
		"}",
		"",
		"function w $trbn_hash_contains(l %hash, l %key) {",
		"@start",
		" %keys_address =l add %hash, 32",
		" %keys =l loadl %keys_address",
		" %slot =l call $trbn_hash_slot(l %keys, l %key)",
		" %stored =l call $trbn_array_get(l %keys, l %slot)",
		" %present =w cnel %stored, 0",
		" ret %present",
		"}",
		"",
		"function l $trbn_hash_get(l %hash, l %key) {",
		"@start",
		" %keys_address =l add %hash, 32",
		" %keys =l loadl %keys_address",
		" %slot =l call $trbn_hash_slot(l %keys, l %key)",
		" %stored =l call $trbn_array_get(l %keys, l %slot)",
		" %present =w cnel %stored, 0",
		" jnz %present, @found, @missing",
		"@found",
		" %values_address =l add %hash, 40",
		" %values =l loadl %values_address",
		" %value =l call $trbn_array_get(l %values, l %slot)",
		" ret %value",
		"@missing",
		" call $write(w 2, l $trbn_hash_missing, l 27)",
		" call $exit(w 2)",
		" hlt",
		"}",
		"",
		"function $trbn_hash_set(l %hash, l %key, l %value) {",
		"@start",
		" %keys_address =l add %hash, 32",
		" %values_address =l add %hash, 40",
		" %count_address =l add %hash, 48",
		" %keys =l loadl %keys_address",
		" %values =l loadl %values_address",
		" %slot =l call $trbn_hash_slot(l %keys, l %key)",
		" %stored =l call $trbn_array_get(l %keys, l %slot)",
		" %present =w cnel %stored, 0",
		" jnz %present, @replace, @insert",
		"@replace",
		" call $trbn_array_set(l %values, l %slot, l %value)",
		" ret",
		"@insert",
		" %count =l loadl %count_address",
		" %capacity =l call $trbn_array_size(l %keys)",
		" %scaled_count =l mul %count, 4",
		" %scaled_capacity =l mul %capacity, 3",
		" %full =w cslel %scaled_capacity, %scaled_count",
		" jnz %full, @grow, @store",
		"@store",
		" call $trbn_array_set(l %keys, l %slot, l %key)",
		" call $trbn_array_set(l %values, l %slot, l %value)",
		" %next_count =l add %count, 1",
		" storel %next_count, %count_address",
		" ret",
		"@grow",
		" %too_large =w cslel 1125899906842624, %capacity",
		" jnz %too_large, @fail, @allocate",
		"@fail",
		" call $trbn_allocation_fail()",
		" hlt",
		"@allocate",
		" %frame =l alloc8 24",
		" %previous =l loadl $trbn_roots",
		" storel %previous, %frame",
		" %frame_count =l add %frame, 8",
		" storel 1, %frame_count",
		" %root =l add %frame, 16",
		" storel 0, %root",
		" storel %frame, $trbn_roots",
		" %new_capacity =l mul %capacity, 2",
		" %replacement =l call $trbn_hash_new(l %new_capacity)",
		" storel %replacement, %root",
		" jmp @rehash_loop",
		"@rehash_loop",
		" %i =l phi @allocate 0, @advance %next",
		" %done =w ceql %i, %capacity",
		" jnz %done, @install, @read",
		"@read",
		" %old_key =l call $trbn_array_get(l %keys, l %i)",
		" %empty =w ceql %old_key, 0",
		" jnz %empty, @advance, @copy",
		"@copy",
		" %old_value =l call $trbn_array_get(l %values, l %i)",
		" call $trbn_hash_set(l %replacement, l %old_key, l %old_value)",
		" jmp @advance",
		"@advance",
		" %next =l add %i, 1",
		" jmp @rehash_loop",
		"@install",
		" %new_keys_address =l add %replacement, 32",
		" %new_keys =l loadl %new_keys_address",
		" storel %new_keys, %keys_address",
		" %new_values_address =l add %replacement, 40",
		" %new_values =l loadl %new_values_address",
		" storel %new_values, %values_address",
		" storel %previous, $trbn_roots",
		" call $trbn_hash_set(l %hash, l %key, l %value)",
		" ret",
		"}",
	]
	mut index := 0
	while index < lines.size()
		qbe_line(writer, lines[index])
		index += 1
	end
	return
end
