import { Diagnostic } from diagnostic
import {
	ComparisonOperator,
	FloatBinaryOperator,
	Gate1Instruction,
	IntegerBinaryOperator,
	ScalarType,
} from gate1_mir
import {
	Gate3FieldLayout,
	Gate3Layout,
	Gate3TypeDefinition,
	Gate3ValueType,
	Gate3VariantLayout,
	compute_gate3_layout,
	gate3_type_definition,
	gate3_value_is_managed,
} from gate3_layout
import { emit_gate3_runtime, emit_gate3_runtime_report_support } from gate3_runtime
import {
	Gate3Block,
	Gate3Function,
	Gate3Instruction,
	Gate3Module,
	Gate3Parameter,
	Gate3ResultType,
	Gate3RuntimeStatistic,
	Gate3Terminator,
	gate3_block,
	gate3_function,
	gate3_instruction_result,
	verify_gate3_mir,
} from gate3_mir
import {
	QbeStaticData,
	qbe_comparison,
	qbe_emit_checked_add,
	qbe_emit_checked_divide,
	qbe_emit_checked_multiply,
	qbe_emit_checked_power,
	qbe_emit_checked_remainder,
	qbe_emit_checked_subtract,
	qbe_emit_integer_binary,
	qbe_emit_static_data,
	qbe_float_operator,
	qbe_line,
	qbe_scalar_type,
	qbe_static_symbol,
} from qbe
import { SourceOrigin } from snapshot
import { Result } from trb/std/result
import trb/std/string_builder

record Gate3QbeContext
	values: Hash<String, String>
	value_types: Hash<String, Gate3ValueType>
	known_static_strings: Hash<String, String>
	transfer_slots: Hash<String, String>
	storage_slots: Hash<String, String>
	root_slots: Hash<String, String>
	aliased_parameters: Hash<String, Boolean>
	root_count: Integer
end

record Gate3KnownClosure
	function_id: String
	captures: Array<String>
end

def _qbe_line(mut writer: StringBuilder, value: String)
	qbe_line(writer, value)
	return
end

def _qbe_emit_static_data(static_data: Array<QbeStaticData>, mut writer: StringBuilder)
	qbe_emit_static_data(static_data, writer)
	return
end

def _qbe_emit_checked_add(mut writer: StringBuilder)
	qbe_emit_checked_add(writer)
	return
end

def _qbe_emit_checked_subtract(mut writer: StringBuilder)
	qbe_emit_checked_subtract(writer)
	return
end

def _qbe_emit_checked_multiply(mut writer: StringBuilder)
	qbe_emit_checked_multiply(writer)
	return
end

def _qbe_emit_checked_divide(mut writer: StringBuilder)
	qbe_emit_checked_divide(writer)
	return
end

def _qbe_emit_checked_remainder(mut writer: StringBuilder)
	qbe_emit_checked_remainder(writer)
	return
end

def _qbe_emit_checked_power(mut writer: StringBuilder)
	qbe_emit_checked_power(writer)
	return
end

def _qbe_emit_integer_binary(
		operator: IntegerBinaryOperator,
		result: String,
		left: String,
		right: String,
		block_index: Integer,
		instruction_index: Integer,
		mut writer: StringBuilder,
	)
	qbe_emit_integer_binary(operator, result, left, right, block_index, instruction_index, writer)
	return
end

def _qbe_float_operator(operator: FloatBinaryOperator): String
	return qbe_float_operator(operator)
end

def _qbe_comparison(operator: ComparisonOperator, suffix: String): String
	return qbe_comparison(operator, suffix)
end

def _qbe_type(value_type: ScalarType): String
	return qbe_scalar_type(value_type)
end

def _qbe_static_symbol(static_data: Array<QbeStaticData>, value: String): String
	return qbe_static_symbol(static_data, value)
end

def _qbe3_static_string_symbol(static_data: Array<QbeStaticData>, value: String): String
	mut index := 0
	while static_data[index].value != value
		index += 1
	end
	return "$trbn_g3string_" + index.to_s()
end

def emit_gate3_qbe(native_module: Gate3Module): Result<String, Diagnostic>
	return _emit_gate3_qbe(native_module, false)
end

def emit_gate3_qbe_with_runtime_report(native_module: Gate3Module): Result<String, Diagnostic>
	return _emit_gate3_qbe(native_module, true)
end

def _emit_gate3_qbe(native_module: Gate3Module, report_runtime: Boolean): Result<String, Diagnostic>
	try verify_gate3_mir(native_module)
	static_data := _qbe3_collect_static_data(native_module)
	mut writer := string_builder.new()
	_qbe_emit_static_data(static_data, writer)
	_qbe3_emit_static_strings(static_data, writer)
	_qbe3_emit_projection_data(writer)
	try _qbe3_emit_descriptors(native_module, writer)
	_qbe3_emit_runtime(writer)
	emit_gate3_runtime(writer)
	if report_runtime
		emit_gate3_runtime_report_support(writer)
	end
	mut function_index := 0
	while function_index < native_module.functions.size()
		try _qbe3_emit_function(
			native_module,
			native_module.functions[function_index],
			function_index,
			static_data,
			writer,
		)
		function_index += 1
	end
	_qbe3_emit_entry(native_module, report_runtime, writer)
	return Result<String, Diagnostic>::Ok(writer.to_s())
end

def _qbe3_emit_static_strings(static_data: Array<QbeStaticData>, mut writer: StringBuilder)
	mut index := 0
	while index < static_data.size()
		item := static_data[index]
		bytes := item.value.to_bytes()
		mut tail := ""
		if bytes.size() != 0
			mut values: Array<String> := []
			mut byte_index := 0
			while byte_index < bytes.size()
				values.push(bytes.at(byte_index).to_s())
				byte_index += 1
			end
			tail = ", b " + values.join(" ")
		end
		_qbe_line(
			writer,
			"data $trbn_g3string_" + index.to_s() + " = align 8 { l 0, l $trbn_desc_string, l 0, l 1, l " +
			bytes.size().to_s() + ", l " + item.value.size().to_s() + tail + " }",
		)
		index += 1
	end
	_qbe_line(writer, "")
	return
end

def _qbe3_collect_static_data(native_module: Gate3Module): Array<QbeStaticData>
	mut static_data: Array<QbeStaticData> := []
	mut symbols: Hash<String, String> := {}
	mut function_index := 0
	while function_index < native_module.functions.size()
		function := native_module.functions[function_index]
		mut known_static_strings: Hash<String, String> := {}
		mut block_index := 0
		while block_index < function.blocks.size()
			block := function.blocks[block_index]
			mut instruction_index := 0
			while instruction_index < block.instructions.size()
				case block.instructions[instruction_index]
				when Gate3Instruction::Scalar(scalar)
					case scalar
					when Gate1Instruction::WriteStatic(value, _origin)
						if !symbols.key?(value)
							symbol := "$trbn_data_" + static_data.size().to_s()
							symbols[value] = symbol
							static_data.push(QbeStaticData.new(symbol: symbol, value: value))
						end
					else
					end
				when Gate3Instruction::StringLiteral(result, value, _origin)
					known_static_strings[result] = value
					if !symbols.key?(value)
						symbol := "$trbn_data_" + static_data.size().to_s()
						symbols[value] = symbol
						static_data.push(QbeStaticData.new(symbol: symbol, value: value))
					end
				when Gate3Instruction::StringConcat(result, left, right, _origin)
					if known_static_strings.key?(left) && known_static_strings.key?(right)
						value := known_static_strings.fetch(left) + known_static_strings.fetch(right)
						known_static_strings[result] = value
						if !symbols.key?(value)
							symbol := "$trbn_data_" + static_data.size().to_s()
							symbols[value] = symbol
							static_data.push(QbeStaticData.new(symbol: symbol, value: value))
						end
					end
				else
				end
				instruction_index += 1
			end
			block_index += 1
		end
		function_index += 1
	end
	return static_data
end

def _qbe3_emit_projection_data(mut writer: StringBuilder)
	_qbe_line(writer, "data $trbn_variant_projection_error = { b 112 97 110 105 99 58 32 105 110 118 97 108 105 100 32 101 110 117 109 32 112 114 111 106 101 99 116 105 111 110 10 }")
	_qbe_line(writer, "")
	return
end

def _qbe3_emit_descriptors(
		native_module: Gate3Module,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut index := 0
	while index < native_module.types.size()
		definition := native_module.types[index]
		symbol := _qbe3_type_descriptor(index)
		case definition
		when Gate3TypeDefinition::String(_type_id)
		when Gate3TypeDefinition::Array(_type_id, element_type)
			mut managed := "0"
			if try gate3_value_is_managed(native_module.types, element_type)
				managed = "1"
			end
			_qbe_line(writer, "data " + symbol + " = align 8 { l 2, l " + managed + " }")
		when Gate3TypeDefinition::Function(_type_id, _parameter_types, _result_type)
		when Gate3TypeDefinition::Record(type_id, _fields)
			layout := try compute_gate3_layout(native_module.types, type_id)
			if layout.managed
				mut offsets: Array<String> := []
				mut field_index := 0
				while field_index < layout.fields.size()
					field := layout.fields[field_index]
					if field.managed
						offsets.push("l " + (field.offset + 32).to_s())
					end
					field_index += 1
				end
				_qbe3_emit_fixed_descriptor(symbol, offsets, writer)
			else
				_qbe_line(writer, "data " + symbol + " = align 8 { l 0 }")
			end
		when Gate3TypeDefinition::Tagged(type_id, _variants)
			layout := try compute_gate3_layout(native_module.types, type_id)
			if layout.managed
				mut variant_symbols: Array<String> := []
				mut variant_index := 0
				while variant_index < layout.variants.size()
					variant := layout.variants[variant_index]
					variant_symbol := symbol + "_v" + variant_index.to_s()
					variant_symbols.push("l " + variant_symbol)
					mut offsets: Array<String> := []
					mut field_index := 0
					while field_index < variant.fields.size()
						field := variant.fields[field_index]
						if field.managed
							offsets.push("l " + (field.offset + 32).to_s())
						end
						field_index += 1
					end
					_qbe_line(
						writer,
						"data " + variant_symbol + " = align 8 { l " + offsets.size().to_s() +
						_gate3_descriptor_tail(offsets) + " }",
					)
					variant_index += 1
				end
				table := symbol + "_table"
				_qbe_line(writer, "data " + table + " = align 8 { " + variant_symbols.join(", ") + " }")
				_qbe_line(
					writer,
					"data " + symbol + " = align 8 { l 3, l " + layout.variants.size().to_s() + ", l " + table + " }",
				)
			else
				_qbe_line(writer, "data " + symbol + " = align 8 { l 0 }")
			end
		end
		index += 1
	end
	index = 0
	while index < native_module.functions.size()
		function := native_module.functions[index]
		mut offsets: Array<String> := []
		mut capture_index := 0
		mut capture_offset := 0
		while capture_index < function.captures.size()
			capture := function.captures[capture_index]
			if try gate3_value_is_managed(native_module.types, capture.value_type)
				offsets.push("l " + (32 + capture_offset).to_s())
			end
			capture_offset += try _qbe3_capture_storage_size(native_module, capture.value_type)
			capture_index += 1
		end
		_qbe3_emit_fixed_descriptor(_qbe3_environment_descriptor(index), offsets, writer)
		index += 1
	end
	_qbe_line(writer, "")
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_fixed_descriptor(
		symbol: String,
		offsets: Array<String>,
		mut writer: StringBuilder,
	)
	_qbe_line(
		writer,
		"data " + symbol + " = align 8 { l 1, l " + offsets.size().to_s() + _gate3_descriptor_tail(offsets) + " }",
	)
	return
end

def _gate3_descriptor_tail(values: Array<String>): String
	if values.empty?()
		return ""
	end
	return ", " + values.join(", ")
end

def _qbe3_type_descriptor(index: Integer): String
	return "$trbn_g3desc_t" + index.to_s()
end

def _qbe3_environment_descriptor(index: Integer): String
	return "$trbn_g3env_f" + index.to_s()
end

def _qbe3_emit_runtime(mut writer: StringBuilder)
	_qbe_line(writer, "function $trbn_integer_range_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_integer_range_error, l 45)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_line(writer, "function $trbn_division_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_division_error, l 24)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_line(writer, "function $trbn_negative_exponent_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_negative_exponent_error, l 33)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_line(writer, "function $trbn_variant_projection_fail() {")
	_qbe_line(writer, "@start")
	_qbe_line(writer, "\tcall $write(w 2, l $trbn_variant_projection_error, l 31)")
	_qbe_line(writer, "\tcall $exit(w 2)")
	_qbe_line(writer, "\thlt")
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	_qbe_emit_checked_add(writer)
	_qbe_emit_checked_subtract(writer)
	_qbe_emit_checked_multiply(writer)
	_qbe_emit_checked_divide(writer)
	_qbe_emit_checked_remainder(writer)
	_qbe_emit_checked_power(writer)
	return
end

def _qbe3_emit_function(
		native_module: Gate3Module,
		function: Gate3Function,
		function_index: Integer,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	context := try _qbe3_context(native_module, function)
	mut parameters: Array<String> := []
	case function.result_type
	when Gate3ResultType::Void
	when Gate3ResultType::Value(value_type)
		case value_type
		when Gate3ValueType::Scalar(_scalar)
		when Gate3ValueType::Aggregate(_type_id)
			if !(try gate3_value_is_managed(native_module.types, value_type))
				parameters.push("l %return")
			end
		end
	end
	if _qbe3_function_uses_closure_abi(native_module, function.id)
		parameters.push("l %environment")
	end
	mut parameter_index := 0
	while parameter_index < function.parameters.size()
		parameter := function.parameters[parameter_index]
		parameters.push(_qbe3_abi_type(parameter.value_type) + " " + context.values.fetch(parameter.id))
		parameter_index += 1
	end
	mut result_prefix := ""
	case function.result_type
	when Gate3ResultType::Void
	when Gate3ResultType::Value(value_type)
		case value_type
		when Gate3ValueType::Scalar(scalar)
			result_prefix = _qbe_type(scalar) + " "
		when Gate3ValueType::Aggregate(_type_id)
			if try gate3_value_is_managed(native_module.types, value_type)
				result_prefix = "l "
			end
		end
	end
	_qbe_line(writer, "function " + result_prefix + "$trbn_g3f" + function_index.to_s() + "(" + parameters.join(", ") + ") {")
	entry_index := _qbe3_block_index(function.blocks, function.entry)
	try _qbe3_emit_block(native_module, function, entry_index, context, static_data, writer)
	mut block_index := 0
	while block_index < function.blocks.size()
		if block_index != entry_index
			try _qbe3_emit_block(native_module, function, block_index, context, static_data, writer)
		end
		block_index += 1
	end
	_qbe_line(writer, "}")
	_qbe_line(writer, "")
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_context(
		native_module: Gate3Module,
		function: Gate3Function,
	): Result<Gate3QbeContext, Diagnostic>
	mut values: Hash<String, String> := {}
	mut value_types: Hash<String, Gate3ValueType> := {}
	mut known_static_strings: Hash<String, String> := {}
	mut transfer_slots: Hash<String, String> := {}
	mut storage_slots: Hash<String, String> := {}
	mut root_slots: Hash<String, String> := {}
	mut aliased_parameters: Hash<String, Boolean> := {}
	mut next_value := 0
	mut next_transfer := 0
	mut next_storage := 0
	mut next_root := 0
	mut parameter_index := 0
	while parameter_index < function.captures.size()
		capture := function.captures[parameter_index]
		values[capture.id] = "%v" + next_value.to_s()
		value_types[capture.id] = capture.value_type
		next_value += 1
		if try gate3_value_is_managed(native_module.types, capture.value_type)
			root_slots[capture.id] = "%root" + next_root.to_s()
			next_root += 1
		end
		parameter_index += 1
	end
	parameter_index = 0
	while parameter_index < function.parameters.size()
		parameter := function.parameters[parameter_index]
		values[parameter.id] = "%v" + next_value.to_s()
		value_types[parameter.id] = parameter.value_type
		next_value += 1
		if try gate3_value_is_managed(native_module.types, parameter.value_type)
			root_slots[parameter.id] = "%root" + next_root.to_s()
			next_root += 1
		end
		parameter_index += 1
	end
	mut block_index := 0
	while block_index < function.blocks.size()
		block := function.blocks[block_index]
		parameter_index = 0
		while parameter_index < block.parameters.size()
			parameter := block.parameters[parameter_index]
			transfer_slots[parameter.id] = "%transfer" + next_transfer.to_s()
			next_transfer += 1
			value_types[parameter.id] = parameter.value_type
			case parameter.value_type
			when Gate3ValueType::Scalar(_scalar)
				values[parameter.id] = "%v" + next_value.to_s()
				next_value += 1
			when Gate3ValueType::Aggregate(_type_id)
				if try gate3_value_is_managed(native_module.types, parameter.value_type)
					values[parameter.id] = "%v" + next_value.to_s()
					next_value += 1
					root_slots[parameter.id] = "%root" + next_root.to_s()
					next_root += 1
				else
					storage_slots[parameter.id] = "%storage" + next_storage.to_s()
					values[parameter.id] = transfer_slots.fetch(parameter.id)
					next_storage += 1
				end
			end
			parameter_index += 1
		end
		mut instruction_index := 0
		while instruction_index < block.instructions.size()
			instruction := block.instructions[instruction_index]
			case instruction
			when Gate3Instruction::StringLiteral(result, value, _origin)
				known_static_strings[result] = value
			when Gate3Instruction::StringConcat(result, left, right, _origin)
				if known_static_strings.key?(left) && known_static_strings.key?(right)
					known_static_strings[result] = known_static_strings.fetch(left) + known_static_strings.fetch(right)
				end
			else
			end
			result := gate3_instruction_result(instruction)
			if result != nil
				value_type := try _qbe3_instruction_type(native_module, instruction)
				value_types[result] = value_type
				case value_type
				when Gate3ValueType::Scalar(_scalar)
					values[result] = "%v" + next_value.to_s()
					next_value += 1
				when Gate3ValueType::Aggregate(_type_id)
					if try gate3_value_is_managed(native_module.types, value_type)
						values[result] = "%v" + next_value.to_s()
						next_value += 1
						root_slots[result] = "%root" + next_root.to_s()
						next_root += 1
					else
						storage_slots[result] = "%storage" + next_storage.to_s()
						values[result] = storage_slots.fetch(result)
						next_storage += 1
					end
				end
			end
			instruction_index += 1
		end
		block_index += 1
	end
	mut alias_pass := 0
	while alias_pass < function.blocks.size()
		block_index = 0
		while block_index < function.blocks.size()
			block := function.blocks[block_index]
			parameter_index = 0
			while parameter_index < block.parameters.size()
				parameter := block.parameters[parameter_index]
				incoming := _qbe3_common_incoming_value(
					function,
					block.id,
					parameter_index,
					values.fetch(parameter.id),
					values,
				)
				if !incoming.empty?()
					case parameter.value_type
					when Gate3ValueType::Scalar(_scalar)
						values[parameter.id] = incoming
						aliased_parameters[parameter.id] = true
					when Gate3ValueType::Aggregate(_type_id)
						if try gate3_value_is_managed(native_module.types, parameter.value_type)
							incoming_root := _qbe3_common_incoming_root(
								function,
								block.id,
								parameter_index,
								root_slots.fetch(parameter.id),
								root_slots,
							)
							if !incoming_root.empty?()
								values[parameter.id] = incoming
								root_slots[parameter.id] = incoming_root
								aliased_parameters[parameter.id] = true
							end
						else
							values[parameter.id] = incoming
							aliased_parameters[parameter.id] = true
						end
					end
				end
				parameter_index += 1
			end
			block_index += 1
		end
		alias_pass += 1
	end
	return Result<Gate3QbeContext, Diagnostic>::Ok(
		Gate3QbeContext.new(
			values: values,
			value_types: value_types,
			known_static_strings: known_static_strings,
			transfer_slots: transfer_slots,
			storage_slots: storage_slots,
			root_slots: root_slots,
			aliased_parameters: aliased_parameters,
			root_count: next_root,
		)
	)
end

def _qbe3_common_incoming_value(
		function: Gate3Function,
		target: String,
		parameter_index: Integer,
		current: String,
		values: Hash<String, String>,
	): String
	mut common := ""
	mut block_index := 0
	while block_index < function.blocks.size()
		case function.blocks[block_index].terminator
		when Gate3Terminator::Jump(edge_target, arguments, _origin)
			if edge_target == target
				candidate := values.fetch(arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when Gate3Terminator::Branch(
				_condition,
				when_true,
				true_arguments,
				when_false,
				false_arguments,
				_origin,
			)
			if when_true == target
				candidate := values.fetch(true_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
			if when_false == target
				candidate := values.fetch(false_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when Gate3Terminator::Return(_value, _origin)
		end
		block_index += 1
	end
	return common
end

def _qbe3_common_incoming_root(
		function: Gate3Function,
		target: String,
		parameter_index: Integer,
		current: String,
		root_slots: Hash<String, String>,
	): String
	mut common := ""
	mut block_index := 0
	while block_index < function.blocks.size()
		case function.blocks[block_index].terminator
		when Gate3Terminator::Jump(edge_target, arguments, _origin)
			if edge_target == target
				candidate := root_slots.fetch(arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when Gate3Terminator::Branch(
				_condition,
				when_true,
				true_arguments,
				when_false,
				false_arguments,
				_origin,
			)
			if when_true == target
				candidate := root_slots.fetch(true_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
			if when_false == target
				candidate := root_slots.fetch(false_arguments[parameter_index])
				if candidate == current
				else
					if common.empty?()
						common = candidate
					else
						if common != candidate
							return ""
						end
					end
				end
			end
		when Gate3Terminator::Return(_value, _origin)
		end
		block_index += 1
	end
	return common
end

def _qbe3_instruction_type(
		native_module: Gate3Module,
		instruction: Gate3Instruction,
	): Result<Gate3ValueType, Diagnostic>
	case instruction
	when Gate3Instruction::Scalar(scalar)
		case scalar
		when Gate1Instruction::BooleanLiteral(_result, _value, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Boolean))
		when Gate1Instruction::IntegerLiteral(_result, _value, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Integer))
		when Gate1Instruction::FloatLiteral(_result, _value, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Float))
		when Gate1Instruction::IntegerBinary(_result, _operator, _left, _right, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Integer))
		when Gate1Instruction::FloatBinary(_result, _operator, _left, _right, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Float))
		when Gate1Instruction::IntegerCompare(_result, _operator, _left, _right, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Boolean))
		when Gate1Instruction::FloatCompare(_result, _operator, _left, _right, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Boolean))
		when Gate1Instruction::BooleanNot(_result, _value, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Boolean))
		when Gate1Instruction::Call(_result, _function_id, _arguments, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
		when Gate1Instruction::WriteStatic(_value, _origin)
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
		end
	when Gate3Instruction::StringLiteral(_result, _value, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate("String"))
	when Gate3Instruction::StringConcat(_result, _left, _right, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate("String"))
	when Gate3Instruction::StringEqual(_result, _left, _right, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Boolean))
	when Gate3Instruction::StringSize(_result, _value, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Integer))
	when Gate3Instruction::StringIndex(_result, _value, _index, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate("String"))
	when Gate3Instruction::WriteString(_value, _newline, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
	when Gate3Instruction::ArrayConstruct(_result, type_id, _arguments, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate(type_id))
	when Gate3Instruction::ArraySize(_result, _type_id, _array, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Integer))
	when Gate3Instruction::ArrayGet(_result, type_id, _array, _index, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(_qbe3_array_element_type(native_module, type_id))
	when Gate3Instruction::ArraySet(_type_id, _array, _index, _value, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
	when Gate3Instruction::ArrayPush(_type_id, _array, _value, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
	when Gate3Instruction::ClosureConstruct(_result, type_id, _function_id, _captures, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate(type_id))
	when Gate3Instruction::ClosureCall(_result, type_id, _closure, _arguments, _origin)
		result_type := _qbe3_function_result_type(native_module, type_id)
		if result_type == nil
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
		end
		return Result<Gate3ValueType, Diagnostic>::Ok(result_type)
	when Gate3Instruction::RuntimeCollect(_origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
	when Gate3Instruction::RuntimeStatistic(_result, _statistic, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Integer))
	when Gate3Instruction::RecordConstruct(_result, type_id, _arguments, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate(type_id))
	when Gate3Instruction::RecordProject(_result, type_id, _record, field, _origin)
		layout := try compute_gate3_layout(native_module.types, type_id)
		return Result<Gate3ValueType, Diagnostic>::Ok(_qbe3_required_field(layout, field).value_type)
	when Gate3Instruction::VariantConstruct(_result, type_id, _variant, _arguments, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate(type_id))
	when Gate3Instruction::VariantTest(_result, _type_id, _value, _variant, _origin)
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Boolean))
	when Gate3Instruction::VariantProject(_result, type_id, _value, variant, field, _origin)
		layout := try compute_gate3_layout(native_module.types, type_id)
		variant_layout := _qbe3_required_variant(layout, variant)
		return Result<Gate3ValueType, Diagnostic>::Ok(_qbe3_required_variant_field(variant_layout, field).value_type)
	when Gate3Instruction::Call(_result, function_id, _arguments, _origin)
		callee := gate3_function(native_module.functions, function_id)
		case callee.result_type
		when Gate3ResultType::Void
			return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Void))
		when Gate3ResultType::Value(value_type)
			return Result<Gate3ValueType, Diagnostic>::Ok(value_type)
		end
	end
end

def _qbe3_emit_block(
		native_module: Gate3Module,
		function: Gate3Function,
		block_index: Integer,
		context: Gate3QbeContext,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	block := function.blocks[block_index]
	_qbe_line(writer, "@b" + block_index.to_s())
	if block.id == function.entry
		try _qbe3_emit_allocations(native_module, function, context, writer)
		try _qbe3_emit_capture_loads(native_module, function, context, writer)
		_qbe3_emit_root_frame(function, context, writer)
	else
		try _qbe3_emit_block_parameter_loads(native_module, block, context, writer)
	end
	mut instruction_index := 0
	while instruction_index < block.instructions.size()
		try _qbe3_emit_instruction(
			native_module,
			function,
			block.instructions[instruction_index],
			block_index,
			instruction_index,
			context,
			static_data,
			writer,
		)
		result := gate3_instruction_result(block.instructions[instruction_index])
		if result != nil
			if context.root_slots.key?(result)
				_qbe_line(writer, "\tstorel " + context.values.fetch(result) + ", " + context.root_slots.fetch(result))
			end
		end
		instruction_index += 1
	end
	try _qbe3_emit_terminator(native_module, function, block.terminator, block_index, context, writer)
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_allocations(
		native_module: Gate3Module,
		function: Gate3Function,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut block_index := 0
	while block_index < function.blocks.size()
		block := function.blocks[block_index]
		mut parameter_index := 0
		while parameter_index < block.parameters.size()
			parameter := block.parameters[parameter_index]
			try _qbe3_emit_allocation(
				native_module,
				parameter.value_type,
				context.transfer_slots.fetch(parameter.id),
				writer,
			)
			if context.storage_slots.key?(parameter.id)
				try _qbe3_emit_allocation(
					native_module,
					parameter.value_type,
					context.storage_slots.fetch(parameter.id),
					writer,
				)
			end
			parameter_index += 1
		end
		mut instruction_index := 0
		while instruction_index < block.instructions.size()
			result := gate3_instruction_result(block.instructions[instruction_index])
			if result != nil
				if context.storage_slots.key?(result)
					try _qbe3_emit_allocation(
						native_module,
						context.value_types.fetch(result),
						context.storage_slots.fetch(result),
						writer,
					)
				end
			end
			instruction_index += 1
		end
		block_index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_allocation(
		native_module: Gate3Module,
		value_type: Gate3ValueType,
		slot: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut allocation := "alloc8"
	mut size := 8
	case value_type
	when Gate3ValueType::Scalar(scalar)
		if scalar == ScalarType::Boolean
			allocation = "alloc4"
			size = 4
		end
	when Gate3ValueType::Aggregate(type_id)
		layout := try compute_gate3_layout(native_module.types, type_id)
		if layout.managed
			size = 8
		else
			size = layout.size
		end
		if !layout.managed && layout.alignment < 8
			allocation = "alloc4"
			if size < 4
				size = 4
			end
		end
	end
	_qbe_line(writer, "\t" + slot + " =l " + allocation + " " + size.to_s())
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_block_parameter_loads(
		native_module: Gate3Module,
		block: Gate3Block,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut index := 0
	while index < block.parameters.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when Gate3ValueType::Scalar(scalar)
			if _qbe3_parameter_uses_transfer(parameter, context)
				_qbe_line(writer,
					"\t" + context.values.fetch(parameter.id) + " =" + _qbe_type(scalar) + " " +
					_qbe3_scalar_slot_load(scalar) + " " + context.transfer_slots.fetch(parameter.id)
				)
			end
		when Gate3ValueType::Aggregate(_type_id)
			if try gate3_value_is_managed(native_module.types, parameter.value_type)
				if _qbe3_parameter_uses_transfer(parameter, context)
					_qbe_line(
						writer,
						"\t" + context.values.fetch(parameter.id) + " =l loadl " +
						context.transfer_slots.fetch(parameter.id),
					)
					_qbe_line(
						writer,
						"\tstorel " + context.values.fetch(parameter.id) + ", " + context.root_slots.fetch(parameter.id),
					)
				end
			end
		end
		index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_capture_loads(
		native_module: Gate3Module,
		function: Gate3Function,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	mut index := 0
	mut offset := 0
	while index < function.captures.size()
		capture := function.captures[index]
		address := _qbe3_address("%environment", 32 + offset, "%capture_address" + index.to_s(), writer)
		case capture.value_type
		when Gate3ValueType::Scalar(scalar)
			_qbe_line(
				writer,
				"\t" + context.values.fetch(capture.id) + " =" + _qbe_type(scalar) + " " +
				_qbe3_scalar_slot_load(scalar) + " " + address,
			)
		when Gate3ValueType::Aggregate(_type_id)
			if try gate3_value_is_managed(native_module.types, capture.value_type)
				_qbe_line(writer, "\t" + context.values.fetch(capture.id) + " =l loadl " + address)
			else
				_qbe_line(writer, "\t" + context.values.fetch(capture.id) + " =l copy " + address)
			end
		end
		offset += try _qbe3_capture_storage_size(native_module, capture.value_type)
		index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_root_frame(
		function: Gate3Function,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	)
	frame_size := 16 + context.root_count * 8
	_qbe_line(writer, "\t%root_frame =l alloc8 " + frame_size.to_s())
	_qbe_line(writer, "\t%previous_roots =l loadl $trbn_roots")
	_qbe_line(writer, "\tstorel %previous_roots, %root_frame")
	_qbe_line(writer, "\t%root_count_address =l add %root_frame, 8")
	_qbe_line(writer, "\tstorel " + context.root_count.to_s() + ", %root_count_address")
	mut index := 0
	while index < context.root_count
		_qbe_line(writer, "\t%root" + index.to_s() + " =l add %root_frame, " + (16 + index * 8).to_s())
		_qbe_line(writer, "\tstorel 0, %root" + index.to_s())
		index += 1
	end
	index = 0
	while index < function.captures.size()
		capture := function.captures[index]
		if context.root_slots.key?(capture.id)
			_qbe_line(writer, "\tstorel " + context.values.fetch(capture.id) + ", " + context.root_slots.fetch(capture.id))
		end
		index += 1
	end
	index = 0
	while index < function.parameters.size()
		parameter := function.parameters[index]
		if context.root_slots.key?(parameter.id)
			_qbe_line(writer, "\tstorel " + context.values.fetch(parameter.id) + ", " + context.root_slots.fetch(parameter.id))
		end
		index += 1
	end
	_qbe_line(writer, "\tstorel %root_frame, $trbn_roots")
	return
end

def _qbe3_emit_instruction(
		native_module: Gate3Module,
		function: Gate3Function,
		instruction: Gate3Instruction,
		block_index: Integer,
		instruction_index: Integer,
		context: Gate3QbeContext,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	prefix := "%g3_" + block_index.to_s() + "_" + instruction_index.to_s() + "_"
	case instruction
	when Gate3Instruction::Scalar(scalar)
		_qbe3_emit_scalar(native_module, scalar, block_index, instruction_index, context.values, static_data, writer)
	when Gate3Instruction::StringLiteral(result, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l copy " + _qbe3_static_string_symbol(static_data, value),
		)
	when Gate3Instruction::StringConcat(result, left, right, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		if context.known_static_strings.key?(result)
			_qbe_line(
				writer,
				"\t" + context.values.fetch(result) + " =l copy " +
				_qbe3_static_string_symbol(static_data, context.known_static_strings.fetch(result)),
			)
		else
			_qbe_line(
				writer,
				"\t" + context.values.fetch(result) + " =l call $trbn_string_concat(l " +
				context.values.fetch(left) + ", l " + context.values.fetch(right) + ")",
			)
		end
	when Gate3Instruction::StringEqual(result, left, right, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =w call $trbn_string_equal(l " +
			context.values.fetch(left) + ", l " + context.values.fetch(right) + ")",
		)
	when Gate3Instruction::StringSize(result, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		address := _qbe3_address(context.values.fetch(value), 40, prefix + "string_size", writer)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l loadl " + address)
	when Gate3Instruction::StringIndex(result, value, index, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l call $trbn_string_index(l " +
			context.values.fetch(value) + ", l " + context.values.fetch(index) + ")",
		)
	when Gate3Instruction::WriteString(value, newline, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		mut newline_value := "0"
		if newline
			newline_value = "1"
		end
		_qbe_line(writer, "\tcall $trbn_write_string(l " + context.values.fetch(value) + ", w " + newline_value + ")")
	when Gate3Instruction::ArrayConstruct(result, type_id, arguments, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		descriptor := _qbe3_type_descriptor(_qbe3_type_index(native_module.types, type_id))
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l call $trbn_array_new(l " + descriptor + ", l " +
			arguments.size().to_s() + ")",
		)
		backing_address := _qbe3_address(context.values.fetch(result), 64, prefix + "array_backing_address", writer)
		backing := prefix + "array_backing"
		_qbe_line(writer, "\t" + backing + " =l loadl " + backing_address)
		mut index := 0
		while index < arguments.size()
			entry := _qbe3_address(backing, index * 8, prefix + "array_entry" + index.to_s(), writer)
			_qbe_line(writer, "\tstorel " + context.values.fetch(arguments[index]) + ", " + entry)
			index += 1
		end
	when Gate3Instruction::ArraySize(result, _type_id, array, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l call $trbn_array_size(l " + context.values.fetch(array) + ")")
	when Gate3Instruction::ArrayGet(result, _type_id, array, index, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l call $trbn_array_get(l " + context.values.fetch(array) +
			", l " + context.values.fetch(index) + ")",
		)
	when Gate3Instruction::ArraySet(_type_id, array, index, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\tcall $trbn_array_set(l " + context.values.fetch(array) + ", l " + context.values.fetch(index) +
			", l " + context.values.fetch(value) + ")",
		)
	when Gate3Instruction::ArrayPush(_type_id, array, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(
			writer,
			"\tcall $trbn_array_push(l " + context.values.fetch(array) + ", l " + context.values.fetch(value) + ")",
		)
	when Gate3Instruction::ClosureConstruct(result, _type_id, function_id, captures, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		callee_index := _qbe3_function_index(native_module.functions, function_id)
		environment := prefix + "environment"
		environment_size := try _qbe3_environment_payload_size(native_module, native_module.functions[callee_index])
		_qbe_line(
			writer,
			"\t" + environment + " =l call $trbn_alloc(l " + _qbe3_environment_descriptor(callee_index) +
			", l " + environment_size.to_s() + ", l 0)",
		)
		_qbe_line(writer, "\tstorel " + environment + ", " + context.root_slots.fetch(result))
		mut capture_index := 0
		mut capture_offset := 0
		while capture_index < captures.size()
			capture_type := native_module.functions[callee_index].captures[capture_index].value_type
			capture_address := _qbe3_address(
				environment,
				32 + capture_offset,
				prefix + "capture" + capture_index.to_s(),
				writer,
			)
			try _qbe3_emit_environment_store(
				native_module,
				capture_type,
				context.values.fetch(captures[capture_index]),
				capture_address,
				writer,
			)
			capture_offset += try _qbe3_capture_storage_size(native_module, capture_type)
			capture_index += 1
		end
		_qbe_line(
			writer,
			"\t" + context.values.fetch(result) + " =l call $trbn_alloc(l $trbn_desc_closure, l 16, l 0)",
		)
		code_address := _qbe3_address(context.values.fetch(result), 32, prefix + "closure_code", writer)
		_qbe_line(writer, "\tstorel $trbn_g3f" + callee_index.to_s() + ", " + code_address)
		environment_address := _qbe3_address(context.values.fetch(result), 40, prefix + "closure_environment", writer)
		_qbe_line(writer, "\tstorel " + environment + ", " + environment_address)
	when Gate3Instruction::ClosureCall(result, type_id, closure, arguments, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		if _qbe3_emit_inlined_closure_call(
				native_module,
				function,
				result,
				closure,
				arguments,
				block_index,
				instruction_index,
				context,
				writer,
			)
			return Result<Boolean, Diagnostic>::Ok(true)
		end
		code_address := _qbe3_address(context.values.fetch(closure), 32, prefix + "call_code_address", writer)
		code := prefix + "call_code"
		_qbe_line(writer, "\t" + code + " =l loadl " + code_address)
		environment_address := _qbe3_address(context.values.fetch(closure), 40, prefix + "call_environment_address", writer)
		environment := prefix + "call_environment"
		_qbe_line(writer, "\t" + environment + " =l loadl " + environment_address)
		parameter_types := _qbe3_function_parameter_types(native_module, type_id)
		mut call_arguments: Array<String> := ["l " + environment]
		mut index := 0
		while index < arguments.size()
			call_arguments.push(_qbe3_abi_type(parameter_types[index]) + " " + context.values.fetch(arguments[index]))
			index += 1
		end
		result_type := _qbe3_function_result_type(native_module, type_id)
		mut call_prefix := "\t"
		if result_type != nil
			case result_type
			when Gate3ValueType::Scalar(scalar)
				call_prefix = "\t" + context.values.fetch(_qbe3_required_id(result)) + " =" + _qbe_type(scalar) + " "
			when Gate3ValueType::Aggregate(_result_type_id)
				if try gate3_value_is_managed(native_module.types, result_type)
					call_prefix = "\t" + context.values.fetch(_qbe3_required_id(result)) + " =l "
				else
					mut prefixed_arguments: Array<String> := ["l " + context.values.fetch(_qbe3_required_id(result))]
					mut argument_index := 0
					while argument_index < call_arguments.size()
						prefixed_arguments.push(call_arguments[argument_index])
						argument_index += 1
					end
					call_arguments = prefixed_arguments
				end
			end
		end
		_qbe_line(writer, call_prefix + "call " + code + "(" + call_arguments.join(", ") + ")")
	when Gate3Instruction::RuntimeCollect(origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\tcall $trbn_collect(w 0)")
	when Gate3Instruction::RuntimeStatistic(result, statistic, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		mut symbol := "$trbn_heap_bytes"
		case statistic
		when Gate3RuntimeStatistic::CollectionCount
			symbol = "$trbn_collection_count"
		when Gate3RuntimeStatistic::AutomaticCollectionCount
			symbol = "$trbn_automatic_collection_count"
		when Gate3RuntimeStatistic::CollectionNanoseconds
			symbol = "$trbn_collection_nanoseconds"
		when Gate3RuntimeStatistic::AllocatedBytes
			symbol = "$trbn_allocated_bytes"
		when Gate3RuntimeStatistic::HeapBytes
			symbol = "$trbn_heap_bytes"
		when Gate3RuntimeStatistic::ReclaimedBytes
			symbol = "$trbn_reclaimed_bytes"
		end
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =l loadl " + symbol)
	when Gate3Instruction::RecordConstruct(result, type_id, arguments, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		layout := try compute_gate3_layout(native_module.types, type_id)
		destination := context.values.fetch(result)
		mut payload := destination
		if layout.managed
			descriptor := _qbe3_type_descriptor(_qbe3_type_index(native_module.types, type_id))
			_qbe_line(
				writer,
				"\t" + destination + " =l call $trbn_alloc(l " + descriptor + ", l " + layout.size.to_s() + ", l 0)",
			)
			_qbe_line(writer, "\tstorel " + destination + ", " + context.root_slots.fetch(result))
			payload = _qbe3_address(destination, 32, prefix + "record_payload", writer)
		else
			_qbe3_emit_zero(destination, layout.size, writer)
		end
		mut index := 0
		while index < layout.fields.size()
			try _qbe3_emit_store_field(
				native_module,
				layout.fields[index],
				context.values.fetch(arguments[index]),
				payload,
				prefix + "field" + index.to_s(),
				writer,
			)
			index += 1
		end
	when Gate3Instruction::RecordProject(result, type_id, record, field, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		layout := try compute_gate3_layout(native_module.types, type_id)
		field_layout := _qbe3_required_field(layout, field)
		mut source := context.values.fetch(record)
		if layout.managed
			source = _qbe3_address(source, 32, prefix + "record_payload", writer)
		end
		try _qbe3_emit_project(
			native_module,
			field_layout,
			source,
			context.values.fetch(result),
			prefix,
			writer,
		)
	when Gate3Instruction::VariantConstruct(result, type_id, variant, arguments, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		layout := try compute_gate3_layout(native_module.types, type_id)
		variant_layout := _qbe3_required_variant(layout, variant)
		destination := context.values.fetch(result)
		mut payload := destination
		if layout.managed
			descriptor := _qbe3_type_descriptor(_qbe3_type_index(native_module.types, type_id))
			_qbe_line(
				writer,
				"\t" + destination + " =l call $trbn_alloc(l " + descriptor + ", l " + layout.size.to_s() + ", l 0)",
			)
			_qbe_line(writer, "\tstorel " + destination + ", " + context.root_slots.fetch(result))
			payload = _qbe3_address(destination, 32, prefix + "variant_payload", writer)
		else
			_qbe3_emit_zero(destination, layout.size, writer)
		end
		_qbe_line(writer, "\tstorew " + variant_layout.tag.to_s() + ", " + payload)
		mut index := 0
		while index < variant_layout.fields.size()
			try _qbe3_emit_store_field(
				native_module,
				variant_layout.fields[index],
				context.values.fetch(arguments[index]),
				payload,
				prefix + "payload" + index.to_s(),
				writer,
			)
			index += 1
		end
	when Gate3Instruction::VariantTest(result, type_id, value, variant, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		layout := try compute_gate3_layout(native_module.types, type_id)
		variant_layout := _qbe3_required_variant(layout, variant)
		tag := prefix + "tag"
		mut source := context.values.fetch(value)
		if layout.managed
			source = _qbe3_address(source, 32, prefix + "variant_payload", writer)
		end
		_qbe_line(writer, "\t" + tag + " =w loadw " + source)
		_qbe_line(writer, "\t" + context.values.fetch(result) + " =w ceqw " + tag + ", " + variant_layout.tag.to_s())
	when Gate3Instruction::VariantProject(result, type_id, value, variant, field, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		layout := try compute_gate3_layout(native_module.types, type_id)
		variant_layout := _qbe3_required_variant(layout, variant)
		mut source := context.values.fetch(value)
		if layout.managed
			source = _qbe3_address(source, 32, prefix + "variant_payload", writer)
		end
		tag := prefix + "tag"
		matches := prefix + "matches"
		ok := "@g3_" + block_index.to_s() + "_" + instruction_index.to_s() + "_project_ok"
		fail := "@g3_" + block_index.to_s() + "_" + instruction_index.to_s() + "_project_fail"
		_qbe_line(writer, "\t" + tag + " =w loadw " + source)
		_qbe_line(writer, "\t" + matches + " =w ceqw " + tag + ", " + variant_layout.tag.to_s())
		_qbe_line(writer, "\tjnz " + matches + ", " + ok + ", " + fail)
		_qbe_line(writer, fail)
		_qbe_line(writer, "\tcall $trbn_variant_projection_fail()")
		_qbe_line(writer, "\thlt")
		_qbe_line(writer, ok)
		field_layout := _qbe3_required_variant_field(variant_layout, field)
		try _qbe3_emit_project(
			native_module,
			field_layout,
			source,
			context.values.fetch(result),
			prefix,
			writer,
		)
	when Gate3Instruction::Call(result, function_id, arguments, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		if _qbe3_emit_inlined_forwarded_closure_call(
				native_module,
				function,
				result,
				function_id,
				arguments,
				block_index,
				instruction_index,
				context,
				writer,
			)
			return Result<Boolean, Diagnostic>::Ok(true)
		end
		callee_index := _qbe3_function_index(native_module.functions, function_id)
		callee := native_module.functions[callee_index]
		mut call_arguments: Array<String> := []
		case callee.result_type
		when Gate3ResultType::Void
		when Gate3ResultType::Value(value_type)
			case value_type
			when Gate3ValueType::Scalar(_scalar)
			when Gate3ValueType::Aggregate(_type_id)
				if !(try gate3_value_is_managed(native_module.types, value_type))
					call_arguments.push("l " + context.values.fetch(_qbe3_required_id(result)))
				end
			end
		end
		if _qbe3_function_uses_closure_abi(native_module, function_id)
			call_arguments.push("l 0")
		end
		mut index := 0
		while index < arguments.size()
			call_arguments.push(
				_qbe3_abi_type(callee.parameters[index].value_type) + " " + context.values.fetch(arguments[index])
			)
			index += 1
		end
		mut call_prefix := "\t"
		case callee.result_type
		when Gate3ResultType::Void
		when Gate3ResultType::Value(value_type)
			case value_type
			when Gate3ValueType::Scalar(scalar)
				call_prefix = "\t" + context.values.fetch(_qbe3_required_id(result)) + " =" + _qbe_type(scalar) + " "
			when Gate3ValueType::Aggregate(_type_id)
				if try gate3_value_is_managed(native_module.types, value_type)
					call_prefix = "\t" + context.values.fetch(_qbe3_required_id(result)) + " =l "
				end
			end
		end
		_qbe_line(writer, call_prefix + "call $trbn_g3f" + callee_index.to_s() + "(" + call_arguments.join(", ") + ")")
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_scalar(
		native_module: Gate3Module,
		instruction: Gate1Instruction,
		block_index: Integer,
		instruction_index: Integer,
		values: Hash<String, String>,
		static_data: Array<QbeStaticData>,
		mut writer: StringBuilder,
	)
	case instruction
	when Gate1Instruction::BooleanLiteral(result, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		mut literal := "0"
		if value
			literal = "1"
		end
		_qbe_line(writer, "\t" + values.fetch(result) + " =w copy " + literal)
	when Gate1Instruction::IntegerLiteral(result, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + values.fetch(result) + " =l copy " + value.to_s())
	when Gate1Instruction::FloatLiteral(result, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + values.fetch(result) + " =d copy d_" + value.to_s())
	when Gate1Instruction::IntegerBinary(result, operator, left, right, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_emit_integer_binary(
			operator,
			values.fetch(result),
			values.fetch(left),
			values.fetch(right),
			block_index,
			instruction_index,
			writer,
		)
	when Gate1Instruction::FloatBinary(result, operator, left, right, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer,
			"\t" + values.fetch(result) + " =d " + _qbe_float_operator(operator) + " " +
			values.fetch(left) + ", " + values.fetch(right)
		)
	when Gate1Instruction::IntegerCompare(result, operator, left, right, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer,
			"\t" + values.fetch(result) + " =w " + _qbe_comparison(operator, "l") + " " +
			values.fetch(left) + ", " + values.fetch(right)
		)
	when Gate1Instruction::FloatCompare(result, operator, left, right, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer,
			"\t" + values.fetch(result) + " =w " + _qbe_comparison(operator, "d") + " " +
			values.fetch(left) + ", " + values.fetch(right)
		)
	when Gate1Instruction::BooleanNot(result, value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		_qbe_line(writer, "\t" + values.fetch(result) + " =w ceqw " + values.fetch(value) + ", 0")
	when Gate1Instruction::Call(_result, _function_id, _arguments, _origin)
	when Gate1Instruction::WriteStatic(value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		symbol := _qbe_static_symbol(static_data, value)
		_qbe_line(writer,
			"\t%g3_io_" + block_index.to_s() + "_" + instruction_index.to_s() +
			" =l call $write(w 1, l " + symbol + ", l " + value.to_bytes().size().to_s() + ")"
		)
	end
	return
end

def _qbe3_emit_store_field(
		native_module: Gate3Module,
		field: Gate3FieldLayout,
		source: String,
		destination: String,
		prefix: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	address := _qbe3_address(destination, field.offset, prefix + "_address", writer)
	case field.value_type
	when Gate3ValueType::Scalar(scalar)
		_qbe_line(writer, "\t" + _qbe3_scalar_field_store(scalar) + " " + source + ", " + address)
	when Gate3ValueType::Aggregate(type_id)
		layout := try compute_gate3_layout(native_module.types, type_id)
		if layout.managed
			_qbe_line(writer, "\tstorel " + source + ", " + address)
		else
			_qbe3_emit_copy(address, source, layout.size, writer)
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_project(
		native_module: Gate3Module,
		field: Gate3FieldLayout,
		source: String,
		destination: String,
		prefix: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	address := _qbe3_address(source, field.offset, prefix + "address", writer)
	case field.value_type
	when Gate3ValueType::Scalar(scalar)
		_qbe_line(writer,
			"\t" + destination + " =" + _qbe_type(scalar) + " " + _qbe3_scalar_field_load(scalar) + " " + address
		)
	when Gate3ValueType::Aggregate(type_id)
		layout := try compute_gate3_layout(native_module.types, type_id)
		if layout.managed
			_qbe_line(writer, "\t" + destination + " =l loadl " + address)
		else
			_qbe3_emit_copy(destination, address, layout.size, writer)
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_terminator(
		native_module: Gate3Module,
		function: Gate3Function,
		terminator: Gate3Terminator,
		block_index: Integer,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	case terminator
	when Gate3Terminator::Jump(target, arguments, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		try _qbe3_emit_edge(native_module, function, target, arguments, context, writer)
		_qbe_line(writer, "\tjmp " + _qbe3_block_label(function.blocks, target))
	when Gate3Terminator::Branch(condition, when_true, true_arguments, when_false, false_arguments, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		true_edge := "@g3_edge_" + block_index.to_s() + "_true"
		false_edge := "@g3_edge_" + block_index.to_s() + "_false"
		_qbe_line(writer, "\tjnz " + context.values.fetch(condition) + ", " + true_edge + ", " + false_edge)
		_qbe_line(writer, true_edge)
		try _qbe3_emit_edge(native_module, function, when_true, true_arguments, context, writer)
		_qbe_line(writer, "\tjmp " + _qbe3_block_label(function.blocks, when_true))
		_qbe_line(writer, false_edge)
		try _qbe3_emit_edge(native_module, function, when_false, false_arguments, context, writer)
		_qbe_line(writer, "\tjmp " + _qbe3_block_label(function.blocks, when_false))
	when Gate3Terminator::Return(value, origin)
		_qbe3_emit_origin(native_module, origin, writer)
		previous_roots := "%g3_return_roots_" + block_index.to_s()
		_qbe_line(writer, "\t" + previous_roots + " =l loadl %root_frame")
		_qbe_line(writer, "\tstorel " + previous_roots + ", $trbn_roots")
		case function.result_type
		when Gate3ResultType::Void
			_qbe_line(writer, "\tret")
		when Gate3ResultType::Value(value_type)
			case value_type
			when Gate3ValueType::Scalar(_scalar)
				_qbe_line(writer, "\tret " + context.values.fetch(_qbe3_required_id(value)))
			when Gate3ValueType::Aggregate(type_id)
				layout := try compute_gate3_layout(native_module.types, type_id)
				if layout.managed
					_qbe_line(writer, "\tret " + context.values.fetch(_qbe3_required_id(value)))
				else
					_qbe3_emit_copy("%return", context.values.fetch(_qbe3_required_id(value)), layout.size, writer)
					_qbe_line(writer, "\tret")
				end
			end
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_emit_edge(
		native_module: Gate3Module,
		function: Gate3Function,
		target: String,
		arguments: Array<String>,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	block := gate3_block(function.blocks, target)
	mut index := 0
	while index < arguments.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when Gate3ValueType::Scalar(_scalar)
		when Gate3ValueType::Aggregate(type_id)
			managed := try gate3_value_is_managed(native_module.types, parameter.value_type)
			if !managed && _qbe3_parameter_uses_transfer(parameter, context)
				source := context.values.fetch(arguments[index])
				destination := context.transfer_slots.fetch(parameter.id)
				if source != destination && _qbe3_edge_source_is_destination(block, source, context)
					layout := try compute_gate3_layout(native_module.types, type_id)
					_qbe3_emit_copy(context.storage_slots.fetch(parameter.id), source, layout.size, writer)
				end
			end
		end
		index += 1
	end
	index = 0
	while index < arguments.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when Gate3ValueType::Scalar(scalar)
			if _qbe3_parameter_uses_transfer(parameter, context)
				_qbe_line(writer,
					"\t" + _qbe3_scalar_slot_store(scalar) + " " + context.values.fetch(arguments[index]) +
					", " + context.transfer_slots.fetch(parameter.id)
				)
			end
		when Gate3ValueType::Aggregate(type_id)
			if try gate3_value_is_managed(native_module.types, parameter.value_type)
				if _qbe3_parameter_uses_transfer(parameter, context)
					_qbe_line(
						writer,
						"\tstorel " + context.values.fetch(arguments[index]) + ", " +
						context.transfer_slots.fetch(parameter.id),
					)
				end
			else
				if _qbe3_parameter_uses_transfer(parameter, context)
					layout := try compute_gate3_layout(native_module.types, type_id)
					destination := context.transfer_slots.fetch(parameter.id)
					mut source := context.values.fetch(arguments[index])
					if source != destination && _qbe3_edge_source_is_destination(block, source, context)
						source = context.storage_slots.fetch(parameter.id)
					end
					if source != destination
						_qbe3_emit_copy(destination, source, layout.size, writer)
					end
				end
			end
		end
		index += 1
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_parameter_uses_transfer(parameter: Gate3Parameter, context: Gate3QbeContext): Boolean
	return !context.aliased_parameters.key?(parameter.id)
end

def _qbe3_edge_source_is_destination(
		block: Gate3Block?,
		source: String,
		context: Gate3QbeContext,
	): Boolean
	mut index := 0
	while index < block.parameters.size()
		parameter := block.parameters[index]
		case parameter.value_type
		when Gate3ValueType::Scalar(_scalar)
		when Gate3ValueType::Aggregate(_type_id)
			if _qbe3_parameter_uses_transfer(parameter, context) && context.transfer_slots.fetch(parameter.id) == source
				return true
			end
		end
		index += 1
	end
	return false
end

def _qbe3_emit_entry(native_module: Gate3Module, report_runtime: Boolean, mut writer: StringBuilder)
	entry_index := _qbe3_function_index(native_module.functions, native_module.entry_function)
	_qbe_line(writer, "export function w $main() {")
	_qbe_line(writer, "@start")
	mut arguments := ""
	if _qbe3_function_uses_closure_abi(native_module, native_module.entry_function)
		arguments = "l 0"
	end
	_qbe_line(writer, "\tcall $trbn_g3f" + entry_index.to_s() + "(" + arguments + ")")
	if report_runtime
		_qbe3_emit_runtime_report(writer)
	end
	_qbe_line(writer, "\tret 0")
	_qbe_line(writer, "}")
	return
end

def _qbe3_emit_runtime_report(mut writer: StringBuilder)
	_qbe_line(writer, "\tcall $trbn_collect(w 0)")
	_qbe3_emit_runtime_statistic_line(
		"collections",
		"$trbn_report_collections",
		"gate3-gc-stat,collections,",
		"$trbn_collection_count",
		writer,
	)
	_qbe3_emit_runtime_statistic_line(
		"automatic_collections",
		"$trbn_report_automatic_collections",
		"gate3-gc-stat,automatic-collections,",
		"$trbn_automatic_collection_count",
		writer,
	)
	_qbe3_emit_runtime_statistic_line(
		"collection_nanoseconds",
		"$trbn_report_collection_nanoseconds",
		"gate3-gc-stat,collection-nanoseconds,",
		"$trbn_collection_nanoseconds",
		writer,
	)
	_qbe3_emit_runtime_statistic_line(
		"allocated_bytes",
		"$trbn_report_allocated_bytes",
		"gate3-gc-stat,allocated-bytes,",
		"$trbn_allocated_bytes",
		writer,
	)
	_qbe3_emit_runtime_statistic_line(
		"reclaimed_bytes",
		"$trbn_report_reclaimed_bytes",
		"gate3-gc-stat,reclaimed-bytes,",
		"$trbn_reclaimed_bytes",
		writer,
	)
	_qbe3_emit_runtime_statistic_line(
		"live_bytes",
		"$trbn_report_live_bytes",
		"gate3-gc-stat,live-bytes,",
		"$trbn_heap_bytes",
		writer,
	)
	return
end

def _qbe3_emit_runtime_statistic_line(
		name: String,
		label_symbol: String,
		label: String,
		value_symbol: String,
		mut writer: StringBuilder,
	)
	value := "%report_" + name
	_qbe_line(writer, "\t" + value + " =l loadl " + value_symbol)
	_qbe_line(
		writer,
		"\tcall $trbn_report_statistic(l " + label_symbol + ", l " + label.to_bytes().size().to_s() + ", l " + value + ")",
	)
	return
end

def _qbe3_emit_origin(native_module: Gate3Module, origin: SourceOrigin, mut writer: StringBuilder)
	mut source_index := 0
	while native_module.sources[source_index].id != origin.source_id
		source_index += 1
	end
	_qbe_line(writer,
		"\t# trb-origin source=" + source_index.to_s() + " start=" + origin.start_line.to_s() + ":" +
		origin.start_column.to_s() + " end=" + origin.end_line.to_s() + ":" + origin.end_column.to_s()
	)
	return
end

def _qbe3_emit_zero(destination: String, size: Integer, mut writer: StringBuilder)
	mut offset := 0
	while size - offset >= 8
		address := _qbe3_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstorel 0, " + address)
		offset += 8
	end
	if size - offset >= 4
		address := _qbe3_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstorew 0, " + address)
		offset += 4
	end
	if size - offset >= 2
		address := _qbe3_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstoreh 0, " + address)
		offset += 2
	end
	if size - offset == 1
		address := _qbe3_address(destination, offset, destination + "_zero_" + offset.to_s(), writer)
		_qbe_line(writer, "\tstoreb 0, " + address)
	end
	return
end

def _qbe3_emit_copy(destination: String, source: String, size: Integer, mut writer: StringBuilder)
	_qbe_line(writer, "\tblit " + source + ", " + destination + ", " + size.to_s())
	return
end

def _qbe3_address(base: String, offset: Integer, name: String, mut writer: StringBuilder): String
	if offset == 0
		return base
	end
	_qbe_line(writer, "\t" + name + " =l add " + base + ", " + offset.to_s())
	return name
end

def _qbe3_abi_type(value_type: Gate3ValueType): String
	case value_type
	when Gate3ValueType::Scalar(scalar)
		return _qbe_type(scalar)
	when Gate3ValueType::Aggregate(_type_id)
		return "l"
	end
end

def _qbe3_array_element_type(native_module: Gate3Module, type_id: String): Gate3ValueType
	definition := gate3_type_definition(native_module.types, type_id)
	if definition == nil
		return Gate3ValueType::Scalar(ScalarType::Void)
	end
	case definition
	when Gate3TypeDefinition::Array(_id, element_type)
		return element_type
	else
		return Gate3ValueType::Scalar(ScalarType::Void)
	end
end

def _qbe3_function_result_type(native_module: Gate3Module, type_id: String): Gate3ValueType?
	definition := gate3_type_definition(native_module.types, type_id)
	if definition == nil
		return nil
	end
	case definition
	when Gate3TypeDefinition::Function(_id, _parameter_types, result_type)
		return result_type
	else
		return nil
	end
end

def _qbe3_function_parameter_types(native_module: Gate3Module, type_id: String): Array<Gate3ValueType>
	definition := gate3_type_definition(native_module.types, type_id)
	if definition == nil
		return []
	end
	case definition
	when Gate3TypeDefinition::Function(_id, parameter_types, _result_type)
		return parameter_types
	else
		return []
	end
end

def _qbe3_type_index(definitions: Array<Gate3TypeDefinition>, type_id: String): Integer
	mut index := 0
	while index < definitions.size()
		definition := definitions[index]
		mut candidate := ""
		case definition
		when Gate3TypeDefinition::Record(id, _fields)
			candidate = id
		when Gate3TypeDefinition::Tagged(id, _variants)
			candidate = id
		when Gate3TypeDefinition::String(id)
			candidate = id
		when Gate3TypeDefinition::Array(id, _element_type)
			candidate = id
		when Gate3TypeDefinition::Function(id, _parameter_types, _result_type)
			candidate = id
		end
		if candidate == type_id
			return index
		end
		index += 1
	end
	return 0
end

def _qbe3_emit_environment_store(
		native_module: Gate3Module,
		value_type: Gate3ValueType,
		source: String,
		destination: String,
		mut writer: StringBuilder,
	): Result<Boolean, Diagnostic>
	case value_type
	when Gate3ValueType::Scalar(scalar)
		_qbe_line(writer, "\t" + _qbe3_scalar_slot_store(scalar) + " " + source + ", " + destination)
	when Gate3ValueType::Aggregate(_type_id)
		if try gate3_value_is_managed(native_module.types, value_type)
			_qbe_line(writer, "\tstorel " + source + ", " + destination)
		else
			case value_type
			when Gate3ValueType::Aggregate(type_id)
				layout := try compute_gate3_layout(native_module.types, type_id)
				_qbe3_emit_copy(destination, source, layout.size, writer)
			else
			end
		end
	end
	return Result<Boolean, Diagnostic>::Ok(true)
end

def _qbe3_capture_storage_size(
		native_module: Gate3Module,
		value_type: Gate3ValueType,
	): Result<Integer, Diagnostic>
	case value_type
	when Gate3ValueType::Scalar(_scalar)
		return Result<Integer, Diagnostic>::Ok(8)
	when Gate3ValueType::Aggregate(type_id)
		layout := try compute_gate3_layout(native_module.types, type_id)
		if layout.managed
			return Result<Integer, Diagnostic>::Ok(8)
		end
		return Result<Integer, Diagnostic>::Ok(((layout.size + 7) / 8) * 8)
	end
end

def _qbe3_environment_payload_size(
		native_module: Gate3Module,
		function: Gate3Function,
	): Result<Integer, Diagnostic>
	mut size := 0
	mut index := 0
	while index < function.captures.size()
		size += try _qbe3_capture_storage_size(native_module, function.captures[index].value_type)
		index += 1
	end
	return Result<Integer, Diagnostic>::Ok(size)
end

def _qbe3_scalar_field_load(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "loadub"
	end
	if value_type == ScalarType::Float
		return "loadd"
	end
	return "loadl"
end

def _qbe3_scalar_field_store(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "storeb"
	end
	if value_type == ScalarType::Float
		return "stored"
	end
	return "storel"
end

def _qbe3_scalar_slot_load(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "loadw"
	end
	return _qbe3_scalar_field_load(value_type)
end

def _qbe3_scalar_slot_store(value_type: ScalarType): String
	if value_type == ScalarType::Boolean
		return "storew"
	end
	return _qbe3_scalar_field_store(value_type)
end

def _qbe3_function_index(functions: Array<Gate3Function>, id: String): Integer
	mut index := 0
	while functions[index].id != id
		index += 1
	end
	return index
end

def _qbe3_function_uses_closure_abi(native_module: Gate3Module, function_id: String): Boolean
	function := gate3_function(native_module.functions, function_id)
	if !function.captures.empty?()
		return true
	end
	mut function_index := 0
	while function_index < native_module.functions.size()
		candidate := native_module.functions[function_index]
		mut block_index := 0
		while block_index < candidate.blocks.size()
			block := candidate.blocks[block_index]
			mut instruction_index := 0
			while instruction_index < block.instructions.size()
				case block.instructions[instruction_index]
				when Gate3Instruction::ClosureConstruct(_result, _type_id, target_id, _captures, _origin)
					if target_id == function_id
						return true
					end
				else
				end
				instruction_index += 1
			end
			block_index += 1
		end
		function_index += 1
	end
	return false
end

def _qbe3_emit_inlined_forwarded_closure_call(
		native_module: Gate3Module,
		function: Gate3Function,
		result: String?,
		function_id: String,
		arguments: Array<String>,
		block_index: Integer,
		instruction_index: Integer,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	): Boolean
	callee := native_module.functions[_qbe3_function_index(native_module.functions, function_id)]
	if !callee.captures.empty?() || callee.blocks.size() != 1
		return false
	end
	block := callee.blocks[0]
	if block.id != callee.entry || !block.parameters.empty?() || block.instructions.size() != 1
		return false
	end
	case block.instructions[0]
	when Gate3Instruction::ClosureCall(inner_result, _type_id, closure, inner_arguments, _origin)
		case block.terminator
		when Gate3Terminator::Return(returned, _return_origin)
			if !_qbe3_optional_ids_equal(returned, inner_result)
				return false
			end
		else
			return false
		end
		closure_index := _qbe3_parameter_index(callee.parameters, closure)
		if closure_index < 0
			return false
		end
		mut forwarded_arguments: Array<String> := []
		mut index := 0
		while index < inner_arguments.size()
			parameter_index := _qbe3_parameter_index(callee.parameters, inner_arguments[index])
			if parameter_index < 0
				return false
			end
			forwarded_arguments.push(arguments[parameter_index])
			index += 1
		end
		return _qbe3_emit_inlined_closure_call(
			native_module,
			function,
			result,
			arguments[closure_index],
			forwarded_arguments,
			block_index,
			instruction_index,
			context,
			writer,
		)
	else
		return false
	end
end

def _qbe3_emit_inlined_closure_call(
		native_module: Gate3Module,
		function: Gate3Function,
		result: String?,
		closure: String,
		arguments: Array<String>,
		block_index: Integer,
		instruction_index: Integer,
		context: Gate3QbeContext,
		mut writer: StringBuilder,
	): Boolean
	known := _qbe3_known_closure(function, closure, context)
	if known == nil
		return false
	end
	if result == nil
		return false
	end
	callee := native_module.functions[_qbe3_function_index(native_module.functions, known.function_id)]
	if callee.blocks.size() != 1
		return false
	end
	block := callee.blocks[0]
	if block.id != callee.entry || !block.parameters.empty?()
		return false
	end
	case callee.result_type
	when Gate3ResultType::Void
		return false
	when Gate3ResultType::Value(value_type)
		case value_type
		when Gate3ValueType::Aggregate(_type_id)
			return false
		when Gate3ValueType::Scalar(scalar)
			case block.terminator
			when Gate3Terminator::Return(returned, _return_origin)
				if returned == nil
					return false
				end
				if block.instructions.empty?()
					source := _qbe3_inline_operand(callee, known, arguments, returned, context)
					if source.empty?()
						return false
					end
					_qbe_line(
						writer,
						"\t" + context.values.fetch(result) + " =" + _qbe_type(scalar) + " copy " + source,
					)
					return true
				end
				if block.instructions.size() != 1
					return false
				end
				case block.instructions[0]
				when Gate3Instruction::Scalar(scalar_instruction)
					case scalar_instruction
					when Gate1Instruction::IntegerBinary(inner_result, operator, left, right, _origin)
						if scalar != ScalarType::Integer || returned != inner_result
							return false
						end
						left_value := _qbe3_inline_operand(callee, known, arguments, left, context)
						right_value := _qbe3_inline_operand(callee, known, arguments, right, context)
						if left_value.empty?() || right_value.empty?()
							return false
						end
						_qbe_emit_integer_binary(
							operator,
							context.values.fetch(result),
							left_value,
							right_value,
							block_index,
							instruction_index,
							writer,
						)
						return true
					else
						return false
					end
				else
					return false
				end
			else
				return false
			end
		end
	end
end

def _qbe3_known_closure(
		function: Gate3Function,
		closure: String,
		context: Gate3QbeContext,
	): Gate3KnownClosure?
	value := context.values.fetch(closure)
	mut block_index := 0
	while block_index < function.blocks.size()
		block := function.blocks[block_index]
		mut instruction_index := 0
		while instruction_index < block.instructions.size()
			case block.instructions[instruction_index]
			when Gate3Instruction::ClosureConstruct(result, _type_id, function_id, captures, _origin)
				if context.values.fetch(result) == value
					return Gate3KnownClosure.new(function_id: function_id, captures: captures)
				end
			else
			end
			instruction_index += 1
		end
		block_index += 1
	end
	return nil
end

def _qbe3_inline_operand(
		callee: Gate3Function,
		known: Gate3KnownClosure,
		arguments: Array<String>,
		operand: String,
		context: Gate3QbeContext,
	): String
	mut index := 0
	while index < callee.captures.size()
		if callee.captures[index].id == operand
			return context.values.fetch(known.captures[index])
		end
		index += 1
	end
	index = 0
	while index < callee.parameters.size()
		if callee.parameters[index].id == operand
			return context.values.fetch(arguments[index])
		end
		index += 1
	end
	return ""
end

def _qbe3_parameter_index(parameters: Array<Gate3Parameter>, id: String): Integer
	mut index := 0
	while index < parameters.size()
		if parameters[index].id == id
			return index
		end
		index += 1
	end
	return - 1
end

def _qbe3_optional_ids_equal(left: String?, right: String?): Boolean
	if left == nil
		return right == nil
	end
	if right == nil
		return false
	end
	return left == right
end

def _qbe3_block_label(blocks: Array<Gate3Block>, id: String): String
	return "@b" + _qbe3_block_index(blocks, id).to_s()
end

def _qbe3_block_index(blocks: Array<Gate3Block>, id: String): Integer
	mut index := 0
	while blocks[index].id != id
		index += 1
	end
	return index
end

def _qbe3_required_id(value: String?): String
	if value == nil
		return ""
	end
	return value
end

def _qbe3_required_field(layout: Gate3Layout, name: String): Gate3FieldLayout
	mut index := 0
	while layout.fields[index].name != name
		index += 1
	end
	return layout.fields[index]
end

def _qbe3_required_variant(layout: Gate3Layout, name: String): Gate3VariantLayout
	mut index := 0
	while layout.variants[index].name != name
		index += 1
	end
	return layout.variants[index]
end

def _qbe3_required_variant_field(variant: Gate3VariantLayout, name: String): Gate3FieldLayout
	mut index := 0
	while variant.fields[index].name != name
		index += 1
	end
	return variant.fields[index]
end
