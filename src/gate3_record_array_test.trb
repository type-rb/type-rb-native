import { ComparisonOperator, Gate1Instruction, ScalarType } from gate1_mir
import { Gate3Field, Gate3TypeDefinition, Gate3ValueType } from gate3_layout
import { Gate3Block, Gate3Function, Gate3Instruction, Gate3Module, Gate3Parameter, Gate3ResultType, Gate3Terminator, verify_gate3_mir } from gate3_mir
import { build_gate3_executable } from gate3_toolchain
import { NativeSource } from native_mir
import { SourceOrigin } from snapshot
import { native_create_directory } from native_file_system
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

def _gate3_record_array_module(extra: Array<Gate3Instruction>): Gate3Module
	origin := SourceOrigin.new(source_id: "main", start_line: 1, start_column: 1, end_line: 1, end_column: 8)
	mut instructions := [
		Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("zero", 0, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("last", - 1, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("first_id", 42, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("second_id", 9, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::BooleanLiteral("yes", true, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::BooleanLiteral("no", false, origin)),
		Gate3Instruction::Call("messages", "records#make_messages", [], origin),
		Gate3Instruction::Call("first", "records#make", ["yes", "first_id"], origin),
		Gate3Instruction::Call("second", "records#make", ["no", "second_id"], origin),
		Gate3Instruction::ArrayConstruct("groups", "Array<Array<Row>>", ["first", "second"], origin),
		Gate3Instruction::RuntimeCollect(origin),
		Gate3Instruction::ArrayGet("selected", "Array<Array<Row>>", "groups", "zero", origin),
		Gate3Instruction::ArrayGet("retained", "Array<Row>", "selected", "zero", origin),
		Gate3Instruction::ArrayGet("replacement", "Array<Row>", "second", "zero", origin),
		Gate3Instruction::ArrayPush("Array<Row>", "selected", "replacement", origin),
		Gate3Instruction::ArraySet("Array<Row>", "selected", "last", "retained", origin),
		Gate3Instruction::RuntimeCollect(origin),
		Gate3Instruction::ArrayGet("actual", "Array<Row>", "first", "last", origin),
		Gate3Instruction::RecordProject("flag", "records#Row", "actual", "valid", origin),
		Gate3Instruction::RecordProject("row_id", "records#Row", "actual", "id", origin),
		Gate3Instruction::RecordConstruct("other", "records#Other", ["first_id", "yes"], origin),
		Gate3Instruction::ArrayGet("message", "Array<Message>", "messages", "zero", origin),
		Gate3Instruction::RecordProject("text", "records#Message", "message", "text", origin),
		Gate3Instruction::WriteString("text", true, origin),
		Gate3Instruction::RecordProject("numbers", "records#Message", "message", "numbers", origin),
		Gate3Instruction::ArrayGet("number", "Array<Integer>", "numbers", "zero", origin),
		Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("expected", 42, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::IntegerCompare("row_ok", ComparisonOperator::Equal, "row_id", "expected", origin)),
		Gate3Instruction::Scalar(Gate1Instruction::IntegerCompare("number_ok", ComparisonOperator::Equal, "number", "expected", origin)),
	]
	mut index := 0
	while index < extra.size()
		instructions.push(extra[index])
		index += 1
	end
	return Gate3Module.new(
		id: "record-array", entry_function: "records#main",
		sources: [NativeSource.new(id: "main", path: "src/main.trb")],
		types: [
			Gate3TypeDefinition::String("String"),
			Gate3TypeDefinition::Array("Array<Integer>", Gate3ValueType::Scalar(ScalarType::Integer)),
			Gate3TypeDefinition::Record("records#Message", [
					Gate3Field.new(name: "text", value_type: Gate3ValueType::Aggregate("String")),
					Gate3Field.new(name: "numbers", value_type: Gate3ValueType::Aggregate("Array<Integer>")),
				]),
			Gate3TypeDefinition::Array("Array<Message>", Gate3ValueType::Aggregate("records#Message")),
			Gate3TypeDefinition::Record("records#Row", [Gate3Field.new(name: "id", value_type: Gate3ValueType::Scalar(ScalarType::Integer)), Gate3Field.new(name: "valid", value_type: Gate3ValueType::Scalar(ScalarType::Boolean))]),
			Gate3TypeDefinition::Record("records#Other", [Gate3Field.new(name: "id", value_type: Gate3ValueType::Scalar(ScalarType::Integer)), Gate3Field.new(name: "valid", value_type: Gate3ValueType::Scalar(ScalarType::Boolean))]),
			Gate3TypeDefinition::Array("Array<Row>", Gate3ValueType::Aggregate("records#Row")),
			Gate3TypeDefinition::Array("Array<Other>", Gate3ValueType::Aggregate("records#Other")),
			Gate3TypeDefinition::Array("Array<Array<Row>>", Gate3ValueType::Aggregate("Array<Row>")),
		],
		functions: [
			Gate3Function.new(
				id: "records#make_messages", name: "make_messages", parameters: [],
				result_type: Gate3ResultType::Value(Gate3ValueType::Aggregate("Array<Message>")), entry: "entry", origin: origin,
				blocks: [Gate3Block.new(
						id: "entry", parameters: [], origin: origin,
						instructions: [
							Gate3Instruction::StringLiteral("prefix", "managed", origin),
							Gate3Instruction::StringLiteral("suffix", "-record", origin),
							Gate3Instruction::StringConcat("text", "prefix", "suffix", origin),
							Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("number", 42, origin)),
							Gate3Instruction::ArrayConstruct("numbers", "Array<Integer>", ["number"], origin),
							Gate3Instruction::RecordConstruct("message", "records#Message", ["text", "numbers"], origin),
							Gate3Instruction::ArrayConstruct("messages", "Array<Message>", ["message"], origin),
						],
						terminator: Gate3Terminator::Return("messages", origin),
					)],
			),
			Gate3Function.new(
				id: "records#make", name: "make",
				parameters: [Gate3Parameter.new(id: "valid", value_type: Gate3ValueType::Scalar(ScalarType::Boolean), origin: origin), Gate3Parameter.new(id: "id", value_type: Gate3ValueType::Scalar(ScalarType::Integer), origin: origin)],
				result_type: Gate3ResultType::Value(Gate3ValueType::Aggregate("Array<Row>")), entry: "entry", origin: origin,
				blocks: [Gate3Block.new(
						id: "entry", parameters: [], origin: origin,
						instructions: [
							Gate3Instruction::RecordConstruct("row", "records#Row", ["id", "valid"], origin),
							Gate3Instruction::ArrayConstruct("rows", "Array<Row>", ["row"], origin),
							Gate3Instruction::RuntimeCollect(origin),
						],
						terminator: Gate3Terminator::Return("rows", origin),
					)],
			),
			Gate3Function.new(
				id: "records#main", name: "main", parameters: [],
				result_type: Gate3ResultType::Void, entry: "entry", origin: origin,
				blocks: [
					Gate3Block.new(
						id: "entry", parameters: [], origin: origin, instructions: instructions,
						terminator: Gate3Terminator::Branch("flag", "check_row", ["row_ok", "number_ok"], "failure", [], origin),
					),
					Gate3Block.new(
						id: "check_row", parameters: [Gate3Parameter.new(id: "row_matches", value_type: Gate3ValueType::Scalar(ScalarType::Boolean), origin: origin), Gate3Parameter.new(id: "number_matches", value_type: Gate3ValueType::Scalar(ScalarType::Boolean), origin: origin)], origin: origin, instructions: [],
						terminator: Gate3Terminator::Branch("row_matches", "check_number", ["number_matches"], "failure", [], origin),
					),
					Gate3Block.new(
						id: "check_number", parameters: [Gate3Parameter.new(id: "matches", value_type: Gate3ValueType::Scalar(ScalarType::Boolean), origin: origin)], origin: origin, instructions: [],
						terminator: Gate3Terminator::Branch("matches", "success", [], "failure", [], origin),
					),
					Gate3Block.new(
						id: "success", parameters: [], origin: origin,
						instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("record-array-ok\n", origin))],
						terminator: Gate3Terminator::Return(nil, origin),
					),
					Gate3Block.new(
						id: "failure", parameters: [], origin: origin,
						instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("record-array-fail\n", origin))],
						terminator: Gate3Terminator::Return(nil, origin),
					),
				],
			),
		],
	)
end

describe("Gate 3 record Array recovery") do
	test("rejects scalar and nominal element mismatches, wrong indices and receivers") do
		origin := SourceOrigin.new(source_id: "main", start_line: 1, start_column: 1, end_line: 1, end_column: 8)
		invalid := [
			Gate3Instruction::ArrayConstruct("wrong", "Array<Row>", ["zero"], origin),
			Gate3Instruction::ArrayConstruct("wrong", "Array<Row>", ["other"], origin),
			Gate3Instruction::ArrayPush("Array<Row>", "first", "other", origin),
			Gate3Instruction::ArraySet("Array<Row>", "first", "zero", "other", origin),
			Gate3Instruction::ArrayGet("wrong", "Array<Row>", "first", "yes", origin),
			Gate3Instruction::ArrayGet("wrong", "Array<Other>", "first", "zero", origin),
			Gate3Instruction::ArrayPush("Array<Other>", "first", "other", origin),
		]
		mut index := 0
		while index < invalid.size()
			case verify_gate3_mir(_gate3_record_array_module([invalid[index]]))
			when Result::Ok(_value)
				expect(false).to_be_true()
			when Result::Err(diagnostic)
				expect(diagnostic.code).to_equal("TRBN0004")
				expect(diagnostic.message).to_equal("operand type does not match the operation")
			end
			index += 1
		end
	end

	test("retains returned scalar records through calls, nested aliases, mutation and collection") do
		native_module := _gate3_record_array_module([])
		case verify_gate3_mir(native_module)
		when Result::Ok(_value)
		when Result::Err(diagnostic)
			puts(diagnostic.path + ": " + diagnostic.message)
			expect(false).to_be_true()
		end
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			workspace := "/tmp/type-rb-native-gate3-record-array"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case build_gate3_executable(native_module, qbe, "/usr/bin/cc", workspace, workspace + "/sample")
			when Result::Ok(report)
				case Process.run(report.output_path, [])
				when Result::Ok(process)
					expect(process.success).to_be_true()
					expect(process.stdout).to_equal("managed-record\nrecord-array-ok\n")
					expect(process.stderr).to_equal("")
				when Result::Err(_error)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.phase + ": " + error.message + " " + error.stderr)
				expect(false).to_be_true()
			end
		end
	end
end
