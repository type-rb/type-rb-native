import { qbe_line } from qbe

def emit_gate3_runtime(mut writer: StringBuilder)
	_gate3_runtime_bytes(writer, "$trbn_allocation_error", "panic: allocation failed\n")
	_gate3_runtime_bytes(writer, "$trbn_index_error", "panic: index out of bounds\n")
	_gate3_runtime_bytes(writer, "$trbn_newline", "\n")
	qbe_line(writer, "data $trbn_heap = align 8 { l 0 }")
	qbe_line(writer, "data $trbn_roots = align 8 { l 0 }")
	qbe_line(writer, "data $trbn_heap_bytes = align 8 { l 0 }")
	qbe_line(writer, "data $trbn_heap_target = align 8 { l 1048576 }")
	qbe_line(writer, "data $trbn_collection_count = align 8 { l 0 }")
	qbe_line(writer, "data $trbn_reclaimed_bytes = align 8 { l 0 }")
	qbe_line(writer, "data $trbn_desc_string = align 8 { l 0 }")
	qbe_line(writer, "data $trbn_desc_closure = align 8 { l 1, l 1, l 40 }")
	qbe_line(writer, "")
	lines := _gate3_runtime_lines()
	mut index := 0
	while index < lines.size()
		qbe_line(writer, lines[index])
		index += 1
	end
	return
end

def _gate3_runtime_bytes(mut writer: StringBuilder, symbol: String, value: String)
	bytes := value.to_bytes()
	mut values: Array<String> := []
	mut index := 0
	while index < bytes.size()
		values.push(bytes.at(index).to_s())
		index += 1
	end
	qbe_line(writer, "data " + symbol + " = { b " + values.join(" ") + " }")
	return
end

def _gate3_runtime_lines(): Array<String>
	return [
		"function $trbn_allocation_fail() {",
		"@start",
		"\tcall $write(w 2, l $trbn_allocation_error, l 25)",
		"\tcall $exit(w 2)",
		"\thlt",
		"}",
		"",
		"function $trbn_index_fail() {",
		"@start",
		"\tcall $write(w 2, l $trbn_index_error, l 27)",
		"\tcall $exit(w 2)",
		"\thlt",
		"}",
		"",
		"function l $trbn_alloc(l %descriptor, l %payload_size) {",
		"@start",
		"\t%total =l add %payload_size, 32",
		"\t%before =l loadl $trbn_heap_bytes",
		"\t%projected =l add %before, %total",
		"\t%target =l loadl $trbn_heap_target",
		"\t%over =w csgtl %projected, %target",
		"\tjnz %over, @collect, @allocate",
		"@collect",
		"\tcall $trbn_collect()",
		"\tjmp @allocate",
		"@allocate",
		"\t%object =l call $malloc(l %total)",
		"\t%failed =w ceql %object, 0",
		"\tjnz %failed, @fail, @initialize",
		"@fail",
		"\tcall $trbn_allocation_fail()",
		"\thlt",
		"@initialize",
		"\t%head =l loadl $trbn_heap",
		"\tstorel %head, %object",
		"\t%descriptor_slot =l add %object, 8",
		"\tstorel %descriptor, %descriptor_slot",
		"\t%size_slot =l add %object, 16",
		"\tstorel %total, %size_slot",
		"\t%mark_slot =l add %object, 24",
		"\tstorel 0, %mark_slot",
		"\t%payload =l add %object, 32",
		"\tcall $memset(l %payload, w 0, l %payload_size)",
		"\t%current_bytes =l loadl $trbn_heap_bytes",
		"\t%updated_bytes =l add %current_bytes, %total",
		"\tstorel %updated_bytes, $trbn_heap_bytes",
		"\tstorel %object, $trbn_heap",
		"\tret %object",
		"}",
		"",
		"function $trbn_scan_fixed(l %object, l %layout) {",
		"@start",
		"\t%index_slot =l alloc8 8",
		"\tstorel 0, %index_slot",
		"\t%count =l loadl %layout",
		"\tjmp @loop",
		"@loop",
		"\t%index =l loadl %index_slot",
		"\t%done =w cslel %count, %index",
		"\tjnz %done, @finish, @visit",
		"@visit",
		"\t%scaled =l mul %index, 8",
		"\t%offset_address =l add %layout, 8",
		"\t%entry =l add %offset_address, %scaled",
		"\t%offset =l loadl %entry",
		"\t%field_address =l add %object, %offset",
		"\t%reference =l loadl %field_address",
		"\tcall $trbn_mark(l %reference)",
		"\t%next =l add %index, 1",
		"\tstorel %next, %index_slot",
		"\tjmp @loop",
		"@finish",
		"\tret",
		"}",
		"",
		"function $trbn_scan_array(l %object, l %descriptor) {",
		"@start",
		"\t%managed_address =l add %descriptor, 8",
		"\t%managed =l loadl %managed_address",
		"\t%skip =w ceql %managed, 0",
		"\tjnz %skip, @finish, @prepare",
		"@prepare",
		"\t%length_address =l add %object, 32",
		"\t%length =l loadl %length_address",
		"\t%backing_address =l add %object, 64",
		"\t%backing =l loadl %backing_address",
		"\t%index_slot =l alloc8 8",
		"\tstorel 0, %index_slot",
		"\tjmp @loop",
		"@loop",
		"\t%index =l loadl %index_slot",
		"\t%done =w cslel %length, %index",
		"\tjnz %done, @finish, @visit",
		"@visit",
		"\t%scaled =l mul %index, 8",
		"\t%entry =l add %backing, %scaled",
		"\t%reference =l loadl %entry",
		"\tcall $trbn_mark(l %reference)",
		"\t%next =l add %index, 1",
		"\tstorel %next, %index_slot",
		"\tjmp @loop",
		"@finish",
		"\tret",
		"}",
		"",
		"function $trbn_mark(l %object) {",
		"@start",
		"\t%nil =w ceql %object, 0",
		"\tjnz %nil, @finish, @check_mark",
		"@check_mark",
		"\t%mark_address =l add %object, 24",
		"\t%mark =l loadl %mark_address",
		"\t%seen =w cnel %mark, 0",
		"\tjnz %seen, @finish, @dispatch",
		"@dispatch",
		"\tstorel 1, %mark_address",
		"\t%descriptor_address =l add %object, 8",
		"\t%descriptor =l loadl %descriptor_address",
		"\t%kind =l loadl %descriptor",
		"\t%fixed =w ceql %kind, 1",
		"\tjnz %fixed, @fixed, @check_array",
		"@fixed",
		"\t%layout =l add %descriptor, 8",
		"\tcall $trbn_scan_fixed(l %object, l %layout)",
		"\tret",
		"@check_array",
		"\t%array =w ceql %kind, 2",
		"\tjnz %array, @array, @check_tagged",
		"@array",
		"\tcall $trbn_scan_array(l %object, l %descriptor)",
		"\tret",
		"@check_tagged",
		"\t%tagged =w ceql %kind, 3",
		"\tjnz %tagged, @tagged, @finish",
		"@tagged",
		"\t%count_address =l add %descriptor, 8",
		"\t%variant_count =l loadl %count_address",
		"\t%tag_address =l add %object, 32",
		"\t%tag =w loadw %tag_address",
		"\t%valid =w cultw %tag, %variant_count",
		"\tjnz %valid, @tag_valid, @finish",
		"@tag_valid",
		"\t%table_address =l add %descriptor, 16",
		"\t%table =l loadl %table_address",
		"\t%tag_long =l extuw %tag",
		"\t%scaled =l mul %tag_long, 8",
		"\t%entry =l add %table, %scaled",
		"\t%variant_layout =l loadl %entry",
		"\tcall $trbn_scan_fixed(l %object, l %variant_layout)",
		"@finish",
		"\tret",
		"}",
		"",
		"function $trbn_mark_roots() {",
		"@start",
		"\t%frame_slot =l alloc8 8",
		"\t%index_slot =l alloc8 8",
		"\t%head =l loadl $trbn_roots",
		"\tstorel %head, %frame_slot",
		"\tjmp @frame_loop",
		"@frame_loop",
		"\t%frame =l loadl %frame_slot",
		"\t%done =w ceql %frame, 0",
		"\tjnz %done, @finish, @frame",
		"@frame",
		"\tstorel 0, %index_slot",
		"\t%count_address =l add %frame, 8",
		"\t%count =l loadl %count_address",
		"\tjmp @root_loop",
		"@root_loop",
		"\t%index =l loadl %index_slot",
		"\t%roots_done =w cslel %count, %index",
		"\tjnz %roots_done, @next_frame, @root",
		"@root",
		"\t%scaled =l mul %index, 8",
		"\t%slots =l add %frame, 16",
		"\t%slot =l add %slots, %scaled",
		"\t%reference =l loadl %slot",
		"\tcall $trbn_mark(l %reference)",
		"\t%next_index =l add %index, 1",
		"\tstorel %next_index, %index_slot",
		"\tjmp @root_loop",
		"@next_frame",
		"\t%previous =l loadl %frame",
		"\tstorel %previous, %frame_slot",
		"\tjmp @frame_loop",
		"@finish",
		"\tret",
		"}",
		"",
		"function $trbn_sweep() {",
		"@start",
		"\t%current_slot =l alloc8 8",
		"\t%previous_slot =l alloc8 8",
		"\t%head =l loadl $trbn_heap",
		"\tstorel %head, %current_slot",
		"\tstorel 0, %previous_slot",
		"\tjmp @loop",
		"@loop",
		"\t%current =l loadl %current_slot",
		"\t%done =w ceql %current, 0",
		"\tjnz %done, @finish, @object",
		"@object",
		"\t%next =l loadl %current",
		"\t%mark_address =l add %current, 24",
		"\t%mark =l loadl %mark_address",
		"\t%live =w cnel %mark, 0",
		"\tjnz %live, @keep, @release",
		"@keep",
		"\tstorel 0, %mark_address",
		"\tstorel %current, %previous_slot",
		"\tstorel %next, %current_slot",
		"\tjmp @loop",
		"@release",
		"\t%descriptor_address =l add %current, 8",
		"\t%descriptor =l loadl %descriptor_address",
		"\t%kind =l loadl %descriptor",
		"\t%array =w ceql %kind, 2",
		"\tjnz %array, @release_array, @unlink",
		"@release_array",
		"\t%backing_address =l add %current, 64",
		"\t%backing =l loadl %backing_address",
		"\t%has_backing =w cnel %backing, 0",
		"\tjnz %has_backing, @free_backing, @unlink",
		"@free_backing",
		"\tcall $free(l %backing)",
		"\tjmp @unlink",
		"@unlink",
		"\t%previous =l loadl %previous_slot",
		"\t%at_head =w ceql %previous, 0",
		"\tjnz %at_head, @unlink_head, @unlink_after",
		"@unlink_head",
		"\tstorel %next, $trbn_heap",
		"\tjmp @account",
		"@unlink_after",
		"\tstorel %next, %previous",
		"\tjmp @account",
		"@account",
		"\t%size_address =l add %current, 16",
		"\t%size =l loadl %size_address",
		"\t%bytes =l loadl $trbn_heap_bytes",
		"\t%remaining =l sub %bytes, %size",
		"\tstorel %remaining, $trbn_heap_bytes",
		"\t%reclaimed =l loadl $trbn_reclaimed_bytes",
		"\t%new_reclaimed =l add %reclaimed, %size",
		"\tstorel %new_reclaimed, $trbn_reclaimed_bytes",
		"\tcall $free(l %current)",
		"\tstorel %next, %current_slot",
		"\tjmp @loop",
		"@finish",
		"\tret",
		"}",
		"",
		"function $trbn_collect() {",
		"@start",
		"\tcall $trbn_mark_roots()",
		"\tcall $trbn_sweep()",
		"\t%count =l loadl $trbn_collection_count",
		"\t%next_count =l add %count, 1",
		"\tstorel %next_count, $trbn_collection_count",
		"\t%live =l loadl $trbn_heap_bytes",
		"\t%doubled =l mul %live, 2",
		"\t%candidate =l add %doubled, 65536",
		"\t%small =w csltl %candidate, 1048576",
		"\tjnz %small, @minimum, @candidate",
		"@minimum",
		"\tstorel 1048576, $trbn_heap_target",
		"\tret",
		"@candidate",
		"\tstorel %candidate, $trbn_heap_target",
		"\tret",
		"}",
		"",
		"function l $trbn_string_new(l %bytes, l %byte_length, l %codepoint_length) {",
		"@start",
		"\t%payload_size =l add %byte_length, 16",
		"\t%object =l call $trbn_alloc(l $trbn_desc_string, l %payload_size)",
		"\t%byte_length_address =l add %object, 32",
		"\tstorel %byte_length, %byte_length_address",
		"\t%codepoint_length_address =l add %object, 40",
		"\tstorel %codepoint_length, %codepoint_length_address",
		"\t%destination =l add %object, 48",
		"\tcall $memcpy(l %destination, l %bytes, l %byte_length)",
		"\tret %object",
		"}",
		"",
		"function l $trbn_string_concat(l %left, l %right) {",
		"@start",
		"\t%left_bytes_address =l add %left, 32",
		"\t%left_bytes =l loadl %left_bytes_address",
		"\t%right_bytes_address =l add %right, 32",
		"\t%right_bytes =l loadl %right_bytes_address",
		"\t%total_bytes =l add %left_bytes, %right_bytes",
		"\t%left_codepoints_address =l add %left, 40",
		"\t%left_codepoints =l loadl %left_codepoints_address",
		"\t%right_codepoints_address =l add %right, 40",
		"\t%right_codepoints =l loadl %right_codepoints_address",
		"\t%total_codepoints =l add %left_codepoints, %right_codepoints",
		"\t%payload_size =l add %total_bytes, 16",
		"\t%object =l call $trbn_alloc(l $trbn_desc_string, l %payload_size)",
		"\t%byte_length_address =l add %object, 32",
		"\tstorel %total_bytes, %byte_length_address",
		"\t%codepoint_length_address =l add %object, 40",
		"\tstorel %total_codepoints, %codepoint_length_address",
		"\t%destination =l add %object, 48",
		"\t%left_source =l add %left, 48",
		"\tcall $memcpy(l %destination, l %left_source, l %left_bytes)",
		"\t%right_destination =l add %destination, %left_bytes",
		"\t%right_source =l add %right, 48",
		"\tcall $memcpy(l %right_destination, l %right_source, l %right_bytes)",
		"\tret %object",
		"}",
		"",
		"function w $trbn_string_equal(l %left, l %right) {",
		"@start",
		"\t%left_length_address =l add %left, 32",
		"\t%left_length =l loadl %left_length_address",
		"\t%right_length_address =l add %right, 32",
		"\t%right_length =l loadl %right_length_address",
		"\t%same_length =w ceql %left_length, %right_length",
		"\tjnz %same_length, @compare, @different",
		"@different",
		"\tret 0",
		"@compare",
		"\t%left_bytes =l add %left, 48",
		"\t%right_bytes =l add %right, 48",
		"\t%comparison =w call $memcmp(l %left_bytes, l %right_bytes, l %left_length)",
		"\t%equal =w ceqw %comparison, 0",
		"\tret %equal",
		"}",
		"",
		"function l $trbn_normalize_index(l %length, l %index) {",
		"@start",
		"\t%negative =w csltl %index, 0",
		"\tjnz %negative, @negative, @check",
		"@negative",
		"\t%adjusted =l add %length, %index",
		"\tjmp @check_adjusted",
		"@check_adjusted",
		"\t%too_low =w csltl %adjusted, 0",
		"\t%too_high =w csgel %adjusted, %length",
		"\t%invalid =w or %too_low, %too_high",
		"\tjnz %invalid, @fail, @adjusted_ok",
		"@adjusted_ok",
		"\tret %adjusted",
		"@check",
		"\t%too_high_direct =w csgel %index, %length",
		"\tjnz %too_high_direct, @fail, @direct_ok",
		"@direct_ok",
		"\tret %index",
		"@fail",
		"\tcall $trbn_index_fail()",
		"\thlt",
		"}",
		"",
		"function l $trbn_utf8_width(l %address) {",
		"@start",
		"\t%byte =w loadub %address",
		"\t%ascii =w cultw %byte, 128",
		"\tjnz %ascii, @one, @check_two",
		"@check_two",
		"\t%two =w cultw %byte, 224",
		"\tjnz %two, @two, @check_three",
		"@check_three",
		"\t%three =w cultw %byte, 240",
		"\tjnz %three, @three, @four",
		"@one",
		"\tret 1",
		"@two",
		"\tret 2",
		"@three",
		"\tret 3",
		"@four",
		"\tret 4",
		"}",
		"",
		"function l $trbn_string_index(l %string, l %index) {",
		"@start",
		"\t%length_address =l add %string, 40",
		"\t%length =l loadl %length_address",
		"\t%actual =l call $trbn_normalize_index(l %length, l %index)",
		"\t%offset_slot =l alloc8 8",
		"\t%position_slot =l alloc8 8",
		"\tstorel 0, %offset_slot",
		"\tstorel 0, %position_slot",
		"\t%bytes =l add %string, 48",
		"\tjmp @loop",
		"@loop",
		"\t%position =l loadl %position_slot",
		"\t%found =w ceql %position, %actual",
		"\tjnz %found, @found, @advance",
		"@advance",
		"\t%offset =l loadl %offset_slot",
		"\t%address =l add %bytes, %offset",
		"\t%width =l call $trbn_utf8_width(l %address)",
		"\t%next_offset =l add %offset, %width",
		"\tstorel %next_offset, %offset_slot",
		"\t%next_position =l add %position, 1",
		"\tstorel %next_position, %position_slot",
		"\tjmp @loop",
		"@found",
		"\t%final_offset =l loadl %offset_slot",
		"\t%source =l add %bytes, %final_offset",
		"\t%final_width =l call $trbn_utf8_width(l %source)",
		"\t%object =l call $trbn_string_new(l %source, l %final_width, l 1)",
		"\tret %object",
		"}",
		"",
		"function $trbn_write_string(l %string, w %newline) {",
		"@start",
		"\t%length_address =l add %string, 32",
		"\t%length =l loadl %length_address",
		"\t%bytes =l add %string, 48",
		"\tcall $write(w 1, l %bytes, l %length)",
		"\tjnz %newline, @newline, @finish",
		"@newline",
		"\tcall $write(w 1, l $trbn_newline, l 1)",
		"@finish",
		"\tret",
		"}",
		"",
		"function l $trbn_array_new(l %descriptor, l %length) {",
		"@start",
		"\t%object =l call $trbn_alloc(l %descriptor, l 40)",
		"\t%small =w csltl %length, 4",
		"\tjnz %small, @minimum, @requested",
		"@minimum",
		"\t%minimum_capacity_slot =l alloc8 8",
		"\tstorel 4, %minimum_capacity_slot",
		"\tjmp @allocate",
		"@requested",
		"\t%requested_capacity_slot =l alloc8 8",
		"\tstorel %length, %requested_capacity_slot",
		"\tjmp @allocate_requested",
		"@allocate",
		"\t%minimum_capacity =l loadl %minimum_capacity_slot",
		"\t%minimum_bytes =l mul %minimum_capacity, 8",
		"\t%minimum_backing =l call $malloc(l %minimum_bytes)",
		"\t%minimum_failed =w ceql %minimum_backing, 0",
		"\tjnz %minimum_failed, @fail, @initialize_minimum",
		"@initialize_minimum",
		"\tcall $memset(l %minimum_backing, w 0, l %minimum_bytes)",
		"\t%length_address_minimum =l add %object, 32",
		"\tstorel %length, %length_address_minimum",
		"\t%capacity_address_minimum =l add %object, 40",
		"\tstorel %minimum_capacity, %capacity_address_minimum",
		"\t%stride_address_minimum =l add %object, 48",
		"\tstorel 8, %stride_address_minimum",
		"\t%managed_address_minimum =l add %object, 56",
		"\t%descriptor_managed_address_minimum =l add %descriptor, 8",
		"\t%managed_minimum =l loadl %descriptor_managed_address_minimum",
		"\tstorel %managed_minimum, %managed_address_minimum",
		"\t%backing_address_minimum =l add %object, 64",
		"\tstorel %minimum_backing, %backing_address_minimum",
		"\tret %object",
		"@allocate_requested",
		"\t%requested_capacity =l loadl %requested_capacity_slot",
		"\t%requested_bytes =l mul %requested_capacity, 8",
		"\t%requested_backing =l call $malloc(l %requested_bytes)",
		"\t%requested_failed =w ceql %requested_backing, 0",
		"\tjnz %requested_failed, @fail, @initialize_requested",
		"@initialize_requested",
		"\tcall $memset(l %requested_backing, w 0, l %requested_bytes)",
		"\t%length_address_requested =l add %object, 32",
		"\tstorel %length, %length_address_requested",
		"\t%capacity_address_requested =l add %object, 40",
		"\tstorel %requested_capacity, %capacity_address_requested",
		"\t%stride_address_requested =l add %object, 48",
		"\tstorel 8, %stride_address_requested",
		"\t%managed_address_requested =l add %object, 56",
		"\t%descriptor_managed_address_requested =l add %descriptor, 8",
		"\t%managed_requested =l loadl %descriptor_managed_address_requested",
		"\tstorel %managed_requested, %managed_address_requested",
		"\t%backing_address_requested =l add %object, 64",
		"\tstorel %requested_backing, %backing_address_requested",
		"\tret %object",
		"@fail",
		"\tcall $trbn_allocation_fail()",
		"\thlt",
		"}",
		"",
		"function l $trbn_array_size(l %array) {",
		"@start",
		"\t%length_address =l add %array, 32",
		"\t%length =l loadl %length_address",
		"\tret %length",
		"}",
		"",
		"function l $trbn_array_get(l %array, l %index) {",
		"@start",
		"\t%length_address =l add %array, 32",
		"\t%length =l loadl %length_address",
		"\t%actual =l call $trbn_normalize_index(l %length, l %index)",
		"\t%backing_address =l add %array, 64",
		"\t%backing =l loadl %backing_address",
		"\t%scaled =l mul %actual, 8",
		"\t%entry =l add %backing, %scaled",
		"\t%value =l loadl %entry",
		"\tret %value",
		"}",
		"",
		"function $trbn_array_set(l %array, l %index, l %value) {",
		"@start",
		"\t%length_address =l add %array, 32",
		"\t%length =l loadl %length_address",
		"\t%actual =l call $trbn_normalize_index(l %length, l %index)",
		"\t%backing_address =l add %array, 64",
		"\t%backing =l loadl %backing_address",
		"\t%scaled =l mul %actual, 8",
		"\t%entry =l add %backing, %scaled",
		"\tstorel %value, %entry",
		"\tret",
		"}",
		"",
		"function $trbn_array_push(l %array, l %value) {",
		"@start",
		"\t%length_address =l add %array, 32",
		"\t%length =l loadl %length_address",
		"\t%capacity_address =l add %array, 40",
		"\t%capacity =l loadl %capacity_address",
		"\t%full =w ceql %length, %capacity",
		"\tjnz %full, @grow, @store",
		"@grow",
		"\t%new_capacity =l mul %capacity, 2",
		"\t%new_bytes =l mul %new_capacity, 8",
		"\t%backing_address_grow =l add %array, 64",
		"\t%old_backing =l loadl %backing_address_grow",
		"\t%new_backing =l call $realloc(l %old_backing, l %new_bytes)",
		"\t%failed =w ceql %new_backing, 0",
		"\tjnz %failed, @fail, @grown",
		"@grown",
		"\tstorel %new_backing, %backing_address_grow",
		"\tstorel %new_capacity, %capacity_address",
		"\tjmp @store_grown",
		"@store_grown",
		"\t%grown_backing_address =l add %array, 64",
		"\t%grown_backing =l loadl %grown_backing_address",
		"\t%grown_scaled =l mul %length, 8",
		"\t%grown_entry =l add %grown_backing, %grown_scaled",
		"\tstorel %value, %grown_entry",
		"\t%grown_length =l add %length, 1",
		"\tstorel %grown_length, %length_address",
		"\tret",
		"@store",
		"\t%backing_address =l add %array, 64",
		"\t%backing =l loadl %backing_address",
		"\t%scaled =l mul %length, 8",
		"\t%entry =l add %backing, %scaled",
		"\tstorel %value, %entry",
		"\t%new_length =l add %length, 1",
		"\tstorel %new_length, %length_address",
		"\tret",
		"@fail",
		"\tcall $trbn_allocation_fail()",
		"\thlt",
		"}",
		"",
	]
end
