import { RecoveryManagedModule } from recovery_managed_mir
import { emit_recovery_managed_qbe, emit_recovery_managed_qbe_with_runtime_report, emit_bootstrap_qbe } from recovery_managed_qbe
import { native_write_text } from native_file_system
import trb/std/process
import trb/std/result
import { Instant } from trb/std/time

record RecoveryManagedBuildError
	phase: String
	message: String
	status: Integer? = nil
	stdout: String = ""
	stderr: String = ""
end

record RecoveryManagedBuildReport
	qbe_ir_path: String
	assembly_path: String
	output_path: String
	emit_seconds: Float
	qbe_seconds: Float
	link_seconds: Float
end

def build_recovery_managed_executable(
		native_module: RecoveryManagedModule,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
	): Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>
	return _build_recovery_managed_executable(native_module, qbe_command, cc_command, workspace, output_path, false, false)
end

def build_recovery_managed_instrumented_executable(
		native_module: RecoveryManagedModule,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
	): Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>
	return _build_recovery_managed_executable(native_module, qbe_command, cc_command, workspace, output_path, true, false)
end

def build_compiler_recovery_executable(
		native_module: RecoveryManagedModule,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
	): Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>
	return _build_recovery_managed_executable(native_module, qbe_command, cc_command, workspace, output_path, false, true)
end

def _build_recovery_managed_executable(
		native_module: RecoveryManagedModule,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
		report_runtime: Boolean,
		bootstrap: Boolean,
	): Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>
	emit_started := Instant.now()
	mut emit_result := emit_recovery_managed_qbe(native_module)
	if report_runtime
		emit_result = emit_recovery_managed_qbe_with_runtime_report(native_module)
	end
	if bootstrap
		emit_result = emit_bootstrap_qbe(native_module)
	end
	qbe_source := case emit_result
	when Result::Ok(source)
		source
	when Result::Err(diagnostic)
		return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Err(
			RecoveryManagedBuildError.new(
				phase: "verify",
				message: diagnostic.code + " " + diagnostic.path + ": " + diagnostic.message,
			)
		)
	end
	emit_seconds := Instant.now().duration_since(emit_started).total_seconds()
	qbe_ir_path := workspace + "/module.ssa"
	assembly_path := workspace + "/module.s"
	case native_write_text(qbe_ir_path, qbe_source)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Err(
			RecoveryManagedBuildError.new(phase: "write-qbe", message: error.operation + ": " + error.message)
		)
	end
	qbe_started := Instant.now()
	qbe_result := case Process.run(qbe_command, ["-t", "arm64_apple", qbe_ir_path])
	when Result::Ok(process_result)
		process_result
	when Result::Err(error)
		return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Err(
			RecoveryManagedBuildError.new(phase: "qbe", message: error.operation + ": " + error.message)
		)
	end
	qbe_seconds := Instant.now().duration_since(qbe_started).total_seconds()
	if !qbe_result.success
		return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Err(
			RecoveryManagedBuildError.new(
				phase: "qbe",
				message: "QBE rejected the generated IL",
				status: qbe_result.status,
				stdout: qbe_result.stdout,
				stderr: qbe_result.stderr,
			)
		)
	end
	case native_write_text(assembly_path, qbe_result.stdout)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Err(
			RecoveryManagedBuildError.new(phase: "write-assembly", message: error.operation + ": " + error.message)
		)
	end
	link_started := Instant.now()
	cc_result := case Process.run(cc_command, [assembly_path, "-Wl,-dead_strip", "-o", output_path])
	when Result::Ok(process_result)
		process_result
	when Result::Err(error)
		return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Err(
			RecoveryManagedBuildError.new(phase: "link", message: error.operation + ": " + error.message)
		)
	end
	link_seconds := Instant.now().duration_since(link_started).total_seconds()
	if !cc_result.success
		return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Err(
			RecoveryManagedBuildError.new(
				phase: "link",
				message: "the system C toolchain rejected the Managed recovery QBE assembly",
				status: cc_result.status,
				stdout: cc_result.stdout,
				stderr: cc_result.stderr,
			)
		)
	end
	return Result<RecoveryManagedBuildReport, RecoveryManagedBuildError>::Ok(
		RecoveryManagedBuildReport.new(
			qbe_ir_path: qbe_ir_path,
			assembly_path: assembly_path,
			output_path: output_path,
			emit_seconds: emit_seconds,
			qbe_seconds: qbe_seconds,
			link_seconds: link_seconds,
		)
	)
end
