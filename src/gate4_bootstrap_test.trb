import { decode_gate3_snapshot, decode_gate4_bootstrap_snapshot } from gate3_snapshot
import { build_gate4_bootstrap_executable } from gate3_toolchain
import { build_gate4_generation } from gate4_toolchain
import { build_matched_go_compiler } from matched_go_driver
import { gate6f_flatten_compiler_source } from gate6f_compiler_source
import { native_create_directory, native_read_text, native_write_text } from native_file_system
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

def _gate4_environment(name: String): String
	value := Process.environment(name)
	if value == nil
		return ""
	end
	return value
end

def _gate4_read(path: String): Result<String, String>
	case native_read_text(path)
	when Result::Ok(source)
		return Result<String, String>::Ok(source)
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
end

def _gate6f_replace_once(source: String, before: String, after: String): Result<String, String>
	if before.empty?()
		return Result<String, String>::Err("replacement needle is empty")
	end
	mut match_index :=- 1
	mut index := 0
	while index + before.size() <= source.size()
		mut matches := true
		mut offset := 0
		while offset < before.size()
			if source[index + offset] != before[offset]
				matches = false
			end
			offset += 1
		end
		if matches
			if match_index >= 0
				return Result<String, String>::Err("replacement needle is not unique")
			end
			match_index = index
		end
		index += 1
	end
	if match_index < 0
		return Result<String, String>::Err("replacement needle is missing")
	end
	mut result := ""
	index = 0
	while index < match_index
		result += source[index]
		index += 1
	end
	result += after
	index = match_index + before.size()
	while index < source.size()
		result += source[index]
		index += 1
	end
	return Result<String, String>::Ok(result)
end

def _gate6_process(command: String, arguments: Array<String>): Result<Process::Output, String>
	case Process.run(command, arguments)
	when Result::Ok(process)
		return Result<Process::Output, String>::Ok(process)
	when Result::Err(error)
		return Result<Process::Output, String>::Err(error.operation + ": " + error.message)
	end
end

def _gate6_reset_directory(path: String): Result<Boolean, String>
	remove := try _gate6_process("/bin/rm", ["-rf", path])
	if !remove.success
		return Result<Boolean, String>::Err("cannot reset " + path + ": " + remove.stderr)
	end
	case native_create_directory(path)
	when Result::Ok(_unit)
		return Result<Boolean, String>::Ok(true)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
end

def _gate6_build(
		executable: String,
		source_path: String,
		output_path: String,
		qbe: String,
		cc: String,
	): Result<Process::Output, String>
	return _gate6_process(
		executable,
		["build", source_path, "--output", output_path, "--qbe", qbe, "--cc", cc],
	)
end

def _gate6_build_target(
		executable: String,
		source_path: String,
		output_path: String,
		qbe: String,
		cc: String,
		target: String,
	): Result<Process::Output, String>
	return _gate6_process(
		executable,
		[
			"build",
			source_path,
			"--output",
			output_path,
			"--qbe",
			qbe,
			"--cc",
			cc,
			"--target",
			target,
		],
	)
end

def _gate6_require_no_intermediates(directory: String): Result<Boolean, String>
	find := try _gate6_process("/usr/bin/find", [directory, "-name", "*.trbn.*", "-print"])
	if !find.success
		return Result<Boolean, String>::Err("cannot inspect build intermediates: " + find.stderr)
	end
	if !find.stdout.empty?()
		return Result<Boolean, String>::Err("build left intermediates: " + find.stdout)
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6_require_missing(path: String): Result<Boolean, String>
	probe := try _gate6_process("/bin/test", ["!", "-e", path])
	if !probe.success
		return Result<Boolean, String>::Err("unexpected build artifact: " + path)
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6_require_same(left: String, right: String, context: String): Result<Boolean, String>
	comparison := try _gate6_process("/usr/bin/cmp", [left, right])
	if !comparison.success
		return Result<Boolean, String>::Err(context + " executables differ")
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6_verify_built_program(
		executable: String,
		source_path: String,
		output_path: String,
		qbe: String,
		expected_runtime: String,
		context: String,
	): Result<Boolean, String>
	build := try _gate6_build(executable, source_path, output_path, qbe, "/usr/bin/cc")
	if build.status != 0 || !build.stdout.empty?() || !build.stderr.empty?()
		return Result<Boolean, String>::Err(context + " build failed: " + build.stderr)
	end
	runtime := try _gate6_process(output_path, [])
	if runtime.status != 0 || runtime.stdout != expected_runtime || !runtime.stderr.empty?()
		return Result<Boolean, String>::Err(context + " runtime differs: " + runtime.stderr)
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6_verify_build_case(
		source_path: String,
		qbe_source: String,
		expected_runtime: String,
		qbe: String,
		workspace: String,
		case_name: String,
	): Result<Boolean, String>
	b1_directory := workspace + "/gate6-build-" + case_name + "-b1"
	b2_directory := workspace + "/gate6-build-" + case_name + "-b2"
	recipe_directory := workspace + "/gate6-build-" + case_name + "-recipe"
	try _gate6_reset_directory(b1_directory)
	try _gate6_reset_directory(b2_directory)
	try _gate6_reset_directory(recipe_directory)
	b1_output := b1_directory + "/program"
	b2_output := b2_directory + "/program"
	recipe_output := recipe_directory + "/program"
	try _gate6_verify_built_program(
		workspace + "/b1",
		source_path,
		b1_output,
		qbe,
		expected_runtime,
		case_name + " B1",
	)
	try _gate6_verify_built_program(
		workspace + "/b2",
		source_path,
		b2_output,
		qbe,
		expected_runtime,
		case_name + " B2",
	)
	recipe_qbe := recipe_directory + "/program.ssa"
	recipe_assembly := recipe_directory + "/program.s"
	case native_write_text(recipe_qbe, qbe_source)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	qbe_process := try _gate6_process(
		qbe,
		["-t", "arm64_apple", "-o", recipe_assembly, recipe_qbe],
	)
	if !qbe_process.success
		return Result<Boolean, String>::Err(case_name + " external QBE failed: " + qbe_process.stderr)
	end
	cc_process := try _gate6_process(
		"/usr/bin/cc",
		[recipe_assembly, "-Wl,-dead_strip,-x", "-o", recipe_output],
	)
	if !cc_process.success
		return Result<Boolean, String>::Err(case_name + " external cc failed: " + cc_process.stderr)
	end
	try _gate6_require_same(b1_output, b2_output, case_name + " B1/B2")
	try _gate6_require_same(b1_output, recipe_output, case_name + " Native/external")
	try _gate6_require_no_intermediates(b1_directory)
	try _gate6_require_no_intermediates(b2_directory)
	return Result<Boolean, String>::Ok(true)
end

def _gate4_compiler_output(
		executable: String,
		source: String,
		mode: String,
	): Result<String, String>
	process := case Process.run(executable, ["--source-content", mode, source])
	when Result::Ok(value)
		value
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
	if !process.success
		return Result<String, String>::Err(executable + " exited with " + process.status.to_s())
	end
	if !process.stderr.empty?()
		return Result<String, String>::Err(executable + " wrote stderr: " + process.stderr)
	end
	return Result<String, String>::Ok(process.stdout)
end

def _gate4_execute_qbe(
		qbe_source: String,
		qbe: String,
		workspace: String,
		case_name: String,
	): Result<String, String>
	qbe_path := workspace + "/conformance-" + case_name + ".ssa"
	assembly_path := workspace + "/conformance-" + case_name + ".s"
	executable_path := workspace + "/conformance-" + case_name
	case native_write_text(qbe_path, qbe_source)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
	qbe_process := case Process.run(qbe, ["-t", "arm64_apple", qbe_path])
	when Result::Ok(process)
		process
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
	if !qbe_process.success
		return Result<String, String>::Err("QBE rejected " + case_name + ": " + qbe_process.stderr)
	end
	case native_write_text(assembly_path, qbe_process.stdout)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
	link_process := case Process.run("/usr/bin/cc", [assembly_path, "-Wl,-dead_strip", "-o", executable_path])
	when Result::Ok(process)
		process
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
	if !link_process.success
		return Result<String, String>::Err("link failed for " + case_name + ": " + link_process.stderr)
	end
	runtime := case Process.run(executable_path, [])
	when Result::Ok(process)
		process
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
	if !runtime.success || !runtime.stderr.empty?()
		return Result<String, String>::Err("runtime failed for " + case_name + ": " + runtime.stderr)
	end
	return Result<String, String>::Ok(runtime.stdout)
end

def _gate4_verify_valid_case(
		root: String,
		category: String,
		case_name: String,
		executables: Array<String>,
		qbe: String,
		workspace: String,
		file_start: Integer,
		file_end: Integer,
		verify_legacy_build: Boolean,
	): Result<String, String>
	base := root + "/compiler/gate4/conformance/" + category + "/" + case_name
	source := try _gate4_read(base + ".trb")
	expected_runtime := try _gate4_read(base + ".out")
	mut canonical_qbe := ""
	mut index := 0
	while index < executables.size()
		check := try _gate4_compiler_output(executables[index], source, "check")
		if check != "ok\n"
			return Result<String, String>::Err(case_name + " check differs at compiler " + index.to_s())
		end
		first := try _gate4_compiler_output(executables[index], source, "emit-qbe")
		second := try _gate4_compiler_output(executables[index], source, "emit-qbe")
		if first != second
			return Result<String, String>::Err(case_name + " QBE is nondeterministic at compiler " + index.to_s())
		end
		if index == 0
			canonical_qbe = first
		else
			if first != canonical_qbe
				return Result<String, String>::Err(case_name + " QBE differs across compiler generations")
			end
		end
		index += 1
	end
	index = file_start
	while index < file_end
		check_process := case Process.run(executables[index], ["check", base + ".trb"])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<String, String>::Err(error.operation + ": " + error.message)
		end
		if check_process.status != 0 || check_process.stdout != "ok\n" || !check_process.stderr.empty?()
			return Result<String, String>::Err(case_name + " file check differs at compiler " + index.to_s())
		end
		emit_process := case Process.run(executables[index], ["emit-qbe", base + ".trb"])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<String, String>::Err(error.operation + ": " + error.message)
		end
		if emit_process.status != 0 || !emit_process.stderr.empty?() || emit_process.stdout != canonical_qbe
			return Result<String, String>::Err(case_name + " file QBE differs at compiler " + index.to_s())
		end
		index += 1
	end
	actual_runtime := try _gate4_execute_qbe(canonical_qbe, qbe, workspace, category + "-" + case_name)
	if actual_runtime != expected_runtime
		return Result<String, String>::Err(case_name + " runtime output differs")
	end
	if verify_legacy_build
		try _gate6_verify_build_case(
			base + ".trb",
			canonical_qbe,
			expected_runtime,
			qbe,
			workspace,
			category + "-" + case_name,
		)
	end
	return Result<String, String>::Ok(canonical_qbe)
end

def _gate6_verify_invalid_build_case(
		source_path: String,
		expected: String,
		workspace: String,
		case_name: String,
	): Result<Boolean, String>
	mut compiler_index := 1
	while compiler_index < 3
		directory := workspace + "/gate6-build-invalid-" + case_name + "-b" + compiler_index.to_s()
		try _gate6_reset_directory(directory)
		output_path := directory + "/program"
		build := try _gate6_build(
			workspace + "/b" + compiler_index.to_s(),
			source_path,
			output_path,
			"/usr/bin/false",
			"/usr/bin/false",
		)
		if build.status != 1 || !build.stdout.empty?() || build.stderr != expected
			return Result<Boolean, String>::Err(
				case_name + " invalid build differs at compiler " + compiler_index.to_s(),
			)
		end
		try _gate6_require_missing(output_path)
		try _gate6_require_no_intermediates(directory)
		compiler_index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6j_verify_candidate_builds(
		executables: Array<String>,
		source_path: String,
		expected_runtime: String,
		qbe: String,
		workspace: String,
		case_name: String,
	): Result<Boolean, String>
	mut outputs: Array<String> := []
	mut index := 0
	while index < executables.size()
		directory := workspace + "/gate6j-build-" + case_name + "-" + index.to_s()
		try _gate6_reset_directory(directory)
		output := directory + "/program"
		try _gate6_verify_built_program(
			executables[index],
			source_path,
			output,
			qbe,
			expected_runtime,
			case_name + " candidate " + index.to_s(),
		)
		try _gate6_require_no_intermediates(directory)
		outputs.push(output)
		index += 1
	end
	index = 1
	while index < outputs.size()
		try _gate6_require_same(outputs[0], outputs[index], case_name + " candidate build")
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6j_verify_invalid_case(
		root: String,
		case_name: String,
		executables: Array<String>,
		workspace: String,
	): Result<Boolean, String>
	base := root + "/compiler/gate4/conformance/invalid/" + case_name
	source := try _gate4_read(base + ".source")
	expected := try _gate4_read(base + ".diag")
	mut index := 0
	while index < executables.size()
		check := try _gate4_compiler_output(executables[index], source, "check")
		emit := try _gate4_compiler_output(executables[index], source, "emit-qbe")
		if check != expected || emit != expected || emit.include?("export function")
			return Result<Boolean, String>::Err(
				case_name + " diagnostic differs at candidate " + index.to_s()
			)
		end
		file_check := try _gate6_process(executables[index], ["check", base + ".source"])
		file_emit := try _gate6_process(executables[index], ["emit-qbe", base + ".source"])
		if file_check.status != 1 || !file_check.stdout.empty?() || file_check.stderr != expected
			return Result<Boolean, String>::Err(
				case_name + " file check differs at candidate " + index.to_s(),
			)
		end
		if file_emit.status != 1 || !file_emit.stdout.empty?() || file_emit.stderr != expected
			return Result<Boolean, String>::Err(
				case_name + " file emission differs at candidate " + index.to_s(),
			)
		end
		directory := workspace + "/gate6j-invalid-" + case_name + "-" + index.to_s()
		try _gate6_reset_directory(directory)
		output := directory + "/program"
		build := try _gate6_build(
			executables[index],
			base + ".source",
			output,
			"/usr/bin/false",
			"/usr/bin/false",
		)
		if build.status != 1 || !build.stdout.empty?() || build.stderr != expected
			return Result<Boolean, String>::Err(
				case_name + " build differs at candidate " + index.to_s(),
			)
		end
		try _gate6_require_missing(output)
		try _gate6_require_no_intermediates(directory)
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6j_verify_bounds_failure(
		root: String,
		executables: Array<String>,
		qbe: String,
		workspace: String,
	): Result<Boolean, String>
	source_path := root + "/compiler/gate4/conformance/runtime-invalid/float-array-bounds.trb"
	source := try _gate4_read(source_path)
	mut canonical_qbe := ""
	mut outputs: Array<String> := []
	mut index := 0
	while index < executables.size()
		check := try _gate4_compiler_output(executables[index], source, "check")
		if check != "ok\n"
			return Result<Boolean, String>::Err("Float Array bounds source check differs")
		end
		emission := try _gate4_compiler_output(executables[index], source, "emit-qbe")
		if index == 0
			canonical_qbe = emission
		else
			if emission != canonical_qbe
				return Result<Boolean, String>::Err("Float Array bounds QBE differs")
			end
		end
		directory := workspace + "/gate6j-bounds-" + index.to_s()
		try _gate6_reset_directory(directory)
		output := directory + "/program"
		build := try _gate6_build(executables[index], source_path, output, qbe, "/usr/bin/cc")
		if build.status != 0 || !build.stdout.empty?() || !build.stderr.empty?()
			return Result<Boolean, String>::Err("Float Array bounds build failed: " + build.stderr)
		end
		runtime := try _gate6_process(output, [])
		if runtime.status != 2 || !runtime.stdout.empty?() || runtime.stderr != "panic: index is out of bounds\n"
			return Result<Boolean, String>::Err("Float Array bounds failure differs")
		end
		try _gate6_require_no_intermediates(directory)
		outputs.push(output)
		index += 1
	end
	index = 1
	while index < outputs.size()
		try _gate6_require_same(outputs[0], outputs[index], "Float Array bounds candidate build")
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate4_verify_conformance(
		root: String,
		qbe: String,
		workspace: String,
		matched_go_compiler: String,
	): Result<Boolean, String>
	executables := [
		workspace + "/b0",
		workspace + "/b1",
		workspace + "/b2",
		workspace + "/native-chain-b2/compiler",
		workspace + "/native-chain-b3/compiler",
		workspace + "/native-chain-b4/compiler",
		matched_go_compiler,
	]
	valid_names := [
		"control-flow",
		"records-arrays",
		"strings-calls",
		"managed-roots",
		"float-scalars",
		"array-aliases",
	]
	mut float_qbe := ""
	mut index := 0
	while index < valid_names.size()
		valid_qbe := try _gate4_verify_valid_case(
			root,
			"valid",
			valid_names[index],
			executables,
			qbe,
			workspace,
			1,
			6,
			true,
		)
		if valid_names[index] == "float-scalars"
			float_qbe = valid_qbe
		end
		index += 1
	end
	required_float_qbe := [
		"function d $g4f0(l %p0)",
		"function d $g4f1(d %p0, d %p1)",
		"=d call $g4f1(d ",
		"=d sltof ",
		"=d loadd ",
		"stored ",
		"=d add ",
		"=d sub ",
		"=d mul ",
		"=d div ",
		"=w ceqd ",
		"=w cned ",
		"=w cltd ",
		"=w cled ",
		"=w cgtd ",
		"=w cged ",
		"d_-0.0",
	]
	index = 0
	while index < required_float_qbe.size()
		if !float_qbe.include?(required_float_qbe[index])
			return Result<Boolean, String>::Err(
				"Float QBE is missing " + required_float_qbe[index]
			)
		end
		index += 1
	end
	if float_qbe.include?("function d $g4f1(l ") || float_qbe.include?("call $g4f1(l ")
		return Result<Boolean, String>::Err("Float call boundary uses the Integer ABI")
	end
	candidate_executables := [executables[3], executables[4], executables[5]]
	float_array_qbe := try _gate4_verify_valid_case(
		root,
		"valid",
		"float-arrays",
		candidate_executables,
		qbe,
		workspace,
		0,
		3,
		false,
	)
	required_float_array_qbe := [
		"function $g4_array_push_d(l %array, d %value)",
		"call $g4_array_push_d(l ",
		", d ",
		"=d sltof ",
		"=d loadd ",
		"stored ",
	]
	index = 0
	while index < required_float_array_qbe.size()
		if !float_array_qbe.include?(required_float_array_qbe[index])
			return Result<Boolean, String>::Err(
				"Float Array QBE is missing " + required_float_array_qbe[index]
			)
		end
		index += 1
	end
	if float_array_qbe.include?("$g4_array_push_d(l %array, l %value)")
		return Result<Boolean, String>::Err("Float Array push uses the Integer ABI")
	end
	try _gate6j_verify_candidate_builds(
		candidate_executables,
		root + "/compiler/gate4/conformance/valid/float-arrays.trb",
		"float-arrays-ok\n",
		qbe,
		workspace,
		"float-arrays",
	)
	gate6j_invalid_names := [
		"float-array-element",
		"float-array-invariance",
		"float-array-immutable",
		"float-array-method",
	]
	index = 0
	while index < gate6j_invalid_names.size()
		try _gate6j_verify_invalid_case(
			root,
			gate6j_invalid_names[index],
			candidate_executables,
			workspace,
		)
		index += 1
	end
	try _gate6j_verify_bounds_failure(root, candidate_executables, qbe, workspace)
	mutation_names := ["base", "literal", "control"]
	mut mutation_qbe: Array<String> := []
	index = 0
	while index < mutation_names.size()
		mutation_qbe.push(
			try _gate4_verify_valid_case(
				root,
				"mutations",
				mutation_names[index],
				executables,
				qbe,
				workspace,
				1,
				6,
				true,
			)
		)
		index += 1
	end
	if mutation_qbe[0] == mutation_qbe[1] || mutation_qbe[0] == mutation_qbe[2] || mutation_qbe[1] == mutation_qbe[2]
		return Result<Boolean, String>::Err("source mutations did not produce three distinct QBE programs")
	end
	invalid_names := [
		"lexical",
		"syntax",
		"duplicate",
		"unresolved",
		"arity",
		"type",
		"unsupported-type",
		"integer-range",
		"float-overflow",
		"float-narrowing",
		"float-remainder",
		"float-method",
		"float-malformed",
	]
	index = 0
	while index < invalid_names.size()
		base := root + "/compiler/gate4/conformance/invalid/" + invalid_names[index]
		source := try _gate4_read(base + ".source")
		expected := try _gate4_read(base + ".diag")
		if !expected.start_with?("TRBN")
			return Result<Boolean, String>::Err(invalid_names[index] + " is not classified as a diagnostic")
		end
		mut compiler_index := 0
		while compiler_index < executables.size()
			check := try _gate4_compiler_output(executables[compiler_index], source, "check")
			emit := try _gate4_compiler_output(executables[compiler_index], source, "emit-qbe")
			if check != expected || emit != expected || emit.include?("export function")
				return Result<Boolean, String>::Err(
					invalid_names[index] + " diagnostic differs at compiler " + compiler_index.to_s()
				)
			end
			compiler_index += 1
		end
		compiler_index = 1
		while compiler_index < 6
			file_check := case Process.run(executables[compiler_index], ["check", base + ".source"])
			when Result::Ok(process)
				process
			when Result::Err(error)
				return Result<Boolean, String>::Err(error.operation + ": " + error.message)
			end
			file_emit := case Process.run(executables[compiler_index], ["emit-qbe", base + ".source"])
			when Result::Ok(process)
				process
			when Result::Err(error)
				return Result<Boolean, String>::Err(error.operation + ": " + error.message)
			end
			if file_check.status != 1 || !file_check.stdout.empty?() || file_check.stderr != expected
				return Result<Boolean, String>::Err(
					invalid_names[index] + " file check differs at compiler " + compiler_index.to_s(),
				)
			end
			if file_emit.status != 1 || !file_emit.stdout.empty?() || file_emit.stderr != expected
				return Result<Boolean, String>::Err(
					invalid_names[index] + " file emission differs at compiler " + compiler_index.to_s(),
				)
			end
			compiler_index += 1
		end
		try _gate6_verify_invalid_build_case(
			base + ".source",
			expected,
			workspace,
			invalid_names[index],
		)
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6_verify_native_bootstrap_cycle(
		b1_path: String,
		compiler_path: String,
		expected_qbe: String,
		qbe: String,
		workspace: String,
	): Result<Boolean, String>
	directories := [
		workspace + "/native-chain-b2",
		workspace + "/native-chain-b3",
		workspace + "/native-chain-b4",
	]
	mut directory_index := 0
	while directory_index < directories.size()
		try _gate6_reset_directory(directories[directory_index])
		directory_index += 1
	end
	outputs := [
		directories[0] + "/compiler",
		directories[1] + "/compiler",
		directories[2] + "/compiler",
	]
	mut seed := b1_path
	mut generation := 0
	while generation < outputs.size()
		build := try _gate6_build(seed, compiler_path, outputs[generation], qbe, "/usr/bin/cc")
		if build.status != 0 || !build.stdout.empty?() || !build.stderr.empty?()
			return Result<Boolean, String>::Err(
				"Native bootstrap generation " + generation.to_s() + " failed: " + build.stderr,
			)
		end
		try _gate6_require_no_intermediates(directories[generation])
		check := try _gate6_process(outputs[generation], ["check", compiler_path])
		if check.status != 0 || check.stdout != "ok\n" || !check.stderr.empty?()
			return Result<Boolean, String>::Err(
				"Native bootstrap generation " + generation.to_s() + " failed source check",
			)
		end
		emission := try _gate6_process(outputs[generation], ["emit-qbe", compiler_path])
		if emission.status != 0 || emission.stdout != expected_qbe || !emission.stderr.empty?()
			return Result<Boolean, String>::Err(
				"Native bootstrap generation " + generation.to_s() + " left the QBE fixed point",
			)
		end
		seed = outputs[generation]
		generation += 1
	end
	try _gate6_require_same(outputs[0], outputs[1], "Native bootstrap B2/B3")
	try _gate6_require_same(outputs[1], outputs[2], "Native bootstrap B3/B4")
	return Result<Boolean, String>::Ok(true)
end

def _gate4_build_cycle(
		b0_path: String,
		recovery_source: String,
		compiler_path: String,
		qbe: String,
		workspace: String,
	): Boolean
	b1 := case build_gate4_generation(b0_path, recovery_source, qbe, "/usr/bin/cc", workspace, "b1")
	when Result::Ok(report)
		report
	when Result::Err(error)
		puts(error.phase + ": " + error.message + "\n" + error.stderr)
		return false
	end
	b2 := case build_gate4_generation(b1.output_path, recovery_source, qbe, "/usr/bin/cc", workspace, "b2")
	when Result::Ok(report)
		report
	when Result::Err(error)
		puts(error.phase + ": " + error.message + "\n" + error.stderr)
		return false
	end
	b3 := case build_gate4_generation(b2.output_path, recovery_source, qbe, "/usr/bin/cc", workspace, "b3")
	when Result::Ok(report)
		report
	when Result::Err(error)
		puts(error.phase + ": " + error.message + "\n" + error.stderr)
		return false
	end
	b1_qbe := case native_read_text(b1.qbe_ir_path)
	when Result::Ok(source)
		source
	when Result::Err(error)
		puts(error.operation + ": " + error.message)
		return false
	end
	b2_qbe := case native_read_text(b2.qbe_ir_path)
	when Result::Ok(source)
		source
	when Result::Err(error)
		puts(error.operation + ": " + error.message)
		return false
	end
	b3_qbe := case native_read_text(b3.qbe_ir_path)
	when Result::Ok(source)
		source
	when Result::Err(error)
		puts(error.operation + ": " + error.message)
		return false
	end
	if b1_qbe != b2_qbe || b2_qbe != b3_qbe
		puts("recovery B1, B2, and B3 QBE outputs differ")
		return false
	end
	canonical_qbe := case Process.run(b1.output_path, ["emit-qbe", compiler_path])
	when Result::Ok(process)
		if !process.success || process.stdout.empty?() || !process.stderr.empty?()
			puts("B1 could not emit the multi-file compiler closure")
			return false
		end
		process.stdout
	when Result::Err(error)
		puts(error.operation + ": " + error.message)
		return false
	end
	case _gate6_verify_native_bootstrap_cycle(
			b1.output_path,
			compiler_path,
			canonical_qbe,
			qbe,
			workspace,
		)
	when Result::Ok(_value)
	when Result::Err(error)
		puts(error)
		return false
	end
	seeds := [b0_path, b1.output_path, b2.output_path]
	expected_qbe := [b1_qbe, b2_qbe, b3_qbe]
	mut seed_index := 0
	while seed_index < seeds.size()
		case Process.run(seeds[seed_index], ["--source-content", "check", recovery_source])
		when Result::Ok(process)
			if !process.success || process.stdout != "ok\n" || process.stderr != ""
				puts("compiler source check differs at seed " + seed_index.to_s())
				return false
			end
		when Result::Err(error)
			puts(error.operation + ": " + error.message)
			return false
		end
		case Process.run(seeds[seed_index], ["--source-content", "emit-qbe", recovery_source])
		when Result::Ok(process)
			if !process.success || process.stdout != expected_qbe[seed_index] || process.stderr != ""
				puts("repeated compiler QBE differs at seed " + seed_index.to_s())
				return false
			end
		when Result::Err(error)
			puts(error.operation + ": " + error.message)
			return false
		end
		seed_index += 1
	end
	file_seeds := [b1.output_path, b2.output_path]
	seed_index = 0
	while seed_index < file_seeds.size()
		case Process.run(file_seeds[seed_index], ["check", compiler_path])
		when Result::Ok(process)
			if !process.success || process.stdout != "ok\n" || process.stderr != ""
				puts("file-oriented compiler source check differs at seed " + seed_index.to_s())
				return false
			end
		when Result::Err(error)
			puts(error.operation + ": " + error.message)
			return false
		end
		case Process.run(file_seeds[seed_index], ["emit-qbe", compiler_path])
		when Result::Ok(process)
			if !process.success || process.stdout != canonical_qbe || process.stderr != ""
				puts("file-oriented compiler QBE differs at seed " + seed_index.to_s())
				return false
			end
		when Result::Err(error)
			puts(error.operation + ": " + error.message)
			return false
		end
		seed_index += 1
	end
	program := "def main()\n\tputs(\"ok\")\n\treturn\nend\n"
	mut executables := [b1.output_path, b2.output_path, b3.output_path]
	mut index := 0
	while index < executables.size()
		case Process.run(executables[index], ["--source-content", "check", program])
		when Result::Ok(process)
			if !process.success || process.stdout != "ok\n" || process.stderr != ""
				puts("self-hosted compiler check failed")
				return false
			end
		when Result::Err(error)
			puts(error.operation + ": " + error.message)
			return false
		end
		index += 1
	end
	return true
end

def _gate6_verify_file_cli(workspace: String): Result<Boolean, String>
	valid_source := "def main()\n\tputs(\"ok\")\n\treturn\nend\n"
	valid_path := workspace + "/gate6-valid.trb"
	invalid_path := workspace + "/gate6-invalid.trb"
	missing_path := workspace + "/gate6-missing.trb"
	large_path := workspace + "/gate6-large.trb"
	case native_write_text(valid_path, valid_source)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	case native_write_text(invalid_path, "def main()\n\tmissing()\n\treturn\nend\n")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	mut padding := " "
	while padding.size() < 524288
		padding += padding
	end
	case native_write_text(large_path, "def main()" + padding + "\n\treturn\nend\n")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	usage := "usage: compiler {check|emit-qbe} SOURCE\n       compiler build SOURCE --output OUTPUT --qbe QBE --cc CC\n"
	executables := [workspace + "/b1", workspace + "/b2"]
	mut canonical_qbe := ""
	mut index := 0
	while index < executables.size()
		executable := executables[index]
		check := case Process.run(executable, ["check", valid_path])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<Boolean, String>::Err(error.operation + ": " + error.message)
		end
		if check.status != 0 || check.stdout != "ok\n" || !check.stderr.empty?()
			return Result<Boolean, String>::Err("file check failed at compiler " + index.to_s())
		end
		emit := case Process.run(executable, ["emit-qbe", valid_path])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<Boolean, String>::Err(error.operation + ": " + error.message)
		end
		if emit.status != 0 || emit.stdout.empty?() || !emit.stderr.empty?()
			return Result<Boolean, String>::Err("file QBE emission failed at compiler " + index.to_s())
		end
		hidden_qbe := try _gate4_compiler_output(executable, valid_source, "emit-qbe")
		if emit.stdout != hidden_qbe
			return Result<Boolean, String>::Err("file and recovery QBE differ at compiler " + index.to_s())
		end
		if index == 0
			canonical_qbe = emit.stdout
		else
			if emit.stdout != canonical_qbe
				return Result<Boolean, String>::Err("file QBE differs across compiler generations")
			end
		end
		diagnostic := case Process.run(executable, ["check", invalid_path])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<Boolean, String>::Err(error.operation + ": " + error.message)
		end
		if diagnostic.status != 1 || !diagnostic.stdout.empty?()
			return Result<Boolean, String>::Err("file diagnostic contract failed at compiler " + index.to_s())
		end
		if diagnostic.stderr != "TRBN4003:2:unresolved function missing\n"
			return Result<Boolean, String>::Err("file diagnostic contract failed at compiler " + index.to_s())
		end
		missing := case Process.run(executable, ["check", missing_path])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<Boolean, String>::Err(error.operation + ": " + error.message)
		end
		if missing.status != 66 || !missing.stdout.empty?()
			return Result<Boolean, String>::Err("missing-file contract failed at compiler " + index.to_s())
		end
		if missing.stderr != "compiler: cannot read source file: " + missing_path + "\n"
			return Result<Boolean, String>::Err("missing-file contract failed at compiler " + index.to_s())
		end
		no_arguments := case Process.run(executable, [])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<Boolean, String>::Err(error.operation + ": " + error.message)
		end
		if no_arguments.status != 64 || !no_arguments.stdout.empty?() || no_arguments.stderr != usage
			return Result<Boolean, String>::Err("no-argument usage contract failed at compiler " + index.to_s())
		end
		invalid_mode := case Process.run(executable, ["invalid", valid_path])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<Boolean, String>::Err(error.operation + ": " + error.message)
		end
		if invalid_mode.status != 64 || !invalid_mode.stdout.empty?() || invalid_mode.stderr != usage
			return Result<Boolean, String>::Err("invalid-mode usage contract failed at compiler " + index.to_s())
		end
		large := case Process.run(executable, ["check", large_path])
		when Result::Ok(process)
			process
		when Result::Err(error)
			return Result<Boolean, String>::Err(error.operation + ": " + error.message)
		end
		if large.status != 0 || large.stdout != "ok\n" || !large.stderr.empty?()
			return Result<Boolean, String>::Err("large file check failed at compiler " + index.to_s())
		end
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6_expect_failed_build(
		executable: String,
		source_path: String,
		output_path: String,
		qbe: String,
		cc: String,
		expected_status: Integer,
		expected_stderr: String,
		directory: String,
		context: String,
	): Result<Boolean, String>
	build := try _gate6_build(executable, source_path, output_path, qbe, cc)
	if build.status != expected_status || !build.stdout.empty?() || build.stderr != expected_stderr
		return Result<Boolean, String>::Err(context + " failure contract differs")
	end
	try _gate6_require_missing(output_path)
	try _gate6_require_no_intermediates(directory)
	return Result<Boolean, String>::Ok(true)
end

def _gate6_verify_build_cli(workspace: String, qbe: String): Result<Boolean, String>
	executable := workspace + "/b1"
	source_directory := workspace + "/gate6 source with spaces"
	output_directory := workspace + "/gate6 output with spaces"
	target_output_directory := workspace + "/gate6 target output with spaces"
	failure_directory := workspace + "/gate6-build-failures"
	try _gate6_reset_directory(source_directory)
	try _gate6_reset_directory(output_directory)
	try _gate6_reset_directory(target_output_directory)
	try _gate6_reset_directory(failure_directory)
	source_path := source_directory + "/input program.trb"
	output_path := output_directory + "/program"
	case native_write_text(source_path, "def main()\n\tputs(\"ok\")\n\treturn\nend\n")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	case native_write_text(output_path, "stale output")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	try _gate6_verify_built_program(
		executable,
		source_path,
		output_path,
		qbe,
		"ok\n",
		"space-bearing atomic replacement",
	)
	try _gate6_require_no_intermediates(output_directory)
	target_output_path := target_output_directory + "/program"
	target_build := try _gate6_build_target(
		executable,
		source_path,
		target_output_path,
		qbe,
		"/usr/bin/cc",
		"darwin-arm64-v0",
	)
	if target_build.status != 0 || !target_build.stdout.empty?() || !target_build.stderr.empty?()
		return Result<Boolean, String>::Err("explicit Darwin target build failed: " + target_build.stderr)
	end
	target_runtime := try _gate6_process(target_output_path, [])
	if target_runtime.status != 0 || target_runtime.stdout != "ok\n" || !target_runtime.stderr.empty?()
		return Result<Boolean, String>::Err("explicit Darwin target runtime differs")
	end
	try _gate6_require_same(output_path, target_output_path, "implicit/explicit Darwin target")
	try _gate6_require_no_intermediates(target_output_directory)

	unsupported_output := failure_directory + "/unsupported-target"
	unsupported_target := try _gate6_build_target(
		executable,
		source_path,
		unsupported_output,
		workspace + "/gate6-missing-qbe",
		workspace + "/gate6-missing-cc",
		"unknown-v0",
	)
	if unsupported_target.status != 64 || !unsupported_target.stdout.empty?()
		return Result<Boolean, String>::Err("unsupported-target status differs")
	end
	if unsupported_target.stderr != "compiler: unsupported target profile\n"
		return Result<Boolean, String>::Err("unsupported-target diagnostic differs")
	end
	try _gate6_require_missing(unsupported_output)
	try _gate6_require_no_intermediates(failure_directory)

	usage := "usage: compiler {check|emit-qbe} SOURCE\n       compiler build SOURCE --output OUTPUT --qbe QBE --cc CC\n"
	invalid_shape := try _gate6_process(
		executable,
		["build", source_path, "--output", output_path, "--qbe", qbe],
	)
	if invalid_shape.status != 64 || !invalid_shape.stdout.empty?() || invalid_shape.stderr != usage
		return Result<Boolean, String>::Err("build usage contract differs")
	end

	missing_source := workspace + "/gate6 missing source.trb"
	missing_output := failure_directory + "/missing-source"
	missing := try _gate6_build(executable, missing_source, missing_output, qbe, "/usr/bin/cc")
	if missing.status != 66 || !missing.stdout.empty?()
		return Result<Boolean, String>::Err("build missing-source status differs")
	end
	if missing.stderr != "compiler: cannot read source file: " + missing_source + "\n"
		return Result<Boolean, String>::Err("build missing-source diagnostic differs")
	end
	try _gate6_require_missing(missing_output)
	try _gate6_require_no_intermediates(failure_directory)

	qbe_failure_tool := failure_directory + "/qbe failure tool"
	cc_failure_tool := failure_directory + "/cc failure tool"
	case native_write_text(
			qbe_failure_tool,
			"#!/bin/sh\nprintf 'qbe child stderr\\n' >&2\nexit 23\n",
		)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	case native_write_text(
			cc_failure_tool,
			"#!/bin/sh\nprintf 'cc child stderr\\n' >&2\nexit 24\n",
		)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	chmod := try _gate6_process("/bin/chmod", ["+x", qbe_failure_tool, cc_failure_tool])
	if !chmod.success
		return Result<Boolean, String>::Err("cannot prepare child failure tools: " + chmod.stderr)
	end
	try _gate6_expect_failed_build(
		executable,
		source_path,
		failure_directory + "/qbe-failure",
		qbe_failure_tool,
		"/usr/bin/cc",
		70,
		"qbe child stderr\ncompiler: qbe failed\n",
		failure_directory,
		"QBE",
	)
	try _gate6_expect_failed_build(
		executable,
		source_path,
		failure_directory + "/missing-qbe",
		workspace + "/gate6-missing-qbe",
		"/usr/bin/cc",
		70,
		"compiler: qbe failed\n",
		failure_directory,
		"missing QBE",
	)
	try _gate6_expect_failed_build(
		executable,
		source_path,
		failure_directory + "/cc-failure",
		qbe,
		cc_failure_tool,
		70,
		"cc child stderr\ncompiler: cc failed\n",
		failure_directory,
		"cc",
	)
	try _gate6_expect_failed_build(
		executable,
		source_path,
		failure_directory + "/missing-cc",
		qbe,
		workspace + "/gate6-missing-cc",
		70,
		"compiler: cc failed\n",
		failure_directory,
		"missing cc",
	)

	missing_parent := workspace + "/gate6-missing-output-parent"
	remove_parent := try _gate6_process("/bin/rm", ["-rf", missing_parent])
	if !remove_parent.success
		return Result<Boolean, String>::Err("cannot reset missing output parent")
	end
	intermediate_failure := try _gate6_build(
		executable,
		source_path,
		missing_parent + "/program",
		qbe,
		"/usr/bin/cc",
	)
	if intermediate_failure.status != 73 || !intermediate_failure.stdout.empty?()
		return Result<Boolean, String>::Err("intermediate-file status differs")
	end
	if intermediate_failure.stderr != "compiler: cannot create intermediate file\n"
		return Result<Boolean, String>::Err("intermediate-file diagnostic differs")
	end

	publish_target := workspace + "/gate6-publish-target"
	try _gate6_reset_directory(publish_target)
	publish_failure := try _gate6_build(
		executable,
		source_path,
		publish_target,
		qbe,
		"/usr/bin/cc",
	)
	if publish_failure.status != 73 || !publish_failure.stdout.empty?()
		return Result<Boolean, String>::Err("publish status differs")
	end
	if publish_failure.stderr != "compiler: cannot publish output\n"
		return Result<Boolean, String>::Err("publish diagnostic differs")
	end
	try _gate6_require_no_intermediates(workspace)
	return Result<Boolean, String>::Ok(true)
end

def _gate6_copy_source(source: String, destination: String): Result<Boolean, String>
	contents := try _gate4_read(source)
	case native_write_text(destination, contents)
	when Result::Ok(_unit)
		return Result<Boolean, String>::Ok(true)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
end

def _gate6_write_source(path: String, source: String): Result<Boolean, String>
	case native_write_text(path, source)
	when Result::Ok(_unit)
		return Result<Boolean, String>::Ok(true)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
end

def _prepare_compiler_closure(
		directory: String,
		sources: Array<String>,
		omitted: String,
	): Result<Boolean, String>
	try _gate6_reset_directory(directory)
	names := ["compiler", "storage", "path", "mir", "literals"]
	mut index := 0
	while index < names.size()
		if names[index] != omitted
			try _gate6_write_source(directory + "/" + names[index] + ".trb", sources[index])
		end
		index += 1
	end
	try _gate6_write_source(directory + "/unrelated.trb", "@\n")
	return Result<Boolean, String>::Ok(true)
end

def _gate6f_verify_compiler_source_closure(
		executable: String,
		compiler_path: String,
		entry: String,
		storage: String,
		path: String,
		mir: String,
		literals: String,
		workspace: String,
	): Result<Boolean, String>
	canonical := try _gate6_process(executable, ["emit-qbe", compiler_path])
	if canonical.status != 0 || canonical.stdout.empty?() || !canonical.stderr.empty?()
		return Result<Boolean, String>::Err("cannot emit canonical multi-file compiler QBE")
	end
	hidden := try _gate6_process(executable, ["--source-content", "check", entry])
	if hidden.status != 0 || !hidden.stderr.empty?()
		return Result<Boolean, String>::Err("hidden compiler-source probe process differs")
	end
	if !hidden.stdout.include?("module does not export Gate4IntegerStorage")
		return Result<Boolean, String>::Err("hidden source-content adapter loaded compiler modules")
	end

	storage_mutation := try _gate6f_replace_once(
		storage,
		"def gate4_storage_chunk_size(): Integer\n\treturn 256\nend\n",
		"def gate4_storage_chunk_size(): Integer\n\treturn 128\nend\n",
	)
	path_mutation := try _gate6f_replace_once(
		path,
		"\t\treturn \".\"\n",
		"\t\treturn \"./\"\n",
	)
	mir_mutation := try _gate6f_replace_once(mir, "MIR failure target does not exist", "MIR failure target is absent")
	literal_mutation := try _gate6f_replace_once(literals, "return parsed <= 1024", "return parsed <= 1023")
	names := ["compiler", "storage", "path", "mir", "literals"]
	sources := [entry, storage, path, mir, literals]
	mutations := [entry, storage_mutation, path_mutation, mir_mutation, literal_mutation]
	mut index := 1
	while index < names.size()
		mut changed := [entry, storage, path, mir, literals]
		changed[index] = mutations[index]
		directory := workspace + "/gate6f-compiler-" + names[index] + "-mutation"
		try _prepare_compiler_closure(directory, changed, "")
		emission := try _gate6_process(executable, ["emit-qbe", directory + "/compiler.trb"])
		if emission.status != 0 || emission.stdout.empty?() || !emission.stderr.empty?()
			return Result<Boolean, String>::Err(names[index] + " mutation emission failed: " + emission.stderr)
		end
		if emission.stdout == canonical.stdout
			return Result<Boolean, String>::Err(names[index] + " mutation did not change compiler QBE")
		end
		try _gate6_require_no_intermediates(directory)

		missing := workspace + "/gate6f-compiler-missing-" + names[index]
		try _prepare_compiler_closure(missing, sources, names[index])
		missing_output := missing + "/compiler"
		missing_build := try _gate6_build(executable, missing + "/compiler.trb", missing_output, missing + "/missing-qbe", missing + "/missing-cc")
		if missing_build.status != 1 || !missing_build.stdout.empty?()
			return Result<Boolean, String>::Err("missing " + names[index] + " module did not fail before tools")
		end
		if !missing_build.stderr.include?("cannot resolve project import " + names[index])
			return Result<Boolean, String>::Err("missing " + names[index] + " module diagnostic differs: " + missing_build.stderr)
		end
		try _gate6_require_missing(missing_output)
		try _gate6_require_no_intermediates(missing)

		malformed := workspace + "/gate6f-compiler-malformed-" + names[index]
		changed[index] = sources[index] + "\n@\n"
		try _prepare_compiler_closure(malformed, changed, "")
		malformed_output := malformed + "/compiler"
		malformed_build := try _gate6_build(executable, malformed + "/compiler.trb", malformed_output, malformed + "/missing-qbe", malformed + "/missing-cc")
		if malformed_build.status != 1 || !malformed_build.stdout.empty?()
			return Result<Boolean, String>::Err("malformed " + names[index] + " module did not fail before tools")
		end
		if !malformed_build.stderr.include?("TRBN4001")
			return Result<Boolean, String>::Err("malformed " + names[index] + " module diagnostic differs: " + malformed_build.stderr)
		end
		try _gate6_require_missing(malformed_output)
		try _gate6_require_no_intermediates(malformed)
		index += 1
	end

	unrelated := workspace + "/gate6f-compiler-unrelated"
	try _prepare_compiler_closure(unrelated, sources, "")
	unrelated_emission := try _gate6_process(executable, ["emit-qbe", unrelated + "/compiler.trb"])
	if unrelated_emission.status != 0 || unrelated_emission.stdout != canonical.stdout || !unrelated_emission.stderr.empty?()
		return Result<Boolean, String>::Err("unrelated invalid compiler sibling entered the closure")
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6_expect_file_root_failure(
		executable: String,
		project: String,
		expected: String,
		label: String,
	): Result<Boolean, String>
	output := project + "/program"
	build := try _gate6_build(
		executable,
		project + "/main.trb",
		output,
		project + "/missing-qbe",
		project + "/missing-cc",
	)
	if build.status != 1 || !build.stdout.empty?()
		return Result<Boolean, String>::Err(label + " did not fail before external tools")
	end
	if !build.stderr.include?(expected)
		return Result<Boolean, String>::Err(label + " diagnostic differs: " + build.stderr)
	end
	try _gate6_require_missing(output)
	try _gate6_require_no_intermediates(project)
	return Result<Boolean, String>::Ok(true)
end

def _gate6_prepare_file_root_project(root: String, project: String): Result<Boolean, String>
	try _gate6_reset_directory(project)
	directories := [project + "/app", project + "/domain", project + "/shared"]
	mut index := 0
	while index < directories.size()
		created := try _gate6_process("/bin/mkdir", ["-p", directories[index]])
		if !created.success
			return Result<Boolean, String>::Err("cannot create file-root fixture directory")
		end
		index += 1
	end
	fixture := root + "/compiler/gate4/conformance/file-root"
	relative := [
		"main.trb",
		"app/summary.trb",
		"app/label.trb",
		"domain/score.trb",
		"shared/index.trb",
		"unrelated.trb",
	]
	index = 0
	while index < relative.size()
		try _gate6_copy_source(fixture + "/" + relative[index], project + "/" + relative[index])
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def _gate6h_fixed_width_name(prefix: String, index: Integer): String
	mut digits := index.to_s()
	while digits.size() < 4
		digits = "0" + digits
	end
	return prefix + digits
end

def _gate6h_prepare_module_chain(project: String, count: Integer): Result<String, String>
	try _gate6_reset_directory(project)
	mut index := 0
	while index < count
		module_name := _gate6h_fixed_width_name("m", index)
		function_name := _gate6h_fixed_width_name("f", index)
		mut source := ""
		if index > 0
			previous_module := _gate6h_fixed_width_name("m", index - 1)
			previous_function := _gate6h_fixed_width_name("f", index - 1)
			source += "import { " + previous_function + " } from " + previous_module + "\n\n"
			source += "def " + function_name + "(): Integer\n\treturn " + previous_function + "() + 1\nend\n"
		else
			source = "def " + function_name + "(): Integer\n\treturn 0\nend\n"
		end
		try _gate6_write_source(project + "/" + module_name + ".trb", source)
		index += 1
	end
	last_function := _gate6h_fixed_width_name("f", count - 1)
	last_module := _gate6h_fixed_width_name("m", count - 1)
	entry := project + "/main.trb"
	try _gate6_write_source(
		entry,
		"import { " + last_function + " } from " + last_module + "\n\n" +
		"def main()\n\tif " + last_function + "() == " + (count - 1).to_s() +
		"\n\t\tputs(\"module-scale-ok\")\n\tend\n\treturn\nend\n",
	)
	return Result<String, String>::Ok(entry)
end

def _gate6_verify_file_root_modules(
		root: String,
		workspace: String,
		qbe: String,
		reference_trb: String,
	): Result<Boolean, String>
	project := workspace + "/gate6 file root project"
	try _gate6_prepare_file_root_project(root, project)
	entry := project + "/main.trb"
	executables := [
		workspace + "/b1",
		workspace + "/b2",
		workspace + "/native-chain-b2/compiler",
		workspace + "/native-chain-b3/compiler",
		workspace + "/native-chain-b4/compiler",
	]
	mut canonical_qbe := ""
	mut index := 0
	while index < executables.size()
		check := try _gate6_process(executables[index], ["check", entry])
		if check.status != 0 || check.stdout != "ok\n" || !check.stderr.empty?()
			return Result<Boolean, String>::Err("file-root check failed at compiler " + index.to_s() + ": " + check.stderr)
		end
		emission := try _gate6_process(executables[index], ["emit-qbe", entry])
		if emission.status != 0 || emission.stdout.empty?() || !emission.stderr.empty?()
			return Result<Boolean, String>::Err("file-root emission failed at compiler " + index.to_s())
		end
		if canonical_qbe == ""
			canonical_qbe = emission.stdout
		else
			if emission.stdout != canonical_qbe
				return Result<Boolean, String>::Err("file-root QBE differs across compiler generations")
			end
		end
		output_directory := workspace + "/gate6-file-root-output-" + index.to_s()
		try _gate6_reset_directory(output_directory)
		output := output_directory + "/program"
		try _gate6_verify_built_program(
			executables[index],
			entry,
			output,
			qbe,
			"file-root-ok\n",
			"file-root compiler " + index.to_s(),
		)
		try _gate6_require_no_intermediates(output_directory)
		index += 1
	end

	repeat_a := workspace + "/gate6-file-root-repeat-a"
	repeat_b := workspace + "/gate6-file-root-repeat-b"
	try _gate6_reset_directory(repeat_a)
	try _gate6_reset_directory(repeat_b)
	try _gate6_verify_built_program(executables[0], entry, repeat_a + "/program", qbe, "file-root-ok\n", "repeat A")
	try _gate6_verify_built_program(executables[0], entry, repeat_b + "/program", qbe, "file-root-ok\n", "repeat B")
	try _gate6_require_same(repeat_a + "/program", repeat_b + "/program", "repeated file-root")

	reference_output := workspace + "/gate6-reference-file-root"
	reference_check := try _gate6_process(reference_trb, ["check", entry])
	if reference_check.status != 0
		return Result<Boolean, String>::Err("reference file-root check failed: " + reference_check.stderr)
	end
	reference_build := try _gate6_process(
		reference_trb,
		["build", "--compile", "--outfile", reference_output, entry],
	)
	if reference_build.status != 0
		return Result<Boolean, String>::Err("reference file-root build failed: " + reference_build.stderr)
	end
	reference_runtime := try _gate6_process(reference_output, [])
	if reference_runtime.status != 0 || reference_runtime.stdout != "file-root-ok\n" || !reference_runtime.stderr.empty?()
		return Result<Boolean, String>::Err("reference file-root runtime differs")
	end

	scale_project := workspace + "/gate6h-module-chain"
	scale_entry := try _gate6h_prepare_module_chain(scale_project, 64)
	mut scale_qbe := ""
	index = 0
	while index < executables.size()
		scale_check := try _gate6_process(executables[index], ["check", scale_entry])
		if scale_check.status != 0 || scale_check.stdout != "ok\n" || !scale_check.stderr.empty?()
			return Result<Boolean, String>::Err(
				"module-chain check failed at compiler " + index.to_s() + ": " + scale_check.stderr,
			)
		end
		scale_emission := try _gate6_process(executables[index], ["emit-qbe", scale_entry])
		if scale_emission.status != 0 || scale_emission.stdout.empty?() || !scale_emission.stderr.empty?()
			return Result<Boolean, String>::Err("module-chain emission failed at compiler " + index.to_s())
		end
		if scale_qbe == ""
			scale_qbe = scale_emission.stdout
		else
			if scale_emission.stdout != scale_qbe
				return Result<Boolean, String>::Err("module-chain QBE differs across compiler generations")
			end
		end
		index += 1
	end
	scale_output := scale_project + "/native-program"
	try _gate6_verify_built_program(
		executables[0],
		scale_entry,
		scale_output,
		qbe,
		"module-scale-ok\n",
		"64-module Native chain",
	)
	scale_reference_output := scale_project + "/reference-program"
	scale_reference_build := try _gate6_process(
		reference_trb,
		["build", "--compile", "--outfile", scale_reference_output, scale_entry],
	)
	if scale_reference_build.status != 0
		return Result<Boolean, String>::Err("reference module-chain build failed: " + scale_reference_build.stderr)
	end
	scale_reference_runtime := try _gate6_process(scale_reference_output, [])
	if scale_reference_runtime.status != 0
		return Result<Boolean, String>::Err("reference module-chain execution failed")
	end
	if scale_reference_runtime.stdout != "module-scale-ok\n" || !scale_reference_runtime.stderr.empty?()
		return Result<Boolean, String>::Err("reference module-chain runtime differs")
	end
	try _gate6_require_no_intermediates(scale_project)

	precedence := workspace + "/gate6-file-root-precedence"
	try _gate6_reset_directory(precedence)
	created := try _gate6_process("/bin/mkdir", ["-p", precedence + "/choice"])
	if !created.success
		return Result<Boolean, String>::Err("cannot create precedence fixture")
	end
	case native_write_text(
			precedence + "/main.trb",
			"import { choice } from choice.trb\n\ndef main()\n\tputs(choice())\n\treturn\nend\n",
		)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	case native_write_text(precedence + "/choice.trb", "def choice(): String\n\treturn \"direct\"\nend\n")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	case native_write_text(precedence + "/choice/index.trb", "def choice(): String\n\treturn \"index\"\nend\n")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	try _gate6_verify_built_program(
		executables[0],
		precedence + "/main.trb",
		precedence + "/program",
		qbe,
		"direct\n",
		"file/index precedence",
	)

	declaration_imports := workspace + "/gate6-file-root-declaration-imports"
	try _gate6_reset_directory(declaration_imports)
	declaration_directories := [
		declaration_imports + "/services",
		declaration_imports + "/shared/ui/data_table",
	]
	index = 0
	while index < declaration_directories.size()
		created := try _gate6_process("/bin/mkdir", ["-p", declaration_directories[index]])
		if !created.success
			return Result<Boolean, String>::Err("cannot create declaration-import fixture")
		end
		index += 1
	end
	try _gate6_write_source(
		declaration_imports + "/main.trb",
		"import { Response as WebResponse, status_code as read_status } from services/http\n" +
		"import services/secure_random as Random\n" +
		"import shared/ui/data_table\n\n" +
		"def main()\n" +
		"\tresponse := WebResponse.new(status: read_status())\n" +
		"\trandom := Random.new(value: response.status)\n" +
		"\ttable := DataTable.new(rows: random.value)\n" +
		"\tif table.rows == 42\n\t\tputs(\"declaration-imports-ok\")\n\tend\n" +
		"\treturn\nend\n",
	)
	try _gate6_write_source(
		declaration_imports + "/services/http.trb",
		"record Response\n\tstatus: Integer\nend\n\ndef status_code(): Integer\n\treturn 42\nend\n",
	)
	try _gate6_write_source(
		declaration_imports + "/services/secure_random.trb",
		"record SecureRandom\n\tvalue: Integer\nend\n",
	)
	try _gate6_write_source(
		declaration_imports + "/shared/ui/data_table/index.trb",
		"record DataTable\n\trows: Integer\nend\n",
	)
	mut declaration_qbe := ""
	index = 0
	while index < executables.size()
		declaration_check := try _gate6_process(
			executables[index],
			["check", declaration_imports + "/main.trb"],
		)
		if declaration_check.status != 0 || declaration_check.stdout != "ok\n" || !declaration_check.stderr.empty?()
			return Result<Boolean, String>::Err(
				"declaration-import check failed at compiler " + index.to_s() + ": " + declaration_check.stderr,
			)
		end
		declaration_emission := try _gate6_process(
			executables[index],
			["emit-qbe", declaration_imports + "/main.trb"],
		)
		if declaration_emission.status != 0 || declaration_emission.stdout.empty?() || !declaration_emission.stderr.empty?()
			return Result<Boolean, String>::Err(
				"declaration-import emission failed at compiler " + index.to_s(),
			)
		end
		if declaration_qbe == ""
			declaration_qbe = declaration_emission.stdout
		else
			if declaration_emission.stdout != declaration_qbe
				return Result<Boolean, String>::Err("declaration-import QBE differs across compiler generations")
			end
		end
		index += 1
	end
	try _gate6_verify_built_program(
		executables[0],
		declaration_imports + "/main.trb",
		declaration_imports + "/native-program",
		qbe,
		"declaration-imports-ok\n",
		"Native declaration imports",
	)
	reference_declaration_output := declaration_imports + "/reference-program"
	reference_declaration_build := try _gate6_process(
		reference_trb,
		[
			"build",
			"--compile",
			"--outfile",
			reference_declaration_output,
			declaration_imports + "/main.trb",
		],
	)
	if reference_declaration_build.status != 0
		return Result<Boolean, String>::Err(
			"reference declaration-import build failed: " + reference_declaration_build.stderr,
		)
	end
	reference_declaration_runtime := try _gate6_process(reference_declaration_output, [])
	if reference_declaration_runtime.status != 0
		return Result<Boolean, String>::Err("reference declaration-import execution failed")
	end
	if reference_declaration_runtime.stdout != "declaration-imports-ok\n" || !reference_declaration_runtime.stderr.empty?()
		return Result<Boolean, String>::Err("reference declaration-import runtime differs")
	end
	try _gate6_require_no_intermediates(declaration_imports)

	root_conflict := workspace + "/gate6-file-root-root-conflict"
	try _gate6_reset_directory(root_conflict)
	created_conflict := try _gate6_process("/bin/mkdir", ["-p", root_conflict + "/choice"])
	if !created_conflict.success
		return Result<Boolean, String>::Err("cannot create root-conflict fixture")
	end
	try _gate6_write_source(
		root_conflict + "/main.trb",
		"import { choice as direct_choice } from choice\n" +
		"import { choice as indexed_choice } from choice/index\n\n" +
		"def main()\n\tputs(direct_choice() + indexed_choice())\n\treturn\nend\n",
	)
	try _gate6_write_source(root_conflict + "/choice.trb", "def choice(): String\n\treturn \"direct\"\nend\n")
	try _gate6_write_source(
		root_conflict + "/choice/index.trb",
		"def choice(): String\n\treturn \"index\"\nend\n",
	)
	index = 0
	while index < executables.size()
		try _gate6_expect_file_root_failure(
			executables[index],
			root_conflict,
			"define the same import root",
			"file/index root conflict compiler " + index.to_s(),
		)
		index += 1
	end
	reference_root_conflict := try _gate6_process(reference_trb, ["check", root_conflict + "/main.trb"])
	if reference_root_conflict.status == 0
		return Result<Boolean, String>::Err("reference accepted a direct/index root conflict")
	end
	if !reference_root_conflict.stderr.include?("define the same import root")
		return Result<Boolean, String>::Err("reference root-conflict diagnostic differs")
	end

	cycle := workspace + "/gate6-file-root-cycle"
	try _gate6_reset_directory(cycle)
	case native_write_text(
			cycle + "/main.trb",
			"import { answer } from a\n\ndef main()\n\tputs(answer())\n\treturn\nend\n",
		)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	case native_write_text(cycle + "/a.trb", "import { helper } from b\n\ndef answer(): String\n\treturn helper()\nend\n")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	case native_write_text(cycle + "/b.trb", "import { answer } from a\n\ndef helper(): String\n\treturn \"cycle\"\nend\n\ndef observe(): String\n\treturn answer()\nend\n")
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
	cycle_build := try _gate6_build(
		executables[0],
		cycle + "/main.trb",
		cycle + "/program",
		workspace + "/missing-qbe",
		workspace + "/missing-cc",
	)
	if cycle_build.status != 1 || !cycle_build.stdout.empty?()
		return Result<Boolean, String>::Err("file-root cycle did not fail before tools")
	end
	if !cycle_build.stderr.include?("TRBN4003:1:import cycle through a")
		return Result<Boolean, String>::Err("file-root cycle diagnostic differs: " + cycle_build.stderr)
	end
	try _gate6_require_missing(cycle + "/program")
	try _gate6_require_no_intermediates(cycle)

	failure_names := [
		"missing-module",
		"escaping-path",
		"malformed-import",
		"missing-export",
		"duplicate-identity",
		"binding-collision",
		"unused-binding",
		"local-conflict",
		"zero-root",
		"ambiguous-root",
		"bare-function",
		"missing-entry-main",
		"invalid-entry-main",
		"package-import",
		"package-root-import",
		"capability-activation",
	]
	failure_entries := [
		"import { value } from missing\n\ndef main()\n\tputs(value())\n\treturn\nend\n",
		"import { value } from ../outside\n\ndef main()\n\tputs(value())\n\treturn\nend\n",
		"import { value } from lib\n\ndef main()\n\tputs(value())\n\treturn\nend\n",
		"import { value } from lib\n\ndef main()\n\tputs(value())\n\treturn\nend\n",
		"import { value as first, value as second } from lib\n\ndef main()\n\treturn\nend\n",
		"import { value as shared, other as shared } from lib\n\ndef main()\n\treturn\nend\n",
		"import { value } from lib\n\ndef main()\n\treturn\nend\n",
		"import { value } from lib\n\ndef value(): String\n\treturn \"local\"\nend\n\ndef main()\n\tputs(value())\n\treturn\nend\n",
		"import lib\n\ndef main()\n\treturn\nend\n",
		"import lib\n\ndef main()\n\treturn\nend\n",
		"import lib\n\ndef main()\n\treturn\nend\n",
		"import { helper } from lib\n\ndef run()\n\tputs(helper())\n\treturn\nend\n",
		"def main(value: Integer)\n\treturn\nend\n",
		"import { value } from trb/std/value\n\ndef main()\n\tputs(value())\n\treturn\nend\n",
		"import trb/std/json\n\ndef main()\n\treturn\nend\n",
		"activate trb/platform/ruby/native\n\ndef main()\n\treturn\nend\n",
	]
	failure_libraries := [
		"",
		"",
		"def value(): String\n\treturn \"broken\"\n",
		"def other(): String\n\treturn \"other\"\nend\n",
		"def value(): String\n\treturn \"value\"\nend\n",
		"def value(): String\n\treturn \"value\"\nend\n\ndef other(): String\n\treturn \"other\"\nend\n",
		"def value(): String\n\treturn \"value\"\nend\n",
		"def value(): String\n\treturn \"imported\"\nend\n",
		"record Other\n\tvalue: Integer\nend\n",
		"record LIB\n\tvalue: Integer\nend\n\nrecord Lib\n\tvalue: Integer\nend\n",
		"def lib(): String\n\treturn \"function\"\nend\n",
		"def helper(): String\n\treturn \"helper\"\nend\n\ndef main()\n\treturn\nend\n",
		"",
		"",
		"",
		"",
	]
	failure_diagnostics := [
		"cannot resolve project import missing",
		"invalid project import path ../outside",
		"TRBN4002",
		"module does not export value",
		"declaration value from lib is already imported as first",
		"duplicate import binding shared",
		"unused import value",
		"import binding conflicts with local declaration value",
		"import lib has no record root declaration matching lib",
		"import lib has multiple record root declarations matching lib",
		"import lib matches only a top-level function; use an exact named import",
		"program must declare exactly one main function",
		"main must take no parameters",
		"package imports are not supported by this compiler subset",
		"package imports are not supported by this compiler subset",
		"unsupported top-level declaration activate",
	]
	mut failure_index := 0
	while failure_index < failure_names.size()
		failure_project := workspace + "/gate6-file-root-" + failure_names[failure_index]
		try _gate6_reset_directory(failure_project)
		try _gate6_write_source(failure_project + "/main.trb", failure_entries[failure_index])
		if !failure_libraries[failure_index].empty?()
			try _gate6_write_source(failure_project + "/lib.trb", failure_libraries[failure_index])
		end
		mut compiler_index := 0
		while compiler_index < executables.size()
			try _gate6_expect_file_root_failure(
				executables[compiler_index],
				failure_project,
				failure_diagnostics[failure_index],
				failure_names[failure_index] + " compiler " + compiler_index.to_s(),
			)
			compiler_index += 1
		end
		failure_index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

describe("Gate 4 reference bootstrap") do
	test("builds B0 from the TypeRB compiler source and executes its checked entry") do
		root := _gate4_environment("TYPE_RB_NATIVE_ROOT")
		reference_trb := _gate4_environment("TYPE_RB_NATIVE_REFERENCE_TRB")
		qbe := _gate4_environment("TYPE_RB_NATIVE_QBE")
		if root.empty?() || reference_trb.empty?() || qbe.empty?()
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-gate4-bootstrap"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			compiler_source := case native_read_text(root + "/compiler/gate4/src/compiler.trb")
			when Result::Ok(source)
				source
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
				""
			end
			storage_source := case native_read_text(root + "/compiler/gate4/src/storage.trb")
			when Result::Ok(source)
				source
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
				""
			end
			path_source := case native_read_text(root + "/compiler/gate4/src/path.trb")
			when Result::Ok(source)
				source
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
				""
			end
			mir_source := case native_read_text(root + "/compiler/gate4/src/mir.trb")
			when Result::Ok(source)
				source
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
				""
			end
			literals_source := case native_read_text(root + "/compiler/gate4/src/literals.trb")
			when Result::Ok(source)
				source
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
				""
			end
			recovery_source := case gate6f_flatten_compiler_source(
					compiler_source,
					storage_source,
					path_source,
					mir_source,
					literals_source,
				)
			when Result::Ok(source)
				source
			when Result::Err(message)
				puts(message)
				expect(false).to_be_true()
				""
			end
			case native_write_text(workspace + "/compiler-recovery.trb", recovery_source)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			compiler_path := workspace + "/compiler.trb"
			case native_write_text(compiler_path, compiler_source)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case native_write_text(workspace + "/storage.trb", storage_source)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case native_write_text(workspace + "/path.trb", path_source)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case native_write_text(workspace + "/mir.trb", mir_source)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			case native_write_text(workspace + "/literals.trb", literals_source)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
			end
			matched_go_compiler := case build_matched_go_compiler(
					reference_trb,
					recovery_source,
					workspace,
				)
			when Result::Ok(path)
				path
			when Result::Err(error)
				puts(error.phase + ": " + error.message + "\n" + error.stderr)
				expect(false).to_be_true()
				""
			end
			snapshot := case Process.run(
					reference_trb,
					["compiler", "bootstrap-snapshot", "--snapshot-version", "4", compiler_path],
				)
			when Result::Ok(process)
				if !process.success
					puts(process.stderr)
				end
				expect(process.success).to_be_true()
				process.stdout
			when Result::Err(error)
				puts(error.operation + ": " + error.message)
				expect(false).to_be_true()
				""
			end
			expect(snapshot.to_bytes().size() > 4194304).to_be_true()
			case decode_gate3_snapshot(snapshot)
			when Result::Ok(_native_module)
				expect(false).to_be_true()
			when Result::Err(diagnostic)
				expect(diagnostic.code).to_equal("TRBN0005")
				expect(diagnostic.message).to_equal("snapshot exceeds the Gate 3 4 MiB input limit")
			end
			case decode_gate4_bootstrap_snapshot(snapshot)
			when Result::Ok(native_module)
				case build_gate4_bootstrap_executable(
						native_module,
						qbe,
						"/usr/bin/cc",
						workspace,
						workspace + "/b0",
					)
				when Result::Ok(_report)
					case Process.run(workspace + "/b0", [])
					when Result::Ok(usage)
						expect(usage.status).to_equal(64)
						expect(usage.stdout).to_equal("")
						expect(usage.stderr).to_equal(
							"usage: gate4-compiler --source-content MODE SOURCE\n",
						)
					when Result::Err(error)
						puts(error.operation + ": " + error.message)
						expect(false).to_be_true()
					end
					source := "def main()\n\tputs(\"ok\")\n\treturn\nend\n"
					case Process.run(workspace + "/b0", ["--source-content", "check", source])
					when Result::Ok(check)
						expect(check.success).to_be_true()
						expect(check.stdout).to_equal("ok\n")
						expect(check.stderr).to_equal("")
					when Result::Err(error)
						puts(error.operation + ": " + error.message)
						expect(false).to_be_true()
					end
					expect(
						_gate4_build_cycle(
							workspace + "/b0",
							recovery_source,
							compiler_path,
							qbe,
							workspace,
						),
					).to_be_true()
					case _gate6f_verify_compiler_source_closure(
							workspace + "/b1",
							compiler_path,
							compiler_source,
							storage_source,
							path_source,
							mir_source,
							literals_source,
							workspace,
						)
					when Result::Ok(_value)
						expect(true).to_be_true()
					when Result::Err(error)
						puts(error)
						expect(false).to_be_true()
					end
					case _gate6_verify_file_cli(workspace)
					when Result::Ok(_value)
						expect(true).to_be_true()
					when Result::Err(error)
						puts(error)
						expect(false).to_be_true()
					end
					case _gate6_verify_build_cli(workspace, qbe)
					when Result::Ok(_value)
						expect(true).to_be_true()
					when Result::Err(error)
						puts(error)
						expect(false).to_be_true()
					end
					case _gate6_verify_file_root_modules(root, workspace, qbe, reference_trb)
					when Result::Ok(_value)
						expect(true).to_be_true()
					when Result::Err(error)
						puts(error)
						expect(false).to_be_true()
					end
					case Process.run(
							"/bin/sh",
							[
								root + "/tools/gate5-normalize.sh",
								"/usr/bin/cc",
								workspace + "/b1.s",
								workspace + "/b2.s",
								workspace + "/normalized",
							],
						)
					when Result::Ok(normalization)
						if !normalization.success
							puts(normalization.stderr)
						end
						expect(normalization.success).to_be_true()
						expect(normalization.stdout.include?("normalization-policy,no-uuid-same-basename\n")).to_be_true()
					when Result::Err(error)
						puts(error.operation + ": " + error.message)
						expect(false).to_be_true()
					end
					case _gate4_verify_conformance(root, qbe, workspace, matched_go_compiler)
					when Result::Ok(_value)
						expect(true).to_be_true()
					when Result::Err(error)
						puts(error)
						expect(false).to_be_true()
					end
				when Result::Err(error)
					puts(error.phase + ": " + error.message + "\n" + error.stderr)
					expect(false).to_be_true()
				end
			when Result::Err(diagnostic)
				puts(diagnostic.code + " " + diagnostic.path + ": " + diagnostic.message)
				expect(false).to_be_true()
			end
		end
	end
end
