import { checked_program_source_import_prefix, compiler_source_has_import, gate6f_compiler_import_prefix, gate6f_flatten_compiler_source, mir_source_import_prefix, parser_source_import_prefix, resolution_source_import_prefix, state_source_import_prefix } from gate6f_compiler_source
import trb/std/result
import { describe, expect, test } from trb/std/test

describe("Gate 6F compiler source closure") do
	test("recognizes import tokens without rejecting identifiers or comments") do
		expect(compiler_source_has_import("import")).to_be_true()
		expect(compiler_source_has_import("\t import { item } from source\n")).to_be_true()
		expect(compiler_source_has_import("import_index := 0\nimportant := 1\nimport2 := 2\n")).to_be_false()
		expect(compiler_source_has_import("# import source\n\t# import other\n")).to_be_false()
	end

	test("derives one deterministic recovery source from the canonical modules") do
		entry := gate6f_compiler_import_prefix() + "def main()\n\treturn\nend\n"
		case gate6f_flatten_compiler_source(entry, "def storage()\n\treturn\nend\n", "def path()\n\treturn\nend\n", mir_source_import_prefix() + "def mir()\n\treturn\nend\n", "def literals()\n\treturn\nend\n", state_source_import_prefix() + "def state()\n\treturn\nend\n", parser_source_import_prefix() + "def parser()\n\treturn\nend\n", resolution_source_import_prefix() + "def resolution()\n\treturn\nend\n", checked_program_source_import_prefix() + "def checked_program()\n\treturn\nend\n")
		when Result::Ok(flattened)
			expect(flattened).to_equal(
				"def storage()\n\treturn\nend\n\ndef path()\n\treturn\nend\n\ndef literals()\n\treturn\nend\n\ndef mir()\n\treturn\nend\n\ndef state()\n\treturn\nend\n\ndef parser()\n\treturn\nend\n\ndef resolution()\n\treturn\nend\n\ndef checked_program()\n\treturn\nend\n\ndef main()\n\treturn\nend\n",
			)
		when Result::Err(message)
			puts(message)
			expect(false).to_be_true()
		end
	end

	test("rejects a changed compiler import boundary") do
		case gate6f_flatten_compiler_source("def main()\n\treturn\nend\n", "", "", "", "", "", "", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program")
		when Result::Ok(_flattened)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("compiler entry import boundary differs")
		end
	end

	test("rejects a missing or changed MIR import boundary") do
		entry := gate6f_compiler_import_prefix() + "def main()\n\treturn\nend\n"
		case gate6f_flatten_compiler_source(entry, "storage", "path", "import unknown\n", "literals", "", "", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program")
		when Result::Ok(_flattened)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("MIR source import boundary differs")
		end
	end

	test("rejects missing or changed state and parser import boundaries") do
		entry := gate6f_compiler_import_prefix() + "entry"
		invalid := ["", "import unknown\n"]
		mut index := 0
		while index < invalid.size()
			case gate6f_flatten_compiler_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", invalid[index], parser_source_import_prefix() + "parser", resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("State source import boundary differs")
			end
			case gate6f_flatten_compiler_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", invalid[index], resolution_source_import_prefix() + "resolution", checked_program_source_import_prefix() + "checked_program")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("Parser source import boundary differs")
			end
			index += 1
		end
	end

	test("rejects missing or changed semantic frontend import boundaries") do
		entry := gate6f_compiler_import_prefix() + "entry"
		invalid := ["", "import unknown\n"]
		mut index := 0
		while index < invalid.size()
			case gate6f_flatten_compiler_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", parser_source_import_prefix() + "parser", invalid[index], checked_program_source_import_prefix() + "checked_program")
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("Resolution source import boundary differs")
			end
			case gate6f_flatten_compiler_source(entry, "storage", "path", mir_source_import_prefix() + "mir", "literals", state_source_import_prefix() + "state", parser_source_import_prefix() + "parser", resolution_source_import_prefix() + "resolution", invalid[index])
			when Result::Ok(_flattened)
				expect(false).to_be_true()
			when Result::Err(message)
				expect(message).to_equal("Checked-program source import boundary differs")
			end
			index += 1
		end
	end

	test("rejects empty bodies and extra imports in every declaration source") do
		invalid := ["", "import other\n", "\timport{value}from other\n", "\rimport\tother\n", "import# comment\nother\n"]
		mut invalid_index := 0
		while invalid_index < invalid.size()
			mut slot := 0
			while slot < 9
				mut sources := ["def main()\n\treturn\nend\n", "storage", "path", "mir", "literals", "state", "parser", "resolution", "checked_program"]
				sources[slot] = invalid[invalid_index]
				case gate6f_flatten_compiler_source(gate6f_compiler_import_prefix() + sources[0], sources[1], sources[2], mir_source_import_prefix() + sources[3], sources[4], state_source_import_prefix() + sources[5], parser_source_import_prefix() + sources[6], resolution_source_import_prefix() + sources[7], checked_program_source_import_prefix() + sources[8])
				when Result::Ok(_flattened)
					expect(false).to_be_true()
				when Result::Err(message)
					expected := if invalid_index == 0
						"compiler declaration source is empty"
					else
						"compiler declaration source has an unexpected import"
					end
					expect(message).to_equal(expected)
				end
				slot += 1
			end
			invalid_index += 1
		end
	end
end
