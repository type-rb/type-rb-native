# Observable, well-typed source mutations for every canonical dependency.
# Each input must match exactly once; the recovery test requires changed QBE.
def compiler_recovery_mutations(): Array<Array<String>>
	return [
		["lambda_lowering", "fn has no analyzed body", "fn analysis is unavailable"],
		["mir_bindings", "capture requires its analyzed lexical binding storage", "capture requires its checked lexical storage"],
		["lambda_syntax", "duplicate fn parameter ", "repeated fn parameter "],
		["lambda_checking", "fn requires a resolved signature", "fn signature is unresolved"],
		["lambda_resolution", "invalid fn parameter type ", "unknown fn parameter type "],
		["callable_types", "generic_application(\"$Callable\", parts)", "generic_application(\"$ChangedCallable\", parts)"],
		["mir_callables", "MIR callable operand is undefined", "MIR callable operand is missing"],
		["qbe_callables", "mut arguments := \"\"", "mut arguments := \" \""],
		["alias_model", "\tparameters: Array<String>\n\ttarget: String", "\ttarget: String\n\tparameters: Array<String>"],
		["alias_syntax", "line: line, parameters:", "line: line + 1, parameters:"],
		["alias_patterns", "Generic#", "AliasTarget#"],
		["generic_bindings", "TypeParameter#function#", "ChangedParameter#function#"],
		["generic_functions", "generic function type argument count differs", "generic function type argument count is invalid"],
		["generic_program", "compiler_new(state.token_kinds.limit[0])", "compiler_new(state.token_kinds.limit[0] + 1)"],
		["generic_check", "abstract_generic_arguments(\"function\",", "abstract_generic_arguments(\"changed\","],
		["checked_body", "\tfunction: Integer\n\tgeneric_binding: Array<Integer>", "\tgeneric_binding: Array<Integer>\n\tfunction: Integer"],
		["standard_library", "<\" + name + \">", "[\" + name + \"]"],
		["result_model", "\torigin: Integer\n\toperand_finish: Integer", "\toperand_finish: Integer\n\torigin: Integer"],
		["result_checked", "try and catch require the standard Result<T, E>", "try and catch require a compiler-owned Result<T, E>"],
		["generic_model", "record GenericInstance\n\tdefinition: Integer\n\targuments: Array<String>", "record GenericInstance\n\targuments: Array<String>\n\tdefinition: Integer"],
		["generic_arguments", "mut depth := 0", "mut depth := 1"],
		["generic_syntax", "expected end for generic declaration ", "missing end for generic declaration "],
		["generic_validation", "invalid generic field type ", "unknown generic field type "],
		["declaration_lookup", "state.generic_definitions.size() - 1", "state.generic_definitions.size() - 2"],
		["type_resolution", "return \"Record#\" + integer_string(record_index)", "return \"Changed#\" + integer_string(record_index)"],
		["syntax_tokens", "unexpected token ", "unexpected syntax token "],
		["enum_model", "\torigin: Integer\n\tvariant: Integer", "\tvariant: Integer\n\torigin: Integer"],
		["enum_syntax", "expected end for enum ", "missing end for enum "],
		["enum_types", "Enum#", "Variant#"],
		["enum_checked", "enum case is not exhaustive", "enum case is incomplete"],
		["enum_mir", "MIR enum field is missing", "MIR enum field is absent"],
		["qbe_enums", "panic: enum payload is unavailable", "panic: enum payload is missing"],
		["checked_submission", "fact.presence == 1", "fact.presence == 2"],
		["nullable_types", "name.size() < 2", "name.size() < 3"],
		["nullable_mir", "MIR none result type differs", "MIR none type differs"],
		["nullable_flow", "cursor + 1 < finish", "cursor + 2 < finish"],
		["qbe_nullable", "panic: nil payload is unavailable", "panic: nil payload is missing"],
		["mir_value_control", "locals.mir_control[5] += 1", "locals.mir_control[5] += 2"],
		["default_arguments", "$default", "$initializer"],
		["argument_binding", "unknown named argument ", "unknown labelled argument "],
		["mir_numeric", "budget = [64, 6, 2]", "budget = [63, 6, 2]"],
		["mir_array_loops", "return block == owner", "return block != owner"],
		["checked_functions", "checker did not consume the complete function body", "checker did not consume the entire function body"],
		["mir_intrinsics", "MIR external adapter is invalid", "MIR external adapter is absent"],
		["qbe_calls", "index > 0", "index > 1"],
		["mir_hashes", "MIR Hash owner is undefined", "MIR Hash owner is absent"],
		["mir_hash_inference", "MIR Hash inference target is missing", "MIR Hash inference target is absent"],
		["qbe_hashes", "$trbn_hash_entries", "$trbn_hash_changed_entries"],
		["mir_ranges", "MIR Range component shape differs", "MIR Range component layout differs"],
		["qbe_ranges", "$trbn_desc_range", "$trbn_desc_changed_range"],
		["mir_iteration_control", "store_integer(locals.mir_values, saved, owner + 1)", "store_integer(locals.mir_values, saved, owner + 2)"],
		["lexer", "unsupported source character ", "unsupported lexical character "],
		["literals", "return parsed <= 1024", "return parsed <= 1023"],
		["mir", "MIR failure target does not exist", "MIR failure target is absent"],
		["iteration_syntax", "plan.body_finish >= token_count - 1", "plan.body_finish >= token_count - 2"],
		["iteration_mir", "plan.parent_loop < - 1", "plan.parent_loop < - 2"],
		["path", "\t\treturn \".\"\n", "\t\treturn \"./\"\n"],
		["hash_types", "Hash<Integer,", "Hash<Changed,"],
		["hash_mir", "mut capacity := 8", "mut capacity := 16"],
		["storage", "def storage_chunk_size(): Integer\n\treturn 256\nend\n", "def storage_chunk_size(): Integer\n\treturn 128\nend\n"],
		["state", "state.diagnostic_count[0] > 0", "state.diagnostic_count[0] > 1"],
		["parser", "unsupported top-level declaration ", "unsupported root declaration "],
		["checked_values", "return - value.category - 1", "return - value.category - 2"],
		["resolution", "unresolved function ", "unresolved callable "],
		["hash_checked", "invalid checked Hash operation", "invalid verified Hash operation"],
		["iteration_checked", "invalid checked iteration", "invalid verified iteration"],
		["mir_analysis", "mut limit := 67108864", "mut limit := 33554432"],
		["mir_construction", "parameter_start: parameter_start,", "parameter_start: parameter_start + 1,"],
		["mir_strings", "MIR String literal index is invalid", "MIR String literal index is missing"],
		["mir_roots", "return 12", "return 14"],
		["qbe_roots", "integer_string(index * 8)", "integer_string(index * 16)"],
		["qbe_strings", "$trbn_string_equal", "$trbn_string_comparison"],
		["mir_types", "MIR composite type is duplicated", "MIR composite identity is duplicated"],
		["mir_arrays", "MIR Array owner is undefined", "MIR Array owner is absent"],
		["qbe_arrays", "$trbn_array_push_paced", "$trbn_array_push_changed"],
		["mir_records", "MIR record owner is undefined", "MIR record owner is absent"],
		["qbe_records", "$trbn_desc_record", "$trbn_desc_changed_record"],
		["mir_identities", "definitions[key] = count + 1", "definitions[key] = count + 2"],
		["mir_flow", "MIR block identifier is duplicated", "MIR block identity is duplicated"],
		["mir_logical", "locals.mir_control[5] += 1", "locals.mir_control[5] += 2"],
		["mir_instructions", "MIR instruction origin is invalid", "MIR instruction source is invalid"],
		["mir_control", "control-flow MIR function has an unterminated path", "control-flow MIR path is incomplete"],
		["mir_calls", "MIR call effects or adapter differ", "MIR call effect contract differs"],
		["checked_types", "unsupported operator ", "unsupported binary operator "],
		["checked_program", "value is not directly callable", "value cannot be called directly"],
		["qbe_output", "output.count[0] = index + 1", "output.count[0] = index + 2"],
		["hash_runtime", "Hash key is missing", "Hash key was absent"],
		["mir_builder", "scalar MIR function has no return value", "scalar MIR return is absent"],
		["mir_passes", "payload = 13", "payload = 14"],
		["mir_verifier", "MIR function adapter kind is invalid", "MIR function adapter kind differs"],
		["project_config", "name is required", "project name is required"],
		["qbe_constants", "\n\t\tif line_bytes == 16", "\n\t\tif line_bytes == 15"],
		["qbe_context", "return \"d\"", "return \"s\""],
		["qbe_functions", "checked function has no MIR body", "checked MIR body is missing"],
		["qbe_numeric", "return \"@scalar_inline_integer_range_failure\"", "return \"@scalar_inline_integer_range_changed\""],
		["qbe_mir", "operator_id = 3", "operator_id = 4"],
		["qbe_control", "integer_string(target)", "integer_string(target + 1)"],
		["qbe_runtime", "data $trbn_gc_heap_target = align 8 { l 1048576 }", "data $trbn_gc_heap_target = align 8 { l 1048577 }"],
	]
end
