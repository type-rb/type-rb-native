import { native_read_text } from native_file_system
import trb/std/result

record RecoveryCompilerSources
	entry: String
	storage: String
	path: String
	mir: String
	literals: String
	state: String
	parser: String
	resolution: String
	checked_program: String
	qbe_output: String
	qbe_runtime: String
	project_config: String
	hash_types: String
	hash_mir: String
	hash_checked: String
	hash_runtime: String
	iteration_mir: String
	iteration_checked: String
	flattened: String
end

def compiler_source_import_prefix(): String
	return "import { IntegerStorage, StringStorage, integer_storage, load_integer, load_string, sparse_integer_at, store_integer, store_string, string_storage } from storage\nimport { path_basename, path_directory, path_join, string_ends_with, string_starts_with, string_without_suffix } from path\nimport { ascii_code, integer_string, number_is_float, number_without_underscores, small_nonnegative_integer_operand } from literals\nimport { mir_block_index, mir_function_index, mir_logical_short_value, mir_value_type, optimize_verified_mir, verify_mir } from mir\nimport { CompilerState, add_module, compiler_new, diagnostic, find_module, find_name_index, has_diagnostic, local_add, locals_new } from state\nimport { advance, binary_operator_id, declaration_start, expect, expect_identifier, finish_statement, parse_module, parse_statement_block, parse_type, skip_newlines, syntax_block_end, syntax_conditional_tail, syntax_expression_precedence, syntax_iteration_suffix, syntax_loop_transfer_kind, syntax_statement_boundary, token_is } from parser\nimport { array_element_type, array_type, common_array_element_type, find_field, find_function_in_module, find_record_type, find_visible_function, find_visible_record, import_path_value, normalize_import_path, record_type, resolve, resolve_type_name, standard_package_import, standard_package_root, standard_package_target, validate_import_usage } from resolution\nimport { check_block, checked_array_assignment_plan, checked_array_assignment_reads_old, checked_array_assignment_store, checked_array_assignment_target, checked_binary_plan_type, checked_loop_transfer_kind, mir_add_parameter, mir_nonnegative_fact, scalar_leaf_inline_eligible, scalar_mir_begin, scalar_mir_commit } from checked_program\nimport { QbeOutput, qbe_output_append, qbe_output_branch, qbe_output_chunk, qbe_output_line, qbe_output_new } from qbe_output\nimport { emit_boolean_puts_runtime, emit_float_array_runtime, emit_float_to_integer_runtime, emit_integer_to_string_runtime, emit_process_runtime, emit_qbe_runtime, emit_string_to_integer_runtime } from qbe_runtime\nimport { parse_project_config } from project_config\nimport { checked_hash_plan, checked_hash_require, checked_hash_valid, checked_hash_verify } from hash_checked\nimport { hash_key_type, native_managed_type } from hash_types\nimport { mir_hash_key_managed, mir_hash_value_managed } from hash_mir\nimport { emit_hash_runtime } from hash_runtime\nimport { checked_iteration_require, checked_range_require } from iteration_checked\n\n"
end

def mir_source_import_prefix(): String
	return "import { ascii_code, float_literal_in_range, number_is_float, small_nonnegative_integer_operand } from literals\n\n"
end

def state_source_import_prefix(): String
	return "import { MirIteration, MirRangeConstruction } from iteration_mir\nimport { integer_string } from literals\nimport { MirHashOperation } from hash_mir\nimport { IntegerStorage, StringStorage, integer_storage, load_integer, load_string, store_integer, store_string, string_storage } from storage\nimport { MirArrayOperation, MirInstruction, MirModule, MirValue } from mir\n\n"
end

def parser_source_import_prefix(): String
	return "import { MirIteration } from iteration_mir\nimport { load_integer, load_string, sparse_integer_at, store_integer, store_string } from storage\nimport { CompilerState, diagnostic, function_index_key, has_diagnostic, terminal_token } from state\n\n"
end

def resolution_source_import_prefix(): String
	return "import { hash_key_type, hash_type, hash_value_type } from hash_types\nimport { load_integer, load_string, store_integer, store_string } from storage\nimport { path_basename, path_directory, string_starts_with, string_without_suffix } from path\nimport { ascii_code, integer_string } from literals\nimport { CheckedLocals, CompilerState, diagnostic, find_name_index, function_index_key, has_diagnostic, local_find, locals_new, terminal_token } from state\nimport { syntax_loop_transfer_kind, token_is } from parser\n\n"
end

def checked_program_source_import_prefix(): String
	return "import { MirIteration, MirRangeConstruction, mir_iteration_valid } from iteration_mir\nimport { checked_iteration_require, checked_iteration_shape, checked_range_require, iteration_element_type } from iteration_checked\nimport { hash_key_type, hash_type, hash_value_type } from hash_types\nimport { mir_hash_operation } from hash_mir\nimport { checked_hash_binding_target, checked_hash_method, checked_hash_plan, checked_hash_publish } from hash_checked\nimport { load_integer, load_string, sparse_integer_at, store_integer, store_string } from storage\nimport { float_literal_in_range, integer_literal_in_range, number_is_float, small_nonnegative_integer_operand } from literals\nimport { MirArrayOperation, MirBlock, MirFunction, MirInstruction, MirLoopTransfer, MirValue, mir_array_assignment_plan, mir_array_assignment_valid, mir_array_element_type, mir_function_index, mir_instruction_with_payload, mir_logical_plan, mir_loop_transfer_valid } from mir\nimport { CheckedLocals, CompilerState, diagnostic, has_diagnostic, local_add, local_find, terminal_token } from state\nimport { advance, binary_operator_id, declaration_start, expect, expect_identifier, finish_statement, parse_type, skip_newlines, syntax_block_end, syntax_conditional_tail, syntax_expression_precedence, syntax_iteration_suffix, syntax_loop_transfer_kind, syntax_statement_boundary, token_is } from parser\nimport { array_element_type, array_type, common_array_element_type, find_field, find_record_type, find_visible_function, find_visible_record, record_type, resolve_type_name, standard_package_import, standard_package_root, type_display } from resolution\n\n"
end

def qbe_output_source_import_prefix(): String
	return "import { StringStorage, load_string, store_string, string_storage } from storage\n\n"
end

def qbe_runtime_source_import_prefix(): String
	return "import { string_starts_with } from path\nimport { QbeOutput, qbe_output_line } from qbe_output\n\n"
end

def project_config_source_import_prefix(): String
	return "import { ascii_code } from literals\n\n"
end

def hash_types_source_import_prefix(): String
	return "import { ascii_code } from literals\nimport { string_starts_with } from path\n\n"
end

def hash_mir_source_import_prefix(): String
	return "import { hash_key_type, hash_type, hash_value_type, native_managed_type, native_value_layout } from hash_types\n\n"
end

def hash_checked_source_import_prefix(): String
	return "import { array_element_type, find_record_type } from resolution\nimport { hash_key_type, hash_value_type } from hash_types\nimport { CompilerState, diagnostic } from state\nimport { load_integer, load_string, sparse_integer_at, store_integer } from storage\nimport { MirHashOperation, mir_hash_operation, mir_hash_valid } from hash_mir\nimport { token_is } from parser\n\n"
end

def hash_runtime_source_import_prefix(): String
	return "import { QbeOutput, qbe_output_line } from qbe_output\n\n"
end

def iteration_checked_source_import_prefix(): String
	return "import { MirIteration, MirRangeConstruction, mir_iteration_shape_valid, mir_iteration_valid, mir_range_valid } from iteration_mir\nimport { CompilerState, diagnostic } from state\nimport { load_integer, sparse_integer_at } from storage\nimport { syntax_iteration_suffix, token_is } from parser\nimport { array_element_type } from resolution\n\n"
end

def compiler_source_has_import(source: String): Boolean
	lines := source.split("\n")
	mut index := 0
	while index < lines.size()
		line := lines[index]
		mut start := 0
		while start < line.size() && (line[start] == " " || line[start] == "\t" || line[start] == "\r")
			start += 1
		end
		text := line.slice(start...line.size())
		if text.start_with?("import")
			if text.size() == 6 || !"_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".include?(text[6])
				return true
			end
		end
		index += 1
	end
	return false
end

def flatten_compiler_recovery_source(
		entry: String,
		storage: String,
		path: String,
		mir: String,
		literals: String,
		state: String,
		parser: String,
		resolution: String,
		checked_program: String,
		qbe_output: String,
		qbe_runtime: String,
		project_config: String,
		hash_types: String,
		hash_mir: String,
		hash_checked: String,
		hash_runtime: String,
		iteration_mir: String,
		iteration_checked: String,
	): Result<String, String>
	prefix := compiler_source_import_prefix()
	if !entry.start_with?(prefix)
		return Result<String, String>::Err("compiler entry import boundary differs")
	end
	core := entry.slice(prefix.size()...entry.size())
	mir_prefix := mir_source_import_prefix()
	if !mir.start_with?(mir_prefix)
		return Result<String, String>::Err("MIR source import boundary differs")
	end
	mir_core := mir.slice(mir_prefix.size()...mir.size())
	state_prefix := state_source_import_prefix()
	if !state.start_with?(state_prefix)
		return Result<String, String>::Err("State source import boundary differs")
	end
	state_core := state.slice(state_prefix.size()...state.size())
	parser_prefix := parser_source_import_prefix()
	if !parser.start_with?(parser_prefix)
		return Result<String, String>::Err("Parser source import boundary differs")
	end
	parser_core := parser.slice(parser_prefix.size()...parser.size())
	resolution_prefix := resolution_source_import_prefix()
	if !resolution.start_with?(resolution_prefix)
		return Result<String, String>::Err("Resolution source import boundary differs")
	end
	resolution_core := resolution.slice(resolution_prefix.size()...resolution.size())
	checked_program_prefix := checked_program_source_import_prefix()
	if !checked_program.start_with?(checked_program_prefix)
		return Result<String, String>::Err("Checked-program source import boundary differs")
	end
	checked_program_core := checked_program.slice(checked_program_prefix.size()...checked_program.size())
	qbe_output_prefix := qbe_output_source_import_prefix()
	if !qbe_output.start_with?(qbe_output_prefix)
		return Result<String, String>::Err("QBE-output source import boundary differs")
	end
	qbe_output_core := qbe_output.slice(qbe_output_prefix.size()...qbe_output.size())
	qbe_runtime_prefix := qbe_runtime_source_import_prefix()
	if !qbe_runtime.start_with?(qbe_runtime_prefix)
		return Result<String, String>::Err("QBE-runtime source import boundary differs")
	end
	qbe_runtime_core := qbe_runtime.slice(qbe_runtime_prefix.size()...qbe_runtime.size())
	project_config_prefix := project_config_source_import_prefix()
	if !project_config.start_with?(project_config_prefix)
		return Result<String, String>::Err("Project-configuration source import boundary differs")
	end
	project_config_core := project_config.slice(project_config_prefix.size()...project_config.size())
	hash_types_prefix := hash_types_source_import_prefix()
	if !hash_types.start_with?(hash_types_prefix)
		return Result<String, String>::Err("hash_types source import boundary differs")
	end
	hash_types_core := hash_types.slice(hash_types_prefix.size()...hash_types.size())
	hash_mir_prefix := hash_mir_source_import_prefix()
	if !hash_mir.start_with?(hash_mir_prefix)
		return Result<String, String>::Err("hash_mir source import boundary differs")
	end
	hash_mir_core := hash_mir.slice(hash_mir_prefix.size()...hash_mir.size())
	hash_checked_prefix := hash_checked_source_import_prefix()
	if !hash_checked.start_with?(hash_checked_prefix)
		return Result<String, String>::Err("hash_checked source import boundary differs")
	end
	hash_checked_core := hash_checked.slice(hash_checked_prefix.size()...hash_checked.size())
	hash_runtime_prefix := hash_runtime_source_import_prefix()
	if !hash_runtime.start_with?(hash_runtime_prefix)
		return Result<String, String>::Err("hash_runtime source import boundary differs")
	end
	hash_runtime_core := hash_runtime.slice(hash_runtime_prefix.size()...hash_runtime.size())
	iteration_checked_prefix := iteration_checked_source_import_prefix()
	if !iteration_checked.start_with?(iteration_checked_prefix)
		return Result<String, String>::Err("iteration_checked source import boundary differs")
	end
	iteration_checked_core := iteration_checked.slice(iteration_checked_prefix.size()...iteration_checked.size())
	declarations := [core, storage, path, mir_core, literals, state_core, parser_core, resolution_core, checked_program_core, qbe_output_core, qbe_runtime_core, project_config_core, hash_types_core, hash_mir_core, hash_checked_core, hash_runtime_core, iteration_mir, iteration_checked_core]
	mut index := 0
	while index < declarations.size()
		if declarations[index].empty?()
			return Result<String, String>::Err("compiler declaration source is empty")
		end
		if compiler_source_has_import(declarations[index])
			return Result<String, String>::Err("compiler declaration source has an unexpected import")
		end
		index += 1
	end
	return Result<String, String>::Ok(iteration_mir + "\n" + storage + "\n" + path + "\n" + literals + "\n" + mir_core + "\n" + state_core + "\n" + parser_core + "\n" + resolution_core + "\n" + iteration_checked_core + "\n" + checked_program_core + "\n" + qbe_output_core + "\n" + qbe_runtime_core + "\n" + project_config_core + "\n" + hash_types_core + "\n" + hash_mir_core + "\n" + hash_checked_core + "\n" + hash_runtime_core + "\n" + core)
end

def compiler_source_directory(path: String): String
	mut slash :=- 1
	mut index := 0
	while index < path.size()
		if path[index] == "/"
			slash = index
		end
		index += 1
	end
	if slash < 0
		return "."
	end
	if slash == 0
		return "/"
	end
	mut result := ""
	index = 0
	while index < slash
		result += path[index]
		index += 1
	end
	return result
end

def compiler_source_path(directory: String, filename: String): String
	if directory == "/"
		return directory + filename
	end
	return directory + "/" + filename
end

def read_required_compiler_source(path: String): Result<String, String>
	case native_read_text(path)
	when Result::Ok(source)
		return Result<String, String>::Ok(source)
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
end

def read_compiler_recovery_sources(entry_path: String): Result<RecoveryCompilerSources, String>
	directory := compiler_source_directory(entry_path)
	entry := try read_required_compiler_source(entry_path)
	storage := try read_required_compiler_source(compiler_source_path(directory, "storage.trb"))
	path := try read_required_compiler_source(compiler_source_path(directory, "path.trb"))
	mir := try read_required_compiler_source(compiler_source_path(directory, "mir.trb"))
	literals := try read_required_compiler_source(compiler_source_path(directory, "literals.trb"))
	state := try read_required_compiler_source(compiler_source_path(directory, "state.trb"))
	parser := try read_required_compiler_source(compiler_source_path(directory, "parser.trb"))
	resolution := try read_required_compiler_source(compiler_source_path(directory, "resolution.trb"))
	checked_program := try read_required_compiler_source(compiler_source_path(directory, "checked_program.trb"))
	qbe_output := try read_required_compiler_source(compiler_source_path(directory, "qbe_output.trb"))
	qbe_runtime := try read_required_compiler_source(compiler_source_path(directory, "qbe_runtime.trb"))
	project_config := try read_required_compiler_source(compiler_source_path(directory, "project_config.trb"))
	hash_types := try read_required_compiler_source(compiler_source_path(directory, "hash_types.trb"))
	hash_mir := try read_required_compiler_source(compiler_source_path(directory, "hash_mir.trb"))
	hash_checked := try read_required_compiler_source(compiler_source_path(directory, "hash_checked.trb"))
	hash_runtime := try read_required_compiler_source(compiler_source_path(directory, "hash_runtime.trb"))
	iteration_mir := try read_required_compiler_source(compiler_source_path(directory, "iteration_mir.trb"))
	iteration_checked := try read_required_compiler_source(compiler_source_path(directory, "iteration_checked.trb"))
	flattened := try flatten_compiler_recovery_source(entry, storage, path, mir, literals, state, parser, resolution, checked_program, qbe_output, qbe_runtime, project_config, hash_types, hash_mir, hash_checked, hash_runtime, iteration_mir, iteration_checked)
	return Result<RecoveryCompilerSources, String>::Ok(
		RecoveryCompilerSources.new(
			entry: entry,
			storage: storage,
			path: path,
			mir: mir,
			literals: literals,
			state: state,
			parser: parser,
			resolution: resolution,
			checked_program: checked_program,
			qbe_output: qbe_output,
			qbe_runtime: qbe_runtime,
			project_config: project_config,
			hash_types: hash_types,
			hash_mir: hash_mir,
			hash_checked: hash_checked,
			hash_runtime: hash_runtime,
			iteration_mir: iteration_mir,
			iteration_checked: iteration_checked,
			flattened: flattened,
		),
	)
end
