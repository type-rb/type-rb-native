import { Gate1Instruction, ScalarType } from gate1_mir
import { Gate3TypeDefinition, Gate3ValueType } from gate3_layout
import { Gate3Block, Gate3Function, Gate3Instruction, Gate3Module, Gate3ResultType, Gate3Terminator, verify_gate3_mir } from gate3_mir
import { build_gate3_executable } from gate3_toolchain
import { NativeSource } from native_mir
import { SourceOrigin } from snapshot
import { native_create_directory } from native_file_system
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

def _gate3_boolean_origin(): SourceOrigin
	return SourceOrigin.new(source_id: "main", start_line: 1, start_column: 1, end_line: 1, end_column: 8)
end

def _gate3_boolean_array_module(extra: Array<Gate3Instruction>, condition: String): Gate3Module
	origin := _gate3_boolean_origin()
	mut instructions := [
		Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("zero", 0, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::IntegerLiteral("last", - 1, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::BooleanLiteral("yes", true, origin)),
		Gate3Instruction::Scalar(Gate1Instruction::BooleanLiteral("no", false, origin)),
		Gate3Instruction::ArrayConstruct("values", "Array<Boolean>", ["no"], origin),
		Gate3Instruction::ArrayConstruct("groups", "Array<Array<Boolean>>", ["values"], origin),
		Gate3Instruction::RuntimeCollect(origin),
		Gate3Instruction::ArrayGet("selected", "Array<Array<Boolean>>", "groups", "zero", origin),
	]
	mut index := 0
	while index < extra.size()
		instructions.push(extra[index])
		index += 1
	end
	return Gate3Module.new(
		id: "boolean-array",
		entry_function: "boolean-array#main",
		sources: [NativeSource.new(id: "main", path: "src/main.trb")],
		types: [
			Gate3TypeDefinition::Array("Array<Boolean>", Gate3ValueType::Scalar(ScalarType::Boolean)),
			Gate3TypeDefinition::Array("Array<Array<Boolean>>", Gate3ValueType::Aggregate("Array<Boolean>")),
			Gate3TypeDefinition::Array("Array<Integer>", Gate3ValueType::Scalar(ScalarType::Integer)),
		],
		functions: [Gate3Function.new(
				id: "boolean-array#main", name: "main", parameters: [],
				result_type: Gate3ResultType::Void, entry: "entry", origin: origin,
				blocks: [
					Gate3Block.new(
						id: "entry", parameters: [], origin: origin, instructions: instructions,
						terminator: Gate3Terminator::Branch(condition, "success", [], "failure", [], origin),
					),
					Gate3Block.new(
						id: "success", parameters: [], origin: origin,
						instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("boolean-array-ok\n", origin))],
						terminator: Gate3Terminator::Return(nil, origin),
					),
					Gate3Block.new(
						id: "failure", parameters: [], origin: origin,
						instructions: [Gate3Instruction::Scalar(Gate1Instruction::WriteStatic("boolean-array-fail\n", origin))],
						terminator: Gate3Terminator::Return(nil, origin),
					),
				],
			)],
	)
end

describe("Gate 3 Boolean Array recovery") do
	test("rejects mismatched elements, indices, receivers and numeric uses") do
		origin := _gate3_boolean_origin()
		invalid := [
			Gate3Instruction::ArrayConstruct("wrong", "Array<Boolean>", ["zero"], origin),
			Gate3Instruction::ArrayPush("Array<Boolean>", "values", "zero", origin),
			Gate3Instruction::ArraySet("Array<Boolean>", "values", "zero", "zero", origin),
			Gate3Instruction::ArrayGet("wrong", "Array<Boolean>", "values", "yes", origin),
			Gate3Instruction::ArraySet("Array<Boolean>", "values", "yes", "yes", origin),
			Gate3Instruction::ArrayGet("wrong", "Array<Integer>", "values", "zero", origin),
			Gate3Instruction::ArrayPush("Array<Integer>", "values", "zero", origin),
		]
		mut index := 0
		while index < invalid.size()
			case verify_gate3_mir(_gate3_boolean_array_module([invalid[index]], "yes"))
			when Result::Ok(_value)
				expect(false).to_be_true()
			when Result::Err(diagnostic)
				expect(diagnostic.code).to_equal("TRBN0004")
				expect(diagnostic.message).to_equal("operand type does not match the operation")
			end
			index += 1
		end
		case verify_gate3_mir(_gate3_boolean_array_module([
						Gate3Instruction::ArrayGet("value", "Array<Boolean>", "values", "zero", origin),
						Gate3Instruction::ArrayGet("wrong", "Array<Boolean>", "values", "value", origin),
					], "yes"))
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0004")
			expect(diagnostic.message).to_equal("operand type does not match the operation")
		end
	end

	test("executes scalar storage and preserves nested arrays across collection") do
		origin := _gate3_boolean_origin()
		native_module := _gate3_boolean_array_module([
				Gate3Instruction::ArrayPush("Array<Boolean>", "selected", "no", origin),
				Gate3Instruction::ArraySet("Array<Boolean>", "selected", "last", "yes", origin),
				Gate3Instruction::RuntimeCollect(origin),
				Gate3Instruction::ArrayGet("actual", "Array<Boolean>", "selected", "last", origin),
			], "actual")
		case verify_gate3_mir(native_module)
		when Result::Ok(_value)
		when Result::Err(diagnostic)
			puts(diagnostic.path + ": " + diagnostic.message)
			expect(false).to_be_true()
		end
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			workspace := "/tmp/type-rb-native-gate3-boolean-array"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case build_gate3_executable(native_module, qbe, "/usr/bin/cc", workspace, workspace + "/sample")
			when Result::Ok(report)
				case Process.run(report.output_path, [])
				when Result::Ok(process)
					expect(process.success).to_be_true()
					expect(process.stdout).to_equal("boolean-array-ok\n")
					expect(process.stderr).to_equal("")
				when Result::Err(_error)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.phase + ": " + error.message + " " + error.stderr)
				expect(false).to_be_true()
			end
		end
	end
end
