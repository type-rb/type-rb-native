import { Gate3Module } from gate3_mir
import { emit_gate3_qbe, emit_gate3_qbe_with_runtime_report, emit_gate4_bootstrap_qbe } from qbe3
import { write_text } from trb/std/filesystem
import { run } from trb/std/process
import { Result } from trb/std/result
import { Instant } from trb/std/time

record Gate3BuildError
	phase: String
	message: String
	status: Integer? = nil
	stdout: String = ""
	stderr: String = ""
end

record Gate3BuildReport
	qbe_ir_path: String
	assembly_path: String
	output_path: String
	emit_seconds: Float
	qbe_seconds: Float
	link_seconds: Float
end

def build_gate3_executable(
		native_module: Gate3Module,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
	): Result<Gate3BuildReport, Gate3BuildError>
	return _build_gate3_executable(native_module, qbe_command, cc_command, workspace, output_path, false, false)
end

def build_gate3_instrumented_executable(
		native_module: Gate3Module,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
	): Result<Gate3BuildReport, Gate3BuildError>
	return _build_gate3_executable(native_module, qbe_command, cc_command, workspace, output_path, true, false)
end

def build_gate4_bootstrap_executable(
		native_module: Gate3Module,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
	): Result<Gate3BuildReport, Gate3BuildError>
	return _build_gate3_executable(native_module, qbe_command, cc_command, workspace, output_path, false, true)
end

def _build_gate3_executable(
		native_module: Gate3Module,
		qbe_command: String,
		cc_command: String,
		workspace: String,
		output_path: String,
		report_runtime: Boolean,
		gate4_bootstrap: Boolean,
	): Result<Gate3BuildReport, Gate3BuildError>
	emit_started := Instant.now()
	mut emit_result := emit_gate3_qbe(native_module)
	if report_runtime
		emit_result = emit_gate3_qbe_with_runtime_report(native_module)
	end
	if gate4_bootstrap
		emit_result = emit_gate4_bootstrap_qbe(native_module)
	end
	qbe_source := case emit_result
	when Result::Ok(source)
		source
	when Result::Err(diagnostic)
		return Result<Gate3BuildReport, Gate3BuildError>::Err(
			Gate3BuildError.new(
				phase: "verify",
				message: diagnostic.code + " " + diagnostic.path + ": " + diagnostic.message,
			)
		)
	end
	emit_seconds := Instant.now().duration_since(emit_started).total_seconds()
	qbe_ir_path := workspace + "/module.ssa"
	assembly_path := workspace + "/module.s"
	case write_text(qbe_ir_path, qbe_source)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Gate3BuildReport, Gate3BuildError>::Err(
			Gate3BuildError.new(phase: "write-qbe", message: error.operation + ": " + error.message)
		)
	end
	qbe_started := Instant.now()
	qbe_result := case run(qbe_command, ["-t", "arm64_apple", qbe_ir_path])
	when Result::Ok(process_result)
		process_result
	when Result::Err(error)
		return Result<Gate3BuildReport, Gate3BuildError>::Err(
			Gate3BuildError.new(phase: "qbe", message: error.operation + ": " + error.message)
		)
	end
	qbe_seconds := Instant.now().duration_since(qbe_started).total_seconds()
	if !qbe_result.success
		return Result<Gate3BuildReport, Gate3BuildError>::Err(
			Gate3BuildError.new(
				phase: "qbe",
				message: "QBE rejected the generated IL",
				status: qbe_result.status,
				stdout: qbe_result.stdout,
				stderr: qbe_result.stderr,
			)
		)
	end
	case write_text(assembly_path, qbe_result.stdout)
	when Result::Ok(_unit)
	when Result::Err(error)
		return Result<Gate3BuildReport, Gate3BuildError>::Err(
			Gate3BuildError.new(phase: "write-assembly", message: error.operation + ": " + error.message)
		)
	end
	link_started := Instant.now()
	cc_result := case run(cc_command, [assembly_path, "-Wl,-dead_strip", "-o", output_path])
	when Result::Ok(process_result)
		process_result
	when Result::Err(error)
		return Result<Gate3BuildReport, Gate3BuildError>::Err(
			Gate3BuildError.new(phase: "link", message: error.operation + ": " + error.message)
		)
	end
	link_seconds := Instant.now().duration_since(link_started).total_seconds()
	if !cc_result.success
		return Result<Gate3BuildReport, Gate3BuildError>::Err(
			Gate3BuildError.new(
				phase: "link",
				message: "the system C toolchain rejected the Gate 3 QBE assembly",
				status: cc_result.status,
				stdout: cc_result.stdout,
				stderr: cc_result.stderr,
			)
		)
	end
	return Result<Gate3BuildReport, Gate3BuildError>::Ok(
		Gate3BuildReport.new(
			qbe_ir_path: qbe_ir_path,
			assembly_path: assembly_path,
			output_path: output_path,
			emit_seconds: emit_seconds,
			qbe_seconds: qbe_seconds,
			link_seconds: link_seconds,
		)
	)
end
