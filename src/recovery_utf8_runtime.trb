import { qbe_line } from qbe

# Recovery owns a separate managed-object ABI. Decode external bytes with the
# same bounded UTF-8 rules as the ordinary runtime, including one-byte invalid
# sequences, before recording String code-point counts or indexing them.
def emit_recovery_utf8_runtime(mut writer: StringBuilder)
	qbe_line(writer, "\nfunction l $trbn_utf8_width(l %data, l %remaining) {\n@start\n %first =w loadub %data\n %low =w cultw %first, 194\n %high =w cugtw %first, 244\n %invalid =w or %low, %high\n jnz %invalid, @one, @classify\n@classify\n %two =w cultw %first, 224\n jnz %two, @two, @longer\n@two\n %two_short =w csltl %remaining, 2\n jnz %two_short, @one, @two_tail\n@two_tail\n %two_address =l add %data, 1\n %two_byte =w loadub %two_address\n %two_low =w cultw %two_byte, 128\n %two_high =w cugtw %two_byte, 191\n %two_bad =w or %two_low, %two_high\n jnz %two_bad, @one, @two_valid\n@two_valid\n ret 2\n@longer\n %three =w cultw %first, 240\n jnz %three, @three, @four\n@three\n %three_short =w csltl %remaining, 3\n jnz %three_short, @one, @three_tail\n@three_tail\n %three_a =l add %data, 1\n %three_b =l add %data, 2\n %second3 =w loadub %three_a\n %third3 =w loadub %three_b\n %second3_low =w cultw %second3, 128\n %second3_high =w cugtw %second3, 191\n %third3_low =w cultw %third3, 128\n %third3_high =w cugtw %third3, 191\n %second3_bad =w or %second3_low, %second3_high\n %third3_bad =w or %third3_low, %third3_high\n %tail3_bad =w or %second3_bad, %third3_bad\n %e0 =w ceqw %first, 224\n %overlong3 =w cultw %second3, 160\n %bad_e0 =w and %e0, %overlong3\n %ed =w ceqw %first, 237\n %surrogate =w cugtw %second3, 159\n %bad_ed =w and %ed, %surrogate\n %range3_bad =w or %bad_e0, %bad_ed\n %three_bad =w or %tail3_bad, %range3_bad\n jnz %three_bad, @one, @three_valid\n@three_valid\n ret 3\n@four\n %four_short =w csltl %remaining, 4\n jnz %four_short, @one, @four_tail\n@four_tail\n %four_a =l add %data, 1\n %four_b =l add %data, 2\n %four_c =l add %data, 3\n %second4 =w loadub %four_a\n %third4 =w loadub %four_b\n %fourth4 =w loadub %four_c\n %second4_low =w cultw %second4, 128\n %second4_high =w cugtw %second4, 191\n %third4_low =w cultw %third4, 128\n %third4_high =w cugtw %third4, 191\n %fourth4_low =w cultw %fourth4, 128\n %fourth4_high =w cugtw %fourth4, 191\n %second4_bad =w or %second4_low, %second4_high\n %third4_bad =w or %third4_low, %third4_high\n %fourth4_bad =w or %fourth4_low, %fourth4_high\n %middle4_bad =w or %second4_bad, %third4_bad\n %tail4_bad =w or %middle4_bad, %fourth4_bad\n %f0 =w ceqw %first, 240\n %overlong4 =w cultw %second4, 144\n %bad_f0 =w and %f0, %overlong4\n %f4 =w ceqw %first, 244\n %too_large =w cugtw %second4, 143\n %bad_f4 =w and %f4, %too_large\n %range4_bad =w or %bad_f0, %bad_f4\n %four_bad =w or %tail4_bad, %range4_bad\n jnz %four_bad, @one, @four_valid\n@four_valid\n ret 4\n@one\n ret 1\n}")
	qbe_line(writer, "\nfunction l $trbn_utf8_count(l %data, l %length) {\n@start\n jmp @loop\n@loop\n %offset =l phi @start 0, @advance %next\n %count =l phi @start 0, @advance %next_count\n %done =w cslel %length, %offset\n jnz %done, @finish, @read\n@read\n %address =l add %data, %offset\n %remaining =l sub %length, %offset\n %width =l call $trbn_utf8_width(l %address, l %remaining)\n %next =l add %offset, %width\n %next_count =l add %count, 1\n jmp @advance\n@advance\n jmp @loop\n@finish\n ret %count\n}")
	return
end
