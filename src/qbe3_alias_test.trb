import { build_gate3_executable } from gate3_toolchain
import { native_create_directory } from native_file_system
import { SourceOrigin } from snapshot
import trb/std/process
import { Gate1Instruction, ScalarType } from gate1_mir
import { Gate3TypeDefinition, Gate3ValueType } from gate3_layout
import { Gate3Block, Gate3Function, Gate3Instruction, Gate3Module, Gate3Parameter, Gate3ResultType, Gate3Terminator } from gate3_mir
import { NativeSource } from native_mir
import trb/std/result
import { describe, expect, test } from trb/std/test

def qbe3_alias_cycle_module(): Gate3Module
	origin := SourceOrigin.new(source_id: "main", start_line: 1, start_column: 1, end_line: 12, end_column: 4)
	type_name := Gate3ValueType::Aggregate("String")
	boolean_type := Gate3ValueType::Scalar(ScalarType::Boolean)
	function := Gate3Function.new(
		id: "main", name: "main", parameters: [], result_type: Gate3ResultType::Void, entry: "entry", origin: origin,
		blocks: [
			Gate3Block.new(id: "entry", parameters: [], origin: origin,
				instructions: [Gate3Instruction::StringLiteral("initial", "stable", origin), Gate3Instruction::Scalar(Gate1Instruction::BooleanLiteral("first", true, origin))],
				terminator: Gate3Terminator::Jump("header", ["initial", "first"], origin)),
			Gate3Block.new(id: "header", parameters: [Gate3Parameter.new(id: "header_value", value_type: type_name, origin: origin), Gate3Parameter.new(id: "take", value_type: boolean_type, origin: origin)], origin: origin, instructions: [],
				terminator: Gate3Terminator::Branch("take", "body", ["header_value"], "exit", ["header_value"], origin)),
			# The backedge precedes its predecessor in block storage order.
			Gate3Block.new(id: "backedge", parameters: [Gate3Parameter.new(id: "backedge_value", value_type: type_name, origin: origin)], origin: origin,
				instructions: [Gate3Instruction::WriteString("backedge_value", true, origin), Gate3Instruction::Scalar(Gate1Instruction::BooleanLiteral("last", false, origin))],
				terminator: Gate3Terminator::Jump("header", ["backedge_value", "last"], origin)),
			Gate3Block.new(id: "body", parameters: [Gate3Parameter.new(id: "body_value", value_type: type_name, origin: origin)], origin: origin, instructions: [],
				terminator: Gate3Terminator::Jump("backedge", ["body_value"], origin)),
			Gate3Block.new(id: "exit", parameters: [Gate3Parameter.new(id: "exit_value", value_type: type_name, origin: origin)], origin: origin, instructions: [Gate3Instruction::WriteString("exit_value", true, origin)],
				terminator: Gate3Terminator::Return(nil, origin)),
		],
	)
	return Gate3Module.new(id: "alias-cycle", entry_function: "main", sources: [NativeSource.new(id: "main", path: "src/main.trb")], types: [Gate3TypeDefinition::String("String")], functions: [function])
end

describe("Managed block-parameter aliases") do
	test("keeps the entry definition through a reordered invariant loop cycle") do
		qbe := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe != nil
			workspace := "/tmp/type-rb-native-gate3-alias-cycle"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(error)
				puts(error.message)
				expect(false).to_be_true()
			end
			case build_gate3_executable(qbe3_alias_cycle_module(), qbe, "/usr/bin/cc", workspace, workspace + "/sample")
			when Result::Ok(report)
				case Process.run(report.output_path, [])
				when Result::Ok(result)
					expect(result.status).to_equal(0)
					expect(result.stdout).to_equal("stable\nstable\n")
					expect(result.stderr).to_equal("")
				when Result::Err(error)
					puts(error.message)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.phase + ": " + error.message + "\n" + error.stderr)
				expect(false).to_be_true()
			end
		end
	end
end
