import { Diagnostic, boundary_diagnostic } from diagnostic
import {
	ComparisonOperator,
	FloatBinaryOperator,
	Gate1Instruction,
	IntegerBinaryOperator,
	ScalarType,
} from gate1_mir
import {
	Gate3Block,
	Gate3Function,
	Gate3Instruction,
	Gate3Module,
	Gate3Parameter,
	Gate3ResultType,
	Gate3Terminator,
	verify_gate3_mir,
} from gate3_mir
import {
	Gate3Field,
	Gate3TypeDefinition,
	Gate3ValueType,
	Gate3Variant,
} from gate3_layout
import { NativeSource } from native_mir
import {
	object,
	required_array,
	required_field,
	required_integer,
	required_string,
	strict_object,
} from json_boundary
import {
	decode_origin,
} from snapshot
import { JsonValue, parse } from trb/std/json
import { Result } from trb/std/result

GATE3_MAX_INPUT_BYTES := 4194304
GATE4_BOOTSTRAP_MAX_INPUT_BYTES := 33554432
GATE3_MAX_SOURCES := 256
GATE3_MAX_FUNCTIONS := 512
GATE3_SNAPSHOT_MAX_TYPES := 1024
GATE3_SNAPSHOT_MAX_FIELDS := 256
GATE3_SNAPSHOT_MAX_VARIANTS := 1024
GATE3_MAX_PARAMETERS := 256
GATE3_MAX_BLOCKS := 1024
GATE3_MAX_INSTRUCTIONS := 16384
GATE3_MAX_ARGUMENTS := 256
GATE4_BOOTSTRAP_MAX_ARRAY_ARGUMENTS := 1024
GATE3_MAX_STATIC_BYTES := 1048576
GATE3_MAX_IDENTIFIER_SIZE := 256
GATE3_MAX_SOURCE_PATH_SIZE := 4096

def decode_gate3_snapshot(source: String): Result<Gate3Module, Diagnostic>
	return _decode_gate3_snapshot(
		source,
		GATE3_MAX_INPUT_BYTES,
		"Gate 3 4 MiB",
		GATE3_MAX_ARGUMENTS,
	)
end

def decode_gate4_bootstrap_snapshot(source: String): Result<Gate3Module, Diagnostic>
	return _decode_gate3_snapshot(
		source,
		GATE4_BOOTSTRAP_MAX_INPUT_BYTES,
		"Gate 4 bootstrap 32 MiB",
		GATE4_BOOTSTRAP_MAX_ARRAY_ARGUMENTS,
	)
end

def _decode_gate3_snapshot(
		source: String,
		max_input_bytes: Integer,
		limit_name: String,
		max_array_arguments: Integer,
	): Result<Gate3Module, Diagnostic>
	if source.to_bytes().size() > max_input_bytes
		return Result<Gate3Module, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", "", "snapshot exceeds the " + limit_name + " input limit")
		)
	end
	root := case parse(source)
	when Result::Ok(value)
		value
	when Result::Err(error)
		return Result<Gate3Module, Diagnostic>::Err(
			Diagnostic.new(
				code: "TRBN0001",
				path: error.path,
				message: error.message,
				start_line: error.line,
				start_column: error.column,
			)
		)
	end
	fields := try strict_object(
		root,
		"",
		["format", "version", "module", "entryFunction", "sources", "types", "functions"],
	)
	format := try required_string(fields, "format", "", false)
	if format != "type-rb-bootstrap-snapshot"
		return Result<Gate3Module, Diagnostic>::Err(
			boundary_diagnostic("TRBN0003", "/format", "unsupported snapshot format")
		)
	end
	version := try required_integer(fields, "version", "")
	if version != 4
		return Result<Gate3Module, Diagnostic>::Err(
			boundary_diagnostic("TRBN0003", "/version", "unsupported Gate 3 snapshot version")
		)
	end
	source_values := try required_array(fields, "sources", "")
	if source_values.size() > GATE3_MAX_SOURCES
		return Result<Gate3Module, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", "/sources", "source count exceeds the Gate 3 limit")
		)
	end
	mut sources: Array<NativeSource> := []
	mut source_index := 0
	while source_index < source_values.size()
		sources.push(try _gate3_decode_source(source_values[source_index], "/sources/" + source_index.to_s()))
		source_index += 1
	end
	type_values := try required_array(fields, "types", "")
	if type_values.size() > GATE3_SNAPSHOT_MAX_TYPES
		return Result<Gate3Module, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", "/types", "type definition count exceeds the Gate 3 limit")
		)
	end
	mut types: Array<Gate3TypeDefinition> := []
	mut type_index := 0
	while type_index < type_values.size()
		types.push(try _gate3_decode_type_definition(type_values[type_index], "/types/" + type_index.to_s()))
		type_index += 1
	end
	function_values := try required_array(fields, "functions", "")
	if function_values.size() > GATE3_MAX_FUNCTIONS
		return Result<Gate3Module, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", "/functions", "function count exceeds the Gate 3 limit")
		)
	end
	mut functions: Array<Gate3Function> := []
	mut function_index := 0
	while function_index < function_values.size()
		functions.push(
			try _gate3_decode_function(
				function_values[function_index],
				"/functions/" + function_index.to_s(),
				max_array_arguments,
			)
		)
		function_index += 1
	end
	native_module := Gate3Module.new(
		id: try required_string(fields, "module", "", true),
		entry_function: try required_string(fields, "entryFunction", "", true),
		sources: sources,
		types: types,
		functions: functions,
	)
	try verify_gate3_mir(native_module)
	return Result<Gate3Module, Diagnostic>::Ok(native_module)
end

def _gate3_decode_type_definition(value: JsonValue, path: String): Result<Gate3TypeDefinition, Diagnostic>
	base_fields := try object(value, path)
	kind := try required_string(base_fields, "kind", path, false)
	if kind == "string"
		fields := try strict_object(value, path, ["kind", "id"])
		type_id := try required_string(fields, "id", path, true)
		if type_id != "String"
			return Result<Gate3TypeDefinition, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path + "/id", "String type must use the canonical String identifier")
			)
		end
		return Result<Gate3TypeDefinition, Diagnostic>::Ok(Gate3TypeDefinition::String(type_id))
	end
	if kind == "array"
		fields := try strict_object(value, path, ["kind", "id", "element"])
		return Result<Gate3TypeDefinition, Diagnostic>::Ok(
			Gate3TypeDefinition::Array(
				try required_string(fields, "id", path, true),
				try _gate3_decode_value_type(
					try required_string(fields, "element", path, false),
					path + "/element",
				),
			)
		)
	end
	if kind == "function"
		fields := try strict_object(value, path, ["kind", "id", "parameters", "result"])
		parameter_names := try _gate3_required_string_array(fields, "parameters", path)
		mut parameter_types: Array<Gate3ValueType> := []
		mut parameter_index := 0
		while parameter_index < parameter_names.size()
			parameter_types.push(
				try _gate3_decode_value_type(
					parameter_names[parameter_index],
					path + "/parameters/" + parameter_index.to_s(),
				)
			)
			parameter_index += 1
		end
		result_name := try required_string(fields, "result", path, false)
		mut result_type: Gate3ValueType? := nil
		if result_name != "Void"
			result_type = try _gate3_decode_value_type(result_name, path + "/result")
		end
		return Result<Gate3TypeDefinition, Diagnostic>::Ok(
			Gate3TypeDefinition::Function(
				try required_string(fields, "id", path, true),
				parameter_types,
				result_type,
			)
		)
	end
	if kind == "record"
		fields := try strict_object(value, path, ["kind", "id", "fields"])
		return Result<Gate3TypeDefinition, Diagnostic>::Ok(
			Gate3TypeDefinition::Record(
				try required_string(fields, "id", path, true),
				try _gate3_decode_fields(try required_array(fields, "fields", path), path + "/fields"),
			)
		)
	end
	if kind == "tagged"
		fields := try strict_object(value, path, ["kind", "id", "variants"])
		variant_values := try required_array(fields, "variants", path)
		if variant_values.size() > GATE3_SNAPSHOT_MAX_VARIANTS
			return Result<Gate3TypeDefinition, Diagnostic>::Err(
				boundary_diagnostic("TRBN0005", path + "/variants", "variant count exceeds the Gate 3 limit")
			)
		end
		mut variants: Array<Gate3Variant> := []
		mut index := 0
		while index < variant_values.size()
			variant_path := path + "/variants/" + index.to_s()
			variant_fields := try strict_object(variant_values[index], variant_path, ["name", "fields"])
			variants.push(
				Gate3Variant.new(
					name: try required_string(variant_fields, "name", variant_path, true),
					fields: try _gate3_decode_fields(
						try required_array(variant_fields, "fields", variant_path),
						variant_path + "/fields",
					),
				)
			)
			index += 1
		end
		return Result<Gate3TypeDefinition, Diagnostic>::Ok(
			Gate3TypeDefinition::Tagged(
				try required_string(fields, "id", path, true),
				variants,
			)
		)
	end
	return Result<Gate3TypeDefinition, Diagnostic>::Err(
		boundary_diagnostic("TRBN0003", path + "/kind", "unsupported Gate 3 type definition")
	)
end

def _gate3_decode_fields(values: Array<JsonValue>, path: String): Result<Array<Gate3Field>, Diagnostic>
	if values.size() > GATE3_SNAPSHOT_MAX_FIELDS
		return Result<Array<Gate3Field>, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path, "field count exceeds the Gate 3 limit")
		)
	end
	mut fields: Array<Gate3Field> := []
	mut index := 0
	while index < values.size()
		field_path := path + "/" + index.to_s()
		item := try strict_object(values[index], field_path, ["name", "type"])
		fields.push(
			Gate3Field.new(
				name: try required_string(item, "name", field_path, true),
				value_type: try _gate3_decode_value_type(
					try required_string(item, "type", field_path, false),
					field_path + "/type",
				),
			)
		)
		index += 1
	end
	return Result<Array<Gate3Field>, Diagnostic>::Ok(fields)
end

def _gate3_decode_source(value: JsonValue, path: String): Result<NativeSource, Diagnostic>
	fields := try strict_object(value, path, ["id", "path"])
	source_path := try required_string(fields, "path", path, false)
	if source_path.empty?()
		return Result<NativeSource, Diagnostic>::Err(
			boundary_diagnostic("TRBN0004", path + "/path", "source path must not be empty")
		)
	end
	if source_path.size() > GATE3_MAX_SOURCE_PATH_SIZE
		return Result<NativeSource, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path + "/path", "source path exceeds the Gate 3 limit")
		)
	end
	return Result<NativeSource, Diagnostic>::Ok(
		NativeSource.new(
			id: try required_string(fields, "id", path, true),
			path: source_path,
		)
	)
end

def _gate3_decode_function(
		value: JsonValue,
		path: String,
		max_array_arguments: Integer,
	): Result<Gate3Function, Diagnostic>
	fields := try strict_object(
		value,
		path,
		["id", "name", "captures", "parameters", "result", "entry", "origin", "blocks"],
	)
	capture_values := try required_array(fields, "captures", path)
	if capture_values.size() > GATE3_MAX_PARAMETERS
		return Result<Gate3Function, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path + "/captures", "capture count exceeds the Gate 3 limit")
		)
	end
	mut captures: Array<Gate3Parameter> := []
	mut capture_index := 0
	while capture_index < capture_values.size()
		captures.push(
			try _gate3_decode_parameter(capture_values[capture_index], path + "/captures/" + capture_index.to_s())
		)
		capture_index += 1
	end
	parameter_values := try required_array(fields, "parameters", path)
	if parameter_values.size() > GATE3_MAX_PARAMETERS
		return Result<Gate3Function, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path + "/parameters", "parameter count exceeds the Gate 3 limit")
		)
	end
	mut parameters: Array<Gate3Parameter> := []
	mut parameter_index := 0
	while parameter_index < parameter_values.size()
		parameters.push(
			try _gate3_decode_parameter(parameter_values[parameter_index], path + "/parameters/" + parameter_index.to_s())
		)
		parameter_index += 1
	end
	block_values := try required_array(fields, "blocks", path)
	if block_values.size() > GATE3_MAX_BLOCKS
		return Result<Gate3Function, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path + "/blocks", "block count exceeds the Gate 3 limit")
		)
	end
	mut blocks: Array<Gate3Block> := []
	mut block_index := 0
	while block_index < block_values.size()
		blocks.push(
			try _gate3_decode_block(
				block_values[block_index],
				path + "/blocks/" + block_index.to_s(),
				max_array_arguments,
			)
		)
		block_index += 1
	end
	return Result<Gate3Function, Diagnostic>::Ok(
		Gate3Function.new(
			id: try required_string(fields, "id", path, true),
			name: try required_string(fields, "name", path, true),
			parameters: parameters,
			result_type: try _gate3_decode_result_type(
				try required_string(fields, "result", path, false),
				path + "/result",
			),
			entry: try required_string(fields, "entry", path, true),
			origin: try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			blocks: blocks,
			captures: captures,
		)
	)
end

def _gate3_decode_parameter(value: JsonValue, path: String): Result<Gate3Parameter, Diagnostic>
	fields := try strict_object(value, path, ["id", "type", "origin"])
	return Result<Gate3Parameter, Diagnostic>::Ok(
		Gate3Parameter.new(
			id: try required_string(fields, "id", path, true),
			value_type: try _gate3_decode_value_type(
				try required_string(fields, "type", path, false),
				path + "/type",
			),
			origin: try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
		)
	)
end

def _gate3_decode_value_type(name: String, path: String): Result<Gate3ValueType, Diagnostic>
	if name == "Boolean"
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Boolean))
	end
	if name == "Integer"
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Integer))
	end
	if name == "Float"
		return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Scalar(ScalarType::Float))
	end
	if name.empty?() || name == "Void"
		return Result<Gate3ValueType, Diagnostic>::Err(
			boundary_diagnostic("TRBN0003", path, "unsupported Gate 3 value type")
		)
	end
	return Result<Gate3ValueType, Diagnostic>::Ok(Gate3ValueType::Aggregate(name))
end

def _gate3_decode_result_type(name: String, path: String): Result<Gate3ResultType, Diagnostic>
	if name == "Void"
		return Result<Gate3ResultType, Diagnostic>::Ok(Gate3ResultType::Void)
	end
	return Result<Gate3ResultType, Diagnostic>::Ok(
		Gate3ResultType::Value(try _gate3_decode_value_type(name, path))
	)
end

def _gate3_decode_block(
		value: JsonValue,
		path: String,
		max_array_arguments: Integer,
	): Result<Gate3Block, Diagnostic>
	fields := try strict_object(value, path, ["id", "parameters", "origin", "instructions", "terminator"])
	parameter_values := try required_array(fields, "parameters", path)
	if parameter_values.size() > GATE3_MAX_PARAMETERS
		return Result<Gate3Block, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path + "/parameters", "block parameter count exceeds the Gate 3 limit")
		)
	end
	mut parameters: Array<Gate3Parameter> := []
	mut parameter_index := 0
	while parameter_index < parameter_values.size()
		parameters.push(
			try _gate3_decode_parameter(parameter_values[parameter_index], path + "/parameters/" + parameter_index.to_s())
		)
		parameter_index += 1
	end
	instruction_values := try required_array(fields, "instructions", path)
	if instruction_values.size() > GATE3_MAX_INSTRUCTIONS
		return Result<Gate3Block, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path + "/instructions", "instruction count exceeds the Gate 3 limit")
		)
	end
	mut instructions: Array<Gate3Instruction> := []
	mut instruction_index := 0
	while instruction_index < instruction_values.size()
		instructions.push(
			try _gate3_decode_instruction(
				instruction_values[instruction_index],
				path + "/instructions/" + instruction_index.to_s(),
				max_array_arguments,
			)
		)
		instruction_index += 1
	end
	return Result<Gate3Block, Diagnostic>::Ok(
		Gate3Block.new(
			id: try required_string(fields, "id", path, true),
			parameters: parameters,
			origin: try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			instructions: instructions,
			terminator: try _gate3_decode_terminator(try required_field(fields, "terminator", path), path + "/terminator"),
		)
	)
end

def _gate3_decode_instruction(
		value: JsonValue,
		path: String,
		max_array_arguments: Integer,
	): Result<Gate3Instruction, Diagnostic>
	base_fields := try object(value, path)
	op := try required_string(base_fields, "op", path, false)
	if op == "boolean_literal"
		fields := try strict_object(value, path, ["op", "result", "value", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(
				Gate1Instruction::BooleanLiteral(
					try required_string(fields, "result", path, true),
					try _gate3_required_boolean(fields, "value", path),
					try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
				)
			)
		)
	end
	if op == "integer_literal"
		fields := try strict_object(value, path, ["op", "result", "value", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(
				Gate1Instruction::IntegerLiteral(
					try required_string(fields, "result", path, true),
					try required_integer(fields, "value", path),
					try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
				)
			)
		)
	end
	if op == "float_literal"
		fields := try strict_object(value, path, ["op", "result", "value", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(
				Gate1Instruction::FloatLiteral(
					try required_string(fields, "result", path, true),
					try _gate3_required_float(fields, "value", path),
					try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
				)
			)
		)
	end
	if op == "integer_binary"
		fields := try strict_object(value, path, ["op", "result", "operator", "left", "right", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(
				Gate1Instruction::IntegerBinary(
					try required_string(fields, "result", path, true),
					try _gate3_integer_operator(try required_string(fields, "operator", path, false), path + "/operator"),
					try required_string(fields, "left", path, true),
					try required_string(fields, "right", path, true),
					try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
				)
			)
		)
	end
	if op == "float_binary"
		fields := try strict_object(value, path, ["op", "result", "operator", "left", "right", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(
				Gate1Instruction::FloatBinary(
					try required_string(fields, "result", path, true),
					try _gate3_float_operator(try required_string(fields, "operator", path, false), path + "/operator"),
					try required_string(fields, "left", path, true),
					try required_string(fields, "right", path, true),
					try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
				)
			)
		)
	end
	if op == "integer_compare" || op == "float_compare"
		fields := try strict_object(value, path, ["op", "result", "operator", "left", "right", "origin"])
		result := try required_string(fields, "result", path, true)
		operator := try _gate3_comparison_operator(try required_string(fields, "operator", path, false), path + "/operator")
		left := try required_string(fields, "left", path, true)
		right := try required_string(fields, "right", path, true)
		origin := try decode_origin(try required_field(fields, "origin", path), path + "/origin")
		if op == "integer_compare"
			return Result<Gate3Instruction, Diagnostic>::Ok(
				Gate3Instruction::Scalar(Gate1Instruction::IntegerCompare(result, operator, left, right, origin))
			)
		end
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(Gate1Instruction::FloatCompare(result, operator, left, right, origin))
		)
	end
	if op == "boolean_not"
		fields := try strict_object(value, path, ["op", "result", "value", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(
				Gate1Instruction::BooleanNot(
					try required_string(fields, "result", path, true),
					try required_string(fields, "value", path, true),
					try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
				)
			)
		)
	end
	if op == "string_literal"
		fields := try strict_object(value, path, ["op", "result", "value", "origin"])
		literal := try required_string(fields, "value", path, false)
		if literal.to_bytes().size() > GATE3_MAX_STATIC_BYTES
			return Result<Gate3Instruction, Diagnostic>::Err(
				boundary_diagnostic("TRBN0005", path + "/value", "String literal exceeds the Gate 3 limit")
			)
		end
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::StringLiteral(
				try required_string(fields, "result", path, true),
				literal,
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "string_concat" || op == "string_equal"
		fields := try strict_object(value, path, ["op", "result", "left", "right", "origin"])
		result := try required_string(fields, "result", path, true)
		left := try required_string(fields, "left", path, true)
		right := try required_string(fields, "right", path, true)
		origin := try decode_origin(try required_field(fields, "origin", path), path + "/origin")
		if op == "string_concat"
			return Result<Gate3Instruction, Diagnostic>::Ok(Gate3Instruction::StringConcat(result, left, right, origin))
		end
		return Result<Gate3Instruction, Diagnostic>::Ok(Gate3Instruction::StringEqual(result, left, right, origin))
	end
	if op == "string_size"
		fields := try strict_object(value, path, ["op", "result", "value", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::StringSize(
				try required_string(fields, "result", path, true),
				try required_string(fields, "value", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "string_index"
		fields := try strict_object(value, path, ["op", "result", "value", "index", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::StringIndex(
				try required_string(fields, "result", path, true),
				try required_string(fields, "value", path, true),
				try required_string(fields, "index", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "write_string"
		fields := try strict_object(value, path, ["op", "value", "newline", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::WriteString(
				try required_string(fields, "value", path, true),
				try _gate3_required_boolean(fields, "newline", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "array_construct"
		fields := try strict_object(value, path, ["op", "result", "type", "arguments", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::ArrayConstruct(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try _gate3_required_string_array_with_limit(
					fields,
					"arguments",
					path,
					max_array_arguments,
				),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "array_size"
		fields := try strict_object(value, path, ["op", "result", "type", "array", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::ArraySize(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try required_string(fields, "array", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "array_get"
		fields := try strict_object(value, path, ["op", "result", "type", "array", "index", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::ArrayGet(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try required_string(fields, "array", path, true),
				try required_string(fields, "index", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "array_set"
		fields := try strict_object(value, path, ["op", "type", "array", "index", "value", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::ArraySet(
				try required_string(fields, "type", path, true),
				try required_string(fields, "array", path, true),
				try required_string(fields, "index", path, true),
				try required_string(fields, "value", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "array_push"
		fields := try strict_object(value, path, ["op", "type", "array", "value", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::ArrayPush(
				try required_string(fields, "type", path, true),
				try required_string(fields, "array", path, true),
				try required_string(fields, "value", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "closure_construct"
		fields := try strict_object(value, path, ["op", "result", "type", "function", "captures", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::ClosureConstruct(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try required_string(fields, "function", path, true),
				try _gate3_required_string_array(fields, "captures", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "closure_call"
		fields := try strict_object(value, path, ["op", "result", "type", "closure", "arguments", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::ClosureCall(
				try _gate3_required_nullable_string(fields, "result", path),
				try required_string(fields, "type", path, true),
				try required_string(fields, "closure", path, true),
				try _gate3_required_string_array(fields, "arguments", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "record_construct"
		fields := try strict_object(value, path, ["op", "result", "type", "arguments", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::RecordConstruct(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try _gate3_required_string_array(fields, "arguments", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "record_project"
		fields := try strict_object(value, path, ["op", "result", "type", "record", "field", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::RecordProject(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try required_string(fields, "record", path, true),
				try required_string(fields, "field", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "variant_construct"
		fields := try strict_object(value, path, ["op", "result", "type", "variant", "arguments", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::VariantConstruct(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try required_string(fields, "variant", path, true),
				try _gate3_required_string_array(fields, "arguments", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "variant_test"
		fields := try strict_object(value, path, ["op", "result", "type", "value", "variant", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::VariantTest(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try required_string(fields, "value", path, true),
				try required_string(fields, "variant", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "variant_project"
		fields := try strict_object(value, path, ["op", "result", "type", "value", "variant", "field", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::VariantProject(
				try required_string(fields, "result", path, true),
				try required_string(fields, "type", path, true),
				try required_string(fields, "value", path, true),
				try required_string(fields, "variant", path, true),
				try required_string(fields, "field", path, true),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "call"
		fields := try strict_object(value, path, ["op", "result", "function", "arguments", "origin"])
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Call(
				try _gate3_required_nullable_string(fields, "result", path),
				try required_string(fields, "function", path, true),
				try _gate3_required_string_array(fields, "arguments", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "write_static"
		fields := try strict_object(value, path, ["op", "value", "origin"])
		static_value := try required_string(fields, "value", path, false)
		if static_value.to_bytes().size() > GATE3_MAX_STATIC_BYTES
			return Result<Gate3Instruction, Diagnostic>::Err(
				boundary_diagnostic("TRBN0005", path + "/value", "static output exceeds the Gate 3 limit")
			)
		end
		return Result<Gate3Instruction, Diagnostic>::Ok(
			Gate3Instruction::Scalar(
				Gate1Instruction::WriteStatic(
					static_value,
					try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
				)
			)
		)
	end
	return Result<Gate3Instruction, Diagnostic>::Err(
		boundary_diagnostic("TRBN0003", path + "/op", "unsupported Gate 3 instruction")
	)
end

def _gate3_decode_terminator(value: JsonValue, path: String): Result<Gate3Terminator, Diagnostic>
	base_fields := try object(value, path)
	op := try required_string(base_fields, "op", path, false)
	if op == "jump"
		fields := try strict_object(value, path, ["op", "target", "arguments", "origin"])
		return Result<Gate3Terminator, Diagnostic>::Ok(
			Gate3Terminator::Jump(
				try required_string(fields, "target", path, true),
				try _gate3_required_string_array(fields, "arguments", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "branch"
		fields := try strict_object(
			value,
			path,
			["op", "condition", "whenTrue", "trueArguments", "whenFalse", "falseArguments", "origin"],
		)
		return Result<Gate3Terminator, Diagnostic>::Ok(
			Gate3Terminator::Branch(
				try required_string(fields, "condition", path, true),
				try required_string(fields, "whenTrue", path, true),
				try _gate3_required_string_array(fields, "trueArguments", path),
				try required_string(fields, "whenFalse", path, true),
				try _gate3_required_string_array(fields, "falseArguments", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	if op == "return"
		fields := try strict_object(value, path, ["op", "value", "origin"])
		return Result<Gate3Terminator, Diagnostic>::Ok(
			Gate3Terminator::Return(
				try _gate3_required_nullable_string(fields, "value", path),
				try decode_origin(try required_field(fields, "origin", path), path + "/origin"),
			)
		)
	end
	return Result<Gate3Terminator, Diagnostic>::Err(
		boundary_diagnostic("TRBN0003", path + "/op", "unsupported Gate 3 terminator")
	)
end

def _gate3_integer_operator(name: String, path: String): Result<IntegerBinaryOperator, Diagnostic>
	if name == "add"
		return Result<IntegerBinaryOperator, Diagnostic>::Ok(IntegerBinaryOperator::Add)
	end
	if name == "subtract"
		return Result<IntegerBinaryOperator, Diagnostic>::Ok(IntegerBinaryOperator::Subtract)
	end
	if name == "multiply"
		return Result<IntegerBinaryOperator, Diagnostic>::Ok(IntegerBinaryOperator::Multiply)
	end
	if name == "divide"
		return Result<IntegerBinaryOperator, Diagnostic>::Ok(IntegerBinaryOperator::Divide)
	end
	if name == "remainder"
		return Result<IntegerBinaryOperator, Diagnostic>::Ok(IntegerBinaryOperator::Remainder)
	end
	if name == "power"
		return Result<IntegerBinaryOperator, Diagnostic>::Ok(IntegerBinaryOperator::Power)
	end
	return Result<IntegerBinaryOperator, Diagnostic>::Err(
		boundary_diagnostic("TRBN0003", path, "unsupported Gate 3 Integer operator")
	)
end

def _gate3_float_operator(name: String, path: String): Result<FloatBinaryOperator, Diagnostic>
	if name == "add"
		return Result<FloatBinaryOperator, Diagnostic>::Ok(FloatBinaryOperator::Add)
	end
	if name == "subtract"
		return Result<FloatBinaryOperator, Diagnostic>::Ok(FloatBinaryOperator::Subtract)
	end
	if name == "multiply"
		return Result<FloatBinaryOperator, Diagnostic>::Ok(FloatBinaryOperator::Multiply)
	end
	if name == "divide"
		return Result<FloatBinaryOperator, Diagnostic>::Ok(FloatBinaryOperator::Divide)
	end
	return Result<FloatBinaryOperator, Diagnostic>::Err(
		boundary_diagnostic("TRBN0003", path, "unsupported Gate 3 Float operator")
	)
end

def _gate3_comparison_operator(name: String, path: String): Result<ComparisonOperator, Diagnostic>
	if name == "equal"
		return Result<ComparisonOperator, Diagnostic>::Ok(ComparisonOperator::Equal)
	end
	if name == "not_equal"
		return Result<ComparisonOperator, Diagnostic>::Ok(ComparisonOperator::NotEqual)
	end
	if name == "less_than"
		return Result<ComparisonOperator, Diagnostic>::Ok(ComparisonOperator::LessThan)
	end
	if name == "less_than_or_equal"
		return Result<ComparisonOperator, Diagnostic>::Ok(ComparisonOperator::LessThanOrEqual)
	end
	if name == "greater_than"
		return Result<ComparisonOperator, Diagnostic>::Ok(ComparisonOperator::GreaterThan)
	end
	if name == "greater_than_or_equal"
		return Result<ComparisonOperator, Diagnostic>::Ok(ComparisonOperator::GreaterThanOrEqual)
	end
	return Result<ComparisonOperator, Diagnostic>::Err(
		boundary_diagnostic("TRBN0003", path, "unsupported Gate 3 comparison operator")
	)
end

def _gate3_required_boolean(
		fields: Hash<String, JsonValue>,
		name: String,
		path: String,
	): Result<Boolean, Diagnostic>
	value := try required_field(fields, name, path)
	case value
	when JsonValue::Boolean(result)
		return Result<Boolean, Diagnostic>::Ok(result)
	else
		return Result<Boolean, Diagnostic>::Err(
			boundary_diagnostic("TRBN0002", path + "/" + name, "expected a boolean")
		)
	end
end

def _gate3_required_float(
		fields: Hash<String, JsonValue>,
		name: String,
		path: String,
	): Result<Float, Diagnostic>
	value := try required_field(fields, name, path)
	case value
	when JsonValue::Float(result)
		return Result<Float, Diagnostic>::Ok(result)
	when JsonValue::Integer(result)
		return Result<Float, Diagnostic>::Ok(result.to_f())
	else
		return Result<Float, Diagnostic>::Err(
			boundary_diagnostic("TRBN0002", path + "/" + name, "expected a number")
		)
	end
end

def _gate3_required_nullable_string(
		fields: Hash<String, JsonValue>,
		name: String,
		path: String,
	): Result<String?, Diagnostic>
	value := try required_field(fields, name, path)
	case value
	when JsonValue::Null
		return Result<String?, Diagnostic>::Ok(nil)
	when JsonValue::String(result)
		if result.empty?()
			return Result<String?, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path + "/" + name, "identifier must not be empty")
			)
		end
		if result.size() > GATE3_MAX_IDENTIFIER_SIZE
			return Result<String?, Diagnostic>::Err(
				boundary_diagnostic("TRBN0005", path + "/" + name, "identifier exceeds the Gate 3 limit")
			)
		end
		return Result<String?, Diagnostic>::Ok(result)
	else
		return Result<String?, Diagnostic>::Err(
			boundary_diagnostic("TRBN0002", path + "/" + name, "expected a string or null")
		)
	end
end

def _gate3_required_string_array(
		fields: Hash<String, JsonValue>,
		name: String,
		path: String,
	): Result<Array<String>, Diagnostic>
	return _gate3_required_string_array_with_limit(fields, name, path, GATE3_MAX_ARGUMENTS)
end

def _gate3_required_string_array_with_limit(
		fields: Hash<String, JsonValue>,
		name: String,
		path: String,
		max_arguments: Integer,
	): Result<Array<String>, Diagnostic>
	values := try required_array(fields, name, path)
	if values.size() > max_arguments
		return Result<Array<String>, Diagnostic>::Err(
			boundary_diagnostic("TRBN0005", path + "/" + name, "argument count exceeds the Gate 3 limit")
		)
	end
	mut result: Array<String> := []
	mut index := 0
	while index < values.size()
		case values[index]
		when JsonValue::String(item)
			if item.empty?()
				return Result<Array<String>, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/" + name + "/" + index.to_s(), "identifier must not be empty")
				)
			end
			if item.size() > GATE3_MAX_IDENTIFIER_SIZE
				return Result<Array<String>, Diagnostic>::Err(
					boundary_diagnostic(
						"TRBN0005",
						path + "/" + name + "/" + index.to_s(),
						"identifier exceeds the Gate 3 limit",
					)
				)
			end
			result.push(item)
		else
			return Result<Array<String>, Diagnostic>::Err(
				boundary_diagnostic("TRBN0002", path + "/" + name + "/" + index.to_s(), "expected a string")
			)
		end
		index += 1
	end
	return Result<Array<String>, Diagnostic>::Ok(result)
end
