import { gate5_go_driver_import, gate5_go_driver_source, gate5_matched_go_source, gate5_recover_canonical_source } from gate5_matched_driver
import trb/std/result
import { describe, expect, test } from trb/std/test

describe("Gate 5 matched Go compiler driver") do
	test("changes only the import and empty main driver") do
		mut canonical := "def compiler_main(source: String, mode: String, file_mode: Boolean): Integer\n"
		canonical += "\tputs(source + mode + file_mode.to_s())\n"
		canonical += "\treturn 0\n"
		canonical += "end\n\n"
		canonical += "def main()\n"
		canonical += "\treturn\n"
		canonical += "end\n"
		case gate5_matched_go_source(canonical)
		when Result::Ok(transformed)
			expect(transformed.start_with?(gate5_go_driver_import())).to_be_true()
			expect(transformed.end_with?(gate5_go_driver_source())).to_be_true()
			case gate5_recover_canonical_source(transformed)
			when Result::Ok(recovered)
				expect(recovered).to_equal(canonical)
			when Result::Err(message)
				puts(message)
				expect(false).to_be_true()
			end
		when Result::Err(message)
			puts(message)
			expect(false).to_be_true()
		end
	end

	test("rejects a compiler source without the exact empty main driver") do
		case gate5_matched_go_source("def main()\n\tputs(\"active\")\n\treturn\nend\n")
		when Result::Ok(_source)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("compiler source must end with the exact empty main() driver")
		end
	end

	test("rejects a transformed source with a changed driver boundary") do
		case gate5_recover_canonical_source(
				gate5_go_driver_import() + "def main()\n\treturn\nend\n",
			)
		when Result::Ok(_source)
			expect(false).to_be_true()
		when Result::Err(message)
			expect(message).to_equal("matched source is missing the exact argv driver")
		end
	end
end
