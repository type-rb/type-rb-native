import { RecoveryManagedField, RecoveryManagedTypeDefinition, RecoveryManagedValueType, RecoveryManagedVariant } from recovery_managed_layout
import { RecoveryManagedBlock, RecoveryManagedFunction, RecoveryManagedInstruction, RecoveryManagedModule, RecoveryManagedResultType, RecoveryManagedTerminator } from recovery_managed_mir
import { build_recovery_managed_executable } from recovery_managed_toolchain
import { NativeSource } from native_mir
import { SourceOrigin } from snapshot
import { native_create_directory } from native_file_system
import trb/std/process
import trb/std/result
import { describe, expect, test } from trb/std/test

def _recovery_managed_managed_aggregate_origin(): SourceOrigin
	return SourceOrigin.new(
		source_id: "main",
		start_line: 1,
		start_column: 1,
		end_line: 12,
		end_column: 4,
	)
end

def _recovery_managed_managed_aggregate_module(): RecoveryManagedModule
	origin := _recovery_managed_managed_aggregate_origin()
	string_type := RecoveryManagedValueType::Aggregate("String")
	box_type := RecoveryManagedValueType::Aggregate("managed#Box")
	return RecoveryManagedModule.new(
		id: "managed-aggregate",
		entry_function: "managed#main",
		sources: [NativeSource.new(id: "main", path: "src/main.trb")],
		types: [
			RecoveryManagedTypeDefinition::String("String"),
			RecoveryManagedTypeDefinition::Record(
				"managed#Box",
				[RecoveryManagedField.new(name: "text", value_type: string_type)],
			),
			RecoveryManagedTypeDefinition::Tagged(
				"managed#MaybeBox",
				[
					RecoveryManagedVariant.new(
						name: "Found",
						fields: [RecoveryManagedField.new(name: "box", value_type: box_type)],
					),
					RecoveryManagedVariant.new(name: "None", fields: []),
				],
			),
		],
		functions: [
			RecoveryManagedFunction.new(
				id: "managed#main",
				name: "main",
				parameters: [],
				result_type: RecoveryManagedResultType::Void,
				entry: "entry",
				origin: origin,
				blocks: [
					RecoveryManagedBlock.new(
						id: "entry",
						parameters: [],
						origin: origin,
						instructions: [
							RecoveryManagedInstruction::StringLiteral("text", "managed aggregate", origin),
							RecoveryManagedInstruction::RecordConstruct("box", "managed#Box", ["text"], origin),
							RecoveryManagedInstruction::VariantConstruct(
								"maybe",
								"managed#MaybeBox",
								"Found",
								["box"],
								origin,
							),
							RecoveryManagedInstruction::RuntimeCollect(origin),
							RecoveryManagedInstruction::VariantProject(
								"projectedBox",
								"managed#MaybeBox",
								"maybe",
								"Found",
								"box",
								origin,
							),
							RecoveryManagedInstruction::RecordProject(
								"projectedText",
								"managed#Box",
								"projectedBox",
								"text",
								origin,
							),
							RecoveryManagedInstruction::WriteString("projectedText", true, origin),
						],
						terminator: RecoveryManagedTerminator::Return(nil, origin),
					),
				],
			),
		],
	)
end

describe("Managed recovery managed aggregate runtime") do
	test("keeps reference-containing records and tagged values live through collection") do
		qbe_command := Process.environment("TYPE_RB_NATIVE_QBE")
		if qbe_command == nil
			expect(true).to_be_true()
		else
			workspace := "/tmp/type-rb-native-recovery-managed-managed-aggregate"
			case native_create_directory(workspace)
			when Result::Ok(_unit)
			when Result::Err(_error)
			end
			case build_recovery_managed_executable(
					_recovery_managed_managed_aggregate_module(),
					qbe_command,
					"/usr/bin/cc",
					workspace,
					workspace + "/sample",
				)
			when Result::Ok(report)
				case Process.run(report.output_path, [])
				when Result::Ok(process)
					expect(process.success).to_be_true()
					expect(process.stdout).to_equal("managed aggregate\n")
					expect(process.stderr).to_equal("")
				when Result::Err(_error)
					expect(false).to_be_true()
				end
			when Result::Err(error)
				puts(error.phase + ": " + error.message + "\n" + error.stderr)
				expect(false).to_be_true()
			end
		end
	end
end
