import { Diagnostic, boundary_diagnostic } from diagnostic
import { RecoveryScalarInstruction, ScalarType } from recovery_scalar_mir
import { AggregateFieldLayout, AggregateLayout, AggregateLayoutKind, AggregateTypeDefinition, AggregateValueType, AggregateVariantLayout, aggregate_field_layout, aggregate_value_types_equal, aggregate_variant_field_layout, aggregate_variant_layout, compute_aggregate_layout, verify_aggregate_layouts } from aggregate_layout
import { NativeSource } from native_mir
import { SourceOrigin } from snapshot
import trb/std/result

record RecoveryAggregateParameter
	id: String
	value_type: AggregateValueType
	origin: SourceOrigin
end

enum RecoveryAggregateResultType
	Void
	Value(value_type: AggregateValueType)
end

enum RecoveryAggregateInstruction
	Scalar(instruction: RecoveryScalarInstruction)
	RecordConstruct(
		result: String,
		type_id: String,
		arguments: Array<String>,
		origin: SourceOrigin,
	)
	RecordProject(
		result: String,
		type_id: String,
		record: String,
			field: String,
			origin: SourceOrigin,
		)
		VariantConstruct(
			result: String,
			type_id: String,
			variant: String,
			arguments: Array<String>,
			origin: SourceOrigin,
		)
		VariantTest(
			result: String,
			type_id: String,
			value: String,
			variant: String,
			origin: SourceOrigin,
		)
		VariantProject(
			result: String,
			type_id: String,
			value: String,
			variant: String,
			field: String,
			origin: SourceOrigin,
		)
		Call(result: String?, function_id: String, arguments: Array<String>, origin: SourceOrigin)
	end

	enum RecoveryAggregateTerminator
		Jump(target: String, arguments: Array<String>, origin: SourceOrigin)
		Branch(
			condition: String,
			when_true: String,
			true_arguments: Array<String>,
			when_false: String,
			false_arguments: Array<String>,
			origin: SourceOrigin,
		)
		Return(value: String?, origin: SourceOrigin)
	end

	record RecoveryAggregateBlock
		id: String
		parameters: Array<RecoveryAggregateParameter>
		origin: SourceOrigin
		instructions: Array<RecoveryAggregateInstruction>
		terminator: RecoveryAggregateTerminator
	end

	record RecoveryAggregateFunction
		id: String
		name: String
		parameters: Array<RecoveryAggregateParameter>
		result_type: RecoveryAggregateResultType
		entry: String
		origin: SourceOrigin
		blocks: Array<RecoveryAggregateBlock>
	end

	record RecoveryAggregateModule
		id: String
		entry_function: String
		sources: Array<NativeSource>
		types: Array<AggregateTypeDefinition>
		functions: Array<RecoveryAggregateFunction>
	end

	record RecoveryAggregateDefinition
		id: String
		value_type: AggregateValueType
	end

	def recovery_aggregate_result_types_equal(left: RecoveryAggregateResultType, right: RecoveryAggregateResultType): Boolean
		case left
		when RecoveryAggregateResultType::Void
			case right
			when RecoveryAggregateResultType::Void
				return true
			when RecoveryAggregateResultType::Value(_right_type)
				return false
			end
		when RecoveryAggregateResultType::Value(left_type)
			case right
			when RecoveryAggregateResultType::Void
				return false
			when RecoveryAggregateResultType::Value(right_type)
				return aggregate_value_types_equal(left_type, right_type)
			end
		end
	end

	def verify_recovery_aggregate_mir(native_module: RecoveryAggregateModule): Result<Boolean, Diagnostic>
		if native_module.sources.empty?()
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", "/sources", "Aggregate recovery MIR must declare at least one source")
			)
		end
		if native_module.functions.empty?()
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", "/functions", "Aggregate recovery MIR must contain at least one function")
			)
		end
		try verify_aggregate_layouts(native_module.types)
		mut source_ids: Array<String> := []
		mut index := 0
		while index < native_module.sources.size()
			source := native_module.sources[index]
			if source_ids.include?(source.id)
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", "/sources/" + index.to_s() + "/id", "Aggregate recovery MIR source identifier is duplicated")
				)
			end
			source_ids.push(source.id)
			index += 1
		end
		mut function_ids: Hash<String, Boolean> := {}
		index = 0
		while index < native_module.functions.size()
			function := native_module.functions[index]
			path := "/functions/" + index.to_s()
			if function.id.empty?() || function_ids.key?(function.id)
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/id", "Aggregate recovery MIR function identifier is empty or duplicated")
				)
			end
			function_ids[function.id] = true
			try _recovery_aggregate_verify_origin(function.origin, source_ids, path + "/origin")
			index += 1
		end
		entry := recovery_aggregate_function(native_module.functions, native_module.entry_function)
		if entry == nil
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", "/entryFunction", "Aggregate recovery MIR entry function does not exist")
			)
		end
		if !entry.parameters.empty?()
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", "/entryFunction", "Aggregate recovery MIR entry function must take no arguments")
			)
		end
		case entry.result_type
		when RecoveryAggregateResultType::Void
		when RecoveryAggregateResultType::Value(_value_type)
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", "/entryFunction", "Aggregate recovery MIR entry function must return Void")
			)
		end
		index = 0
		while index < native_module.functions.size()
			try _recovery_aggregate_verify_function(
				native_module,
				native_module.functions[index],
				source_ids,
				"/functions/" + index.to_s(),
			)
			index += 1
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_verify_function(
			native_module: RecoveryAggregateModule,
			function: RecoveryAggregateFunction,
			source_ids: Array<String>,
			path: String,
		): Result<Boolean, Diagnostic>
		if function.blocks.empty?()
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path + "/blocks", "Aggregate recovery MIR function has no blocks")
			)
		end
		mut definitions: Hash<String, AggregateValueType> := {}
		mut index := 0
		while index < function.parameters.size()
			parameter := function.parameters[index]
			parameter_path := path + "/parameters/" + index.to_s()
			try _recovery_aggregate_verify_origin(parameter.origin, source_ids, parameter_path + "/origin")
			try _recovery_aggregate_define(definitions, parameter.id, parameter.value_type, parameter_path + "/id")
			index += 1
		end
		mut block_ids: Hash<String, Boolean> := {}
		mut entry_found := false
		index = 0
		while index < function.blocks.size()
			block := function.blocks[index]
			block_path := path + "/blocks/" + index.to_s()
			if block.id.empty?() || block_ids.key?(block.id)
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", block_path + "/id", "Aggregate recovery MIR block identifier is empty or duplicated")
				)
			end
			block_ids[block.id] = true
			if block.id == function.entry
				entry_found = true
				if !block.parameters.empty?()
					return Result<Boolean, Diagnostic>::Err(
						boundary_diagnostic("TRBN0004", block_path + "/parameters", "entry block must not have parameters")
					)
				end
			end
			try _recovery_aggregate_verify_origin(block.origin, source_ids, block_path + "/origin")
			mut parameter_index := 0
			while parameter_index < block.parameters.size()
				parameter := block.parameters[parameter_index]
				parameter_path := block_path + "/parameters/" + parameter_index.to_s()
				try _recovery_aggregate_verify_origin(parameter.origin, source_ids, parameter_path + "/origin")
				try _recovery_aggregate_define(definitions, parameter.id, parameter.value_type, parameter_path + "/id")
				parameter_index += 1
			end
			mut instruction_index := 0
			while instruction_index < block.instructions.size()
				instruction_path := block_path + "/instructions/" + instruction_index.to_s()
				definition := try _recovery_aggregate_instruction_definition(native_module, block.instructions[instruction_index], instruction_path)
				if definition != nil
					try _recovery_aggregate_define(definitions, definition.id, definition.value_type, instruction_path + "/result")
				end
				instruction_index += 1
			end
			index += 1
		end
		if !entry_found
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path + "/entry", "Aggregate recovery MIR entry block does not exist")
			)
		end
		index = 0
		while index < function.blocks.size()
			try _recovery_aggregate_verify_block(
				native_module,
				function,
				function.blocks[index],
				definitions,
				source_ids,
				path + "/blocks/" + index.to_s(),
			)
			index += 1
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_instruction_definition(
			native_module: RecoveryAggregateModule,
			instruction: RecoveryAggregateInstruction,
			path: String,
		): Result<RecoveryAggregateDefinition?, Diagnostic>
		case instruction
		when RecoveryAggregateInstruction::Scalar(scalar)
			case scalar
			when RecoveryScalarInstruction::BooleanLiteral(result, _value, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Boolean))
			when RecoveryScalarInstruction::IntegerLiteral(result, _value, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Integer))
			when RecoveryScalarInstruction::FloatLiteral(result, _value, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Float))
			when RecoveryScalarInstruction::IntegerBinary(result, _operator, _left, _right, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Integer))
			when RecoveryScalarInstruction::FloatBinary(result, _operator, _left, _right, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Float))
			when RecoveryScalarInstruction::IntegerCompare(result, _operator, _left, _right, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Boolean))
			when RecoveryScalarInstruction::FloatCompare(result, _operator, _left, _right, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Boolean))
			when RecoveryScalarInstruction::BooleanNot(result, _value, _origin)
				return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Boolean))
			when RecoveryScalarInstruction::Call(_result, _function_id, _arguments, _origin)
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path, "Scalar recovery call must be normalized to a Aggregate recovery call")
				)
			when RecoveryScalarInstruction::WriteStatic(_value, _origin)
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Ok(nil)
			end
		when RecoveryAggregateInstruction::RecordConstruct(result, type_id, _arguments, _origin)
			layout := try compute_aggregate_layout(native_module.types, type_id)
			if layout.kind != AggregateLayoutKind::Record
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/type", "record construction requires a record type")
				)
			end
			return _recovery_aggregate_some_definition(result, AggregateValueType::Aggregate(type_id))
		when RecoveryAggregateInstruction::RecordProject(result, type_id, _record, field, _origin)
			layout := try compute_aggregate_layout(native_module.types, type_id)
			field_layout := aggregate_field_layout(layout, field)
			if layout.kind != AggregateLayoutKind::Record || field_layout == nil
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/field", "record projection references an unknown field")
				)
			end
			return _recovery_aggregate_some_definition(result, field_layout.value_type)
		when RecoveryAggregateInstruction::VariantConstruct(result, type_id, variant, _arguments, _origin)
			layout := try compute_aggregate_layout(native_module.types, type_id)
			if layout.kind != AggregateLayoutKind::Tagged || aggregate_variant_layout(layout, variant) == nil
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/variant", "variant construction references an unknown variant")
				)
			end
			return _recovery_aggregate_some_definition(result, AggregateValueType::Aggregate(type_id))
		when RecoveryAggregateInstruction::VariantTest(result, _type_id, _value, _variant, _origin)
			return _recovery_aggregate_some_definition(result, AggregateValueType::Scalar(ScalarType::Boolean))
		when RecoveryAggregateInstruction::VariantProject(result, type_id, _value, variant, field, _origin)
			layout := try compute_aggregate_layout(native_module.types, type_id)
			variant_layout := aggregate_variant_layout(layout, variant)
			if layout.kind != AggregateLayoutKind::Tagged
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/variant", "variant projection requires a tagged type")
				)
			end
			if variant_layout == nil
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/variant", "variant projection references an unknown variant")
				)
			end
			field_layout := aggregate_variant_field_layout(variant_layout, field)
			if field_layout == nil
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/field", "variant projection references an unknown field")
				)
			end
			return _recovery_aggregate_some_definition(result, field_layout.value_type)
		when RecoveryAggregateInstruction::Call(result, function_id, _arguments, _origin)
			callee := recovery_aggregate_function(native_module.functions, function_id)
			if callee == nil
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/function", "call references an unknown function")
				)
			end
			case callee.result_type
			when RecoveryAggregateResultType::Void
				if result != nil
					return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
						boundary_diagnostic("TRBN0004", path + "/result", "Void call must not define a result")
					)
				end
				return Result<RecoveryAggregateDefinition?, Diagnostic>::Ok(nil)
			when RecoveryAggregateResultType::Value(value_type)
				if result == nil
					return Result<RecoveryAggregateDefinition?, Diagnostic>::Err(
						boundary_diagnostic("TRBN0004", path + "/result", "non-Void call must define a result")
					)
				end
				return _recovery_aggregate_some_definition(result, value_type)
			end
		end
	end

	def _recovery_aggregate_verify_block(
			native_module: RecoveryAggregateModule,
			function: RecoveryAggregateFunction,
			block: RecoveryAggregateBlock,
			definitions: Hash<String, AggregateValueType>,
			source_ids: Array<String>,
			path: String,
		): Result<Boolean, Diagnostic>
		mut available: Hash<String, AggregateValueType> := {}
		mut index := 0
		while index < function.parameters.size()
			parameter := function.parameters[index]
			available[parameter.id] = parameter.value_type
			index += 1
		end
		index = 0
		while index < block.parameters.size()
			parameter := block.parameters[index]
			available[parameter.id] = parameter.value_type
			index += 1
		end
		index = 0
		while index < block.instructions.size()
			instruction := block.instructions[index]
			instruction_path := path + "/instructions/" + index.to_s()
			try _recovery_aggregate_verify_instruction(native_module, instruction, available, source_ids, instruction_path)
			definition := try _recovery_aggregate_instruction_definition(native_module, instruction, instruction_path)
			if definition != nil
				available[definition.id] = definitions.fetch(definition.id)
			end
			index += 1
		end
		try _recovery_aggregate_verify_terminator(native_module, function, block.terminator, available, source_ids, path + "/terminator")
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_verify_instruction(
			native_module: RecoveryAggregateModule,
			instruction: RecoveryAggregateInstruction,
			available: Hash<String, AggregateValueType>,
			source_ids: Array<String>,
			path: String,
		): Result<Boolean, Diagnostic>
		case instruction
		when RecoveryAggregateInstruction::Scalar(scalar)
			return _recovery_aggregate_verify_scalar(scalar, available, source_ids, path)
		when RecoveryAggregateInstruction::RecordConstruct(_result, type_id, arguments, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			layout := try compute_aggregate_layout(native_module.types, type_id)
			try _recovery_aggregate_require_arguments(available, arguments, layout.fields, path + "/arguments")
		when RecoveryAggregateInstruction::RecordProject(_result, type_id, record, field, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require(available, record, AggregateValueType::Aggregate(type_id), path + "/record")
			layout := try compute_aggregate_layout(native_module.types, type_id)
			if layout.kind != AggregateLayoutKind::Record || aggregate_field_layout(layout, field) == nil
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/field", "record projection references an unknown field")
				)
			end
		when RecoveryAggregateInstruction::VariantConstruct(_result, type_id, variant, arguments, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			layout := try compute_aggregate_layout(native_module.types, type_id)
			variant_layout := aggregate_variant_layout(layout, variant)
			if layout.kind != AggregateLayoutKind::Tagged || variant_layout == nil
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/variant", "variant construction references an unknown variant")
				)
			end
			try _recovery_aggregate_require_arguments(available, arguments, variant_layout.fields, path + "/arguments")
		when RecoveryAggregateInstruction::VariantTest(_result, type_id, value, variant, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require(available, value, AggregateValueType::Aggregate(type_id), path + "/value")
			layout := try compute_aggregate_layout(native_module.types, type_id)
			if layout.kind != AggregateLayoutKind::Tagged || aggregate_variant_layout(layout, variant) == nil
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/variant", "variant test references an unknown variant")
				)
			end
		when RecoveryAggregateInstruction::VariantProject(_result, type_id, value, variant, field, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require(available, value, AggregateValueType::Aggregate(type_id), path + "/value")
			layout := try compute_aggregate_layout(native_module.types, type_id)
			variant_layout := aggregate_variant_layout(layout, variant)
			if layout.kind != AggregateLayoutKind::Tagged
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/variant", "variant projection requires a tagged type")
				)
			end
			if variant_layout == nil
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/variant", "variant projection references an unknown variant")
				)
			end
			if aggregate_variant_field_layout(variant_layout, field) == nil
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/field", "variant projection references an unknown field")
				)
			end
		when RecoveryAggregateInstruction::Call(_result, function_id, arguments, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			callee := recovery_aggregate_function(native_module.functions, function_id)
			if callee == nil
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/function", "call references an unknown function")
				)
			end
			if arguments.size() != callee.parameters.size()
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/arguments", "call argument count does not match the callee")
				)
			end
			mut index := 0
			while index < arguments.size()
				try _recovery_aggregate_require(available, arguments[index], callee.parameters[index].value_type, path + "/arguments/" + index.to_s())
				index += 1
			end
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_verify_scalar(
			instruction: RecoveryScalarInstruction,
			available: Hash<String, AggregateValueType>,
			source_ids: Array<String>,
			path: String,
		): Result<Boolean, Diagnostic>
		case instruction
		when RecoveryScalarInstruction::BooleanLiteral(_result, _value, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
		when RecoveryScalarInstruction::IntegerLiteral(_result, value, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			if value < - 9007199254740991 || value > 9007199254740991
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/value", "Integer literal is outside the portable range")
				)
			end
		when RecoveryScalarInstruction::FloatLiteral(_result, value, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			if !value.finite?()
				return Result<Boolean, Diagnostic>::Err(
					boundary_diagnostic("TRBN0004", path + "/value", "Float literal must be finite")
				)
			end
		when RecoveryScalarInstruction::IntegerBinary(_result, _operator, left, right, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require_scalar(available, left, ScalarType::Integer, path + "/left")
			try _recovery_aggregate_require_scalar(available, right, ScalarType::Integer, path + "/right")
		when RecoveryScalarInstruction::FloatBinary(_result, _operator, left, right, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require_scalar(available, left, ScalarType::Float, path + "/left")
			try _recovery_aggregate_require_scalar(available, right, ScalarType::Float, path + "/right")
		when RecoveryScalarInstruction::IntegerCompare(_result, _operator, left, right, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require_scalar(available, left, ScalarType::Integer, path + "/left")
			try _recovery_aggregate_require_scalar(available, right, ScalarType::Integer, path + "/right")
		when RecoveryScalarInstruction::FloatCompare(_result, _operator, left, right, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require_scalar(available, left, ScalarType::Float, path + "/left")
			try _recovery_aggregate_require_scalar(available, right, ScalarType::Float, path + "/right")
		when RecoveryScalarInstruction::BooleanNot(_result, value, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require_scalar(available, value, ScalarType::Boolean, path + "/value")
		when RecoveryScalarInstruction::Call(_result, _function_id, _arguments, _origin)
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "Scalar recovery call must be normalized to a Aggregate recovery call")
			)
		when RecoveryScalarInstruction::WriteStatic(_value, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_verify_terminator(
			native_module: RecoveryAggregateModule,
			function: RecoveryAggregateFunction,
			terminator: RecoveryAggregateTerminator,
			available: Hash<String, AggregateValueType>,
			source_ids: Array<String>,
			path: String,
		): Result<Boolean, Diagnostic>
		case terminator
		when RecoveryAggregateTerminator::Jump(target, arguments, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_verify_target(function, target, arguments, available, path)
		when RecoveryAggregateTerminator::Branch(condition, when_true, true_arguments, when_false, false_arguments, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			try _recovery_aggregate_require_scalar(available, condition, ScalarType::Boolean, path + "/condition")
			try _recovery_aggregate_verify_target(function, when_true, true_arguments, available, path + "/true")
			try _recovery_aggregate_verify_target(function, when_false, false_arguments, available, path + "/false")
		when RecoveryAggregateTerminator::Return(value, origin)
			try _recovery_aggregate_verify_origin(origin, source_ids, path + "/origin")
			case function.result_type
			when RecoveryAggregateResultType::Void
				if value != nil
					return Result<Boolean, Diagnostic>::Err(
						boundary_diagnostic("TRBN0004", path + "/value", "Void function must not return a value")
					)
				end
			when RecoveryAggregateResultType::Value(value_type)
				if value == nil
					return Result<Boolean, Diagnostic>::Err(
						boundary_diagnostic("TRBN0004", path + "/value", "non-Void function must return a value")
					)
				end
				try _recovery_aggregate_require(available, value, value_type, path + "/value")
			end
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_verify_target(
			function: RecoveryAggregateFunction,
			target: String,
			arguments: Array<String>,
			available: Hash<String, AggregateValueType>,
			path: String,
		): Result<Boolean, Diagnostic>
		block := recovery_aggregate_block(function.blocks, target)
		if block == nil
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path + "/target", "terminator references an unknown block")
			)
		end
		if arguments.size() != block.parameters.size()
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path + "/arguments", "block argument count does not match the target")
			)
		end
		mut index := 0
		while index < arguments.size()
			try _recovery_aggregate_require(available, arguments[index], block.parameters[index].value_type, path + "/arguments/" + index.to_s())
			index += 1
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_require_arguments(
			available: Hash<String, AggregateValueType>,
			arguments: Array<String>,
			fields: Array<AggregateFieldLayout>,
			path: String,
		): Result<Boolean, Diagnostic>
		if arguments.size() != fields.size()
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "aggregate argument count does not match its layout")
			)
		end
		mut index := 0
		while index < arguments.size()
			try _recovery_aggregate_require(available, arguments[index], fields[index].value_type, path + "/" + index.to_s())
			index += 1
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_define(
			mut definitions: Hash<String, AggregateValueType>,
			id: String,
			value_type: AggregateValueType,
			path: String,
		): Result<Boolean, Diagnostic>
		if id.empty?() || definitions.key?(id)
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "value identifier is empty or defined more than once")
			)
		end
		definitions[id] = value_type
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_require(
			available: Hash<String, AggregateValueType>,
			id: String,
			expected: AggregateValueType,
			path: String,
		): Result<Boolean, Diagnostic>
		actual := try _recovery_aggregate_require_any(available, id, path)
		if !aggregate_value_types_equal(actual, expected)
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "operand type does not match the operation")
			)
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end

	def _recovery_aggregate_require_scalar(
			available: Hash<String, AggregateValueType>,
			id: String,
			scalar: ScalarType,
			path: String,
		): Result<Boolean, Diagnostic>
		return _recovery_aggregate_require(available, id, AggregateValueType::Scalar(scalar), path)
	end

	def _recovery_aggregate_require_any(
			available: Hash<String, AggregateValueType>,
			id: String,
			path: String,
		): Result<AggregateValueType, Diagnostic>
		if !available.key?(id)
			return Result<AggregateValueType, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "operand is not available in this block")
			)
		end
		return Result<AggregateValueType, Diagnostic>::Ok(available.fetch(id))
	end

	def _recovery_aggregate_aggregate_layout(
			native_module: RecoveryAggregateModule,
			value_type: AggregateValueType,
			path: String,
		): Result<AggregateLayout, Diagnostic>
		case value_type
		when AggregateValueType::Scalar(_scalar)
			return Result<AggregateLayout, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "operation requires an aggregate value")
			)
		when AggregateValueType::Aggregate(type_id)
			return compute_aggregate_layout(native_module.types, type_id)
		end
	end

	def _recovery_aggregate_some_definition(
			id: String,
			value_type: AggregateValueType,
		): Result<RecoveryAggregateDefinition?, Diagnostic>
		return Result<RecoveryAggregateDefinition?, Diagnostic>::Ok(RecoveryAggregateDefinition.new(id: id, value_type: value_type))
	end

	def recovery_aggregate_instruction_result(instruction: RecoveryAggregateInstruction): String?
		case instruction
		when RecoveryAggregateInstruction::Scalar(scalar)
			case scalar
			when RecoveryScalarInstruction::BooleanLiteral(result, _value, _origin)
				return result
			when RecoveryScalarInstruction::IntegerLiteral(result, _value, _origin)
				return result
			when RecoveryScalarInstruction::FloatLiteral(result, _value, _origin)
				return result
			when RecoveryScalarInstruction::IntegerBinary(result, _operator, _left, _right, _origin)
				return result
			when RecoveryScalarInstruction::FloatBinary(result, _operator, _left, _right, _origin)
				return result
			when RecoveryScalarInstruction::IntegerCompare(result, _operator, _left, _right, _origin)
				return result
			when RecoveryScalarInstruction::FloatCompare(result, _operator, _left, _right, _origin)
				return result
			when RecoveryScalarInstruction::BooleanNot(result, _value, _origin)
				return result
			when RecoveryScalarInstruction::Call(result, _function_id, _arguments, _origin)
				return result
			when RecoveryScalarInstruction::WriteStatic(_value, _origin)
				return nil
			end
		when RecoveryAggregateInstruction::RecordConstruct(result, _type_id, _arguments, _origin)
			return result
		when RecoveryAggregateInstruction::RecordProject(result, _type_id, _record, _field, _origin)
			return result
		when RecoveryAggregateInstruction::VariantConstruct(result, _type_id, _variant, _arguments, _origin)
			return result
		when RecoveryAggregateInstruction::VariantTest(result, _type_id, _value, _variant, _origin)
			return result
		when RecoveryAggregateInstruction::VariantProject(result, _type_id, _value, _variant, _field, _origin)
			return result
		when RecoveryAggregateInstruction::Call(result, _function_id, _arguments, _origin)
			return result
		end
	end

	def recovery_aggregate_function(functions: Array<RecoveryAggregateFunction>, id: String): RecoveryAggregateFunction?
		mut index := 0
		while index < functions.size()
			if functions[index].id == id
				return functions[index]
			end
			index += 1
		end
		return nil
	end

	def recovery_aggregate_block(blocks: Array<RecoveryAggregateBlock>, id: String): RecoveryAggregateBlock?
		mut index := 0
		while index < blocks.size()
			if blocks[index].id == id
				return blocks[index]
			end
			index += 1
		end
		return nil
	end

	def _recovery_aggregate_verify_origin(
			origin: SourceOrigin,
			source_ids: Array<String>,
			path: String,
		): Result<Boolean, Diagnostic>
		if !source_ids.include?(origin.source_id)
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path + "/source", "origin references an unknown source")
			)
		end
		if origin.start_line < 1 || origin.start_column < 1 || origin.end_line < 1 || origin.end_column < 1
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "origin coordinates must be positive")
			)
		end
		if origin.end_line < origin.start_line || (origin.end_line == origin.start_line && origin.end_column < origin.start_column)
			return Result<Boolean, Diagnostic>::Err(
				boundary_diagnostic("TRBN0004", path, "origin end precedes its start")
			)
		end
		return Result<Boolean, Diagnostic>::Ok(true)
	end
