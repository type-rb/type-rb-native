import { AggregateField, AggregateLayoutKind, AggregateTypeDefinition, AggregateValueType, AggregateVariant, aggregate_field_layout, aggregate_value_types_equal, aggregate_variant_field_layout, aggregate_variant_layout, compute_aggregate_layout, verify_aggregate_layouts } from aggregate_layout
import { ScalarType } from recovery_scalar_mir
import trb/std/result
import { describe, expect, test } from trb/std/test

def _aggregate_scalar(value_type: ScalarType): AggregateValueType
	return AggregateValueType::Scalar(value_type)
end

def _aggregate_field(name: String, value_type: AggregateValueType): AggregateField
	return AggregateField.new(name: name, value_type: value_type)
end

def _aggregate_layout_definitions(): Array<AggregateTypeDefinition>
	return [
		AggregateTypeDefinition::Record(
			"example#Point",
			[
				_aggregate_field("visible", _aggregate_scalar(ScalarType::Boolean)),
				_aggregate_field("x", _aggregate_scalar(ScalarType::Integer)),
				_aggregate_field("y", _aggregate_scalar(ScalarType::Float)),
			],
		),
		AggregateTypeDefinition::Record(
			"example#Envelope",
			[
				_aggregate_field("point", AggregateValueType::Aggregate("example#Point")),
				_aggregate_field("selected", _aggregate_scalar(ScalarType::Boolean)),
			],
		),
		AggregateTypeDefinition::Tagged(
			"example#Outcome",
			[
				AggregateVariant.new(name: "None", fields: []),
				AggregateVariant.new(
					name: "Count",
					fields: [_aggregate_field("value", _aggregate_scalar(ScalarType::Integer))],
				),
				AggregateVariant.new(
					name: "Located",
					fields: [_aggregate_field("point", AggregateValueType::Aggregate("example#Point"))],
				),
			],
		),
	]
end

describe("Aggregate recovery static aggregate layout") do
	test("lays out scalar and nested record fields deterministically") do
		definitions := _aggregate_layout_definitions()
		case compute_aggregate_layout(definitions, "example#Point")
		when Result::Ok(layout)
			expect(layout.kind).to_equal(AggregateLayoutKind::Record)
			expect(layout.size).to_equal(24)
			expect(layout.alignment).to_equal(8)
			expect(aggregate_field_layout(layout, "visible").offset).to_equal(0)
			expect(aggregate_field_layout(layout, "x").offset).to_equal(8)
			expect(aggregate_field_layout(layout, "y").offset).to_equal(16)
		when Result::Err(_diagnostic)
			expect(false).to_be_true()
		end
		case compute_aggregate_layout(definitions, "example#Envelope")
		when Result::Ok(layout)
			expect(layout.size).to_equal(32)
			expect(layout.alignment).to_equal(8)
			expect(aggregate_field_layout(layout, "point").offset).to_equal(0)
			expect(aggregate_field_layout(layout, "selected").offset).to_equal(24)
		when Result::Err(_diagnostic)
			expect(false).to_be_true()
		end
	end

	test("lays out tags and maximum payload storage") do
		case compute_aggregate_layout(_aggregate_layout_definitions(), "example#Outcome")
		when Result::Ok(layout)
			expect(layout.kind).to_equal(AggregateLayoutKind::Tagged)
			expect(layout.payload_offset).to_equal(8)
			expect(layout.size).to_equal(32)
			expect(layout.alignment).to_equal(8)
			none := aggregate_variant_layout(layout, "None")
			count := aggregate_variant_layout(layout, "Count")
			located := aggregate_variant_layout(layout, "Located")
			expect(none.tag).to_equal(0)
			expect(none.payload_size).to_equal(0)
			expect(count.tag).to_equal(1)
			if count != nil
				expect(aggregate_variant_field_layout(count, "value").offset).to_equal(8)
			end
			expect(located.tag).to_equal(2)
			if located != nil
				expect(aggregate_variant_field_layout(located, "point").size).to_equal(24)
			end
		when Result::Err(_diagnostic)
			expect(false).to_be_true()
		end
	end

	test("retains nominal identity for identical shapes") do
		left := AggregateValueType::Aggregate("example#Left")
		right := AggregateValueType::Aggregate("example#Right")
		expect(aggregate_value_types_equal(left, left)).to_be_true()
		expect(aggregate_value_types_equal(left, right)).to_be_false()
		expect(
			compute_aggregate_layout(_aggregate_layout_definitions(), "example#Outcome")
		).to_equal(compute_aggregate_layout(_aggregate_layout_definitions(), "example#Outcome"))
	end

	test("rejects recursive by-value layouts") do
		definitions := [
			AggregateTypeDefinition::Record(
				"example#Recursive",
				[_aggregate_field("next", AggregateValueType::Aggregate("example#Recursive"))],
			),
		]
		case verify_aggregate_layouts(definitions)
		when Result::Ok(_valid)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0004")
			expect(diagnostic.message).to_equal("recursive by-value aggregate layout is unsupported")
		end
	end

	test("rejects duplicate fields and variants") do
		duplicate_fields := [
			AggregateTypeDefinition::Record(
				"example#Duplicate",
				[
					_aggregate_field("value", _aggregate_scalar(ScalarType::Integer)),
					_aggregate_field("value", _aggregate_scalar(ScalarType::Float)),
				],
			),
		]
		case verify_aggregate_layouts(duplicate_fields)
		when Result::Ok(_valid)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.message).to_equal("field name is duplicated")
		end
		duplicate_variants := [
			AggregateTypeDefinition::Tagged(
				"example#DuplicateTag",
				[
					AggregateVariant.new(name: "Same", fields: []),
					AggregateVariant.new(name: "Same", fields: []),
				],
			),
		]
		case verify_aggregate_layouts(duplicate_variants)
		when Result::Ok(_valid)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.message).to_equal("variant name is duplicated")
		end
	end

	test("rejects unknown aggregate field types") do
		definitions := [
			AggregateTypeDefinition::Record(
				"example#Broken",
				[_aggregate_field("missing", AggregateValueType::Aggregate("example#Missing"))],
			),
		]
		case verify_aggregate_layouts(definitions)
		when Result::Ok(_valid)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.message).to_equal("aggregate type does not exist")
		end
	end

	test("rejects duplicate type identities") do
		definitions := [
			AggregateTypeDefinition::Record("example#Same", []),
			AggregateTypeDefinition::Tagged(
				"example#Same",
				[AggregateVariant.new(name: "Only", fields: [])],
			),
		]
		case verify_aggregate_layouts(definitions)
		when Result::Ok(_valid)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.message).to_equal("type identifier is duplicated")
		end
	end

	test("enforces the configured aggregate byte limit") do
		mut chunk_fields: Array<AggregateField> := []
		mut index := 0
		while index < 256
			chunk_fields.push(_aggregate_field("word" + index.to_s(), _aggregate_scalar(ScalarType::Integer)))
			index += 1
		end
		mut page_fields: Array<AggregateField> := []
		index = 0
		while index < 256
			page_fields.push(_aggregate_field("chunk" + index.to_s(), AggregateValueType::Aggregate("example#Chunk")))
			index += 1
		end
		definitions := [
			AggregateTypeDefinition::Record("example#Chunk", chunk_fields),
			AggregateTypeDefinition::Record("example#Page", page_fields),
			AggregateTypeDefinition::Record(
				"example#TooLarge",
				[
					_aggregate_field("first", AggregateValueType::Aggregate("example#Page")),
					_aggregate_field("second", AggregateValueType::Aggregate("example#Page")),
					_aggregate_field("third", AggregateValueType::Aggregate("example#Page")),
				],
			),
		]
		case compute_aggregate_layout(definitions, "example#TooLarge")
		when Result::Ok(_layout)
			expect(false).to_be_true()
		when Result::Err(diagnostic)
			expect(diagnostic.code).to_equal("TRBN0005")
			expect(diagnostic.message).to_equal("aggregate layout exceeds the Aggregate recovery byte limit")
		end
	end
end
