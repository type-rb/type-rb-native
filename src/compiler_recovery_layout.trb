# Exact canonical import boundaries for the recovery-only flattened equivalent.
# Keep this table synchronized with the ordinary file-root closure. Unknown or
# missing declarations are errors, never implicitly recovered dependencies.
record RecoveryCompilerModule
	name: String
	imports: String
end

def compiler_recovery_layout(): Array<RecoveryCompilerModule>
	return [
		RecoveryCompilerModule.new(name: "literals", imports: ""),
		RecoveryCompilerModule.new(name: "mir", imports: ""),
		RecoveryCompilerModule.new(name: "iteration_mir", imports: ""),
		RecoveryCompilerModule.new(name: "path", imports: ""),
		RecoveryCompilerModule.new(name: "hash_types", imports: "import { ascii_code } from literals\nimport { string_starts_with } from path\n\n"),
		RecoveryCompilerModule.new(name: "hash_mir", imports: "import { hash_key_type, hash_type, hash_value_type, native_managed_type, native_value_layout } from hash_types\n\n"),
		RecoveryCompilerModule.new(name: "storage", imports: ""),
		RecoveryCompilerModule.new(name: "state", imports: "import { MirHashOperation } from hash_mir\nimport { MirIteration, MirRangeConstruction } from iteration_mir\nimport { integer_string } from literals\nimport { MirArrayOperation, MirBlock, MirInstruction, MirModule, MirValue } from mir\nimport { IntegerStorage, StringStorage, integer_storage, load_integer, load_string, store_integer, store_string, string_storage } from storage\n\n"),
		RecoveryCompilerModule.new(name: "parser", imports: "import { MirIteration } from iteration_mir\nimport { CompilerState, diagnostic, function_index_key, has_diagnostic, terminal_token } from state\nimport { load_integer, load_string, sparse_integer_at, store_integer, store_string } from storage\n\n"),
