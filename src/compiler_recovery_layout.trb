		RecoveryCompilerModule.new(name: "qbe_numeric", imports: "import { QbeEmitContext, QbeValue, emit_label, emit_temporary } from qbe_context\nimport { emit_root_value } from qbe_memory\nimport { QbeOutput, qbe_output_branch, qbe_output_line } from qbe_output\n\n"),
		RecoveryCompilerModule.new(name: "qbe_mir", imports: "import { integer_string, number_without_underscores } from literals\nimport { MirInstruction, mir_block_index, mir_function_index, mir_value_type } from mir\nimport { mir_scalar_result_fact } from mir_analysis\nimport { QbeEmitContext, QbeValue, emit_label, emit_temporary, emit_typed_load, emit_typed_store, emitted_value, scalar_type_name } from qbe_context\nimport { emit_array_data_address, emit_array_header } from qbe_memory\nimport { emit_checked_integer_operation, lower_binary_operand } from qbe_numeric\nimport { QbeOutput, qbe_output_branch, qbe_output_line } from qbe_output\nimport { CompilerState } from state\nimport { store_string } from storage\n\n"),
		RecoveryCompilerModule.new(name: "qbe_control", imports: "import { integer_string } from literals\nimport { MirFunction, mir_block_index, mir_function_index } from mir\nimport { mir_scalar_result_fact } from mir_analysis\nimport { QbeEmitContext, emit_label, emit_temporary, emit_typed_store, qbe_type, scalar_type_name } from qbe_context\nimport { emit_mir_scalar_instruction } from qbe_mir\nimport { QbeOutput, qbe_output_branch, qbe_output_line } from qbe_output\nimport { CompilerState } from state\n\n"),
