		RecoveryCompilerModule.new(name: "resolution", imports: "import { hash_key_type, hash_type, hash_value_type } from hash_types\nimport { ascii_code, integer_string } from literals\nimport { syntax_loop_transfer_kind, token_is } from parser\nimport { path_basename, path_directory, string_starts_with, string_without_suffix } from path\nimport { CheckedLocals, CompilerState, diagnostic, find_name_index, function_index_key, has_diagnostic, local_find, locals_new, terminal_token } from state\nimport { load_integer, load_string, store_integer, store_string } from storage\n\n"),
		RecoveryCompilerModule.new(name: "hash_checked", imports: "import { MirHashOperation, mir_hash_operation, mir_hash_valid } from hash_mir\nimport { hash_key_type, hash_value_type } from hash_types\nimport { token_is } from parser\nimport { array_element_type, find_record_type } from resolution\nimport { CompilerState, diagnostic } from state\nimport { load_integer, load_string, sparse_integer_at, store_integer } from storage\n\n"),
		RecoveryCompilerModule.new(name: "iteration_checked", imports: "import { MirIteration, MirRangeConstruction, mir_iteration_shape_valid, mir_iteration_valid, mir_range_valid } from iteration_mir\nimport { syntax_iteration_suffix, token_is } from parser\nimport { array_element_type } from resolution\nimport { CompilerState, diagnostic } from state\nimport { load_integer, sparse_integer_at } from storage\n\n"),
		RecoveryCompilerModule.new(name: "mir_analysis", imports: "import { ascii_code } from literals\nimport { MirArrayOperation, MirBlock, MirFunction, MirInstruction, MirModule, mir_array_element_type, mir_table_span_valid, mir_value_type } from mir\n\n"),
