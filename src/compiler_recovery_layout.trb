# Exact canonical import boundaries for the recovery-only flattened equivalent.
# Keep this table synchronized with the ordinary file-root closure. Unknown or
# missing declarations are errors, never implicitly recovered dependencies.
record RecoveryCompilerModule
	name: String
	imports: String
end

def compiler_recovery_layout(): Array<RecoveryCompilerModule>
	return [
		RecoveryCompilerModule.new(name: "object_dispatch", imports: "import { object_dispatch_arguments, object_dispatch_method } from object_dispatch_shapes\nimport { object_method_function } from object_methods\nimport { MirObjectMethod, MirObjectWitness } from object_model\nimport { object_assignable, object_instance_type } from object_types\nimport { CompilerState, diagnostic, has_diagnostic } from state\nimport { load_integer, load_string, sparse_integer_at } from storage\n\n"),
