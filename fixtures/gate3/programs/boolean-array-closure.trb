alias Predicate = () -> Boolean

record Flags
	values: Array<Boolean>
end

def grow(mut values: Array<Boolean>, value: Boolean): Boolean
	mut index := 0
	while index < 64
		values.push(value)
		index += 1
	end
	return !value
end

def main()
	mut values: Array<Boolean> := [false, true]
	values[- 1] = grow(values, true)
	mut groups: Array<Array<Array<Boolean>>> := [[[true]], [values]]
	groups[0][0] = values
	flags := Flags.new(values: groups[0][0])
	predicate: Predicate := fn(): Boolean
		return !flags.values[1]
	end
	mut empty: Array<Boolean> := []
	empty.push(predicate())
	if empty[- 1]
		if !values[0]
			if values[2]
				if values.size() == 66
					puts("boolean-array-recovery-ok")
				end
			end
		end
	end
	return
end
