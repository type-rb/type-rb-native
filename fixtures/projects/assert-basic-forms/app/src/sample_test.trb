import { describe, expect, test } from trb/std/test

describe("Assertions") do
	test("not equal") do
		expect(1).to_not_equal(2)
	end
	test("true") do
		expect(1 < 2).to_be_true()
	end
	test("false") do
		expect(2 < 1).to_be_false()
	end
	test("nil") do
		value: String? := nil
		expect(value).to_be_nil()
	end
end
