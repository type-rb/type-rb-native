import { describe, expect, test } from trb/std/test

record Point
	x: Integer
	y: Integer
end

enum Shape
	Circle(radius: Integer)
	Square(side: Integer)
end

describe("Structure") do
	test("array") do
		expect([1, 2]).to_equal([1, 2])
	end
	test("hash") do
		expect({"a" => 1}).to_equal({"a" => 1})
	end
	test("record") do
		expect(Point.new(x: 1, y: 2)).to_equal(Point.new(x: 1, y: 2))
	end
	test("enum") do
		expect(Shape::Circle(2)).to_equal(Shape::Circle(2))
	end
end
