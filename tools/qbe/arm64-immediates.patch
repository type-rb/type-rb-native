+/* Keep only constants representable by the selected integer instruction. */
+static int
+selimm(Ins *i, Fn *fn)
+{
+	Con *c;
+	int64_t n;
+
+	if (KBASE(i->cls) || rtype(i->arg[1]) != RCon)
+		return 0;
+	c = &fn->con[i->arg[1].val];
+	if (c->type != CBits)
+		return 0;
+	switch (i->op) {
+	case Oadd:
+	case Osub:
+		switch (imm(c, i->cls, &n)) {
+		case Inlo12:
+		case Inhi12:
+			i->op = i->op == Oadd ? Osub : Oadd;
+			i->arg[1] = getcon(n, fn);
+			return 1;
+		case Iplo12:
+		case Iphi12:
+			i->arg[1] = getcon(n, fn);
+			return 1;
+		default:
+			return 0;
+		}
+	case Oand:
+	case Oor:
+	case Oxor:
+		n = i->cls == Kw ? (uint32_t)c->bits.i : c->bits.i;
+		if (!arm64_logimm(n, i->cls))
+			return 0;
+		i->arg[1] = getcon(n, fn);
+		return 1;
+	case Oshl:
+	case Oshr:
+	case Osar:
+		/* IL shift counts are reduced modulo the result width. */
+		i->arg[1] = getcon(c->bits.i & (KWIDE(i->cls) ? 63 : 31), fn);
+		return 1;
+	default:
+		return 0;
+	}
+}
