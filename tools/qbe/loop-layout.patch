+/* Put a two-block loop's test after its body. Enter through the original
+ * header, then fall through from the body to that test on every backedge.
+ * Only emission order changes: CFG edges and allocated instructions stay put.
+ */
+static void
+looplayout(Fn *fn)
+{
+	Blk *prev, *head, *body;
+
+	for (prev=fn->start; prev && prev->link; prev=prev->link) {
+		head = prev->link;
+		body = head->link;
+		if (!body || !head->s1 || !head->s2 || body->npred != 1)
+			continue;
+		if (head->s1 != body && head->s2 != body)
+			continue;
+		if (body->jmp.type != Jjmp || body->s1 != head)
+			continue;
+		prev->link = body;
+		head->link = body->link;
+		body->link = head;
+		prev = body;
+	}
+}
