+static int
+memreg(Ref r, Fn *fn)
+{
+	return rtype(r) == RTmp && r.val >= Tmp0
+		&& fn->tmp[r.val].cls == Kl && fn->tmp[r.val].slot == -1;
+}
+
+/* Use only shifts directly encodable by the memory operation. Other shifts
+ * remain ordinary instructions and may still serve as an unscaled index. */
+static Ins *
+memshift(Ref r, int sz, Fn *fn)
+{
+	Ins *d;
+	Con *c;
+
+	if (!memreg(r, fn) || fn->tmp[r.val].ndef != 1)
+		return 0;
+	d = fn->tmp[r.val].def;
+	if (!d || d->op != Oshl || d->cls != Kl
+	|| !memreg(d->arg[0], fn) || rtype(d->arg[1]) != RCon)
+		return 0;
+	c = &fn->con[d->arg[1].val];
+	if (c->type != CBits || c->bits.i < 0 || c->bits.i > 3
+	|| (1 << c->bits.i) != sz)
+		return 0;
+	return d;
+}
+
+/* Consume only a unique address add. Shared liveness and allocation already
+ * handle both registers in RMem; frame and symbol addresses stay unchanged. */
+static void
+selmem(Ins *i, Fn *fn)
+{
+	Ins *d, *shift;
+	Tmp *t, *index;
+	Con *c;
+	Addr a;
+	Ref *r;
+	int sz;
+
+	if (isload(i->op)) {
+		r = &i->arg[0];
+		sz = loadsz(i);
+	} else if (isstore(i->op)) {
+		r = &i->arg[1];
+		sz = storesz(i);
+	} else
+		return;
+	if (rtype(*r) != RTmp || r->val < Tmp0)
+		return;
+	t = &fn->tmp[r->val];
+	d = t->def;
+	if (t->ndef != 1 || t->nuse != 1 || !d
+	|| d->op != Oadd || d->cls != Kl
+	|| !memreg(d->arg[0], fn))
+		return;
+	a = (Addr){.offset = {.type = CBits}, .base = d->arg[0],
+		.index = R, .scale = 1};
+	if (rtype(d->arg[1]) == RCon) {
+		c = &fn->con[d->arg[1].val];
+		if (c->type != CBits || c->bits.i < 0
+		|| c->bits.i > 4095 * sz || c->bits.i % sz)
+			return;
+		a.offset = *c;
+	} else if (memreg(d->arg[1], fn)) {
+		a.index = d->arg[1];
+		shift = memshift(a.index, sz, fn);
+		if (!shift && (shift = memshift(a.base, sz, fn))) {
+			a.index = a.base;
+			a.base = d->arg[1];
+		}
+		if (shift) {
+			index = &fn->tmp[a.index.val];
+			a.index = shift->arg[0];
+			a.scale = sz;
+			/* Replace one shift-result use with its source. A shared shift
+			 * keeps its own source use in addition to the memory index. */
+			if (--index->nuse == 0)
+				*shift = (Ins){.op = Onop};
+			else
+				fn->tmp[a.index.val].nuse++;
+		}
+	} else
+		return;
+	vgrow(&fn->mem, ++fn->nmem);
+	fn->mem[fn->nmem-1] = a;
+	*r = MEM(fn->nmem-1);
+	/* The add's operand uses become the memory operand's register uses. */
+	t->nuse = 0;
+	*d = (Ins){.op = Onop};
+}
