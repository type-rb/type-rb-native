+static void
+prunecopies(Fn *fn)
+{
+	Blk *b;
+	Phi *p, **pp, **phis;
+	Ins *i;
+	BSet live;
+	uint *work, count, t, n;
+	int changed;
+
+	for (b=fn->start; b && !b->phi; b=b->link)
+		;
+	if (!b)
+		return;
+	phis = alloc(fn->ntmp * sizeof phis[0]);
+	work = alloc(fn->ntmp * sizeof work[0]);
+	bsinit(&live, fn->ntmp);
+	count = 0;
+	for (b=fn->start; b; b=b->link) {
+		for (p=b->phi; p; p=p->link)
+			phis[p->to.val] = p;
+		for (i=b->ins; i<&b->ins[b->nins]; i++)
+			if (i->op != Ocopy) {
+				copyuse(i->arg[0], &live, work, &count);
+				copyuse(i->arg[1], &live, work, &count);
+			}
+		copyuse(b->jmp.arg, &live, work, &count);
+	}
+	while (count) {
+		t = work[--count];
+		p = phis[t];
+		if (p) {
+			for (n=0; n<p->narg; n++)
+				copyuse(p->arg[n], &live, work, &count);
+		} else {
+			i = fn->tmp[t].def;
+			if (i && i->op == Ocopy)
+				copyuse(i->arg[0], &live, work, &count);
+		}
+	}
+	changed = 0;
+	for (b=fn->start; b; b=b->link) {
+		for (pp=&b->phi; (p=*pp);)
+			if (!bshas(&live, p->to.val)) {
+				*pp = p->link;
+				changed = 1;
+			} else
+				pp = &p->link;
+		for (i=b->ins; i<&b->ins[b->nins]; i++)
+			if (i->op == Ocopy && rtype(i->to) == RTmp)
+			if (!bshas(&live, i->to.val)) {
+				*i = (Ins){.op = Onop};
+				changed = 1;
+			}
+	}
+	if (changed)
