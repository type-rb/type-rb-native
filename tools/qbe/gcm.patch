+/* Phi-only cycles have no observable use, but the scheduling walk treats
+ * every phi argument as live. Mark from non-copy uses before scheduling;
+ * retain all ordinary instructions and let existing GCM own their removal. */
+static void
+copyuse(Ref r, BSet *live, uint *work, uint *count)
+{
+	if (req(r, R) || rtype(r) != RTmp || bshas(live, r.val))
+		return;
+	bsset(live, r.val);
+	work[(*count)++] = r.val;
+}
