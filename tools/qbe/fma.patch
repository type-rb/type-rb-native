 */
 
+/* Contract only an explicitly permitted multiply and its adjacent consumer.
+ * No operand can change between them. Omit the rounded product only when the
+ * consumer overwrites it or the next write precedes every use in this block.
+ * Calls and block exits stop that proof, including implicit ABI register uses.
+ * Otherwise preserve the product when the result can be computed first safely.
+ * Keeping this after register allocation avoids a third generic IR operand.
+ */
+static int
+emitcontract(Ins *mul, Ins *end, E *e)
+{
+	Ins *add, *next;
+	Ref other;
+	char *op;
+	char reg;
+	int product, keep;
+
+	if (mul->op != Omulc || mul + 1 == end)
+		return 0;
+	add = mul + 1;
+	if ((add->op != Oadd && add->op != Osub) || add->cls != mul->cls)
+		return 0;
+	if (!isreg(mul->to) || !isreg(mul->arg[0]) || !isreg(mul->arg[1])
+	|| !isreg(add->to) || !isreg(add->arg[0]) || !isreg(add->arg[1]))
+		return 0;
+	if (req(mul->to, add->arg[0]) == req(mul->to, add->arg[1]))
+		return 0;
+	product = req(mul->to, add->arg[1]);
+	other = add->arg[!product];
+	keep = 0;
+	if (!req(mul->to, add->to)) {
+		for (next=add+1; next!=end; next++) {
+			if (next->op == Ocall
+			|| req(next->arg[0], mul->to) || req(next->arg[1], mul->to)) {
+				keep = 1;
+				break;
+			}
+			if (req(next->to, mul->to))
+				break;
+		}
+		if (next == end)
+			keep = 1;
+	}
+	/* A live rounded product can follow the fused result when computing that
+	 * result leaves both multiply inputs intact. No extra register is needed. */
+	if (keep && (req(add->to, mul->arg[0]) || req(add->to, mul->arg[1])))
+		return 0;
+	op = "fmadd";
+	if (add->op == Osub)
+		op = product ? "fmsub" : "fnmsub";
+	reg = mul->cls == Kd ? 'd' : 's';
+	fprintf(e->f, "\t%s\t%c%d, %c%d, %c%d, %c%d\n",
+		op, reg, add->to.val - V0,
+		reg, mul->arg[0].val - V0, reg, mul->arg[1].val - V0,
+		reg, other.val - V0);
+	if (keep)
+		emitins(mul, e);
+	return 1;
+}
