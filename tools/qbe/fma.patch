+/* Recompute physical liveness after allocation inserted copies and spill slots.
+ * Functions without permitted Float multiplication need no extra analysis.
+ */
+static void
+contractlive(Fn *fn)
+{
+	Blk *b;
+	Ins *i;
+
+	for (b=fn->start; b; b=b->link)
+		for (i=b->ins; i!=&b->ins[b->nins]; i++)
+			if (i->op == Omulc) {
+				filllive(fn);
+				return;
+			}
+}
+
+/* A local divide or square root can delay the product after a carried addend
+ * is ready. Keep short load/multiply reductions separate; this profitability
+ * choice does not relax the product-observation proof below.
+ */
+static int
+contractlateproduct(Ins *mul, Blk *b)
+{
+	Ins *i;
+	int pending, arg;
+
+	pending = 3;
+	for (i=mul; i!=b->ins && pending;) {
+		i--;
+		if (i->op == Ocall)
+			break;
+		for (arg=0; arg<2; arg++)
+			if ((pending & (1 << arg)) && req(i->to, mul->arg[arg])) {
+				if ((i->op == Odiv || i->op == Osqrt) && i->cls == mul->cls)
+					return 1;
+				pending &= ~(1 << arg);
+			}
+	}
+	return 0;
+}
+
+/* Contract only an explicitly permitted multiply and its adjacent consumer.
+ * No operand can change between them. The rounded product must be overwritten
+ * before reuse, or dead at the block exit. Calls stop the local proof; successor
+ * liveness and ABI return registers preserve observations at block boundaries.
+ * Keeping this after register allocation avoids a third generic IR operand.
+ */
+static int
+emitcontract(Ins *mul, Blk *b, E *e)
+{
+	Ins *add, *next, *end, *prior;
+	Ref other;
+	char *op;
+	char reg;
+	int product, nr[2];
+
+	end = &b->ins[b->nins];
+	if (mul->op != Omulc || mul + 1 == end)
+		return 0;
+	add = mul + 1;
+	if ((add->op != Oadd && add->op != Osub) || add->cls != mul->cls)
+		return 0;
+	if (!isreg(mul->to) || !isreg(mul->arg[0]) || !isreg(mul->arg[1])
+	|| !isreg(add->to) || !isreg(add->arg[0]) || !isreg(add->arg[1]))
+		return 0;
+	if (req(mul->to, add->arg[0]) == req(mul->to, add->arg[1]))
+		return 0;
+	product = req(mul->to, add->arg[1]);
+	other = add->arg[!product];
+	if (!req(mul->to, add->to)) {
+		for (next=add+1; next!=end; next++) {
+			if (next->op == Ocall
+			|| req(next->arg[0], mul->to) || req(next->arg[1], mul->to))
+				return 0;
+			if (req(next->to, mul->to))
+				break;
+		}
+		if (next == end) {
+			/* A predecessor-fed addend can be a reduction chain:
+			 * fusion may lengthen its critical path. Extend the
+			 * overwrite proof for a local addend or a late product.
+			 */
+			for (prior=b->ins; prior!=mul; prior++)
+				if (req(prior->to, other))
+					break;
+			if (prior == mul && !contractlateproduct(mul, b))
+				return 0;
+			if (bshas(b->out, mul->to.val) || req(b->jmp.arg, mul->to))
+				return 0;
+			/* Return values are implicit uses, separate from successors. */
+			if (rtype(b->jmp.arg) == RCall
+			&& (T.retregs(b->jmp.arg, nr) & BIT(mul->to.val)))
+				return 0;
+		}
+	}
+	op = "fmadd";
+	if (add->op == Osub)
+		op = product ? "fmsub" : "fnmsub";
+	reg = mul->cls == Kd ? 'd' : 's';
+	fprintf(e->f, "\t%s\t%c%d, %c%d, %c%d, %c%d\n",
+		op, reg, add->to.val - V0,
+		reg, mul->arg[0].val - V0, reg, mul->arg[1].val - V0,
+		reg, other.val - V0);
+	return 1;
+}
