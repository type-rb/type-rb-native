+/* A phi class may include interfering values. Prefer the incoming value's
+ * actual register when the hottest allocated predecessors agree, before
+ * falling back to the class-wide hint. This remains a soft preference. */
+static int
+phihint(int t)
+{
+	Phi *p;
+	Ref a;
+	uint u;
+	int r, weight, w, previous;
+
+	p = phidefs[t];
+	if (!p)
+		return -1;
+	r = -1;
+	weight = -1;
+	for (u=0; u<p->narg; u++) {
+		a = p->arg[u];
+		if (rtype(a) != RTmp || a.val < Tmp0)
+			continue;
+		previous = tmp[a.val].visit;
+		if (previous == -1)
+			continue;
+		w = p->blk[u]->loop;
+		if (w > weight) {
+			weight = w;
+			r = previous;
+		} else if (w == weight && r != previous)
+			r = -1;
+	}
+	return r;
 }
 
