def append_inventory_command(
		mut inventory: StringBuilder,
		label: String,
		command: String,
		arguments: Array<String>,
	): Result<TimedProcess, String>
	inventory.append("## " + label + "\n")
	inventory.append("command: " + command)
	mut index := 0
	while index < arguments.size()
		inventory.append(" " + arguments[index])
		index += 1
	end
	inventory.append("\n")
	measurement := try measure_process(command, arguments)
	inventory.append("status: " + measurement.status.to_s() + "\n")
	if !measurement.stdout.empty?()
		inventory.append("stdout:\n" + measurement.stdout)
		if !measurement.stdout.end_with?("\n")
			inventory.append("\n")
		end
	end
	if !measurement.stderr.empty?()
		inventory.append("stderr:\n" + measurement.stderr)
		if !measurement.stderr.end_with?("\n")
			inventory.append("\n")
		end
	end
	inventory.append("\n")
	return Result<TimedProcess, String>::Ok(measurement)
end

def record_inventory(
		inventory_path: String,
		candidate_root: String,
		baseline_root: String,
		seed: String,
		seed_provenance: String,
		benchmark: String,
		qbe: String,
		cc: String,
		go_command: String,
		workspace: String,
		baseline_sources: CompilerSources,
		candidate_sources: CompilerSources,
		baseline_chain: CompilerChain,
		candidate_chain: CompilerChain,
		scale_source: String,
		scale_qbe: String,
		application: String,
	): Result<Boolean, String>
	mut inventory := string_builder.new()
	inventory.append("Gate 6G self-hosted symbol lookup process inventory\n\n")
	inventory.append("initial seed provenance (outside ordinary chains):\n  " + seed_provenance + "\n\n")
	inventory.append("ordinary baseline chain:\n")
	inventory.append("  B1 -> baseline B2/compiler -> baseline B3/compiler -> baseline B4/compiler\n")
	inventory.append("ordinary candidate chain:\n")
	inventory.append("  B1 -> candidate B2/compiler -> candidate B3/compiler -> candidate B4/compiler\n\n")
	inventory.append("measured comparison:\n")
	inventory.append("  baseline B4 emits/builds the Gate 6F source; candidate B4 emits/builds the Gate 6G source\n")
	inventory.append("  both build outputs use the basename compiler\n")
	inventory.append("  both B4 compilers emit the same generated 6,000-function source\n")
	inventory.append("  two warmups precede eleven alternating observations for time and RSS\n\n")
	inventory.append("retained external boundary:\n")
	inventory.append("  Native compiler -> explicit QBE 1.3 -> explicit system CC -> assembler/linker\n")
	inventory.append("  recovery, Go, benchmark controller, and shell are outside ordinary chains\n\n")
	inventory.append("exact measured commands:\n")
	inventory.append("  " + baseline_chain.b4 + " emit-qbe " + baseline_sources.entry_path + "\n")
	inventory.append("  " + candidate_chain.b4 + " emit-qbe " + candidate_sources.entry_path + "\n")
	inventory.append("  " + baseline_chain.b4 + " build " + baseline_sources.entry_path + " --output " + workspace + "/measured-baseline/compiler --qbe " + qbe + " --cc " + cc + "\n")
	inventory.append("  " + candidate_chain.b4 + " build " + candidate_sources.entry_path + " --output " + workspace + "/measured-candidate/compiler --qbe " + qbe + " --cc " + cc + "\n")
	inventory.append("  " + baseline_chain.b4 + " emit-qbe " + scale_source + "\n")
	inventory.append("  " + candidate_chain.b4 + " emit-qbe " + scale_source + "\n\n")
	try append_inventory_command(inventory, "candidate TypeRB Native revision", "/usr/bin/git", ["-C", candidate_root, "rev-parse", "HEAD"])
	try append_inventory_command(inventory, "candidate worktree status", "/usr/bin/git", ["-C", candidate_root, "status", "--porcelain"])
	try append_inventory_command(inventory, "baseline TypeRB Native revision", "/usr/bin/git", ["-C", baseline_root, "rev-parse", "HEAD"])
	try append_inventory_command(inventory, "operating system", "/usr/bin/sw_vers", [])
	try append_inventory_command(inventory, "kernel and architecture", "/usr/bin/uname", ["-a"])
	try append_inventory_command(inventory, "processor", "/usr/sbin/sysctl", ["-n", "machdep.cpu.brand_string"])
	try append_inventory_command(inventory, "physical memory", "/usr/sbin/sysctl", ["-n", "hw.memsize"])
	try append_inventory_command(inventory, "Go inventory tool version", go_command, ["version"])
	try append_inventory_command(inventory, "C toolchain version", cc, ["--version"])
	try append_inventory_command(inventory, "QBE probe", qbe, ["-h"])
	artifacts := [
		benchmark,
		seed,
		baseline_chain.b2,
		baseline_chain.b3,
		baseline_chain.b4,
		candidate_chain.b2,
		candidate_chain.b3,
		candidate_chain.b4,
		application,
		qbe,
	]
	try append_inventory_command(inventory, "artifact formats", "/usr/bin/file", artifacts)
	mut hash_arguments := ["-a", "256"]
	mut index := 0
	while index < artifacts.size()
		hash_arguments.push(artifacts[index])
		index += 1
	end
	try append_inventory_command(inventory, "artifact SHA-256", "/usr/bin/shasum", hash_arguments)
	try append_inventory_command(inventory, "compiler source closure SHA-256", "/usr/bin/shasum", [
			"-a",
			"256",
			baseline_sources.entry_path,
			baseline_sources.storage_path,
			baseline_sources.path_path,
			candidate_sources.entry_path,
			candidate_sources.storage_path,
			candidate_sources.path_path,
			scale_source,
		])
	try append_inventory_command(inventory, "fixed-point and scale QBE SHA-256", "/usr/bin/shasum", [
			"-a",
			"256",
			baseline_chain.fixed_qbe_path,
			candidate_chain.fixed_qbe_path,
			scale_qbe,
		])
	try append_inventory_command(inventory, "baseline compiler undefined symbols", "/usr/bin/nm", ["-u", baseline_chain.b4])
	try append_inventory_command(inventory, "candidate compiler undefined symbols", "/usr/bin/nm", ["-u", candidate_chain.b4])
	try append_inventory_command(inventory, "baseline compiler dynamic libraries", "/usr/bin/otool", ["-L", baseline_chain.b4])
	try append_inventory_command(inventory, "candidate compiler dynamic libraries", "/usr/bin/otool", ["-L", candidate_chain.b4])
	try append_inventory_command(inventory, "baseline compiler Go metadata probe", go_command, ["version", "-m", baseline_chain.b4])
	try append_inventory_command(inventory, "candidate compiler Go metadata probe", go_command, ["version", "-m", candidate_chain.b4])
	assembly_probe := workspace + "/inventory-cc-probe.s"
	try write_required(assembly_probe, "")
	try append_inventory_command(
		inventory,
		"CC assembler and linker expansion",
		cc,
		["-###", assembly_probe, "-Wl,-dead_strip", "-o", workspace + "/inventory-cc-output"],
	)
	try require_no_intermediates(workspace)
	return write_required(inventory_path, inventory.to_s())
end

def record_chain_hashes(
		mut output: StringBuilder,
		candidate: String,
		chain: CompilerChain,
	): Result<Boolean, String>
	try record_hash(output, "compiler-sha256", "compiler-source", candidate + "-b2", chain.b2)
	try record_hash(output, "compiler-sha256", "compiler-source", candidate + "-b3", chain.b3)
	try record_hash(output, "compiler-sha256", "compiler-source", candidate + "-b4", chain.b4)
	try record_hash(output, "emitted-qbe-sha256", "compiler-source", candidate, chain.fixed_qbe_path)
	return Result<Boolean, String>::Ok(true)
end

def execute_benchmark(
		candidate_root: String,
		baseline_root: String,
		seed: String,
		seed_provenance: String,
		benchmark: String,
		qbe: String,
		cc: String,
		go_command: String,
		workspace: String,
		raw_path: String,
		inventory_path: String,
	): Result<Boolean, String>
	try create_required_directory(workspace)
	baseline_sources := try read_compiler_sources(baseline_root)
	candidate_sources := try read_compiler_sources(candidate_root)
	baseline_revision := try measure_process("/usr/bin/git", ["-C", baseline_root, "rev-parse", "HEAD"])
	if baseline_revision.status != 0 || baseline_revision.stdout.strip() != "7cb7e85c0b5bff14157dc1a686829c010d095b70"
		return Result<Boolean, String>::Err("baseline root is not the registered Gate 6F revision")
	end
	try require_hash(seed, "f7bcdadad91a125808e9ef509a28f2a54414d4635af5b12e9493caf49c42e44e", "Gate 6F B1 seed")
	try require_hash(baseline_sources.entry_path, "d6cbf5100e2d76f6d04ff48a597de11fea8abd952f9c8e212f1d6f71de30c9ce", "baseline compiler entry")
	try require_hash(candidate_sources.entry_path, "ebba63420e0cee349f0abf2726686b161712ef3f8a9d5399bdea8e23d0940dc0", "candidate compiler entry")
	try require_hash(baseline_sources.storage_path, "d4c77fec9e5c5e8580cb0b5ee71fbd2c9c714555cbd4fd1457fcd44cc6db1f9d", "baseline storage source")
	try require_hash(candidate_sources.storage_path, "d4c77fec9e5c5e8580cb0b5ee71fbd2c9c714555cbd4fd1457fcd44cc6db1f9d", "candidate storage source")
	try require_hash(baseline_sources.path_path, "6347003851071b73cb8dbf38622fcc7cf3be6abf81ea253b9aad081fb057510a", "baseline path source")
	try require_hash(candidate_sources.path_path, "6347003851071b73cb8dbf38622fcc7cf3be6abf81ea253b9aad081fb057510a", "candidate path source")
	baseline_chain := try build_compiler_chain(seed, baseline_sources, qbe, cc, workspace + "/baseline-chain", "baseline")
	candidate_chain := try build_compiler_chain(seed, candidate_sources, qbe, cc, workspace + "/candidate-chain", "candidate")
	try require_hash(baseline_chain.b4, "2b63bd297e2e049f51c54b59299385aabf05d93ff218c701a5c6a54307358e12", "baseline B4 compiler")
	try require_hash(candidate_chain.b4, "0c3c8c2d59a416aeb2165079a3e14ea83f2624aed3ea3deb750b7e47c3271cd7", "candidate B4 compiler")
	try require_hash(baseline_chain.fixed_qbe_path, "626bcdfb28c6517c50b86851edf76f4ab5b0d8ada7d28e73209ff10e193bae67", "baseline fixed-point QBE")
	try require_hash(candidate_chain.fixed_qbe_path, "7f67262117dfdcd8f075cb9273fe5843051a53ceddcff71bc8c633ce262fe402", "candidate fixed-point QBE")
	scale_source_path := workspace + "/scale-6000.trb"
	try write_required(scale_source_path, try gate6g_scale_source(6000))
	baseline_scale_qbe := try emitted_qbe(baseline_chain.b4, scale_source_path, "baseline scale")
	candidate_scale_qbe := try emitted_qbe(candidate_chain.b4, scale_source_path, "candidate scale")
	if baseline_scale_qbe != candidate_scale_qbe
		return Result<Boolean, String>::Err("candidate scale QBE differs from baseline")
	end
	scale_qbe_path := workspace + "/scale-6000.ssa"
	try write_required(scale_qbe_path, baseline_scale_qbe)
	try require_hash(scale_qbe_path, "05fc4203f253c341ac4bab441a3d9c06320e36ad2c40e4ef56ce0b39b4479559", "scale QBE")
	application_project := workspace + "/file-root-project"
	try prepare_application(candidate_root, application_project)
	application_directories := [workspace + "/application-baseline", workspace + "/application-candidate", workspace + "/application-repeat"]
	mut index := 0
	while index < application_directories.size()
		try create_required_directory(application_directories[index])
		index += 1
	end
	application_outputs := [
		application_directories[0] + "/program",
		application_directories[1] + "/program",
		application_directories[2] + "/program",
	]
	try build_checked(baseline_chain.b4, application_project + "/main.trb", application_outputs[0], qbe, cc, "baseline application")
	try build_checked(candidate_chain.b4, application_project + "/main.trb", application_outputs[1], qbe, cc, "candidate application")
	try build_checked(candidate_chain.b4, application_project + "/main.trb", application_outputs[2], qbe, cc, "repeated candidate application")
	index = 0
	while index < application_outputs.size()
		try verify_application(application_outputs[index], "application " + index.to_s())
		try require_hash(application_outputs[index], "413d97fd8a3f26e1086795b1fd5306ad5817613e7080ddba410eb8264c0a67b9", "application " + index.to_s())
		if index > 0
			try require_file_equal(application_outputs[0], application_outputs[index], "application bytes differ")
		end
		index += 1
	end
	measured_directories := [workspace + "/measured-baseline", workspace + "/measured-candidate"]
	index = 0
	while index < measured_directories.size()
		try create_required_directory(measured_directories[index])
		index += 1
	end
	compilers := [baseline_chain.b4, candidate_chain.b4]
	compiler_sources := [baseline_sources.entry_path, candidate_sources.entry_path]
	compiler_qbe := [baseline_chain.fixed_qbe, candidate_chain.fixed_qbe]
	measured_outputs := [measured_directories[0] + "/compiler", measured_directories[1] + "/compiler"]
	expected_outputs := [baseline_chain.b4, candidate_chain.b4]
	mut output := string_builder.new()
	output.append("metric,case,candidate,iteration,value,status\n")
	direct_times := try measure_emit_time_series(output, compilers, compiler_sources, compiler_qbe, "compiler-source")
	build_times := try measure_build_time_series(output, compilers, compiler_sources, measured_outputs, expected_outputs, qbe, cc)
	scale_sources := [scale_source_path, scale_source_path]
	scale_qbe := [baseline_scale_qbe, baseline_scale_qbe]
	scale_times := try measure_emit_time_series(output, compilers, scale_sources, scale_qbe, "scale-6000-functions")
	direct_rss := try measure_emit_rss_series(output, compilers, compiler_sources, compiler_qbe, "compiler-source")
	build_rss := try measure_build_rss_series(output, compilers, compiler_sources, measured_outputs, expected_outputs, qbe, cc)
	scale_rss := try measure_emit_rss_series(output, compilers, scale_sources, scale_qbe, "scale-6000-functions")
	baseline_direct_median := gate6g_median_float(direct_times[0])
	candidate_direct_median := gate6g_median_float(direct_times[1])
	baseline_build_median := gate6g_median_float(build_times[0])
	candidate_build_median := gate6g_median_float(build_times[1])
	baseline_scale_median := gate6g_median_float(scale_times[0])
	candidate_scale_median := gate6g_median_float(scale_times[1])
	baseline_direct_rss := gate6g_median_integer(direct_rss[0])
	candidate_direct_rss := gate6g_median_integer(direct_rss[1])
	baseline_build_rss := gate6g_median_integer(build_rss[0])
	candidate_build_rss := gate6g_median_integer(build_rss[1])
	baseline_scale_rss := gate6g_median_integer(scale_rss[0])
	candidate_scale_rss := gate6g_median_integer(scale_rss[1])
	append_measurement(output, "median", "compiler-emit-qbe-total", "baseline", 0, baseline_direct_median.to_s(), 0)
	append_measurement(output, "median", "compiler-emit-qbe-total", "candidate", 0, candidate_direct_median.to_s(), 0)
	append_measurement(output, "median", "compiler-build-total", "baseline", 0, baseline_build_median.to_s(), 0)
	append_measurement(output, "median", "compiler-build-total", "candidate", 0, candidate_build_median.to_s(), 0)
	append_measurement(output, "median", "scale-6000-functions-total", "baseline", 0, baseline_scale_median.to_s(), 0)
	append_measurement(output, "median", "scale-6000-functions-total", "candidate", 0, candidate_scale_median.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-emit-qbe", "baseline", 0, baseline_direct_rss.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-emit-qbe", "candidate", 0, candidate_direct_rss.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-build", "baseline", 0, baseline_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-build", "candidate", 0, candidate_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-6000-functions", "baseline", 0, baseline_scale_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-6000-functions", "candidate", 0, candidate_scale_rss.to_s(), 0)
	append_measurement(output, "improvement-limit-percent", "compiler-emit-qbe", "candidate-over-baseline", 0, "95", 0)
	append_measurement(output, "improvement-limit-percent", "compiler-build", "candidate-over-baseline", 0, "97", 0)
	append_measurement(output, "improvement-limit-percent", "scale-6000-functions", "candidate-over-baseline", 0, "75", 0)
	append_measurement(output, "rss-limit-percent", "compiler-emit-qbe", "candidate-over-baseline", 0, "105", 0)
	append_measurement(output, "rss-limit-percent", "compiler-build", "candidate-over-baseline", 0, "105", 0)
	append_measurement(output, "rss-limit-percent", "scale-6000-functions", "candidate-over-baseline", 0, "110", 0)
	append_measurement(output, "compiler-size-absolute-limit", "compiler-source", "candidate", 0, "208530", 0)
	baseline_stripped := try strip_and_record(output, "baseline-b4", baseline_chain.b4, workspace + "/baseline-chain/stripped")
	candidate_stripped := try strip_and_record(output, "candidate-b4", candidate_chain.b4, workspace + "/candidate-chain/stripped")
	try record_hash(output, "seed-sha256", "compiler-seed", "gate6f-b1", seed)
	try record_hash(output, "compiler-source-sha256", "source", "baseline-entry", baseline_sources.entry_path)
	try record_hash(output, "compiler-source-sha256", "source", "candidate-entry", candidate_sources.entry_path)
	try record_hash(output, "scale-source-sha256", "source", "6000-functions", scale_source_path)
	try record_hash(output, "scale-qbe-sha256", "qbe", "both", scale_qbe_path)
	try record_chain_hashes(output, "baseline", baseline_chain)
	try record_chain_hashes(output, "candidate", candidate_chain)
	try record_hash(output, "application-sha256", "file-root", "candidate", application_outputs[1])
	append_measurement(output, "compiler-size-stripped-baseline", "compiler-source", "gate6f", 0, baseline_stripped.to_s(), 0)
	append_measurement(output, "compiler-size-stripped-candidate", "compiler-source", "gate6g", 0, candidate_stripped.to_s(), 0)
	try require_no_intermediates(workspace)
	try write_required(raw_path, output.to_s())
	try record_inventory(
		inventory_path,
		candidate_root,
		baseline_root,
		seed,
		seed_provenance,
		benchmark,
		qbe,
		cc,
		go_command,
		workspace,
		baseline_sources,
		candidate_sources,
		baseline_chain,
		candidate_chain,
		scale_source_path,
		scale_qbe_path,
		application_outputs[1],
	)
	if !gate6g_candidate_within_percent(baseline_direct_median, candidate_direct_median, 95.0)
		return Result<Boolean, String>::Err("candidate compiler emit-qbe median misses the 5% improvement")
	end
	if !gate6g_candidate_within_percent(baseline_build_median, candidate_build_median, 97.0)
		return Result<Boolean, String>::Err("candidate compiler build median misses the 3% improvement")
	end
	if !gate6g_candidate_within_percent(baseline_scale_median, candidate_scale_median, 75.0)
		return Result<Boolean, String>::Err("candidate scale median misses the 25% improvement")
	end
	if candidate_direct_rss * 100 > baseline_direct_rss * 105
		return Result<Boolean, String>::Err("candidate compiler emit-qbe RSS exceeds the 5% bound")
	end
	if candidate_build_rss * 100 > baseline_build_rss * 105
		return Result<Boolean, String>::Err("candidate compiler build RSS exceeds the 5% bound")
	end
	if candidate_scale_rss * 100 > baseline_scale_rss * 110
		return Result<Boolean, String>::Err("candidate scale RSS exceeds the 10% bound")
	end
	if candidate_stripped > 208530
		return Result<Boolean, String>::Err("candidate stripped compiler exceeds the registered size bound")
	end
	return Result<Boolean, String>::Ok(true)
end

def main()
	arguments := argv()
	if arguments.size() != 11
		puts(
			"usage: gate6g-benchmark CANDIDATE_ROOT BASELINE_ROOT SEED SEED_PROVENANCE BENCHMARK QBE CC GO WORKSPACE RAW_CSV INVENTORY",
		)
		return
	end
	case execute_benchmark(
			arguments[0],
			arguments[1],
			arguments[2],
			arguments[3],
			arguments[4],
			arguments[5],
			arguments[6],
			arguments[7],
			arguments[8],
			arguments[9],
			arguments[10],
		)
	when Result::Ok(_value)
		puts(arguments[9])
		puts(arguments[10])
	when Result::Err(error)
		puts(error)
	end
end
