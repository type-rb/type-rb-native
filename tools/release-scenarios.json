      "declarations": "import trb/std/process\nimport trb/std/result\n",
      "body": "case Process.run(\"/bin/sh\", [\"-c\", \"printf before; exit 7\"])\nwhen Result::Ok(value)\nputs(value.status)\nputs(value.stdout)\nputs(value.stderr)\nputs(value.success)\nwhen Result::Err(error)\nputs(error.operation)\nend",
      "kind": "accepted",
      "stdout": "7\nbefore\n\nfalse\n"
    },
