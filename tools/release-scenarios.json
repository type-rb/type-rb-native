      "id": "process-argv-fresh",
      "row": "package.std.process",
      "declarations": "import trb/std/process\n",
      "body": "mut first := Process.argv()\nfirst.push(\"local\")\nputs(first.size())\nputs(Process.argv().size())",
      "kind": "accepted",
      "stdout": "1\n0\n"
    },
    {
