      "id": "process-working-directory",
      "row": "package.std.process",
      "declarations": "import trb/std/process\nimport trb/std/result\n",
      "body": "expected := Process.environment(\"TRB_SCENARIO_CWD\")\ncase Process.working_directory()\nwhen Result::Ok(value)\nif expected != nil\nputs(value == expected)\nelse\nputs(false)\nend\nwhen Result::Err(error)\nputs(error.operation)\nend",
      "kind": "accepted",
      "stdout": "true\n"
    },
    {
      "id": "process-run-success",
      "row": "package.std.process",
      "declarations": "import trb/std/process\nimport trb/std/result\n",
      "body": "case Process.run(\"/bin/sh\", [\"-c\", \"printf out; printf err >&2\"])\nwhen Result::Ok(value)\nputs(value.status)\nputs(value.stdout)\nputs(value.stderr)\nputs(value.success)\nwhen Result::Err(error)\nputs(error.operation)\nend",
      "kind": "accepted",
      "stdout": "0\nout\nerr\ntrue\n"
    },
    {
      "id": "process-run-nonzero",
