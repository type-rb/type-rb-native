def sum(values: Array<Float>): Float
	mut index := 0
	mut total: Float := 0.0
	while index < values.size()
		total += values[index]
		index += 1
	end
	return total
end

def main()
	mut values: Array<Float> := []
	mut index := 0
	while index < 10
		values.push(index % 10)
		index += 1
	end
	mut result := 0.0
	mut round := 0
	while round < 10000000
		result = sum(values)
		round += 1
	end
	puts(result.to_i().to_s())
	return
end
