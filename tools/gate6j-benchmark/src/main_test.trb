import {
	gate6j_candidate_within_percent,
	gate6j_median_float,
	gate6j_median_integer,
	verify_float_array_qbe,
} from main
import { Result } from trb/std/result
import { describe, expect, test } from trb/std/test

describe("Gate 6J benchmark policy") do
	test("computes registered odd medians without mutating input") do
		floats := [5.0, 1.0, 4.0, 2.0, 3.0]
		integers := [50, 10, 40, 20, 30]
		expect(gate6j_median_float(floats)).to_equal(3.0)
		expect(gate6j_median_integer(integers)).to_equal(30)
		expect(floats[0]).to_equal(5.0)
		expect(integers[0]).to_equal(50)
	end

	test("enforces percentage bounds at their exact boundary") do
		expect(gate6j_candidate_within_percent(100.0, 110.0, 110.0)).to_be_true()
		expect(gate6j_candidate_within_percent(100.0, 110.001, 110.0)).to_be_false()
		expect(gate6j_candidate_within_percent(100.0, 125.0, 125.0)).to_be_true()
		expect(gate6j_candidate_within_percent(100.0, 125.001, 125.0)).to_be_false()
	end

	test("requires the direct Float Array cell ABI") do
		qbe := (
			"function $g4_array_push_d(l %array, d %value) {\n" +
			"@start\n" +
			"\tcall $g4_array_push_d(l %array, d %value)\n" +
			"\t%wide =d sltof 1\n" +
			"\t%loaded =d loadd %slot\n" +
			"\tstored %wide, %slot\n" +
			"\tret\n}\n"
		)
		case verify_float_array_qbe(qbe)
		when Result::Ok(_value)
			expect(true).to_be_true()
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
		case verify_float_array_qbe(qbe.replace_all("=d sltof ", "=d copy "))
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(error)
			expect(error).to_equal("Float Array QBE is missing =d sltof ")
		end
		case verify_float_array_qbe(qbe.replace_all("d %value", "l %value"))
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(error)
			expect(error).to_equal(
				"Float Array QBE is missing function $g4_array_push_d(l %array, d %value)",
			)
		end
		case verify_float_array_qbe(
				qbe + "function $g4_array_push_d(l %array, l %value) {\n@start\n\tret\n}\n",
			)
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(error)
			expect(error).to_equal("Float Array push uses the Integer ABI")
		end
		case verify_float_array_qbe(
				qbe + "\tcall $g4_array_push(l %array, l 0)\n",
			)
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(error)
			expect(error).to_equal("Float Array push retains the nested general-push path")
		end
	end
end
