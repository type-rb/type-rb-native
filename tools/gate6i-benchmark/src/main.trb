import trb/std/filesystem
import trb/std/process
import trb/std/result
import trb/std/string_builder
import { Instant } from trb/std/time

record TimedProcess
	seconds: Float
	status: Integer
	stdout: String
	stderr: String
end

record PeakProcess
	rss: Integer
	status: Integer
	stdout: String
	stderr: String
end

record CompilerSources
	root: String
	entry_path: String
	storage_path: String
	path_path: String
	entry: String
	storage: String
	path_source: String
end

record CompilerChain
	b2: String
	b3: String
	b4: String
	fixed_qbe: String
	fixed_qbe_path: String
end

record ApplicationBuild
	command: String
	arguments: Array<String>
	output_path: String
	expected_path: String
	label: String
end

def measure_process(command: String, arguments: Array<String>): Result<TimedProcess, String>
	started := Instant.now()
	case Process.run(command, arguments)
	when Result::Ok(process)
		return Result<TimedProcess, String>::Ok(
			TimedProcess.new(
				seconds: Instant.now().duration_since(started).total_seconds(),
				status: process.status,
				stdout: process.stdout,
				stderr: process.stderr,
			),
		)
	when Result::Err(error)
		return Result<TimedProcess, String>::Err(error.operation + ": " + error.message)
	end
end

def peak_process(command: String, arguments: Array<String>): Result<PeakProcess, String>
	mut time_arguments := ["-l", command]
	mut index := 0
	while index < arguments.size()
		time_arguments.push(arguments[index])
		index += 1
	end
	measurement := try measure_process("/usr/bin/time", time_arguments)
	lines := measurement.stderr.split("\n")
	index = 0
	while index < lines.size()
		if lines[index].include?("maximum resident set size")
			fields := lines[index].strip().split(" ")
			mut field_index := 0
			while field_index < fields.size()
				if !fields[field_index].empty?()
					return Result<PeakProcess, String>::Ok(
						PeakProcess.new(
							rss: fields[field_index].to_i(),
							status: measurement.status,
							stdout: measurement.stdout,
							stderr: measurement.stderr,
						),
					)
				end
				field_index += 1
			end
		end
		index += 1
	end
	return Result<PeakProcess, String>::Err(
		"time did not report maximum resident set size for " + command + ": " + measurement.stderr,
	)
end

def append_measurement(
		mut output: StringBuilder,
		metric: String,
		case_name: String,
		candidate: String,
		iteration: Integer,
		value: String,
		status: Integer,
	)
	output.append(
		metric + "," + case_name + "," + candidate + "," + iteration.to_s() + "," + value + "," +
		status.to_s() + "\n",
	)
end

def create_required_directory(path: String): Result<Boolean, String>
	case FileSystem.create_directory(path)
	when Result::Ok(_unit)
		return Result<Boolean, String>::Ok(true)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
end

def read_required(path: String): Result<String, String>
	case FileSystem.read_text(path)
	when Result::Ok(value)
		return Result<String, String>::Ok(value)
	when Result::Err(error)
		return Result<String, String>::Err(error.operation + ": " + error.message)
	end
end

def write_required(path: String, value: String): Result<Boolean, String>
	case FileSystem.write_text(path, value)
	when Result::Ok(_unit)
		return Result<Boolean, String>::Ok(true)
	when Result::Err(error)
		return Result<Boolean, String>::Err(error.operation + ": " + error.message)
	end
end

def copy_required(source: String, destination: String): Result<Boolean, String>
	value := try read_required(source)
	return write_required(destination, value)
end

def require_file(path: String): Result<Boolean, String>
	probe := try measure_process("/bin/test", ["-f", path])
	return Result<Boolean, String>::Err("missing file " + path) if probe.status != 0
	return Result<Boolean, String>::Ok(true)
end

def require_file_equal(left: String, right: String, message: String): Result<Boolean, String>
	comparison := try measure_process("/usr/bin/cmp", [left, right])
	return Result<Boolean, String>::Err(message) if comparison.status != 0
	return Result<Boolean, String>::Ok(true)
end

def require_no_intermediates(directory: String): Result<Boolean, String>
	find := try measure_process("/usr/bin/find", [directory, "-name", "*.trbn.*", "-print"])
	return Result<Boolean, String>::Err("cannot inspect Native intermediates: " + find.stderr) if find.status != 0
	return Result<Boolean, String>::Err("Native build left intermediates: " + find.stdout) if !find.stdout.empty?()
	return Result<Boolean, String>::Ok(true)
end

def sha256(path: String): Result<String, String>
	measurement := try measure_process("/usr/bin/shasum", ["-a", "256", path])
	if measurement.status != 0
		return Result<String, String>::Err("shasum failed for " + path + ": " + measurement.stderr)
	end
	fields := measurement.stdout.strip().split(" ")
	return Result<String, String>::Err("shasum returned no digest for " + path) if fields.size() < 1
	return Result<String, String>::Ok(fields[0])
end

def require_hash(path: String, expected: String, label: String): Result<Boolean, String>
	actual := try sha256(path)
	return Result<Boolean, String>::Err(label + " SHA-256 differs: " + actual) if actual != expected
	return Result<Boolean, String>::Ok(true)
end

def file_size(path: String): Result<Integer, String>
	measurement := try measure_process("/usr/bin/stat", ["-f", "%z", path])
	if measurement.status != 0
		return Result<Integer, String>::Err("stat failed for " + path + ": " + measurement.stderr)
	end
	return Result<Integer, String>::Ok(measurement.stdout.strip().to_i())
end

def record_hash(
		mut output: StringBuilder,
		metric: String,
		case_name: String,
		candidate: String,
		path: String,
	): Result<String, String>
	digest := try sha256(path)
	append_measurement(output, metric, case_name, candidate, 0, digest, 0)
	return Result<String, String>::Ok(digest)
end

def record_size(
		mut output: StringBuilder,
		metric: String,
		case_name: String,
		candidate: String,
		path: String,
	): Result<Integer, String>
	size := try file_size(path)
	append_measurement(output, metric, case_name, candidate, 0, size.to_s(), 0)
	return Result<Integer, String>::Ok(size)
end

def strip_and_record(
		mut output: StringBuilder,
		candidate: String,
		path: String,
		stripped: String,
	): Result<Integer, String>
	measurement := try measure_process("/usr/bin/strip", ["-x", "-o", stripped, path])
	if measurement.status != 0
		return Result<Integer, String>::Err("strip failed for " + path + ": " + measurement.stderr)
	end
	try record_size(output, "compiler-size-raw", "compiler-source", candidate, path)
	return record_size(output, "compiler-size-stripped", "compiler-source", candidate, stripped)
end

def read_compiler_sources(root: String): Result<CompilerSources, String>
	entry_path := root + "/compiler/gate4/src/compiler.trb"
	storage_path := root + "/compiler/gate4/src/storage.trb"
	path_path := root + "/compiler/gate4/src/path.trb"
	return Result<CompilerSources, String>::Ok(
		CompilerSources.new(
			root: root,
			entry_path: entry_path,
			storage_path: storage_path,
			path_path: path_path,
			entry: try read_required(entry_path),
			storage: try read_required(storage_path),
			path_source: try read_required(path_path),
		),
	)
end

def build_arguments(
		source_path: String,
		output_path: String,
		qbe: String,
		cc: String,
	): Array<String>
	return ["build", source_path, "--output", output_path, "--qbe", qbe, "--cc", cc]
end

def go_build_arguments(config_path: String, output_path: String): Array<String>
	return ["build", "--compile", "--config", config_path, "--outfile", output_path]
end

def build_checked(
		seed: String,
		source_path: String,
		output_path: String,
		qbe: String,
		cc: String,
		label: String,
	): Result<Boolean, String>
	measurement := try measure_process(seed, build_arguments(source_path, output_path, qbe, cc))
	if measurement.status != 0 || !measurement.stdout.empty?() || !measurement.stderr.empty?()
		return Result<Boolean, String>::Err(label + " failed: " + measurement.stderr + measurement.stdout)
	end
	try require_file(output_path)
	return Result<Boolean, String>::Ok(true)
end

def emitted_qbe(executable: String, source_path: String, label: String): Result<String, String>
	emission := try measure_process(executable, ["emit-qbe", source_path])
	if emission.status != 0 || emission.stdout.empty?() || !emission.stderr.empty?()
		return Result<String, String>::Err(label + " QBE emission failed: " + emission.stderr)
	end
	return Result<String, String>::Ok(emission.stdout)
end

def verify_compiler(
		executable: String,
		source_path: String,
		expected_qbe: String,
		label: String,
	): Result<Boolean, String>
	check := try measure_process(executable, ["check", source_path])
	if check.status != 0 || check.stdout != "ok\n" || !check.stderr.empty?()
		return Result<Boolean, String>::Err(label + " compiler-source check failed")
	end
	emission := try emitted_qbe(executable, source_path, label)
	return Result<Boolean, String>::Err(label + " compiler QBE is not fixed") if emission != expected_qbe
	return Result<Boolean, String>::Ok(true)
end

def build_compiler_chain(
		seed: String,
		sources: CompilerSources,
		qbe: String,
		cc: String,
		workspace: String,
		label: String,
	): Result<CompilerChain, String>
	try create_required_directory(workspace)
	directories := [workspace + "/b2", workspace + "/b3", workspace + "/b4"]
	mut index := 0
	while index < directories.size()
		try create_required_directory(directories[index])
		index += 1
	end
	expected_qbe := try emitted_qbe(seed, sources.entry_path, label + " B1")
	outputs := [directories[0] + "/compiler", directories[1] + "/compiler", directories[2] + "/compiler"]
	mut chain_seed := seed
	index = 0
	while index < outputs.size()
		try build_checked(
			chain_seed,
			sources.entry_path,
			outputs[index],
			qbe,
			cc,
			label + " B" + (index + 1).to_s() + "-to-B" + (index + 2).to_s(),
		)
		try verify_compiler(outputs[index], sources.entry_path, expected_qbe, label + " B" + (index + 2).to_s())
		if index > 0
			try require_file_equal(outputs[index - 1], outputs[index], label + " B2/B3/B4 bytes differ")
		end
		chain_seed = outputs[index]
		index += 1
	end
	fixed_qbe_path := workspace + "/fixed-point.ssa"
	try write_required(fixed_qbe_path, expected_qbe)
	return Result<CompilerChain, String>::Ok(
		CompilerChain.new(
			b2: outputs[0],
			b3: outputs[1],
			b4: outputs[2],
			fixed_qbe: expected_qbe,
			fixed_qbe_path: fixed_qbe_path,
		),
	)
end

def prepare_application(root: String, project: String): Result<Boolean, String>
	try create_required_directory(project)
	directories := [project + "/app", project + "/domain", project + "/shared"]
	mut index := 0
	while index < directories.size()
		try create_required_directory(directories[index])
		index += 1
	end
	relative := [
		"main.trb",
		"app/summary.trb",
		"app/label.trb",
		"domain/score.trb",
		"shared/index.trb",
		"unrelated.trb",
	]
	fixture := root + "/compiler/gate4/conformance/file-root"
	index = 0
	while index < relative.size()
		try copy_required(fixture + "/" + relative[index], project + "/" + relative[index])
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def verify_application(executable: String, label: String): Result<Boolean, String>
	measurement := try measure_process(executable, [])
	if measurement.status != 0 || measurement.stdout != "file-root-ok\n" || !measurement.stderr.empty?()
		return Result<Boolean, String>::Err(label + " runtime differs: " + measurement.stderr)
	end
	return Result<Boolean, String>::Ok(true)
end

def verify_float_application(executable: String, label: String): Result<Boolean, String>
	measurement := try measure_process(executable, [])
	if measurement.status != 0 || measurement.stdout != "float-kernel-ok\n" || !measurement.stderr.empty?()
		return Result<Boolean, String>::Err(label + " runtime differs: " + measurement.stderr)
	end
	return Result<Boolean, String>::Ok(true)
end

def verify_float_conformance_application(executable: String, label: String): Result<Boolean, String>
	measurement := try measure_process(executable, [])
	if measurement.status != 0 || measurement.stdout != "float-scalars-ok\n" || !measurement.stderr.empty?()
		return Result<Boolean, String>::Err(label + " runtime differs: " + measurement.stderr)
	end
	return Result<Boolean, String>::Ok(true)
end

def verify_float_qbe(qbe: String): Result<Boolean, String>
	required := [
		"function d ",
		"=d sltof ",
		"=d loadd ",
		"stored ",
		"=d add ",
		"=d sub ",
		"=d mul ",
		"=d div ",
		"=w cltd ",
		"=w cgtd ",
	]
	mut index := 0
	while index < required.size()
		if !qbe.include?(required[index])
			return Result<Boolean, String>::Err("Float QBE is missing " + required[index])
		end
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def gate6i_median_float(values: Array<Float>): Float
	mut sorted: Array<Float> := []
	mut index := 0
	while index < values.size()
		sorted.push(values[index])
		index += 1
	end
	index = 0
	while index < sorted.size()
		mut other := index + 1
		while other < sorted.size()
			if sorted[other] < sorted[index]
				value := sorted[index]
				sorted[index] = sorted[other]
				sorted[other] = value
			end
			other += 1
		end
		index += 1
	end
	return sorted[sorted.size() / 2]
end

def gate6i_median_integer(values: Array<Integer>): Integer
	mut sorted: Array<Integer> := []
	mut index := 0
	while index < values.size()
		sorted.push(values[index])
		index += 1
	end
	index = 0
	while index < sorted.size()
		mut other := index + 1
		while other < sorted.size()
			if sorted[other] < sorted[index]
				value := sorted[index]
				sorted[index] = sorted[other]
				sorted[other] = value
			end
			other += 1
		end
		index += 1
	end
	return sorted[sorted.size() / 2]
end

def gate6i_candidate_within_percent(baseline: Float, candidate: Float, maximum_percent: Float): Boolean
	return candidate * 100.0 <= baseline * maximum_percent
end

def measure_emit_time(
		mut output: StringBuilder,
		compiler: String,
		source: String,
		expected: String,
		case_name: String,
		candidate: String,
		iteration: Integer,
	): Result<Float, String>
	measurement := try measure_process(compiler, ["emit-qbe", source])
	append_measurement(
		output,
		"compiler-emit-qbe-total",
		case_name,
		candidate,
		iteration,
		measurement.seconds.to_s(),
		measurement.status,
	)
	if measurement.status != 0 || measurement.stdout != expected || !measurement.stderr.empty?()
		return Result<Float, String>::Err(candidate + " " + case_name + " emission differs")
	end
	return Result<Float, String>::Ok(measurement.seconds)
end

def measure_emit_rss(
		mut output: StringBuilder,
		compiler: String,
		source: String,
		expected: String,
		case_name: String,
		candidate: String,
		iteration: Integer,
	): Result<Integer, String>
	measurement := try peak_process(compiler, ["emit-qbe", source])
	append_measurement(
		output,
		"compiler-emit-qbe-peak-rss",
		case_name,
		candidate,
		iteration,
		measurement.rss.to_s(),
		measurement.status,
	)
	if measurement.status != 0 || measurement.stdout != expected
		return Result<Integer, String>::Err(candidate + " " + case_name + " RSS emission differs")
	end
	return Result<Integer, String>::Ok(measurement.rss)
end

def measure_build_time(
		mut output: StringBuilder,
		compiler: String,
		source: String,
		output_path: String,
		expected_path: String,
		qbe: String,
		cc: String,
		candidate: String,
		iteration: Integer,
	): Result<Float, String>
	measurement := try measure_process(compiler, build_arguments(source, output_path, qbe, cc))
	append_measurement(
		output,
		"compiler-build-total",
		"compiler-source",
		candidate,
		iteration,
		measurement.seconds.to_s(),
		measurement.status,
	)
	if measurement.status != 0 || !measurement.stdout.empty?() || !measurement.stderr.empty?()
		return Result<Float, String>::Err(candidate + " compiler build failed")
	end
	try require_file_equal(output_path, expected_path, candidate + " measured compiler bytes differ")
	return Result<Float, String>::Ok(measurement.seconds)
end

def measure_build_rss(
		mut output: StringBuilder,
		compiler: String,
		source: String,
		output_path: String,
		expected_path: String,
		qbe: String,
		cc: String,
		candidate: String,
		iteration: Integer,
	): Result<Integer, String>
	measurement := try peak_process(compiler, build_arguments(source, output_path, qbe, cc))
	append_measurement(
		output,
		"compiler-build-peak-rss",
		"compiler-source",
		candidate,
		iteration,
		measurement.rss.to_s(),
		measurement.status,
	)
	if measurement.status != 0 || !measurement.stdout.empty?()
		return Result<Integer, String>::Err(candidate + " compiler RSS build failed")
	end
	try require_file_equal(output_path, expected_path, candidate + " RSS compiler bytes differ")
	return Result<Integer, String>::Ok(measurement.rss)
end

def measure_emit_time_series(
		mut output: StringBuilder,
		compilers: Array<String>,
		sources: Array<String>,
		expected: Array<String>,
		case_name: String,
	): Result<Array<Array<Float>>, String>
	mut baseline_values: Array<Float> := []
	mut candidate_values: Array<Float> := []
	mut iteration :=- 2
	while iteration < 11
		mut order := 0
		while order < 2
			mut candidate := order
			if iteration % 2 != 0
				candidate = 1 - order
			end
			mut label := "baseline"
			if candidate == 1
				label = "candidate"
			end
			value := try measure_emit_time(
				output,
				compilers[candidate],
				sources[candidate],
				expected[candidate],
				case_name,
				label,
				iteration,
			)
			if iteration >= 0
				if candidate == 0
					baseline_values.push(value)
				else
					candidate_values.push(value)
				end
			end
			order += 1
		end
		iteration += 1
	end
	return Result<Array<Array<Float>>, String>::Ok([baseline_values, candidate_values])
end

def measure_emit_rss_series(
		mut output: StringBuilder,
		compilers: Array<String>,
		sources: Array<String>,
		expected: Array<String>,
		case_name: String,
	): Result<Array<Array<Integer>>, String>
