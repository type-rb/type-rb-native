def require_command_success(command: String, arguments: Array<String>, label: String): Result<Boolean, String>
	measurement := try measure_process(command, arguments)
	if measurement.status != 0
		return Result<Boolean, String>::Err(label + " failed: " + measurement.stderr + measurement.stdout)
	end
	return Result<Boolean, String>::Ok(true)
end

def require_file_absent(path: String, label: String): Result<Boolean, String>
	probe := try measure_process("/bin/test", ["-e", path])
	return Result<Boolean, String>::Err(label + " unexpectedly exists: " + path) if probe.status == 0
	return Result<Boolean, String>::Ok(true)
end

def require_text(path: String, expected: String, label: String): Result<Boolean, String>
	actual := try read_required(path)
	return Result<Boolean, String>::Err(label + " content differs") if actual != expected
	return Result<Boolean, String>::Ok(true)
end

def prepare_configured_project(root: String, project: String): Result<Boolean, String>
	try create_required_directory(project)
	directories := [project + "/src", project + "/src/lib", project + "/src/lib/value"]
	mut index := 0
	while index < directories.size()
		try create_required_directory(directories[index])
		index += 1
	end
	fixture := root + "/corpus/gate6k/configured-project"
	relative := [
		"trbconfig.jsonc",
		"go.mod",
		"src/application.trb",
		"src/ignored_test.trb",
		"src/unrelated.trb",
		"src/lib/value.trb",
		"src/lib/value/index.trb",
	]
	index = 0
	while index < relative.size()
		try copy_required(fixture + "/" + relative[index], project + "/" + relative[index])
		index += 1
	end
	return Result<Boolean, String>::Ok(true)
end

def prepare_probe_project(root: String, project: String, application_source: String): Result<Boolean, String>
	try create_required_directory(project)
	try create_required_directory(project + "/src")
	fixture := root + "/corpus/gate6k/configured-project"
	try copy_required(fixture + "/trbconfig.jsonc", project + "/trbconfig.jsonc")
	try copy_required(fixture + "/go.mod", project + "/go.mod")
	try write_required(project + "/src/application.trb", application_source)
	return Result<Boolean, String>::Ok(true)
end

def require_native_check(compiler: String, config: String, label: String): Result<Boolean, String>
	measurement := try measure_process(compiler, ["check", config])
	if measurement.status != 0 || measurement.stdout != "ok\n" || !measurement.stderr.empty?()
		return Result<Boolean, String>::Err(label + " failed: " + measurement.stderr + measurement.stdout)
	end
	return Result<Boolean, String>::Ok(true)
end

def require_deterministic_failure(
		command: String,
		arguments: Array<String>,
		needle: String,
		label: String,
	): Result<Boolean, String>
	first := try measure_process(command, arguments)
	second := try measure_process(command, arguments)
	if first.status == 0 || second.status == 0
		return Result<Boolean, String>::Err(label + " unexpectedly succeeded")
	end
	if first.status != second.status || first.stdout != second.stdout || first.stderr != second.stderr
		return Result<Boolean, String>::Err(label + " is not deterministic")
	end
	combined := first.stderr + first.stdout
	if !combined.include?(needle)
		return Result<Boolean, String>::Err(label + " does not contain expected diagnostic: " + combined)
	end
	return Result<Boolean, String>::Ok(true)
end

def prepare_probe_tool(path: String, marker: String, status: Integer): Result<Boolean, String>
	source := "#!/bin/sh\n/usr/bin/touch \"" + marker + "\"\nexit " + status.to_s() + "\n"
	try write_required(path, source)
	return require_command_success("/bin/chmod", ["755", path], "make probe tool executable")
end

def run_configured_project_probes(
		root: String,
		compiler: String,
		qbe: String,
		cc: String,
		workspace: String,
	): Result<Boolean, String>
	try create_required_directory(workspace)

	spaces_project := workspace + "/project with spaces"
	try prepare_configured_project(root, spaces_project)
	excluded_directories := [
		spaces_project + "/src/.git",
		spaces_project + "/src/.trb",
		spaces_project + "/src/node_modules",
	]
	mut index := 0
	while index < excluded_directories.size()
		try create_required_directory(excluded_directories[index])
		try write_required(excluded_directories[index] + "/invalid.trb", "this is not TypeRB\n")
		index += 1
	end
	non_source_link := spaces_project + "/src/non-source-link"
	try require_command_success(
		"/bin/ln",
		["-s", spaces_project + "/missing-target", non_source_link],
		"create non-source symlink",
	)
	try require_native_check(compiler, spaces_project + "/trbconfig.jsonc", "space/exclusion/symlink project")

	symlink_project := workspace + "/symlink-source"
	try prepare_configured_project(root, symlink_project)
	try require_command_success(
		"/bin/ln",
		["-s", symlink_project + "/src/application.trb", symlink_project + "/src/linked.trb"],
		"create source symlink",
	)
	try require_deterministic_failure(
		compiler,
		["check", symlink_project + "/trbconfig.jsonc"],
		"cannot collect project source",
		"symlinked source",
	)

	unreadable_project := workspace + "/unreadable-source"
	try prepare_configured_project(root, unreadable_project)
	unreadable_source := unreadable_project + "/src/unreadable.trb"
	try write_required(unreadable_source, "def helper(): Integer\n\treturn 1\nend\n")
	try require_command_success("/bin/chmod", ["000", unreadable_source], "make source unreadable")
	unreadable_first := try measure_process(compiler, ["check", unreadable_project + "/trbconfig.jsonc"])
	unreadable_second := try measure_process(compiler, ["check", unreadable_project + "/trbconfig.jsonc"])
	try require_command_success("/bin/chmod", ["644", unreadable_source], "restore source permissions")
	if unreadable_first.status == 0 || unreadable_first.status != unreadable_second.status || unreadable_first.stdout != unreadable_second.stdout || unreadable_first.stderr != unreadable_second.stderr
		return Result<Boolean, String>::Err("unreadable source failure is not deterministic")
	end
	if !(unreadable_first.stderr + unreadable_first.stdout).include?("cannot collect project source")
		return Result<Boolean, String>::Err("unreadable source diagnostic differs")
	end

	zero_main := workspace + "/zero-main"
	try prepare_probe_project(root, zero_main, "def helper(): Integer\n\treturn 1\nend\n")
	try require_deterministic_failure(
		compiler,
		["check", zero_main + "/trbconfig.jsonc"],
		"project must declare exactly one top-level main function",
		"zero main",
	)

	duplicate_main := workspace + "/duplicate-main"
	try prepare_probe_project(root, duplicate_main, "def main()\n\treturn\nend\n")
	try write_required(duplicate_main + "/src/other.trb", "def main()\n\treturn\nend\n")
	try require_deterministic_failure(
		compiler,
		["check", duplicate_main + "/trbconfig.jsonc"],
		"project has more than one top-level main function",
		"duplicate main",
	)

	missing_import := workspace + "/missing-import"
	try prepare_probe_project(
		root,
		missing_import,
		"import { missing } from absent\n\ndef main()\n\treturn\nend\n",
	)
	try require_deterministic_failure(
		compiler,
		["check", missing_import + "/trbconfig.jsonc"],
		"cannot resolve project import absent",
		"missing import",
	)

	cycle_project := workspace + "/cycle"
	try prepare_probe_project(
		root,
		cycle_project,
		"import { a } from a\n\ndef main()\n\ta()\n\treturn\nend\n",
	)
	try write_required(cycle_project + "/src/a.trb", "import { b } from b\n\ndef a()\n\tb()\n\treturn\nend\n")
	try write_required(cycle_project + "/src/b.trb", "import { a } from a\n\ndef b()\n\ta()\n\treturn\nend\n")
	try require_deterministic_failure(
		compiler,
		["check", cycle_project + "/trbconfig.jsonc"],
		"import cycle through",
		"import cycle",
	)

	unimported_invalid := workspace + "/unimported-invalid"
	try prepare_probe_project(root, unimported_invalid, "def main()\n\treturn\nend\n")
	try write_required(unimported_invalid + "/src/bad.trb", "this is not TypeRB\n")
	try require_deterministic_failure(
		compiler,
		["check", unimported_invalid + "/trbconfig.jsonc"],
		"unsupported top-level declaration this",
		"unimported invalid source",
	)

	tool_project := workspace + "/tool-suppression"
	try prepare_probe_project(root, tool_project, "def helper(): Integer\n\treturn 1\nend\n")
	marker := workspace + "/compiler-diagnostic-tool-launched"
	probe_tool := workspace + "/probe-tool"
	try prepare_probe_tool(probe_tool, marker, 91)
	protected_output := workspace + "/protected-output"
	try write_required(protected_output, "preserve-me\n")
	try require_deterministic_failure(
		compiler,
		build_arguments(tool_project + "/trbconfig.jsonc", protected_output, probe_tool, probe_tool),
		"project must declare exactly one top-level main function",
		"tool suppression after compiler diagnostic",
	)
	try require_file_absent(marker, "compiler diagnostic tool marker")
	try require_text(protected_output, "preserve-me\n", "compiler diagnostic protected output")

	valid_project := spaces_project + "/trbconfig.jsonc"
	qbe_output := workspace + "/qbe-failure-output"
	try write_required(qbe_output, "preserve-qbe\n")
	qbe_failure := try measure_process(compiler, build_arguments(valid_project, qbe_output, "/usr/bin/false", cc))
	return Result<Boolean, String>::Err("QBE failure unexpectedly succeeded") if qbe_failure.status == 0
	try require_text(qbe_output, "preserve-qbe\n", "QBE failure protected output")

	cc_output := workspace + "/cc-failure-output"
	try write_required(cc_output, "preserve-cc\n")
	cc_failure := try measure_process(compiler, build_arguments(valid_project, cc_output, qbe, "/usr/bin/false"))
	return Result<Boolean, String>::Err("CC failure unexpectedly succeeded") if cc_failure.status == 0
	try require_text(cc_output, "preserve-cc\n", "CC failure protected output")
	try require_no_intermediates(workspace)
	return Result<Boolean, String>::Ok(true)
end

def strip_application_and_record(
		mut output: StringBuilder,
		candidate: String,
		path: String,
		stripped: String,
	): Result<Integer, String>
	measurement := try measure_process("/usr/bin/strip", ["-x", "-o", stripped, path])
	if measurement.status != 0
		return Result<Integer, String>::Err("strip failed for " + path + ": " + measurement.stderr)
	end
	try record_size(output, "application-size-raw", "scale-1024-modules", candidate, path)
	return record_size(output, "application-size-stripped", "scale-1024-modules", candidate, stripped)
end

def append_inventory_command(
		mut inventory: StringBuilder,
		label: String,
		command: String,
		arguments: Array<String>,
	): Result<TimedProcess, String>
	inventory.append("## " + label + "\n")
	inventory.append("command: " + command)
	mut index := 0
	while index < arguments.size()
		inventory.append(" " + arguments[index])
		index += 1
	end
	inventory.append("\n")
	measurement := try measure_process(command, arguments)
	inventory.append("status: " + measurement.status.to_s() + "\n")
	if !measurement.stdout.empty?()
		inventory.append("stdout:\n" + measurement.stdout)
		if !measurement.stdout.end_with?("\n")
			inventory.append("\n")
		end
	end
	if !measurement.stderr.empty?()
		inventory.append("stderr:\n" + measurement.stderr)
		if !measurement.stderr.end_with?("\n")
			inventory.append("\n")
		end
	end
	inventory.append("\n")
	return Result<TimedProcess, String>::Ok(measurement)
end

def record_inventory(
		inventory_path: String,
		candidate_root: String,
		baseline_root: String,
		seed: String,
		seed_provenance: String,
		benchmark: String,
		reference_trb: String,
		qbe: String,
		cc: String,
		go_command: String,
		workspace: String,
		baseline_sources: CompilerSources,
		candidate_sources: CompilerSources,
		baseline_chain: CompilerChain,
		candidate_chain: CompilerChain,
		small_config: String,
		small_manifest: String,
		scale_entry: String,
		scale_config: String,
		scale_manifest: String,
		scale_qbe: String,
		small_application: String,
		native_scale_application: String,
		go_scale_application: String,
	): Result<Boolean, String>
	mut inventory := string_builder.new()
	inventory.append("Gate 6K explicit configured-project process inventory\n\n")
	inventory.append("initial seed provenance (outside ordinary chains):\n  " + seed_provenance + "\n\n")
	inventory.append("fresh Gate 6J baseline chain:\n")
	inventory.append("  B1 -> baseline B2/compiler -> baseline B3/compiler -> baseline B4/compiler\n")
	inventory.append("Gate 6K introduction and candidate chain:\n")
	inventory.append("  B1 -> untimed file-root transition -> candidate B2 -> candidate B3 -> candidate B4\n")
	inventory.append("  the transition is setup-only and is not a candidate, measurement, or release seed\n\n")
	inventory.append("measured comparison:\n")
	inventory.append("  fresh Gate 6J B4 versus Gate 6K B4 on their canonical compiler closures\n")
	inventory.append("  Gate 6K B4 file-root versus configured input on one 1,025-file source graph\n")
	inventory.append("  Gate 6K B4 configured input versus pinned optimized Go on that configured project\n")
	inventory.append("  two warmups precede eleven alternating check/emit/build time and RSS observations\n")
	inventory.append("  three warmups precede 31 alternating Native/Go runtime observations\n\n")
	inventory.append("retained external boundary:\n")
	inventory.append("  Native compiler -> explicit QBE 1.3 -> explicit system CC -> assembler/linker\n")
	inventory.append("  Go, reference trb, benchmark controller, setup probes, and recovery remain outside ordinary chains\n\n")
	inventory.append("exact measured commands:\n")
	inventory.append("  " + baseline_chain.b4 + " emit-qbe " + baseline_sources.entry_path + "\n")
	inventory.append("  " + candidate_chain.b4 + " emit-qbe " + candidate_sources.entry_path + "\n")
	inventory.append("  " + baseline_chain.b4 + " build " + baseline_sources.entry_path + " --output " + workspace + "/measured-baseline/compiler --qbe " + qbe + " --cc " + cc + "\n")
	inventory.append("  " + candidate_chain.b4 + " build " + candidate_sources.entry_path + " --output " + workspace + "/measured-candidate/compiler --qbe " + qbe + " --cc " + cc + "\n")
	inventory.append("  " + candidate_chain.b4 + " check " + scale_entry + "\n")
	inventory.append("  " + candidate_chain.b4 + " check " + scale_config + "\n")
	inventory.append("  " + reference_trb + " check --config " + scale_config + "\n")
	inventory.append("  " + candidate_chain.b4 + " emit-qbe " + scale_entry + "\n")
	inventory.append("  " + candidate_chain.b4 + " emit-qbe " + scale_config + "\n")
	inventory.append("  " + candidate_chain.b4 + " build " + scale_entry + " --output <file-root-program> --qbe " + qbe + " --cc " + cc + "\n")
	inventory.append("  " + candidate_chain.b4 + " build " + scale_config + " --output <configured-native-program> --qbe " + qbe + " --cc " + cc + "\n")
	inventory.append("  " + reference_trb + " build --compile --config " + scale_config + " --outfile <configured-go-program>\n\n")
	try append_inventory_command(inventory, "candidate TypeRB Native revision", "/usr/bin/git", ["-C", candidate_root, "rev-parse", "HEAD"])
	try append_inventory_command(inventory, "candidate worktree status", "/usr/bin/git", ["-C", candidate_root, "status", "--porcelain"])
	try append_inventory_command(inventory, "baseline TypeRB Native revision", "/usr/bin/git", ["-C", baseline_root, "rev-parse", "HEAD"])
	try append_inventory_command(inventory, "operating system", "/usr/bin/sw_vers", [])
	try append_inventory_command(inventory, "kernel and architecture", "/usr/bin/uname", ["-a"])
	try append_inventory_command(inventory, "processor", "/usr/sbin/sysctl", ["-n", "machdep.cpu.brand_string"])
	try append_inventory_command(inventory, "physical memory", "/usr/sbin/sysctl", ["-n", "hw.memsize"])
	try append_inventory_command(inventory, "reference compiler version", reference_trb, ["version"])
	try append_inventory_command(inventory, "Go inventory tool version", go_command, ["version"])
	try append_inventory_command(inventory, "C toolchain version", cc, ["--version"])
	try append_inventory_command(inventory, "QBE probe", qbe, ["-h"])
	artifacts := [
		benchmark,
		seed,
		baseline_chain.b2,
		baseline_chain.b3,
		baseline_chain.b4,
		candidate_chain.transition,
		candidate_chain.b2,
		candidate_chain.b3,
		candidate_chain.b4,
		small_application,
		native_scale_application,
		go_scale_application,
		qbe,
	]
	try append_inventory_command(inventory, "artifact formats", "/usr/bin/file", artifacts)
	mut hash_arguments := ["-a", "256"]
	mut index := 0
	while index < artifacts.size()
		hash_arguments.push(artifacts[index])
		index += 1
	end
	try append_inventory_command(inventory, "artifact SHA-256", "/usr/bin/shasum", hash_arguments)
	try append_inventory_command(inventory, "compiler source closure SHA-256", "/usr/bin/shasum", [
			"-a",
			"256",
			baseline_sources.entry_path,
			baseline_sources.storage_path,
			baseline_sources.path_path,
			candidate_sources.entry_path,
			candidate_sources.storage_path,
			candidate_sources.path_path,
			small_config,
			small_manifest,
			scale_entry,
			scale_config,
			scale_manifest,
		])
	try append_inventory_command(inventory, "fixed-point and scale QBE SHA-256", "/usr/bin/shasum", [
			"-a",
			"256",
			baseline_chain.fixed_qbe_path,
			candidate_chain.fixed_qbe_path,
			scale_qbe,
		])
	try append_inventory_command(inventory, "baseline compiler undefined symbols", "/usr/bin/nm", ["-u", baseline_chain.b4])
	try append_inventory_command(inventory, "candidate compiler undefined symbols", "/usr/bin/nm", ["-u", candidate_chain.b4])
	try append_inventory_command(inventory, "baseline compiler dynamic libraries", "/usr/bin/otool", ["-L", baseline_chain.b4])
	try append_inventory_command(inventory, "candidate compiler dynamic libraries", "/usr/bin/otool", ["-L", candidate_chain.b4])
	try append_inventory_command(inventory, "Native scale application dynamic libraries", "/usr/bin/otool", ["-L", native_scale_application])
	try append_inventory_command(inventory, "Go scale application dynamic libraries", "/usr/bin/otool", ["-L", go_scale_application])
	try append_inventory_command(inventory, "baseline compiler Go metadata probe", go_command, ["version", "-m", baseline_chain.b4])
	try append_inventory_command(inventory, "candidate compiler Go metadata probe", go_command, ["version", "-m", candidate_chain.b4])
	small_go := try append_inventory_command(inventory, "configured small application Go metadata probe", go_command, ["version", "-m", small_application])
	if small_go.status == 0
		return Result<Boolean, String>::Err("Native configured small application unexpectedly contains Go metadata")
	end
	native_go := try append_inventory_command(inventory, "Native scale application Go metadata probe", go_command, ["version", "-m", native_scale_application])
	if native_go.status == 0
		return Result<Boolean, String>::Err("Native scale application unexpectedly contains Go metadata")
	end
	go_metadata := try append_inventory_command(inventory, "Go scale application metadata", go_command, ["version", "-m", go_scale_application])
	if go_metadata.status != 0
		return Result<Boolean, String>::Err("optimized Go scale application metadata probe failed")
	end
	assembly_probe := workspace + "/inventory-cc-probe.s"
	try write_required(assembly_probe, "")
	try append_inventory_command(
		inventory,
		"CC assembler and linker expansion",
		cc,
		["-###", "-xassembler", assembly_probe, "-Wl,-dead_strip", "-o", workspace + "/inventory-cc-output"],
	)
	try require_no_intermediates(workspace)
	return write_required(inventory_path, inventory.to_s())
end

def record_chain_hashes(
		mut output: StringBuilder,
		candidate: String,
		chain: CompilerChain,
	): Result<Boolean, String>
	if !chain.transition.empty?()
		try record_hash(output, "compiler-sha256", "compiler-source", candidate + "-transition", chain.transition)
	end
	try record_hash(output, "compiler-sha256", "compiler-source", candidate + "-b2", chain.b2)
	try record_hash(output, "compiler-sha256", "compiler-source", candidate + "-b3", chain.b3)
	try record_hash(output, "compiler-sha256", "compiler-source", candidate + "-b4", chain.b4)
	try record_hash(output, "emitted-qbe-sha256", "compiler-source", candidate, chain.fixed_qbe_path)
	return Result<Boolean, String>::Ok(true)
end

def write_configured_manifest(root: String, output_path: String): Result<Boolean, String>
	relative := [
		"go.mod",
		"src/application.trb",
		"src/ignored_test.trb",
		"src/lib/value.trb",
		"src/lib/value/index.trb",
		"src/unrelated.trb",
		"trbconfig.jsonc",
	]
	mut manifest := string_builder.new()
	mut index := 0
	while index < relative.size()
		manifest.append((try sha256(root + "/" + relative[index])) + "  ./" + relative[index] + "\n")
		index += 1
	end
	try write_required(output_path, manifest.to_s())
	return Result<Boolean, String>::Ok(true)
end

def build_regression_application(
		compiler: String,
		source: String,
		output_path: String,
		qbe: String,
		cc: String,
		expected_stdout: String,
		expected_hash: String,
		label: String,
	): Result<Boolean, String>
	try build_checked(compiler, source, output_path, qbe, cc, label)
	measurement := try measure_process(output_path, [])
	if measurement.status != 0 || measurement.stdout != expected_stdout || !measurement.stderr.empty?()
		return Result<Boolean, String>::Err(label + " runtime differs")
	end
	try require_hash(output_path, expected_hash, label)
	return Result<Boolean, String>::Ok(true)
end

def execute_benchmark(
		candidate_root: String,
		baseline_root: String,
		seed: String,
		seed_provenance: String,
		benchmark: String,
		reference_trb: String,
		qbe: String,
		cc: String,
		go_command: String,
		workspace: String,
		raw_path: String,
		inventory_path: String,
	): Result<Boolean, String>
	try create_required_directory(workspace)
	baseline_sources := try read_compiler_sources(baseline_root)
	candidate_sources := try read_compiler_sources(candidate_root)
	baseline_revision := try measure_process("/usr/bin/git", ["-C", baseline_root, "rev-parse", "HEAD"])
	if baseline_revision.status != 0 || baseline_revision.stdout.strip() != "e9b00ed946919957fad82b6d2d3ffccfe8cd48d1"
		return Result<Boolean, String>::Err("baseline root is not the registered Gate 6J revision")
	end
	candidate_revision := try measure_process("/usr/bin/git", ["-C", candidate_root, "rev-parse", "HEAD"])
	if candidate_revision.status != 0 || candidate_revision.stdout.strip() != "84e2e4a6e2cff9d7fdab46ce4eec33b609a597c4"
		return Result<Boolean, String>::Err("candidate root is not the registered Gate 6K implementation revision")
	end
	try require_hash(seed, "caf3d213559382376bb87b1555e832c0efd7321c0a930ffa23e88d5bc1e55c77", "Gate 6J retained B4 seed")
	try require_hash(baseline_sources.entry_path, "9a90b1ca0a3fd77e2215fb744f288c5d006e08a56be81b6be6124c795a013a81", "baseline compiler entry")
	try require_hash(candidate_sources.entry_path, "536dde374815c7c01796be00d445b97591afdadd8cda1a3ca1a6dd4e80a3cdb6", "candidate compiler entry")
	try require_hash(baseline_sources.storage_path, "d4c77fec9e5c5e8580cb0b5ee71fbd2c9c714555cbd4fd1457fcd44cc6db1f9d", "baseline storage source")
	try require_hash(candidate_sources.storage_path, "d4c77fec9e5c5e8580cb0b5ee71fbd2c9c714555cbd4fd1457fcd44cc6db1f9d", "candidate storage source")
	try require_hash(baseline_sources.path_path, "6347003851071b73cb8dbf38622fcc7cf3be6abf81ea253b9aad081fb057510a", "baseline path source")
	try require_hash(candidate_sources.path_path, "6347003851071b73cb8dbf38622fcc7cf3be6abf81ea253b9aad081fb057510a", "candidate path source")
	baseline_chain := try build_compiler_chain(seed, baseline_sources, qbe, cc, workspace + "/baseline-chain", "baseline")
	candidate_chain := try build_transition_compiler_chain(seed, candidate_sources, qbe, cc, workspace + "/candidate-chain", "candidate")
	try require_hash(baseline_chain.b4, "caf3d213559382376bb87b1555e832c0efd7321c0a930ffa23e88d5bc1e55c77", "baseline B4 compiler")
	try require_hash(candidate_chain.b4, "f57975e61e80e9535d60adf41bfa68f0e4f68bc2b1be2bc47a6b7d557340fa56", "candidate B4 compiler")
	try require_hash(baseline_chain.fixed_qbe_path, "95aba97d9aa07b8eac651336648b7fe53d33e88fa4411edf3f4dad76f8aea4ee", "baseline fixed-point QBE")
	try require_hash(candidate_chain.fixed_qbe_path, "62db3c31527a670c3050051a9fa27bf142b6c5deaab81ef8234104bd467aa95a", "candidate fixed-point QBE")

	small_project := candidate_root + "/corpus/gate6k/configured-project"
	small_config := small_project + "/trbconfig.jsonc"
	small_manifest := workspace + "/configured-project.manifest"
	try write_configured_manifest(small_project, small_manifest)
	try require_hash(small_manifest, "03b741487a4eb338c44cfae1ad2f4d67f88015bca9c2fb24c447530f157cf284", "configured-project manifest")
	try require_hash(small_config, "4ac3c76411dc5ed9a8786b267d734d6744301d56dd4617ba1c4799f419444806", "configured-project config")

	scale_project := workspace + "/scale-project"
	scale_manifest := workspace + "/scale-project.manifest"
	scale_entry := try prepare_scale_project(candidate_root, scale_project, 1024, scale_manifest)
	scale_config := scale_project + "/trbconfig.jsonc"
	try require_hash(scale_manifest, "db438159189ba944283d8a92a09a1176020522c67d2551065c4010c50858f16b", "scale-project manifest")
	try require_hash(scale_config, "4ac3c76411dc5ed9a8786b267d734d6744301d56dd4617ba1c4799f419444806", "scale-project config")
	file_root_scale_qbe := try emitted_qbe(candidate_chain.b4, scale_entry, "file-root scale")
	configured_scale_qbe := try emitted_qbe(candidate_chain.b4, scale_config, "configured scale")
	if file_root_scale_qbe != configured_scale_qbe
		return Result<Boolean, String>::Err("configured scale QBE differs from file-root")
	end
	scale_qbe_path := workspace + "/scale-1024-modules.ssa"
	try write_required(scale_qbe_path, file_root_scale_qbe)
	try require_hash(scale_qbe_path, "39f61f19bcd404732848604b568f4a5db3d70990ea233aaf8e337296d5d88874", "scale QBE")
	application_project := workspace + "/file-root-project"
	try prepare_application(candidate_root, application_project)
	application_directories := [workspace + "/application-baseline", workspace + "/application-candidate", workspace + "/application-repeat"]
	mut index := 0
	while index < application_directories.size()
		try create_required_directory(application_directories[index])
		index += 1
	end
	application_outputs := [
		application_directories[0] + "/program",
		application_directories[1] + "/program",
		application_directories[2] + "/program",
	]
	try build_checked(baseline_chain.b4, application_project + "/main.trb", application_outputs[0], qbe, cc, "baseline application")
	try build_checked(candidate_chain.b4, application_project + "/main.trb", application_outputs[1], qbe, cc, "candidate application")
	try build_checked(candidate_chain.b4, application_project + "/main.trb", application_outputs[2], qbe, cc, "repeated candidate application")
	index = 0
	while index < application_outputs.size()
		try verify_application(application_outputs[index], "application " + index.to_s())
		try require_hash(application_outputs[index], "413d97fd8a3f26e1086795b1fd5306ad5817613e7080ddba410eb8264c0a67b9", "application " + index.to_s())
		if index > 0
			try require_file_equal(application_outputs[0], application_outputs[index], "application bytes differ")
		end
		index += 1
	end
	regression_directory := workspace + "/registered-regressions"
	try create_required_directory(regression_directory)
	try create_required_directory(regression_directory + "/gate6i")
	try create_required_directory(regression_directory + "/gate6j")
	try build_regression_application(
		candidate_chain.b4,
		candidate_root + "/corpus/gate6i/float-kernel/src/main.trb",
		regression_directory + "/gate6i/program",
		qbe,
		cc,
		"float-kernel-ok\n",
		"a24b8bf40013e75cabb9d1b508c594388a8cecd73f68b0f3f2add9afc5a4bede",
		"Gate 6I scalar Float application",
	)
	try build_regression_application(
		candidate_chain.b4,
		candidate_root + "/corpus/gate6j/float-array/src/main.trb",
		regression_directory + "/gate6j/program",
		qbe,
		cc,
		"float-array-ok\n",
		"53ca1dbdb87a373ff177796a4ff358d5acf8f5163f1dfc4df73b72f41dac8e6d",
		"Gate 6J Float Array application",
	)

	small_directories := [
		workspace + "/small-configured-native",
		workspace + "/small-configured-repeat",
		workspace + "/small-configured-go",
	]
	index = 0
	while index < small_directories.size()
		try create_required_directory(small_directories[index])
		index += 1
	end
	small_outputs := [
		small_directories[0] + "/program",
		small_directories[1] + "/program",
		small_directories[2] + "/program",
	]
	small_qbe := try emitted_qbe(candidate_chain.b4, small_config, "configured small")
	small_qbe_path := workspace + "/configured-project.ssa"
	try write_required(small_qbe_path, small_qbe)
	try build_checked(candidate_chain.b4, small_config, small_outputs[0], qbe, cc, "configured small application")
	try build_checked(candidate_chain.b4, small_config, small_outputs[1], qbe, cc, "repeated configured small application")
	small_go_build := try measure_process(reference_trb, go_build_arguments(small_config, small_outputs[2]))
	if small_go_build.status != 0 || !small_go_build.stderr.empty?()
		return Result<Boolean, String>::Err("optimized Go configured small application failed: " + small_go_build.stderr)
	end
	index = 0
	while index < small_outputs.size()
		try verify_configured_application(small_outputs[index], "configured small application " + index.to_s())
		if index == 1
			try require_file_equal(small_outputs[0], small_outputs[1], "configured small Native bytes differ")
		end
		index += 1
	end
	try require_hash(small_qbe_path, "ccae60d4c24176880935c8f3d9afb96f7d4e4787aa0033c25a080c54ebf5f774", "configured small QBE")
	try require_hash(small_outputs[0], "33a39ea940ad189cead3f05f2af9af66d1b0abbffcb086cfa51a6b5e54cbc562", "configured small Native application")

	scale_application_directories := [
		workspace + "/scale-application-file-root",
		workspace + "/scale-application-configured",
		workspace + "/scale-application-configured-repeat",
		workspace + "/scale-application-configured-go",
	]
	index = 0
	while index < scale_application_directories.size()
		try create_required_directory(scale_application_directories[index])
		index += 1
	end
	scale_application_outputs := [
		scale_application_directories[0] + "/program",
		scale_application_directories[1] + "/program",
		scale_application_directories[2] + "/program",
		scale_application_directories[3] + "/program",
	]
	try build_checked(candidate_chain.b4, scale_entry, scale_application_outputs[0], qbe, cc, "file-root scale application")
	try build_checked(candidate_chain.b4, scale_config, scale_application_outputs[1], qbe, cc, "configured scale application")
	try build_checked(candidate_chain.b4, scale_config, scale_application_outputs[2], qbe, cc, "repeated configured scale application")
	go_build := try measure_process(reference_trb, go_build_arguments(scale_config, scale_application_outputs[3]))
	if go_build.status != 0 || !go_build.stderr.empty?()
		return Result<Boolean, String>::Err("canonical optimized Go scale application failed: " + go_build.stderr)
	end
	try require_file(scale_application_outputs[3])
	index = 0
	while index < scale_application_outputs.size()
		try verify_scale_application(scale_application_outputs[index], "scale application " + index.to_s())
		if index > 0 && index < 3
			try require_file_equal(
				scale_application_outputs[0],
				scale_application_outputs[index],
				"Native scale application bytes differ",
			)
		end
		index += 1
	end
	try run_configured_project_probes(
		candidate_root,
		candidate_chain.b4,
		qbe,
		cc,
		workspace + "/configured-project-probes",
	)
	measured_directories := [
		workspace + "/measured-baseline",
		workspace + "/measured-candidate",
		workspace + "/scale-measured-baseline",
		workspace + "/scale-measured-candidate",
		workspace + "/scale-compare-native",
		workspace + "/scale-compare-go",
	]
	index = 0
	while index < measured_directories.size()
		try create_required_directory(measured_directories[index])
		index += 1
	end
	compilers := [baseline_chain.b4, candidate_chain.b4]
	compiler_sources := [baseline_sources.entry_path, candidate_sources.entry_path]
	compiler_qbe := [baseline_chain.fixed_qbe, candidate_chain.fixed_qbe]
	measured_outputs := [measured_directories[0] + "/compiler", measured_directories[1] + "/compiler"]
	expected_outputs := [baseline_chain.b4, candidate_chain.b4]
	scale_measured_outputs := [measured_directories[2] + "/program", measured_directories[3] + "/program"]
	scale_compare_outputs := [measured_directories[4] + "/program", measured_directories[5] + "/program"]
	mut output := string_builder.new()
	output.append("metric,case,candidate,iteration,value,status\n")

	canonical_labels := ["gate6j-baseline", "gate6k-candidate"]
	canonical_emit_times := try measure_emit_time_series(
		output,
		compilers,
		compiler_sources,
		compiler_qbe,
		"compiler-source",
		canonical_labels,
	)
	canonical_build_times := try measure_build_time_series(output, compilers, compiler_sources, measured_outputs, expected_outputs, qbe, cc)
	native_input_checks := [
		CheckRun.new(
			command: candidate_chain.b4,
			arguments: ["check", scale_entry],
			label: "file-root-native",
			expected_stdout: "ok\n",
		),
		CheckRun.new(
			command: candidate_chain.b4,
			arguments: ["check", scale_config],
			label: "configured-native",
			expected_stdout: "ok\n",
		),
	]
	configured_go_checks := [
		CheckRun.new(
			command: candidate_chain.b4,
			arguments: ["check", scale_config],
			label: "configured-native",
			expected_stdout: "ok\n",
		),
		CheckRun.new(
			command: reference_trb,
			arguments: ["check", "--config", scale_config],
			label: "configured-go",
			expected_stdout: "checked 1025 file(s) for mode go\n",
		),
	]
	native_input_check_times := try measure_check_time_series(output, native_input_checks, "scale-native-input")
	configured_go_check_times := try measure_check_time_series(output, configured_go_checks, "scale-configured-check")
	scale_sources := [scale_entry, scale_config]
	scale_qbe := [file_root_scale_qbe, file_root_scale_qbe]
	scale_emit_times := try measure_emit_time_series(
		output,
		[candidate_chain.b4, candidate_chain.b4],
		scale_sources,
		scale_qbe,
		"scale-native-input",
		["file-root-native", "configured-native"],
	)
	scale_native_builds := [
		ScaleBuild.new(
			command: candidate_chain.b4,
			arguments: build_arguments(scale_entry, scale_measured_outputs[0], qbe, cc),
			output_path: scale_measured_outputs[0],
			expected_path: scale_application_outputs[0],
			label: "file-root-native",
			case_name: "scale-native-input",
		),
		ScaleBuild.new(
			command: candidate_chain.b4,
			arguments: build_arguments(scale_config, scale_measured_outputs[1], qbe, cc),
			output_path: scale_measured_outputs[1],
			expected_path: scale_application_outputs[1],
			label: "configured-native",
			case_name: "scale-native-input",
		),
	]
	scale_native_build_times := try measure_scale_build_time_series(
		output,
		scale_native_builds,
	)
	scale_compare_builds := [
		ScaleBuild.new(
			command: candidate_chain.b4,
			arguments: build_arguments(scale_config, scale_compare_outputs[0], qbe, cc),
			output_path: scale_compare_outputs[0],
			expected_path: scale_application_outputs[1],
			label: "configured-native",
			case_name: "scale-configured-build",
		),
		ScaleBuild.new(
			command: reference_trb,
			arguments: go_build_arguments(scale_config, scale_compare_outputs[1]),
			output_path: scale_compare_outputs[1],
			expected_path: "",
			label: "configured-go",
			case_name: "scale-configured-build",
		),
	]
	scale_go_build_times := try measure_scale_build_time_series(
		output,
		scale_compare_builds,
	)

	canonical_emit_rss := try measure_emit_rss_series(
		output,
		compilers,
		compiler_sources,
		compiler_qbe,
		"compiler-source",
		canonical_labels,
	)
	canonical_build_rss := try measure_build_rss_series(output, compilers, compiler_sources, measured_outputs, expected_outputs, qbe, cc)
	native_input_check_rss := try measure_check_rss_series(output, native_input_checks, "scale-native-input")
	configured_go_check_rss_values := try measure_check_rss_series(output, configured_go_checks, "scale-configured-check")
	scale_emit_rss := try measure_emit_rss_series(
		output,
		[candidate_chain.b4, candidate_chain.b4],
		scale_sources,
		scale_qbe,
		"scale-native-input",
		["file-root-native", "configured-native"],
	)
	scale_native_build_rss := try measure_scale_build_rss_series(
		output,
		scale_native_builds,
	)
	scale_go_build_rss := try measure_scale_build_rss_series(
		output,
		scale_compare_builds,
	)
	runtime_times := try measure_runtime_time_series(output, [scale_application_outputs[1], scale_application_outputs[3]])
	runtime_rss := try measure_runtime_rss_series(output, [scale_application_outputs[1], scale_application_outputs[3]])

	baseline_canonical_emit_median := gate6k_median_float(canonical_emit_times[0])
	candidate_canonical_emit_median := gate6k_median_float(canonical_emit_times[1])
	baseline_canonical_build_median := gate6k_median_float(canonical_build_times[0])
	candidate_canonical_build_median := gate6k_median_float(canonical_build_times[1])
	file_root_check_median := gate6k_median_float(native_input_check_times[0])
	configured_native_check_median := gate6k_median_float(native_input_check_times[1])
	configured_native_go_check_median := gate6k_median_float(configured_go_check_times[0])
	configured_go_check_median := gate6k_median_float(configured_go_check_times[1])
	file_root_emit_median := gate6k_median_float(scale_emit_times[0])
	configured_emit_median := gate6k_median_float(scale_emit_times[1])
	file_root_build_median := gate6k_median_float(scale_native_build_times[0])
	configured_native_build_median := gate6k_median_float(scale_native_build_times[1])
	configured_native_go_build_median := gate6k_median_float(scale_go_build_times[0])
	configured_go_build_median := gate6k_median_float(scale_go_build_times[1])
	configured_native_runtime_median := gate6k_median_float(runtime_times[0])
	configured_go_runtime_median := gate6k_median_float(runtime_times[1])
	baseline_canonical_emit_rss := gate6k_median_integer(canonical_emit_rss[0])
	candidate_canonical_emit_rss := gate6k_median_integer(canonical_emit_rss[1])
	baseline_canonical_build_rss := gate6k_median_integer(canonical_build_rss[0])
	candidate_canonical_build_rss := gate6k_median_integer(canonical_build_rss[1])
	file_root_check_rss := gate6k_median_integer(native_input_check_rss[0])
	configured_native_check_rss := gate6k_median_integer(native_input_check_rss[1])
	configured_native_go_check_rss := gate6k_median_integer(configured_go_check_rss_values[0])
	configured_go_check_rss := gate6k_median_integer(configured_go_check_rss_values[1])
	file_root_emit_rss := gate6k_median_integer(scale_emit_rss[0])
	configured_emit_rss := gate6k_median_integer(scale_emit_rss[1])
	file_root_build_rss := gate6k_median_integer(scale_native_build_rss[0])
	configured_native_build_rss := gate6k_median_integer(scale_native_build_rss[1])
	configured_native_go_build_rss := gate6k_median_integer(scale_go_build_rss[0])
	configured_go_build_rss := gate6k_median_integer(scale_go_build_rss[1])
	configured_native_runtime_rss := gate6k_median_integer(runtime_rss[0])
	configured_go_runtime_rss := gate6k_median_integer(runtime_rss[1])

	append_measurement(output, "median", "compiler-emit-qbe-total", "baseline", 0, baseline_canonical_emit_median.to_s(), 0)
	append_measurement(output, "median", "compiler-emit-qbe-total", "candidate", 0, candidate_canonical_emit_median.to_s(), 0)
	append_measurement(output, "median", "compiler-build-total", "baseline", 0, baseline_canonical_build_median.to_s(), 0)
	append_measurement(output, "median", "compiler-build-total", "candidate", 0, candidate_canonical_build_median.to_s(), 0)
	append_measurement(output, "median", "scale-check-total", "file-root-native", 0, file_root_check_median.to_s(), 0)
	append_measurement(output, "median", "scale-check-total", "configured-native", 0, configured_native_check_median.to_s(), 0)
	append_measurement(output, "median", "scale-configured-check-total", "configured-native", 0, configured_native_go_check_median.to_s(), 0)
	append_measurement(output, "median", "scale-configured-check-total", "configured-go", 0, configured_go_check_median.to_s(), 0)
	append_measurement(output, "median", "scale-emit-qbe-total", "file-root-native", 0, file_root_emit_median.to_s(), 0)
	append_measurement(output, "median", "scale-emit-qbe-total", "configured-native", 0, configured_emit_median.to_s(), 0)
	append_measurement(output, "median", "scale-native-build-total", "file-root-native", 0, file_root_build_median.to_s(), 0)
	append_measurement(output, "median", "scale-native-build-total", "configured-native", 0, configured_native_build_median.to_s(), 0)
	append_measurement(output, "median", "scale-configured-build-total", "configured-native", 0, configured_native_go_build_median.to_s(), 0)
	append_measurement(output, "median", "scale-configured-build-total", "configured-go", 0, configured_go_build_median.to_s(), 0)
	append_measurement(output, "median", "application-runtime-total", "configured-native", 0, configured_native_runtime_median.to_s(), 0)
	append_measurement(output, "median", "application-runtime-total", "configured-go", 0, configured_go_runtime_median.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-emit-qbe", "baseline", 0, baseline_canonical_emit_rss.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-emit-qbe", "candidate", 0, candidate_canonical_emit_rss.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-build", "baseline", 0, baseline_canonical_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "compiler-build", "candidate", 0, candidate_canonical_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-check", "file-root-native", 0, file_root_check_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-check", "configured-native", 0, configured_native_check_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-configured-check", "configured-native", 0, configured_native_go_check_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-configured-check", "configured-go", 0, configured_go_check_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-emit-qbe", "file-root-native", 0, file_root_emit_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-emit-qbe", "configured-native", 0, configured_emit_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-native-build", "file-root-native", 0, file_root_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-native-build", "configured-native", 0, configured_native_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-configured-build", "configured-native", 0, configured_native_go_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "scale-configured-build", "configured-go", 0, configured_go_build_rss.to_s(), 0)
	append_measurement(output, "median-rss", "application-runtime", "configured-native", 0, configured_native_runtime_rss.to_s(), 0)
	append_measurement(output, "median-rss", "application-runtime", "configured-go", 0, configured_go_runtime_rss.to_s(), 0)
	append_measurement(output, "native-input-limit-percent", "scale-check-emit-build", "configured-over-file-root", 0, "115", 0)
	append_measurement(output, "go-parity-limit-percent", "scale-configured-check-build-runtime", "native-over-go", 0, "125", 0)
	append_measurement(output, "canonical-regression-limit-percent", "compiler-source", "gate6k-over-gate6j", 0, "115", 0)
	append_measurement(output, "compiler-size-absolute-limit", "compiler-source", "candidate", 0, "248000", 0)

	baseline_stripped := try strip_and_record(output, "baseline-b4", baseline_chain.b4, workspace + "/baseline-chain/stripped")
	candidate_stripped := try strip_and_record(output, "candidate-b4", candidate_chain.b4, workspace + "/candidate-chain/stripped")
	native_scale_size := try strip_application_and_record(
		output,
		"configured-native",
		scale_application_outputs[1],
		scale_application_directories[1] + "/stripped",
	)
	go_scale_size := try strip_application_and_record(
		output,
		"configured-go",
		scale_application_outputs[3],
		scale_application_directories[3] + "/stripped",
	)
	try record_hash(output, "seed-sha256", "compiler-seed", "gate6j-b4", seed)
	try record_hash(output, "compiler-source-sha256", "source", "baseline-entry", baseline_sources.entry_path)
	try record_hash(output, "compiler-source-sha256", "source", "candidate-entry", candidate_sources.entry_path)
	try record_hash(output, "configured-source-manifest-sha256", "source", "small", small_manifest)
	try record_hash(output, "configured-qbe-sha256", "qbe", "small", small_qbe_path)
	try record_hash(output, "scale-source-manifest-sha256", "source", "1024-modules", scale_manifest)
	try record_hash(output, "scale-entry-sha256", "source", "1024-modules", scale_entry)
	try record_hash(output, "scale-qbe-sha256", "qbe", "both", scale_qbe_path)
	try record_chain_hashes(output, "baseline", baseline_chain)
	try record_chain_hashes(output, "candidate", candidate_chain)
	try record_hash(output, "application-sha256", "file-root", "candidate", application_outputs[1])
	try record_hash(output, "application-sha256", "configured-small", "native", small_outputs[0])
	try record_hash(output, "application-sha256", "configured-small", "go", small_outputs[2])
	try record_hash(output, "application-sha256", "scale-1024-modules", "configured-native", scale_application_outputs[1])
	try record_hash(output, "application-sha256", "scale-1024-modules", "configured-go", scale_application_outputs[3])
	append_measurement(output, "compiler-size-stripped-baseline", "compiler-source", "gate6j", 0, baseline_stripped.to_s(), 0)
	append_measurement(output, "compiler-size-stripped-candidate", "compiler-source", "gate6k", 0, candidate_stripped.to_s(), 0)
	try require_no_intermediates(workspace)
	try write_required(raw_path, output.to_s())
	try record_inventory(
		inventory_path,
		candidate_root,
		baseline_root,
		seed,
		seed_provenance,
		benchmark,
		reference_trb,
		qbe,
		cc,
		go_command,
		workspace,
		baseline_sources,
		candidate_sources,
		baseline_chain,
		candidate_chain,
		small_config,
		small_manifest,
		scale_entry,
		scale_config,
		scale_manifest,
		scale_qbe_path,
		small_outputs[0],
		scale_application_outputs[1],
		scale_application_outputs[3],
	)

	if !gate6k_candidate_within_percent(file_root_check_median, configured_native_check_median, 115.0)
		return Result<Boolean, String>::Err("configured Native check exceeds the file-root 15% bound")
	end
	if !gate6k_candidate_within_percent(file_root_emit_median, configured_emit_median, 115.0)
		return Result<Boolean, String>::Err("configured Native emit-qbe exceeds the file-root 15% bound")
	end
	if !gate6k_candidate_within_percent(file_root_build_median, configured_native_build_median, 115.0)
		return Result<Boolean, String>::Err("configured Native build exceeds the file-root 15% bound")
	end
	if configured_native_check_rss * 100 > file_root_check_rss * 115
		return Result<Boolean, String>::Err("configured Native check RSS exceeds the file-root 15% bound")
	end
	if configured_emit_rss * 100 > file_root_emit_rss * 115
		return Result<Boolean, String>::Err("configured Native emit-qbe RSS exceeds the file-root 15% bound")
	end
	if configured_native_build_rss * 100 > file_root_build_rss * 115
		return Result<Boolean, String>::Err("configured Native build RSS exceeds the file-root 15% bound")
	end
	if !gate6k_candidate_within_percent(configured_go_check_median, configured_native_go_check_median, 125.0)
		return Result<Boolean, String>::Err("configured Native check exceeds the optimized Go 25% bound")
	end
	if configured_native_go_check_rss * 100 > configured_go_check_rss * 125
		return Result<Boolean, String>::Err("configured Native check RSS exceeds the optimized Go 25% bound")
	end
	if !gate6k_candidate_within_percent(configured_go_build_median, configured_native_go_build_median, 125.0)
		return Result<Boolean, String>::Err("configured Native build exceeds the optimized Go 25% bound")
	end
	if configured_native_go_build_rss * 100 > configured_go_build_rss * 125
		return Result<Boolean, String>::Err("configured Native build RSS exceeds the optimized Go 25% bound")
	end
	if !gate6k_candidate_within_percent(configured_go_runtime_median, configured_native_runtime_median, 125.0)
		return Result<Boolean, String>::Err("configured Native runtime exceeds the optimized Go 25% bound")
	end
	if configured_native_runtime_rss * 100 > configured_go_runtime_rss * 125
		return Result<Boolean, String>::Err("configured Native runtime RSS exceeds the optimized Go 25% bound")
	end
	if !gate6k_candidate_within_percent(baseline_canonical_emit_median, candidate_canonical_emit_median, 115.0)
		return Result<Boolean, String>::Err("candidate canonical emit-qbe exceeds the Gate 6J 15% bound")
	end
	if !gate6k_candidate_within_percent(baseline_canonical_build_median, candidate_canonical_build_median, 115.0)
		return Result<Boolean, String>::Err("candidate canonical build exceeds the Gate 6J 15% bound")
	end
	if candidate_canonical_emit_rss * 100 > baseline_canonical_emit_rss * 115
		return Result<Boolean, String>::Err("candidate canonical emit-qbe RSS exceeds the Gate 6J 15% bound")
	end
	if candidate_canonical_build_rss * 100 > baseline_canonical_build_rss * 115
		return Result<Boolean, String>::Err("candidate canonical build RSS exceeds the Gate 6J 15% bound")
	end
	if native_scale_size * 5 > go_scale_size
		return Result<Boolean, String>::Err("Native scale application is not at least 80% smaller than optimized Go")
	end
	if candidate_stripped > 248000
		return Result<Boolean, String>::Err("candidate stripped compiler exceeds the registered size bound")
	end
	return Result<Boolean, String>::Ok(true)
end

def main()
	arguments := argv()
	if arguments.size() != 12
		puts(
			"usage: gate6k-benchmark CANDIDATE_ROOT BASELINE_ROOT SEED SEED_PROVENANCE BENCHMARK REFERENCE_TRB QBE CC GO WORKSPACE RAW_CSV INVENTORY",
		)
		return
	end
	case execute_benchmark(
			arguments[0],
			arguments[1],
			arguments[2],
			arguments[3],
			arguments[4],
			arguments[5],
			arguments[6],
			arguments[7],
			arguments[8],
			arguments[9],
			arguments[10],
			arguments[11],
		)
	when Result::Ok(_value)
		puts(arguments[10])
		puts(arguments[11])
	when Result::Err(error)
		puts(error)
	end
end
