	mut iteration :=- 2
	while iteration < 11
		mut order := 0
		while order < 2
			mut candidate := order
			if iteration % 2 != 0
				candidate = 1 - order
			end
			build := builds[candidate]
			value := try measure_scale_build_time(
				output,
