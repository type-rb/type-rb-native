def measure_scale_build_time(
		mut output: StringBuilder,
		command: String,
		arguments: Array<String>,
		output_path: String,
		expected_path: String,
		candidate: String,
		case_name: String,
		iteration: Integer,
	): Result<Float, String>
	measurement := try measure_process(command, arguments)
	append_measurement(
		output,
		"application-build-total",
		case_name,
		candidate,
		iteration,
		measurement.seconds.to_s(),
		measurement.status,
	)
	if measurement.status != 0 || !measurement.stderr.empty?()
		return Result<Float, String>::Err(candidate + " scale-project build failed: " + measurement.stderr)
	end
	try require_file(output_path)
	if !expected_path.empty?()
		try require_file_equal(output_path, expected_path, candidate + " scale-project bytes differ")
	end
	try verify_scale_application(output_path, candidate + " measured scale project")
	return Result<Float, String>::Ok(measurement.seconds)
end

