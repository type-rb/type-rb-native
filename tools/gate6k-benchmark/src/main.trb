def measure_runtime_time_series(
		mut output: StringBuilder,
		executables: Array<String>,
	): Result<Array<Array<Float>>, String>
	mut native_values: Array<Float> := []
	mut go_values: Array<Float> := []
	mut iteration :=- 3
	while iteration < 31
		mut order := 0
		while order < 2
			mut candidate := order
			if iteration % 2 != 0
				candidate = 1 - order
			end
			mut label := "configured-native"
			if candidate == 1
				label = "configured-go"
			end
			value := try measure_runtime_time(output, executables[candidate], label, iteration)
			if iteration >= 0
				if candidate == 0
					native_values.push(value)
				else
					go_values.push(value)
				end
			end
			order += 1
		end
		iteration += 1
	end
	return Result<Array<Array<Float>>, String>::Ok([native_values, go_values])
end

