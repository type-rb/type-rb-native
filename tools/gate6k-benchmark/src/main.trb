def measure_runtime_time(
		mut output: StringBuilder,
		executable: String,
		candidate: String,
		iteration: Integer,
	): Result<Float, String>
	measurement := try measure_process(executable, [])
	append_measurement(
		output,
		"application-runtime-total",
		"scale-1024-modules",
		candidate,
		iteration,
		measurement.seconds.to_s(),
		measurement.status,
	)
	if measurement.status != 0 || measurement.stdout != "module-scale-ok\n" || !measurement.stderr.empty?()
		return Result<Float, String>::Err(candidate + " scale-project runtime differs")
	end
	return Result<Float, String>::Ok(measurement.seconds)
end

