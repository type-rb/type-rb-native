import {
	gate6h_candidate_within_percent,
	gate6h_entry_source,
	gate6h_fixed_width_index,
	gate6h_median_float,
	gate6h_median_integer,
	gate6h_module_source,
} from main
import { Result } from trb/std/result
import { describe, expect, test } from trb/std/test

describe("Gate 6H benchmark policy") do
	test("uses fixed-width module and function names") do
		case gate6h_fixed_width_index(7)
		when Result::Ok(value)
			expect(value).to_equal("0007")
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
		case gate6h_fixed_width_index(1023)
		when Result::Ok(value)
			expect(value).to_equal("1023")
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
	end

	test("generates the exact predecessor module shape") do
		case gate6h_module_source(0)
		when Result::Ok(source)
			expect(source).to_equal("def f0000(): Integer\n\treturn 1\nend\n")
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
		case gate6h_module_source(7)
		when Result::Ok(source)
			expect(source).to_equal(
				"import { f0006 } from m0006\n\ndef f0007(): Integer\n\treturn f0006() + 1\nend\n",
			)
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
	end

	test("generates an entry that observes the complete chain") do
		case gate6h_entry_source(3)
		when Result::Ok(source)
			expect(source).to_equal(
				"import { f0002 } from m0002\n\ndef main()\n\tif f0002() == 3\n\t\tputs(\"module-scale-ok\")\n\telse\n\t\tputs(\"module-scale-bad\")\n\tend\n\treturn\nend\n",
			)
		when Result::Err(error)
			puts(error)
			expect(false).to_be_true()
		end
	end

	test("rejects names and projects outside the registered shape") do
		case gate6h_fixed_width_index(- 1)
		when Result::Ok(_value)
			expect(false).to_be_true()
		when Result::Err(error)
			expect(error).to_equal("module index must be between 0 and 9999")
		end
		case gate6h_entry_source(1)
		when Result::Ok(_source)
			expect(false).to_be_true()
		when Result::Err(error)
			expect(error).to_equal("module count must be at least 2")
		end
	end

	test("computes registered odd medians without mutating input") do
		floats := [5.0, 1.0, 4.0, 2.0, 3.0]
		integers := [50, 10, 40, 20, 30]
		expect(gate6h_median_float(floats)).to_equal(3.0)
		expect(gate6h_median_integer(integers)).to_equal(30)
		expect(floats[0]).to_equal(5.0)
		expect(integers[0]).to_equal(50)
	end

	test("enforces percentage bounds at their exact boundary") do
		expect(gate6h_candidate_within_percent(100.0, 65.0, 65.0)).to_be_true()
		expect(gate6h_candidate_within_percent(100.0, 65.001, 65.0)).to_be_false()
		expect(gate6h_candidate_within_percent(100.0, 125.0, 125.0)).to_be_true()
		expect(gate6h_candidate_within_percent(100.0, 125.001, 125.0)).to_be_false()
	end
end
