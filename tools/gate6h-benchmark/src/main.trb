def measure_scale_build_time(
		mut output: StringBuilder,
		command: String,
		arguments: Array<String>,
		output_path: String,
		expected_path: String,
		candidate: String,
		iteration: Integer,
	): Result<Float, String>
	measurement := try measure_process(command, arguments)
	append_measurement(
		output,
		"application-build-total",
		"scale-1024-modules",
		candidate,
		iteration,
		measurement.seconds.to_s(),
		measurement.status,
	)
	if measurement.status != 0 || !measurement.stderr.empty?()
		return Result<Float, String>::Err(candidate + " scale-project build failed: " + measurement.stderr)
	end
	try require_file(output_path)
	if !expected_path.empty?()
		try require_file_equal(output_path, expected_path, candidate + " scale-project bytes differ")
	end
	try verify_scale_application(output_path, candidate + " measured scale project")
	return Result<Float, String>::Ok(measurement.seconds)
end

def measure_scale_build_rss(
		mut output: StringBuilder,
		command: String,
		arguments: Array<String>,
		output_path: String,
		expected_path: String,
		candidate: String,
		iteration: Integer,
	): Result<Integer, String>
	measurement := try peak_process(command, arguments)
	append_measurement(
		output,
		"application-build-peak-rss",
		"scale-1024-modules",
		candidate,
		iteration,
		measurement.rss.to_s(),
		measurement.status,
	)
	if measurement.status != 0
		return Result<Integer, String>::Err(candidate + " scale-project RSS build failed")
	end
	try require_file(output_path)
	if !expected_path.empty?()
		try require_file_equal(output_path, expected_path, candidate + " scale-project RSS bytes differ")
	end
	try verify_scale_application(output_path, candidate + " measured RSS scale project")
	return Result<Integer, String>::Ok(measurement.rss)
end

def measure_scale_build_time_series(
		mut output: StringBuilder,
		builds: Array<ScaleBuild>,
	): Result<Array<Array<Float>>, String>
	mut first_values: Array<Float> := []
	mut second_values: Array<Float> := []
	mut iteration :=- 2
	while iteration < 11
		mut order := 0
		while order < 2
			mut candidate := order
			if iteration % 2 != 0
				candidate = 1 - order
			end
			build := builds[candidate]
			value := try measure_scale_build_time(
				output,
				build.command,
				build.arguments,
				build.output_path,
				build.expected_path,
				build.label,
				iteration,
			)
			if iteration >= 0
				if candidate == 0
					first_values.push(value)
				else
					second_values.push(value)
				end
			end
			order += 1
		end
		iteration += 1
	end
	return Result<Array<Array<Float>>, String>::Ok([first_values, second_values])
end

