	%entries =l add %descriptor, 24
	%entry =l add %entries, %scaled
	%offset =l loadl %entry
	%field =l add %object, %offset
	%reference =l loadl %field
	call $g4_gc_mark(l %reference)
	%next =l add %index, 1
	jmp @loop
@finish
	ret
