function w $g4_run(l %program, l %args) {
@start
	%pid =w call $fork()
	%ff =w csltw %pid, 0
	jnz %ff, @fail, @child_check
@child_check
	%child =w ceqw %pid, 0
	jnz %child, @child, @parent
@child
	%ignored =w call $execv(l %program, l %args)
	call $exit(w 127)
	hlt
@parent
	%sp =l alloc8 8
	storew 0, %sp
	%waited =w call $waitpid(w %pid, l %sp, w 0)
	%wf =w csltw %waited, 0
	jnz %wf, @fail, @status
@status
	%st =w loadw %sp
	%sig =w and %st, 127
	%signaled =w cnew %sig, 0
	jnz %signaled, @signal, @exited
@signal
	%sr =w add %sig, 128
	ret %sr
@exited
	%shifted =w shr %st, 8
	%code =w and %shifted, 255
	ret %code
@fail
	ret 127
}

function w $g4_run_qbe(l %qbe, l %ssa, l %assembly) {
@start
