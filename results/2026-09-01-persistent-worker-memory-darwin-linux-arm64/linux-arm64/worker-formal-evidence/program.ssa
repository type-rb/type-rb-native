	jnz %empty, @minimum, @double
@minimum
	%minimum =l copy 64
	jmp @allocate
@double
	%doubled =l mul %capacity, 2
	jmp @allocate
@allocate
	%next_capacity =l phi @minimum %minimum, @double %doubled
	%bytes =l mul %next_capacity, 8
	%data =l loadl $g4_gc_temp_data
	%new_data =l call $realloc(l %data, l %bytes)
	%failed =w ceql %new_data, 0
	jnz %failed, @fail, @grown
@fail
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@grown
	storel %new_data, $g4_gc_temp_data
	storel %next_capacity, $g4_gc_temp_capacity
	jmp @store
@store
	%current_data =l loadl $g4_gc_temp_data
	%offset =l mul %count, 8
	%slot =l add %current_data, %offset
	storel %value, %slot
	%next_count =l add %count, 1
	storel %next_count, $g4_gc_temp_count
	ret
}

function $g4_gc_temp_reset(l %base) {
@start
	storel %base, $g4_gc_temp_count
	ret
}

function l $g4_gc_alloc(l %descriptor, l %payload_size, l %reserved_size) {
@start
