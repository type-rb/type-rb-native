	%base =l call $malloc(l %total)
	%failed =w ceql %base, 0
	jnz %failed, @fail, @initialize
@fail
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@initialize
	%head =l loadl $g4_gc_heap
	storel %head, %base
	%object =l add %base, 8
	storel %descriptor, %object
	%payload =l add %object, 8
	call $memset(l %payload, w 0, l %payload_size)
	%bytes =l loadl $g4_gc_heap_bytes
	%updated =l add %bytes, %total
	storel %updated, $g4_gc_heap_bytes
