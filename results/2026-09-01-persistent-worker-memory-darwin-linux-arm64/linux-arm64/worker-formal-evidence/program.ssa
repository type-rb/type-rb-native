	%a1 =l add %a, 8
	storel $g4_target_flag, %a1
	%a2 =l add %a, 16
	storel %target, %a2
	%a3 =l add %a, 24
	storel $g4_o_flag, %a3
	%a4 =l add %a, 32
	storel %assembly, %a4
	%a5 =l add %a, 40
	storel %ssa, %a5
	%a6 =l add %a, 48
	storel 0, %a6
	%r =w call $g4_run(l %qbe, l %a)
	ret %r
}

