function $g4_fail(l %message, l %size) {
@start
	call $write(w 2, l %message, l %size)
	call $exit(w 2)
	hlt
}

function l $g4_alloc(l %size) {
@start
	%pointer =l call $calloc(l 1, l %size)
	%failed =w ceql %pointer, 0
	jnz %failed, @fail, @ok
@fail
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@ok
	ret %pointer
}

function l $g4_string_alloc(l %size) {
@start
	%result =l call $g4_gc_alloc(l $g4_desc_string, l %size, l 0)
	ret %result
}

function l $g4_temp_alloc(l %size) {
@start
	%storage =l loadl $g4_temporary_storage
	%missing =w ceql %storage, 0
	jnz %missing, @initialize, @allocate
@initialize
	%allocated =l call $calloc(l 1, l 1048576)
	%failed =w ceql %allocated, 0
	jnz %failed, @allocation_failed, @initialized
@allocation_failed
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@initialized
	storel %allocated, $g4_temporary_storage
	jmp @allocate
@allocate
	%base =l loadl $g4_temporary_storage
	%used_address =l add $g4_temporary_storage, 8
	%used =l loadl %used_address
	%with_padding =l add %size, 7
	%aligned =l and %with_padding, -8
	%next =l add %used, %aligned
	%overflow =w csltl 1048576, %next
	jnz %overflow, @capacity_failed, @ready
@capacity_failed
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@ready
	%result =l add %base, %used
	storel %next, %used_address
	ret %result
}

function $g4_temp_reset() {
@start
	%used_address =l add $g4_temporary_storage, 8
	storel 0, %used_address
	ret
}

function l $g4_string_from_c(l %source) {
@start
	%length =l call $strlen(l %source)
	%size =l add %length, 9
	%string =l call $g4_string_alloc(l %size)
	%length_address =l add %string, 8
	storel %length, %length_address
	%data =l add %string, 16
	call $memcpy(l %data, l %source, l %length)
	%end =l add %data, %length
	storeb 0, %end
	ret %string
}

function l $g4_read_file(l %p) {
@start
	%f =l call $fopen(l %p, l $g4_rb)
	%fm =w ceql %f, 0
	jnz %fm, @fail, @seek
@seek
	%es =w call $fseek(l %f, l 0, w 2)
	%ef =w cnew %es, 0
	jnz %ef, @close, @len
@len
	%n =l call $ftell(l %f)
	%neg =w csltl %n, 0
	jnz %neg, @close, @rewind
@rewind
	%rs =w call $fseek(l %f, l 0, w 0)
	%rf =w cnew %rs, 0
	jnz %rf, @close, @alloc
@alloc
	%sz =l add %n, 9
	%s =l call $g4_string_alloc(l %sz)
	%length_address =l add %s, 8
	storel %n, %length_address
	%d =l add %s, 16
	%got =l call $fread(l %d, l 1, l %n, l %f)
	%cs =w call $fclose(l %f)
	%rfe =w cnel %got, %n
	%cfe =w cnew %cs, 0
	%bad =w or %rfe, %cfe
	jnz %bad, @fail, @done
@done
	%e =l add %d, %n
	storeb 0, %e
	%file_root =l add $g4_gc_global_roots, 8
	storel %s, %file_root
	ret %s
@close
	%ignored =w call $fclose(l %f)
	jmp @fail
@fail
	ret 0
}

function l $g4_file_exists(l %path) {
@start
