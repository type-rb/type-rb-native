	%path_slot =l add %read_data, %offset
	%path =l loadl %path_slot
	%path_data =l add %path, 16
	%source =l call $g4_read_file(l %path_data)
	%read_failed =w ceql %source, 0
	jnz %read_failed, @source_failed, @source_ready
@source_failed
	storel %path, %error_slot
	ret %result
@source_ready
	call $g4_array_push(l %sources, l %source)
	jmp @read_next
@read_next
	%next_index =l add %index, 1
	jmp @read_loop
@success
	ret %result
}

