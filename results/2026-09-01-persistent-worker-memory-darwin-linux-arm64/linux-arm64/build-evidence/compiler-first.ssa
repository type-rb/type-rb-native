	%bsp =l loadl %bspp
	%bsrc =l call $g4_read_file(l %bsp)
	%bsm =w ceql %bsrc, 0
	jnz %bsm, @bread_error, @bpaths
@bread_error
	call $write(w 2, l $g4_file_error, l 35)
	%bspl =l call $strlen(l %bsp)
	call $write(w 2, l %bsp, l %bspl)
	call $write(w 2, l $g4_newline, l 1)
	ret 66
@bpaths
	%bop =l add %argv, 32
	%bo =l loadl %bop
	%bqp =l add %argv, 48
	%bqbe =l loadl %bqp
	%bcp =l add %argv, 64
	%bcc =l loadl %bcp
	%bssa =l call $g4_c_concat(l %bo, l $g4_ssa_suffix)
	%basm =l call $g4_c_concat(l %bo, l $g4_asm_suffix)
	%bf =l call $fopen(l %bssa, l $g4_wb)
	%bfm =w ceql %bf, 0
	jnz %bfm, @bfile_error, @bredirect
@bfile_error
	call $g4_cleanup(l %bssa, l %basm)
	call $write(w 2, l $g4_intermediate_error, l 42)
	ret 73
@bredirect
	%bfd =w call $fileno(l %bf)
	%bsaved =w call $dup(w 1)
	%bfdb =w csltw %bfd, 0
	%bsavedb =w csltw %bsaved, 0
	%brb =w or %bfdb, %bsavedb
	jnz %brb, @bredirect_error, @bset_stdout
@bset_stdout
	%bset =w call $dup2(w %bfd, w 1)
	%bsetb =w csltw %bset, 0
	jnz %bsetb, @bredirect_error, @bcompile
@bredirect_error
	%bci =w call $close(w %bsaved)
	%bfci =w call $fclose(l %bf)
	call $g4_cleanup(l %bssa, l %basm)
	call $write(w 2, l $g4_intermediate_error, l 42)
	ret 73
@bcompile
	%bm =l call $g4_string_from_c(l $g4_emit)
	%bpath =l call $g4_string_from_c(l %bsp)
	%bst =l call $g4f109(l %bsrc, l %bpath, l %bm, l 1)
	%brestore =w call $dup2(w %bsaved, w 1)
	%bclosed =w call $close(w %bsaved)
	%bfclosed =w call $fclose(l %bf)
	%brb0 =w csltw %brestore, 0
	%brb1 =w csltw %bclosed, 0
	%brb2 =w cnew %bfclosed, 0
	%brb3 =w or %brb0, %brb1
	%brbad =w or %brb3, %brb2
	jnz %brbad, @bpost_error, @bcompiled
@bpost_error
	call $g4_cleanup(l %bssa, l %basm)
	call $write(w 2, l $g4_intermediate_error, l 42)
	ret 73
@bcompiled
	%bcfail =w cnel %bst, 0
	jnz %bcfail, @bcompiler_failed, @bqbe
@bcompiler_failed
	call $g4_cleanup(l %bssa, l %basm)
	ret 1
@bqbe
	%bqs =w call $g4_run_qbe(l %bqbe, l %bssa, l %basm)
	%bqfail =w cnew %bqs, 0
	jnz %bqfail, @bqbe_failed, @btemp
@bqbe_failed
	call $g4_cleanup(l %bssa, l %basm)
	call $write(w 2, l $g4_qbe_error, l 21)
	ret 70
@btemp
	%btmpl =l call $g4_c_concat(l %bo, l $g4_temp_suffix)
	%bdir =l call $mkdtemp(l %btmpl)
	%bdfail =w ceql %bdir, 0
	jnz %bdfail, @btemp_failed, @btemp_path
@btemp_failed
	call $g4_cleanup(l %bssa, l %basm)
	call $write(w 2, l $g4_intermediate_error, l 42)
	ret 73
@btemp_path
	%bbase =l call $g4_c_basename(l %bo)
	%bdp =l call $g4_c_concat(l %bdir, l $g4_slash)
	%bexe =l call $g4_c_concat(l %bdp, l %bbase)
	%bcs =w call $g4_project_run_cc(l %bcc, l %basm, l %bexe)
	%bccfail =w cnew %bcs, 0
	jnz %bccfail, @bcc_failed, @bpublish
@bcc_failed
	call $g4_cleanup(l %bssa, l %basm)
	call $g4_cleanup_output(l %bexe, l %bdir)
	call $write(w 2, l $g4_cc_error, l 20)
	ret 70
@bpublish
	%bpr =w call $rename(l %bexe, l %bo)
	%bpf =w cnew %bpr, 0
	jnz %bpf, @bpublish_failed, @bsuccess
@bpublish_failed
	call $g4_cleanup(l %bssa, l %basm)
	call $g4_cleanup_output(l %bexe, l %bdir)
	call $write(w 2, l $g4_publish_error, l 32)
	ret 73
@bsuccess
	call $g4_cleanup(l %bssa, l %basm)
	call $g4_cleanup_output(l %bexe, l %bdir)
	ret 0
@other
	%a3 =w ceqw %argc, 3
	jnz %a3, @fargs, @hargc
@hargc
	%a4 =w ceqw %argc, 4
	jnz %a4, @hargs, @usage
@hargs
	%hfp =l add %argv, 8
	%hf =l loadl %hfp
	%hfc =w call $strcmp(l %hf, l $g4_source_arg)
	%valid_hf =w ceqw %hfc, 0
	jnz %valid_hf, @hidden, @usage
@usage
	call $write(w 2, l $g4_usage_error, l 103)
	ret 64
@hidden
	%hmp =l add %argv, 16
	%hmc =l loadl %hmp
	%hm =l call $g4_string_from_c(l %hmc)
	%hsp =l add %argv, 24
	%hsc =l loadl %hsp
	%hs =l call $g4_string_from_c(l %hsc)
	%hst =l call $g4f108(l %hs, l %hm, l 0)
	ret 0
@fargs
	%fmp =l add %argv, 8
	%fmc =l loadl %fmp
	%cc =w call $strcmp(l %fmc, l $g4_check)
	%cm =w ceqw %cc, 0
	%ec =w call $strcmp(l %fmc, l $g4_emit)
	%em =w ceqw %ec, 0
	%valid_fm =w or %cm, %em
	jnz %valid_fm, @file, @usage
@file
	%pp =l add %argv, 16
	%path =l loadl %pp
	%src =l call $g4_read_file(l %path)
	%rf =w ceql %src, 0
	jnz %rf, @read_error, @compile
@read_error
	call $write(w 2, l $g4_file_error, l 35)
	%pl =l call $strlen(l %path)
	call $write(w 2, l %path, l %pl)
	call $write(w 2, l $g4_newline, l 1)
	ret 66
@compile
	%fm =l call $g4_string_from_c(l %fmc)
	%fpath =l call $g4_string_from_c(l %path)
	%fst =l call $g4f109(l %src, l %fpath, l %fm, l 1)
	%failed =w cnel %fst, 0
	ret %failed
}

export function w $main(w %argc, l %argv) {
@start
	call $g4_gc_trace_initialize()
	call $g4_static_strings_initialize()
	storel $g4_qbe_darwin_arm64, $g4_selected_qbe_target
	storel $g4_dead_strip_darwin, $g4_selected_dead_strip
	storel 0, $g4_project_selected_linker
	%a11 =w ceqw %argc, 11
	jnz %a11, @target_shape, @dispatch
@target_shape
	%target_flag_pointer =l add %argv, 72
	%target_flag =l loadl %target_flag_pointer
	%target_flag_comparison =w call $strcmp(l %target_flag, l $g4_target_option)
	%target_flag_ok =w ceqw %target_flag_comparison, 0
	jnz %target_flag_ok, @target_profile, @dispatch
@target_profile
	%profile_pointer =l add %argv, 80
	%profile =l loadl %profile_pointer
	%darwin_comparison =w call $strcmp(l %profile, l $g4_profile_darwin_arm64)
	%darwin =w ceqw %darwin_comparison, 0
	jnz %darwin, @target_darwin, @target_linux_check
@target_darwin
	jmp @invoke_target
@target_linux_check
	%linux_comparison =w call $strcmp(l %profile, l $g4_profile_linux_arm64)
	%linux =w ceqw %linux_comparison, 0
	jnz %linux, @target_linux_arm64, @target_linux_amd64_check
@target_linux_arm64
	storel $g4_qbe_linux_arm64, $g4_selected_qbe_target
	jmp @target_linux_common
@target_linux_amd64_check
	%linux_amd64_comparison =w call $strcmp(l %profile, l $g4_profile_linux_amd64)
	%linux_amd64 =w ceqw %linux_amd64_comparison, 0
	jnz %linux_amd64, @target_linux_amd64, @target_error
@target_linux_amd64
	storel $g4_qbe_linux_amd64, $g4_selected_qbe_target
	jmp @target_linux_common
@target_linux_common
	storel $g4_dead_strip_linux, $g4_selected_dead_strip
	storel $g4_project_linker_lld, $g4_project_selected_linker
	jmp @invoke_target
@target_error
	call $write(w 2, l $g4_target_error, l 37)
	call $g4_gc_finish()
	ret 64
@invoke_target
	%target_status =w call $g4_compiler_dispatch(w 9, l %argv)
	call $g4_gc_finish()
	ret %target_status
@dispatch
	%dispatch_status =w call $g4_compiler_dispatch(w %argc, l %argv)
	call $g4_gc_finish()
	ret %dispatch_status
}
