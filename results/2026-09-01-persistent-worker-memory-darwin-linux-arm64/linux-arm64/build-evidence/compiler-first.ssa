function $g4_static_string_decode(l %target, l %encoded, l %encoded_length, l %decoded_length) {
@start
	storel 0, %target
	%length_address =l add %target, 8
	storel %decoded_length, %length_address
	%output =l add %target, 16
	jmp @loop
@loop
	%input_index =l phi @start 0, @literal %literal_next_input, @match_done %match_next_input
	%output_index =l phi @start 0, @literal %literal_next_output, @match_done %match_next_output
	%done =w cslel %encoded_length, %input_index
	jnz %done, @terminate, @read
@read
	%encoded_address =l add %encoded, %input_index
	%header =w loadub %encoded_address
	%is_match =w csgtw %header, 127
	jnz %is_match, @match, @literal
@literal
	%literal_address =l add %output, %output_index
	storeb %header, %literal_address
	%literal_next_input =l add %input_index, 1
	%literal_next_output =l add %output_index, 1
	jmp @loop
@match
	%high_address =l add %encoded_address, 1
	%low_address =l add %encoded_address, 2
	%high =w loadub %high_address
	%low =w loadub %low_address
	%high_long =l extuw %high
	%low_long =l extuw %low
	%high_shifted =l shl %high_long, 8
	%distance =l or %high_shifted, %low_long
	%match_length_word =w sub %header, 125
	%match_length =l extuw %match_length_word
	jmp @copy
@copy
	%copy_index =l phi @match 0, @copy_byte %copy_next
	%copy_done =w cslel %match_length, %copy_index
	jnz %copy_done, @match_done, @copy_byte
@copy_byte
	%source_base =l sub %output_index, %distance
	%source_index =l add %source_base, %copy_index
	%source_address =l add %output, %source_index
	%value =w loadub %source_address
	%destination_index =l add %output_index, %copy_index
	%destination_address =l add %output, %destination_index
	storeb %value, %destination_address
	%copy_next =l add %copy_index, 1
	jmp @copy
@match_done
	%match_next_input =l add %input_index, 3
	%match_next_output =l add %output_index, %match_length
	jmp @loop
@terminate
	%terminator =l add %output, %decoded_length
	storeb 0, %terminator
	ret
}

