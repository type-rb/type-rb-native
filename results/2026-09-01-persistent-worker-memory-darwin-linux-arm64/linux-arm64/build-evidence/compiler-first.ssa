	%unknown =w ceqw %type, 4
	%unreadable =w or %denied, %unknown
	jnz %unreadable, @error, @special
@special
	%source_kind =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)
	jnz %source_kind, @error, @ignore
@regular
	%source =w call $g4_c_ends_with(l %path, l $g4_project_trb_suffix)
	jnz %source, @test, @ignore
@test
