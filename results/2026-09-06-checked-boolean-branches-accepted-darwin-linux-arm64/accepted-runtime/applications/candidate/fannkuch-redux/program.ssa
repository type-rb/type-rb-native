	%a2 =l add %a, 16
	storel %dead_strip, %a2
	%a3 =l add %a, 24
	storel $g4_math_library, %a3
	%a4 =l add %a, 32
	storel $g4_o_flag, %a4
	%a5 =l add %a, 40
	storel %output, %a5
	%a6 =l add %a, 48
	storel 0, %a6
	%r =w call $g4_run(l %cc, l %a)
	ret %r
}

