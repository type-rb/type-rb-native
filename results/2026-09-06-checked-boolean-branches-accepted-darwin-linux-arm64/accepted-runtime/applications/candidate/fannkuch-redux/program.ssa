function $g4_gc_update_peak(l %candidate) {
@start
	%peak =l loadl $g4_gc_peak_heap_bytes
	%greater =w csgtl %candidate, %peak
	jnz %greater, @store, @finish
@store
	storel %candidate, $g4_gc_peak_heap_bytes
	ret
@finish
	ret
}

function $g4_gc_maybe_collect(l %additional) {
@start
	%before =l loadl $g4_gc_heap_bytes
	%projected =l add %before, %additional
	%target =l loadl $g4_gc_heap_target
	%over =w csgtl %projected, %target
	jnz %over, @collect, @finish
@collect
	call $g4_gc_collect(w 1)
@finish
	ret
}

function $g4_gc_temp_push(l %value) {
@start
	%nil =w ceql %value, 0
	jnz %nil, @finish, @descriptor
@descriptor
	%descriptor_mark =l loadl %value
	%static =w ceql %descriptor_mark, 0
	jnz %static, @finish, @count
@count
	%count =l loadl $g4_gc_temp_count
	%capacity =l loadl $g4_gc_temp_capacity
	%full =w ceql %count, %capacity
	jnz %full, @grow, @store
@grow
	call $g4_gc_temp_grow(l %value, l %count, l %capacity)
	ret
@store
	%current_data =l loadl $g4_gc_temp_data
	%offset =l shl %count, 3
	%slot =l add %current_data, %offset
	storel %value, %slot
	%next_count =l add %count, 1
	storel %next_count, $g4_gc_temp_count
	jmp @finish
@finish
