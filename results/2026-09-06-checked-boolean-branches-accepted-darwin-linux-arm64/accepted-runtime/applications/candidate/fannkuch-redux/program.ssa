function l $g4_array_new(l %descriptor) {
@start
	%array =l call $g4_gc_alloc(l %descriptor, l 24, l 32)
	%data =l call $calloc(l 4, l 8)
	%failed =w ceql %data, 0
	jnz %failed, @fail, @initialize
@fail
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@initialize
	%heap =l loadl $g4_gc_heap_bytes
	%heap_with_data =l add %heap, 32
	storel %heap_with_data, $g4_gc_heap_bytes
	%allocated =l loadl $g4_gc_allocated_bytes
	%allocated_with_data =l add %allocated, 32
	storel %allocated_with_data, $g4_gc_allocated_bytes
	call $g4_gc_update_peak(l %heap_with_data)
	%length =l add %array, 8
	storel 0, %length
	%capacity =l add %array, 16
	storel 4, %capacity
	%data_slot =l add %array, 24
	storel %data, %data_slot
	ret %array
}

function $g4_array_push(l %array, l %value) {
@start
	%length_slot =l add %array, 8
	%length =l loadl %length_slot
	%capacity_slot =l add %array, 16
	%capacity =l loadl %capacity_slot
	%full =w ceql %length, %capacity
	jnz %full, @grow, @store
@grow
	%new_capacity =l mul %capacity, 2
	%new_bytes =l mul %new_capacity, 8
	%old_bytes =l mul %capacity, 8
	%growth =l sub %new_bytes, %old_bytes
	%data_slot =l add %array, 24
	%data =l loadl %data_slot
	%new_data =l call $realloc(l %data, l %new_bytes)
	%failed =w ceql %new_data, 0
	jnz %failed, @fail, @grown
@fail
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@grown
	%heap_before =l loadl $g4_gc_heap_bytes
	%heap_after =l add %heap_before, %growth
	storel %heap_after, $g4_gc_heap_bytes
	%allocated_before =l loadl $g4_gc_allocated_bytes
	%allocated_after =l add %allocated_before, %growth
	storel %allocated_after, $g4_gc_allocated_bytes
	call $g4_gc_update_peak(l %heap_after)
	storel %new_capacity, %capacity_slot
	storel %new_data, %data_slot
	jmp @store
@store
	%current_data_slot =l add %array, 24
	%current_data =l loadl %current_data_slot
	%offset =l mul %length, 8
	%target =l add %current_data, %offset
	storel %value, %target
	%new_length =l add %length, 1
	storel %new_length, %length_slot
	ret
}

function l $g4_integer_add(l %left, l %right) {
@start
	%result =l add %left, %right
	%too_high =w csgtl %result, 9007199254740991
	jnz %too_high, @fail, @check_low
@check_low
	%too_low =w csltl %result, -9007199254740991
	jnz %too_low, @fail, @ok
@fail
	call $g4_fail(l $g4_integer_range_error, l 45)
	hlt
@ok
	ret %result
}

