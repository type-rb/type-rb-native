	hlt
@ok
	ret %result
}

function l $g4_integer_mul(l %left, l %right) {
@start
	%c =l or %left, %right
	%u =l shr %c, 26
	jnz %u, @left_sign, @multiply
@left_sign
	%right_zero =w ceql %right, 0
	jnz %right_zero, @zero, @left_nonzero
@left_nonzero
	%left_positive =w csgtl %left, 0
	jnz %left_positive, @left_positive, @left_negative
@left_positive
	%right_positive =w csgtl %right, 0
	jnz %right_positive, @positive_positive, @positive_negative
@positive_positive
	%positive_limit =l div 9007199254740991, %right
	%positive_overflow =w csgtl %left, %positive_limit
	jnz %positive_overflow, @fail, @multiply
@positive_negative
	%negative_limit =l div -9007199254740991, %left
	%negative_overflow =w csltl %right, %negative_limit
	jnz %negative_overflow, @fail, @multiply
@left_negative
	%right_positive_two =w csgtl %right, 0
	jnz %right_positive_two, @negative_positive, @negative_negative
@negative_positive
	%negative_limit_two =l div -9007199254740991, %right
	%negative_overflow_two =w csltl %left, %negative_limit_two
	jnz %negative_overflow_two, @fail, @multiply
@negative_negative
	%positive_limit_two =l div 9007199254740991, %right
	%positive_overflow_two =w csltl %left, %positive_limit_two
	jnz %positive_overflow_two, @fail, @multiply
@multiply
	%result =l mul %left, %right
	ret %result
@zero
	ret 0
@fail
	call $g4_fail(l $g4_integer_range_error, l 45)
	hlt
}

