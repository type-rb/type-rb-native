	%allocated_after =l add %allocated_before, %growth
	storel %allocated_after, $g4_gc_allocated_bytes
	call $g4_gc_update_peak(l %heap_after)
	storel %new_capacity, %capacity_slot
	storel %new_data, %data_slot
	jmp @store
@store
	%current_data_slot =l add %array, 24
	%current_data =l loadl %current_data_slot
	%offset =l mul %length, 8
	%target =l add %current_data, %offset
	stored %value, %target
	%new_length =l add %length, 1
	storel %new_length, %length_slot
	ret
}

data $g4_process_argc = align 8 { l 0 }
data $g4_process_argv_pointer = align 8 { l 0 }

function l $g4_process_argv() {
@start
	%array =l call $g4_array_new(l $g4_desc_array_managed)
	%argc =l loadl $g4_process_argc
	%argv =l loadl $g4_process_argv_pointer
	jmp @loop
@loop
	%index =l phi @start 1, @append %next
	%done =w cslel %argc, %index
	jnz %done, @finish, @load
@load
	%offset =l mul %index, 8
	%cell =l add %argv, %offset
	%source =l loadl %cell
	%string =l call $g4_string_from_c(l %source)
	call $g4_array_push_paced(l %array, l %string)
	jmp @append
@append
	%next =l add %index, 1
	jmp @loop
@finish
	ret %array
}

data $g4_invalid_integer_error = { b "panic: invalid Integer", b 10 }

function l $g4_string_to_integer(l %string) {
@start
	%length_address =l add %string, 8
	%length =l loadl %length_address
	%empty =w ceql %length, 0
	jnz %empty, @invalid, @first
@first
	%parse_start_slot =l alloc8 8
	%data =l add %string, 16
	%first =w loadub %data
	%plus =w ceqw %first, 43
	%minus =w ceqw %first, 45
	%signed =w or %plus, %minus
	jnz %signed, @signed, @unsigned
@signed
	%sign_only =w ceql %length, 1
	jnz %sign_only, @invalid, @signed_start
@signed_start
	%signed_index =l copy 1
	storel %signed_index, %parse_start_slot
	jmp @validate
@unsigned
	%unsigned_index =l copy 0
	storel %unsigned_index, %parse_start_slot
	jmp @validate
@validate
	%validation_index =l phi @signed_start %signed_index, @unsigned %unsigned_index, @validate_next %validation_next
	%validation_done =w cslel %length, %validation_index
	jnz %validation_done, @parse_start, @validate_digit
@validate_digit
	%validation_address =l add %data, %validation_index
	%validation_character =w loadub %validation_address
	%validation_below =w csltw %validation_character, 48
	%validation_above =w csgtw %validation_character, 57
	%validation_invalid =w or %validation_below, %validation_above
	jnz %validation_invalid, @invalid, @validate_next
@validate_next
	%validation_next =l add %validation_index, 1
	jmp @validate
@parse_start
	%parse_begin =l loadl %parse_start_slot
	jmp @parse
@parse
	%parse_index =l phi @parse_start %parse_begin, @parse_next %next_index
	%accumulator =l phi @parse_start 0, @parse_next %next_accumulator
	%parse_done =w cslel %length, %parse_index
	jnz %parse_done, @sign, @parse_digit
@parse_digit
	%parse_address =l add %data, %parse_index
	%parse_character =w loadub %parse_address
	%digit_word =w sub %parse_character, 48
	%digit =l extuw %digit_word
	%large_prefix =w csgtl %accumulator, 900719925474099
	%limit_prefix =w ceql %accumulator, 900719925474099
	%large_digit =w csgtl %digit, 1
	%limit_overflow =w and %limit_prefix, %large_digit
	%overflow =w or %large_prefix, %limit_overflow
	jnz %overflow, @range, @accumulate
@accumulate
	%scaled =l mul %accumulator, 10
	%next_accumulator =l add %scaled, %digit
	jmp @parse_next
@parse_next
	%next_index =l add %parse_index, 1
	jmp @parse
@sign
	jnz %minus, @negative, @positive
@negative
	%negative_result =l sub 0, %accumulator
	ret %negative_result
@positive
	ret %accumulator
@invalid
	call $g4_fail(l $g4_invalid_integer_error, l 23)
	hlt
@range
	call $g4_fail(l $g4_integer_range_error, l 45)
	hlt
}

function l $g4_integer_to_string(l %value) {
@start
	%buffer =l alloc8 32
	%end =l add %buffer, 32
	%cursor_slot =l alloc8 8
	storel %end, %cursor_slot
	%negative =w csltl %value, 0
	jnz %negative, @negative_value, @positive_value
@negative_value
	%negative_magnitude =l sub 0, %value
	jmp @magnitude
@positive_value
	%positive_magnitude =l copy %value
	jmp @magnitude
@magnitude
	%magnitude_value =l phi @negative_value %negative_magnitude, @positive_value %positive_magnitude
	%zero =w ceql %magnitude_value, 0
	jnz %zero, @zero_digit, @digits
@zero_digit
	%zero_cursor =l sub %end, 1
	storeb 48, %zero_cursor
	storel %zero_cursor, %cursor_slot
	jmp @sign
@digits
	%current =l phi @magnitude %magnitude_value, @digit %remaining
	%done =w ceql %current, 0
	jnz %done, @sign, @digit
@digit
	%remainder =l rem %current, 10
	%digit_value =l add %remainder, 48
	%digit_byte =w copy %digit_value
	%cursor =l loadl %cursor_slot
	%next_cursor =l sub %cursor, 1
	storeb %digit_byte, %next_cursor
	storel %next_cursor, %cursor_slot
	%remaining =l div %current, 10
	jmp @digits
@sign
	jnz %negative, @negative_sign, @finish
@negative_sign
	%sign_cursor =l loadl %cursor_slot
	%before_sign =l sub %sign_cursor, 1
	storeb 45, %before_sign
	storel %before_sign, %cursor_slot
	jmp @finish
@finish
	%start =l loadl %cursor_slot
	%length =l sub %end, %start
	%size =l add %length, 9
	%string =l call $g4_string_alloc(l %size)
	%length_address =l add %string, 8
	storel %length, %length_address
	%data =l add %string, 16
	call $memcpy(l %data, l %start, l %length)
	%terminator =l add %data, %length
	storeb 0, %terminator
	ret %string
}

data $g4_float_integer_error = { b "panic: Float cannot be converted to Integer", b 10 }

function l $g4_float_to_integer(d %value) {
@start
	%self_difference =d sub %value, %value
	%finite =w ceqd %self_difference, %self_difference
	jnz %finite, @range, @nonfinite
@range
	%too_high =w cgtd %value, d_9007199254740991.0
	%too_low =w cltd %value, d_-9007199254740991.0
	%outside =w or %too_high, %too_low
	jnz %outside, @outside, @convert
@convert
	%result =l dtosi %value
	ret %result
@nonfinite
	call $g4_fail(l $g4_float_integer_error, l 44)
	hlt
@outside
	call $g4_fail(l $g4_integer_range_error, l 45)
	hlt
}
