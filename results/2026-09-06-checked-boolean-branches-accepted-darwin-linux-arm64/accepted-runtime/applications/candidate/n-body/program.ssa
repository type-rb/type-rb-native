function $g4_fail(l %message, l %size) {
@start
	call $write(w 2, l %message, l %size)
	call $exit(w 2)
	hlt
}

function l $g4_alloc(l %size) {
@start
	%pointer =l call $calloc(l 1, l %size)
	%failed =w ceql %pointer, 0
	jnz %failed, @fail, @ok
@fail
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@ok
	ret %pointer
}

function l $g4_string_alloc(l %size) {
@start
	%result =l call $g4_gc_alloc(l $g4_desc_string, l %size, l 0)
	ret %result
}

function l $g4_temp_alloc(l %size) {
@start
	%storage =l loadl $g4_temporary_storage
	%missing =w ceql %storage, 0
	jnz %missing, @initialize, @allocate
@initialize
	%allocated =l call $calloc(l 1, l 1048576)
	%failed =w ceql %allocated, 0
	jnz %failed, @allocation_failed, @initialized
@allocation_failed
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@initialized
	storel %allocated, $g4_temporary_storage
	jmp @allocate
@allocate
	%base =l loadl $g4_temporary_storage
	%used_address =l add $g4_temporary_storage, 8
	%used =l loadl %used_address
	%with_padding =l add %size, 7
	%aligned =l and %with_padding, -8
	%next =l add %used, %aligned
	%overflow =w csltl 1048576, %next
	jnz %overflow, @capacity_failed, @ready
@capacity_failed
	call $g4_fail(l $g4_allocation_error, l 26)
	hlt
@ready
	%result =l add %base, %used
	storel %next, %used_address
	ret %result
}

function $g4_temp_reset() {
@start
	%used_address =l add $g4_temporary_storage, 8
	storel 0, %used_address
	ret
}

function l $g4_string_from_c(l %source) {
@start
	%length =l call $strlen(l %source)
	%size =l add %length, 9
	%string =l call $g4_string_alloc(l %size)
	%length_address =l add %string, 8
	storel %length, %length_address
	%data =l add %string, 16
	call $memcpy(l %data, l %source, l %length)
	%end =l add %data, %length
	storeb 0, %end
	ret %string
}

function l $g4_read_file(l %p) {
@start
	%f =l call $fopen(l %p, l $g4_rb)
	%fm =w ceql %f, 0
	jnz %fm, @fail, @seek
@seek
	%es =w call $fseek(l %f, l 0, w 2)
	%ef =w cnew %es, 0
	jnz %ef, @close, @len
@len
	%n =l call $ftell(l %f)
	%neg =w csltl %n, 0
	jnz %neg, @close, @rewind
@rewind
	%rs =w call $fseek(l %f, l 0, w 0)
	%rf =w cnew %rs, 0
	jnz %rf, @close, @alloc
@alloc
	%sz =l add %n, 9
	%s =l call $g4_string_alloc(l %sz)
	%length_address =l add %s, 8
	storel %n, %length_address
	%d =l add %s, 16
	%got =l call $fread(l %d, l 1, l %n, l %f)
	%cs =w call $fclose(l %f)
	%rfe =w cnel %got, %n
	%cfe =w cnew %cs, 0
	%bad =w or %rfe, %cfe
	jnz %bad, @fail, @done
@done
	%e =l add %d, %n
	storeb 0, %e
	%file_root =l add $g4_gc_global_roots, 8
	storel %s, %file_root
	ret %s
@close
	%ignored =w call $fclose(l %f)
	jmp @fail
@fail
	ret 0
}

function l $g4_file_exists(l %path) {
@start
	%data =l add %path, 16
	%status =w call $access(l %data, w 0)
	%ok =w ceqw %status, 0
	%result =l extuw %ok
	ret %result
}

function l $g4_read_source(l %path) {
@start
	%data =l add %path, 16
	%source =l call $g4_read_file(l %data)
	ret %source
}

function w $g4_run(l %program, l %args) {
@start
	%pid =w call $fork()
	%ff =w csltw %pid, 0
	jnz %ff, @fail, @child_check
@child_check
	%child =w ceqw %pid, 0
	jnz %child, @child, @parent
@child
	%ignored =w call $execv(l %program, l %args)
	call $exit(w 127)
	hlt
@parent
	%sp =l alloc8 8
	storew 0, %sp
	%waited =w call $waitpid(w %pid, l %sp, w 0)
	%wf =w csltw %waited, 0
	jnz %wf, @fail, @status
@status
	%st =w loadw %sp
	%sig =w and %st, 127
	%signaled =w cnew %sig, 0
	jnz %signaled, @signal, @exited
@signal
	%sr =w add %sig, 128
	ret %sr
@exited
	%shifted =w shr %st, 8
	%code =w and %shifted, 255
	ret %code
@fail
	ret 127
}

function w $g4_run_qbe(l %qbe, l %ssa, l %assembly) {
@start
	%target =l loadl $g4_selected_qbe_target
	%a =l alloc8 56
	storel %qbe, %a
	%a1 =l add %a, 8
	storel $g4_target_flag, %a1
	%a2 =l add %a, 16
	storel %target, %a2
	%a3 =l add %a, 24
	storel $g4_o_flag, %a3
	%a4 =l add %a, 32
	storel %assembly, %a4
	%a5 =l add %a, 40
	storel %ssa, %a5
	%a6 =l add %a, 48
	storel 0, %a6
	%r =w call $g4_run(l %qbe, l %a)
	ret %r
}

function w $g4_run_cc(l %cc, l %assembly, l %output) {
@start
	%dead_strip =l loadl $g4_selected_dead_strip
	%a =l alloc8 56
	storel %cc, %a
	%a1 =l add %a, 8
	storel %assembly, %a1
	%a2 =l add %a, 16
	storel %dead_strip, %a2
	%a3 =l add %a, 24
	storel $g4_math_library, %a3
	%a4 =l add %a, 32
	storel $g4_o_flag, %a4
	%a5 =l add %a, 40
	storel %output, %a5
	%a6 =l add %a, 48
	storel 0, %a6
	%r =w call $g4_run(l %cc, l %a)
	ret %r
}

