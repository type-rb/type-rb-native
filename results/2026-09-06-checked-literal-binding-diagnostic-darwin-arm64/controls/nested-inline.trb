def literal(): Integer
	return 1_024
end

def identity(value: Integer): Integer
	return value
end

def positive(value: Integer): Integer
	return +value
end

def float_identity(value: Float): Float
	return value
end

def main()
	mut value := 7
	puts((value + identity(literal())).to_s())
	mut index := 0
	while index < 1
		puts((value + identity(literal())).to_s())
		puts((value + identity(literal())).to_s())
		puts((value + identity(literal())).to_s())
		index += 1
	end
	return
end
