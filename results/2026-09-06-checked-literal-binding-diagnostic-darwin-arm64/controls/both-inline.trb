def literal(): Integer
	return 1_024
end

def identity(value: Integer): Integer
	return value
end

def positive(value: Integer): Integer
	return +value
end

def float_identity(value: Float): Float
	return value
end

def main()
	puts((identity(1) + literal()).to_s())
	mut index := 0
	while index < 1
		puts((identity(1) + literal()).to_s())
		puts((identity(1) + literal()).to_s())
		puts((identity(1) + literal()).to_s())
		index += 1
	end
	return
end
