def sum(left: Integer, right: Integer): Integer
	return left + right
end

def main()
	lefts := [9007199254740991, - 9007199254740991, 9007199254740991, - 9007199254740991, 2, - 2, 0]
	rights := [0, 0, - 9007199254740991, 9007199254740991, - 3, 3, 0]
	mut index := 0
	while index < lefts.size()
		puts(sum(lefts[index], rights[index]).to_s())
		puts(sum(lefts[index], rights[index]).to_s())
		puts(sum(lefts[index], rights[index]).to_s())
		index += 1
	end
	return
end
