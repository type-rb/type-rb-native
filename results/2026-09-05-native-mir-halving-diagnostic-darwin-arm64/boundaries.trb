def half(value: Integer): Integer
	return value / 2
end

def main()
	values := [0, 1, - 1, 2, - 2, 3, - 3, 9007199254740990, - 9007199254740990, 9007199254740991, - 9007199254740991]
	mut index := 0
	while index < values.size()
		puts(half(values[index]).to_s())
		index += 1
	end
	puts(half(15).to_s())
end
