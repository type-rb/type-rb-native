+	test("selects exact Integer halving from verified same-block literals") do
+		source := "def half(value: Integer): Integer\n\treturn value / 2\nend\n\ndef main()\n\tmut index := 0\n\twhile index < 1\n\t\tputs(half(index).to_s())\n\t\tindex += 1\n\tend\n\tputs(half(- 3).to_s())\nend\n"
+		mut state := gate4_compiler_new(source.size() + 1)
+		expect(gate4_lex(state, source)).to_be_true()
+		expect(gate4_parse_module(state, 0, state.entry_module[0])).to_be_true()
+		expect(gate4_resolve(state)).to_be_true()
+		expect(gate4_check(state)).to_be_true()
+		expect(gate4_verify_mir(state.scalar_mir, true)).to_equal("")
+		function := state.scalar_mir.functions[gate4_mir_function_index(state.scalar_mir, 0)]
+		block := state.scalar_mir.blocks[function[6]]
+		instruction_index := block[5] + 1
+		literal_index := state.scalar_mir.instructions[block[5]][4]
+		expect(state.scalar_mir.instructions[instruction_index][4]).to_equal(14)
+		qbe := gate4_output_source(gate4_emit_qbe(state))
+		expect(gate4_occurrence_count(qbe, " =l sar ")).to_equal(2)
+		expect(gate4_occurrence_count(qbe, ", 63\n")).to_equal(2)
+		state.scalar_mir.literal_texts[literal_index] = "3"
+		expect(gate4_verify_mir(state.scalar_mir, true)).to_equal("MIR Integer halving literal differs")
+		state.scalar_mir.literal_texts[literal_index] = "0"
+		expect(gate4_verify_mir(state.scalar_mir, true)).to_equal("MIR Integer halving literal differs")
+		state.scalar_mir.literal_texts[literal_index] = "2"
+		state.scalar_mir.instructions[instruction_index][3] = 0
+		expect(gate4_verify_mir(state.scalar_mir, true)).to_equal("MIR Integer halving literal differs")
+		state.scalar_mir.instructions[instruction_index][3] = 1
+		state.scalar_mir.instructions[instruction_index][5] =- 1
+		expect(gate4_verify_mir(state.scalar_mir, true)).to_equal("MIR failure target does not exist")
+	end
+
