	%static =w ceql %descriptor_mark, 0
	jnz %static, @finish, @count
@count
	%count =l loadl $g4_gc_temp_count
	%capacity =l loadl $g4_gc_temp_capacity
	%full =w ceql %count, %capacity
	jnz %full, @grow, @store
@grow
	call $g4_gc_temp_grow(l %value, l %count, l %capacity)
	ret
@store
