function l $g4_string_concat(l %left, l %right) {
@start
	%left_length_address =l add %left, 8
	%right_length_address =l add %right, 8
	%left_length =l loadl %left_length_address
	%right_length =l loadl %right_length_address
	%length =l add %left_length, %right_length
	%size =l add %length, 9
	%string =l call $g4_string_alloc(l %size)
	%length_address =l add %string, 8
	storel %length, %length_address
	%data =l add %string, 16
	%left_data =l add %left, 16
	call $memcpy(l %data, l %left_data, l %left_length)
	%right_target =l add %data, %left_length
	%right_data =l add %right, 16
	call $memcpy(l %right_target, l %right_data, l %right_length)
	%end =l add %data, %length
	storeb 0, %end
	ret %string
}

function l $g4_string_equal(l %left, l %right) {
@start
	%left_length_address =l add %left, 8
	%right_length_address =l add %right, 8
	%left_length =l loadl %left_length_address
	%right_length =l loadl %right_length_address
	%same_length =w ceql %left_length, %right_length
	jnz %same_length, @compare, @different
@compare
	%left_data =l add %left, 16
	%right_data =l add %right, 16
	%comparison =w call $memcmp(l %left_data, l %right_data, l %left_length)
	%equal =w ceqw %comparison, 0
	%result =l extuw %equal
	ret %result
@different
	ret 0
}

function l $g4_string_index(l %string, l %requested) {
@start
	%length_address =l add %string, 8
	%length =l loadl %length_address
	%negative =w csltl %requested, 0
	jnz %negative, @negative, @check
@negative
	%adjusted_negative =l add %length, %requested
	jmp @bounds
@check
	%adjusted_positive =l copy %requested
	jmp @bounds
@bounds
	%index =l phi @negative %adjusted_negative, @check %adjusted_positive
	%below =w csltl %index, 0
	%above =w cslel %length, %index
	%invalid =w or %below, %above
	jnz %invalid, @fail, @load
@fail
	call $g4_fail(l $g4_bounds_error, l 30)
	hlt
@load
	%data =l add %string, 16
	%address =l add %data, %index
	%character =w loadub %address
	%result =l call $g4_string_alloc(l 10)
	%result_length =l add %result, 8
	storel 1, %result_length
	%result_data =l add %result, 16
	storeb %character, %result_data
	%result_end =l add %result_data, 1
	storeb 0, %result_end
	ret %result
}

