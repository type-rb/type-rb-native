	%size =l add %length, 9
	%string =l call $g4_string_alloc(l %size)
	%length_address =l add %string, 8
	storel %length, %length_address
	%data =l add %string, 16
	%left_data =l add %left, 16
	call $memcpy(l %data, l %left_data, l %left_length)
	%right_target =l add %data, %left_length
	%right_data =l add %right, 16
	call $memcpy(l %right_target, l %right_data, l %right_length)
	%end =l add %data, %length
	storeb 0, %end
	ret %string
}

function l $g4_string_equal(l %left, l %right) {
@start
	%left_length_address =l add %left, 8
	%right_length_address =l add %right, 8
