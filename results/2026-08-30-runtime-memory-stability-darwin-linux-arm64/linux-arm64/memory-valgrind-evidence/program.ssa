	jnz %fm, @fail, @seek
@seek
	%es =w call $fseek(l %f, l 0, w 2)
	%ef =w cnew %es, 0
	jnz %ef, @close, @len
@len
	%n =l call $ftell(l %f)
	%neg =w csltl %n, 0
	jnz %neg, @close, @rewind
@rewind
	%rs =w call $fseek(l %f, l 0, w 0)
	%rf =w cnew %rs, 0
	jnz %rf, @close, @alloc
@alloc
	%sz =l add %n, 9
	%s =l call $g4_string_alloc(l %sz)
	%length_address =l add %s, 8
	storel %n, %length_address
	%d =l add %s, 16
	%got =l call $fread(l %d, l 1, l %n, l %f)
	%cs =w call $fclose(l %f)
	%rfe =w cnel %got, %n
	%cfe =w cnew %cs, 0
	%bad =w or %rfe, %cfe
	jnz %bad, @fail, @done
@done
	%e =l add %d, %n
	storeb 0, %e
	%file_root =l add $g4_gc_global_roots, 8
	storel %s, %file_root
	ret %s
@close
	%ignored =w call $fclose(l %f)
	jmp @fail
@fail
	ret 0
}

