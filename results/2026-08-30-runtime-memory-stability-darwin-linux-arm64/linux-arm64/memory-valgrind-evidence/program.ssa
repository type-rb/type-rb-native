	%new_bytes =l mul %new_capacity, 8
	%old_bytes =l mul %capacity, 8
	%growth =l sub %new_bytes, %old_bytes
	%data_slot =l add %array, 24
	%data =l loadl %data_slot
	%new_data =l call $realloc(l %data, l %new_bytes)
	%failed =w ceql %new_data, 0
